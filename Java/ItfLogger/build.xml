<project name="ItfLogger"  basedir="." default="ItfLogger">
    <description>
            Base classes for CDR 
    </description>
	<property name="build.executable" value="C:/Java/jdk7/bin/javac"/>
	<property name="src.dir" location="src" />
	<property name="classes.dir" location="bin" />
	<property name="jar.filename" value="C:/ITF-jar/itfJarFiles/${ant.project.name}.jar" />
	
	<path id="class.path">
	  <fileset dir="../ITF-jar/lib">
	  	<include name="log4j-1.2.17.jar" /> 
	  	</fileset>
	</path>
	
	
	<target name="ItfLogger">
		    <javac	      srcdir="${src.dir}"
		      includes="**/*.java"
		      destdir="${classes.dir}" includeantruntime="false" executable="${build.executable}" compiler="javac1.7" debug="true">
		    	<classpath refid="class.path" />
		    	</javac>
		<copy todir="${classes.dir}">
		            <fileset dir="${src.dir}" />
		</copy>
		<jar destfile = "${jar.filename}">
			<fileset dir = "${classes.dir}" /> 
		</jar>
	</target>
	
	<target name="clean">
		<delete>
		   <fileset dir="${classes.dir}">
		      <include name="**/*"/>
		   </fileset>			
		</delete>
		<delete file = "${jar.filename}" />
				   
	</target>
	
	<target name="print-version"> 
	   <echo>Java/JVM version: ${ant.java.version}</echo> 
	   <echo>Java/JVM detail version: ${java.version}</echo> 
	</target>
	
</project>