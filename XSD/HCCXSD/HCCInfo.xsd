<?xml version="1.0" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">


  <xs:simpleType name="INTEGER">
    <xs:restriction base="xs:int"></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VisibleString">
    <xs:restriction base="xs:string"></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="NameStruct">
    <xs:sequence>
      <xs:element name="full" type="VisibleString" minOccurs="0"/>
      <xs:element name="last" type="VisibleString" minOccurs="0"/>
      <xs:element name="first" type="VisibleString" minOccurs="0"/>
      <xs:element name="middle" type="VisibleString" minOccurs="0"/>
      <xs:element name="title" type="VisibleString" minOccurs="0"/>
      <xs:element name="suffix" type="VisibleString" minOccurs="0"/>
      <xs:element name="previous" type="VisibleString" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  
 
  <xs:complexType name="HCCEventStruct">
    <xs:sequence>
      <xs:element name="HCC_CODE" type="INTEGER" minOccurs="0"/>
      <xs:element name="HCC_MODEL_YR" type="INTEGER" minOccurs="0"/>
      <xs:element name="DIAGNOSIS_DATE" type="VisibleString" minOccurs="0"/>
      <xs:element name="HCC_DESCRIPTION" type="VisibleString" minOccurs="0"/>
      <xs:element name="HCC_WEIGHT" type="xs:decimal" minOccurs="0"/>
      <xs:element name="TRIGGER_DX_CODE" type="VisibleString" minOccurs="0"/>
      <xs:element name="TRIGGER_DX_VERSION" type="INTEGER" minOccurs="0"/>
      <xs:element name="TRIGGER_DX_DESCRIPTION" type="VisibleString" minOccurs="0"/>
      <xs:element name="TRIGGER_DX_EXTERNAL_PRVDR_ID" type="INTEGER" minOccurs="0"/>
      <xs:element name="TRIGGER_DX_PROVIDER_FULL_NAME" type="VisibleString" minOccurs="0"/>
      <xs:element name="SECTION_NAME" type="VisibleString" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

 
  <xs:element name="HCC_EMPI_File">
   <xs:complexType>
    <xs:sequence>

     <xs:element name="HCC_EMPI_Info" maxOccurs="unbounded">
      <xs:complexType>
       <xs:sequence>
	
	    <xs:element name="ExtractRunDate" type="VisibleString" minOccurs="0"/>
        <xs:element name="patEMPI" type="INTEGER" minOccurs="0"/>
        <xs:element name="EXISTING_DIAGNOSIS_ID" type="xs:decimal" minOccurs="0"/>
        <xs:element name="ADD_DELETE_MODIFY_FLAG" type = "VisibleString" minOccurs="0"/>
        <xs:element name="patName" type="NameStruct" minOccurs="0"/>
        <xs:element name="HCCEvent" type="HCCEventStruct" minOccurs="0"/>

	   </xs:sequence>
      </xs:complexType>
     </xs:element>
	 
	</xs:sequence>
   </xs:complexType>
  </xs:element>

</xs:schema>
