 set addressDomain = ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDDomainLookup","ADDRESSTYPE_DOMAIN",.addressDomain)
 
 set fac = context.Facility
 set ncid = ""  
 Do ##class(ITFCOMMON.Utility).GetHddNcidForRep(fac,facilityDomain,helpContext,.ncid)
 set context.FacNcid = ncid
   
 set rncid = ""
 set race = context.Race
 Do ##class(ITFCOMMON.Utility).GetHddNcidForRep(race,raceDom,helixCont,.rncid)
 set context.RaceNcid = rncid
 
 set pid34 = context.Pid34
 set p3Ncid = ""
 Do ##class(ITFCOMMON.Utility).GetHddNcidForRep(pid34,facilityDomain,helixCont,.p3Ncid)
 set context.Pid34Ncid = p3Ncid 
 
 set pid57 = context.Pid57
