<code name='MakeHDDCalls' xpos='200' ypos='2150' >
<![CDATA[ 
 set helpContext= ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDContextLookup","HELP_CONTEXT",.helpContext)
 set context.HddContext = helpContext

 set helixCont = ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDContextLookup","HELIX_ECID_CONTEXT",.helixCont)
   
 set facilityDomain= ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDDomainLookup","IHC_FACILITY_DOMAIN",.facilityDomain)
 set context.HddDomain = facilityDomain

 set raceDom = ""
