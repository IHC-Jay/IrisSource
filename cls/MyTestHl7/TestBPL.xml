 set nameTypeDomain = ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDDomainLookup","NAMETYPE_DOMAIN",.nameTypeDomain)
 
 set genderDomain = ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDDomainLookup","GENDER_DOMAIN",.genderDomain)
 
 set languageDomain = ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDDomainLookup","LANGUAGE_DOMAIN",.languageDomain)
 
 set maritalStatusDom = ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDDomainLookup","MARITALSTATUS_DOMAIN",.maritalStatusDom ) 
 
 set religionDomain = ""
 Do ##class(ITFCOMMON.Utility).ItfCommonLookup("HDDDomainLookup","RELIGION_DOMAIN",.religionDomain )
 
 set languageDomain = ""
