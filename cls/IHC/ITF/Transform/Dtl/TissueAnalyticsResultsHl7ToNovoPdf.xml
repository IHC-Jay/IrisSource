<Data><![CDATA[
<transform sourceClass='EnsLib.HL7.Message' targetClass='EnsLib.HL7.Message' sourceDocType='TissueAnalyticsResPdf:TAResPdf24' targetDocType='TissueAnalyticsResPdf:TAResPdf24' create='new' language='objectscript' >
<annotation>Transforms Hl7 PDF to Cerner</annotation>
<assign value='source.{MSH}' property='target.{MSH}' action='set' />
<assign value='"PP RESULTS"' property='target.{MSH:SendingApplication.namespaceID}' action='set' />
<assign value='"R03"' property='target.{MSH:MessageType.triggerevent}' action='set' />
<assign value='source.{MSH:SendingApplication.namespaceID}' property='target.{MSH:ReceivingApplication.namespaceID}' action='set' />
<assign value='context.msh41SendFacility' property='target.{MSH:SendingFacility.namespaceID}' action='set' />
<assign value='"P"' property='target.{MSH:ProcessingID.processingID}' action='set' />
<assign value='2.3' property='target.{MSH:VersionID.versionID}' action='set' />
<assign value='source.{PID}' property='target.{PID}' action='set' />
<if condition='source.{PV1} &apos;=""' >
<true>
<assign value='source.{PV1}' property='target.{PV1}' action='set' />
</true>
</if>
<foreach property='context.attPrvdrIds' key='k1' >
<assign value='context.attPrvdrIds.GetAt(k1)' property='target.{PV1:AttendingDoctor(k1).IDnumberST}' action='set' />
<assign value='context.attPrvdrLnms.GetAt(k1)' property='target.{PV1:AttendingDoctor(k1).familyname.surname}' action='set' />
<assign value='context.attPrvdrFnms.GetAt(k1)' property='target.{PV1:AttendingDoctor(k1).givenname}' action='set' />
<assign value='context.attPrvdrMnms.GetAt(k1)' property='target.{PV1:AttendingDoctor(k1).degree}' action='set' />
</foreach>
<assign value='source.{OBR}' property='target.{OBR}' action='set' />
<assign value='1' property='target.{OBR:SetIDOBR}' action='set' />
<assign value='"F"' property='target.{OBR:ResultStatus}' action='set' />
<code>
<![CDATA[ Set tmpstream = ##class(%Stream.GlobalCharacter).%New()
  set rem=""
  do tmpstream.Write("^Tissue Analytics^PDF^Base64^")
]]]]><![CDATA[></code>

<foreach property='source.{OBXgrp()}' key='k1' >
<code>
<![CDATA[
  do source.GetFieldStreamRaw(.tmpstream, "OBXgrp("_k1_").OBX:5", .rem)
  ]]]]><![CDATA[></code>
</foreach>
<code>
<![CDATA[
  do target.StoreFieldStreamRaw(tmpstream, "OBXgrp("_k1_").OBX:5", rem)
]]]]><![CDATA[></code>
</transform>
