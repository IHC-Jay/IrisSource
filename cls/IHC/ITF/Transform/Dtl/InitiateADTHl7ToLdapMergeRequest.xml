<transform sourceClass='EnsLib.HL7.Message' targetClass='IHC.ITF.Request.LdapMergeRequest' sourceDocType='ADTInitiate:ADT_HELP' create='new' language='objectscript' >
<foreach property='source.{PID:PatientIdentifierList()}' key='k1' >
<if condition='source.{PID:PatientIdentifierList(k1).assigningauthority.namespaceID}="UN"' >
<true>
<assign value='source.{PID:PatientIdentifierList(k1).ID}' property='target."PRESERVE_UNIT_NUMBER"' action='set' />
</true>
</if>
