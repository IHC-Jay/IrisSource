<true>
<assign value='$zstrip(source.{PID:SSNNumberPatient},"*E",,"1234567890")' property='target.SSN' action='set' />
</true>
</if>
<code>
<![CDATA[ set tDOB=$zstrip(source.GetValueAt("PID:DateTimeOfBirth.timeofanevent"),"*P")
 set tDate=$extract(tDOB,1,8)
 set tTime=$extract(tDOB,9,14)
 if ($length(tTime)=6){
   set tTime=$extract(tTime,1,2)_":"_$extract(tTime,3,4)_":"_$extract(tTime,5,6)
 }else{ set tTime="00:00:00"}
 set tDOB=tDate_" "_tTime]]]]><![CDATA[></code>
<assign value='$zdatetime($zdatetimeh(tDOB,8),3)_".0"' property='target.DOB' action='set' />
