<transform sourceClass='EnsLib.HL7.Message' targetClass='EnsLib.HL7.Message' sourceDocType='RemedyPartnersResOru:ResPdf24' targetDocType='RemedyPartnersResOru:ResPdf24' create='new' language='objectscript' >
<annotation>Transforms RemedyPartners Hl7 results to Cerner</annotation>
<trace value='"#### DTL:BEGIN ####"' />
<assign value='source.{MSH}' property='target.{MSH}' action='set' />
<assign value='source.{EVN}' property='target.{EVN}' action='set' />
<assign value='source.{PID}' property='target.{PID}' action='set' />
<assign value='source.{PV1}' property='target.{PV1}' action='set' />
<assign value='source.{ORC}' property='target.{ORC}' action='set' />
<assign value='source.{OBR}' property='target.{OBR}' action='set' />
<assign value='source.{OBXgrp()}' property='target.{OBXgrp()}' action='set' />
<foreach property='source.{OBXgrp()}' key='k1' >
<assign value='"F"' property='target.{OBXgrp(k1).OBX:ObservationResultStatus}' action='set' />
<if condition='source.{OBXgrp(k1).OBX:3.1}&apos;=""' >
<true>
<assign value='context.obx3.GetAt(k1)' property='target.{OBXgrp(k1).OBX:3.1}' action='set' />
</true>
<false>
<assign value='""' property='target.{OBXgrp(k1).OBX:3.1}' action='set' />
</false>
</if>
<assign value='"ST"' property='target.{OBXgrp(k1).OBX:ValueType}' action='set' />
<assign value='source.{OBXgrp(k1).OBX:ObservationIdentifier.identifierST}' property='target.{OBXgrp(k1).OBX:ObservationIdentifier.text}' action='set' />

<assign value='source.{OBXgrp(k1).OBX:ObservationIdentifier.identifierST}' property='obx3EpiDates' action='set' />
<trace value='"#### OBX3; ####"_obx3EpiDates' />
<assign value='""' property='updDateFormat' action='set' />

<if condition='obx3EpiDates ="Episode_Dates"' >
<true>
  <assign value='source.{OBXgrp(k1).OBX:ObservationValue(1)}' property='obx5Val' action='set' />
  <code>
<![CDATA[ // Split the Assigned patient locatio    
   set dateList = $LISTFROMSTRING(obx5Val, "-")
   $$$TRACE("OBX5 date List count::"_$LISTLENGTH(dateList))   
   set dateListLength = $LISTLENGTH(dateList) 
   if dateListLength>1{
	   set beginDateRange = $LIST(dateList,1) 
	   set endDateRange = $LIST(dateList,2)  
	   set updBeginDateFormat = $E(beginDateRange,5,6)_"/"_$E(beginDateRange,7,8)_"/"_$E(beginDateRange,1,4)_" "_$E(beginDateRange,9,10)_":"_$E(beginDateRange,11,12)
	   if ($L(endDateRange)>0){
	   	set updEndDateFormat = $E(endDateRange,5,6)_"/"_$E(endDateRange,7,8)_"/"_$E(endDateRange,1,4)_" "_$E(endDateRange,9,10)_":"_$E(endDateRange,11,12)
	   	set updDateFormat = updBeginDateFormat_" - "_ updEndDateFormat	
	   }else{
		   set updDateFormat = updBeginDateFormat
	   }   
   }elseIF dateListLength=1{ 
       set beginDateRange = $LIST(dateList,1) 
       set updDateFormat = $E(beginDateRange,5,6)_"/"_$E(beginDateRange,7,8)_"/"_$E(beginDateRange,1,4)_" "_$E(beginDateRange,9,10)_":"_$E(beginDateRange,11,12)
   }
   $$$TRACE( "Updated Date Format: "_updDateFormat)
 ]]]]><![CDATA[></code>
 <assign value='updDateFormat' property='target.{OBXgrp(k1).OBX:5}' action='set' />
</true>
</if>

</foreach>
<assign value='' property='target.{OBR:UniversalServiceIdentifier.nameofcodingsystem}' action='clear' />
<assign value='context.obr4' property='target.{OBR:UniversalServiceIdentifier.identifierST}' action='set' />
