<code>
<![CDATA[ 
  set address1=$replace(address1,".","")
  set updAddress = $ZCONVERT(address1 ,"U")

  $$$TRACE("DTL:Cleanse-Address1(Directions)...") 
  set listDirections = $LISTBUILD("WEST ","EAST ","NORTH ","SOUTH ")
  set listDirectionsLen =$LISTLENGTH(listDirections)
  FOR i=1:1:listDirectionsLen {
     set direction = $LIST(listDirections,i)     
     if updAddress [ direction {
	     SET updAddress=$REPLACE(updAddress,direction,$E(direction,1)_" ")
	     $$$TRACE("updAddress value(direction) :"_updAddress)	                 
	 }    	  
  }  
  
  $$$TRACE("DTL:Cleanse-Address1(Abbreviations..)...") 
  set addressAbbrList = $LISTFROMSTRING(context.addressAbbr, ",")
  set addressAbbrListLen =$LISTLENGTH(addressAbbrList)
  set address1List = $LISTFROMSTRING(updAddress, " ")
  set address1ListLen =$LISTLENGTH(address1List)
  set lastAddress1Word = $LIST(address1List,address1ListLen)
  $$$TRACE("$$$ addressAbbrList: "_addressAbbrList)
  $$$TRACE("$$$ updAddress: "_updAddress)
  $$$TRACE("$$$ lastAddress1Word: "_lastAddress1Word)
  
  FOR i=1:1:addressAbbrListLen {
     set abbr = $LIST(addressAbbrList,i)    
     if updAddress [ abbr {
	     if (abbr=lastAddress1Word){
     		try {
 				set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.RoyalAdtHl7ToIhcHieDemogr.AddressAbbrRoyal", lastAddress1Word, .retVal )
 	 			set abbrVal=retVal
 				if (retVal="Unknown"){
	 				set abbrVal=lastAddress1Word
				}
 			}catch err{
				set abbrVal=lastAddress1Word 
 			}
  			SET updAddress=$REPLACE(updAddress,abbr,abbrVal)
  			$$$TRACE("updAddress value(end words abbr) :"_updAddress)
  			break
	     }else{
		     $$$TRACE("$$$ abbr "_abbr_" is not the last word of the address:"_updAddress)
		 }
  	}     	  
  }  
]]]]><![CDATA[></code>
<assign value='updAddress' property='address1' action='set' />
<code>
<![CDATA[ 
    set AddrWrapKeywordsList = $LISTFROMSTRING(context.addressKeyWords, ",")
    
    
    if (($LISTLENGTH(AddrWrapKeywordsList) > 0) && (context.AddrWrapLogicValue = 1) && ($LENGTH(address2) = 0)){
       $$$TRACE("Inside need wrapping")
       SET ptr=0
       WHILE 1=$LISTNEXT(AddrWrapKeywordsList,ptr,addrWrap){
          set addrWrapPre = " "_addrWrap
          set addrLine1L = $ZCONVERT(address1 ,"L") ///Converting to Lowercase
          set addrWrapL = $ZCONVERT(addrWrapPre,"L")
           $$$TRACE(" addrLine1L : ["_addrLine1L_"]. addrWrapL:["_addrWrapL_"]")
          ///Below $FIND will give the ending index+1 of the word in "addrWrapL"
          set indexAddrLine1 = $FIND(addrLine1L,addrWrapL)          
          if (indexAddrLine1 > 0){
            $$$TRACE("Inside indexfound(end of address1) at: "_indexAddrLine1 )
             ///Need to minus the length addrWrapL since we have the ending index+1 in previous step
             set street1 = $EXTRACT(addrLine1L,0,indexAddrLine1-$LENGTH(addrWrapL)-1)
             $$$TRACE("street1 Value in List position : ["_street1_"]")
             
             ///* will get till the end of the string
             set street2 = $EXTRACT(addrLine1L,indexAddrLine1-$LENGTH(addrWrapL)+1,*)
             $$$TRACE("street2 Value in List position : ["_street2_"]" )
             
             ///We are interchanging street1 and street2 values when we map just bcas Egate does that
             set isWrapped = "1" 
             break            
          }
       }       
    }
  ]]]]><![CDATA[></code>
