<assign value='source.{MSH}' property='target.{MSH}' action='set' />
<assign value='' property='target.{MSH:SendingFacility}' action='clear' />
<assign value='"TISSUE_ANALYTICS_PDF"' property='target.{MSH:SendingApplication.namespaceID}' action='set' />
<assign value='"iCENTRA"' property='target.{MSH:ReceivingApplication.namespaceID}' action='set' />
