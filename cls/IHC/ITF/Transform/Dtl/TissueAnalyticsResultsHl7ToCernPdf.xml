</true>
</if>
<assign value='source.{OBR}' property='target.{OBR}' action='set' />
<assign value='"TissueAnalytics_"_source.{PID:PatientAccountNumber.ID}_"_"_source.{MSH:DateTimeOfMessage.timeofanevent}_".pdf"' property='pdfFileName' action='set' />
<assign value='context.obr41Ncid' property='target.{OBR:UniversalServiceIdentifier.identifierST}' action='set' />
<assign value='context.obr41Ncid' property='obx3Val' action='set' />
<foreach property='source.{OBXgrp()}' key='k1' >
<code>
<![CDATA[ Set tmpstream = ##class(%Stream.GlobalCharacter).%New()
]]]]><![CDATA[></code>
<assign value='k1' property='target.{OBXgrp(k1).OBX:SetIDOBX}' action='set' />
<assign value='"ED"' property='target.{OBXgrp(k1).OBX:ValueType}' action='set' />
