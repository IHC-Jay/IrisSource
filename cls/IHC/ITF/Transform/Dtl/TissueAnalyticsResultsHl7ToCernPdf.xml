<transform sourceClass='EnsLib.HL7.Message' targetClass='EnsLib.HL7.Message' sourceDocType='TissueAnalyticsResPdf:TAResPdf24' targetDocType='TissueAnalyticsResPdf:TAResPdf24' create='new' language='objectscript' >
