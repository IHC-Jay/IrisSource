<XData name="DTL">
<XMLNamespace>http://www.intersystems.com/dtl</XMLNamespace>
<Data><![CDATA[
<transform sourceClass='EnsLib.HL7.Message' targetClass='EnsLib.HL7.Message' sourceDocType='SchedCern:Sched_Cern' targetDocType='SchedCern:Sched_Cern' create='new' language='objectscript' >
<annotation>Translates Cerner Scheduling Hl7 records to AmWell </annotation>
<trace value='"#### DTL:BEGIN ####"' />
<trace value='"#### DTL: Mapping MSH Segment ####"' />
<assign value='source.{MSH:FieldSeparator}' property='target.{MSH:FieldSeparator}' action='set' />
<assign value='source.{MSH:EncodingCharacters}' property='target.{MSH:EncodingCharacters}' action='set' />
<assign value='"INTERFACEENGINE"' property='target.{MSH:SendingApplication.namespaceID}' action='set' />
<assign value='"INTERMOUNTAIN"' property='target.{MSH:SendingFacility.namespaceID}' action='set' />
<assign value='"AMWELL"' property='target.{MSH:ReceivingApplication.namespaceID}' action='set' />
<assign value='"AMERICANWELL"' property='target.{MSH:ReceivingFacility.namespaceID}' action='set' />
<assign value='source.{MSH:DateTimeOfMessage.Time}' property='target.{MSH:DateTimeOfMessage.Time}' action='set' />
<assign value='source.{MSH:MessageType.MessageCode}' property='target.{MSH:MessageType.messageCode}' action='set' />
<assign value='context.msgType' property='target.{MSH:MessageType.triggerevent}' action='set' />
<assign value='source.{MSH:MessageControlID}' property='target.{MSH:MessageControlID}' action='set' />
<assign value='context.processingId' property='target.{MSH:ProcessingID.processingID}' action='set' />
<assign value='source.{MSH:VersionID.VersionID}' property='target.{MSH:VersionID.versionID}' action='set' />
<trace value='"#### DTL: Mapping SCH Segment ####"' />
<assign value='source.{SCH:PlacerAppointmentID.EntityIdentifier}' property='target.{SCH:FillerAppointmentID.EntityIdentifier}' action='set' />
<assign value='source.{SCH:AppointmentDuration}' property='target.{SCH:AppointmentDuration}' action='set' />
<assign value='source.{SCH:AppointmentTimingQuantity(1).StartDateTime.Time}' property='target.{SCH:AppointmentTimingQuantity(1).StartDateTime.Time}' action='set' />
<assign value='..ToUpper(context.sch25)' property='target.{SCH:FillerStatusCode.Identifier}' action='set' />
<assign value='context.sch7' property='target.{SCH:AppointmentType.Identifier}' action='set' />

<trace value='"#### DTL: Mapping PID Segment ####"' />
<assign value='source.{PIDgrp(1).PID:SetIDPID}' property='target.{PIDgrp(1).PID:SetIDPID}' action='set' />
<assign value='context.empiNumber' property='target.{PIDgrp(1).PID:PatientID.IDNumber}' action='set' />
<assign value='"EMPI"' property='target.{PIDgrp(1).PID:PatientID.IdentifierTypeCode}' action='set' />
<assign value='context.AmWellMrnNumber' property='target.{PIDgrp(1).PID:PatientIdentifierList(1).IDNumber}' action='set' />
<assign value='"AMW"' property='target.{PIDgrp(1).PID:PatientIdentifierList(1).IdentifierTypeCode}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientName(1).FamilyName.Surname}' property='target.{PIDgrp(1).PID:PatientName(1).FamilyName.Surname}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientName(1).GivenName}' property='target.{PIDgrp(1).PID:PatientName(1).GivenName}' action='set' />

<assign value='source.{PIDgrp(1).PID:DateTimeofBirth}' property='patDob' action='set' />
<if condition='$length(patDob) &gt; 8  ' >
<true>
<assign value='$extract(patDob,1,8)' property='target.{PIDgrp(1).PID:DateTimeofBirth}' action='set' />
</true>
<false>
<assign value='patDob' property='target.{PIDgrp(1).PID:DateTimeofBirth}' action='set' />
</false>
</if>
<assign value='context.pid8' property='target.{PIDgrp(1).PID:AdministrativeSex}' action='set' />

<foreach property='source.{PIDgrp(1).PID:PatientAddress()}' key='k1' >
<assign value='source.{PIDgrp(1).PID:PatientAddress(k1).AddressType}' property='addrType' action='set' />
<trace value='"#### DTL:AddressType ####"_addrType' />
<if condition='addrType ="199"' >
<true>
<assign value='source.{PIDgrp(1).PID:PatientAddress(k1).StreetAddress.StreetorMailingAddress}' property='target.{PIDgrp(1).PID:PatientAddress(k1).streetaddress}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientAddress(k1).OtherDesignation}' property='target.{PIDgrp(1).PID:PatientAddress(k1).otherdesignation}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientAddress(k1).City}' property='target.{PIDgrp(1).PID:PatientAddress(k1).city}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientAddress(k1).StateorProvince}' property='target.{PIDgrp(1).PID:PatientAddress(k1).stateorprovince}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientAddress(k1).ZiporPostalCode}' property='zipCode' action='set' />
<if condition='$length(zipCode) &gt; 5  ' >
<true>
<assign value='$extract(zipCode,1,5)' property='target.{PIDgrp(1).PID:PatientAddress(k1).ziporpostalcode}' action='set' />
</true>
<false>
<assign value='zipCode' property='target.{PIDgrp(1).PID:PatientAddress(k1).ziporpostalcode}' action='set' />
</false>
</if>
<assign value='context.pid116.GetAt(k1)' property='target.{PIDgrp(1).PID:PatientAddress(k1).country}' action='set' />
</true>
</if>
</foreach>
<foreach property='source.{PIDgrp(1).PID:PhoneNumberHome()}' key='k1' >
<assign value='source.{PIDgrp(1).PID:PhoneNumberHome(k1).TelecommunicationUseCode}' property='phType' action='set' />
<assign value='source.{PIDgrp(1).PID:PhoneNumberHome(k1).TelephoneNumber}' property='phNumberHome' action='set' />
<code>
<![CDATA[ // Remove non numeric
 set phNumberHome=$zstrip(phNumberHome,"*P") 
 ]]]]><![CDATA[></code>
<trace value='phType_":::phType"' />
<trace value='phNumberHome_":::phNumberHome"' />
<if condition='$length(phNumberHome) &gt; 0' >
<true>
<if condition='phType="521363181"' >
<true>
<assign value='source.{PIDgrp(1).PID:PhoneNumberHome(k1).TelephoneNumber}' property='target.{PIDgrp(1).PID:PhoneNumberHome(1).TelephoneNumber}' action='set' />
<code>
<![CDATA[ quit]]]]><![CDATA[></code>
</true>
<false>
<if condition='phType="195"' >
<true>
<assign value='source.{PIDgrp(1).PID:PhoneNumberHome(k1).TelephoneNumber}' property='target.{PIDgrp(1).PID:PhoneNumberHome(1).TelephoneNumber}' action='set' />
</true>
<false>
<if condition='(phType="193")' >
<true>
<assign value='source.{PIDgrp(1).PID:PhoneNumberHome(k1).TelephoneNumber}' property='target.{PIDgrp(1).PID:PhoneNumberHome(1).TelephoneNumber}' action='set' />
</true>
</if>
</false>
</if>
</false>
</if>
</true>
</if>
</foreach>

<if condition='((source.{PIDgrp(1).PID:PatientDeathIndicator} ="1022") || ($L(source.{PIDgrp(1).PID:PatientDeathDateandTime.Time})>0))' >
<true>
<assign value='"Y"' property='target.{PIDgrp(1).PID:PatientDeathIndicator}' action='set' />
</true>
<false>
  <if condition='source.{PIDgrp(1).PID:PatientDeathIndicator} ="1023"' >  
 <true>
  <assign value='"N"' property='target.{PIDgrp(1).PID:PatientDeathIndicator}' action='set' />
  </true>
  </if>
</false>
</if>

<assign value='source.{PIDgrp(1).PV1:SetIDPV1}' property='target.{PIDgrp(1).PV1:SetIDPV1}' action='set' />
<assign value='..ToUpper(context.teleHealthEndPoint)' property='target.{PIDgrp(1).PV1:3.4.1}' action='set' />

<assign value='context.sch7' property='target.{RGSgrp(1).AISgrp(1).AIS:UniversalServiceIdentifier.Text}' action='set' />

<if condition='context.providerIdFlag ="1"' >
<true>
<assign value='source.{RGSgrp(1).AIPgrp(1).AIP:SetIDAIP}' property='target.{RGSgrp(1).AIPgrp(1).AIP:SetIDAIP}' action='set' />
<assign value='source.{RGSgrp(1).AIPgrp(1).AIP:PersonnelResourceID(1).IDNumber}' property='target.{RGSgrp(1).AIPgrp(1).AIP:PersonnelResourceID(1).IDNumber}' action='set' />
<assign value='source.{RGSgrp(1).AIPgrp(1).AIP:PersonnelResourceID(1).FamilyName.Surname}' property='target.{RGSgrp(1).AIPgrp(1).AIP:PersonnelResourceID(1).FamilyName.Surname}' action='set' />
<assign value='source.{RGSgrp(1).AIPgrp(1).AIP:PersonnelResourceID(1).GivenName}' property='target.{RGSgrp(1).AIPgrp(1).AIP:PersonnelResourceID(1).GivenName}' action='set' />
</true>
<false>
<assign value='source.{RGSgrp(1).AIGgrp(1).AIG:SetIDAIG}' property='target.{RGSgrp(1).AIPgrp(1).AIP:SetIDAIP}' action='set' />
<assign value='source.{RGSgrp(1).AIGgrp(1).AIG:ResourceID.Identifier}' property='genericResourceId' action='set' />
<assign value='$ZSTRIP(genericResourceId,"*W")' property='target.{RGSgrp(1).AIPgrp(1).AIP:PersonnelResourceID(1).IDNumber}' action='set' />
</false>
</if>
<trace value='"#### DTL:END ####"' />
</transform>
]]></Data>
</XData>
