<Method name="getPhoneNumber">
<ClassMethod>1</ClassMethod>
<FormalSpec>pNumber:%String,*pAreaCode:%String,*pLocalNumber:%String</FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	set tSC=$$$OK
	set phLength=$Length(pNumber)
	 set pAreaCode=""
	 set pLocalNumber=""
	 If (phLength=13){
 	   set pAreaCode=$e(pNumber,2,4)
	    set pLocalNumber=$e(pNumber,6,*)
	 }ElseIf (phLength=12){
  	  	set pAreaCode=$e(pNumber,1,3)
 	   set pLocalNumber=$e(pNumber,5,*)
	 }ElseIf (phLength=10){
    	set pAreaCode=$e(pNumber,1,3)
    	set pLocalNumber=$e(pNumber,4,*)
 	}ElseIf (phLength=8){ 
    	set pLocalNumber=pNumber
 	}
	quit tSC
]]></Implementation>
</Method>

