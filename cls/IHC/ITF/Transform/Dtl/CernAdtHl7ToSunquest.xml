 set sDestNurseUnit = sNurseUnit 
 if ( (($length(sPatType) > 0) && '((sPatType = "N") || (sPatType = "O"))) ) {
	 if ( ($length(sNurseUnit) > 0) && (sNurseUnit = "SER") ) {
