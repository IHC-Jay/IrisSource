 }
 set sRoom = source.GetValueAt("PV1:AssignedPatientLocation.room") 
 set sDestRoom = sRoom
 if ( ($length(sUB92Cond) > 0) && (sUB92Cond = "CLIN_REG") ) {
	 set sDestRoom = source.GetValueAt("ZZZ(2):28UB92Value")
 }  
 if ($length(sDestRoom) = 0) {
	 set sTriggerEvent = source.GetValueAt("MSH:MessageType.triggerevent")
	 if ($listfind($listfromstring(context.dummyRoomEvents,","), sTriggerEvent) > 0){
		 set sDestRoom = context.dummyRoomName
	 } else {
		 set sDestRoom = sNurseUnit
	 }
 }
 $$$TRACE("###   After PV1-3.2 Logic   ### : " _ sDestRoom)
]]]]><![CDATA[></code>
