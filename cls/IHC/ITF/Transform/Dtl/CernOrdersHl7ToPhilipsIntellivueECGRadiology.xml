<code>
<![CDATA[ // Split the Assigned patient location     
   set patLocList = $LISTFROMSTRING(patLoc, "|")
   $$$TRACE("patLoc Value is : " _patLoc)   
   $$$TRACE("Pat Location List(PV13 patLoc) count::"_$LISTLENGTH(patLocList))   
   set patLocListLength = $LISTLENGTH(patLocList)  
   Set facility = "" 
   Set pointOfCareUnit = ""
   Set room = ""
   Set bed = ""
   Set building = ""     
   if patLocListLength>4{	   
	 set pointOfCareUnit = $LIST(patLocList,3) 
	 set room = $LIST(patLocList,4)   
	 set bed =  $LIST(patLocList,5) 
	 set building = $LIST(patLocList,2) 	 
	 set facility = $LIST(patLocList,1) 	 
   }elseIF patLocListLength=4{      
	 set pointOfCareUnit = $LIST(patLocList,3) 
	 set room = $LIST(patLocList,4)   
	 set bed =  ""
	 set building = $LIST(patLocList,2) 	 
	 set facility = $LIST(patLocList,1) 	 
   }elseIF  patLocListLength=3{	
	 set pointOfCareUnit = $LIST(patLocList,3) 
	 set room = ""   
	 set bed =  ""
	 set building = $LIST(patLocList,2) 	 
	 set facility = $LIST(patLocList,1) 	 
   } elseIF  patLocListLength=2{	   
	 set pointOfCareUnit = ""
	 set room = ""   
	 set bed =  ""
	 set building = $LIST(patLocList,2) 	 
	 set facility = $LIST(patLocList,1) 	 	 
   }elseIF  patLocListLength=1{	      
	 set pointOfCareUnit = ""
	 set room = ""   
	 set bed =  ""
	 set building = ""
	 set facility = $LIST(patLocList,1)  	 
   }else{
         set pointOfCareUnit = context.pv13POC
         }
   ]]]]><![CDATA[></code>
