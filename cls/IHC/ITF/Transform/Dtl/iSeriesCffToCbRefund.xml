<Default>0</Default>
</Parameter>

<XData name="DTL">
<XMLNamespace>http://www.intersystems.com/dtl</XMLNamespace>
<Data><![CDATA[
<transform sourceClass='IHC.ITF.BILLING.DStruc.ARMRefundToIDX.InARM.Batch' targetClass='IHC.ITF.BILLING.DStruc.ARMRefundToIDX.OutCB.Batch' create='new' language='objectscript' >
<assign value='"IR000"' property='target.Header.RecordType' action='set' />
<trace value='"RecordCount :"_source.Header.RecordCount' />
<assign value='source.Header.RecordCount' property='target.Header.RecordCount' action='set' />
<assign value='source.Header.BatchDescription' property='target.Header.Description' action='set' />
<code>
<![CDATA[ set sourceDate= source.Header.BatchDate
 $$$TRACE("SourceDate value is :"_sourceDate )
 
 set yr= $EXTRACT(sourceDate,0,4)
 set month= $EXTRACT(sourceDate,6,7)
 set date= $EXTRACT(sourceDate,9,10)
 $$$TRACE("yr value is :"_yr )
 $$$TRACE("month value is :"_month )
 $$$TRACE("date value is :"_date )
 
 set targetDate = month_date_yr
 $$$TRACE("targetDate  value is :"_targetDate )
 
 //Remove leading "0" from target amount. "<" indicates leading char
 set targetamountstrip =..Strip(source.Header.TotalAmount,"<","0")
 $$$TRACE("targetamountstrip value is :"_targetamountstrip)
 
 set targetAmount= source.Header.AmountSign_targetamountstrip
 $$$TRACE("targetAmount value is :"_targetAmount)]]]]><![CDATA[></code>
<assign value='targetDate' property='target.Header.Date' action='set' />
<assign value='..Pad(targetAmount,8)' property='target.Header.TotalDollars' action='set' />
<foreach property='source.Record()' key='k1' >
<assign value='source.Record.(k1).Detail.InvoiceNumber' property='actualInvoiceNo' action='set' />
<code>
<![CDATA[ 
  $$$TRACE("actualInvoiceNo value is :"_actualInvoiceNo)
  
  set InvoiceNo=..Strip(actualInvoiceNo ,"<","0")
 $$$TRACE("InvoiceNo value is :"_InvoiceNo)
  
 ]]]]><![CDATA[></code>
<assign value='..Pad(InvoiceNo,10," ")' property='target.Record.(k1).Detail.IDXInvoiceNumber' action='set' />
<assign value='source.Record.(k1).Detail.AmountSign' property='amountSign' action='set' />
<trace value='"amountSign value is : "_amountSign' />
<assign value='source.Record.(k1).Detail.RequestedAmount' property='reqAmt' action='set' />
<code>
<![CDATA[  $$$TRACE("reqAmt value is :"_reqAmt)
  
  set reqAmtStrip=..Strip(reqAmt ,"<","0")
 $$$TRACE("reqAmtStrip value is :"_reqAmtStrip)
 
 set reqAmtPad = ..Pad(reqAmtStrip,8," ")
 $$$TRACE("reqAmtPad value is :"_reqAmtPad)
 
 //Below check is done to assign empty space in case amount sign is not "-"
 if amountSign'= "-"
 {
   set amountSign=" "
 }
 
 set requestedAmount = amountSign_reqAmtPad
 $$$TRACE("requestedAmount value is :"_requestedAmount)]]]]><![CDATA[></code>
<if condition='amountSign = "-"' >
<true>
<assign value='requestedAmount' property='target.Record.(k1).Detail.RefundReversalAmount' action='set' />
</true>
<false>
<assign value='requestedAmount' property='target.Record.(k1).Detail.CheckAmount' action='set' />
<assign value='..Pad("",-9)' property='target.Record.(k1).Detail.RefundReversalAmount' action='set' />
</false>
</if>
<assign value='source.Record.(k1).Detail.IDXTransactionCode' property='target.Record.(k1).Detail.RefundReversalPayCode' action='set' />
<assign value='source.Record.(k1).Detail.CheckDate' property='chkDate' action='set' />
<code>
<![CDATA[ 
 $$$TRACE("chkDate value is :"_chkDate)
 
 set yr= $EXTRACT(chkDate,0,4)
 set month= $EXTRACT(chkDate,6,7)
 set date= $EXTRACT(chkDate,9,10)
 $$$TRACE("yr value is :"_yr )
 $$$TRACE("month value is :"_month )
 $$$TRACE("date value is :"_date )
 
 set chkIssueDate= month_date_yr
 $$$TRACE("chkIssueDate value is :"_chkIssueDate)]]]]><![CDATA[></code>
<assign value='chkIssueDate' property='target.Record.(k1).Detail.CheckIssueDate' action='set' />
<assign value='source.Record.(k1).Detail.DateCleared' property='dtClr' action='set' />
<code>
<![CDATA[ 
 $$$TRACE("dtClr value is :"_dtClr)
 
 set yr= $EXTRACT(dtClr,0,4)
 set month= $EXTRACT(dtClr,6,7)
 set date= $EXTRACT(dtClr,9,10)
 $$$TRACE("yr value is :"_yr )
 $$$TRACE("month value is :"_month )
 $$$TRACE("date value is :"_date )
 
 set dateCleared= month_date_yr
 $$$TRACE("dateCleared value is :"_dateCleared)]]]]><![CDATA[></code>
<assign value='dateCleared' property='target.Record.(k1).Detail.CheckClearingDate' action='set' />
<assign value='source.Record.(k1).Detail.CancelOrVoidDate' property='cancelDate' action='set' />
<code>
<![CDATA[ 
 $$$TRACE("cancelDate value is :"_cancelDate)
 
 set yr= $EXTRACT(cancelDate,0,4)
 set month= $EXTRACT(cancelDate,6,7)
 set date= $EXTRACT(cancelDate,9,10)
 $$$TRACE("yr value is :"_yr )
 $$$TRACE("month value is :"_month )
 $$$TRACE("date value is :"_date )
 
 set cancelVoidDate= month_date_yr
 $$$TRACE("cancelVoidDate value is :"_cancelVoidDate)]]]]><![CDATA[></code>
<assign value='cancelVoidDate' property='target.Record.(k1).Detail.CheckVoidOrCancelDate' action='set' />
<assign value='$EXTRACT(source.Record.(k1).Detail.CancelOrVoidComments,0,30)' property='target.Record.(k1).Detail.VoidOrCancelComments' action='set' />
<assign value='source.Record.(k1).Detail.CheckNumber' property='target.Record.(k1).Detail.CheckNumber' action='set' />
</foreach>
</transform>
]]></Data>
</XData>
