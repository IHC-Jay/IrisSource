<Data><![CDATA[
<transform sourceClass='EnsLib.HL7.Message' targetClass='EnsLib.EDI.XML.Document' sourceDocType='SchedR1S14:SIU2_3' targetDocType='DIG-Appt-service:Appointment' create='new' language='objectscript' >
<assign value='"Pain"' property='target.{reason}' action='set' />
<assign value='"Phreesia"' property='target.{source}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientName().givenname}' property='target.{firstName}' action='set' />
<assign value='source.{PIDgrp(1).PID:PatientName(1).familylastname.familyname}' property='target.{lastName}' action='set' />
<if condition='source.{PIDgrp(1).PID:PhoneNumberHome(1).phonenumber1} &apos;= ""' >
<true>
<trace value='"Set Input Contact: " _ source.{PIDgrp(1).PID:PhoneNumberHome(1).phonenumber1}' />
<assign value='source.{PIDgrp(1).PID:PhoneNumberHome(1).phonenumber1}' property='target.{contact}' action='set' />
</true>
<false>
<trace value='"Phone EMPTY: " _ source.{PIDgrp(1).PID:PhoneNumberHome(1).phonenumber1}' />
</false>
</if>
<if condition='source.{PIDgrp(1).PID:DateTimeOfBirth.timeofanevent}' >
<true>
<code>
<![CDATA[ set ag = 0
 set dtOfB = source.GetValueAt("PIDgrp("_(1)_").PID:DateTimeOfBirth.timeofanevent")
 set zdt = $ZDATEH(dtOfB ,8)
 if ($ISVALIDNUM(zdt)) 
 {
   set ag = (( $P($HOROLOG, ",", 1) - zdt) / 365)
   WRITE !, "AGE: " _ ag _", " _ $NORMALIZE(ag, -1)
 }
]]]]><![CDATA[></code>
<assign value='$NORMALIZE(ag, -1)' property='target.{age}' action='set' />
</true>
<false>
<trace value='"DofB: EMPTY " _ source.{PIDgrp(1).PID:DateTimeOfBirth.timeofanevent}' />
</false>
</if>
<assign value='source.{AILgrp(1).AIL:LocationResourceID.pointofcare}' property='target.{nursingUnit}' action='set' />
</transform>
]]></Data>
