<![CDATA[ 
     // get the DATA string into a list 
        
    SET countdown=$LENGTH(context.ObxValues,":")
    SET countup=1
    FOR reps=countdown:-1:1 {
      SET extract=$PIECE(context.ObxValues,":",countup)
     // $$$TRACE(countup_":"_extract)
      if ( extract '= "" )
      {  
        do context.ObxList.Insert(extract)
      }
      SET countup=countup+1
   }   
   
   // Parse the items of the list and create the OBX segment 
   
   set length=context.ObxList.Count()
   
  $$$TRACE(" create the OBX segments using the list created, length is :"_length)
   FOR count=1:1:length
   {
        set str = context.ObxList.GetAt(count) 
        $$$TRACE(" index: "_count_" list value :"_str ) 
        if ( str ="DATA") 
        {
          $$$TRACE(" SKip processing for this line, its the header ")
        }
        else
        {
        
        SET code =$PIECE(str,"~",1)
        SET code = $PIECE(code,".",1)
        SET value =$PIECE(str,"~",2)
        SET unit =$PIECE(str,"~",3)
        SET codeFound = 0 // this means code is not found in the lookups
		
		$$$TRACE(" Code :Value :Unit "_code_":"_value_":"_unit )
        //check if value need to be mapped with lookup
        // check if the codes exisit in the list 
		if ( codeFound = 0)
		{
		//chk for code in PHQ9 list
		set ListFindEvent=context.Phq9CodesList.Find(code,"")
        if ( ListFindEvent '= ""  )
        {      
            $$$TRACE(" Found code in the Phq9 List ")
			set codeFound = 1
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.GenericResultsDelimEpicMigrationHl7Vitals.Lookup.MapPHQ9", value, .retVal )
            if ($$$ISERR(status) || (retVal = "Unknown") || (retVal ="")) {       
            $$$TRACE("Unable to find a mapping value for this value")
             } else {
       $$$TRACE(" found mapping value :"_retVal )
       set value = retVal
            }
           
         }		
		}
		
		if ( codeFound = 0 )
		{
		// look for code in PHQA list
		 set ListFindEvent=context.PhqACodesList.Find(code,"")
        if ( ListFindEvent '= "" )
        {      
            $$$TRACE(" Found code in the PhqA List ")
			set codeFound = 1
             $$$TRACE("  Find Event index :"_ListFindEvent )
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.GenericResultsDelimEpicMigrationHl7Vitals.Lookup.MapPHQA", value, .retVal )
            if ($$$ISERR(status) || (retVal = "Unknown") || (retVal ="")) {       
            $$$TRACE("Unable to find a mapping value for this value")
             } else {
       $$$TRACE(" found mapping value :"_retVal )
       set value = retVal
            }
          }
		
		
		}
		
		if ( codeFound = 0 )
		{
		$$$TRACE("  Try to find code in the EPDS list : "_code)
            $$$TRACE(" get first item from EPDS list :"_context.EpdsCodesList.GetAt(1) )
            set ListFindEvent=context.EpdsCodesList.Find(code,"")
            $$$TRACE("  Find Event index :"_ListFindEvent )
        if ( ListFindEvent '= "" )
        {      
            $$$TRACE(" Found code in the EPDS List ")
			set codeFound = 1
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.GenericResultsDelimEpicMigrationHl7Vitals.Lookup.MapEPDS", value, .retVal )
            if ($$$ISERR(status) || (retVal = "Unknown") || (retVal ="")) {       
            $$$TRACE("Unable to find a mapping value for this value")
             } else {
       $$$TRACE(" found mapping value :"_retVal )
       set value = retVal
            }
          }
		}
		
		if ( codeFound = 0 )
		{
		$$$TRACE("  Try to find code in the GAD list : "_code)
            $$$TRACE(" get first item from GAD list :"_context.GadCodesList.GetAt(1) )
            set ListFindEvent=context.GadCodesList.Find(code,"")
            $$$TRACE("  Find Event index :"_ListFindEvent )
        if ( ListFindEvent '= "" )
        {      
            $$$TRACE(" Found code in the GAD List ")
			set codeFound = 1
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.GenericResultsDelimEpicMigrationHl7Vitals.Lookup.MapGAD", value, .retVal )
            if ($$$ISERR(status) || (retVal = "Unknown") || (retVal ="")) {       
            $$$TRACE("Unable to find a mapping value for this value")
             } else {
       $$$TRACE(" found mapping value :"_retVal )
       set value = retVal
            }
          }
		}
        
		if ( codeFound = 0 )
		{
		$$$TRACE("  Try to find code in the CSSRS list : "_code)
            $$$TRACE(" get first item from CSSRS list :"_context.CssrsCodesList.GetAt(1) )
            set ListFindEvent=context.CssrsCodesList.Find(code,"")
            $$$TRACE("  Find Event index :"_ListFindEvent )
        if ( ListFindEvent '= "" )
        {      
            $$$TRACE(" Found code in the CSSRS List ")
			set codeFound = 1
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.GenericResultsDelimEpicMigrationHl7Vitals.Lookup.MapCSSRS", value, .retVal )
            if ($$$ISERR(status) || (retVal = "Unknown") || (retVal ="")) {       
            $$$TRACE("Unable to find a mapping value for this value")
             } else {
       $$$TRACE(" found mapping value :"_retVal )
       set value = retVal
            }
          }
		}
                 
        
      if ( codeFound = 0 ){
         $$$TRACE("  Try to find code in the One off table : "_code_"-"_value)
         set status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.GenericResultsDelimEpicMigrationHl7Vitals.Lookup.MapOneOffs", code_"-"_value, .retVal )
         if ($$$ISERR(status) || (retVal = "Unknown") || (retVal ="")) {       
            $$$TRACE("Unable to find a mapping value for this value")
         } else {
            $$$TRACE(" found mapping value :"_retVal )
            set value = retVal
            set codefound =1
         }
      }
	             
       do target.SetValueAt( count ,"PIDgrpgrp(1).ORCgrp(1).OBXgrp("_count_").OBX:SetIDOBX" )
       do target.SetValueAt(code, "PIDgrpgrp(1).ORCgrp(1).OBXgrp("_count_").OBX:ObservationIdentifier.identifier") 
       do target.SetValueAt( value ,"PIDgrpgrp(1).ORCgrp(1).OBXgrp("_count_").OBX:ObservationValue(1)")
       do target.SetValueAt( unit ,"PIDgrpgrp(1).ORCgrp(1).OBXgrp("_count_").OBX:Units.identifier")
       
       }
        
        
   }
   
   ]]]]><![CDATA[></code>
