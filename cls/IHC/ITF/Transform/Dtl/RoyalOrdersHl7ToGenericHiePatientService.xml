<Data><![CDATA[
<transform sourceClass='EnsLib.HL7.Message' targetClass='EnsLib.HL7.Message' sourceDocType='RoyalOrders:RoyalOrd231' targetDocType='RoyalOrders:RoyalOrd231' create='new' language='objectscript' >
<assign value='source' property='target' action='set' />
<code disabled='1' >
<![CDATA[ 
  set Pid3count = source.GetValueAt("PIDgrp.PID:PatientIdentifierList(*)")
   
   
   $$$TRACE("Pid3count is : "_Pid3count)]]]]><![CDATA[></code>
<trace value='"outside Pid3count value is " _Pid3count ' disabled='1' />
<if condition='(context.isOrderCMRNPresent = 0 &amp;&amp; context.isVeratoCMRNPresent = 1)' >
<true>
<trace value='"No CMRN is in the Order and Verato returns one of more CMRNs"' />
<comment>
<annotation>Check how many PID-3 is present and insert the CMRN in the last occurrence of PID-3</annotation>
</comment>
<code>
<![CDATA[ 
  set Pid3count = source.GetValueAt("PIDgrp.PID:PatientIdentifierList(*)")
   
   
   $$$TRACE("Pid3count is : "_Pid3count)]]]]><![CDATA[></code>
<if condition='source.{PIDgrp.PID:PatientIdentifierList(Pid3count).ID} =""' >
<true>
<trace value='"PID-3.1 does not have a value. copy cerner mrn in this location"' />
<assign value='context.pid31value' property='target.{PIDgrp.PID:PatientIdentifierList(Pid3count).ID}' action='set' />
<assign value='"EMPI"' property='target.{PIDgrp.PID:PatientIdentifierList(Pid3count).assigningauthority}' action='set' />
<assign value='"MRN"' property='target.{PIDgrp.PID:PatientIdentifierList(Pid3count).identifiertypecode}' action='set' />
</true>
<false>
<assign value='context.pid31value' property='target.{PIDgrp.PID:PatientIdentifierList(Pid3count +1).ID}' action='set' />
<assign value='"EMPI"' property='target.{PIDgrp.PID:PatientIdentifierList(Pid3count +1).assigningauthority}' action='set' />
<assign value='"MRN"' property='target.{PIDgrp.PID:PatientIdentifierList(Pid3count +1).identifiertypecode}' action='set' />
</false>
</if>
</true>
<false>
<trace value='"Pass the original CMRN present in the message"' />
</false>
</if>
</transform>
