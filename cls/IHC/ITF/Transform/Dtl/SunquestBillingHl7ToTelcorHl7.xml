    set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestBillingHl7.TelcorFacilitiesTwoLetterIDs",performingLab,.tAccount)
    $$$TRACE("Faccount was empty in the previous Scenario")
    if ($$$ISOK(tStatus)){ 
      set facAccount=tAccount
      $$$TRACE("FACACCOUNT"_facAccount)
    }else{
      set facAccount = performingLab
    }
