<transform sourceClass='IHC.ITF.Response.CleansePatientDataResponse' targetClass='EnsLib.EDI.XML.Document' targetDocType='PatientMdm:patientMdmRequest' create='new' language='objectscript' >
<foreach property='source.ID.ADDRESS()' key='k1' >
<assign value='source.ID.ADDRESS.(k1).DELIVERYADDRESSLINE1' property='address1' action='set' />
<assign value='address1' property='target.{Address(k1).Address.addrLn1}' action='set' />
<assign value='source.ID.ADDRESS.(k1).DELIVERYADDRESSLINE2' property='address2' action='set' />
<if condition='$length($ZSTRIP(address2,"*W")) &gt; 0' >
<true>
<assign value='address2' property='target.{Address(k1).Address.addrLn2}' action='set' />
</true>
</if>
<assign value='source.ID.ADDRESS.(k1).DELIVERYADDRESSLINE3' property='address3' action='set' />
<if condition='$length($ZSTRIP(address3,"*W")) &gt; 0' >
<true>
<assign value='address3' property='target.{Address(k1).Address.addrLn3}' action='set' />
</true>
</if>
<assign value='source.ID.ADDRESS.(k1).DELIVERYADDRESSLINE4' property='address4' action='set' />
<if condition='$length($ZSTRIP(address4,"*W")) &gt; 0' >
<true>
<assign value='address4' property='target.{Address(k1).Address.addrLn4}' action='set' />
</true>
</if>
<assign value='source.ID.ADDRESS.(k1).LOCALITYCOMPLETE1' property='city' action='set' />
<assign value='city' property='target.{Address(k1).Address.city}' action='set' />
<assign value='source.ID.ADDRESS.(k1).PROVINCECOUNTYSTANDARD1' property='state' action='set' />
<assign value='$ZSTRIP(state,"*WCP")' property='state1' action='set' />
<assign value='source.ID.ADDRESS.(k1).LASTLINEELEMENTSPOSTCODE1' property='target.{Address(k1).Address.pstlCd}' action='set' />
<assign value='source.ID.ADDRESS.(k1).LASTLINEELEMENTSPOSTCODE2' property='postalExt' action='set' />
<if condition='$length($ZSTRIP(postalExt,"*W")) &gt; 0' >
<true>
<assign value='postalExt' property='target.{Address(k1).Address.pstlCdExt}' action='set' />
</true>
</if>
<if condition='($length(state1) &gt; 0)' >
<true>
<assign value='state1' property='target.{Address(k1).Address.state}' action='set' />
</true>
</if>
<assign value='source.ID.ADDRESS.(k1).PROVINCECOUNTYSTANDARD2' property='county' action='set' />
<if condition='$length($ZSTRIP(county,"*W")) &gt; 0' >
<true>
<assign value='county' property='target.{Address(k1).Address.county}' action='set' />
</true>
</if>
<assign value='source.ID.ADDRESS.(k1).COUNTRYISO3CHAR' property='country' action='set' />
<if condition='$length($ZSTRIP(country,"*W")) &gt; 0' >
<true>
<assign value='country' property='target.{Address(k1).Address.cntryCd}' action='set' />
</true>
</if>
<assign value='source.ID.ADDRESS.(k1).POSTCODECOMPLETE' property='zipCode' action='set' />
<assign value='source.ID.ADDRESS.(k1).COMMENT' property='addressType' action='set' />
<if condition='$length($ZSTRIP(addressType,"*W")) &gt; 0' >
<true>
<assign value='addressType' property='target.{Address(k1).addrTp}' action='set' />
</true>
</if>
<assign value='source.ID.ADDRESS.(1).GEOCODINGLONGITUDE' property='target.{Address(1).Address.lngtd}' action='set' />
<assign value='source.ID.ADDRESS.(1).GEOCODINGLATITUDE' property='target.{Address(1).Address.lattd}' action='set' />
<assign value='source.ID.ADDRESS.(1).MATCHCODE_" - "_source.ID.ADDRESS.(1).MATCHCODEDESCRIPTION' property='target.{Address(1).Address.vldtnMsg}' action='set' />

<assign value='context.ihcEmpiNum_"|"_addressType_"|Patient"' property='target.{Address(k1).key}' action='set' />
<assign value='address1_"|"_address2_"|"_city_"|"_state_"|"_country_"|"_zipCode_"|Patient"' property='target.{Address(k1).Address.key}' action='set' />
</foreach>
<foreach property='source.ID.PHONE()' key='k1' >
<assign value='source.ID.PHONE.(k1).PHONENUMBER' property='phnNum' action='set' />
<assign value='source.ID.PHONE.(k1).PHONEFLAG' property='phoneFlag' action='set' />
<if condition='phoneFlag="R"' >
<true>
<trace value='"#### DTL:Invalid Phone number from iCentra Adt. Blanking out. ####"_phnNum' />
</true>
<false>
<if condition='$length($ZSTRIP(phnNum,"*W")) &gt; 0' >
<true>
<assign value='phnNum' property='target.{Phone(k1).phnNum}' action='set' />
<assign value='source.ID.PHONE.(k1).COMMENT' property='phoneTypeWithExt' action='set' />
<assign value='""' property='phTypeWithExtList' action='set' />
<assign value='""' property='phoneTypeExt' action='set' />
<code>
<![CDATA[ 
    set phTypeWithExtList = $LISTFROMSTRING(phoneTypeWithExt, "##")
    set phoneType = $LIST(phTypeWithExtList,1)
    set phoneTypeExt = $LIST(phTypeWithExtList,2) 
 ]]]]><![CDATA[></code>
<if condition='$length($ZSTRIP(phoneType,"*W")) &gt; 0' >
<true>
<assign value='phoneType' property='target.{Phone(k1).phnTp}' action='set' />
</true>
</if>
<assign value='$ZSTRIP(phoneTypeExt,"*W")' property='updPhnExt' action='set' />
<if condition='($length(updPhnExt) &gt; 10)' >
<true>
<trace value='"#### DTL: Phone extension from iCentra Adt lenght is more than 10. Blanking out. ####"_updPhnExt' />
</true>
<false>
<if condition='($length(updPhnExt) &gt; 0)' >
<true>
<assign value='updPhnExt' property='target.{Phone(k1).phnNumExt}' action='set' />
</true>
</if>
</false>
</if>
<assign value='context.ihcEmpiNum_"|"_phoneType_"|Patient"' property='target.{Phone(k1).key}' action='set' />
</true>
</if>
</false>
</if>
</foreach>
</transform>
]]></Data>
