<trace value='"ORC, OBR mapping done"' />
<trace value='"OBXgrp #: " _ source.{PIDgrpgrp(1).ORCgrp(1).OBXgrp("*")}' />
<assign value='1' property='context.outputObxIndex' action='set' />
<foreach property='source.{PIDgrpgrp(1).ORCgrp()}' key='k1' >
<code>
<![CDATA[ set isObr4Translated = 0
 set servCode = source.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBR:UniversalServiceIdentifier.identifier")
  set retVal = ""
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("TmisResultsObr4ToObr4Translation", servCode, .retVal )
  $$$TRACE("TmisResultsObr4ToObr4Translation ItfLookup: value: " _ servCode _ ", stat: " _ retStat _ " retVal = " _ retVal )

 if ($$$ISOK(retStat))
 {
   set tSC1 = target.SetValueAt(retVal, "PIDgrpgrp("_1_").ORCgrp("_k1_").OBR:UniversalServiceIdentifier.identifier", "set", "")
   set isObr4Translated = 1
   $$$TRACE("OBR-4 value was translated, set isObr4Translated ")
 } 
]]]]><![CDATA[></code>
<foreach property='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp()}' key='k2' >
<assign value='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX}' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX}' action='set' />
<assign value='context.outputObxIndex' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX:SetIDOBX}' action='set' />
<assign value='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX:ObservationIdentifier.identifier}' property='context.obx3Val' action='set' />
<if condition='$get(isObr4Translated) = 0' >
<annotation>We didn&#39;t already translate the OBR-4.1</annotation>
<true>
<trace value='"OBR-4.1 value not translated. get OBX_3_ObservationIdentifier: " _ source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX:ObservationIdentifier.identifier}' />
<trace value='"UniversalServiceIdentifier: " _ source.{PIDgrpgrp(k1).ORCgrp(k2).OBR:UniversalServiceIdentifier.identifier}' />
<code>
<![CDATA[ //  We didn't already translate the OBR-4.1 value, so look at the OBX-3.1 value
 set retVal = ""
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("TmisResultsObx3ToObr4Translation", context.obx3Val , .retVal )
 $$$TRACE("mapObx3ToObr4, val: " _ context.obx3Val _ ", stat: " _ retStat _ " retVal: " _ retVal )
 if ($$$ISOK(retStat))
 {
  $$$TRACE("This is a code whose translated value needs to replace")
  set oldId = context.obx3Val 
  set newObsId = ""
  set context.obx3Val = retVal
  // Check if it mapped to two values rather than one
  set dashInd = $FIND(context.obx3Val ,",")
  if (dashInd > 0)
  {
    $$$TRACE("Map returned two values : " _ context.obx3Val )
    set newObsId = $EXTRACT(context.obx3Val , dashInd, $Length(context.obx3Val))
    set context.obx3Val = $EXTRACT(context.obx3Val , 1, dashInd -2)
  }
  // OBR4 is not same as OBX3
  if ( source.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBR:UniversalServiceIdentifier.identifier") '= context.obx3Val )
  {
    // We need to translate obr-4.1.
    set stat =  target.SetValueAt(context.obx3Val , "PIDgrpgrp(1).ORCgrp("_k1_").OBR:UniversalServiceIdentifier.identifier", "set", "")
    $$$TRACE("translate obr-4.1: " _ context.obx3Val )
   }
 
  if ( newObsId '= "")
  {
   // replace OBX-3.1 with the 2nd value
   set stat =  target.SetValueAt(newObsId, "PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ObservationIdentifier.identifier", "set", "")
   set context.obx3Val = newObsId
   $$$TRACE("replace OBX-3.1 with the 2nd value: " _ newObsId)
  }
 
 }
 ]]]]><![CDATA[></code>
</true>
</if>
<trace value='"OBX:ObservationIdentifier: " _ target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX:ObservationIdentifier.identifier}' />
<trace value='"OBR:UniversalServiceIdentifier: " _  target.{PIDgrpgrp(k1).ORCgrp(k2).OBR:UniversalServiceIdentifier.identifier}' />
<trace value='"OBX:ObservationValue: " _ source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX:ObservationValue()}' />
<code>
<annotation>check TmisResultsObx3ToObx2Translation</annotation>
<![CDATA[ set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("TmisResultsObx3ToObx2Translation", context.obx3Val, .retVal )
 if ($$$ISOK(retStat))
  {
    // We need to change OBX-2 to the translated value.
    set stat =  target.SetValueAt(retVal, "PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_context.outputObxIndex_").OBX:ValueType", "set", "")
    $$$TRACE("Change OBX-2 to the translated value: " _ retVal)
  }
]]]]><![CDATA[></code>
<assign value='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX:ProducersID}' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ProducersID}' action='set' />
<code>
<![CDATA[ set obx15 = source.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ProducersID.identifier")
    set retVal = ""
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("TmisResultsPerformingLocationTranslation", obx15, .retVal )
 $$$TRACE("mapObx15ToObx15: " _ obx15 _ " - " _ retVal )
 if ($$$ISOK(retStat))
 {
   set obx15 = retVal
 }
  Set tSC1=target.SetValueAt(obx15, "PIDgrpgrp("_(1)_").ORCgrp("_(k1)_").OBXgrp("_context.outputObxIndex_").OBX:ProducersID.identifier","set","")
  $$$TRACE("Set OBX:ProducersID.identifier: " _ tSC1)
 ]]]]><![CDATA[></code>
<code>
<![CDATA[  // Populate OBX-5 last, to ease handling of cases where each repetition must be sent as a separate ORU transaction
  set serviceCode = target.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBR:UniversalServiceIdentifier.identifier")
  set obx5Cnt = source.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ObservationValue(*)")
  $$$TRACE("# of OBX-5:ObservationValue: " _ obx5Cnt )
 For obx5Index=1:1:obx5Cnt 
 {
   set obsVal = source.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ObservationValue("_obx5Index_")")
   set retVal = ""
   set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("TmisResultsObr4RestrictingObx5Repetition", serviceCode , .retVal )
   $$$TRACE(obx5Index _ ". TmisResultsObr4RestrictingObx5Repetition lookup: " _ retStat _ ", val: " _ serviceCode _ " : " _ retVal) 

   if ((serviceCode = "XMT") && (obsVal = "STP"))
   {
    // It's an STP result value, so we need to translate it
    set obsVal =  "XT"
   }
   if ( ($$$ISOK(retStat))  && (obx5Cnt > 1))
   {
     set msgId = source.GetValueAt("MSH:MessageControlID")
   
     Set tSC1=target.SetValueAt(obx15, "PIDgrpgrp("_(1)_").ORCgrp("_(k1)_").OBXgrp("_context.outputObxIndex_").OBX:ObservationValue(1)","set","")
     Set tSC1=target.SetValueAt(msgId _ "-" _ obx5Index, "MSH:MessageControlID", "set", "")
     if (obx5Index < obx5Cnt )
     {
        $$$TRACE("SEND multi records")
        Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError($CLASSNAME(), "Sending multi records is not Implemented. multiple OBX segments: " _ obx5Cnt )
     }

   }
   else
   {
     if (obx5Index > 1)
     {
       set obsVal = "~" _ obsVal
     }
     // set obx-5
     Set tSC1=target.SetValueAt(obsVal, "PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ObservationValue("_obx5Index_")", "set", "")
   }
  } 
 ]]]]><![CDATA[></code>
<if condition='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX:ObservationIdentifier.identifier} = "TITER" ' >
<true>
