<assign value='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).OBX}' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX}' action='append' />
<assign value='context.outputObxIndex' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:SetIDOBX}' action='set' />
<assign value='"TX"' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ValueType}' action='set' />
<assign value='"TITER"' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ObservationIdentifier.identifier}' action='set' />
<assign value='"1"' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ObservationSubID}' action='set' />
<assign value='"F"' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ObservResultStatus}' action='set' >
<annotation>FINAL</annotation>
</assign>
<assign value='""' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ObservationIdentifier.alternateidentifier}' action='set' />
<assign value='""' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ObservationValue()}' action='set' />
<assign value='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).NTE(1):Comment(1)}' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ObservationValue()}' action='set' />
<assign value='""' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).OBX:ResponsibleObserver}' action='set' />
<code>
<annotation>set OBX-15</annotation>
<![CDATA[ set obx15 = source.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ProducersID.identifier")
    set retVal = ""
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("TmisResultsPerformingLocationTranslation", obx15, .retVal )
 $$$TRACE("mapObx15ToObx15: " _ obx15 _ " - " _ retVal )
 if ($$$ISOK(retStat))
 {
   set obx15 = retVal
 }
  Set tSC1=target.SetValueAt(obx15, "PIDgrpgrp("_(1)_").ORCgrp("_(k1)_").OBXgrp("_context.outputObxIndex_").OBX:ProducersID.identifier","set","")
  $$$TRACE("Set OBX:ProducersID.identifier: " _ tSC1)
 ]]]]><![CDATA[></code>
<trace value='"TITER: added one more OBX. cmt:" _ source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).NTE(1):Comment(1)}' />
</true>
<false>
<assign value='source.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).NTE()}' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).NTE()}' action='set' />
<trace value='"Added NTE: " _ k1 _ "/ " _ k2' />
<assign value='k1 + context.outputObxIndex' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(context.outputObxIndex).NTE():SetIDNotesandComments}' action='set' />
<assign value='$REPLACE(source.{PIDgrpgrp(1).ORCgrp(context.outputObxIndex).OBXgrp(k2).NTE(1):Comment(1)}, "-", " ")' property='target.{PIDgrpgrp(1).ORCgrp(k1).OBXgrp(k2).NTE():Comment()}' action='set' />
</false>
</if>
<assign value='context.outputObxIndex + 1' property='context.outputObxIndex' action='set' />
</foreach>
</foreach>
<trace value='"DTL complete, OBX: " _ context.outputObxIndex' />
</transform>
]]></Data>
