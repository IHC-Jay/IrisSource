<code>
<![CDATA[ // Source system sending Diagnosis in the format code~Version^Code~version and telcor expects it as code~code as result of their enhancement
 SET delim="^"
 set sep="~"
 SET countdown=$LENGTH(wDiagnosisCode,delim)
 set wTargetDiagnosisCode=""
 SET countup=1
 FOR reps=countdown:-1:1 {
    SET extract=$PIECE(wDiagnosisCode,delim,countup) 
    set extract=$piece(extract,sep)
    if (extract'=""){
       set wTargetDiagnosisCode=wTargetDiagnosisCode_sep_extract
    }
    SET countup=countup+1
 }
 set wTargetDiagnosisCode=$zstrip(wTargetDiagnosisCode,"<",sep)
 ]]]]><![CDATA[></code>
