<code>
<![CDATA[ // Determine finanacial class
 set tNewFinancialClass=cFCSELFPAY // Specify the default financial class
 If (tIsInstitutionalPatient){
    set tNewFinancialClass = cFCCLIENT
 }else {
    If ($Length(tPrimaryInsCoID)>0){
       set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerPathDftHl7ToTelcorBill.Lookup.InsurancePlanIDtoTelcorFinancialClass", tPrimaryInsCoID, .tNewFinancialClass )  
       // If not fount make last Digit as Donot Care Digit ? and try looking up again
       if ($$$ISERR(tStatus)){
          set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerPathDftHl7ToTelcorBill.Lookup.InsurancePlanIDtoTelcorFinancialClass", $e(tPrimaryInsCoID,1,3)_"?", .tNewFinancialClass )
       }       
       // If not fount make last Digit as Donot Care Digit ? and try looking up again
       if ($$$ISERR(tStatus)){    
          set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerPathDftHl7ToTelcorBill.Lookup.InsurancePlanIDtoTelcorFinancialClass", $e(tPrimaryInsCoID,1,2)_"??", .tNewFinancialClass )
       }      
       // If still not found set it to Commercial plan
       if ($$$ISERR(tStatus)){  
          set tNewFinancialClass=cFCCOMMERCIAL
       } 
     }    
  }
  // Telcor finanacial class length cannot be >8
  If ($length(tNewFinancialClass)>8){
     set tNewFinancialClass =$e(tNewFinancialClass,1,8)
  }
  
 ]]]]><![CDATA[></code>
