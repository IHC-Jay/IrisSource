   set patLocListLength = $LISTLENGTH(patLocList)  
   if patLocListLength>2{	   
	 set nuresLoc = $LIST(patLocList,1) 
	 set building = $LIST(patLocList,2) 	 
	 set facility = $LIST(patLocList,3) 	 
   }elseIF  patLocListLength>1{
	 set nuresLoc = $LIST(patLocList,1) 
	 set building = $LIST(patLocList,2) 	 	  	
   }elseIF  patLocListLength=1{
	   set nuresLoc = $LIST(patLocList,1) 
   }   
   ]]]]><![CDATA[></code>
<assign value='building' property='target.{PV1:AssignedPatientLocation.building}' action='set' />
