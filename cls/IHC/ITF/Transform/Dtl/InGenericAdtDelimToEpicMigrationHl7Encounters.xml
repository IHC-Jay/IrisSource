<code>
<![CDATA[ // Split the patient name    
   set patNameList = $LISTFROMSTRING(patName, "^")
   set patNameListLen = $LISTLENGTH(patNameList)  
   if patNameListLen>2{	   
	 set last = $LIST(patNameList,1) 
	 set first = $LIST(patNameList,2) 	 
	 set mid = $LIST(patNameList,3) 	 
   }elseIF  patNameListLen>1{
	 set last = $LIST(patNameList,1) 
	 set first = $LIST(patNameList,2) 	 	  	
   }elseIF  patNameListLen=1{
	   set last = $LIST(patNameList,1) 
   }   
   ]]]]><![CDATA[></code>
<assign value='last' property='target.{PID:PatientName(1).familyname.surname}' action='set' />
<assign value='first' property='target.{PID:PatientName(1).givenname}' action='set' />
