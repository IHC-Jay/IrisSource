       }
    }elseif ($P(AnswerPiece3,"_",1) ="ZSA") {
       set ZSAAnswer =$P(AnswerPiece1,"-",2)
    }
    
    if ($P(QuestionPiece1,"_",1) ="ZBL") {
       //Determine answer type
       if (AnswerPiece2="Picklist") {
          Set ZBLAnswer =$P(AnswerPiece1,"-",2)
       }elseif (AnswerPiece2="DateTime") {
          set Year=$P(AnswerPiece1," ",3)
          set Month=$P(AnswerPiece1," ",2)
          set Day=$P(AnswerPiece1," ",1)
          set Month =$CASE(Month,"JAN":"01","FEB":"02","MAR":"03","APR":"04","MAY":"05","JUN":"06","JUL":"07","AUG":"08","SEP":"09","OCT":"10","NOV":"11","DEC":"12")
          set ZBLAnswer =Year_Month_Day 
