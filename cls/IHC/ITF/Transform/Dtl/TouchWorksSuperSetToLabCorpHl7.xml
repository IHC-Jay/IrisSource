          set ZCIAnswer =Year_Month_Day 
       }else {
          set ZCIAnswer =AnswerPiece1
       } 
    }elseif ($P(AnswerPiece3,"_",1) ="ZCI") {
       set ZCIAnswer =$P(AnswerPiece1,"-",2)
    }
    if ($P(QuestionPiece1,"_",1) ="ZSA") {
