    if ($P(QuestionPiece1,"_",1) ="ZCI") {
       //Determine answer type
       if (AnswerPiece2="Picklist") {
          Set ZCIAnswer =$P(AnswerPiece1,"-",2)
       }elseif (AnswerPiece2="DateTime") {
          set Year=$P(AnswerPiece1," ",3)
          set Month=$P(AnswerPiece1," ",2)
