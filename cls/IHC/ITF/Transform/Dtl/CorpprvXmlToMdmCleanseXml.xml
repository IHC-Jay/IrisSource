<DependsOn>IHC.ITF.DStruc.Schema.CORPPRVProviderRequest.CORPPRVPROVIDER,Request.CleanseProviderDataRequest</DependsOn>

<Parameter name="IGNOREMISSINGSOURCE">
<Default>1</Default>
</Parameter>

<Parameter name="REPORTERRORS">
<Default>1</Default>
</Parameter>

<Parameter name="TREATEMPTYREPEATINGFIELDASNULL">
<Default>0</Default>
</Parameter>

<XData name="DTL">
<XMLNamespace>http://www.intersystems.com/dtl</XMLNamespace>
<Data><![CDATA[
<transform sourceClass='IHC.ITF.DStruc.Schema.CORPPRVProviderRequest.CORPPRVPROVIDER' targetClass='Request.CleanseProviderDataRequest' create='new' language='objectscript' >
<trace value='"In DTL to map to MDM CORPPRVProvider: "' />
<assign value='0' property='phNum' action='set' />
<assign value='"CORPPRV"' property='target.ID.NAME.(1).SRCSYSTEM' action='set' />
<assign value='source.PROVIDERDEMOGRAPHIC.ADVPROVIDERPRVDRID.content' property='target.ID.NAME.(1).SRCPRVDRID' action='set' />
<assign value='""' property='addrSeq' action='set' />
<assign value=' source.PROVIDERDEMOGRAPHIC.ADVPROVIDERFIRSTNM.content ' property='target.ID.NAME.(1).FIRSTNAME' action='set' />
<assign value=' source.PROVIDERDEMOGRAPHIC.ADVPROVIDERMIDDLENM.content' property='target.ID.NAME.(1).MIDDLENAME' action='set' />
<assign value='source.PROVIDERDEMOGRAPHIC.ADVPROVIDERTITLENM.content' property='target.ID.NAME.(1).TITLE' action='set' />
<assign value='""' property='target.ID.NAME.(1).SUFFIX' action='set' />
<assign value=' source.PROVIDERDEMOGRAPHIC.ADVPROVIDERLASTNM.content' property='target.ID.NAME.(1).LASTNAME' action='set' />
<assign value=' "CORPPRV"  ' property='target.ID.NAME.(1).COMMENT' action='set' />
<assign value='1' property='addrInd' action='set' />
<foreach property='source.ADDRESSINFO()' key='k2' >
<trace value='"Map ADDRESS and Phone: " _  k2' />
<assign value=' $ZSTRIP(source.ADDRESSINFO.(k2).ADVPRVDRADDRADDRLINE1TXT.content,  "&lt;&gt;WC")  ' property='target.ID.ADDRESS.(addrInd).ADDRESSLINE1' action='set' />
<assign value=' $ZSTRIP(source.ADDRESSINFO.(k2).ADVPRVDRADDRADDRLINE1TXT.content,  "&lt;&gt;WC")  ' property='addrSrcKey' action='set' />
<foreach property='context.corpprvResponse.addrList' key='k3' >
<if condition='source.ADDRESSINFO.(k2).ADVPRVDRADDRADDRLINE1TXT.content = context.corpprvResponse.addrList.(k3).AddrLine1' >
<true>
<assign value='context.corpprvResponse.addrList.(k3).AddrSeq' property='addrSeq' action='set' />
</true>
</if>
</foreach>
<if condition='$L($ZSTRIP(source.ADDRESSINFO.(k2).ADVPRVDRADDRADDRLINE2TXT.content,  "&lt;&gt;WC")) &gt; 0' >
<true>
<assign value=' source.ADDRESSINFO.(k2).ADVPRVDRADDRADDRLINE2TXT.content  ' property='target.ID.ADDRESS.(addrInd).ADDRESSLINE2' action='set' />
<assign value='addrSrcKey _ "|" _  source.ADDRESSINFO.(k2).ADVPRVDRADDRADDRLINE2TXT.content  ' property='addrSrcKey' action='set' />
</true>
<false>
<assign value='addrSrcKey _ "|"' property='addrSrcKey' action='set' />
</false>
</if>
<assign value='source.ADDRESSINFO.(k2).ADVPRVDRADDRCITYNM.content' property='target.ID.ADDRESS.(addrInd).CITY' action='set' />
<assign value='addrSrcKey _ "|" _ source.ADDRESSINFO.(k2).ADVPRVDRADDRCITYNM.content' property='addrSrcKey' action='set' />
<assign value=' source.ADDRESSINFO.(k2).ADVPRVDRADDRSTATECD.content  ' property='target.ID.ADDRESS.(addrInd).STATE' action='set' />
<assign value='addrSrcKey _ "|" _  source.ADDRESSINFO.(k2).ADVPRVDRADDRSTATECD.content  ' property='addrSrcKey' action='set' />
<assign value=' source.ADDRESSINFO.(k2).ADVPRVDRADDRCOUNTYID.content  ' property='target.ID.ADDRESS.(addrInd).COUNTY' action='set' />
<if condition='$L($ZSTRIP(source.ADDRESSINFO.(k2).ADVPRVDRADDRCOUNTRY.content,  "&lt;&gt;WC")) &gt; 0' >
<true>
<assign value=' source.ADDRESSINFO.(k2).ADVPRVDRADDRCOUNTRY.content  ' property='target.ID.ADDRESS.(addrInd).COUNTRY' action='set' />
</true>
<false>
<assign value=' "USA"  ' property='target.ID.ADDRESS.(addrInd).COUNTRY' action='set' />
</false>
</if>
<assign value=' source.ADDRESSINFO.(k2).ADVPRVDRADDRPOSTALCODE.content  ' property='target.ID.ADDRESS.(addrInd).ZIPCODE' action='set' />
<assign value='addrSrcKey _ "|" _  source.ADDRESSINFO.(k2).ADVPRVDRADDRPOSTALCODE.content  ' property='addrSrcKey' action='set' />
<if condition='source.ADDRESSINFO.(k2).ADVPRVDRADDRPRMRYFLG.content = "Y"' >
<true>
<assign value='addrSeq _ "#^#Active:Y#^#" _ addrSrcKey' property='target.ID.ADDRESS.(addrInd).COMMENT' action='set' />
</true>
<false>
<assign value='addrSeq _ "#^#Active:N#^#" _ addrSrcKey' property='target.ID.ADDRESS.(addrInd).COMMENT' action='set' />
</false>
</if>
<if condition='$L($ZSTRIP(source.ADDRESSINFO.(k2).ADVPRVDRADDRPHONENO.content , "&lt;&gt;WC")) &gt; 0' >
<true>
<assign value='phNum + 1' property='phNum' action='set' />
<assign value=' source.ADDRESSINFO.(k2).ADVPRVDRADDRPHONENO.content  ' property='target.ID.PHONE.(phNum).PHONENUMBER' action='set' />
<assign value=' addrSeq _ "#^#PHONE#^#Active:" _ source.ADDRESSINFO.(k2).ADVPRVDRADDRPRMRYFLG.content  ' property='target.ID.PHONE.(phNum).COMMENT' action='set' />
<trace value='"target.ID.PHONE.(" _ phNum _ ").PHONENUMBER"' />
</true>
<false>
<trace value='k2 _ ". Phone is EMPTY"' />
</false>
</if>
<if condition='$L($ZSTRIP(source.ADDRESSINFO.(k2).ADVPRVDRADDRFAXNO.content, "&lt;&gt;WC")) &gt; 0' >
<true>
<assign value='phNum + 1' property='phNum' action='set' />
<assign value=' source.ADDRESSINFO.(k2).ADVPRVDRADDRFAXNO.content  ' property='target.ID.PHONE.(phNum).PHONENUMBER' action='set' />
<assign value=' addrSeq _ "#^#FAX#^#Active:"_ source.ADDRESSINFO.(k2).ADVPRVDRADDRPRMRYFLG.content  ' property='target.ID.PHONE.(phNum).COMMENT' action='set' />
<trace value='"target.ID.PHONE.(" _ phNum _ ").PHONENUMBER"' />
</true>
<false>
<trace value='k2 _ ". Fax is EMPTY"' />
</false>
</if>
<assign value='addrInd + 1' property='addrInd' action='set' />
</foreach>
<foreach property='context.corpprvResponse.facList.()' key='k3' >
<trace value='addrInd _ ". Set ORG address from corpprvResponse"' />
<trace value='"context.corpprvResponse.facList.(" _ k3 _ ").FACAADR1"' />
<assign value='context.corpprvResponse.facList.(k3).FACAADR1' property='FACAADR1' action='set' />
<code>
<![CDATA[ set newVal = ##class(IHC.ITF.ITFCOMMON.Util.XmlSpecialCharRepalce).replace(FACAADR1)]]]]><![CDATA[></code>
<trace value='"old: " _ FACAADR1 _ ", new: " _ newVal' />
<assign value='newVal' property='target.ID.ADDRESS.(addrInd).ADDRESSLINE1' action='set' />
<assign value='context.corpprvResponse.facList.(k3).FACAADR2' property='target.ID.ADDRESS.(addrInd).ADDRESSLINE2' action='set' />
<assign value='context.corpprvResponse.facList.(k3).FACCITY' property='target.ID.ADDRESS.(addrInd).CITY' action='set' />
<assign value='context.corpprvResponse.facList.(k3).FACZIP' property='target.ID.ADDRESS.(addrInd).ZIPCODE' action='set' />
<assign value='context.corpprvResponse.facList.(k3).FCILITYID' property='target.ID.ADDRESS.(addrInd).COMMENT' action='set' />
<assign value='addrInd + 1' property='addrInd' action='set' />
</foreach>
<trace value='"DTL complete for CORPPRVProvider cleanse service " ' />
</transform>
]]></Data>
</XData>
</Class>
</Export>
