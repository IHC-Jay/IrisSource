<foreach property='source.{PID:PhoneNumberHome()}' key='k2' >
<code>
<![CDATA[  set isUseCodeNet = 0
  set areaCode=""
  set phoneNo=""
  set phoneType=""
  set emailAdd =""

  
  set tUseCode= source.GetValueAt("PID:PhoneNumberHome("_(k2)_").telecommunicationusecode")
  if ((tUseCode '= "NET") && (tUseCode '= "EMR"))
  {
     set telEqupType = source.GetValueAt("PID:PhoneNumberHome("_(k2)_").telecommunicationequipmentty") 
     
     $$$TRACE("Value of tUseCode : "_tUseCode)
     $$$TRACE("Value of telEqupType : "_telEqupType)
     
     if (($L(telEqupType )> 0) && ($L(tUseCode)> 0))
     {
       set telType   = tUseCode_"-"_telEqupType
       $$$TRACE("Value of telType : "_telType)
     }
     
     set areaCode = source.GetValueAt("PID:PhoneNumberHome("_(k2)_").Areacitycode")
     set phoneNo= source.GetValueAt("PID:PhoneNumberHome("_(k2)_").Phonenumber")
     set mtch = $LOCATE(phoneNo,"[^\w\s]")
 
     while (mtch > 0)
     {
       set mtch = $LOCATE(phoneNo,"[^\w\s]")
       set phoneNo= $REPLACE(phoneNo,$EXTRACT(phoneNo,mtch),"")
     }
  
  if ($L(telType)> 0)
     {
        set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.RtCbRegHl7ToCdr.Lookup.PhoneTypeMap", telType, .retVal )	        
        if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) 
        {       
    	   set phoneType = ""	  	      	
        }
        else
        {
    	   set phoneType = retVal
        }
        $$$TRACE("Value of phoneType : "_phoneType) 
     } 
   }
   elseif (tUseCode = "NET")
   {
     set isUseCodeNet = 1
     set emailAdd = source.GetValueAt("PID:PhoneNumberHome("_(k2)_").Emailaddress") 
     
   }]]]]><![CDATA[></code>
