<assign value='source.{MSH}' property='target.{MSH}' action='set' />
<assign value='"INT1"' property='target.{MSH:ReceivingApplication.namespaceID}' action='set' />
<assign value='""' property='target.{MSH:ReceivingFacility.namespaceID}' action='set' />
<assign value='""' property='target.{MSH:ProcessingID.processingmode}' action='set' />
<assign value='' property='target.{MSH:ProcessingID.processingmode}' action='remove' />
<code>
<![CDATA[ $$$TRACE("Have MSH_9_2 Event Type: " _context.MSH92)
 if (context.MSH92 = "A05"){
   set context.MSH92 = "A01"
   $$$TRACE("Changing MSH_9_2 to: " _context.MSH92)  
 }elseIF (context.MSH92 = "A38"){
   set context.MSH92 = "A11"
   $$$TRACE("Changing MSH_9_2 to: " _context.MSH92)
 }elseIF (context.MSH92 = "A44"){
   set context.MSH92 = "A18"
   $$$TRACE("Changing MSH_9_2 to: " _context.MSH92)
 }else{
   $$$TRACE("Not Changing MSH_9_2.")
  }]]]]><![CDATA[></code>
<assign value='context.MSH92' property='target.{MSH:MessageType.triggerevent}' action='set' />
<assign value='"2.3"' property='target.{MSH:VersionID.versionID}' action='set' />
<assign value='source.{EVN}' property='target.{EVN}' action='set' />
<assign value='source.{PID}' property='target.{PID}' action='set' />
<foreach property='target.{PID:PatientIdentifierList()}' key='k1' >
<assign value='context.msh4Facility' property='target.{PID:PatientIdentifierList(k1).assigningauthority.namespaceID}' action='set' />
</foreach>
<foreach property='target.{PID:PhoneNumberHome()}' key='k2' >
<assign value='..Translate(target.{PID:PhoneNumberHome(k2).phonenumber1},"()-.")' property='target.{PID:PhoneNumberHome(k2).phonenumber1}' action='set' />
</foreach>
<foreach property='target.{PID:PhoneNumberBusiness()}' key='k3' >
<assign value='..Translate(target.{PID:PhoneNumberBusiness(k3).phonenumber1},"()-.")' property='target.{PID:PhoneNumberBusiness(k3).phonenumber1}' action='set' />
</foreach>
<foreach property='target.{PID:AlternatePatientIDPID()}' key='k1' >
<if condition='..Length(target.{PID:AlternatePatientIDPID(k1).ID})&lt;1' >
<true>
<assign value='"000000"' property='target.{PID:AlternatePatientIDPID(k1).ID}' action='set' />
<trace value='"No PID-4.1, setting to 000000"' />
</true>
<false>
<trace value='"PID-4.1 has a valid ID"' />
</false>
</if>
</foreach>
<assign value='source.{MRG}' property='target.{MRG}' action='set' />
<foreach property='source.{NK1()}' key='k1' >
<trace value='"Working NK1"' />
<assign value='source.{NK1(k1)}' property='target.{NK1(k1)}' action='set' />
<trace value='"Set Target NK1 from Source NK1"' />
<if condition='$LENGTH(target.{NK1(k1):Name().middleinitialorname}&gt;0) &amp;&amp; $MATCH(target.{NK1(k1):Name().middleinitialorname},$CHAR(92,34,92,34))' >
<true>
<assign value='""' property='target.{NK1(k1):Name().middleinitialorname}' action='set' />
<trace value='"NK1 Middle Name is a delete string, setting to empty string"' />
</true>
<false>
<trace value='"NK1 Middle Name is not a delete string"' />
</false>
</if>
<if condition='$LENGTH(target.{NK1(k1):Name().suffix}) &amp;&amp; $MATCH(target.{NK1(k1):Name().suffix}, $CHAR(92,34,92,34))' >
<true>
<assign value='""' property='target.{NK1(k1):Name().suffix}' action='set' />
<trace value='"NK1 Suffix is a delete string, setting to empty string" ' />
</true>
<false>
<trace value='"NK1 Suffix Name not a delete string"' />
</false>
</if>
<if condition='$LENGTH(target.{NK1(k1):Name().prefix}) &amp;&amp; $MATCH(target.{NK1(k1):Name().prefix},$CHAR(92,34,92,34))' >
<true>
<assign value='""' property='target.{NK1(k1):Name().prefix}' action='set' />
<trace value='"NK1 Prefix is delete string, setting to empty string."' />
</true>
<false>
<trace value='"NK1 Prefix not a delete string"' />
</false>
</if>
<assign value='..Translate(target.{NK1(k1):PhoneNumber().phonenumber1},"()-.")' property='target.{NK1(k1):PhoneNumber().phonenumber1}' action='set' />
<assign value='..Translate(target.{NK1(k1):BusinessPhoneNumber().phonenumber1},"()-.")' property='target.{NK1(k1):BusinessPhoneNumber().phonenumber1}' action='set' />
</foreach>
<assign value='source.{PV1}' property='target.{PV1}' action='set' />
<assign value='context.pointOfCareUnit' property='target.{PV1:AssignedPatientLocation.pointofcare}' action='set' />
<assign value='context.Room' property='target.{PV1:AssignedPatientLocation.room}' action='set' />
<assign value='context.Bed' property='target.{PV1:AssignedPatientLocation.bed}' action='set' />
<assign value='context.msh4Facility' property='target.{PV1:AssignedPatientLocation.facilityHD.namespaceID}' action='set' />
<assign value='context.finPID18' property='target.{PV1:VisitNumber.ID}' action='set' />
<assign value='""' property='target.{PV1:ServicingFacility}' action='set' />
<if condition='source.{DG1(1)}&apos;="" ' >
<true>
<trace value='"We have DG1 segments"' />
<trace value='"Check Event type and against global value NoDG1Events if not A02, A03, A18 or any other event in global, then map DG1 segment. Otherwise DO NOT map DG1 segment."' />
<code>
<![CDATA[ set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"NoDG1Events",.configValue)           
 $$$TRACE("NoDG1Events: " _$GET(^IHC.CernAdtHl7ToConnectRx("NoDG1Events")))
 if ($GET(^IHC.CernAdtHl7ToConnectRx("NoDG1Events"))'=""){
    $$$TRACE("NoDG1Events Global has values:  "_$GET(^IHC.CernAdtHl7ToConnectRx("NoDG1Events")))
    $$$TRACE("These are the events that don't want DG1 segments...")
    $$$TRACE("So Here is the current context.MSH92 being used to check against NoDG1Events: " _context.MSH92)

 }else{
     $$$TRACE("Global NoDG1Events has no values.")
 }]]]]><![CDATA[></code>
<if condition='..NotIn(context.MSH92,$GET(^IHC.CernAdtHl7ToConnectRx("NoDG1Events")))' >
<true>
<trace value='"Doing DG1 Mapping!"' />
<foreach property='source.{DG1()}' key='k1' >
<trace value='"Setting Target DG1 from Source DG1"' />
<assign value='source.{DG1(k1)}' property='target.{DG1(k1)}' action='set' />
<trace value='"Target DG1-6 is: " _target.{DG1(k1):DiagnosisType}' />
<if condition='target.{DG1(k1):ConfidentialIndicator}="P"' >
<true>
<assign value='""' property='target.{DG1(k1):ConfidentialIndicator}' action='set' />
<trace value='"Removed P value for DG1-18 Confidential Indicator, set it to empty string"' />
</true>
<false>
<trace value='"No P value found for DG1-18 Confidential Indicator"' />
</false>
</if>
</foreach>
</true>
<false>
<trace value='"Not mapping DG1 segment due to Not Allowed DG1 Event type found: "_context.MSH92' />
</false>
</if>
</true>
<false>
<trace value='"We do not have DG1 segments, not doing DG1 mapping"' />
</false>
</if>
<foreach property='source.{GT1()}' key='k1' >
<assign value='source.{GT1(k1)}' property='target.{GT1(k1)}' action='set' />
<foreach property='target.{GT1(k1):GuarantorPhNumHome()}' key='k2' >
<assign value='..Translate(target.{GT1(k1):GuarantorPhNumHome(k2).phonenumber1},"()-.")' property='target.{GT1(k1):GuarantorPhNumHome(k2).phonenumber1}' action='set' />
</foreach>
<foreach property='target.{GT1(k1):GuarantorPhNumBusiness()}' key='k3' >
<assign value='..Translate(target.{GT1(k1):GuarantorPhNumBusiness(k3).phonenumber1},"()-.")' property='target.{GT1(k1):GuarantorPhNumBusiness(k3).phonenumber1}' action='set' />
</foreach>
<foreach property='target.{GT1(k1):GuarantorEmployerPhoneNumber()}' key='k4' >
<assign value='..Translate(target.{GT1(k1):GuarantorEmployerPhoneNumber(k4).phonenumber1},"()-.")' property='target.{GT1(k1):GuarantorEmployerPhoneNumber(k4).phonenumber1}' action='set' />
</foreach>
</foreach>
<foreach property='source.{IN1grp()}' key='k1' >
<assign value='source.{IN1grp(k1).IN1}' property='target.{IN1grp(k1).IN1}' action='set' />
<assign value='..Strip(target.{IN1grp(k1).IN1:InsurancePlanID.identifier},"&lt;","0")' property='target.{IN1grp(k1).IN1:InsurancePlanID.identifier}' action='set' />
<assign value='..Strip(target.{IN1grp(k1).IN1:InsuranceCompanyID().ID},"&lt;","0")' property='target.{IN1grp(k1).IN1:InsuranceCompanyID().ID}' action='set' />
<assign value='..Translate(target.{IN1grp(k1).IN1:InsuranceCoPhoneNumber().phonenumber1},"()-.")' property='target.{IN1grp(k1).IN1:InsuranceCoPhoneNumber().phonenumber1}' action='set' />
<code>
<![CDATA[ $$$TRACE("NoIN2ForFacilites: " _$GET(^IHC.CernAdtHl7ToConnectRx("NoIN2ForFacilities")))
 if ($GET(^IHC.CernAdtHl7ToConnectRx("NoIN2ForFacilities"))'=""){
    $$$TRACE("Global NoIN2ForFacilites has values:"_$GET(^IHC.CernAdtHl7ToConnectRx("NoIN2ForFacilities")))
    $$$TRACE("These are the Facilities That Don't Want IN2 segments....")
    $$$TRACE("Checking against Facility from context.msh4Facility which is: " _context.msh4Facility)

 }else{
    $$$TRACE("Global NoIN2ForFacilites has no values set in it." )
 }]]]]><![CDATA[></code>
<if condition='..NotIn(context.msh4Facility,$GET(^IHC.CernAdtHl7ToConnectRx("NoIN2ForFacilities")))' >
<true>
<trace value='"Copying IN2 due to MSH facility set to send IN2 to ConnectRx."' />
<assign value='source.{IN1grp(k1).IN2}' property='target.{IN1grp(k1).IN2}' action='set' />
<assign value='..Translate(target.{IN1grp(k1).IN2:EmployerContactPersonPhoneNu().phonenumber1},"()-.")' property='target.{IN1grp(k1).IN2:EmployerContactPersonPhoneNu().phonenumber1}' action='set' />
<assign value='..Translate(target.{IN1grp(k1).IN2:InsuredsPhoneNumberHome().phonenumber1},"()-.")' property='target.{IN1grp(k1).IN2:InsuredsPhoneNumberHome().phonenumber1}' action='set' />
<assign value='..Translate(target.{IN1grp(k1).IN2:InsuredsEmployerPhoneNumber().phonenumber1},"()-.")' property='target.{IN1grp(k1).IN2:InsuredsEmployerPhoneNumber().phonenumber1}' action='set' />
</true>
<false>
<trace value='"Not copying IN2 due to  MSH facility in global setting to not set IN2 to ConnectRx."' />
</false>
</if>
</foreach>
<foreach property='source.{ACC()}' key='k1' >
<assign value='source.{ACC(k1)}' property='target.{ACC(k1)}' action='set' />
</foreach>
<foreach property='source.{UB2()}' key='k1' >
<assign value='source.{UB2(k1)}' property='target.{UB2(k1)}' action='set' />
</foreach>
</transform>
]]></Data>
