<code name='Systolic/Diastolic Check ' xpos='200' ypos='850' >
<![CDATA[   //reset flag at beginning
   set context.SkipRecord = 0 
   set context.Systolic = ""
   
   set ObsCode = request.ObservationID 
   $$$TRACE(" observation ID is :"_ObsCode)
   $$$TRACE(" Patient ID is :"_request.PatientID)
   $$$TRACE(" Encounter ID is :"_request.EncounterID)
   
  // 8480-6 is code for SYSTOILIC BP
  if ( ObsCode = "8480-6" ) 
  {
    $$$TRACE(" This is a Systolic record, Store values into GLOBALS and Skip processing ")
    set ^IHC.EpicMigrationTouchWorksResults("PatientID") = request.PatientID
    set ^IHC.EpicMigrationTouchWorksResults("VisitID") = request.EncounterID
    set ^IHC.EpicMigrationTouchWorksResults("SystolicObsValue") = request.ObservationValue
    set context.SkipRecord = 1
   
  }
  
  if ( ObsCode = "8462-4")
  {
  // this is a diastolic value ,check in Globals for systolic values  on this patient
  $$$TRACE(" This is a diastolic record, find systolic values from GLOABLS" )
  
  set patId = $GET(^IHC.EpicMigrationTouchWorksResults("PatientID"))
  set encounterId = $GET(^IHC.EpicMigrationTouchWorksResults("VisitID"))
  set obsVal = $GET(^IHC.EpicMigrationTouchWorksResults("SystolicObsValue"))
  
  if ( (patId = request.PatientID) && (encounterId = request.EncounterID ))
  {
    // same patient - get the systolic value from globals 
    $$$TRACE("Patient matched up to the one stored in GLOABLS ")
    set context.Systolic = obsVal
  }
  
   }]]]]><![CDATA[>
