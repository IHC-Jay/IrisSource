<trace name='SuccessEmail' value='"Generate Successful File Creation Email "' xpos='470' ypos='2500' />
<code name='GenerateSuccessEmail' xpos='470' ypos='2600' >
<![CDATA[  //Generate the amount string
  set indexLen=context.sqlResponse.totalSentList.Count()
  set strEmailText=""
  for i=1:1:indexLen {
     set strEmailText=strEmailText_$c(13)_"Credit Amount: "_context.sqlResponse.totalCalculatedListCredit.GetAt(i)_$c(13)
     set strEmailText=strEmailText_"Debit Amount: "_context.sqlResponse.totalCalculatedListDebit.GetAt(i)_$c(13)
     set strEmailText=strEmailText_"Batch Amount: "_context.sqlResponse.totalSentList.GetAt(i)_$c(13)_$c(13)
   }
   
   set strEmailText=context.successEmailText_$c(13)_$c(13)_$c(13)_strEmailText
   
    set emailAlertRequest=##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnSuccess(context.successEmailSubject,strEmailText,context.configName)
 do process.SendAlert(emailAlertRequest)
]]]]><![CDATA[>
