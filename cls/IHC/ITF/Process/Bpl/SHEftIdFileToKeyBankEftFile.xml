<code name='CreateteStreamforFTPS' xpos='470' ypos='2900' >
<![CDATA[ // Create Stream
 set encryptedFileName=context.filePath_context.encryptedFileName
 if (##class(%File).Exists(encryptedFileName)=0){
     set status=$$$ERROR("ITFSHKBEFT002","Encrypted file does not exists")
 }
 
 Set streamFile=##class(%FileCharacterStream).%New()
 Do streamFile.LinkToFile(encryptedFileName)

 set stream=##class(%Stream.GlobalCharacter).%New()
 Set status = stream.CopyFromAndSave(streamFile)
 set context.ftpRequest=##class(Ens.StreamContainer).%New(stream)
 set context.ftpRequest.OriginalFilename = encryptedFileName
 
