<code name='Write Encrypted File' xpos='470' ypos='2200' >
<![CDATA[ 
  
  $$$TRACE("Attempting to create Encrypted File")
  $$$TRACE("Dest File name : "_context.cryptoResponse.DestFileName)		

  
   Set tStream=##class(%FileBinaryStream).%New()
   $$$TRACE("Set parameters name:" _context.cryptoResponse.DestFileName)
   Do tStream.LinkToFile(context.cryptoResponse.DestFileName)
   Do context.cryptoResponse.FileStream.Rewind()
 
   Set tSC=tStream.CopyFrom(context.cryptoResponse.FileStream)
   $$$TRACE("Copy stream " _ tSC) 
   
   Do tStream.Flush()
   
   Set tSC=tStream.%Save()
   $$$TRACE("Save stream " _ tSC) 
   
   ]]]]><![CDATA[>
</code>
<code name='GetFtpsOperationName' xpos='470' ypos='2300' >
<![CDATA[  
  

  // Get the destination and target config names map. This will retrieve the setting which has name of the 
  // FTP operation for each destination id associated with the payment type.
  $$$LOGINFO("Retrieve target config name block")
  set context.targetConfigNames=""
  set shImmedDestination=$zstrip(context.sqlResponse.immediateDestination,"*W"," ")
  $$$LOGINFO(" select health destination code "_shImmedDestination)
  set configValue=""
  set status=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"DestinationTargetConfigNameMap",.configValue)
  set countDestination=$length(configValue,",")
  FOR i=1:1:countDestination {
    SET value=$piece(configValue,",",i)
    set immediateDestination=$p(value,":",1)
    set ftpsOperation=$p(value,":",2)
    $$$LOGINFO(i_"*** "_value_" ****** "_immediateDestination_" ***** "_ftpsOperation)
    $$$LOGINFO(" select health destination code "_shImmedDestination)
    if (shImmedDestination=immediateDestination){
       set context.targetConfigNames=ftpsOperation
     }
  }
  $$$LOGINFO(" Retrieved Target Configname for the destination is "_context.targetConfigNames)
 if (context.targetConfigNames=""){
      set status=$$$ERROR("ITFSHKBEFT001","The transaction file "_context.fileName_" has immediate destination(bank routing number) of "_immedDestination_" that does not have a entry set up in the setting name DestinationTargetConfigNameMap of this component. The setting needs to be updated for this destination and the transaction needs to be re-triggered.")
 }
  $$$LOGINFO("End target config name block")]]]]><![CDATA[>
</code>
<code name='CheckEncryptedFile' xpos='470' ypos='2400' >
<![CDATA[ // If unencrypted file is present on the server delete it
  set unencryptedFileName=context.filePath_context.tempFileName
 if (##class(%File).Exists(unencryptedFileName)=1){
     Do ##class(%Library.File).Delete(unencryptedFileName)
 }
 // Check Encrypted file to make sure it got created
 set encryptedFileName=context.filePath_context.encryptedFileName
 if (##class(%File).Exists(encryptedFileName)=0){
     set status=$$$ERROR("ITFSHKBEFT002","Encrypted file does not exists. Encryption operation did not create the file as expected.")
 }]]]]><![CDATA[>
