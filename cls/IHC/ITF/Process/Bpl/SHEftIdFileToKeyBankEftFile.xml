<code name='Setup Encryption' xpos='470' ypos='1900' >
<![CDATA[    
   
    set context.cryptoRequest = ##class(IHC.ITF.ITFCOMMON.Operation.Util.Crypto.CryptoRequest).%New()
 

   set context.cryptoRequest.Operation = "Encrypt"
   $$$TRACE("This is an encryption process.")
    
  
   set context.cryptoRequest.EncryptKey = context.PUBLICKEYNAME
   $$$TRACE("EncryptKey  is "_context.cryptoRequest.EncryptKey)

   set context.cryptoRequest.DestFileName = context.filePath _ context.encryptedFileName
   $$$TRACE("Destination file name is "_context.cryptoRequest.DestFileName)
 


   $$$TRACE("Ready to call Encrypt Operation: " _ context.filePath _ "/"_context.tempFileName _ ", Output: " _ context.cryptoRequest.DestFileName)
 
   set context.cryptoRequest.SrcFileName = context.filePath _ context.tempFileName
   $$$TRACE("Request Source File name is "_context.filePath _ context.tempFileName)
	
   
 
 //Get Encryption Target
 
 set configValue=""
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNamesEncryption",.configValue)
  set context.encryptionTarget=configValue
	
  
 $$$TRACE("encryptionTarget is "_context.encryptionTarget)
 ]]]]><![CDATA[>
