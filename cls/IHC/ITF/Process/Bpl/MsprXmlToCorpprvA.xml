<code name='HDD Call for Provider Entity' xpos='200' ypos='1550' >
<![CDATA[ // Create request
 $$$TRACE("HDD Call for Board Provider Entity")
 set prvRBRRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddUniqueRepByRepObject()
 Set k2="",tSC=1
 set ihcFacilityDomain = "119"
 s gCorpprvContext = "50450887"
 set callHDD=0
 For {
	Set k2=context.CactusRequest.GetNextIndex("Provider(1).ProviderEntityRecord()",k2,.tSCTrans)
	Quit:k2=""
	Set strAffil=$zStrip(context.CactusRequest.GetValueAt("Provider(1).ProviderEntityRecord("_(k2)_").entity_k"),"<>W")
	s filterRecord=0
    If (##class(Ens.Util.FunctionSet).In(strAffil,context.ProviderEntityFilterString)=1){
         s filterRecord=1
    }
    $$$TRACE("filter Record "_filterRecord)
	Set recordType=$zstrip(context.CactusRequest.GetValueAt("Provider(1).ProviderEntityRecord("_(k2)_").recordtype"),"<>W")
	Set affiliationFacility=$zStrip(context.CactusRequest.GetValueAt("Provider(1).ProviderEntityRecord("_(k2)_").entity_k"),"<>W")
	$$$TRACE("Record TYpe and Affiliation "_recordType_" "_affiliationFacility)
	If (((recordType'="")&&(recordType="E"))&&(filterRecord=0)) {
