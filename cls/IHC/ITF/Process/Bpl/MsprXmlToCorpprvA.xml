<trace name='ProviderBoard HDD' value='"Call HDD for Provider Board Info Elements"' xpos='200' ypos='850' />
<code name='Create HDD Object /Call Hdd ' xpos='200' ypos='950' >
<annotation><![CDATA[For Provider Board Info]]]]><![CDATA[></annotation>
<![CDATA[ // Create request
  set hddOpNm=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TargetConfigNameHddWebService",.pstatus)

 Set k1="",tSC=1
 $$$TRACE("HDD Call for Board Provider Info: "_hddOpNm)
 For {
	$$$TRACE("Inside HDD call for Provider Board Rquest "_k1)
	Set k1=context.CactusRequest.GetNextIndex("Provider(1).ProviderBoardsRecord()",k1,.tSCTrans)
	Quit:k1=""
	Set bid=$Zstrip(context.CactusRequest.GetValueAt("Provider(1).ProviderBoardsRecord("_(k1)_").board_rtk.ID"),"<>W")
    Set statusId=$Zstrip(context.CactusRequest.GetValueAt("Provider(1).ProviderBoardsRecord("_(k1)_").boardstatus_rtk.ID"),"<>W")
	if ((bid="") || (statusId=""))
	{
	   set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"Missing BOARD_ID/BOARD_STATUSID for record with provider id: "_context.prvdrId)
	   quit
	}
	set CorprvBordId=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepByRep(bid, context.gCactusContext,context.gBrdSpcAreaDmn, context.gBrdSpcAreaContext, hddOpNm, .process)	
 $$$TRACE("Corpprv Board ID: " _ CorprvBordId)
    set CorprvStatus=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepByRep(statusId, context.gCactusContext,context.gBrdCrtSttsDmn, context.gCrpprvSttsContext, hddOpNm, .process)    
    if ((CorprvBordId'="") && (CorprvStatus'="")) {
      do context.corpprvBoardIds.Insert(CorprvBordId)
      do context.boardStatusIds.Insert(CorprvStatus)
    }
    else {
      do context.corpprvBoardIds.Insert("")
      do context.boardStatusIds.Insert("")
    } 
 }
]]]]><![CDATA[>
</code>
<trace name='HDD For Location Status' value='"HDD Call for Location Status"' xpos='200' ypos='1050' />
<code name='LocationStatus' xpos='200' ypos='1150' >
<![CDATA[ // Create request
 $$$TRACE("HDD Call for Location Status")
 Set locationStatus=$Zstrip(context.CactusRequest.GetValueAt("Provider(1).ProviderDemographicsRecord.status_rtk.ID"), "<>W")
 If (locationStatus '="NONE") {
    set stsBYBRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddUniqueRepByRepObject()
    s gCorpprvContext = "50450837"
   s locationStatusDomain = "50450918"
   do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddUniqueRepByRepObject(stsBYBRequest , locationStatus,context.gCactusContext,  locationStatusDomain,gCorpprvContext,   context.StatusRtk_locationStatus)
   set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,stsBYBRequest,.hddNcidResponse)
   If ($$$ISERR(tStatus)){
     set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Call to HDD for getting location status "_locationStatus_" in domain 50450918 and context "_context.gCrpprvSttsContext_" ended in Error "  )
   }Else {
     set hddObj =  ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddNcidResponse,context.StatusRtk_locationStatus)	     
     if ((hddObj ="")||(hddObj.Rep="")){
	    set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Unable to get Corpprv Rep. for source Rep :"_locationStatus_": in domain :" + locationStatusDomain_": Can not continue: Check HDD/data validity for Provider Status Codes!" )
     }Else{
          set context.hddLocationStatusResponse=hddNcidResponse
     } 
   }    
  }]]]]><![CDATA[>
</code>
<trace name='HDD Call For Speciality Code' value='"HDD Call for Speciality Code"' xpos='200' ypos='1250' />
<code name='Speciality Code HDD Call' xpos='200' ypos='1350' >
<![CDATA[ // Create request
 $$$TRACE("HDD Call for Speciality Code")
 set sptRBRRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddUniqueRepByRepObject()
 Set k1="",tSC=1
 set currentDomain = "291"
 set gCorpprvContext = "50450840"
 set context.specialitiesPresent=0
 set status=$$$OK
 For {
	Set k1=context.CactusRequest.GetNextIndex("Provider(1).ProviderSpecialtiesRecord()",k1,.tSCTrans)
	Quit:k1=""
	Set active = $zStrip(context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").active"),"<>W")
	If ((active="1") || (active=".T.")) {
		Set specialtyCodeID=$zstrip(context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").specialty_rtk.ID"),"<>W")
		do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddUniqueRepByRepObject(sptRBRRequest , specialtyCodeID,context.gCactusContext,  currentDomain,gCorpprvContext,   context.SpecialityRtkID_specialtyCodeID)
		set context.specialitiesPresent=1
	}
 }
 If (context.specialitiesPresent=1){
	set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,sptRBRRequest,.hddNcidResponse)
	If ($$$ISERR(tStatus)){
		set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Unable to get Corpprv Rep. for source Rep :"_specialtyCodeID_": in domain :"_ currentDomain_": Can not continue: Check HDD/data validity for Speciality Codes!"   )
	}Else {
		set context.hddAdvProviderSpecialityResponse=hddNcidResponse
	    set k1=""
		For {
			Set k1=context.CactusRequest.GetNextIndex("Provider(1).ProviderSpecialtiesRecord()",k1,.tSCTrans)
			Quit:k1=""
			set active2=$zStrip(context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").active"),"<>W")
			If ((active2="1") || (active2=".T.")) {
				Set specialtyCodeID=$zstrip(context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").specialty_rtk.ID"),"<>W")
				set hddObj =  ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddNcidResponse,context.SpecialityRtkID_specialtyCodeID)	     
				if ((hddObj ="")||(hddObj.Rep="")){
					set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Unable to get Corpprv Rep. for source Rep :"_specialtyCodeID_": in domain :"_currentDomain_": Can not continue: Check HDD/data validity for Speciality Codes!" )	
				}
			}
		}
	}
  }
  If ((context.specialitiesPresent=1)&&$$$ISOK(status)){
      set context.hddSpecialityCodeResponse=hddNcidResponse
  }    ]]]]><![CDATA[>
