<code name='CheckAndParseRequest' xpos='200' ypos='550' >
<![CDATA[ If (request.sourceSystem="CACTUS"){
   set status=$$$OK
   $$$TRACE("Parse cactus string"_request.CACTUS.content)
   set context.CactusRequest=##class(EnsLib.EDI.XML.Document).ImportFromString(request.CACTUS.content)
   set context.CactusRequest.DocType="Standard_Export_3_14_XSD_NEWA:CACTUSMessage"    
   // Parse MSPR Response
   $$$TRACE("Parse MSPR response String")
   set replstr="<?xml version="_""""_"1.0"_""""_"?>"
   set MSPRResponseString=$Replace(request.MSPR.content,replstr,"")
   // Remove the XMl Version tag from start and Junk characters at the end
   set MSPRResponseString="<CiwsInfo>"_$piece(MSPRResponseString,"<CiwsInfo>",2)
   set MSPRResponseString=$piece(MSPRResponseString,"</CiwsInfo>")_"</CiwsInfo>"
   Set reader = ##class(%XML.Reader).%New()
   Set sc=reader.OpenString(MSPRResponseString)
   if '$$$ISOK(sc){
      set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
   } 
   Else {
      Do reader.Correlate("CiwsInfo","IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo")
      do reader.Next(.CiwsInfo,.sc)
      If $$$ISOK(sc){
	 set context.msprResponse=CiwsInfo
	 try {
	   set context.HDDNCID=CiwsInfo.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).memberInfo.userNcid.ncid
	          set context.UnitNumber=CiwsInfo.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).unitNumber.content
	      }catch{
		      set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"The MSPR response back from XMPL Proxy has Unit Number of userNCid blank .Review the transaction with Cactus and MSPR.")  
	      }    
	      $$$TRACE(" HDDNCID "_context.HDDNCID_" "_context.UnitNumber)
      }
      Else {	  
          set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
      }    
  } 
 }else{
   // Send Error.
   set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing  -Invalid source "_request.sourceSystem)
   
 }]]]]><![CDATA[>
</code>
