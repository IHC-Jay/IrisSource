<code name='CheckProviderPhysicianException' xpos='200' ypos='1700' >
<![CDATA[ 
 // Call Ldap Operation to CheckProviderPhysician exception indicator
 $$$TRACE("Inside Call to LDAP")
 set context.checkProviderPhysIndException=0
 set unitNumber=context.UnitNumber
 set checkLdap=0
 set ldapSearchRequest=##class(IHC.ITF.ITFCOMMON.DStruc.LdapSearchRequest).%New()
 try{
     set mMemInfo=context.msprResponse.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).memberInfo.names.Item
     set countMemberId=context.msprResponse.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).memberInfo.genericMemberIds.Item.Count()
	    //set ^IHC("MsprProviderToGenericHl7","CountNames1")=countNames
 }catch{ set countMemberId=0}
	
 for i=1:1:countMemberId {
    set idItem= context.msprResponse.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).memberInfo.genericMemberIds.Item.GetAt(i)
    set idTypeNcid=idItem.idTypeNcid.ncid
    If (idTypeNcid="50450667"){
       If (idItem.idValue.content < context.MAXPRVDRID){//AIKB-3884 65536 to 89999
          set checkLdap=1
       }
    }
 } 
 If (checkLdap=1){
    $$$TRACE("Setting LDAP parameters")
    set ldapSearchRequest=##class(IHC.ITF.ITFCOMMON.DStruc.LdapSearchRequest).%New()
    set ldapSearchRequest.searchString="unitnumber="_ unitNumber
    set ldapSearchRequest.attrList=process.LdapAttrList
    set ldapSearchRequest.searchScope=process.LdapSearchScope
	set ldapSearchRequest.DN=process.LdapDN
    //Call ldap Operation
    set context.ldapRecFound=0
    set tSC=process.SendRequestSync(process.TargetConfigNameLdap,ldapSearchRequest,.ldapResponse)
       if (($$$ISERR(tSC))||ldapResponse.ldapReturnValues.Count()=0){
       }Else{
           set ldapSearch = ldapResponse.ldapReturnValues.GetAt("cernaccesslist-PhysIndException")
           If (ldapSearch'=""){
               set context.checkProviderPhysIndException=1
           }       }
  }  
 ]]]]><![CDATA[>
