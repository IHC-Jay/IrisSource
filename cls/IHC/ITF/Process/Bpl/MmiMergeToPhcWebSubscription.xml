<foreach property='request.{PID:PatientIDInternalID()}' key='context.k1' xpos='200' ypos='650' xend='200' yend='900' >
<trace value='"Assigning Authority: " _ request.{PID:PatientIDInternalID(context.k1).assigningauthority.namespaceID}' xpos='200' ypos='250' />
