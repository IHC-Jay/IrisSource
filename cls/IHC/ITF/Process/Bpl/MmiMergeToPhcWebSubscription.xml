<if name='newUnitNumber &apos;= "" AND oldUnitNumber &apos;= ""' condition='(context.newUnitNumber &apos;= "") &amp;&amp; (context.oldUnitNumber &apos;= "")' xpos='200' ypos='750' xend='200' yend='1000' >
<true>
<code name='Merge' xpos='335' ypos='900' >
<![CDATA[ try {
   set host = %Ensemble("%Process").JavaGWhost
   set port = %Ensemble("%Process").JavaGWport
   set jarFile = %Ensemble("%Process").JavaJarFile
   set url = %Ensemble("%Process").ProviderUrl

   set gateway=##class(EnsLib.JavaGateway.JavaGateway).%New()
   set status=gateway.%Connect(host, port)
   $$$TRACE("Connect to " _ host _ ":" _ port _ ", stat: " _ status)
   if ($$$ISOK(status))
   {
      // Set status=gateway.%Import(jarFile) 
      // $$$TRACE("import: " _ jarFile _ ", Status: " _ status _ ", now trying to run TestPhcWebEjb")
      if ($$$ISOK(status))
      {
         set ejbObj=##class(org.ihc.itf.PhcWebEjb).%New(.gateway)
         set status = ejbObj.sendDataToSubscriptionService( context.oldUnitNumber, context.newUnitNumber, url )
         $$$LOGINFO("SendData SubscriptionService: oldUnitNumber: " _ context.oldUnitNumber _ ", newUnitNumber: " _ context.newUnitNumber _ " to URL: " _ url _ ", status: " _ status)
      }
      Do gateway.%Disconnect() 
   }
   if ($$$ISOK(status))
   {
      // reset error
      Do ##class(ITFCOMMON.Utility).ResetError($CLASSNAME())
   }
   else
   {
    // Set number of errors
    Set status =  ##class(ITFCOMMON.Utility).CheckError($CLASSNAME())
    Set status =  ##class(ITFCOMMON.Utility).FailMsgError($CLASSNAME(), "failed to call PhcWebEjb to URL: " _ url _ " : " _ $System.Status.GetErrorText(%objlasterror)) 
   }
   
  } catch exp
  {
	$$$LOGERROR("ERROR in SendData to TestPhcWebEjb to URL: " _ url _ " : " _ exp.Data)
	Do gateway.%Disconnect() 
	Set status =  ##class(ITFCOMMON.Utility).CheckError($CLASSNAME())
        Set status =  ##class(ITFCOMMON.Utility).FailMsgError($CLASSNAME(), "failed to call PhcWebEjb: " _ $System.Status.GetErrorText(%objlasterror)) 

  }		
 ]]]]><![CDATA[>
