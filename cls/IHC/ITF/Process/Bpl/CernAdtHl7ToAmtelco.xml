     set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToAmtelco.Lookup.AdtEventsFilterOut", context.msgType, .retVal )
     set context.isFilterOutEvent = retVal
     if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {       
       $$$TRACE("Unable to get Filter Out event map value from the lookup table. Getting the default value.")
       set context.isFilterOutEvent = 0
    } else {
	   $$$TRACE("Value of Adt Event Filter Out from the lookup table :" _ context.isFilterOutEvent)
    }
    
      set seriesPat = request.GetValueAt("PV1:PatientType")
      set dischargeTime = request.GetValueAt("PV1:45.1")
      set admitTime = request.GetValueAt("PV1:44.1")
      
      $$$TRACE(" PV1-18 value : "_seriesPat )
      $$$TRACE(" PV1-45 value discharge date n time : "_dischargeTime )
      $$$TRACE(" PV1-44 value Admit date n time : "_admitTime )
       
      if ( (seriesPat '= "") && ( seriesPat = "526742845") )
      {
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "This is a series patient , Skip the record.") 
          
          }
          
      if (context.msgType = "A08") 
       {
           if ( (admitTime '= "") && ( dischargeTime = "")   )
          {
            $$$TRACE(" This A08 transaction has an admit date and no discharge date, Pass it to Amtelco ")
          
          }
          else
          {
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "This A08 transaction either has a discharge date/time or no Admit date/time , Skip the record.") 
          
