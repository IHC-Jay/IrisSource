<code name='Setup and Call HDD IsMemberObject' xpos='1010' ypos='1800' >
<![CDATA[ set nursingunit = request.GetValueAt("ZZZ(2):14VisitAdmitSource")
 $$$TRACE(" Nursing Unit NCID from ZZZ(2):14 : "_nursingunit )
    
  set context.hddMemRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateIsMemberObject()
  if ( nursingunit '= "" ){
       if ($ISVALIDNUM(nursingunit )="1")
       {
          
       $$$TRACE("Nursing unit is a number, Check the NCID for presence in the Amtelco location inclusion domain")
      
       Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddIsMemberObject(context.hddMemRequest ,context.hddDomainAmtelcoInc ,nursingunit , "NU_Amtelco")
        set tStatus=process.SendRequestSync(context.HddTargetConfigName,context.hddMemRequest,.hddMemResponse)
     if ('tStatus) {     
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
     }
      else { 
         set context.hddMemResponse= hddMemResponse
          $$$TRACE("Hdd return count(isMemberObjectFromNcid): " _ context.hddMemResponse.listOfHDDobj.Count() )
    }
  
 
  
    set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddMemResponse, "NU_Amtelco")
         if (hddObj '= "")
         {
            set isMem = hddObj.Rep
            if ( isMem '= 1 )
            {
                 $$$TRACE(" This Nursing Unit  is not a member of the AMTELCO Domain , Skip the record ")                
         set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "This Nursing Unit  is not a member of the Amtelco Domain , Skip the record.") 
                 
                
             }
             else
             {
                $$$TRACE(" This Nursing Unit is a valid member of the AMTELCO Domain")
               
              }
              
             } 
             
             }
             else
             {
              $$$TRACE(" This Nursing Unit is NOT a valid NCID number" )
               set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "This Nursing Unit  is not a number , Skip the record.") 
         
             }
        }]]]]><![CDATA[>
