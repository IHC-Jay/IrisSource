<code name='GetMSH4FilterList' xpos='200' ypos='1050' >
<annotation><![CDATA[MSH-4 Filter out list]]]]><![CDATA[></annotation>
<![CDATA[  $$$TRACE("Fetch MSH-4 Filter Out list")
 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"FilterOutLocations", .getLocFilterOutStr)
 if ($$$ISOK(pstatus)){
		$$$TRACE("Facilities to Filter Out: " _getLocFilterOutStr)
		TRY {
			For iTarget=1:1:$L(getLocFilterOutStr,",") 
			{ 
				Set tOneTarget=$ZStrip($P(getLocFilterOutStr,",",iTarget),"<>W")  
                Continue:""=tOneTarget
				if (context.Msh4Facility = tOneTarget){
					set filterOutFacility = 1
					QUIT
				}
				set filterOutFacility = 0
				$$$TRACE("Filter Out Facility from settings: [" _ tOneTarget _"] verifying against MSH-4 Facility: [ " _ context.Msh4Facility_"]")
			}
			$$$TRACE("Checking against allowed facilities")
			if (filterOutFacility=1) {
				$$$TRACE("Facility is a MSH-4 Facility to be Filtered Out. Skipping HL7 Message. MSH-4 Facility found: ["_context.Msh4Facility_"]")
				set context.SilentSkip=1
			}
			else{
				$$$TRACE("Have a workable Facility.")
			}
		} Catch eException {
			Set exceptStatus = "Error Parsing STRING: getLocFilterOutStr - for Filter Out Facility list: "_eException.AsStatus()
			set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not parse data required to proces HL7 data. Error caught: "_exceptStatus )
			
		}   
		
	}else{
		set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "***Unable to get FilterOutLocations from the Process Settings for Cern-Adt-Hl7_IhcHie-Base64-UHINREST. Setting required for processing messages!")
	}
	
 
]]]]><![CDATA[>
