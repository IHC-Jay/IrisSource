<code name='ping token' xpos='470' ypos='1900' >
<![CDATA[ $$$TRACE(" Target Operation to get AccessToken from Ping service " _ context.AccessTokenTargetConfigName)   
 set httpRequestObj=##class(EnsLib.HTTP.GenericMessage).%New()   
 set status =  process.SendRequestSync(context.AccessTokenTargetConfigName,httpRequestObj,.accessTokenResponse)
 if ($$$ISOK(status)){
    $$$TRACE("AcsessToken Operation status - OK")
    set context.RestAccessTokenHttpResponse=accessTokenResponse      
    Set tcharStream = ##class(%GlobalCharacterStream).%New()
    Set tStatus = tcharStream.CopyFrom(context.RestAccessTokenHttpResponse.Stream)
    set text=""
    While 'tcharStream.AtEnd {
       Set text = text_tcharStream.Read($$$MaxStringLength)
    } 
    set context.AccessToken = text
    $$$TRACE("Accss Token from Ping Service: "_context.AccessToken)
    if (context.AccessToken=""){
       $$$TRACE(" Access Token is blank/empty")
       set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," No Access Token from ping service. ") 
    }      
 }else {
    $$$TRACE("Calling Ping Service to get the Access Token failed!!!")
    set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Calling Ping Service to get the Access Token failed!!!") 
 }
 $$$TRACE("Done getting token")]]]]><![CDATA[>
</code>
<code name='DoPostTranslationWork' xpos='470' ypos='2000' >
<![CDATA[ $$$TRACE("Do any remaining message work post DTL-Base64Encoding")
 $$$TRACE("Cloning Response!")
 set context.NewResponseClone = response.%ConstructClone(1)
 $$$TRACE("Response Cloned! Now to Base64Encode Clone!")
 set context.ResponseBase64Encoded = $SYSTEM.Encryption.Base64Encode(context.NewResponseClone.OutputToString(),1)
 $$$TRACE("Cloned Response is now Base64 Encoded!")
 $$$TRACE("Here's the Base64 Encoded data: "_context.ResponseBase64Encoded )
 



]]]]><![CDATA[>
</code>
<code name='CreateHttpGenericStream' xpos='470' ypos='2100' >
<annotation><![CDATA[Creating Generic HTTP Stream to use to send to the REST service]]]]><![CDATA[></annotation>
<![CDATA[ 
 set newStreamContainer = ##class(%GlobalCharacterStream).%New()
 do newStreamContainer.Write(context.ResponseBase64Encoded)
 set tStatus = newStreamContainer.Rewind()
 $$$TRACE("New Stream Container with Base64Encoded data: "_newStreamContainer)
 
 set context.NewResponseStream = ##class(EnsLib.HTTP.GenericMessage).%New()
 do context.NewResponseStream.StreamSet(newStreamContainer)
  $$$TRACE("Add record to request complete")
 set streamSize = newStreamContainer.SizeGet()
 $$$TRACE("StreamContainer Size is: "_streamSize)
 do context.NewResponseStream.HTTPHeaders.SetAt("Bearer "_context.AccessToken, "Authorization")
 $$$TRACE("Add access token to request complete")
 Do context.NewResponseStream.HTTPHeaders.SetAt("text/plain","content-type")
 $$$TRACE("Add context type to request complete")
 Do context.NewResponseStream.HTTPHeaders.SetAt(streamSize,"content-length")
 $$$TRACE("Add context length to request complete")
 
 
 $$$TRACE("Base64 Encoded Clone set to the stream. Stream is: "_context.NewResponseStream)
]]]]><![CDATA[>
