<Super>IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL</Super>
<TimeCreated>64463,39267.201212</TimeCreated>

<XData name="BPL">
<Description>
BPL Definition</Description>
<XMLNamespace>http://www.intersystems.com/bpl</XMLNamespace>
<Data><![CDATA[
<process language='objectscript' request='Ens.Request' response='Ens.Response' height='4450' width='2000' >
<context>
<property name='cdrReadMmiTargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='mmiRow' type='IHC.ITF.Response.MmiEventsRow' instantiate='1' />
<property name='dataRecord' type='IHC.ITF.ITFCOMMON.DStruc.CDR.DataRecord' instantiate='0' />
<property name='mmiRecord' type='IHC.ITF.ITFCOMMON.DStruc.CDR.MmiRecord' instantiate='0' />
<property name='memberInfo' type='IHC.ITF.ITFCOMMON.DStruc.CDR.MemberInfo' instantiate='0' />
<property name='cdrReadMmiResponse' type='IHC.ITF.ITFCOMMON.DStruc.CDR.MmiInfo' instantiate='0' />
<property name='NumOfInitiateInstances' type='%String' instantiate='0' >
</property>
<property name='iniTargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='empiMod' type='%String' instantiate='0' >
</property>
</context>
<sequence xend='200' yend='3150' >
<scope xpos='200' ypos='250' xend='200' yend='3050' >
<trace name='Debug' value='"In BPL: " _ $CLASSNAME() _ ", Process: " _ process.%ConfigName' xpos='200' ypos='350' />
<code name='Check ReplyCodeActions' xpos='200' ypos='450' >
<annotation><![CDATA[Get ReplyCodeActions from settings]]]]><![CDATA[></annotation>
<![CDATA[
 //ReplyCodeActions validation
 set replyCodeActions=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","ReplyCodeActions",.pstatus)
 if ( ($$$ISERR(pstatus)) || (replyCodeActions= "")) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get ReplyCodeActions, shutting down.")   
 } else {
    $$$TRACE("ReplyCodeActions: " _ replyCodeActions)
 }]]]]><![CDATA[>
</code>


<code name='Get Number of Initiate Instances' xpos='470' ypos='1700' >
<![CDATA[
 set context.NumOfInitiateInstances=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","NumberOfInitiateInstances",.pstatus)
 if ($$$ISOK(pstatus)){
 	$$$TRACE("NumOfInitiateInstances " _ context.NumOfInitiateInstances)
 }else{
	 Set status = $$$ERROR("Initialization error, No NumOfInitiateInstances found in the Settings.")
 } 
 	  ]]]]><![CDATA[>
</code>



<code name='Check Cdr ReadMmi Configuration' xpos='200' ypos='950' >
<annotation><![CDATA[Get CDR ReadMmi configuration from settings]]]]><![CDATA[></annotation>
<![CDATA[
 //CdrReadMmiTargetConfigName validation
 set context.cdrReadMmiTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","CdrReadMmiOperationName",.pStatus)
 if (($$$ISERR(pstatus)) || (context.cdrReadMmiTargetConfigName = "")){
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get CdrReadMmiOperationName, shutting down.")
 } else {
    $$$TRACE("CdrReadMmiTargetConfigName " _ context.cdrReadMmiTargetConfigName)   
 }]]]]><![CDATA[>
</code>


<code name='EmpiModulus' xpos='200' ypos='650' >
<![CDATA[
      Set context.empiMod = request.UnitNumber # context.NumOfInitiateInstances
      $$$TRACE("Empi# Modulus: "_context.empiMod)
      set context.iniTargetConfigName = "Cdr-Demogr-Cff_Initiate-Xml-Soap-"_context.empiMod
      set context.cdrReadMmiTargetConfigName = context.cdrReadMmiTargetConfigName_"-"_context.empiMod
      $$$TRACE("Target Process name : "_context.iniTargetConfigName)
 ]]]]><![CDATA[>
</code>



<code name='Get MMIDataRecord' xpos='200' ypos='1450' >
<![CDATA[ 
 $$$TRACE(" Getting MMI Data Record.. " )
 set cdrReadMmiRequest = ##class(Ens.StringRequest).%New()  
 set cdrReadMmiRequest.StringValue = request.UnitNumber
 set cdrReadMmiResp = ##class(IHC.ITF.Response.MmiEventsRow).%New()
 set tStatus=process.SendRequestSync(context.cdrReadMmiTargetConfigName,cdrReadMmiRequest,.cdrReadMmiResp)
 $$$TRACE(" Status after ReadMmi " _ tStatus)
 $$$TRACE(" cdrReadMmiResp: " _ cdrReadMmiResp)
 if ('tStatus) {
     //set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected CDR READMMI response returned or CDR READMMI call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))     
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, " RETRYING.. Unexpected CDR READMMI response returned or CDR READMMI call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))     
     $$$TRACE(" Status ItfGeneralError " _ tStatus)
 } else {    
  if ($IsObject(cdrReadMmiResp)){
   set context.cdrReadMmiResponse= cdrReadMmiResp    
   set context.dataRecord = cdrReadMmiResp.DataRecord   
   set context.mmiRecord = context.dataRecord.ListOfMMIRecords.GetAt(1)   
   set context.memberInfo = context.mmiRecord.MemberInfo   
   set context.cdrReadMmiResponse.DataRecord.mmiEventRow = request   
  }else{
	  $$$TRACE(" CdrMmiRead Response is null. ")
	  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName," RETRYING..CdrMmi Read Response is empty/null.")	  
	  }   
 }]]]]><![CDATA[>
</code>

<call name='Send to TargetConfigNames' target='@context.iniTargetConfigName' async='1' xpos='200' ypos='250' >
<request type='Ens.Request' >
<assign property="callrequest" value="context.cdrReadMmiResponse" action="set" />
</request>
</call>

<code name='Reset Error' xpos='200' ypos='2800' >
<annotation><![CDATA[Reset the Error count so that we start from beginning]]]]><![CDATA[></annotation>
<![CDATA[
 Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)]]]]><![CDATA[>
</code>
<faulthandlers>
<catchall xpos='200' ypos='2900' xend='200' yend='350' >
<code name='Call ProcessError' xpos='200' ypos='250' >
<annotation><![CDATA[Call error handler method]]]]><![CDATA[></annotation>
<![CDATA[ Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).ProcessError(..%Context.%LastError)
]]]]><![CDATA[>
</code>
</catchall>
</faulthandlers>
</scope>
</sequence>
</process>
]]></Data>
</XData>

