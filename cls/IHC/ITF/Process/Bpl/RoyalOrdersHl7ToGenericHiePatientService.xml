		 		do tStream.Write("  ")
	 			do tStream.Write(respData)
	 			do tStream.Write($CHAR(10))
	 			do tStream.Write(request.RawContent)	 
	 			do tStream.Write($CHAR(10))
	 			do tStream.Write("----------------")
	 			do tStream.Write($CHAR(10))	 
	 			set tRequest.Stream = tStream
 	 			set tStatus = process.SendRequestSync(context.notifyTargetConfigName,tRequest)
 	 			if ('tStatus) {
      	 			set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected error while writing the record to a file system. "_$SYSTEM.Status.GetOneErrorText(tStatus))
      	 		}else{
		    		set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respData)
      	 		}
		    }elseif (statusCode [ "5"){
			    $$$TRACE("  HTTP status codes starting 5.. ")
		   		set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Response: ["_respData_"].") 
		    }else{
		    	$$$TRACE("  DisableMsgError.... ")
        		set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Response from Patient Service Post Operation: "_respData) 
		    }
		} else {
        		$$$TRACE("PatientService call status 200 OK !!! ")
        		Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName) 
        		
        		set respJSONstring = respData          		
          		$$$TRACE(" respData "_respData)
          		set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respJSONstring)          		
          		set iterator =  consumedJSONobj.%GetIterator()
                 while iterator.%GetNext(.key,.value) { 
                 	$$$TRACE(" Key: "_key_" Value: "_value)
                 	if (key="status"){
	                 	 if (value="SUCCESS"){
		                 	$$$TRACE(" Status: "_value)	  
						set getmrn = 0
      			        set context.CernerMrnvalues = ""
      				//set mrn = (consumedJSONobj.%Get("data")).%Get("mrn")
      				//$$$TRACE(" CMRN#: "_mrn)
      				
      				set statusDetailsArr = (consumedJSONobj.%Get("data")) 
      				Set arrObj = statusDetailsArr.%GetIterator()
  			      
  				while arrObj.%GetNext(.key, .value)
  				{
		  	          //Set arrNextElemObj = value.%GetIterator()
		  	         // while arrNextElemObj.%GetNext(.key, .value) {
		  		     if (key = "primaryIds")
  				        { 
		  			   Set arrElem2Obj = value.%GetIterator()	 
	  			           while arrElem2Obj.%GetNext(.key, .value) {
	  			             Set arrElem3Obj = value.%GetIterator()
		  	                     while arrElem3Obj.%GetNext(.key, .value) {
		  			      // $$$TRACE("  key: "_key_" Value: "_value)
		  			       if ( (key ="assigningAuthority") && ( value = "INMT") )
		  			       {
		  			          //$$$TRACE("value is INMT")
		  			          set getmrn = 1
		  			          //$$$TRACE("getmrn value is : "_getmrn)
		  			       }
		  			       if ( (key = "mrn") && (getmrn = 1) )
		  			       {
		  			         // $$$TRACE("value value is : "_value)
		  			          if (context.CernerMrnvalues ="")
		  			          {
		  			           set context.CernerMrnvalues = value
		  			          }
		  			          else
		  			          {
		  			            set context.CernerMrnvalues = context.CernerMrnvalues_"|"_value
		  			          }
		  			          set getmrn = 0 
		  			         // $$$TRACE("getmrn value is : "_getmrn)
		  			          //$$$TRACE(" CernerMrnvalues : "_context.CernerMrnvalues)
		  			       }
		  			     }
		  			    }
		  			   //}
		  			  }
  				}							
	                 	 }else{
		                 	 $$$TRACE(" Status: "_value)
		                 	 set context.errResp = "1"
		                 	
		                 	set tRequest = ##class(Ens.StreamContainer).%New("")	 
		 					set tStream = ##class(%Stream.GlobalCharacter).%New("")	
		 					do tStream.Write($ZSTRIP($ZDATETIME($HOROLOG,8,1),"*"," :")) 
		 					do tStream.Write("  ")
	 						do tStream.Write(respData)
