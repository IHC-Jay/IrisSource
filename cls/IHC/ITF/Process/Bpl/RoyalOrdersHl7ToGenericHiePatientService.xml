	 						do tStream.Write(request.RawContent)	 
	 						do tStream.Write($CHAR(10))
	 						do tStream.Write("----------------")
	 						do tStream.Write($CHAR(10))	 
	 						set tRequest.Stream = tStream
 	 			 			set tStatus = process.SendRequestSync(context.notifyTargetConfigName,tRequest)
 	 			 			if ('tStatus) {
      	 						set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected error while writing the record to a file system. "_$SYSTEM.Status.GetOneErrorText(tStatus))
      	 		 			}
    
		                 	 $$$TRACE(" respJSONstring (ERRTXT): "_respJSONstring)	
		                 	
								 set retryErrCodeList = $LISTFROMSTRING(context.retrySameDisableErrorCodes, ",")
								 Set lenRetryErrCodeList = $ListLength(retryErrCodeList)
	   							 $$$TRACE("  lenRetryErrCodeList : "_lenRetryErrCodeList)
	   							 For i=1:1:lenRetryErrCodeList {
		   	 						set listItem = $List(retryErrCodeList,i)
									Set isRetryErrCodeFound = respJSONstring[ listItem	
									$$$TRACE("  isRetryErrCodeFound:"_isRetryErrCodeFound_" ErrCode:"_listItem)
									if (isRetryErrCodeFound=1) quit				
								 }
	    						if (isRetryErrCodeFound=1) {
								    $$$TRACE(" RetryCheckError.. errorText "_respJSONstring)
	        						Set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"TimedOut. No Successful Response from Patient service: ["_respJSONstring_"]. Retrying ..")
								}else{
								 if respJSONstring [ "line 1 limit is 30"{
			                 		 set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Length of the Address1 from iCentra Adt in PID-11.1 is more than 30. Response from Patient Service Post Operation: "_respJSONstring)	                
			                 	 }elseif respJSONstring [  "Patient not found for mrn"{
				                 	set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Either keep cmrn:"_context.tellicaKeepMrn_" not exists in Hie. Response from Patient Service Post Operation: "_respJSONstring)	              
			                 	 }else{
								 	$$$TRACE(" Unknown/Unhandled Error. Response from the Hie Patient Service: errorText: "_respJSONstring)
	    						 	set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Unknown/Unhandled error: "_respJSONstring) 
			                 	 }
								}
							               	
		                 }
	                }
                 	
                }                 
        } 
    }else{
	    set errTxt = $SYSTEM.Status.GetOneErrorText(status)
	    $$$TRACE("Call PatientService ERR TEXT: "_errTxt)
	    set retryErrCodeList = $LISTFROMSTRING(context.retrySameDisableErrorCodes, ",")
	   	Set lenRetryErrCodeList = $ListLength(retryErrCodeList)
	   	$$$TRACE("  lenRetryErrCodeList : "_lenRetryErrCodeList)
	   	For i=1:1:lenRetryErrCodeList {
		   	 set listItem = $List(retryErrCodeList,i)
			Set isRetryErrCodeFound = errTxt[ listItem	
			$$$TRACE("  isRetryErrCodeFound:"_isRetryErrCodeFound_" ErrCode:"_listItem)
			if (isRetryErrCodeFound=1) quit				
		}

	    if (isRetryErrCodeFound=1) {
		    $$$TRACE(" RetryCheckError.. errorText "_errTxt)
	        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"TimedOut. No Successful Response from Patient service: ["_errTxt_"]. Retrying ..")
		}else{
			$$$TRACE("Call PatientService ERR TEXT: "_errTxt)
	    	set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Unknown/Unhandled error: "_errTxt) 
		}    	   
    }          
