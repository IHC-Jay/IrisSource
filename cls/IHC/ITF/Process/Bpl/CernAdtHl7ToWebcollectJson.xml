<code name='Create HTTP Request for TOKEN' xpos='470' ypos='3300' >
<![CDATA[  
  //get globals and check if a new token is needed
 
  set oldTokenTime =  $GET(^IHC.CernADTJsonWebcollect("AzureTokenTime"))
  $$$TRACE(" Get token time from GLOBALS : "_ oldTokenTime)
  if ( oldTokenTime = "")
  {
     //first time getting token 
     set context.getToken=1
     }
     else
     {
     set context.time = $HOROLOG
     $$$TRACE("Current time is : "_context.time)
     set minutesPassed = $SYSTEM.SQL.DATEDIFF("n", oldTokenTime,context.time)
     $$$TRACE(" minutes passed since last token  is : "_minutesPassed )
     if ( minutesPassed > 50 )
     {
        set context.getToken = 1
     } 
     else
     {
       set context.getToken = 0
     }
     
     }
  
    
     if ( context.getToken = 1 )
     {
         //get the new token 
         //to do - stores theses values ina lookup and send the actual values for these
        $$$TRACE(" Make the CALL to get new token ")
	set httpRequestObj=##class(IHC.ITF.Request.WebcollectAzureToken).%New()	
	set httpRequestObj.form1 = context.GrantType	
	set httpRequestObj.form2 = context.Resource	
	set httpRequestObj.form3 = context.ClientID	
	set httpRequestObj.form4 = context.ClientSecret	
	set httpRequestObj.url = context.TokenUrl	
		
	$$$TRACE("Call the operation to get TOKEN")
	set tStatus=process.SendRequestSync("Op-Webcollect-Json-Wsrc-AZUREACCESSTOKEN",httpRequestObj,.retResponse)
     if ( tStatus=$$$OK) 
     { 
       if ( retResponse '= "" )
       {
	   $$$TRACE("  Return Response is not empty.... ")   
       set statusLine=""
       set statusCode=""
       set statusDesc=""
       set context.httpTokenResp=retResponse
       set statusLine=context.httpTokenResp.HTTPHeaders.GetAt("StatusLine")
       
      $$$TRACE("StatusLine: "_statusLine)
      if (statusLine'="")
      {
	     set statusCode=$piece(statusLine," ",2)
	     set statusDesc=$piece(statusLine," ",3)
      }
      
      set stream = retResponse.Stream
      set respData = ""
      While 'stream.AtEnd { 
       		set respData = respData _ stream.ReadLine(,.sc,.eol)       		
       	}
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc) 
       if (statusCode'="200"){
	    	if (statusCode="401"){
		   		$$$TRACE("  CheckError... ")
		   		set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid access token. Response: ["_respData_"]. Retrying...") 
		   	}elseif (statusCode="400"){
		    	$$$TRACE("  In Status Code 400... ")
		    	$$$TRACE(" respData "_respData)
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respData)      	 		      	 		
		    }elseif (statusCode="500"){
			    $$$TRACE("  In Status Code 500 (Internal server error)... ")
			    set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Response: ["_respData_"]. Retrying...") 
		    }else{			    
			    $$$TRACE("  DisableMsgError.... ")
        		set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Error Response from Microsoft Token Operation: "_respData) 
				 
		    }
		}else {
        		$$$TRACE("Azure token call status 200 OK !!! ")
           
      Set tcharStream = ##class(%GlobalCharacterStream).%New()
      Set tStatus = tcharStream.CopyFrom(context.httpTokenResp.Stream)
      set context.Token=""
      While 'tcharStream.AtEnd {
        Set context.Token = context.Token_tcharStream.Read($$$MaxStringLength)
      } 
      $$$TRACE("TOKEN REST SERVICE response: "_context.Token)
      Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName) 
      
     }
     }
     else
     { // this is a case where it successfully returns empty- in this case Retry message
     set errTxt = " Return Response is empty or Null ....,RETRY MS Token Service "
     $$$TRACE(errTxt)
     set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"TimedOut. Empty Response from Microsoft Token service: ["_errTxt_"]. Retrying ..") 
    
	     
     }
      
     } 
     else
     {
        set errTxt = $SYSTEM.Status.GetOneErrorText(status)
	    $$$TRACE("MS Token Service ERR TEXT: "_errTxt)
	    set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"TimedOut. No Successful Response from Microsoft Token service: ["_errTxt_"]. Retrying ..") 
     }	    
	
	}
	else
	{
	// No need to make call to get token ,use the token from the GLOBALs
	 $$$TRACE(" Use Token Stored in GLOBALS ")
	 set context.TokenOnly =  $GET(^IHC.CernADTJsonWebcollect("AzureToken"))
	
	}
      
     ]]]]><![CDATA[>
</code>
