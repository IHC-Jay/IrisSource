	 set updStatus = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst).ClaimStatusUpdate(tStatus,context.guId,context.schedId,context.batchNum+1,reqObj.DestinationFileName,.process)		
	 if (updStatus='$$$OK){
		 set context.errMsg = "Claim status update failed.."_$SYSTEM.Status.GetOneErrorText(updStatus)
		 set status1 = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst).createAndSendResponse("8",context.errMsg,context.schedId, context.errorFilePath,.process)		
		 set context.numErrBatchCounts =  context.numErrBatchCounts +1
	 }else{
		 set context.numSuccessBatchCounts =  context.numSuccessBatchCounts +1
		 $$$TRACE(" Batch count ["_(context.batchNum+1)_"] successful.")   
