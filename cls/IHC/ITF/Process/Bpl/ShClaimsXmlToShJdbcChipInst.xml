<Method name="createAndSendResponse">
<ClassMethod>1</ClassMethod>
<FormalSpec><![CDATA[retCode:%String,retDesc:%String,scheduleId:%String,destinationFilePath:%String,&process1:IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst]]></FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tmpStatus AS %Status=$$$OK
	
	set tRequest = ##class(Ens.StreamContainer).%New("")	 
	 set tStream = ##class(%Stream.GlobalCharacter).%New("")
	 set respStr = "<AppResponse><ReturnCode>"_retCode_"</ReturnCode><ReturnDesc>"_retDesc_"</ReturnDesc></AppResponse>"	 
	 do tStream.Write(respStr)	 
	 set tRequest.Stream = tStream	 
	 	  	 	  
	 set claimsOraXmlFileTargetConfigName=##class(Ens.Director).GetItemSettingValue(process1.%ConfigName,"Host","ClaimsOraXmlFileTargetConfigName",.pstatus)
	 set reqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream)
 	 set reqObj.DestinationFileName = scheduleId_".xml"
	 set reqObj.DestinationFilePath = destinationFilePath
	 try{
 	 	set tmpStatus = process1.SendRequestSync(claimsOraXmlFileTargetConfigName,reqObj)
 	 	if ($$$ISOK(tmpStatus)){
	 	 	$$$TRACE("Response file sent..."_reqObj.DestinationFileName )
 	 		set tmpStatus = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process1.%ConfigName, retDesc)
 	 	}
	 }catch(ex){
		 Set tmpStatus = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process1.%ConfigName,"Unable to write to file path :"_destinationFilePath_"Error:"_ex)   			 
	 }
 	  
   quit tmpStatus
]]></Implementation>
</Method>

<Method name="ClaimStatusUpdate">
<ClassMethod>1</ClassMethod>
<FormalSpec><![CDATA[tStatus:%String,guid:%String,scheId:%String,batchNum:%String,fileName:%String,&process1:IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst]]></FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tmpStatus AS %Status=$$$OK
	
	try{
		set claimsStatusUpdateTargetConfigName=##class(Ens.Director).GetItemSettingValue(process1.%ConfigName,"Host","ClaimsStatusUpdateTargetConfigName",.pstatus) 
		set clmUpdateStatusReqObj = ##class(IHC.ITF.Request.ShspMedicareJobStsUpdate).%New()
		set clmUpdateStatusReqObj.pFileGuid = guid
    	set clmUpdateStatusReqObj.pBatchNumber = batchNum
    	set clmUpdateStatusReqObj.pFileName = fileName
     	if ('tStatus) {
	 		 set isFileSent="15" 
	 	}else{
			 set isFileSent="14" 
	 	}
	 	set clmUpdateStatusReqObj.pJobStatus = isFileSent
  	 	$$$TRACE(" Before SHSP_CHIP_JOB_STS_UPD(Inst) call...")
     	set tmpStatus=process1.SendRequestSync(claimsStatusUpdateTargetConfigName,clmUpdateStatusReqObj,.dbResponse)
  	 	$$$TRACE(" After SHSP_CHIP_JOB_STS_UPD(Inst) call-status : "_tmpStatus)
	}catch(ex){
		$$$TRACE("$$$Inside update status catch....")	
		set errText = $System.Status.GetOneStatusText(ex)	
		set retDesc = "Error while calling the SP -- SHSP_CHIP_JOB_STS_UPD, Failed to update the claim status of 837I. BatchCount: ["_batchNum_"]"_errText	
		set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst).createAndSendResponse("8",retDesc,scheId, fileName,.process1)    	 	 			  
	}
  	 
	quit tmpStatus
]]></Implementation>
