<![CDATA[ 
		set clmMedicaidGenXmlRequest = ##class(IHC.ITF.Request.ShMedicaidClmGenXmlRequest).%New()  
		set clmMedicaidGenXmlRequest.pFileGuid = context.guId
		set clmMedicaidGenXmlRequest.pBatchNumber = context.batchNum +1
		$$$TRACE(" Begin SHSP_CHIP_CLM_GEN_XML(Inst) stored procedure call ... ")
		set tStatus=process.SendRequestSync(context.claimsShXmlTargetConfigName,clmMedicaidGenXmlRequest,.clmXmlResponse)
  		$$$TRACE(" After SHSP_CHIP_CLM_GEN_XML(Inst) stored procedure call ... "_tStatus)  
  		if (tStatus) {
  			$$$TRACE(" XML Response file size: "_clmXmlResponse.Size)
  			if (clmXmlResponse.Size=0){
	  			set returnDesc = "XML returned from Oracle SP is 0 bytes. Skipping the trigger file request.."
				set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst).createAndSendResponse("4",returnDesc,context.schedId, context.errorFilePath,.process)	  				
  			}
  			set fileReqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(clmXmlResponse) 
  			set fileReqObj.DestinationFilePath= context.oraArchiveFilePath
  			set fileReqObj.DestinationFileName = "HT000004-002_"_$zstrip($ZDATETIME($ZTIMESTAMP,3,1,2), "*P")_"_HT000015-300_"_clmMedicaidGenXmlRequest.pBatchNumber_".837.XML"
  			set context.fileName = fileReqObj.DestinationFileName 
  			set tStatus = process.SendRequestSync(context.claimsOraXmlFileTargetConfigName,fileReqObj)	  
	  		$$$TRACE(" Oracle Raw XML File sent status: "_tStatus)	  		
	  		if (tStatus=$$$OK){
		  		Set fileStream = ##class(%FileCharacterStream).%New()
				Set fStatus = fileStream.FilenameSet(context.oraArchiveFilePath_"/"_context.fileName)
				Set tReader=##class(%XML.Reader).%New()
				Set tSC=tReader.OpenStream(fileStream)
				if $$$ISERR(tSC){
					set returnDesc = "Failed to get XML file from Oracle SP call. Skipping the trigger file request.."
					set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst).createAndSendResponse("4",returnDesc,context.schedId, context.errorFilePath,.process)	  				
		  			set context.numErrBatchCounts =  context.numErrBatchCounts +1
	 				set context.batchNum = context.batchNum + 1
				}else{
					Set elementName = "MedicaidInstituitionalFile"
					set className = "SH.Chip.Inst.MedicaidInstituitionalFile"
					Do tReader.Correlate(elementName,className)
					set tCount = 0
					set sc = $$$OK
					While tReader.Next(.tRequest,.sc) {
						Set tCount=tCount+1
						set context.xmlDoc = tRequest
						$$$TRACE(" sc status :"_sc)			
					}
					$$$TRACE(" sc status(1) :"_sc)	
					If $$$ISERR(sc){
						Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Unable to create XML objects "_sc)   			 
					}		
					set context.isXmlResponse= "1"
					$$$TRACE(" isXmlResponse: "_context.isXmlResponse)
				}
	  		}else{
		  		set returnDesc = "Failed to get XML file from Oracle SP call. Skipping the trigger file request.."
		  		set context.errMsg = context.errMsg_returnDesc
		  		set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcChipInst).createAndSendResponse("4",returnDesc,context.schedId, context.errorFilePath,.process)	  				
		  		set context.numErrBatchCounts =  context.numErrBatchCounts +1
	 			set context.batchNum = context.batchNum + 1

	  		}	
  		}else{
	  		set fileName = "HT000004-002_"_$zstrip($ZDATETIME($ZTIMESTAMP,3,1,2), "*P")_"_HT000015-300_"_clmMedicaidGenXmlRequest.pBatchNumber_".837.xml.log"	  		
	  		set errText = $SYSTEM.Status.GetOneErrorText(tStatus)  	 		
  	 		s pStream = ##class(%Stream.GlobalCharacter).%New()
			do pStream.Write(errText)
			set tRequest = ##class(Ens.StreamContainer).%New(pStream)	 
			set fileReqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream) 
  			set fileReqObj.DestinationFilePath= context.errorFilePath
  			set fileReqObj.DestinationFileName = fileName
  			set tStatus = process.SendRequestSync(context.claimsOraXmlFileTargetConfigName,fileReqObj)  			
  			set context.numErrBatchCounts =  context.numErrBatchCounts +1
	 		set context.isXmlResponse = "3"
	 		$$$TRACE( " isXmlResponse : "_context.isXmlResponse)
	 		set context.batchNum = context.batchNum + 1	 

	  	}
			
	]]]]><![CDATA[>
