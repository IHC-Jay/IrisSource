<code name='Call File Operation' xpos='200' ypos='1550' >
<![CDATA[ //Call the FTP operation through Sync method to get the status 
 
 Set tSC = process.SendRequestSync(context.targetConfigNames, context.fileRequest, .pResponse, 3600)
 If $$$ISERR(tSC)
 {
  $$$TRACE("FTP operation failed - Status : "_tSC_"targetConfigNames  : "_context.targetConfigNames _" File name : "_context.fileRequest.OriginalFilename)
 }
 Else
 {
 $$$TRACE("FTP operation is successful, deleting the encrypted file : "_context.fileRequest.OriginalFilename)
 // delete the file , since file operation is success
 set deleteSuccess = ##class(%File).Delete(context.fileRequest.OriginalFilename)
 If $$$ISERR(deleteSuccess)
 {
  $$$LOGERROR("Unable to delete temporary file :"_context.fileRequest.OriginalFilename)
 } 
 
 }
 
 ]]]]><![CDATA[>
