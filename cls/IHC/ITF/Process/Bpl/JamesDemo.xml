<code name='Create Stream and Email' xpos='200' ypos='1450' >
<![CDATA[ // Create Stream and failure email
 set encryptedFileName=context.filePath_context.encryptedFileName
 if (##class(%File).Exists(encryptedFileName)=0){
     set emailAlertRequest=##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError(context.failEmailSubject,context.failEmailText,context.configName)
 do process.SendAlert(emailAlertRequest)
 set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Encrypted file does not exists : "_encryptedFileName_" so unable to send the file to ASH through SFTP Operation")
 }
   
 Set streamFile=##class(%FileCharacterStream).%New()
 Do streamFile.LinkToFile(encryptedFileName)

 //set stream=##class(%Stream.GlobalCharacter).%New()
 //Set status = stream.CopyFromAndSave(streamFile)
 set context.fileRequest=##class(Ens.StreamContainer).%New(streamFile)
 set context.fileRequest.OriginalFilename = encryptedFileName
 
