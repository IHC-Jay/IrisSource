<code name='ReadValues' xpos='335' ypos='800' >
<![CDATA[  //Global variables 
       //ID|LastName|FirstName|MiddleName|Suffix|Gender|BirthDate|SSN|Street1|Street2|City|State|Zip|Phone
      
       
       set updLastName = $replace(request.GetValueAt("PIDgrp.PID:PatientName(1).familylastname.familyname") ,"-","")
       if (updLastName ="DO NOT USE"){
	       set updLastName = ""
	   }

       set lastNameUpd = $ZCVT($ZSTRIP(updLastName,"<=>"," "),"O","URL")
       set firstNameUpd = $ZCVT($ZSTRIP(request.GetValueAt("PIDgrp.PID:PatientName(1).givenname"),"<=>"," "),"O","URL")
       if (firstNameUpd = "OR"){
	       set firstNameUpd = $replace(firstNameUpd,"OR","")
	   }
       
       
        set updMidName = $replace(request.GetValueAt("PIDgrp.PID:PatientName(1).middleinitialorname"),"-","")
  	    $$$TRACE( " updMidName: " _updMidName)
        set midNameUpd = $ZCVT($ZSTRIP(updMidName,"<=>"," "),"O","URL")
       
        set ssn = request.GetValueAt("PIDgrp.PID:SSNNumberPatient")
        set updSsn=$zstrip(ssn,"*P")

        set bdate = request.GetValueAt("PIDgrp.PID:DateTimeOfBirth.timeofanevent")
        if ($L(bdate)>8){
	        set tmpDate = $E(bdate,1,10)
	        set bdateList = $LISTFROMSTRING(tmpDate, "/")
	        set bdateListLength = $LISTLENGTH(bdateList)
	        if bdateListLength=3{	   
	         if ($L($LIST(bdateList,2)=1)){
		         set month = "0"_$LIST(bdateList,2)
		         $$$TRACE( " month "_month)
		     }
		     if ($L($LIST(bdateList,1)=1)){
		         set dayy = "0"_$LIST(bdateList,1)
		          $$$TRACE( " dayy "_dayy)
		     }
			 set bdate = $E($LIST(bdateList,3),1,4)_month_dayy
			 $$$TRACE( " Modified Birth Date " _ bdate)
		    }
	    }
	    set updZip = request.GetValueAt("PIDgrp.PID:PatientAddress(1).ziporpostalcode")
	    if ($L(updZip)>5){
         set updZip = $E($ZSTRIP(request.GetValueAt("PIDgrp.PID:PhoneNumberHome(1).phonenumber1"),"*P"),1,5)
	    }
                
        set context.demogrParams = "givenName="_$ZSTRIP(firstNameUpd,"*W")_"&familyName="_$ZSTRIP(lastNameUpd,"*W")_"&middleName="_$ZSTRIP(midNameUpd,"*W")_"&dob="_bdate_"&gender="_request.GetValueAt("PIDgrp.PID:Sex")_"&zip="_updZip_"&phone="_$ZSTRIP(request.GetValueAt("PIDgrp.PID:PhoneNumberHome(1).phonenumber1"),"*P")_"&ssn="_updSsn_"&ctx=INMT"_"&fetchMultiple=true&rows=10"
       
       // set context.demogrParams = "givenName="_firstNameUpd_"&familyName="_lastNameUpd_"&middleName="_midNameUpd_"&dob="_bdate_"&gender="_request.GENDER_"&zip="_updZip_"&phone="_$ZSTRIP(request.HOMEPHONE,"*P")_"&ssn="_request.SSN_"&fetchMultiple=true&rows=1"
       
       $$$TRACE( " context.demogrParams ..."_context.demogrParams)
         
       
  ]]]]><![CDATA[>
</code>
<code name='CallWebServiceAccessTokenFromPing' xpos='335' ypos='900' >
<![CDATA[ 
  $$$TRACE(" Target Operation to get AccessToken from Ping service " _ context.accessTokenTargetConfigName)   
   set httpRequestObj=##class(EnsLib.HTTP.GenericMessage).%New()   
   set status =  process.SendRequestSync(context.accessTokenTargetConfigName,httpRequestObj,.accessTokenResponse)
   if ($$$ISOK(status)){
      $$$TRACE("AcsessToken Operation status - OK")
      set context.restAccessTokenHttpResponse=accessTokenResponse      
      Set tcharStream = ##class(%GlobalCharacterStream).%New()
      Set tStatus = tcharStream.CopyFrom(context.restAccessTokenHttpResponse.Stream)
      set text=""
      While 'tcharStream.AtEnd {
        Set text = text_tcharStream.Read($$$MaxStringLength)
      } 
      set context.accessToken = text
      $$$TRACE("Accss Token from Ping Service: "_context.accessToken)
      if (context.accessToken=""){
	      $$$TRACE(" Access Token is blank/empty")
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," No Access Token from ping service. ") 
	  }      
    }
    else {
	    $$$TRACE("Calling Ping Service to get the Access Token failed!!!")
       set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Calling Ping Service to get the Access Token failed!!!") 
    }
    
     $$$TRACE(" request.ID : "_request.GetValueAt("PIDgrp.PID:PatientIdentifierList(1).ID"))
     //Set context.empiMod = request.ID # 10
    //$$$TRACE("Empi# Modulus: "_context.empiMod)      
    
   ]]]]><![CDATA[>
</code>
<code name='callPatientSearchService' xpos='335' ypos='1000' >
<![CDATA[  

       
      set context.statusValue = ""
      $$$TRACE("Calling Patient search service(1111) to get IHC CMRN#..") 
      set operType = "SEARCH"
      //set tarConfigName = context.targetList.GetAt(1)_context.empiMod 
      set searchCmrntarConfigName = context.searchcmrnTargetConfigName 
      set streamRequest=##class(Ens.StringContainer).%New()
      set streamRequest.StringValue= context.demogrParams
      $$$TRACE(" SearchCMRN Target Operation: " _ searchCmrntarConfigName) 
      set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.HiePatientService).%New()  
      set httpPingServiceRequestObj.accessToken = context.accessToken
      set httpPingServiceRequestObj.operationType = operType  
      set httpPingServiceRequestObj.identifier = ""
      set httpPingServiceRequestObj.streamObject = streamRequest
      
      $$$TRACE(" Calling Patient Service "_operType_" - BEGIN ")
      set status = process.SendRequestSync(searchCmrntarConfigName,httpPingServiceRequestObj,.patientServiceResponse)
      $$$TRACE(" Calling Patient Service "_operType_" - END ")
      
      $$$TRACE("  Patient Service: "_status)
      if (status=$$$OK){
	    $$$TRACE("Call Hie Patient Service "_operType_" Operation OK status.")      
        set patServiceResponseData=patientServiceResponse.Stream  
        set statusCode = patientServiceResponse.Attributes.GetAt("StatusCode")       
        set stream =   patServiceResponseData
       	set respData = ""
       	While 'stream.AtEnd { 
       		set respData = respData _ stream.ReadLine(,.sc,.eol)       		
       	}
        $$$TRACE(" httpStatusCode(11): "_statusCode) 
        
        if (statusCode'="200"){
	    	if (statusCode="401"){
		   		$$$TRACE("  CheckError... ")
		   		set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid access token. Response: ["_respData_"]. Retrying...") 
		   	}elseif (statusCode="400"){
		    	$$$TRACE("  In Status Code 400... ")
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respData)
		    }elseif(statusCode="500"){
			    $$$TRACE("  In Status Code 500... ")
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respData)
		    }else{
		    	$$$TRACE("  DisableMsgError.... ")
        		set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Response from Patient Service Post Operation: "_respData) 
		    }
		} else {
        		$$$TRACE("PatientService call status 200 OK !!! ")
        		Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName) 
        		
        		set respJSONstring = respData          		
          		
          		set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respJSONstring) 
          		set statusVal = consumedJSONobj.%Get("status")  
          		$$$TRACE("  statusVal: "_statusVal)     
      			if (statusVal="SUCCESS"){ 
      			        set getmrn = 0
      			        set context.CernerMrnvalues = ""
      				//set mrn = (consumedJSONobj.%Get("data")).%Get("mrn")
      				//$$$TRACE(" CMRN#: "_mrn)
      				
      				set statusDetailsArr = (consumedJSONobj.%Get("data").%Get("patients")) 
      				Set arrObj = statusDetailsArr.%GetIterator()
  			      
  				while arrObj.%GetNext(.key, .value)
  				{
		  	          Set arrNextElemObj = value.%GetIterator()
		  	          while arrNextElemObj.%GetNext(.key, .value) {
		  		     if (key = "primaryIds")
  				        { 
		  			   Set arrElem2Obj = value.%GetIterator()	 
	  			           while arrElem2Obj.%GetNext(.key, .value) {
	  			             Set arrElem3Obj = value.%GetIterator()
		  	                     while arrElem3Obj.%GetNext(.key, .value) {
		  			       //$$$TRACE("  key: "_key_" Value: "_value)
		  			       if ( (key ="assigningAuthority") && ( value = "INMT") )
		  			       {
		  			          //$$$TRACE("value is INMT")
		  			          set getmrn = 1
		  			          //$$$TRACE("getmrn value is : "_getmrn)
		  			       }
		  			       if ( (key = "mrn") && (getmrn = 1) )
		  			       {
		  			         // $$$TRACE("value value is : "_value)
		  			          if (context.CernerMrnvalues ="")
		  			          {
		  			           set context.CernerMrnvalues = value
		  			          }
		  			          else
		  			          {
		  			            set context.CernerMrnvalues = context.CernerMrnvalues_"|"_value
		  			          }
		  			          set getmrn = 0 
		  			         // $$$TRACE("getmrn value is : "_getmrn)
		  			          //$$$TRACE(" CernerMrnvalues : "_context.CernerMrnvalues)
		  			       }
		  			     }
		  			    }
		  			   }
		  			  }
  				}
        	              }
 	  			$$$TRACE(" Final CernerMrnvalues : "_context.CernerMrnvalues)
 	  			
		}   
      }
    
    
    
   ]]]]><![CDATA[>
</code>
<code name='Set PID-3.1' xpos='335' ypos='1100' >
<![CDATA[ 
 // Check if Verato returned CMRN
 if (context.CernerMrnvalues = "" )
 {
    set isVeratoCMRNPresent = 0
 }
 else
 {
    set isVeratoCMRNPresent = 1
 }
 
 $$$TRACE("isVeratoCMRNPresent is : "_isVeratoCMRNPresent)
 $$$TRACE("isOrderCMRNPresent is : "_context.isOrderCMRNPresent)
 
 //Scenario 1 - No CMRN is in the Order or found in Verato, then Open Doc ID is the only ID passed on
 
 if (context.isOrderCMRNPresent = 0 && isVeratoCMRNPresent  = 0)
 {
   // Get OpenDoc MRN
   set context.pid31value = request.GetValueAt("PIDgrp.PID:PatientIdentifierList(1).ID")
 }
 elseif (context.isOrderCMRNPresent = 0 && isVeratoCMRNPresent = 1)  //Scenario 2 - No CMRN is in  the Order and Verato returns one of more CMRNs
 {
   // Get the First CMRN returned by the Verato
   set context.pid31value = $PIECE(context.CernerMrnvalues,"|")
 }
 
 $$$TRACE("context.pid31value is : "_context.pid31value)
]]]]><![CDATA[>
