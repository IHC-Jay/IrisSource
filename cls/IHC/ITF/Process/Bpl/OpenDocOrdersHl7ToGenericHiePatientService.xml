<code name='Check CMRN Present in Message' xpos='200' ypos='550' >
<![CDATA[  
  
  set pid31= request.GetValueAt("PIDgrp.PID:PatientIdentifierList(1).ID")
  $$$TRACE("pid31 is : "_pid31)
 
  // check if Order record have CMRN
 if (pid31 '="")
 {
    // check if PID3.1 starts with OD
  set getstartletter = $EXTRACT(pid31,0,2)
  $$$TRACE("getstartletter is : "_getstartletter)
 
   if (getstartletter ="OD")
   {
    // Its a OpenDoc MRN
    set context.isOrderCMRNPresent = 0
   }
   else
   {
   $$$TRACE("Not OD so its CMRN")
     set context.isOrderCMRNPresent = 1
   }
 }
 else
 {
   // PID-3.1 is empty so no CMRN is present
   set context.isOrderCMRNPresent = 0
 }
 
   $$$TRACE("isOrderCMRNPresent is : "_context.isOrderCMRNPresent)
   
  
   ]]]]><![CDATA[>
</code>
