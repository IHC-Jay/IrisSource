<code name='Check OBR4.1 Universal service ID' xpos='470' ypos='1200' >
<annotation><![CDATA[Check OBR4.1 Universal service ID]]]]><![CDATA[></annotation>
<![CDATA[ set obrGrprAvailable = ""
 set obrGrprAvailibleSuccess = ""
 set obrGrprID = ""
 
 //Changes for HL72.5
 
 if (request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceIdentifier.NameofAlternateCodingSystem") = "L" )
 {
   set obrGrprID = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceIdentifier.AlternateIdentifier")
 }
 else
 {
 set obrGrprID = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceIdentifier.Identifier")
 }
 
 //
  
 $$$TRACE("Debug obrGrprID is: " _obrGrprID)

 set orbGrprAvailable = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestResultsHl7ToPowerPathMicrolabHl725.ObrGroupID", obrGrprID,.obrGrprAvailibleSuccess)
 
 $$$TRACE("Debug obrGrprAvailibleSuccess is: " _obrGrprAvailibleSuccess)

 if ((obrGrprAvailibleSuccess '= 1))
 {
      $$$TRACE("BAD OR MISSING UNIVERSAL SERVICE ID (OBR4.1.")
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(obrGrprID, "OBR Group Id Not in lookup table.")
 }
 else
 {
      $$$TRACE("Lookup successful")
 }]]]]><![CDATA[>
