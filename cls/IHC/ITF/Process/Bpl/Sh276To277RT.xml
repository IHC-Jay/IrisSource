<code name='Check Reply Code Actions' xpos='200' ypos='450' >
<annotation><![CDATA[Check Reply Code Action configuration]]]]><![CDATA[></annotation>
<![CDATA[
 /* Check if ReplyCodeActions have been configured or not */
 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
  
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Initialization error, No ReplyCodeActions found")
 }
 
 	  ]]]]><![CDATA[>
</code>
<code name='Parse and Extract' xpos='200' ypos='550' >
<annotation><![CDATA[Parse X12 and extract values needed for WS call]]]]><![CDATA[></annotation>
<![CDATA[ 
 /* Allocating 2 GB of memory for the process */
  
  //SET $ZSTORAGE=2048000  
 
 
 /* Check if the received data is a X12 file or not and report error if it is not a X12 message. Parse the file at Transaction Level and extract values needed for webservice call */
  $$$TRACE("CR276: " _ $L(request.Payload))

  set context.orig276 = ##class(EnsLib.EDI.X12.Document).ImportFromString(request.Payload, .stat)
  set context.orig276.DocType = "HIPAA_5010:Interchange" 
 
   try
   {          
       ///set context.inXmlDoc.DocType = "HIPAA_5010:Interchange" 
       set context.GSCounter = context.orig276.ChildCount   
              
       $$$TRACE( "InterchangeSenderID: " _ $ZSTRIP(context.orig276.GetValueAt("ISA:InterchangeSenderID"), "<>W"))
       	
       #dim individualGroup As EnsLib.EDI.X12.Document
       set individualGroup = context.orig276.getNthChild(1,2)

       $$$TRACE( "# of STs: " _ individualGroup.ChildCount)  
       #dim STRecord As EnsLib.EDI.X12.Document 
		  
       set STRecord=individualGroup.getNthChild(1,2)
       if (STRecord.DocType = "")
       {
     	 set STRecord.DocType = "HIPAA_5010:276"
       }
            
    }
    Catch ex 
    { 
      if 1=ex.%IsA("%Exception.SystemException") 
      {
        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
      }
      else 
      {       
       Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Interchange level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)  
      }  
    }  
    ]]]]><![CDATA[>
