<![CDATA[ set claimFound="N"
 set tStatus=process.SendRequestSync("Op-Sh-276-Wssc", context.claimDtlRequest, .pResponse)
 
 $$$TRACE("GetOutbound277: " _ tStatus)
  
 if ('tStatus) 
 {     
    set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected WebService response returned or WS call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
 } 
 else 
 {
   if ($IsObject(pResponse))
   {    
     set context.wsResponse=pResponse
     set context.errFlg=pResponse.GetClaimDetailsResult.GetNext().ErrorFlag
     set claimFound=pResponse.GetClaimDetailsResult.GetNext().ClaimFoundFlag
     $$$TRACE("Response CLaim Found : " _ claimFound)
   }
   else
   {
     Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName, "NULL response returned from WebService ")
   }

 }

]]]]><![CDATA[>
