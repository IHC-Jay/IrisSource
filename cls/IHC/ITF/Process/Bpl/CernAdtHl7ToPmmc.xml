<code name='GetUniqueRepByNcid' xpos='200' ypos='750' >
<annotation><![CDATA[getRepFromNcid]]]]><![CDATA[></annotation>
<![CDATA[     
   set ncid = request.GetValueAt("ZZ1:ZZ12SendFacilityNcid")  
     try{
	    $$$TRACE(" Calling GetUniqueRepByNcid... " )
         set status=##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getRepFromNcid(ncid, "ZZ-12", "522446925", context.hddTargetConfigName, .process, .resp) 
        $$$TRACE(" Returned Rep from HDD: " _ resp)
        set context.facilityRep = resp
        $$$TRACE("Facility Rep: " _ context.facilityRep) 
        
        set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToPmmc.Lookup.AllowedPmmcFacilities", context.facilityRep, .retVal )
        
        if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {       
     		$$$TRACE("Sending facility rep is not in the lookup table. Skip the message...")
     		Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(context.facilityRep, "Not allowed facility rep ["_ context.facilityRep_"] iCentra MSH-4 NCID: "_ncid_". Skipping the record." )
    	}
     }catch(exVar){
	     set exVarData = $ZSTRIP(exVar.Data,"*C")
	     $$$TRACE(" exVarData --> "_exVarData)
	     if exVar.Code [ "ITFCOMMON:10108" {
		    set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,exVarData)
	   	 }elseif(exVar.Code [ "ITFCOMMON:10109") {
		   set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,exVarData)			
		 }elseif(exVar.Code [ "ITFCOMMON:10106") {
		   	 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,exVarData)		  
		 }else{
			 //Any other Unexpected error
			 set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Shutting down..Unknown Error."_exVarData)
		 }
	 }
   
  ]]]]><![CDATA[>
</code>


