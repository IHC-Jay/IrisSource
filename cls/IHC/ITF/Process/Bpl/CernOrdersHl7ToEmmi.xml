     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.hddContextCernerToIhcLocation, "MSH4:Facility")  	  	
     $$$TRACE("Hdd Request MSH-4 Sending Facility is " _ context.facId )     		
 } else {
	 // Skip message if PV1-3.4 is empty
	 set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH-4 Sending Facility is empty. Skipping the record.")	 
 }
 
 set pid8Sex = request.GetValueAt("PIDgrp.PID:Sex")  	
 if (pid8Sex '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid8Sex, context.hddContextInterface, "PID8:Sex")  	  	
     $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 }
  
 set orc1OrderControl = request.GetValueAt("ORCgrp(1).ORC:OrderControl")  	
 if (orc1OrderControl '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , orc1OrderControl, context.hddContextInterface, "ORC1:OrderControl")  	  	
     $$$TRACE("Hdd Request ORC1-1 OrderControl is " _ orc1OrderControl)     		
 }
 $$$TRACE(" After setting all NCID values")  
