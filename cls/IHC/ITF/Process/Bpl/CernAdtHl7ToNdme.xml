       set transplantType = request.GetValueAt("OBX("_(obxIndex)_"):5(1)")
       if (((transplantCode ="CPA_OR_CPM") && (transplantType ="CPA"))) {
          $$$TRACE("SKIPPING RECORD, This is a CPA record")
           set context.globalSkipMsg = context.globalSkipMsg _" SKIP RECORD - This is a CPA record "
