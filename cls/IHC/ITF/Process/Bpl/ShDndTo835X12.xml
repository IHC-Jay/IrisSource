<trace name='Request variable trace' value='request_"Before calling File reading code"_request' xpos='200' ypos='650' />
<code name='Create Array of values' xpos='200' ypos='750' >
<![CDATA[ $$$TRACE("File : " _ request.Filename)
 set DndId = ""
 While 'request.AtEnd {
   set line = request.ReadLine()
   Set context.inpDnd = context.inpDnd _ line _ ", "
   if ($FIND(line,"ID#") = 4)
   {
     set DndId = $PIECE(line, "#", 2)
   }
  }
  $$$TRACE(context.inpDnd)
  
 $$$TRACE( "Parse DndCoreEraRecord Id: " _ DndId)
 
 if (DndId = "")
 {
   set status = $$$ERROR($$$EnsErrGeneral, "No DnD Id to process")
   QUIT
 }
 
 
 set list = ##class(IHC.ITF.DStruc.DndCoreEraRecord).%OpenId(DndId)
 $$$TRACE( list.%Id() _", CKPYREFID: " _ list.CKPYREFID _", Status: " _ list.Status)
 
 set list.TriggerTime = $ZDATETIME($HOROLOG,3, 1)
 set list.Status = "Processed"
 set stat = list.%Save()
 $$$TRACE( "Update Status: " _ stat)
 
 #dim dndCoreflds as IHC.ITF.DStruc.DndCoreEraRecordFields;
 set dndCoreflds = list.ChildProp
 $$$TRACE( "DndCoreEraRecordFields Count(): " _ dndCoreflds.Count())

 set row = ""
 set nxt = dndCoreflds.GetNext(.row)
 set num =1
 set context.loopSegEleValueArr = ##class(%ArrayOfDataTypes).%New()

 set prevSEGMENT = ""

 set segmentInd = 1

 set fldNum = 0
 set fldExists = 0
 set eleNum = 0
 
 set prevLoop = ""
 set newLoop = 0
 set num1000A = 0
 set num1000B = 0
 set num2000 = 0
 set num2100 = 0
 set num2110 = 0
 set keyStr = "", base2000Str = "", base2100Str = ""
 set emptyFldVal = 0
 set svcFldVal = 0
 
  For num=1:1:dndCoreflds.Count()
 {
	 if ('$IsObject(nxt))
	 {
		 quit
	 }
	 
	 // Is there data in the field?
	 set fldVal = $ZSTRIP(nxt.ELEMENTVALUE, "<>W")
	 if (fldVal = "")
	 {
		 set nxt = dndCoreflds.GetNext(.row)
		 set emptyFldVal = emptyFldVal  + 1
		 continue
	 }
	 
	 // $$$TRACE( num _". " _ nxt.LOOP _ "-" _	nxt.SEGMENT _ ": " _ nxt.ELEMENT _"= " _ fldVal)
	 set eleNum = $NUMBER(+nxt.ELEMENT, "I")
	 // New Loop - update index numbers
	 if (prevLoop '= nxt.LOOP)
	 {
		 set newLoop = 1
		 
		 // Update loop #s
		 if ("1000A" = nxt.LOOP)
		 {
			 set num1000A = num1000A + 1
			 set num1000B = 0
			 set num2000 = 0
			 set keyStr = "1000A," _ num1000A
		 }
		 elseif ("1000B" = nxt.LOOP)
		 {
			 set num1000B = num1000B + 1
			 set num2000 = 0
			 set keyStr = "1000B," _ num1000B
		 }
		 elseif ("2000" = nxt.LOOP)
		 {
			 set num2000 = num2000 + 1
			 set num2100 = 0
			 set num2110 = 0
			 set num1000A = 0
 			 set num1000B = 0
 			 set keyStr = "2000," _ num2000
 			 set base2000Str = keyStr
		 }
		 elseif ("2100" = nxt.LOOP)
		 {
			 set num2100 = num2100 + 1
			 set num2110 = 0
			 set keyStr = base2000Str _ ",2100," _ num2100
			 set base2100Str = keyStr
		 }
		 elseif ("2110" = nxt.LOOP)
		 {
			 set num2110 = num2110 + 1
			 set keyStr = base2100Str _ ",2110," _ num2110
		 }
		 else
		 {
			 set keyStr = nxt.LOOP
		 }
		 	
		 // $$$TRACE( keyStr)
	 }
	 else
	 {
		 set newLoop = 0
	 }
	
         // Combine subfields into SVC-01
	 if ( (nxt.SEGMENT = "SVC") && ($FIND(nxt.ELEMENT, "01") = 3)) // First SVC field
	 {
		 set eleNum = 1
		 
		 if (newLoop = 0) // Multiple 2110 in same 2100
		 {
			if ("2110" = nxt.LOOP)
			 {
				 set num2110 = num2110 + 1
				 set keyStr = base2100Str _ ",2110," _ num2110
			 }
		 }


		 if ( $FIND(nxt.ELEMENT, "01-1") = 5) 
		 {
			 set fldVal = nxt.ELEMENTVALUE
			 $$$TRACE( " ------- SVC: " _ nxt.LOOP _ " " _ nxt.SEGMENT _" " _ nxt.ELEMENT _"= " _ nxt.ELEMENTVALUE)

			 set nxt = dndCoreflds.GetNext(.row)
			 if ( ($FIND(nxt.ELEMENT, "01-2") = 5)  &&($ZSTRIP(nxt.ELEMENTVALUE, "<>W") '= ""))
			 {
				 set fldVal = fldVal _ ":" _ $ZSTRIP(nxt.ELEMENTVALUE, "<>W")
				 $$$TRACE( "  ------- SVC-02: " _ nxt.LOOP _ "/" _ nxt.SEGMENT _"/" _ nxt.ELEMENT _ ": " _ fldVal _ "= " _ nxt.ELEMENTVALUE)
				 

				 set nxt = dndCoreflds.GetNext(.row)
				 if ( ($FIND(nxt.ELEMENT, "01-3") = 5) &&($ZSTRIP(nxt.ELEMENTVALUE, "<>W") '= ""))
				 {
					 set fldVal = fldVal _ ":" _ $ZSTRIP(nxt.ELEMENTVALUE, "<>W")
					 $$$TRACE( "   ------- SVC-03: " _ nxt.LOOP _ "/" _ nxt.SEGMENT _"/" _ nxt.ELEMENT _ ": " _ fldVal _ "= " _ nxt.ELEMENTVALUE)
					

				 }
			 }
		 }
		 set svcFldVal = svcFldVal + 1
	 }
	 elseif ((nxt.ELEMENT = 1) || (nxt.ELEMENT = "01")) 
	 {
		 
		 if (prevSEGMENT = nxt.SEGMENT)
		 {
			set segmentInd = segmentInd + 1
			
		 	$$$TRACE( " ------- ELEMENT = 1 --- " _ nxt.LOOP _ " " _ nxt.SEGMENT _ " -- GROUP: " _ segmentInd)
		 }
		 else
		 {
			 set segmentInd = 1
		 }
		 set prevSEGMENT = nxt.SEGMENT
	 }
	 set insStr = keyStr _	"," _ nxt.SEGMENT _"," _ segmentInd _ ","  _ eleNum 
	 $$$TRACE( fldNum  _". " _ insStr  _"= " _ fldVal _ " => " _ $LENGTH(insStr, ","))
	 set prevLoop = nxt.LOOP
	 
	 if (context.loopSegEleValueArr.GetAt(insStr))
	 {
		 $$$LOGERROR( "  *** One or more fields overwritten: " _ insStr _ "= " _ context.loopSegEleValueArr.GetAt(insStr))
		 set fldExists = 1
		 QUIT
	 }
	 	 
         set fldNum = fldNum + 1
         
         // Field Name with incremented number
         // This array is used in the DTL to map to X12
         Do context.loopSegEleArr.SetAt(insStr, fldNum)
         
         // Field Value with name
         Do context.loopSegEleValueArr.SetAt(fldVal, insStr)
     
	 set nxt = dndCoreflds.GetNext(.row)
 }
 
 
 if (fldExists = 1)
 {
	 set status = $$$ERROR($$$ObjectScriptError, "  *** One or more data fields overwritten *** ")
	 QUIT
 }
 $$$TRACE( "-=- Got valid: " _ fldNum _ " fields from DB from DndCoreEraRecordFields: " _ dndCoreflds.Count() _ ", Empty values: " _ emptyFldVal _ ", # of subfields merge for SVC: " _ svcFldVal  )]]]]><![CDATA[>
</code>
<code name='Get segments and fields' xpos='200' ypos='850' >
<![CDATA[ set key=""
 // Get all unique segments with #s 
 // Example:
 // loopSegEleArr contains: Key = Value
 // 2000,1,2100,1,2110,2,SVC,1,1 = HC:83036
 // This has 9 values and the field value is HC:83036
 // odd number 1,3, 5, 7: segment name, even number 2, 4, 6, 8: index
 // Last number is the field index
 
 // 2000,1,2100,1,2110,2,SVC - These 7 fields makes a Unique segment
 //
 for ind=1:1:context.loopSegEleArr.Count()
 {
	 set key = context.loopSegEleArr.GetAt(ind) quit:key=""  

	 if ($LENGTH(key, ",") >= 4)   
	 { 
	    set flds = $LENGTH(key, ",")
	    // $$$TRACE( flds _". " _ key)
	    
	    // Get maximum field index - Last field is the field number
	    if ( $PIECE(key, ",", flds) > context.maxFlds.GetAt($PIECE(key, ",", 1, flds-1)) )
	    {
		    Do context.maxFlds.SetAt($PIECE(key, ",", flds), $PIECE(key, ",", 1, flds-1)  )
		    // $$$TRACE( "   Set max flds: " _ $PIECE(key, ",", flds) _" , " _ $PIECE(key, ",", 1, flds-1) )
	    }
	 	
	    Do context.multiSegs.SetAt($PIECE(key, ",", flds-1), $PIECE(key, ",", 1, flds-2)  ) 
	  		
	 }
	 
	 else
	 {
		 $$$LOGERROR( " ---- TBD ---" _ $LENGTH(key, ","))
		 QUIT
	 }

 }
 
 $$$TRACE( "# of Segments to map: " _ context.multiSegs.Count())
 
 /***
 set key=""
  set num = 1
 for  {
	 set value=context.multiSegs.GetNext(.key)  quit:key=""  
	  $$$TRACE( "Segment " _ num _". " _ key _ ", # of loops: " _ value )	 
	 set num = num + 1
 }
 ***/
 

 
 
]]]]><![CDATA[>
