<![CDATA[ $$$TRACE("Inbound data size: " _ request.Stream.Size _", File: " _ ##class(%File).GetFilename(request.OriginalFilename))
 
 if (request.%Extends("Ens.StreamContainer"))
 {
    if (request.Stream.Size < 108)
    {
       set context.ProcessMsg=0       
    }
    else
    {
 
       try
       {
           $$$TRACE("Import X12: " _ request.Stream.Size)
	   set context.x12Doc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.Stream, .stat)
	   if ( ($$$ISOK(stat)) && ($IsObject(context.x12Doc)) && (context.x12Doc.%Extends("EnsLib.EDI.X12.Document")) )
	   {
		 $$$TRACE("Inbound data is X12")
	   }
	   else
	   {
		   set context.ProcessMsg=0
	   }
       }
       Catch sc
       {
          $$$TRACE(" EnsLib.EDI.X12.Document exception: " _ sc.AsSystemError())
          set context.ProcessMsg=0
       }
       $$$TRACE(request.OriginalFilename)
    }
 }
 else
 {
   set context.ProcessMsg=0
 }
         
 ]]]]><![CDATA[>
