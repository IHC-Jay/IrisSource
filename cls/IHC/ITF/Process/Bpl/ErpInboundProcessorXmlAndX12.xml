<code name='Process X12, Get TP Link' xpos='740' ypos='1100' >
<![CDATA[ 
 if ( ($ISOBJECT(context.x12Doc)) && (context.x12Doc.%Extends("EnsLib.EDI.X12.Document")) )
  {
      set context.x12Doc.DocType = "HIPAA_5010:Interchange:Group"
      
  	 set context.interchangeSenderID = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeSenderID"), "<>W") 
  	 set context.interchangeReceiverID = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeReceiverID"), "<>W")
  	 
	 $$$TRACE( context.interchangeSenderID  _ " -> " _ context.interchangeReceiverID )
	 $$$TRACE( context.x12Doc.GetValueAt("ISA:InterchangeControlNumber"))

 	
 	set GSnum = 1
 	set GSCounter = context.x12Doc.ChildCount
        set mmId = $EXTRACT($ZDATE($HOROLOG, 8), 1, 6)
       
  	$$$TRACE(  " GS ChildCount " _ GSCounter)
       /* Iterates through available number of group's and collects group level information and sets to gsDoc object */
          set segX12Data = ""
          while ( GSnum <= GSCounter)
          { 
            set individualGroup = context.x12Doc.getNthChild(GSnum,2)
            set individualGroup.DocType = "HIPAA_5010:Group"
	        
	        set context.applicationSendersCode = individualGroup.GetValueAt("GS:ApplicationSendersCode")        
	        set context.applicationReceiversCode = individualGroup.GetValueAt("GS:ApplicationReceiversCode")	        
	        set context.groupControlNumber = individualGroup.GetValueAt("GS:GroupControlNumber")
	        set context.functionalIdentifierCode = individualGroup.GetValueAt("GS:FunctionalIdentifierCode")
	        
	        set context.geNumberofTransactionSets = individualGroup.GetValueAt("GE:NumberofTransactionSetsInclu")

	        $$$TRACE( "GS: " _ context.applicationSendersCode _" -> " _ context.applicationReceiversCode _ ", Ctrl # " _ context.groupControlNumber )
	        
	        set STCounter = individualGroup.ChildCount 
	        $$$TRACE(  " ST ChildCount " _ STCounter)
	        #dim individualST As EnsLib.EDI.X12.Document
	        set STnum = 1
	        while ( STnum <= STCounter)
	        { 
	        	set individualST = individualGroup.getNthChild(STnum)
	        	set segInd = 1
	        	$$$TRACE( "ST # " _ individualST.SegCount)
	        	while (segInd <= individualST.SegCount)
	        	{
		        	set segVal = individualST.GetValueAt(segInd)
		        	
		        	if ($FIND(segVal,"ST") = 3)
			  		{
				  	
				  		set context.transactionSetIdentifierCode = $PIECE(segVal, context.x12Doc.ElementSeparator , 2)				  				  		
				  						  		
				  		set context.transactionSetControlNumber = $PIECE(segVal, context.x12Doc.ElementSeparator , 3)
				  		
				  		set stat = ##class(IHC.ITF.ITFCOMMON.ErpUtil).GetTpLink(context.interchangeSenderID, context.interchangeReceiverID, context.transactionSetIdentifierCode, context.direc, .retVal)
				  		$$$TRACE( "GetTpLink: " _ retVal)
				  		if (retVal '= "")
				  		{
    				  		  set context.lnkNm = $PIECE(retVal, ",", 2)
				  		  $$$TRACE("Link: " _ context.lnkNm )
				  		  set context.ack = $PIECE(retVal, ",", 3)
				  		  
				  		  set context.folder= $PIECE(retVal, ",", 4)
				  		  if (context.folder = "")
				  		  {
				  		      set context.folder= $PIECE(retVal, ",", 5)
				  		  }
				  		  set context.protocol = $PIECE(retVal, ",", 6)
				  		  set context.separators = $PIECE(retVal, ",", 7)
				  		  
				  		  if ( context.separators = "")
				  		  {
				  		     set context.separators = "^|\~" // ElementSeparator,ComponentSeparator,RepetitionSeparator,SegmentTerminator
				  		  }
				  		  set context.interchangeIdQualifier = $PIECE(retVal, ",", 8)
				  		  
				  		}
				  		if (context.lnkNm = "")
				  		{
				  		   $$$LOGERROR("Can't find TP Link for " _ context.interchangeSenderID _", " _ context.interchangeReceiverID _", " _ context.transactionSetIdentifierCode)
				  		   set context.ProcessMsg = 0
				  		    Set errStr = $SYSTEM.Status.GetErrorText(##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName," Can't find TP Link for " _ context.interchangeSenderID _", " _ context.interchangeReceiverID _", " _ context.transactionSetIdentifierCode))  
				  		    
				  		    Do process.ItfSendAlert(errStr _ ", Can't find TP Link for " _ context.interchangeSenderID _", " _ context.interchangeReceiverID _", " _ context.transactionSetIdentifierCode _", file name: " _ request.OriginalFilename)
				  		}
				  	    QUIT	// X12 ST parsing
		 
			  		}
			  	
		        	Do $INCREMENT(segInd)
	        	}
	        	Do $INCREMENT(STnum)
          	} 
          	Do $INCREMENT(GSnum) 
          }
  }
  else
  {
            Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"NOT a valid X12.Document object")
  }]]]]><![CDATA[>
