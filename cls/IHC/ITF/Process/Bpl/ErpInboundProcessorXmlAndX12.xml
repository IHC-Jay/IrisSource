<code name='Get Control Number' xpos='1010' ypos='1350' >
<![CDATA[ set glbNm = context.interchangeSenderID _ "-" _ context.interchangeReceiverID_ "-" _ context.transactionSetIdentifierCode
 if ($GET(^ItfGlobalISAId(glbNm)) = "")
 {
	$$$TRACE("Create new global: " _ glbNm)
 	set ^ItfGlobalISAId(glbNm) = 1
 }
 else
 {
   set ^ItfGlobalISAId(glbNm) = $INCREMENT(^ItfGlobalISAId(glbNm))
 }
 
 set context.isaCtrlNum = ^ItfGlobalISAId(glbNm)
 set context.gsCtrlNum = context.isaCtrlNum
 
  FOR i=$L(context.isaCtrlNum )+1:1:9
  {
    set context.isaCtrlNum =  "0" _ context.isaCtrlNum 
  }
  $$$TRACE("ISA CTRL # " _ glbNm _ ": " _ context.isaCtrlNum _", GS # " _ context.gsCtrlNum)]]]]><![CDATA[>
