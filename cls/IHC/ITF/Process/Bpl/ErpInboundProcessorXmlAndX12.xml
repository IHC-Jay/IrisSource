<code name='Send 997' xpos='1010' ypos='1550' >
<![CDATA[ $$$TRACE("Create Stream Container")
 set scTp = ##class(IHC.ITF.DStruc.Record.StreamContainerWithTP).%New()
 set scTp.Stream = ##class(%Library.FileCharacterStream).%New()
 
 set scTp.Folder  = context.folder
 
 set scTp.Protocol = context.protocol
 
 $$$TRACE("Copy Stream: " _ response)
 Do response.OutputToLibraryStream(scTp.Stream)
 
 set flNm = ##class(%File).GetFilename(request.OriginalFilename)
 set flNm = $E(flNm, 1, $FIND(flNm, ".")-2) _ "_997.txt"
 
 set scTp.OutputFilename =  flNm 
 set scTp.OriginalFilename =  flNm 
 
  $$$TRACE("Send 997 to: " _ context.ackTarget _ ", stream size:" _ scTp.Stream.Size)
   set tStatus=process.SendRequestSync(context.ackTarget, scTp, .response)
  if ('tStatus) { 
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," Unexpected response returned or call failure." _$SYSTEM.Status.GetOneErrorText(tStatus))    
  }]]]]><![CDATA[>
