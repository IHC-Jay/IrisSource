<code name='Process XML, Get TP Link' xpos='200' ypos='1350' >
<![CDATA[ set tyTypeStr = "/catalogue_item_notification:catalogueItemNotificationMessage/sh:StandardBusinessDocumentHeader/sh:DocumentIdentification/sh:Type"
 set sendStr = "/catalogue_item_notification:catalogueItemNotificationMessage/sh:StandardBusinessDocumentHeader/sh:Sender/sh:Identifier"					  
 set recvStr = "/catalogue_item_notification:catalogueItemNotificationMessage/sh:StandardBusinessDocumentHeader/sh:Receiver/sh:Identifier"					  		
			
 set expr = "text()"
 
 Set tSC=context.xmlDoc.EvaluateExpression(tyTypeStr, expr, .xPathDoc)
 $$$TRACE("Type EvaluateExpression stat: " _ tSC)
 
	    	if (xPathDoc.Count() > 0)
		{
			set type = xPathDoc.GetAt(1).Value
		}
	
 Set tSC=context.xmlDoc.EvaluateExpression(sendStr, expr, .xPathDoc)
 $$$TRACE("Sender EvaluateExpression stat: " _ tSC)
 
	    	if (xPathDoc.Count() > 0)
		{
			set sender = xPathDoc.GetAt(1).Value
		}
		

 Set tSC=context.xmlDoc.EvaluateExpression(recvStr, expr, .xPathDoc)
 $$$TRACE("Receiver EvaluateExpression stat: " _ tSC)
 
	    	if (xPathDoc.Count() > 0)
		{
			set receiver = xPathDoc.GetAt(1).Value
		}
		
 $$$TRACE("XML values: " _ type _", " _sender  _", " _receiver )
 
 set stat = ##class(IHC.ITF.ITFCOMMON.ErpUtil).GetTpLink(sender  , receiver , type, context.direc, .retVal)
 
				  		$$$TRACE( "GetTpLink: " _ retVal)
				  		if (retVal '= "")
				  		{
				  		  set context.transactionSetIdentifierCode = type
    				  		  set context.lnkNm = $PIECE(retVal, ",", 2)
				  		  $$$TRACE("Link: " _ context.lnkNm )
				  		  set context.ack = $PIECE(retVal, ",", 3)
				  		  set context.protocol = $PIECE(retVal, ",", 6)
				  		  set context.folder= $PIECE(retVal, ",", 4)
				  		  if (context.folder = "")
				  		  {
				  		      set context.folder= $PIECE(retVal, ",", 5)
				  		  }
				  		}
				  		if (context.lnkNm = "")
				  		{
				  		   $$$LOGERROR("Can't find TP Link for " _ sender _", " _ receiver _", " _ type)
				  		    Set context.errStat = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName,"Can't find TP Link for " _ context.interchangeSenderID _", " _ context.interchangeReceiverID _", " _ context.transactionSetIdentifierCode)
				  		   set context.ProcessMsg = 0
				  		}
				  		]]]]><![CDATA[>
