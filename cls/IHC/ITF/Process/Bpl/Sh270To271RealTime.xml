<code name='Check Reply Code Actions' xpos='200' ypos='450' >
<annotation><![CDATA[Check Reply Code Action configuration]]]]><![CDATA[></annotation>
<![CDATA[
 /* Check if ReplyCodeActions have been configured or not */
 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
  
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Initialization error, No ReplyCodeActions found")
 }
 
 	  ]]]]><![CDATA[>
</code>
<code name='Parse and Extract' xpos='200' ypos='550' >
<annotation><![CDATA[Parse X12 and extract values needed for WS call]]]]><![CDATA[></annotation>
<![CDATA[ 
 /* Allocating 2 GB of memory for the process */
  
  SET $ZSTORAGE=2048000  
 
 
 /* Check if the received data is a X12 file or not and report error if it is not a X12 message. Parse the file at Transaction Level and extract values needed for webservice call */
 
 
 if (request.%Extends("EnsLib.EDI.X12.Document"))
 {
     set context.orig270 = request
   try
   {          
       /* Setting request message to X12 Interchange structure and gather number of child segment (GS-GE) count */
       
       set request.DocType = "HIPAA_5010:270" 
       set context.GSCounter = request.ChildCount
       
       
       set SubscriberHLflag = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).HL!3=22:HierarchicalChildCode(1)")
       
       
       if (SubscriberHLflag = "0")
       {
           set context.subscriberID = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.NM1:IdentificationCode(1)")           
           set context.patientFirstName = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.NM1:NameFirst(1)")
           set context.patientLastName = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.NM1:NameLastorOrganizationName(1)")
           set patientDOB = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.DMG:DateTimePeriod(1)")
           $$$TRACE("patientDOB : "_ patientDOB )
           
           if ( patientDOB '= "")
           {
              set tempDOBdt = $ZDH(patientDOB,8)
              set context.patientDOB = $ZD(tempDOBdt,1,,4)  
              $$$TRACE("converted patientDOB : "_ context.patientDOB )         
           }
         
           set ref01 = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.REF(1):RefIdQualifier(1)")
           set ref02 = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.REF(1):RefId(1)")
         
           if ( ref01 = "SY")
           {
             set context.patientSSN = ref02
           }
         
           set dtp02Sub = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.DTP(1):DateTimePeriodFormatQualifie(1)")
           set dtp03Sub = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.DTP(1):DateTimePeriod(1)")
           set dtp02Inq = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.loop2110C(1).DTP:DateTimePeriodFormatQualifie(1)")
           set dtp03Inq = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.loop2110C(1).DTP:DateTimePeriod(1)")         
         
         
           if ((dtp02Inq'="") && (dtp03Inq'=""))
           {
             if (dtp02Inq="RD8")
             {
               Set context.eligibilityStartDate = dtp03Inq.Substring(0,8)
               Set context.eligibilityEndDate = dtp03Inq.Substring(9,16)
             }
             elseif (dtp02Inq="D8") 
             {
              Set context.eligibilityStartDate = dtp03Inq
              Set context.eligibilityEndDate = ""
             }
           }
           elseif ((dtp02Sub'="") && (dtp03Sub'=""))
           {
             if (dtp02Sub="RD8")
             {
               Set context.eligibilityStartDate = dtp03Sub.Substring(0,8)
               Set context.eligibilityEndDate = dtp03Sub.Substring(9,16)
             }
             elseif (dtp02Sub="D8") 
             {
               Set context.eligibilityStartDate = dtp03Sub
               Set context.eligibilityEndDate = ""
             }
           }        
         

         set context.serviceTypeCodes = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.loop2110C(1).EQ:ServiceTypeCode(1)")
         set context.Subscriberflag = "Y" 
       
	   }
       elseif (SubscriberHLflag = "1")
       {
           set context.subscriberID = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2100C.NM1:IdentificationCode(1)")
           set patientDOB = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.DMG:DateTimePeriod(1)")
           set context.patientFirstName = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.NM1:NameFirst(1)")
           set context.patientLastName = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.NM1:NameLastorOrganizationName(1)")
           
           $$$TRACE("patientDOB : "_ patientDOB )
           
           if ( patientDOB '= "")
           {
              set tempDOBdt = $ZDH(patientDOB,8)
              set context.patientDOB = $ZD(tempDOBdt,1,,4)  
              $$$TRACE("converted patientDOB : "_ context.patientDOB )         
           }
         
           set ref01 = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.REF(1):RefIdQualifier(1)")
           set ref02 = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.REF(1):RefId(1)")
         
           if ( ref01 = "SY")
           {
             set context.patientSSN = ref02
           }
         
           set dtp02Pat = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.DTP(1):DateTimePeriodFormatQualifie(1)")
           set dtp03Pat = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.DTP(1):DateTimePeriod(1)")
           
           set dtp02Inq = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.loop2110D(1).DTP:DateTimePeriodFormatQualifie(1)")
           set dtp03Inq = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.loop2110D(1).DTP:DateTimePeriod(1)")         
         
           
         
           if ((dtp02Inq'="") && (dtp03Inq'=""))
           {
             if (dtp02Inq="RD8")
             {
               set context.eligibilityStartDate = dtp03Inq.Substring(0,8)
               set context.eligibilityEndDate = dtp03Inq.Substring(9,16)
             }
             elseif (dtp02Inq="D8") 
             { 
              set context.eligibilityStartDate = dtp03Inq
              set context.eligibilityEndDate = ""
             }
           }
           elseif ((dtp02Pat'="") && (dtp03Pat'=""))
           { 
             if (dtp02Pat="RD8")
             {
               set context.eligibilityStartDate = dtp03Pat.Substring(0,8)
               set context.eligibilityEndDate = dtp03Pat.Substring(9,16)
             }
             elseif (dtp02Pat="D8") 
             {         
               
               set context.eligibilityStartDate = dtp03Pat
               set context.eligibilityEndDate = ""
             }
           }        
         

         set context.serviceTypeCodes = request.GetValueAt("loop2000A(1).loop2000B(1).loop2000C(1).loop2000D(1).loop2100D.loop2110D(1).EQ:ServiceTypeCode(1)")
         set context.Subscriberflag = "N" 
       }
       
       if (context.eligibilityStartDate '= "")
       {
          set tempdt = $ZDH(context.eligibilityStartDate,8)               
          set context.eligibilityStartDate = $ZD(tempdt,1,,4)       
       }
       
       if (context.eligibilityEndDate '= "")
       {
          set tempdt = $ZDH(context.eligibilityEndDate,8)               
          set context.eligibilityEndDate = $ZD(tempdt,1,,4)       
       }
       
       $$$TRACE("Subscriber flag : "_ context.Subscriberflag _ "||subscriberID : "_ context.subscriberID _ "|| patientDOB : "_ context.patientDOB _ "|| patientFirstName : "_ context.patientFirstName _ "|| patientLastName : "_ context.patientLastName _ "|| patientSSN : "_ context.patientSSN _ "|| eligibilityStartDate : "_ context.eligibilityStartDate _ "|| eligibilityEndDate : "_ context.eligibilityEndDate _ "|| serviceTypeCodes : "_ context.serviceTypeCodes)
       
        set context.arr=##class(Request.GetOutbound271Request).%New()
        
        set context.arr.subscriberID=context.subscriberID
        set context.arr.dateOfBirth=context.patientDOB
        set context.arr.patientFirstName=context.patientFirstName
        set context.arr.patientLastName=context.patientLastName
        set context.arr.patientSsn=context.patientSSN
        set context.arr.eligibilityStartDate=context.eligibilityStartDate
        set context.arr.eligibilityEndDate=context.eligibilityEndDate
        set context.arr.serviceTypeCodes=context.serviceTypeCodes
        set context.arr.subscriberFlag=context.Subscriberflag
       

    }
    Catch ex 
    { 
      if 1=ex.%IsA("%Exception.SystemException") 
      {
        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
      }
      else 
      {       
       Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Interchange level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)  
      }  
    }  
 } 
 else
 {
  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message ")
 } 
]]]]><![CDATA[>
</code>
<code name='Parse ISA and collect GS level' xpos='200' ypos='650' >
<annotation><![CDATA[Parse X12 and split at GS level]]]]><![CDATA[></annotation>
<![CDATA[
 set tStatus=process.SendRequestSync("Out-Sh-270-271-WsCall", context.arr,.response)
 
 $$$TRACE("GetOutbound271: " _ tStatus)
  
 if ('tStatus) 
 {     
    set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected WebService response returned or WS call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
 } 
 else 
 {    
    $$$TRACE("Op-SH-270-271-WS returned: " _ response)
    
 $$$TRACE("Response SubscriberId : " _ response.GetOutbound271Result.SubscriberId)
 $$$TRACE("Response SubscriberLastName : " _ response.GetOutbound271Result.SubscriberLastName)
 $$$TRACE("Response SubscriberFirstName : " _ response.GetOutbound271Result.SubscriberFirstName)
 $$$TRACE("Response SubscriberMiddleName : " _ response.GetOutbound271Result.SubscriberMiddleName)
 $$$TRACE("Response SubscriberDob : " _ response.GetOutbound271Result.SubscriberDob)
 $$$TRACE("Response SubscriberSex : " _ response.GetOutbound271Result.SubscriberSex)
 $$$TRACE("Response PatientLastName : " _ response.GetOutbound271Result.PatientLastName)
 $$$TRACE("Response PatientFirstName : " _ response.GetOutbound271Result.PatientFirstName)
 $$$TRACE("Response PatientMiddleName : " _ response.GetOutbound271Result.PatientMiddleName)
 $$$TRACE("Response PatientDob : " _ response.GetOutbound271Result.PatientDob)
 $$$TRACE("Response MedicaidId : " _ response.GetOutbound271Result.MedicaidId)
 $$$TRACE("Response PatientSex : " _ response.GetOutbound271Result.PatientSex)
 $$$TRACE("Response DateValidationCode : " _ response.GetOutbound271Result.DateValidationCode)
 $$$TRACE("Response MemberFoundCode : " _ response.GetOutbound271Result.MemberFoundCode)
 $$$TRACE("Response MemberNotFoundReasonCodes : " _ response.GetOutbound271Result.MemberNotFoundReasonCodes)
 $$$TRACE("Response ErrorFlag : " _ response.GetOutbound271Result.ErrorFlag)
 $$$TRACE("Response SubscriberFlag : " _ response.GetOutbound271Result.SubscriberFlag)
 $$$TRACE("Response PatientAddressLine1 : " _ response.GetOutbound271Result.PatientAddressLine1)
 $$$TRACE("Response PatientAddressLine2 : " _ response.GetOutbound271Result.PatientAddressLine2)
 $$$TRACE("Response PatientCity : " _ response.GetOutbound271Result.PatientCity)
 $$$TRACE("Response PatientState : " _ response.GetOutbound271Result.PatientState)
 $$$TRACE("Response PatientZip : " _ response.GetOutbound271Result.PatientZip)
 $$$TRACE("Response PatientSubscriberRelationCode : " _ response.GetOutbound271Result.PatientSubscriberRelationCode)
 $$$TRACE("Response EligBenefits : " _ response.GetOutbound271Result.X12EligibilityAndBenefits)
    
   /// set context.call271Obj.origMsg = request
    set context.wsResponse = response   
 }
]]]]><![CDATA[>
