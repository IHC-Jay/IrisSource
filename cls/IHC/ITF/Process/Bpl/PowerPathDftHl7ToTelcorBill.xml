        set context.isInterHospitalBill=1
        set context.PerformingFacility=tPerformingFacility
        set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerPathDftHl7ToTelcorBill.Lookup.IHCSiteIDtoFacility",context.FacilityId,.tPerformingFacility)
        if ($$$ISOK(tStatus)){set context.CanProcess=1}
    }
    
    If (context.CanProcess=1){ 
        $$$TRACE("The performing facility is Telcor Facility and it is interhospital billing transaction")
    }else {$$$TRACE("The performing facility is not Telcor Facility or it is not interhospital billing transaction")}
               
