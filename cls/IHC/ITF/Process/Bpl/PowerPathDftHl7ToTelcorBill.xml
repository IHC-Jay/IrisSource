<![CDATA[    // This is for a facility not using TELCOR billing.
    // Check if Transaction If is mapped to Telcor Facility and if MSH:6 is mapped to be inter-hospital billing transaction.
    set context.isInterHospitalBill=0
    set context.PerformingFacility=context.TransactionId
    If ($length(context.TransactionId)>=3){
