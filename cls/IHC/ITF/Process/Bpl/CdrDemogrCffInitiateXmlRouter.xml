<code name='buildMmiRow' xpos='200' ypos='650' >
<![CDATA[
      
      set context.mmiEventRespObj =##class(IHC.ITF.Response.MmiEventsRow).%New()
      set context.mmiEventRespObj.UnitNumber = context.mmiRow.UnitNumber      
      set context.mmiEventRespObj.AuditNumber = context.mmiRow.AuditNumber
      set context.mmiEventRespObj.TxTypeCid = context.mmiRow.TxTypeCid
      set context.mmiEventRespObj.TxTime = context.mmiRow.TxTime
      set context.mmiEventRespObj.Employee = context.mmiRow.Employee
      set context.mmiEventRespObj.Application = context.mmiRow.Application
      set context.mmiEventRespObj.ApplicationVersion = context.mmiRow.ApplicationVersion
      set context.mmiEventRespObj.MmiVersion = context.mmiRow.MmiVersion
      set context.mmiEventRespObj.FacilityCid = context.mmiRow.FacilityCid
      set context.mmiEventRespObj.DelUnitNumber = context.mmiRow.DelUnitNumber
      
      set curTimeStamp = $zstrip($ZDATETIME($ZTIMESTAMP,3,1,4), "*P")
      set context.mmiEventLog = curTimeStamp _ ":" _ context.mmiRow.UnitNumber _ "|"_ context.mmiRow.AuditNumber_ "|"_ context.mmiRow.TxTypeCid _ "|"_ context.mmiRow.TxTime _ "|" _ context.mmiRow.Employee _ "|" _ context.mmiRow.Application _ "|" _ context.mmiRow.ApplicationVersion _ "|" _ context.mmiRow.MmiVersion _ "|" _ context.mmiRow.FacilityCid _ ":" _ context.mmiRow.DelUnitNumber
      kill curTimeStamp
          
 ]]]]><![CDATA[>
</code>


<code name='WriteToTarget' xpos='605' ypos='1500' >
<![CDATA[ 
   if (context.cdrEventsInFileFlag = 1){
	 set tRequest = ##class(Ens.StreamContainer).%New("")	 
	 set tStream = ##class(%Stream.GlobalCharacter).%New("")	 
	 do tStream.Write(context.mmiEventLog_$CHAR(13)_$CHAR(10))	 
	 set tRequest.Stream = tStream
 	 set tStatus = process.SendRequestSync(context.cdrEventsFileTargetConfigName,tRequest)
 	 if ('tStatus) {
      	 set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected error while writing the record to a file system. "_$SYSTEM.Status.GetOneErrorText(tStatus))
      	 kill status
 	 }
 	 kill tRequest
 	 kill tStream
 	 kill tStatus
   }
 ]]]]><![CDATA[>
