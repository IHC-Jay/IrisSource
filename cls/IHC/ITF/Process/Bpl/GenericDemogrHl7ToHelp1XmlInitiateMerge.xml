<code name='Get EMPI' xpos='200' ypos='750' >
<annotation><![CDATA[Filter Message]]]]><![CDATA[></annotation>
<![CDATA[ 
 set i1=""  
 for {
	 set i1 = request.GetNextIndex("PID:PatientIdentifierList()",i1,.tSC)  quit:i1=""
	 if (request.GetValueAt("PID:PatientIdentifierList("_(i1)_").assigningauthority.namespaceID") = "UN") {
		 set context.empiNum = request.GetValueAt("PID:PatientIdentifierList("_(i1)_").ID")		 
		 $$$TRACE("EmpiNumber: " _ context.empiNum)
		 if ($ISVALIDNUM(context.empiNum) '= "1") {	     
		     set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "PID-3.1 MMINumber :["_context.empiNum_"] is not valid, skip message.")
    		 quit
	     }			 
	 }		 
 }
 ]]]]><![CDATA[>
