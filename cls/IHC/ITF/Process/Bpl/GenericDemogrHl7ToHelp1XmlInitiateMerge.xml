<code name='CallHddMethodMsprId' xpos='200' ypos='750' >
<annotation><![CDATA[CallHddMethod-getUniqueRepByNcid-to get MSPRID from Emplyee Ncid]]]]><![CDATA[></annotation>
<![CDATA[ 
   		set employeeNcid = request.GetValueAt("ZZZ:Employee") 
     $$$TRACE("Employee Ncid is " _ employeeNcid)		  	
  	if (($ISVALIDNUM(employeeNcid)= "1") && (employeeNcid '="100")){		
		set context.msprId=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(employeeNcid, context.hddContext3mUnitNumber, context.hddTargetConfigName, .process)
		$$$TRACE("MSPR ID: " _ context.msprId)	
		if ((context.msprId = "") || (context.msprId = "ERROR")){
			$$$TRACE("MSPR ID is NOT defined in HDD - Employee Ncid: ["_employeeNcid_"]. Context: ["_context.hddContext3mUnitNumber_"]. Hdd Method: getUniqueRepByNcid")	
			//set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "MSPR ID is NOT defined in HDD - Employee Ncid: ["_employeeNcid_"]. Context: ["_context.hddContext3mUnitNumber_"]. Hdd Method: getUniqueRepByNcid.")
			$$$TRACE(" Assigning default MSPR ID "_context.defaultMsprId)
			set context.msprId= context.defaultMsprId			
		}
		
		set context.userName=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(employeeNcid, context.hddContextName, context.hddTargetConfigName, .process)
		$$$TRACE("User Name is " _ context.userName)	
		if ((context.userName = "") || (context.userName = "ERROR")){
			$$$TRACE("UserName is NOT defined in HDD - Employee Ncid: ["_employeeNcid_"]. Context: ["_context.hddContextName_"]. Hdd Method: getUniqueRepByNcid")	
			//set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "MSPR ID is NOT defined in HDD - Employee Ncid: ["_employeeNcid_"]. Context: ["_context.hddContextName_"]. Hdd Method: getUniqueRepByNcid.")
			$$$TRACE(" Assigning default User Name "_context.defaultUserName)
			set context.userName = context.defaultUserName
		}		
	}else{
		//if (employeeNcid = "100"){
			set context.msprId= context.defaultMsprId
