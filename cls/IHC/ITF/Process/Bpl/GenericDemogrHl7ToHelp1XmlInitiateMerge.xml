<code name='Call InitiateMerge' xpos='470' ypos='1200' >
<![CDATA[ 
     set tStatus=process.SendRequestSync(context.targetList.GetAt(1),context.iniMergeRequest,.help1MergeResponse)
     $$$TRACE(" Status after EmpiMerge " _ tStatus)
     $$$TRACE(" RESPONSE: " _ help1MergeResponse)
  	 if ('tStatus) {	 
	 	$$$TRACE(" Status Error text: " _ $SYSTEM.Status.GetOneErrorText(tStatus))
		 set errText = $SYSTEM.Status.GetOneErrorText(tStatus)
		 set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," MergePerson call failure. empi#: ["_context.empiNum_"]. ErrorText: "_errText)               
	 }else{
		 $$$TRACE(" Initiate Merge Successfully sent to Help1 Trauma Consolidation service !!! ")		 
	 }	 
   ]]]]><![CDATA[>
