     	}catch(exVar){
	     	set exVarData = $ZSTRIP(exVar.Data,"*C")
	     	$$$TRACE(" exVarData --> "_exVarData)
	     	if exVar.Code [ "ITFCOMMON:10109" {
		     	Set alertRequest=##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError("HDD-Missing Mapping:"_parentRepFieldName,exVarData,process.%ConfigName)
				do process.SendAlert(alertRequest)	
