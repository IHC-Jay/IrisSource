<FormalSpec><![CDATA[parentRep:%String,parentRepFieldName:%String,parentDomainNcid:%String,parentRepContextNcid:%String,parentDomainRelationship:%String,relationshipTypeNcid:%String,childRepContextNcid:%String,hddTargetConfigName:%String,&process:IHC.ITF.Process.Bpl.PeaksEpicAdtHl7ToIhcHieDemogr,&retVal]]></FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tmpStatus AS %Status=$$$OK
    set retVal = ""
    if ($L(parentRep)>0){
    	try{
	     	$$$TRACE(" Calling hddGetUniqueNcidChildRepByParentRep for "_ parentRepFieldName)	    
         	set status = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getUniqueNcidChildRepByParentRep(parentRep,parentRepFieldName,parentDomainNcid,parentRepContextNcid,parentDomainRelationship,relationshipTypeNcid,childRepContextNcid,hddTargetConfigName, .process, .retVal)
