<code name='GetNcidFromRep' xpos='470' ypos='1100' >
<![CDATA[  
  set pidSexRep = request.GetValueAt("PIDgrpgrp(1).PIDgrp.PID:Sex") 
  $$$TRACE("PID-8: "_pidSexRep)
  

   try{
	   $$$TRACE(" Calling getNcidFromRep().... " )
        set status=##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getNcidFromRep(pidSexRep,"PID-8", context.ihcGenderDomain, context.ihcInterfaceContext, context.hddTargetConfigName, .process, .retNcid) 
        $$$TRACE(" Returned Ncid from HDD: " _ retNcid)
        set context.PID8SexNCID = retNcid
     }catch(exVar){
	     set exVarData = $ZSTRIP(exVar.Data,"*C")
	     $$$TRACE(" exVarData --> "_exVarData)
	     if exVar.Code [ "ITFCOMMON:10108" {
		   // InutDataError - one of the input parameters from source is blank.
		   set context.PID8SexNCID= "O"
	   	 }elseif(exVar.Code [ "ITFCOMMON:10109") {
		   set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName,exVarData)		   
		 }elseif(exVar.Code [ "ITFCOMMON:10106") {		   	
		    set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,exVarData)		  
		 }else{
			 //Any other Unexpected error
			 set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Shutting down..Unknown Error."_exVarData)
		 }
	 }
	 ]]]]><![CDATA[>
</code>
