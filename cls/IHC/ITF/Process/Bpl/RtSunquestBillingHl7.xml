   set context.facilityID=pathvalue
 }else{
   set errorMessage = "Match to obtain facility-ID failed - cannot route it.  Input message:"_request.OutputToString()
   set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, errorMessage )  
   set error = 1
