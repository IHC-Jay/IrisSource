<code name='Check If faclility InterHospital' xpos='470' ypos='1600' >
<![CDATA[ //If Arm Facility The check for interhosiptal record and send to telcor
 set performingLabId= request.GetValueAt("FT1(1):Feeschedule")
 $$$TRACE("Performing LABOD:"_performingLabId)
 set finClass=""
 set facAccount=""
 
       set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestBillingHl7.interHospitalBillingIDs",context.facilityID,.tAccount)
        if ($$$ISOK(tStatus)){  
              set valueFromLookUp = tAccount
              $$$TRACE("valueFromLookUp:"_valueFromLookUp)
              set splitval1 = $P(valueFromLookUp,"&")
              set splitval2 = $P(valueFromLookUp,"&",2)
              if splitval1 '=""{                
                 set performFacility = $P(splitval1,":",1)
                 if (performFacility=performingLabId) || (performFacility=".*"){
                   set finClass =  $P(splitval1,":",2)
                   set facAccount = $P(splitval1,":",3) 
                   $$$TRACE("Finclass:>>"_finClass_">>>FacAccount:"_facAccount)
                 }
              }elseif splitval2'=""{
                 set performFacility = $P(splitval2,":",1)
                 if (performFacility=performingLabId) || (performFacility=".*") {
                   set finClass =  $P(splitval2,":",2)
                   set facAccount = $P(splitval2,":",3) 
                   $$$TRACE("Finclass:>>"_finClass_">>>FacAccount:"_facAccount)
                 }
              }
        }
 
 if (finClass'="") &&(finClass="Client"){
  set context.isInterHospital=1
 }
 $$$TRACE("IsInterHospital:"_context.isInterHospital)
 ]]]]><![CDATA[>
