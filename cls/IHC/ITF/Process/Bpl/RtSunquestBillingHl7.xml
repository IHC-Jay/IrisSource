<code name='Send Record to Iseries' xpos='200' ypos='1000' >
<![CDATA[  //Send the Records
 set key=$ZDATE($H,8) 
   $$$TRACE("Key:"_key)
    set isExists = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%ExistsId(key)  
    if isExists { 
        $$$TRACE("Start sending Arm Msg Ids")
        Set routMessgae = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%OpenId(key)
        $$$TRACE("After reading from Key")
        set arrayOfArmMsgIds = routMessgae.ArmMsgIds
        $$$TRACE("After reading Array")
        //Loop for each Facility
        set armKey =""
        for{
           Set armListIds = arrayOfArmMsgIds.GetNext(.armKey)           
	   $$$TRACE("Arm Msg Id Count:"_$LISTLENGTH(armListIds))
	   set listLen = $LISTLENGTH(armListIds)
	   set totalCount = 1
           for armIds=1:1:listLen {
                 set parent = ##class(EnsLib.HL7.Message).%OpenId($LIST(armListIds,armIds))
                 $$$TRACE("Arm Msg:"_parent.OutputToString())
                 set clone = parent.%ConstructClone()
                 //This scenarion shouldnt occur but still
                 if parent.GetValueAt("BTS") '=""{
                   do clone.RemoveSegmentAt(6)
                   do clone.%save()
                 }
                 if totalCount=listLen {                         
                        //Create BTS String
                         set BTSeg="BTS|"_listLen_"|"_armKey_"|"_totalCount_"^0^0^0|"
                         set BTSegX = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&"_BTSeg))  
                         set clone = parent.%ConstructClone() 
                         do clone.RemoveSegmentAt(6)      
                         set status = clone.AppendSegment(BTSegX)
                         do clone.%Save()
                         $$$TRACE("Clone:"_clone.OutputToString())
                 }
                 set tStatus=process.SendRequestAsync(context.IseriesTargetConfig,clone,.Response)
           }
	   Quit:armKey=""
        }
       }]]]]><![CDATA[>
</code>
<code name='Send Record To Telcor' xpos='200' ypos='1100' >
<![CDATA[  //Send the Records
 set key=$ZDATE($H,8)
    set isExists = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%ExistsId(key)  
    if isExists { 
        $$$TRACE("Start sending Telcor Msg Ids")
        Set routMessgae = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%OpenId(key)
        set arrayOfTelcorMsgIds = routMessgae.TelcorMsgIds
        //Loop for each Facility
        set telcorkey =""
        for{
           Set telcorListIds = arrayOfTelcorMsgIds.GetNext(.telcorkey)           
	   $$$TRACE("telcorListIds Msg Id Count:"_$LISTLENGTH(telcorListIds))
	   set listLen=$LISTLENGTH(telcorListIds)
	   set totalCount = 1
           for telcorIds=1:1:listLen{
                 set parent = ##class(EnsLib.HL7.Message).%OpenId($LIST(telcorListIds,telcorIds))
                 $$$TRACE("Arm Msg:"_parent.OutputToString())
                 set clone = parent.%ConstructClone()
                 //This scenarion shouldnt occur but still
                 if parent.GetValueAt("BTS") '=""{
                   do clone.RemoveSegmentAt(6)
                   do clone.%save()
                 }
                 if totalCount=listLen{                         
                        //Create BTS String
                         set BTSeg="BTS|"_listLen_"|"_telcorkey_"|"_totalCount_"^0^0^0|"
                         set BTSegX = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&"_BTSeg))  
                         set clone = parent.%ConstructClone() 
                         do clone.RemoveSegmentAt(6)      
                         set status = clone.AppendSegment(BTSegX)
                         do clone.%Save()
                         $$$TRACE("Clone:"_clone.OutputToString())
                 }
                 set tStatus=process.SendRequestAsync(context.telcorTargetConfig,clone,.Response)
                 set totalCount=totalCount+1
           }
	   Quit:telcorkey=""
        }
       }
       //After sending all the record send FTS to Telcor
       set tStatus=process.SendRequestAsync(context.telcorTargetConfig,request,.Response)]]]]><![CDATA[>
