    if ($$$ISOK(tStatus)){        
        set context.facilityTLA=tfacilityTLA
        set destination="Telcor"        
        $$$TRACE("Telcor context.facilityTLA:"_+context.facilityTLA)
     }else{// Check and see if its ARM faclility
