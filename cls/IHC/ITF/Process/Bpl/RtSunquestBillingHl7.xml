<code name='Send Each Record Cerner' xpos='200' ypos='900' >
<![CDATA[ //Send the Records
 set key=$ZDATE($H,8)
    set isExists = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%ExistsId(key)  
    if isExists {       
      $$$TRACE("Open the message for sending")
        Set routMessgae = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%OpenId(key)
        set listOfCernerMsgId = routMessgae.CernerMsgIds
        $$$TRACE("Cerner Msg Id Count:"_listOfCernerMsgId.Count())
        for cerIds=1:1:listOfCernerMsgId.Count() {
           set parent = ##class(EnsLib.HL7.Message).%OpenId(listOfCernerMsgId.GetAt(cerIds))
           $$$TRACE("Cerner Msg:"_parent.OutputToString())
           set tStatus=process.SendRequestAsync(process.TargetConfigNames,parent,.Response)
        }     
      }]]]]><![CDATA[>
