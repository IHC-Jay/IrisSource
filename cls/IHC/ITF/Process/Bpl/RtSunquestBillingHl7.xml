<code name='Store Telcor and Arm Messgae' xpos='470' ypos='1500' >
<![CDATA[ set key=$ZDATE($H,8)
    set isExists = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%ExistsId(key)  
    if 'isExists {
           set routMessgae = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%New()
       set routMessgae.Id = key
       //If the destination is Arm and doenst have cerner's Account number then add to Arm
       if (destination="Arm") && 'context.sendToCerner {
         //Get the count
         set armCount = routMessgae.ArmMsgIds.Count()
         if armCount=0{
           $$$TRACE("First Time Count is zero")
           set armList = $LISTBUILD(request.%Id())
         }else{
           $$$TRACE("Second time take from Arm Array and add to list")
           set armList = routMessgae.ArmMsgIds.GetAt(context.facilityID)
           set endLen = $LISTLENGTH(armList)+1         
	   set $LIST(armList,endLen) = request.%Id()
         }
         // Store the ArmMsg Id
         do routMessgae.ArmMsgIds.SetAt(armList,context.facilityID)
       }elseif destination="Telcor"{
         //Get the count
         set telcorCount = routMessgae.TelcorMsgIds.Count()
         if telcorCount=0{
           $$$TRACE("telcorCount First Time Count is zero")
           set telcorList = $LISTBUILD(request.%Id())
         }else{
           $$$TRACE("Second time take from Arm Array and add to list")
           set telcorList = routMessgae.TelcorMsgIds.GetAt(context.facilityID)
           set endLen = $LISTLENGTH(telcorList)+1         
	   set $LIST(telcorList,endLen) = request.%Id()
         }
         // Store the ArmMsg Id
         do routMessgae.TelcorMsgIds.SetAt(telcorList,context.facilityID)        
       } 
       do routMessgae.%Save()
       $$$TRACE("Id for the first time")
     
    }else{
      $$$TRACE("Another Facility ID")
      Set routMessgae = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%OpenId(key)
      if (destination="Arm") && 'context.sendToCerner {
          //Get the count
         set armCount = routMessgae.ArmMsgIds.Count()
         if armCount=0{
           $$$TRACE("First Time Count is zero")
           set armList = $LISTBUILD(request.%Id())
         }else{
           $$$TRACE("Second time take from Arm Array and add to list")
           set armList = routMessgae.ArmMsgIds.GetAt(context.facilityID)
           set endLen = $LISTLENGTH(armList)+1         
	   set $LIST(armList,endLen) = request.%Id()
         }
         // Store the ArmMsg Id
         do routMessgae.ArmMsgIds.SetAt(armList,context.facilityID)
       }elseif destination="Telcor"{
         //Get the count
         set telcorCount = routMessgae.TelcorMsgIds.Count()
         if telcorCount=0{
           $$$TRACE("First Time Count is zero")
           set telcorList = $LISTBUILD(request.%Id())
         }else{
           $$$TRACE("Second time take from Arm Array and add to list")
           set telcorList = routMessgae.TelcorMsgIds.GetAt(context.facilityID)
           set endLen = $LISTLENGTH(telcorList)+1         
	   set $LIST(telcorList,endLen) = request.%Id()
         }
         // Store the ArmMsg Id
         do routMessgae.TelcorMsgIds.SetAt(telcorList,context.facilityID) 
       } 
       do routMessgae.%Save()
    }
  ]]]]><![CDATA[>
