    set idKey = $ORDER(^IHC.Sunquest.TelcorIds(key,facKey,""))
    set facCount = 0
    while (idKey'=""){
      //Increment the Fac Count
      set facCount = facCount+1		
      set parent = ##class(EnsLib.HL7.Message).%OpenId(idKey)
      set clone = parent.%ConstructClone()
      //This scenarion shouldnt occur but still
      if parent.GetValueAt("BTS") '=""{
          do clone.RemoveSegmentAt(6)
          do clone.%save()
      }
      if $ORDER(^IHC.Sunquest.TelcorIds(key,facKey,idKey))=""{
        // Indicate this a Last record
         //Create BTS String
          set BTSeg="BTS|"_facCount_"|"_facKey_"|"_facCount_"^0^0^0|"
          set BTSegX = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&"_BTSeg))  
          set clone = parent.%ConstructClone()  
          do clone.RemoveSegmentAt(6)
          set status = clone.AppendSegment(BTSegX)
          do clone.%Save()
          $$$TRACE("Clone:"_clone.OutputToString())                         
          //Send the Message to Router
          set tStatus=process.SendRequestAsync(context.telcorTargetConfig,clone)                          
      }else{        
        $$$TRACE("Output:"_parent.OutputToString())
         set tStatus=process.SendRequestAsync(context.telcorTargetConfig,clone)  
      }
      set idKey = $ORDER(^IHC.Sunquest.TelcorIds(key,facKey,idKey))
    }
    set facKey = $ORDER(^IHC.Sunquest.TelcorIds(key,facKey))
 } 
 //After sending all the record send FTS to Telcor
