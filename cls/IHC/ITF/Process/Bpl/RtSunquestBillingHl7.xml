<code name='Store the cerner data' xpos='470' ypos='1300' >
<![CDATA[ //Store the cerner data
 $$$TRACE("Send To Cerner:"_context.sendToCerner)
 set key=$ZDATE($H,8)
 if (context.sendToCerner) && (context.ChargeNumber'="1111111"){
    set isExists = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%ExistsId(key)  
    if 'isExists {
       //Create the object
       set routMessgae = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%New()
       set routMessgae.Id = key
       do routMessgae.CernerMsgIds.Insert(request.%Id())
       do routMessgae.%Save()
       $$$TRACE("Id for the first time")
     
    }else{
      $$$TRACE("Another Cerner Facility ID")
      Set routMessgae = ##class(IHC.ITF.BILLING.DStruc.StoreRoutingMessages).%OpenId(key)
      do routMessgae.CernerMsgIds.Insert(request.%Id())
      do routMessgae.%Save()  
    }
  }]]]]><![CDATA[>
