<code name='Send Record to Iseries' xpos='200' ypos='1000' >
<![CDATA[ $$$TRACE("Key:"_key)
   //Loop through the global
 if key'=""{
 set facKey = $ORDER(^IHC.Sunquest.ArmIds(key,"")) 
 while (facKey'=""){
    set idKey = $ORDER(^IHC.Sunquest.ArmIds(key,facKey,""))
    set facCount = 0
    while (idKey'=""){
      //Increment the Fac Count
      set facCount = facCount+1		
      set parent = ##class(EnsLib.HL7.Message).%OpenId(idKey)
       set clone = parent.%ConstructClone()
       set clone.DocType="SunquestBillingIseries2.2:DFT_P03"
      //This scenarion shouldnt occur but still
      if parent.GetValueAt("BTS") '=""{
          do clone.RemoveSegmentAt(6)
          do clone.%save()
      }
      if $ORDER(^IHC.Sunquest.ArmIds(key,facKey,idKey))=""{
        //Remove the existing BTS Segment        
        // Indicate this a Last record
         //Create BTS String
          set BTSeg="BTS|"_facCount_"|"_facKey_"|"_facCount_"^0^0^0|"
          set BTSegX = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&"_BTSeg))
          set clone = parent.%ConstructClone() 
          set clone.DocType="SunquestBillingIseries2.2:DFT_P03" 
          do clone.RemoveSegmentAt(6)
          set status = clone.AppendSegment(BTSegX)
          do clone.%Save()
          $$$TRACE("Clone:"_clone.OutputToString())                         
          //Send the Message to Router
          set tStatus=process.SendRequestAsync(context.IseriesTargetConfig,clone)                          
      }else{        
        $$$TRACE("Output:"_parent.OutputToString())
         set tStatus=process.SendRequestAsync(context.IseriesTargetConfig,clone)  
      }
      set idKey = $ORDER(^IHC.Sunquest.ArmIds(key,facKey,idKey))
    }
    set facKey = $ORDER(^IHC.Sunquest.ArmIds(key,facKey))
 }   
   
 }]]]]><![CDATA[>
