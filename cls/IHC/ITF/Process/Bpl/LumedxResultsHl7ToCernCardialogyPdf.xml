<code name='Set Base64 pdf list' xpos='200' ypos='1250' >
<![CDATA[   $$$TRACE("Set up Base64 String list... ")
   set pdfStr=context.pdfStrRequest.StringValue
   $$$TRACE("PDF String length: "_$Length(pdfStr))
   set base64Str=$system.Encryption.Base64Encode(pdfStr)
   $$$TRACE("Base64 String length: "_$Length(base64Str))
   set bStr=##Class(Ens.Util.FunctionSet).ReplaceStr(base64Str,$Char(13,10),"")
   SET bStrLen=$Length(bStr)
   $$$TRACE("Base64 String length(without \r\n): "_bStrLen)
   SET countup=1
   set cnt=1
   set ep=72
   do {
      SET extract=##Class(Ens.Util.FunctionSet).SubString(bStr,countup,ep)
      $$$TRACE(cnt_" "_extract)
      set st = context.base64Strs.Insert(extract)
      SET countup=ep+1
      set ep=countup+71
      set cnt=cnt+1
   } while (countup < bStrLen)
   $$$TRACE("Count: " _ context.base64Strs.Count())]]]]><![CDATA[>
