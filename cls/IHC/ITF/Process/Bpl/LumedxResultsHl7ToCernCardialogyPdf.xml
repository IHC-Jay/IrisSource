<code name='Setup PDF String request' xpos='200' ypos='1050' >
<![CDATA[ $$$TRACE(" Create String Request...")
 set context.pdfStrRequest  = ##class(Ens.StringRequest).%New()
 set context.pdfStrRequest.StringValue = request.GetValueAt("OBXgrp(1).OBX:ObservationValue(1)") 
 set pdfSize=##Class(Ens.Util.FunctionSet).Length(context.pdfStrRequest.StringValue)
 $$$TRACE("pdf Size: "_pdfSize)	
 if (pdfSize<1) {
    $$$TRACE("Encoded pdf data is empty or invalid length.")
    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "UUEncoded pdf data is empty or invalid length. Skipping the record.")
 }]]]]><![CDATA[>
