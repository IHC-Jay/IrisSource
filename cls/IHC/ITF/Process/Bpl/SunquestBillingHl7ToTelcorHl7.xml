<code name='To Store the Transformed Telcor Dtl' xpos='1010' ypos='2400' >
<![CDATA[  //Create a messgae from the transformed  value
  set message = ##class(EnsLib.HL7.Message).ImportFromString(context.telcorResponse.OutputToString())
  $$$TRACE("output " _message) 
  set message.DocType="2.3:DFT_P03"
  //Save the messgae
  do message.%Save()
  $$$TRACE("Add Fac to Class")
   //Check and see if this is the first message in the file
  set isExist=$DATA(^IHC.Sunquest.TelcorKey("Key")) 
  $$$TRACE("isExist:"_isExist) 
   if 'isExist{
     set ^IHC.Sunquest.TelcorKey("Key") = $ZDATETIME($ZTIMESTAMP,3,1,6)  
  } 
  $$$TRACE("SunquestToTelcor:>>"_$g(^IHC.Sunquest.TelcorKey("Key")))
  
   set key=$g(^IHC.Sunquest.TelcorKey("Key"))   
   
   set ^IHC.Sunquest.DtlTelcorIds(key,message.%Id())=message.%Id()         
   
   
    
  ]]]]><![CDATA[>
