<code name='Skip the Message if its invalid charge code' xpos='1010' ypos='1800' >
<![CDATA[
 set invalidChargeCode=""
 set isError=0
 //Get the value from LookUp 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestBillingHl7.TelcorProperties","InvalidChargeCode",.configValue)  
 if ($$$ISOK(status)){     
       set invalidChargeCode=configValue        
     }else{
       set isError=1
     }
     $$$TRACE("invalidChargeCode:"_invalidChargeCode)
 Set isInvalidCharge =0
 if 'isError{
        //Loop Through the Ft1 Segement 
       For i = 1:1:request.GetValueAt("FT1(*)") {	 
 	  set pathvalue=request.GetValueAt("FT1("_i_"):Transactioncode.identifier",,.status)
 	       $$$TRACE("pathvalue:"_pathvalue)
         	If ""'= pathvalue{
 	          if invalidChargeCode [ pathvalue  {
 		      set isInvalidCharge = 1
 		  }
 	      } 
        }
       $$$TRACE("isInvalidCharge :"_isInvalidCharge )
     if isInvalidCharge {
         set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Skipping the record. Invalid charge code: [ "_ pathvalue_" ] in FT1_7 ")  
       }
   }]]]]><![CDATA[>
</code>
<code name='Check to see if allowByChargeCodeAndFacility' xpos='1010' ypos='1900' >
<![CDATA[  set BBChargeCodesStop=""
  set ISTATChargeCodesStop =""
 //Get the value from LookUp 
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestBillingHl7.BBChargeCodesStop",context.batchFacilityID,.tBBChargeCodesStop) 

  if ($$$ISOK(tStatus)){ 
         set BBChargeCodesStop=tBBChargeCodesStop 
         $$$TRACE("Charge Stop:"_BBChargeCodesStop)
     }
 
 //Get the value from LookUp 
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestBillingHl7.ISTATChargeCodesStop",context.batchFacilityID,.tISTATChargeCodesStop ) 

 if ($$$ISOK(tStatus)){
         set ISTATChargeCodesStop =tISTATChargeCodesStop 
         $$$TRACE("Charge Stop:"_ISTATChargeCodesStop )
     }
 
  // Check if the charge Code needs to sent or not     
  set tmpErroMsg=""
  set tmpIsError=0
  For i = 1:1:request.GetValueAt("FT1(*)") {	 
 	  set pathvalue=request.GetValueAt("FT1("_i_"):Transactioncode.identifier",,.status)
 	     $$$TRACE("ChargeCode Pathval:"_pathvalue)
         	If ""'= pathvalue{
 	          if pathvalue = "1111111" {
 		      set tmpErroMsg = tmpErroMsg_" Invalid charge code, skipping"
 		      set tmpIsError=1
 		  }
 		  if BBChargeCodesStop [ pathvalue {
 		     set tmpErroMsg = tmpErroMsg_" Invalid Blood bank charge code, skipping"
 		     set tmpIsError=1 
 		  }
 		 if ISTATChargeCodesStop [ pathvalue {
 		     set tmpErroMsg = tmpErroMsg_" Invalid Blood bank charge code, skipping"
 		     set tmpIsError=1 
 		  } 
 	      } 
        }
        
        //If Error Skip the Message in other words dont send the record
        if tmpIsError {
         set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, tmpErroMsg)  
       }]]]]><![CDATA[>
</code>
<code name='IsInterhospitalBilling' xpos='1010' ypos='2000' >
<![CDATA[   if (((request.GetValueAt("MSH:ReceivingFacility") = "670") || (request.GetValueAt("MSH:ReceivingFacility")= "652")) && ((request.GetValueAt("FT1(1):Feeschedule")= "IM"))){
    set context.isInterHospitalBilling = 1
  
