     $$$TRACE("Hdd Request ORC1-1 OrderControl is " _ orc1OrderControl)     		
 }
 else
 {
   set CompositeCheckError="ORC.1"
 }
 
 //ORC-5 Value
 set orc5OrderStatus = request.GetValueAt("ORCgrp(1).ORC:OrderStatus")  	
 if (orc5OrderStatus '= "" && $LOCATE(orc5OrderStatus,"CD:") '="1") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , orc5OrderStatus , context.hddContextOrderStatusCode, "ORC5:OrderStatus")  	  	
     $$$TRACE("Hdd Request ORC-5 OrderStatus is " _ orc5OrderStatus)     		
 }
 else
 {
   set CompositeCheckError=CompositeCheckError _ ",ORC.5"
 }
 
 //Check if OBR-2 (Order ID) is available
 set obr2PlacerOrder = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:PlacerOrderNumber") 
 if (obr2PlacerOrder = "") 
 {
    set CompositeCheckError=CompositeCheckError _ ",OBR.2"
    		
 }
  
 //Check if OBR-3 (Accession Number) is available
 set obr2PlacerOrder = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:FillerOrderNumber") 
 if (obr2PlacerOrder = "") 
 {
    set CompositeCheckError=CompositeCheckError _ ",OBR.3"
     	  	
 }

 //Check for Valid OBR.4 
 set obr4SvcId = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceID.identifier") 
 set context.svcId=obr4SvcId
 if (obr4SvcId '= "" && $ISVALIDNUM(obr4SvcId)= "1" && $LOCATE(obr4SvcId,"CD:") '="1") 
 {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr4SvcId, context.hddImgExamcodeContext, "OBR4:USId")  	  	
     $$$TRACE("Hdd Request OBR-4 Service id is " _ obr4SvcId)     		
 }
 else 
 {
    set CompositeCheckError=CompositeCheckError _ ",OBR.4"
    
 }

 
  
 //Check for Valid Facility ID
 set context.facId = request.GetValueAt("MSH:SendingFacility.namespaceID")  	
 if (context.facId '= "" && $ISVALIDNUM(context.facId)= "1") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId,  context.hddContextCernerToIhcLocation, "MSH4:Facility")  	  	
     $$$TRACE("Hdd Request MSH-4 Sending Facility is " _ context.facId )     		
 } else {
     // Skip message if MSH-4 is empty or invalid ncid
	 set CompositeCheckError=CompositeCheckError _ ",MSH.4"
     	 
 }
 
 //Check for Valid Patient ID
 set PatientID = request.GetValueAt("PIDgrp.PID:PatientIdentifierList(1).ID")  	
 if (PatientID '= "" && $ISVALIDNUM(PatientID )= "1") 
 {
     $$$TRACE("Valid PID.3 ")     		
 } else {
     // Skip message if Patient ID is empty or invalid ncid
	 set CompositeCheckError=CompositeCheckError _ ",PID.3"
    
 }
 
 
 //Check for Valid Patient Name
 set PatientName = request.GetValueAt("PIDgrp.PID:PatientName(1).familylastname.familyname")  	
 if (PatientName '= "") 
 {
     $$$TRACE("Valid PID.5 ")     		
 } else {
     // Skip message if Patient ID is empty or invalid ncid
	 set CompositeCheckError=CompositeCheckError _ ",PID.5"
      
 }

  
 set pid8Sex = request.GetValueAt("PIDgrp.PID:Sex")  	
 if (pid8Sex '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid8Sex, context.hddContextHelp, "PID8:Sex")  	  	
     $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 }
 
 set pid10Race = request.GetValueAt("PIDgrp.PID:Race()")   	
 if (pid10Race '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid10Race, context.hddContextHelp, "PID10:Race")  	  	
     $$$TRACE("Hdd Request PID-10 Race is " _ pid10Race)     		
 }
 
  set pid11Country = request.GetValueAt("PIDgrp.PID:PatientAddress(1).country")  	
 if (pid11Country '= "") {
