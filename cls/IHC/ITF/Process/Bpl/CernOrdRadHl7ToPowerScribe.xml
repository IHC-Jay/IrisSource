     $$$TRACE("Hdd Request PID-15 Languageis " _ pid15Lang )     		
 }
 
 set pid16MS = request.GetValueAt("PIDgrp.PID:MaritalStatus.identifier")  	
 if (pid16MS '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid16MS, context.hddContextHelp, "PID16:MS")  	  	
     $$$TRACE("Hdd Request PID-16 Married Status is " _ pid16MS)     		
 }
 
 set pid17Rel = request.GetValueAt("PIDgrp.PID:Religion.identifier")  	
 if (pid17Rel '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid17Rel, context.hddContextHelp, "PID17:Religion")  	  	
     $$$TRACE("Hdd Request PID-17 Religion is " _ pid17Rel)     		
 }
 
 set patClass = request.GetValueAt("PIDgrp.PV1grp.PV1:PatientClass")  	
 if (patClass '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, patClass, context.hddContextHelp, "PV12:Class")  	  	
     $$$TRACE("Hdd Request PV1-2 Patient Class is " _ patClass)     		
 }
 
 set pv13Pc= request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.pointofcare")  
 if (pv13Pc'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv13Pc, context.hddContextCerner, "PV131:PC")  	  	
     $$$TRACE("Hdd Request PV1-3.1Point of Care is " _ pv13Pc)     		
 }

 set pv13Room= request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.room")  
 if (pv13Room'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv13Room, context.hddContextCerner, "PV132:Room")  	  	
     $$$TRACE("Hdd Request PV1-3.2 Room is " _ pv13Room)     		
 }
 
 set pv13Bed= request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.bed")  
 if (pv13Bed'="") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv13Bed, context.hddContextCerner, "PV133:Bed")  	  	
     $$$TRACE("Hdd Request PV1-3.3 Bed is " _ pv13Bed)     		
 }
 
 set pat18PType = request.GetValueAt("PIDgrp.PV1grp.PV1:PatientType")  	
 if (pat18PType '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pat18PType, context.hddContextHelp, "PV118:PType")  	  	
     $$$TRACE("Hdd Request PV1-18 Patient Type is " _ pat18PType)     		
 }
  
 set p120FC = request.GetValueAt("PIDgrp.PV1grp.PV1:FinancialClass(1).FinancialClass")  
 if (p120FC '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, p120FC, context.hddContextDefault, "PV120:FC")  	  	
     $$$TRACE("Hdd Request PV1-20 Finacial Class is " _ p120FC)     		
 }
  
 if CompositeCheckError '=""
	{
	  $$$TRACE(CompositeCheckError)
	  if $EXTRACT(CompositeCheckError,1,1) = ","
	  {
	            	set CompositeCheckError = $EXTRACT(CompositeCheckError,2,*)
	            	$$$TRACE(CompositeCheckError)

	  }
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Field/s " _ CompositeCheckError _" is/are either blank or not all numeric. " _ "Hl7 Msg:" _ request.RawContent)
	}

 $$$TRACE(" After setting all NCID values")  
 ]]]]><![CDATA[>
