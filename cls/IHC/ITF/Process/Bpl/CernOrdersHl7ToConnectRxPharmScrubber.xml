<code name='Scan message' xpos='200' ypos='650' >
<![CDATA[ set sCharRepStrs= ##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","SpecialCharReplaceStringPairs",.pstatus)
 if ($$$ISOK(pstatus)){
   $$$TRACE("StripSpecialCharacters: " _ sCharRepStrs)
 }else{
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "***Initialization error: No StripSpecialCharacters found!")
 } 
  
   SET countdown=$LENGTH(sCharRepStrs,",")
   SET countup=1
   Set msg = request.RawContent
   FOR reps=countdown:-1:1 {
      SET extract=$PIECE(sCharRepStrs,",",countup)
      $$$TRACE(countup_" "_extract)
      set msg = $REPLACE(msg,$CHAR($PIECE(extract,"=",1)),$PIECE(extract,"=",2))
   }
   set context.hl7Msg=##class(EnsLib.HL7.Message).ImportFromString(msg)
   set context.hl7Msg.DocType=request.DocType
   do context.hl7Msg.PokeTypeCategory(request.MessageTypeCategory)
   ]]]]><![CDATA[>
