<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='ValidationPassed' type='%Boolean' initialexpression='1' instantiate='0' />

<property name='checkMMITargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='100' />
</parameters>
</property>

<property name='empiNumber' type='%String' instantiate='0' />

</context>
<sequence xend='200' yend='1450' >
<scope xpos='200' ypos='250' xend='200' yend='1350' >
<trace name='incomingMessage' value=' "Incoming Message: "_request.RawContent' xpos='200' ypos='450' >
<annotation><![CDATA[Incoming Record is request.RawContent]]]]><![CDATA[></annotation>
</trace>
<code name='Check ReplyCodeActions' xpos='200' ypos='450' >
<annotation><![CDATA[From settings tab]]]]><![CDATA[></annotation>
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }
 	  ]]]]><![CDATA[>
</code>
<code name='Trace MaxError and get Target Config Names' xpos='200' ypos='550' >
<annotation><![CDATA[Trace MaxError and get Target Config Names]]]]><![CDATA[></annotation>
<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)
 

   //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
   Set status = $$$ERROR("Initialization error, No TargetConfigNames found")
 }else{
      $$$TRACE("TargetConfigNames: " _configValue )
 }
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
    $$$TRACE("TargetConfigNames: " _context.targetList)
    $$$TRACE("Count: " _ context.targetList.Count())
 
 

 	  ]]]]><![CDATA[>
</code>

<code name='CheckMmiTargetConfigName' xpos='200' ypos='650' >
<![CDATA[ 

 set context.checkMMITargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","CheckMMITargetConfigName",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.checkMMITargetConfigName= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get CheckMMITargetConfigName, shutting down.")       
 }
  ]]]]><![CDATA[>
</code>

<code name='ValidateMessage' xpos='200' ypos='650' >
<annotation><![CDATA[Example how to validate message per error setting]]]]><![CDATA[></annotation>
<![CDATA[ set validationSettingValue=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 set tempStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSettingValue)
 if (tempStatus'=$$$OK){
    set context.ValidationPassed=0
    set context.errorStatus=tempStatus
    }]]]]><![CDATA[>
</code>
<if name='Check If Message Is Valid' condition='context.ValidationPassed' xpos='200' ypos='750' xend='200' yend='1100' >
<true>
<trace name='Message Validation Passed' value='"Message Validation Passed"' xpos='470' ypos='900' />

<code name='GetCernerEmpiNumber' xpos='200' ypos='650' >
<annotation><![CDATA[Get EMPI(CMRN)]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Get Empi(CMRN)...") 
  set context.empiNumber=""
  set k1="",tSC=1 
 For { 
     Set k1=request.GetNextIndex("PID:3()",k1,.tSCTrans)  Quit:k1=""          
     If (request.GetValueAt("PID:3("_(k1)_").5")="ICENTRAMRN") {
         Set context.empiNumber=request.GetValueAt("PID:3("_(k1)_").1.1")         
         quit
     }
 }
 $$$TRACE("EMPI: " _ context.empiNumber) 

]]]]><![CDATA[>
</code>

<code name='Call CheckMMI' xpos='200' ypos='1150' >
<![CDATA[  
 set trequest = ##class(Ens.StringRequest).%New("")
 set trequest.StringValue = context.empiNumber
 set tStatus=process.SendRequestSync(context.checkMMITargetConfigName,trequest,.checkMmiResponse)
 if ('tStatus) {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected CheckMMI response returned or CheckMMI call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
 } else{
       if (checkMmiResponse.StringValue = "1"){
	       $$$TRACE(" Cerner MRN exists in CDR : [" _ context.empiNumber_"]") 
       }else{
	       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Cerner MRN: ["_trequest.StringValue  _"] doesn't exist in the CDR. Skipping the record.")	
	   }	  	 
 }
 ]]]]><![CDATA[>
</code>



<foreach name='Send To Each Target' property='context.targetList' key='context.targetConfigIndex' xpos='470' ypos='1000' xend='200' yend='350' >
<call name='Send to TargetConfigNames' target='@context.targetList.GetAt(context.targetConfigIndex)' async='1' xpos='200' ypos='250' >
<request type='Ens.Request' >
<assign property="callrequest" value="request" action="set" />
</request>
<response type='Ens.Response' />
</call>
<code name='RESETERROR' xpos='470' ypos='2600' >
<![CDATA[  Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)

]]]]><![CDATA[>
</code>
</foreach>
</true>
<false>
<trace name='Message Validation Failed' value='"Message Validation Failed"' xpos='200' ypos='900' >
