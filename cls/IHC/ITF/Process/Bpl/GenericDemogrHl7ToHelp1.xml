 //Validate the message against schema
 set validationSetting=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 if (($$$ISERR(pstatus)) || (validationSetting = "")) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get ValidationSetting, shutting down.")
    quit
 } else {
    $$$TRACE("ValidationSetting: " _ validationSetting) 
    set pStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSetting)    
	if (pStatus'=$$$OK) {		
	    $$$TRACE("Failed Validation Settings: " _ validationSetting)
	    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Validation against data structure is failed. Skipping the record.")
	    quit
	} else {
		$$$TRACE("Passed Validation Settings: " _ validationSetting)
	}
 }]]]]><![CDATA[>
