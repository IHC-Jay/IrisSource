<code name='GetRepFromNcid' xpos='740' ypos='1450' >
<![CDATA[ $$$TRACE("Get Rep from Ncid Hdd lookup calls")  	

 set context.pid10 = "" 
 set context.pid16 = "" 
 set context.pid17 = "" 

   set raceNcid = request.GetValueAt("ZZZ:RaceNCID") 
 $$$TRACE("raceNcid(ZZZ-22): "_raceNcid)		  	
 if (raceNcid '= "" && $ISVALIDNUM(raceNcid)= "1") {		
	set context.pid10=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(raceNcid, context.hddContextHelp, context.hddTargetConfigName, .process)
	$$$TRACE("HDD Rep PID-10: "_context.pid10)		
 }
 
 set maritalStatusNcid = request.GetValueAt("ZZZ:MaritalStatusNCID") 
 $$$TRACE("maritalStatusNcid(ZZZ-23): "_maritalStatusNcid)		  	
 if (maritalStatusNcid '= "" && $ISVALIDNUM(maritalStatusNcid)= "1") {		
	set context.pid16=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(maritalStatusNcid, context.hddContextHelp, context.hddTargetConfigName, .process)
	$$$TRACE("HDD Rep PID-16: "_context.pid16)		
 }
     
 set religionNcid = request.GetValueAt("ZZZ:ReligionNCID")
 // GenericV2 translator does not match eGate translator for this rep to ncid conversion - compensating here
 if (religionNcid = 177) {
  set religionNcid = 179
 } 
 $$$TRACE("religionNcid(ZZZ-24): "_religionNcid)		  	
 if (religionNcid '= "" && $ISVALIDNUM(religionNcid)= "1") {		
	set context.pid17=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(religionNcid, context.hddContextHelp, context.hddTargetConfigName, .process)
	$$$TRACE("HDD Rep PID-17: "_context.pid17)		
 }
