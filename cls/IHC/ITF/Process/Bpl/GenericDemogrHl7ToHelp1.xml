 set context.filterUpdates = 0
 set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.GenericDemogrHl7ToHelp1.Lookup.Properties", "UPDATEFILTERFLAG", .retVal )
 set updateFilterFlag = retVal
   
 if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {       
     $$$TRACE("UPDATEFILTERFLAG not found on lookup table(GenericDemogrHl7ToHelp1.Lookup.Properties). Setting default value.")
     set updateFilterFlag = 0
 }

