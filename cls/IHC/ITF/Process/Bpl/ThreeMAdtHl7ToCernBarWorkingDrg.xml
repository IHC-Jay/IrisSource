<code name='DRG Type code for Cerner' xpos='200' ypos='1650' >
<![CDATA[  $$$TRACE("Change the 3M's DRG Type description for Cerner.") 
  Set Drg18 =request.GetValueAt("DRG(1):DRG18")    
  $$$TRACE("DRG-18 : " _Drg18 )
  if (Drg18 ="")
