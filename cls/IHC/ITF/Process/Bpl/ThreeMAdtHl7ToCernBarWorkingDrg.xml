<code name='9. Call GetNcidFromRep' xpos='200' ypos='1250' >
<![CDATA[ 
   set tStatus = process.SendRequestSync(context.hddTargetConfigName,context.hddNcidRequest,.hddNcidResponse)
 if ('tStatus) {
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
 }else{ 
   set context.hddNcidResponse= hddNcidResponse
 }

   
 set context.msh4Ncid = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(context.threeDigitFacNum, context.hddFacilityDomain, context.hddContextCerner, context.hddTargetConfigName, .process)
     

   if (context.msh4Ncid ="") {   
    	set status =  ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "HDD getNcidFromRep call failed to return the NCID ["_context.msh4Ncid_"] for the Rep from Hl7 record [" _context.threeDigitFacNum_"].  Error out to the HDD support for checking.")
   }
   
    $$$TRACE("The NCID result after the HDD lookup call is ["_context.msh4Ncid_"]. The Rep value passed in from the incoming MSH-6 is ["_context.threeDigitFacNum_"]")
 ]]]]><![CDATA[>
