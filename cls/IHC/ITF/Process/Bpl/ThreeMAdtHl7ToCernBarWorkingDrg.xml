<code name='8. Prep GetNcidFromRep' xpos='200' ypos='1150' >
<annotation><![CDATA[Prepare RepFromNcid values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("For Hdd lookup call")  	
 set context.hddNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
 $$$TRACE("After creating HDD NCID lookup request object.")  
 
 set msh6 = request.GetValueAt("MSH:6.1")
 $$$TRACE("The value from the incoming MSH:6.1 is: " _msh6) 
 set ThreeDigitFacNum = ""
 
 if (msh6  = "")
 {    
            $$$TRACE("MSH-6 Facility number is empty:  " _msh6 ) 
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The message from 3M source system  has no facility value in MSH-6.  Skip and send it to source system for fix.")  
 }
 else
 {
                    
            set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ThreeMAdtHl7ToCernBarWorkingDrg.Lookup.AllowedFacilitiesTable", msh6, .retVal )
            $$$TRACE("The facility 3 digit code Lookup returned value: " _retVal)
            
            if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {   
    	        set status =  ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Couldn't get value for the facility in Lookup Table.")	  	  
            }
            else
            {
               set ThreeDigitFacNum = retVal
               $$$TRACE("The corresponding 3 digit facility code on the lookup table is:  " _ThreeDigitFacNum ) 
            }                    
     
 } 
 
 if (ThreeDigitFacNum '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, ThreeDigitFacNum, context.hddFacilityDomain, context.hddContextCerner, "MSH:4")  	  	
     $$$TRACE("8.  Three digit facility code for HDD NCID lookup is: " _ThreeDigitFacNum)     		
 }
 
 $$$TRACE("8.1 After setting HDD NCID lookup request object.")  
 ]]]]><![CDATA[>
