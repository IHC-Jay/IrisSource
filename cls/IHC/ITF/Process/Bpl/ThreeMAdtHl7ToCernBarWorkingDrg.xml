<code name='Check "W" in DG1-6' xpos='200' ypos='1550' >
<annotation><![CDATA[Checking for the working DRG diagnosis type code]]]]><![CDATA[></annotation>
<![CDATA[  //source.{DG1grp(k1).DG1:DiagnosisType}
  set k1="",tSC=1    
  For { 
       Set k1=request.GetNextIndex("DG1grp().DG1",k1,.tSCTrans)  Quit:k1="" 
       set context.diagnosisTypeDg16 = request.GetValueAt("DG1grp("_k1_").DG1:DiagnosisType")
       $$$TRACE("DG1-6 Diagnosis Type: " _context.diagnosisTypeDg16)
       if ((context.diagnosisTypeDg16'="W")&&(context.diagnosisTypeDg16'="w")){			
			    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***DG1-6 Diagnosis Type: ["_context.diagnosisTypeDg16_"].  Error out for source system to fix.")
	  $$$TRACE("DG1-6 Diagnosis Type for Working DRG should be W: " _ context.diagnosisTypeDg16)		
       }        
   }]]]]><![CDATA[>
