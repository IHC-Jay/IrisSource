<code name='8. Prep GetNcidFromRep' xpos='200' ypos='1150' >
<annotation><![CDATA[Prepare RepFromNcid values]]]]><![CDATA[></annotation>
<![CDATA[	
 set context.hddNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
 
 set msh6 = request.GetValueAt("MSH:6.1")
 $$$TRACE("The facility code value from the incoming MSH:6.1 is: " _msh6)
  
 set context.threeDigitFacNum = ""
 
 if (msh6  = "")
 {    
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The message from 3M source system  has no facility value in MSH-6.  Skip and send it to source system for fix.")  
 }
 else
 {
                    
            set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ThreeMAdtHl7ToCernBarWorkingDrg.Lookup.AllowedFacilitiesTable", msh6, .retVal )
            $$$TRACE("The facility 3 digit code Lookup returned value: " _retVal)
            
            if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {   
    	        set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Found no match in the allowed facility lookup Table.  Skip the messages with an invalid facility code.")	  	  
            }
            else
            {
               set context.threeDigitFacNum = retVal
               $$$TRACE("The corresponding 3 digit facility code found in the allowed facility lookup table is:  " _context.threeDigitFacNum ) 
            }                    
     
 } 
 
 if (context.threeDigitFacNum'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, context.threeDigitFacNum, context.hddFacilityDomain, context.hddContextCerner, "MSH:4")  	  	
     $$$TRACE("8.  Three digit facility code for HDD NCID lookup is: " _context.threeDigitFacNum)     		
 }
 ]]]]><![CDATA[>
