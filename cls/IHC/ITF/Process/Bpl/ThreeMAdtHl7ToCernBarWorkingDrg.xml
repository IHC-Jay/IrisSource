    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***DRG-18 is empty.  Error out for source system to fix.")
  }
  
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ThreeMAdtHl7ToCernBarWorkingDrg.Lookup.AllowedDrgTypes", Drg18, .retVal )
 $$$TRACE("DRG type from source's DRG-18:[" _Drg18_"]. Return Value: ["_retVal _"]") 
 if (retVal '= "") 
 {   
      set context.drgType = retVal
      $$$TRACE("The DRG type from the lookup table: " _context.drgType) 
 }
 else
 {
      set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid DRG Type: " _Drg18_ " found no match in the lookup table. Skipping the record." )	  	  
 }
]]]]><![CDATA[>
