<code name='12. Check lookup table in DG1-6' xpos='200' ypos='1550' >
<annotation><![CDATA[Checking for the working DRG diagnosis type code]]]]><![CDATA[></annotation>
<![CDATA[  //source.{DG1grp(k1).DG1:DiagnosisType}
  set k1="",tSC=1    
  For { 
       Set k1=request.GetNextIndex("DG1grp().DG1",k1,.tSCTrans)  Quit:k1="" 
       set context.diagnosisTypeDg16 = request.GetValueAt("DG1grp("_k1_").DG1:DiagnosisType")
       $$$TRACE("DG1-6 Diagnosis Type: " _context.diagnosisTypeDg16)
       
       set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ThreeMAdtHl7ToCernBarWorkingDrg.Lookup.DiagnosisTypes", context.diagnosisTypeDg16, .retVal )
          $$$TRACE("DRG16 :" _ context.diagnosisTypeDg16 _ "]. ItfLookup return Value: ["_retVal _"]") 
 
          if (retVal '= "") 
          {   
              
              $$$TRACE("The DRG type is valid, value from the lookup table: " _ retStat ) 
          }
          else
          {
             // set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid DG1-6 Diagnosis Type: ["_ context.diagnosisTypeDg16 _ "], Not found in the DiagnosisTypes lookup table. Skipping the record." )	  	  
       		
	      set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***DG1-6 Diagnosis Type: ["_context.diagnosisTypeDg16_"].  Not found in the DiagnosisTypes lookup table.")
	  $$$TRACE("DG1-6 Diagnosis Type for Working DRG not in lookup " _ context.diagnosisTypeDg16)		
          }
   }]]]]><![CDATA[>
</code>
<code name='13. DRG Type code for Cerner' xpos='200' ypos='1650' >
<![CDATA[  $$$TRACE("Change the 3M's DRG Type description for Cerner.") 
  Set Drg18 =request.GetValueAt("DRG(1):DRG18")    
  $$$TRACE("DRG-18 : " _Drg18 )
  if (Drg18 ="")
  {         
    $$$TRACE("DRG-18 is empty.")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***DRG-18 is empty.  Error out for source system to fix.")
  }
  else
  {
      //Trim the doc type version number in DRG-18
      set DocTypeWithNoVersionNum =$PIECE(Drg18,".") 
      $$$TRACE("The doc type after trimming the version number  [" _DocTypeWithNoVersionNum_"]")
      if (DocTypeWithNoVersionNum = Drg18)
      {
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***DRG-18 doc type format is invalid.  It contains no dot before the version number.  Error out for source system to fix.")
      }
      else
      {
          set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ThreeMAdtHl7ToCernBarWorkingDrg.Lookup.AllowedDrgTypes", DocTypeWithNoVersionNum, .retVal )
          $$$TRACE("DRG type from source's DRG-18:[" _Drg18_"] and the trimmed doc type base string:[" _DocTypeWithNoVersionNum_ "]. Return Value: ["_retVal _"]") 
 
          if (retVal '= "") 
          {   
              set context.drgType = retVal
              $$$TRACE("The DRG type code from the lookup table: " _context.drgType) 
          }
          else
          {
              set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid DRG Type: " _Drg18_ " found no match in the DGR Type Code lookup table. Skipping the record." )	  	  
          }
      }
 }]]]]><![CDATA[>
