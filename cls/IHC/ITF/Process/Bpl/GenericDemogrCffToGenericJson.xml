<Method name="GetValues">
<ClassMethod>1</ClassMethod>
<FormalSpec>respJSONstring:%String,respArray:%Library.ListOfDataTypes</FormalSpec>
<Implementation><![CDATA[
	  set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respJSONstring)
          set iter = consumedJSONobj.%GetIterator()

         set iterator =  consumedJSONobj.%GetIterator()
         while iterator.%GetNext(.key,.value) { 
         	// WRITE !, " Key: "_key_" Value: "_value
         	IF ( ($isObject(value)) && (value.%Extends("%Library.DynamicAbstractObject")) )
			{
				Do ..ParseDynamicAbstractObject(value,  respArray)	
			}
         }
]]></Implementation>
</Method>

<Method name="ParseDynamicAbstractObject">
<ClassMethod>1</ClassMethod>
<FormalSpec>obj:%Library.DynamicAbstractObject,respArray:%Library.ListOfDataTypes</FormalSpec>
<Implementation><![CDATA[
	 set iterator =  obj.%GetIterator()
     while iterator.%GetNext(.key,.value) {
	      WRITE !, "ParseDynamicAbstractObject Key: "_key _ ": " _ obj.%Get("status")
	     
	     	
	     	IF ( ($isObject(value)) && (value.%Extends("%Library.DynamicAbstractObject")) )
			{
				Do ..ParseDynamicAbstractObject(value, respArray)	
			}
			elseif ( respArray.IsDefined(key)  )
			{
				WRITE !, " Key: "_key_" Value: "_value
				if ( $ZCONVERT(key, "U") [ "NAME")
				{
					if ($ZCONVERT(obj.%Get("status"), "U") = "CURRENT")
					{
						do respArray.SetAt(value, key)
					}
				}
				elseif ( $MATCH($ZCONVERT(key, "U"), "LINE1|LINE2|ZIP|COUNTRY|CITY|STATE") )
				{
					if ($ZCONVERT(obj.%Get("type"), "U") = "HOMEADDR")
					{
						do respArray.SetAt(value, key)
					}
				}
				else
				{
					do respArray.SetAt(value, key)
				}
			}
			
	}
]]></Implementation>
</Method>

<Method name="CallPatientServices">
<ClassMethod>1</ClassMethod>
<FormalSpec><![CDATA[opType:%String,token:%String,mrn:%String,jsonReq:Ens.StringContainer,pConfigName:%String,&process1:Ens.BusinessProcess,&mrnPar]]></FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
		#dim status AS %Status=$$$OK
		set mrnFromResp=""
      $$$TRACE(" Operation Type: " _ opType) 
     $$$TRACE(" Target Operation: " _ process1.PatientServiceTargetConfigName) 
     set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.httpsRequestForPingService).%New() 
     set httpPingServiceRequestObj.accessToken = token
     set httpPingServiceRequestObj.operationType = opType  
     set httpPingServiceRequestObj.identifier = mrn 
     set httpPingServiceRequestObj.streamObject = jsonReq
     $$$TRACE(" Calling Patient Service "_opType_" - BEGIN ")
     set status = process1.SendRequestSync(process1.PatientServiceTargetConfigName,httpPingServiceRequestObj,.patientServiceResponse)
     $$$TRACE(" Calling Patient Service "_opType_" - END ")
     if ($$$ISOK(status)){
      $$$TRACE("Call PatientService "_opType_" Operation OK status.")      
      set restPatientServiceHttpResponse=patientServiceResponse  
      set isOperDone = restPatientServiceHttpResponse.Attributes.GetAt(opType)       
      if (isOperDone ="N"){
	      $$$TRACE("### Failed to "_opType_" the patient :"_mrn_" ####")           
	      set errTxt = restPatientServiceHttpResponse.Attributes.GetAt("ERRTXT")
	      set errMsg = "Failed to "_opType_" this record in Initiate thru Patient Service. Skpping the record. Error Response: "_errTxt
	     // Do ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process1.%ConfigName,   errMsg)
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process1.%ConfigName,errMsg)
	  }else{
      	$$$TRACE("### Operation "_opType_" Done:: "_isOperDone_" ####")           
      	set mrnFromResp = restPatientServiceHttpResponse.Attributes.GetAt("MRN")
      	$$$TRACE("### MRN#:: "_mrnFromResp_" ####")           
	  }   
    }else {
	    $$$TRACE("Unexpected error while calling PatientService. "_$SYSTEM.Status.GetOneErrorText(status))    
        set errorMsg = $SYSTEM.Status.GetOneErrorText(status)
       if (errorMsg ["ERRTOKEN"){
          set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process1.%ConfigName,"Possible invalid or expired access token. Contact HIE service team for access token issue."_errorMsg) 
       }else{
	       if (errorMsg ["POSTSTATUS:0"){
		       set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process1.%ConfigName," No response from the Hie patient service. Contact HIE service team."_errorMsg) 
	       }else{
           	  set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process1.%ConfigName,"Unexpected error while calling PatientService. "_errorMsg)
	       }     
       }
	}   
	 set mrnPar = mrnFromResp      
     quit status
]]></Implementation>
</Method>

