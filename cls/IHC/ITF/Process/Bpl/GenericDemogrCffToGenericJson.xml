<code name='Compare Old addr in rec with initiate' xpos='470' ypos='1100' >
<![CDATA[ set line1Str = context.jsonRespArray.GetAt( "line1")
 set extAdd = $EXTRACT(line1Str ,1,$LENGTH(context.WrongAppend))
 $$$TRACE("EXTRACT of " _ line1Str  _ " in line1: " _extAdd)
 
 if ( $ZCONVERT(extAdd, "U") '= $ZCONVERT(context.WrongAppend, "U") )
 {
    $$$TRACE("line 1 in Initiate record is not WRONG, compare fields")
   
    
    set initiateZip =  $ZSTRIP(context.jsonRespArray.GetAt( "zip"), "*P") 
    set reqZip = $ZSTRIP(request.OldZip, "*P")
    $$$TRACE("The Zip after removing hyphon : " _ initiateZip ) 
 
    if ( (context.jsonRespArray.GetAt( "familyName") = request.LastName) && 
     (context.jsonRespArray.GetAt( "dateOfBirth")  = request.OldBirthdate) && 
     (line1Str = request.OldAddress1)  && 
     (context.jsonRespArray.GetAt("line2") = request.OldAddress2) && 
     (context.jsonRespArray.GetAt("state") = request.OldState) && 
     (context.jsonRespArray.GetAt( "city") = request.OldCity) && 
     (initiateZip = reqZip ) 
     )   
    {
      $$$TRACE("initiate Address 1 will be updated with Wrong initiateTempAddress1: " _ line1Str)
    }
    else
    {
      $$$TRACE("Values in inbound and Initiate do not match")
      $$$TRACE(context.jsonRespArray.GetAt( "familyName") _ ", " _ request.LastName)
      $$$TRACE(line1Str  _ ", " _request.OldAddress1)  
      $$$TRACE(context.jsonRespArray.GetAt("line2") _ ", " _request.OldAddress2) 
      $$$TRACE(context.jsonRespArray.GetAt("state") _ ", " _request.OldState) 
      $$$TRACE(context.jsonRespArray.GetAt( "city") _ ", " _request.OldCity) 
      $$$TRACE(initiateZip  _ ", " _ reqZip )
       set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Values in inbound record and Initiate do not match. Skipping this record. " _ request.MMINumber)
   } 
  }  
  else
  {
        
         set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"MMI Record is already in WRONG status. Skipping this record. "_ request.MMINumber)
  }

  
