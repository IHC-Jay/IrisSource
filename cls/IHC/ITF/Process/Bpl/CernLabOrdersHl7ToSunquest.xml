   {
    set specimenAlias = "OBR.15.1"
   } 
   if ($LOCATE(request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:SpecimenSource.bodysite.identifierST"),"CD:") ="1") 
    { 
    set specimenAlias = specimenAlias _ "," _"OBR.15.2"
    $$$TRACE(specimenAlias)
    } 
      
      
 if specimenAlias '=""
    {
        if $EXTRACT(specimenAlias ,1,1) = ","
	       {
	            	set specimenAlias = $EXTRACT(specimenAlias ,2,*)
	       }
