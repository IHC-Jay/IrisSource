 set uniqueDomain=""
 $$$TRACE("Return value from obr4 lookup table: "_retVal)
 if ($$$ISERR(targetStat) || (retVal = "Unknown") || (retVal ="")) {       
    $$$TRACE("Unable to get Target from the lookup table for unique context on obr4 using default.")
    set context.Obr4Context= context.IHCCernerToSunquestContext
 } else {
    $$$TRACE("In ismember lookup")
    set pv13 = request.GetValueAt("PIDgrp.PV1grp.PV1:3.2")
    if ((pv13="") || (pv13="<sp>")) {
       set pv13 = request.GetValueAt("PIDgrp.PV1grp.PV1:3.1")
    }
    set uniqueLookup =##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(pv13,context.SpecialContextExclusionDomain,context.SatelliteExclusion,context.hddTargetConfigName,.process)
    $$$TRACE("Unique domain to use? "_uniqueLookup)
    if (uniqueLookup '="") {
       $$$TRACE("Using satellite unique lookup logic.")
       set obr4=request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceIdentifier.identifierST")
       $$$TRACE("Obr 4: "_obr4)
       set useUniqueContext =##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).isMember(uniqueLookup,obr4,context.hddTargetConfigName,.process)
       $$$TRACE("Use unique context? "_useUniqueContext)
       if (useUniqueContext ="1") {
          set uniqueContext = $PIECE(retVal,",",2)
          set context.Obr4Context= uniqueContext
       }elseif ((useUniqueContext["ITFCOMMON:10109") || (useUniqueContext="") || (useUniqueContext["Web service returned(error):")){
          set status =##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "There was a problem with either the data used for the obr4 isMember lookup (using domain: "_uniqueDomain_" and ncid: "_obr4_") or the lookup returned an error, shutting down. Error returned: "_useUniqueContext_". If blank after error returned then it is a domain/data issue.")
       }else {
          set context.Obr4Context= context.IHCCernerToSunquestContext
       }
    }elseif ((uniqueLookup["ITFCOMMON:10109") || (uniqueLookup["Web service returned(error):")){
       set status =##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "There was a problem with either the data used for the PV!-3 reptoncid lookup (using domain: "_context.SpecialContextExclusionDomain_"and Context: "_context.SatelliteExclusion_" and rep: "_pv13_") or the lookup returned an error, shutting down. Error returned: "_uniqueLookup_". If blank after error returned then it is a domain/data issue.")
    }else {
       set uniqueDomain = $PIECE(retVal,",",1)
       set obr4=request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceIdentifier.identifierST")
       $$$TRACE("Obr 4: "_obr4)
       set useUniqueContext =##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).isMember(uniqueDomain,obr4,context.hddTargetConfigName,.process)
       $$$TRACE("Use unique context? "_useUniqueContext)
       if (useUniqueContext ="1") {
          set uniqueContext = $PIECE(retVal,",",2)
          set context.Obr4Context= uniqueContext
       }elseif ((useUniqueContext["ITFCOMMON:10109") || (useUniqueContext="") || (useUniqueContext["Web service returned(error):")){
          set status =##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "There was a problem with either the data used for the obr4 isMember lookup (using domain: "_uniqueDomain_" and ncid: "_obr4_") or the lookup returned an error, shutting down. Error returned: "_useUniqueContext_". If blank after error returned then it is a domain/data issue.")
       }else {
          set context.Obr4Context= context.IHCCernerToSunquestContext
       }
    }
    $$$TRACE("Context used: "_context.Obr4Context)
 }]]]]><![CDATA[>
