 for { 
    set orcIndex=request.GetNextIndex("ORCgrp()",orcIndex,.tSCTrans)  Quit:orcIndex=""
    set obr4 = request.GetValueAt("ORCgrp("_orcIndex_").OBRuniongrp.OBRunion.OBR:UniversalServiceIdentifier.identifierST")
