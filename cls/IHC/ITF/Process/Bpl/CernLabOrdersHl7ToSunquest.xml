             set context.specimenAliasAlert = ##class(IHC.ITF.ITFCOMMON.Utility).CreateAlert("Sending record without Specimen type/modifier.Lab will need to fix NCIDs.Field/s " _ specimenAlias _ " is/are not aliased on Cerner. " _ "Hl7 Msg:" _ request.RawContent,process.%ConfigName)
             
