       set targetStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernLabOrdersHl7ToSunquest.Lookup.Obr4SpecimenConcatenation", obr4, .specimenTable)
       if ((specimenTable '="") && (specimenTable '="Unknown")) {
          do context.SpecimenField.SetAt($P(specimenTable,",",2), orcIndex)
          if (context.SpecimenField.GetAt(orcIndex) ="OBR") {
             set obr151 =request.GetValueAt("ORCgrp("_orcIndex_").OBRuniongrp.OBRunion.OBR:SpecimenSource.specimensourcenameorcode.identifierST")
             set obr154 =request.GetValueAt("ORCgrp("_orcIndex_").OBRuniongrp.OBRunion.OBR:SpecimenSource.bodysite.identifierST")
             set targetStat2 = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup($P(specimenTable,",",1), obr151_"|"_obr154, .newSpecimen)
             if ((newSpecimen '="") && (newSpecimen '="Unknown")) {
                do context.Specimen.SetAt(newSpecimen, orcIndex)
             }
          }elseif (context.SpecimenField.GetAt(orcIndex) ="OBX") {
             for {
                set obxIndex=request.GetNextIndex("ORCgrp("_orcIndex_").OBRuniongrp.OBXgrp()",obxIndex,.tSCTrans)  Quit:obxIndex=""
                set obx3 = request.GetValueAt("ORCgrp("_orcIndex_").OBRuniongrp.OBXgrp("_obxIndex_").OBX:ObservationIdentifier.identifierST")
                set obx5 = request.GetValueAt("ORCgrp("_orcIndex_").OBRuniongrp.OBXgrp("_obxIndex_").OBX:ObservationValue(1)")
