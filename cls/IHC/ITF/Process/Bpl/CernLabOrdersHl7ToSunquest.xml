<transform name='Mapper.' class='IHC.ITF.Transform.Dtl.CernLabOrdersHl7ToSunquestMapper' source='request' target='response' xpos='200' ypos='1750' />
<code name='Add test note if needed' xpos='200' ypos='1850' >
<![CDATA[    if (context.NoteToAdd '="") {
       $$$TRACE("Test note to send: " _context.NoteToAdd)
       set NTESeg = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&NTE||||"))
       set noteCount = response.GetValueAt("ORCgrp(1).OBRuniongrp.NTE(*)")
       if (noteCount >0) {
          set note =""
          $$$TRACE("Prepending new note")
          set orcIndex =""
          for { 
             $$$TRACE("In note loop 1")
             set note = context.NoteToAdd
             $$$TRACE("In note loop 1.1")
             Set orcIndex=response.GetNextIndex("ORCgrp()",orcIndex,.tSCTrans)  Quit:orcIndex=""
             set nteIndex =""
             for {
                $$$TRACE("In note loop 2")
                set nteIndex=response.GetNextIndex("ORCgrp("_orcIndex_").OBRuniongrp.NTE()",nteIndex,.tSCTrans)   Quit:nteIndex=""
                set note =note_","_response.GetValueAt("ORCgrp("_orcIndex_").OBRuniongrp.NTE("_nteIndex_"):3(1)")
             }
             set pointer =0
             set outboundIndex =0
             while $ListNext($LISTFROMSTRING(note,","),pointer,listValue){
                $$$TRACE("In note loop 3")
                set outboundIndex =(outboundIndex+1)
                do response.InsertSegmentAt(NTESeg,"ORCgrp(1).OBRuniongrp.NTE()")
                do response.%Save()
                do response.SetValueAt(outboundIndex, "ORCgrp(1).OBRuniongrp.NTE("_outboundIndex_"):1")
                do response.SetValueAt(listValue, "ORCgrp(1).OBRuniongrp.NTE("_outboundIndex_"):3(1)") 
             }
          }
       }else {
          do response.InsertSegmentAt(NTESeg,"ORCgrp(1).OBRuniongrp.NTE()")
          do response.%Save()
          do response.SetValueAt("1", "ORCgrp(1).OBRuniongrp.NTE(1):1")
          do response.SetValueAt(context.NoteToAdd, "ORCgrp(1).OBRuniongrp.NTE(1):3(1)")
       }       
       set context.NoteToAdd =""
    }]]]]><![CDATA[>
