<code name='process response of the height/weight service call' xpos='470' ypos='1400' >
<![CDATA[ $$$TRACE("Call REST Operation")
      set statusCode=""
      set statusDesc=""
  if (context.icentraSvcRequest'="") {
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync(context.hwOpNm,context.icentraSvcRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set statusLine=""
      set context.restHttpResponse=httpRESTResponse
      set statusLine=context.restHttpResponse.HTTPHeaders.GetAt("StatusLine")
      if (statusLine'=""){
	set statusCode=$piece(statusLine," ",2)
	set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
		  // If status code is 200 the check the reponse to see if it got processed correctly or not
      if (statusCode'="200"){
        set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"REST service response with code: "_statusCode_"  Desc: "_statusDesc) 
      }
      else {
        Set tcharStream = ##class(%GlobalCharacterStream).%New()
        Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
        $$$TRACE("tcharStream size:"_tcharStream.Size)
        set text=""
        While 'tcharStream.AtEnd {
          Set text = text_tcharStream.Read($$$MaxStringLength)
        } 
        $$$TRACE("REST service response: "_text)
        If ($$$IsdefObject(tcharStream)) {
	  Do tcharStream.Rewind()
	  Set tConsumedJSON = ##class(%Library.DynamicAbstractObject).%FromJSON(tcharStream)
	  $$$TRACE("Status Message: "_tConsumedJSON.%Get("message"))
	  set iter = tConsumedJSON.%GetIterator()
	  set statusKey=""
	  set statusCode=""
	  #dim statusIter As %Iterator.Object
	  #dim detailIter As %Iterator.Array
	  do iter.%GetNext(.key , .value )
	  set iter = value.%GetIterator()
	  while iter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="service-status" {
	        set statusIter=value.%GetIterator()
	     }
	     elseif ((key="code") && (statusKey="service-status")) {
	       set statusCode=value
	     }
	     if key="status-details" {
                set detailIter = value.%GetIterator()
	     }
	     else {
	        continue
	     }
	  }
	  while statusIter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="code" {
	        set statusCode=value
	        if statusCode="000" {
	          while detailIter.%GetNext(.key , .value ) {
	            $$$TRACE("key = "_key_" , value = "_value)
	               if key="MEASURED-HEIGHT-UNITS" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.heightUnit=##class(Ens.Util.FunctionSet).ToUpper(value)
	               }
	               elseif key="MEASURED-WEIGHT-UNITS" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.mweightUnit=##class(Ens.Util.FunctionSet).ToUpper(value)
	               }
	               elseif key="DOSAGE-WEIGHT-UNITS" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.dweightUnit=##class(Ens.Util.FunctionSet).ToUpper(value)
	               }
	               elseif key="MEASURED-HEIGHT" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.height=value
	               }
	               elseif key="MEASURED-HEIGHT-PERFORMED" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.heightDt=value
	               }
	               elseif key="DOSAGE-WEIGHT" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.dweight=value
	               }
	               elseif key="DOSAGE-WEIGHT-PERFORMED" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.dweightDt=value
	               }
	               elseif key="MEASURED-WEIGHT" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.mweight=value
	               }	
	               elseif key="MEASURED-WEIGHT-PERFORMED" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  set context.mweightDt=value
	               }	                              
	          }
	        }
	        else {
	          set status=##class(IHC.ITF.ITFCOMMON.Utility).ProcessErrorExt(process.%ConfigName,"iCentra service failed to query height and weight for FIN:"_context.enc_" with Status: "_value)
	          quit
	        }
	     }
	  }
        }
	$$$TRACE("REST Service response Status Code: "_statusCode)
      }
    }
    ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Post request failed with Status Code: "_statusCode_" : Status Desc: "_statusDesc) 
    }
  } 
  if ((context.heightUnit="IN") || (context.heightUnit="INCH") ) {
     set context.height=context.height*2.54
  }
  if ((context.mweightUnit="LB") || (context.mweightUnit="POUND") ) {
     set context.mweight=context.mweight*0.453592
  }
  if ((context.dweightUnit="LB") || (context.dweightUnit="POUND") ) {
     set context.dweight=context.dweight*0.453592
  }
  if (context.heightDt'="") {
     set tmpDt=$P(context.heightDt,"-",3)_$P(context.heightDt,"-",1)_$P(context.heightDt,"-",2)
     set context.heightDt=tmpDt_"000000"
  }
  if (context.dweightDt'="") {
     set tmpDt=$P(context.dweightDt,"-",3)_$P(context.dweightDt,"-",1)_$P(context.dweightDt,"-",2)
     set context.dweightDt=tmpDt_"000000"
  }
  if (context.mweightDt'="") {
     set tmpDt=$P(context.mweightDt,"-",3)_$P(context.mweightDt,"-",1)_$P(context.mweightDt,"-",2)
     set context.mweightDt=tmpDt_"000000"
  }
  $$$TRACE("Height and Wiehgts(dose,messured): "_context.height_" "_context.heightUnit_" "_context.heightDt_"/"_context.dweight_" "_context.dweightUnit_" "_context.dweightDt_" "_context.mweight_" "_context.mweightUnit_" "_context.mweightDt)]]]]><![CDATA[>
</code>
