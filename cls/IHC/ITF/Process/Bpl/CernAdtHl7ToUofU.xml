<code name='SetCernerAndUofUMrns' xpos='200' ypos='650' >
<annotation><![CDATA[Get EMPI(CMRN and UofU)]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Setting Empi(CMRN and UofU)...") 
  set context.empiNumber=""
  set k1="",tSC=1 
 For { 
     Set k1=request.GetNextIndex("PID:3()",k1,.tSCTrans)  Quit:k1=""          
     If (request.GetValueAt("PID:3("_k1_").4.1")="EMPI") {
         Set context.empiNumber=request.GetValueAt("PID:3("_k1_").1")              
     }
     If (request.GetValueAt("PID:3("_k1_").4.1")= context.UofUMrnTypeNcid) {
         Set context.uofuMrnNumber=request.GetValueAt("PID:3("_k1_").1")              
     }     
 }
 $$$TRACE("Cerner MRN " _ context.empiNumber) 
 $$$TRACE("UofU MRN (From PID): " _ context.uofuMrnNumber) 
     if ($ISVALIDNUM(context.uofuMrnNumber)'="1"){	 
        set k1="",tSC=1 
    For { 
     Set k1=request.GetNextIndex("OBX()",k1,.tSCTrans)  Quit:k1="" 
     Set obx5Value = request.GetValueAt("OBX("_k1_"):5(1)")
     set obx31= request.GetValueAt("OBX("_k1_"):3.1")
     if (obx31 = "U_MRN") {	       
             set context.uofuMrnNumber = obx5Value
      }                 
    }
       if ($ISVALIDNUM(context.uofuMrnNumber)'="1"){	
          Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, " Invalid UofU mrn# ["_ context.uofuMrnNumber _"].  Contact Cerner Cerner registration system. Skipping the record." )
       }       
     }
     $$$TRACE("UofU MRN (From OBX): " _ context.uofuMrnNumber) 
 ]]]]><![CDATA[>
