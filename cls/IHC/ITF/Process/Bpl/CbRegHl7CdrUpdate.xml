<code name='Call GetNcidFromRep' xpos='200' ypos='850' >
<![CDATA[  set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.LookupResponse, "MSH4:SendingFac")
 $$$TRACE("Just setup hdd object")
 if (hddObj '= ""){
     $$$TRACE("Just checked hdd object")
    if (hddObj.NCID '= ""){
       $$$TRACE("Just checked hdd object response")
       set context.facility = hddObj.NCID
       $$$TRACE("Created HDD Response for Facility. NCID: " _hddObj.NCID_ ", context: " _context.FacilityContext_", domain: " _context.FacilityDomain)
    }
   }
 
 //For Language
 
   set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.LookupResponse, "PID15:Lang")
 $$$TRACE("Just setup Language hdd object")
 if (hddObj '= ""){
     $$$TRACE("Just checked Language hdd object")
    if (hddObj.NCID '= ""){
       $$$TRACE("Just checked Language hdd object response")
       set context.ncidLanguage = hddObj.NCID
       $$$TRACE("Created HDD Response for Language. NCID: " _hddObj.NCID_ ", context: " _context.CBContext_", domain: " _context.LanguageDomain)
    }
