<code name='Build HDD Request' xpos='200' ypos='950' >
<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object") 
 
 //MSH.4 HDD
 set MSH4 = request.GetValueAt("MSH:4.1") 
 if (MSH4 '= "" && $ISVALIDNUM(MSH4)= "1") 
 {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , MSH4 , context.FacilityContext, "MSH.4")  	  	
         		
 }
 else {
    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH.4.1 is Null or invalid NCID, Skipping the record.")
 }
 
 //PV1_3_4 HDD
 set PV134 = request.GetValueAt("PV1:AssignedPatientLocation.facilityHD.namespaceID") 
 if (PV134 '= "" && $ISVALIDNUM(PV134)= "1") 
 {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , PV134, context.FacilityContext, "PV1.3.4")  	  	
         		
 }
 else {
    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "PV1.3.4 is Null or invalid NCID, Skipping the record.")
 }
  
 //PID.8  
 set pid8Sex = request.GetValueAt("PID:Sex")  	
 $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)
 if (pid8Sex '= "") 
 {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid8Sex, context.DefaultHelpContext, "PID8")  	  	         		
 }
 
 //PID.30  
 set pid30 = request.GetValueAt("PID:PatientDeathIndicator")  	
 if (pid30 '= "") 
 {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid30, context.DefaultHelpContext, "PID30")  	  	     	
 }
 
 //PV1.3.1
 set PV1PointCare= request.GetValueAt("PV1:AssignedPatientLocation.pointofcare")  
 if (PV1PointCare'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, PV1PointCare, context.PatientLocationContext, "PV1:pointofcare")  	  	
         		
 }
 
 //PV1.3.2
 set PV1Room= request.GetValueAt("PV1:AssignedPatientLocation.room")  
 if (PV1Room'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, PV1Room, context.PatientLocationContext, "PV1:Room")  	  	
         		
 }

 //PV1.3.3
 set PV1Bed= request.GetValueAt("PV1:AssignedPatientLocation.bed")  
 if (PV1Bed'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, PV1Bed, context.PatientLocationContext, "PV1:Bed")  	  	
         		
 }

 //OBR.4
 set obr4SvcId = request.GetValueAt("OBR:4.1") 
 if (obr4SvcId '= "" && $ISVALIDNUM(obr4SvcId)= "1") 
 {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr4SvcId, context.ReportContext, "OBR4:USId")  	  	
 }
 else {
    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "OBR-4.1 is Null or invalid NCID, Skipping the record.")
 }
 
 
 set obr25ResStatus = request.GetValueAt("OBR:25")  	
 if (obr25ResStatus '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr25ResStatus, context.RESULTSTATUSCONTEXT, "OBR25:ResultStatus")  	  	
     $$$TRACE("Hdd Request OBR-25 ResultStatus is " _ obr25ResStatus )     		
 }


