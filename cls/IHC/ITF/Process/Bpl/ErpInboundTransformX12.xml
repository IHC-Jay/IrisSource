<code name='Get documentType ' xpos='200' ypos='650' >
<![CDATA[
 set context.documentType = ""
 set context.x12Doc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.Stream, .stat)
	   if ( ($$$ISOK(stat)) && ($IsObject(context.x12Doc)) && (context.x12Doc.%Extends("EnsLib.EDI.X12.Document")) )
	   {
		 $$$TRACE("Inbound data is X12")
			 set context.x12Doc.DocType = "ERP_4010:Interchange:Group"
			 			 
			 Set k1="",tSC=1,k2=""
			 set nxt = context.x12Doc.GetSegmentIndex("GroupDocsRef",.tSCTrans)
			 Set k1=context.x12Doc.NextChild(k1,nxt)

			 while (($IsObject(k1)) && (context.documentType = ""))
			{
			    
				If ""=k1.DocType {
					Set tDocType = k1.resolveChildDocType()
					
					Set tSC =k1.PokeDocType(tDocType)
				}
				Set context.x12Doc.FunctionalGroups(k1)=k1
			
		 		Set k2=context.x12Doc.FunctionalGroups(k1).NextChild(k2,context.x12Doc.FunctionalGroups(k1).GetSegmentIndex("TransactionSetDocsRef",.tSCTrans))
		 		while (($IsObject(k2)) && (context.documentType = ""))
		 		{


					Set context.x12Doc.FunctionalGroups(k1).TransactionSets(k2)=k2
					If ""=k2.DocType {
						Set tDocType = k2.resolveChildDocType()
						Set tSC =k2.PokeDocType(tDocType)
					}
					
						set segRec = k2.GetValueAt(1)
						set recType = k2.GetValueAt(1_":0")
						if (recType = "ST")
						{
							set context.documentType = k2.GetValueAt("1:1")
							set stCtrlNum = k2.GetValueAt("1:2")
							$$$TRACE( context.documentType _", " _ stCtrlNum)
							QUIT
						}
					
		 		}
			}
	     set context.dtlNm = "IHC.ITF.Transform.Dtl.ErpX124010" _ context.documentType _"ToWorkdayXML" 
	
	     $$$TRACE("Call: " _ context.dtlNm)
	}
	else
	{  
	
	     $$$TRACE("NOT X12")
	}
			 
			
	SET $ZSTORAGE=-1
	$$$TRACE("Storage: " _ $ZS)]]]]><![CDATA[>
