<code name='Send data' xpos='470' ypos='1300' >
<![CDATA[
   $$$TRACE("Create Stream Container")
   set scTp = ##class(IHC.ITF.DStruc.Record.StreamContainerWithTransType).%New()
   set scTp.Stream = ##class(%Library.FileCharacterStream).%New()
 
   set scTp.TpName = request.TpName
   set scTp.Folder = request.Folder
   set scTp.TransType = request.TransTypeName
   set scTp.TradingPartnerName = request.TradingPartnerName
   
   set stat = response.OutputToLibraryStream(scTp.Stream) 

   if ('stat) { 
      set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," Unexpected response returned from Stream Copy." _$SYSTEM.Status.GetOneErrorText(stat))    
   }
   else
   {
      $$$TRACE("OutputToLibraryStream OK")
   }
   set flNm = ##class(%File).GetFilename(request.OriginalFilename)
 
   set scTp.OutputFilename = request.TpName _ "_" _ $SYSTEM.SYS.TimeStamp() _ "_" _ request.%Id() _ ".xml"
   set scTp.OriginalFilename = request.TpName _ "_" _ $SYSTEM.SYS.TimeStamp()  _ "_" _ request.%Id()_ ".xml" 
 
 FOR ind=1:1:context.targetList.Count()
 {
    $$$TRACE(ind _ ". Send DTL data to: " _ context.targetList.GetAt(ind) _ ", stream size:" _ scTp.Stream.Size)
   
    set tStatus=process.SendRequestAsync(context.targetList.GetAt(ind), scTp, "Inbound Message")
    if ('tStatus) { 
       set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," Unexpected response returned or call failure." _$SYSTEM.Status.GetOneErrorText(tStatus))    
    }
 }
