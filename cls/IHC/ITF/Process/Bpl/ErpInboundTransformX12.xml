<code name='Validate X12 data' xpos='470' ypos='1000' >
<![CDATA[	 
       set GSnum = 1
 	   set GSCounter = context.x12Doc.ChildCount
         
  		$$$TRACE(  " GS ChildCount " _ GSCounter)
          
          while ( GSnum <= GSCounter)
          {
	          	set individualGroup = context.x12Doc.getNthChild(GSnum,2)
	          	set individualGroup.DocType = "ERP_4010:Group"
	          	set STCounter = individualGroup.ChildCount 
		        $$$TRACE(  GSnum _ ". ST ChildCount " _ STCounter)
		        #dim individualST As EnsLib.EDI.X12.Document
		        set STnum = 1
		        if ( STCounter >= 1)
		        { 
		        	set individualST = individualGroup.getNthChild(STnum)
		        	set individualST.DocType = "ERP_4010:" _ context.documentType
		        	Do individualST.BuildMap()
		        	if $$$ISERR(individualST.BuildMapStatus)
		        	{
		        		$$$TRACE( "BuildMapStatus: failed" )
						set errStr = ""
		        		Do $system.Status.DecomposeStatus(individualST.BuildMapStatus,.err,"-d")
	  					For i=1:1:err { set errStr = errStr _", " _ err(i) }
	  					Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"X12 data error. " _ errStr)
		        	}
		        	else
		        	{
			        	$$$TRACE( "BuildMapStatus: passed")
		        	}
		        }
		        else
		        {
			        $$$TRACE( "No segments in ST-SE")
					Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"X12 data error. No segments in ST-SE")
		        } 
		        Do $INCREMENT(GSnum) 
          }
       if $$$ISERR(status)
       {
             Set errStr = $SYSTEM.Status.GetErrorText(status)  				  		    
             Do process.ItfSendAlert(errStr _ " Invalid Inbound Data, file name: " _ request.OriginalFilename)
   
             set tStatus=process.SendRequestAsync("ErpInbound-ToError-XmlAndX12-File", request, "20")
             if ('tStatus) { 
                 set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," Unexpected response returned or call failure." _$SYSTEM.Status.GetOneErrorText(tStatus)) 
             }   
       }
  
  ]]]]><![CDATA[>
