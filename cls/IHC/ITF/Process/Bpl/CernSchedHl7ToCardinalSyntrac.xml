<code name='check AIS-3' xpos='470' ypos='1800' >
<annotation><![CDATA[Check if AIS-2 = 'RAD' and AIS-3 types are desired.]]]]><![CDATA[></annotation>
<![CDATA[    
    set ais3 =context.ais3ServiceIDList.GetAt(1)
    $$$TRACE("AIS-3 value: " _ ais3)   
    
  set ais2=request.GetValueAt("RGSgrp(1).AISgrp(1).AIS:SegmentActionCode")
 $$$TRACE("AIS-2 value: " _ ais2)   
  
  // check if AIS-2 is RAD
  if (ais2 = "RAD")
  {
  
  //Ensure that ais3 is on  "AllowedAIS3Types" tab
  
  //Retrieve AllowedAIS3Types from 'Additional Setting' tab
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedAIS3Types",.AllowedAIS3Types)
 
   
 // If the 'AllowedAIS3Types' setting was not found, signal error and shutdown
 // ELSE if the setting was found, but was empty, signal error and shutdown
 // ELSE check incoming facility
 if ($$$ISERR(pstatus))
 {
    // AllowedAIS3Types setting was not found
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, No configuration for AllowedAIS3Types found. Shutting down")
 }
 elseif (AllowedAIS3Types = "")
 {
    // AllowedAIS3Types setting found, but was empty
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, AllowedAIS3Types configuration is empty. Shutting down")
 }
 else
 {
    $$$TRACE("AllowedAIS3Types : "_AllowedAIS3Types) 
         
    // Loop thru each allowed AIS-3 from the 'AllowedAIS3Types' tab
    For iTarget=1:1:$L(AllowedAIS3Types, ",") 
    { 
        
        Set tOneTarget=$ZStrip($P(AllowedAIS3Types,",",iTarget),"<>W") 
        Continue:""=tOneTarget
            
        // validate the AIS3 value   
        if ((##class(Ens.Util.FunctionSet).StartsWith(ais3,tOneTarget)))
        {
            $$$TRACE("ais3 is accepted")
	    set context.isAllowedAIS3 = 1
	    QUIT
        } 
    }
 
    // If this AIS3 is not sent to CardinalSyntrac, write filter message to log & skip
    if (context.isAllowedAIS3 = 0)
    {
       Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "AIS Type ["_ais3_"] not sent to CardinalSyntrac. Skipping the record.") 
    }
 }
 
 }
 
 else
 {
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "AIS-2 ["_ais2_"] not sent to CardinalSyntrac. Skipping the record.")
 }]]]]><![CDATA[>
