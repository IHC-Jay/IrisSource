<code name='Filter for allowed facilities' xpos='200' ypos='650' >
<![CDATA[ $$$TRACE("Filter for the NCID that stands for the allowed facility.")
 
 set k1="",tSC=1
 set FacLookupFound = 0
 set facNcid = 0
 For { 
 
         set k1=request.GetNextIndex("MFEgrp(1).PRA:7()",k1,.tSCTrans) Quit:k1=""   
         set facNcid = request.GetValueAt("MFEgrp(1).PRA:7("_k1_").1.1")
         $$$TRACE(" k1 of loopIndex: " _k1) 
         $$$TRACE("The facility Privilige Ncid: "_facNcid )   

        
         if (facNcid = "" || $ISVALIDNUM(facNcid)'="1")

         {
    
            $$$TRACE("Loop Index at: " _k1_ ":  The PRA-7.1 Privilige value is either blank or non-numeric value:  " _facNcid ) 

         }
         else
        {
                    
            set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.MsprGenericHl7ToSunquestProviderNonProvider.Lookup.AllowedFacilitiesTable", facNcid, .retVal )
            $$$TRACE("Lookup call returned value: " _ retVal)
    
            if (retVal = 1) 
            {   
               set FacLookupFound = 1
               $$$TRACE("Loop Index at: " _k1_ ":  The facility Privilige Ncid found match on the lookup list:  " _facNcid ) 
            }  
                     
     
        }  
   
  }

  
   if (FacLookupFound = 0)
   {
          set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "No valid  facility privilege found. Skip the record.  ")
   }
 
   ]]]]><![CDATA[>
