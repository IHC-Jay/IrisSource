	set context.hidDemogrObj = ##class(IHC.ITF.Service.HieServiceDemographics).%New()
	set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.HiePatientService).%New() 
    set httpPingServiceRequestObj.streamObject = request
    
    set jsonObj = ##class(IHC.ITF.Util.IhcHieDemogrJsonWsrPatientService).%New() 
    set temp =  jsonObj.ParseJson(httpPingServiceRequestObj, .resp) 
    
    $$$TRACE("Data:::"_temp)
    
    $$$TRACE("resp:::"_resp)
    
    set context.hidDemogrObj = resp
    
