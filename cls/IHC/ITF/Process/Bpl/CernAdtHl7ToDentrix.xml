<code name='Get NCIDs to send to HDD' xpos='200' ypos='1450' >
<annotation><![CDATA[- Retrieve Guarantor Country NCID's from HL7 message
- Retrieve InsuredrelationToPatient NCIDs
- Load these values into variable 'hddRepRequest'
- These will be used to call HDD from within DTL]]]]><![CDATA[></annotation>
<![CDATA[
  //
  // Retrieve all Guarantor Country NCID's & add to 'hddRepRequest
  //
  set k1 = 1
  set ncid = request.GetValueAt("GT1("_k1_"):GuarantorAddress(1).country")
 
  
  while((ncid '= "") && ($ISVALIDNUM(ncid) = "1"))
  {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , ncid,  context.hddCountryContext, "GT1:Country"_k1)  
     
     set k1 = k1 + 1
     set ncid = request.GetValueAt("GT1("_k1_"):GuarantorAddress(1).country")
  }
  
  // Subtract 1 from k1 to get the correct number of NCID's
  set k1 = k1 - 1
  $$$TRACE("Retrieved "_k1_" Country NCID's")
 
  //-------------------------------------------------------------------------------------
  //
  // Retrieve all InsuredRelationToPatient NCID's & add to 'hddRepRequest
  //
  set k1 = 1
  set ncid = request.GetValueAt("IN1grp("_k1_").ZNI:PatientRelationship")
 
  while((ncid '= "") && ($ISVALIDNUM(ncid) = "1"))
  {
     $$$TRACE("Retrieved relationship NCID : "_ncid)
 
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , ncid,  context.hddInsuredRelationContext, "IN1:InsuredRelation"_k1)  
     
     set k1 = k1 + 1
     set ncid = request.GetValueAt("IN1grp("_k1_").ZNI:PatientRelationship")
  }
  
  // Subtract 1 from k1 to get the correct number of NCID's
  set k1 = k1 - 1
  $$$TRACE("Retrieved "_k1_" InsuredRelationToPatient NCID's")
 ]]]]><![CDATA[>
