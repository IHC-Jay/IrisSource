<code name='Get  HDD Contexts' xpos='200' ypos='1350' >
<annotation><![CDATA[- Access lookup file for:
- Guarantor Country context
- Insured Relation context
- If any are not found, use the default value defined in the variable definition]]]]><![CDATA[></annotation>
<![CDATA[  //
  // Get the HDD context value used to convert the Country NCID
  // If not found in the lookup file, use the value set in the variable definition
  //
      set retStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToDENTRIX.Lookup.HddContexts", "CONTEXT.CountryContext", .retVal )
    if (retVal '= "Unknown")
    {
	set context.hddCountryContext = retVal
    } 		
    $$$TRACE("Hdd Context hddCountryContext: " _ context.hddCountryContext)
    
      //
  // Get the HDD context value used to convert the InsuredRelation NCID
  // If not found in the lookup file, use the value set in the variable definition
  //
      set retStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToDENTRIX.Lookup.HddContexts", "CONTEXT.InsuredRelationContext", .retVal )
    if (retVal '= "Unknown")
