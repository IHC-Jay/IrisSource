   } 
   else { 
     
     $$$TRACE("Response StreamBG: " _ digResponse.StreamBG)
     set stream = digResponse.StreamBG
     While 'stream.AtEnd 
     { 
       set respStr =  stream.ReadLine(,.sc,.eol)
       $$$TRACE(respStr) 
       If $$$ISERR(sc) 
       { 
           $$$TRACE("ERROR")
