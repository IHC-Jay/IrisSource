<code name='Construct Json with FIN' xpos='470' ypos='1000' >
<![CDATA[ 
  set context.FINNumber= request.GetValueAt("PIDgrp(1).PID:PatientAccountNumber.IDNumber")
  set context.AppointmentID = request.GetValueAt("SCH:PlacerAppointmentID.EntityIdentifier") 


 $$$TRACE("PID-18 FIN: "_context.FINNumber)
 if (context.FINNumber'="") {
 
        Set tStatus = $$$OK
	try {
		
		// Create the target
		Set context.ApptInfoRequest = ##class(EnsLib.HTTP.GenericMessage).%New()
	Set tStream = ""
	Set tStream = ##class(%Stream.GlobalCharacter).%New()
	
	Do tStream.Write("{"_$CHAR(34)_"ATT_JSON"_$CHAR(34)_":{"_$CHAR(34)_"fin"_$CHAR(34)_":"_$CHAR(34)_context.FINNumber_$CHAR(34)_","_$CHAR(34)_"appt_id"_$CHAR(34)_":"_$CHAR(34)_context.AppointmentID_$CHAR(34)_"}}")
	Do tStream.Rewind()

		Do context.ApptInfoRequest.HTTPHeaders.SetAt("application/json","content-type")
		Do context.ApptInfoRequest.HTTPHeaders.SetAt(tStream.Size,"content-length")
		Set context.ApptInfoRequest.Stream = ##class(%Stream.GlobalBinary).%New()
		Set tStatus = context.ApptInfoRequest.Stream.CopyFrom(tStream)

		
		// Trace some data
		Do tStream.Rewind()
		Set tStr = tStream.Read()
		$$$TRACE("Data string: " _ tStr)
 
	} catch(eException){
		Set tStatus = eException.AsStatus()
	}
	
     }
 else {
  $$$TRACE("FIN is null...")
 }]]]]><![CDATA[>
