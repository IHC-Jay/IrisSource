<code name='Call Appointment REST Service' xpos='470' ypos='1100' >
<![CDATA[ 
  $$$TRACE("Call REST Operation")
      set statusCode=""
      set statusDesc=""
  if (context.FINNumber '="") 
  {
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync(context.ApptInfoServiceTargetConfigName,context.ApptInfoRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set statusLine=""
      set context.ApptInfoResponse =httpRESTResponse
      set statusLine=context.ApptInfoResponse.HTTPHeaders.GetAt("StatusLine")
      if (statusLine'=""){
	set statusCode=$piece(statusLine," ",2)
	set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
		  // If status code is 200 the check the reponse to see if it got processed correctly or not
      if (statusCode'="200")
      {
      
        if (statusCode ="400")
        {
           set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName, "Error Code 400.Invalid Request ")
        }
        elseif(statusCode ="404")
        {
          set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Error Code 404.Not able to find REST service ")
        }
        elseif(statusCode ="500")
        {
          set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Error Code 500.Internal Server Error")
        }
        else
        {
          set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"REST service response with code: "_statusCode_"  Desc: "_statusDesc)
        } 
      }
      else {
        Set tcharStream = ##class(%GlobalCharacterStream).%New()
        Set tStatus = tcharStream.CopyFrom(context.ApptInfoResponse.Stream)
        set respText =""
        While 'tcharStream.AtEnd {
          Set respText = respText_tcharStream.Read()
        } 
        $$$TRACE("PCP service response: "_respText)
        try{
            set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respText)
            set iter = consumedJSONobj.%GetIterator()
            set Repstatus = consumedJSONobj.%Get("response").%Get("service-status").%Get("status")
            $$$TRACE(" Value of response Status "_Repstatus) 
		
	     
        if Repstatus [ "SUCCESS"{
	        $$$TRACE(" Successful Response from APPT Info Service ")
	       	         
	         set ArraySize = consumedJSONobj.%Get("response").%Get("status-details").%Size()
	         $$$TRACE(" Value of ArraySize "_ArraySize)
	         
	         if ArraySize > 0
	         { 
	                  
	          set context.ApptID = consumedJSONobj.%Get("response").%Get("status-details").%Get("APPT_ID")
	          $$$TRACE(" Value of ApptID  "_context.ApptID )
	          
	          set context.ApptLOC= consumedJSONobj.%Get("response").%Get("status-details").%Get("APPT_LOC")
	          $$$TRACE(" Value of ApptLOC "_context.ApptLOC)
	          
	          set context.ApptTYPE= consumedJSONobj.%Get("response").%Get("status-details").%Get("APPT_TYPE")
	          $$$TRACE(" Value of ApptTYPE "_context.ApptTYPE)
	          
	          set context.ProviderID = consumedJSONobj.%Get("response").%Get("status-details").%Get("PROVIDER_ID")
	          $$$TRACE(" Value of ProviderID  "_context.ProviderID)
	         
	          
	        }else{
	        
	           $$$TRACE("Service returned empty value due to invalid MRN number")
	          
	           set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Service did not return Appointment info for FIN: "_context.FINNumber_". Skipping the record.")
	        }
    }
    else {
    
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Service returned Error. Skipping the record.")
    }
    }catch(exVar){
	     $$$TRACE("inside Catch Block")
