    if ($$$ISOK(tStatus)){        
        set context.performingLabTelcorFac=1
     }
     $$$TRACE("context.performingLabTelcorFac:"_+context.performingLabTelcorFac)
     
     // Send to Iseries for Institution Bill
     if (""'= context.patientFacID && (context.patientFacID '= context.performingLabID) && 'context.performingLabTelcorFac){
