<code name='4. Lookup Target Operation' xpos='470' ypos='700' >
<![CDATA[   
   //Check the PID-18.1 to determine the route to the target operation (Cerner or iSeries/ARM)
   //set context.pid181 = ""
   set context.targetOperation= ""
  
   set context.pid181 = request.GetValueAt("PID:18.1")
   $$$TRACE("4.  context.pid181 value:  " _context.pid181)
   //If PID-18.1 has more than than 9 characters, route to the Cerner outbound operation
   if (context.pid181'="")
   {
       if ($LENGTH(context.pid181) > 9)
       {
           set context.targetOperation="Arup-Billing-Hl7_Cern"
           $$$TRACE("4.1  context.targetOperation for Cerner:  " _context.targetOperation)
       }
       else
       {
           set context.targetOperation = "Out-Arup-Billing-BRIDGE-Ens-TO-EgBilling-ISERIES"
           $$$TRACE("4.2  context.targetOperation for iSeria/AORLL:  " _context.targetOperation)
       }
   }
   else
   {
       $$$TRACE("4.3 The PID-18.1 account number is Null or empty. Skip the record with invalid data.")
       set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The PID-18.1 account number is Null or empty. Skip the record with invalid data.") 
   }]]]]><![CDATA[>
