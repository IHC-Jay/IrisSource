<Data><![CDATA[
<process language='objectscript' request='Ens.Request' response='Ens.Response' height='2000' width='2000' >
<context>
<property name='pid181' type='%String' initialexpression='""' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='targetConfigNm' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='targetOperation' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
</context>
<sequence xend='200' yend='1550' >
<scope xpos='200' ypos='250' xend='200' yend='1450' >
<trace name='1. Incoming Message' value=' "1. Incoming Message:: "_request.RawContent' xpos='200' ypos='350' >
<annotation><![CDATA[Incoming Record is request.RawContent]]]]><![CDATA[></annotation>
</trace>
<if name='BHS - end of batch Record' condition='request.GetValueAt("MSH:5.1") &apos;= "END"' xpos='200' ypos='450' xend='200' yend='1000' >
<true>
<code name='3. Initialize Portal Settings ' xpos='470' ypos='600' >
<annotation><![CDATA[Check/Initialize for Management Portal Settings]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("3. Initializing Portal Settings...")
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if (($$$ISERR(pstatus)) || (configValue = "")) { 	
 	$$$TRACE("Initialization error, No ReplyCodeActions found.")
 	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),"Initialization error, No ReplyCodeActions found")
 } 
 $$$TRACE("3.1  Initialization complete.")
 set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("3.2  Max Errors: [" _ maxErr_"]")
  
]]]]><![CDATA[>
</code>
<code name='4. Target Config Name' xpos='470' ypos='700' >
<![CDATA[
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
   Set status = $$$ERROR("Initialization error, No TargetConfigNames found")
 }else{
        set context.targetConfigNm = configValue
        $$$TRACE("TargetConfigNames: " _context.targetConfigNm)
 }]]]]><![CDATA[>
</code>
<code name='5. Check PID' xpos='470' ypos='800' >
<![CDATA[  
   set context.pid181 = request.GetValueAt("PID:18.1")
   $$$TRACE("PID-18.1 value:  " _context.pid181)
   
   set pid31 = request.GetValueAt("PID:3.1")
   $$$TRACE("PID-3.1 value:  " _pid31)
   
   if (pid31="" && context.pid181="")
   {
       $$$TRACE("Neither Patient ID in PID-3.1 nor Patient account number in PID-18.1. Error out the record and send it to source system to fix.")
       set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Invaid record with no PID-3.1 and no PID-18.1. Skip and send it to Arup fir fix.") 
   }
   else
   {
    set context.targetOperation = context.targetConfigNm
   }]]]]><![CDATA[>
</code>
<call name='target.callrequest' target='@context.targetOperation' async='1' xpos='470' ypos='900' >
<request type='Ens.Request' >
<assign property="callrequest" value="request" action="set" />
</request>
</call>
</true>
<false>
<code name='2. Suppress the "END" record' xpos='200' ypos='600' >
<![CDATA[  // Skip this batch END record used to be for iSeries/AS400 route. (AIKB-4967 / RITM0150592)       
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError($CLASSNAME(),"Suppress the iSeries batch END record from being sent to Cerner.  Just skip it.") 

]]]]><![CDATA[>
</code>
</false>
</if>
<code name='7. Reset Error Count' xpos='200' ypos='1100' >
<![CDATA[  Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)
]]]]><![CDATA[>
</code>
<trace name='8. After reset errors' value='"After reset errors"' xpos='200' ypos='1200' >
<annotation><![CDATA["After reset errors"]]]]><![CDATA[></annotation>
</trace>
