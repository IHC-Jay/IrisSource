<code name='code for firstname checking' xpos='740' ypos='1650' >
<annotation><![CDATA[validating firstname]]]]><![CDATA[></annotation>
<![CDATA[  set context.firstname=request.firstname
 $$$TRACE("firstnme:"_context.firstname)
 Set context.firstname1=$ZCONVERT((context.firstname),"U")
 $$$TRACE("firstname1:"_context.firstname1)
 Set context.modfirstname=$ZSTRIP(context.firstname1,"*W")
 $$$TRACE("nodified firstname:"_context.modfirstname)
 set lenoffirstname=$L(context.firstname)
 $$$TRACE("lenoffirstname:"_lenoffirstname)
 
  

 set FN=($ZSTRIP(context.firstname,"*P'W",,"^!]'.$+-"))
 Set lenofstripfirstname=$L($ZSTRIP(FN,"*N"))
 $$$TRACE("lenofstripfirstname:"_lenofstripfirstname)

  if ((context.modfirstname="BABY")||(context.modfirstname="NEWBORN")||(context.modfirstname="TEST")||(context.modfirstname="UNBORN")||(context.modfirstname="XTEST")){ 
 set context.ErrorMessageFN="first name is not valid"
 set context.InvalidField="true"
 $$$TRACE("Invalidfield in firstname in trace block:"_context.InvalidField) 
 }
  elseif ($Locate(context.firstname,"^BABY")="1"){
 set context.ErrorMessageFN="first name is invalid"
 set context.InvalidField="true"
 $$$TRACE("Invalidfield in firstname in trace block:"_context.InvalidField)
 }


  elseif context.firstname=""{
 set context.ErrorMessageFN="empty"
 set context.InvalidField="true"
 $$$TRACE("Invalidfield in firstname in trace block:"_context.InvalidField)
 }
 elseif (lenoffirstname '= lenofstripfirstname) {
 set context.ErrorMessageFN="First name contains non alpha dash or apostrophe characters"
 set context.InvalidField="true"
 $$$TRACE("Invalidfield in firstname in trace block lenoffirstname:"_context.InvalidField)
 }

 else{
 }
  
    

 
]]]]><![CDATA[>
