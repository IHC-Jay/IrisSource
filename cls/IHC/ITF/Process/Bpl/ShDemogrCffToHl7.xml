<code name='code for checking middlename lastname and ssn' xpos='740' ypos='1750' >
<annotation><![CDATA[validating firstname,firstname with middlename,middlename,lastname,ssn and dateofbirth]]]]><![CDATA[></annotation>
<![CDATA[ set context.middlename=request.middlename
 $$$TRACE("middlename:"_context.middlename)
 Set context.middlename1=$L(context.middlename)
 $$$TRACE("Length:"_context.middlename1)
 set context.firstname2=$ZSTRIP(context.firstname1,"*W")
 $$$TRACE("firstname2-spaceremoved&capitals:"_context.firstname2)
 set lenofmiddlename=$L(context.middlename)
 $$$TRACE("lenofmiddlename:"_lenofmiddlename)

 //checking middlename contains rather than alphapets,space,^,!,],',.,$,+ and -
 S mn=$ZSTRIP(context.middlename,"*P'W",,"^!]'.$+-")
 S lenofstripmiddlename=$L($ZSTRIP(mn,"*N"))
 $$$TRACE("lenofstripmiddlename:"_lenofstripmiddlename)

 set context.lastname=request.lastname
 $$$TRACE("lastname in trace:"_context.lastname)
 
 set lenoflastname=$L(context.lastname)
 $$$TRACE("lenoflastname:"_lenoflastname)

 //set lenofstriplastname=($L($ZSTRIP(context.lastname,"*P")))
  S b=$ZSTRIP(context.lastname,"*P'W",,"^!]'.$+-")
 S lenofstriplastname=$L($ZSTRIP(b,"*N"))
 $$$TRACE("lenofstriplastname:"_lenofstriplastname)

  
 if context.middlename=""
 {
   if ($L(context.firstname)="1")
   {
    set context.ErrorMessageFN="Firstname is a single char&&Middle name is empty"
    set context.InvalidField="true"
   } 
   elseif((context.firstname2="BOY")||(context.firstname2="BOYA")||(context.firstname2="BOYB")||(context.firstname2="BOYC")||(context.firstname2="GIRL")||(context.firstname2="GITLA")||(context.firstname2="GIRLB")||(context.firstname2="GIRLC"))
   {
    set context.ErrorMessageFN="First name is not valid when Middle Name is Empty"
    set context.InvalidField="true"
   }
 }
 ;|| 
 
 if ($ZSTRIP($ZCVT(context.middlename,"U"),"*W")="TEST")||($ZSTRIP($ZCVT(context.middlename,"U"),"*W")="XTEST"){
  set context.ErrorMessageMN="Invalid middlename"
  set context.InvalidField="true"
  $$$TRACE("Invalidfield in middlename in trace block TEST XTEST sec:"_context.InvalidField)
  }
  elseif(lenofmiddlename '= lenofstripmiddlename){
 set context.ErrorMessageMN="middle name contains non alpha dash or apostrophe characters"
 set context.InvalidField="true"
 $$$TRACE("Invalidfield in middlenamein trace block lenofmiddlename sec:"_context.InvalidField)
 }
 
 
 
 if ($ZSTRIP($ZCVT(context.lastname,"U"),"*W")="TEST")||($ZSTRIP($ZCVT(context.lastname,"U"),"*W")="XTEST"){
 
  set context.ErrorMessageLN="Invalid lastname"
  set context.InvalidField="true"
  $$$TRACE("Invalidfield in lastnamein trace block TEST XTEST sec:"_context.InvalidField)

  }
   elseif context.lastname=""{
   set context.ErrorMessageLN="Invalid empty Last Name"
   set context.InvalidField="true"
   $$$TRACE("Invalidfield in lastname in trace block in empty:"_context.InvalidField)

 }
 elseif lenoflastname '= lenofstriplastname
 {
 set context.ErrorMessageLN="Last Name contains non alpha dash or apostrophe characters"
 set context.InvalidField="true"
 $$$TRACE("Invalidfield in lastname in trace block in empty:"_context.InvalidField)

 }
 set context.ssn=request.ssn
 $$$TRACE("ssn:"_context.ssn)
 
 //checking whether SSN has same digit or not(111111111)
     
  if context.ssn'=""
 {
  
  $$$TRACE("BadSSN vai before ssn checking:"_context.BadSSN)
  set context.ssn=request.ssn
 $$$TRACE("ssn:"_context.ssn)
 
  Set l=$L(context.ssn)
 
		Set Dig=$E(context.ssn)
		FOR K=2:1:l {
		        Set Count=0
			Quit:Dig'=$E(context.ssn,K)
			Set Count=Count+1
			
		}
 $$$TRACE("after checking of SS count valN:"_Count)
 }
 else{
 $$$TRACE("ssn is empty:"_context.ssn)
 }
 
 
    //checking SSN contains numeric values only
  if context.ssn'=""
 {

 		
 set context.matchssn=context.ssn?9N
 $$$TRACE("Matchssn:"_context.matchssn)
 
 if Count '= "0"{
 Set context.BadSSN="true"
 Set context.SkipSSN="true"
 $$$TRACE("BadSSN in ssn checking:"_context.BadSSN)
 $$$TRACE("SkipSSN in ssn checking:"_context.SkipSSN)

 }
 elseif context.matchssn'="1"{
 $$$TRACE("SS# contains anythig other than numbers or leading blanks")
 set context.BadSSN="true"
 $$$TRACE("SSN contains non numeric or leading spaces in BadSSN:"_context.BadSSN)
 }
 elseif (context.ssn<500){
 set context.BadSSN="true"
 $$$TRACE("BadSSN is less than 500:"_context.BadSSN)
 }
 }
 else{
 $$$TRACE("ssn is empty:&&BadSSN is false and skipSSn is false")
 }
 
 set context.birthdatetime=request.birthdatetime
 $$$TRACE("birthdatetime:"_context.birthdatetime)
 Set context.dob=($E(context.birthdatetime,0,8))
 $$$TRACE("context.dob:"_context.dob)
 if (context.dob="" &&(context.ssn=""||context.BadSSN="true")){
 set context.InvalidField="true"
 set context.ErrorMessageSSN="Birthday is empty & SSN is empty or invalid"
 $$$TRACE("context.InvalidField in ssn dob :"_context.InvalidField)
 $$$TRACE("context.ErrorMessage in ssn dob :"_context.ErrorMessageSSN)



 }
 
 
 
 
    

 
 
 
 
 
 
 
 
 
  
    
