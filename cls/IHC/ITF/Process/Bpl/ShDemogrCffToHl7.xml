  Set context.DefaultErrorMessage="\n  ****  Do Not Respond to this Automated message!!!  ****\n\n"   
  $$$TRACE("DefaultErrorMessage code block:"_context.DefaultErrorMessage)                 
 $$$TRACE("Tablename inside code block:"_context.tablename)

 
   
 
 Set context.InvalidField = "false"
 Set context.ErrorMessage = "\n **** Do Not Respond to this Automated message!!! ****\n\n"
 Set context.BadSSN = "false"
 Set context.SkipSSN = "false"
 Set context.blankactioncode="false"



 
 Set context.actioncode=request.actioncode
 $$$TRACE("action code:"_context.actioncode)
 if ((context.actioncode '= "A" ) && (context.actioncode '= "U" )){
 
  set context.InvalidField="true"
  $$$TRACE("InvalidField in actioncodechecking:"_context.InvalidField)
  if (context.actioncode="D"){
     Set context.ErrorMessage="Action code is D(delete)"
     $$$TRACE("ErrorMessage in action code in Delete:"_context.ErrorMessage)

  }
  elseif (context.actioncode=""){
     Set context.ErrorMessage="Action code is empty"
     set context.blankactioncode="true"
     $$$TRACE("ErrorMessage in actioncode in empty:"_context.ErrorMessage)
     $$$TRACE("blankactioncodein actioncodein empty:"_context.blankactioncode)


  }   
  else{
     Set context.ErrorMessage="Invalid Action code "
     $$$TRACE("ErrorMessage in actioncode in actioncode:"_context.ErrorMessage)

  }
 }
