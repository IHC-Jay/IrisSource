<code name='CallLdapOpearaion' xpos='200' ypos='850' >
<![CDATA[ //Call ldap Operation
 set context.ldapRecFound=0
 set strRequest=##class(Ens.StringRequest).%New()
 set strRequest.StringValue=context.ldapSearchStr
 set tSC=process.SendRequestSync(process.TargetConfigNameLdap,strRequest,.ldapResponse)
 if (('tSC)||ldapResponse.ldapReturnValues.Count()=0){
   $$$TRACE("Ldap Search Failed ..."_tSC) 
   If ($$$ISOK(tSC)){
     set context.ldapRecFound=1
   }
   if ($zstrip(request.CurrentLastName,"<>W")=""){
      set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Source data does not provide the current names, skip the message.")
   }   
      
 }else{
     set prvId=""
     set prvId=ldapResponse.ldapReturnValues.GetAt("providerid")
     if (($length(prvId)>0)&&(prvId<65000)){
        set context.licTypeCdUpdate=0
        $$$TRACE("Set licTypeCdUpdate as false as prvID < 65000 ")
     }
     // Initialize the ldap context variables
     set context.Ldapunitnumber = ldapResponse.ldapReturnValues.GetAt("unitnumber")
     set context.Ldapihcempid = ldapResponse.ldapReturnValues.GetAt("ihcempid")
     set context.Ldapproviderid = ldapResponse.ldapReturnValues.GetAt("providerid")
     set context.Ldapsn = ldapResponse.ldapReturnValues.GetAt("sn")
     set context.Ldapgivenname = ldapResponse.ldapReturnValues.GetAt("givenname")
     set context.Ldapmiddlename = ldapResponse.ldapReturnValues.GetAt("middlename")
     set context.Ldaptitle = ldapResponse.ldapReturnValues.GetAt("title")
     $$$TRACE("Ldap Search Successful ")
   } 
