<code name='Validation' xpos='200' ypos='450' >
<annotation><![CDATA[check deploy code - look for reply action code settings]]]]><![CDATA[></annotation>
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }
 
 $$$TRACE("Inside initial Validations..")
  	  
 // If Doctype is blank means it is Invalid XML
 IF (request.DocType=""){
	set errMsg = "Invalid inbound Cactus record. "
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errMsg)       
    quit
 } 	  
 	
 $$$TRACE("Validate Provider ID..")	
 //Check Provider Id
 set context.ProviderID=$zstrip(request.GetValueAt("Provider(1).ProviderDemographicsRecord.id.Value"),"<>W")
 $$$TRACE("Provider ID: "_context.ProviderID)	
 if (($L(context.ProviderID ) = 0) || ($L(context.ProviderID) > 5))
 {
 	set errMsg = "Invalid inbound Cactus record. Corporate Provider ID DemographicsRecord->Id element value is not valid or empty : "_context.ProviderID
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errMsg)       
    quit
    
 }
 elseif ($ISVALIDNUM(context.ProviderID) = 0)
 {
	 set errMsg="Invalid inbound Cactus record.Corporate Provider ID (DemographicsRecord->Id element Value is not numeric:  "_context.ProviderID 
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errMsg)       
     quit	 
 } 
 $$$TRACE("Validate First and Last Name..")	
 // Check first and last names
 set firstName =""
 set lastName = "" 
 set firstName  =  request.GetValueAt("Provider(1).ProviderDemographicsRecord.firstname.Value")  $$$TRACE(" firstName  :  "_firstName) 
 set lastName = request.GetValueAt("Provider(1).ProviderDemographicsRecord.lastname.Value") $$$TRACE(" lastName :  "_lastName)
 
 if (($L(firstName) = 0) || ($L(lastName) = 0))
 {
 	set errorMsg = "Invalid inbound Cactus record. One of the names DemographicsRecord->firstname or lastname element value is missing"
 	set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errorMsg)       
 	quit
 } 
  ]]]]><![CDATA[>
