<code name='ProfLicStateCodeHDDLookUp' xpos='200' ypos='750' >
<![CDATA[  //Professional licenseInfolicenseNo state code
  set stCodeStr=""
  set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
  set k1=""
  $$$TRACE("ProfLicStateCodeHDDLookUp") 
  For {
		Set k1=request.GetNextIndex("Provider(1).ProviderLicensesRecord()",k1,.tSCTrans)
		Quit:k1=""
		Set licId=request.GetValueAt("Provider(1).ProviderLicensesRecord("_(k1)_").license_rtk.ID")
		Set currentRep=$zStrip(request.GetValueAt("Provider(1).ProviderLicensesRecord("_(k1)_").state.Value"),"<>W")
		$$$TRACE("License Rep: "_currentRep)
		If ((licId="NPDBDEAxxx")&&(currentRep'="")) {
		    do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , currentRep, context.assigningAuthorityDomain,context.cactusContext,   context.cStateCode_currentRep)
		    $$$TRACE("Add DEA License ncid lookup 1st: "_context.cStateCode_currentRep)
		    set stCodeStr=stCodeStr_","_currentRep
		}
		else {
			Set statusrtk=request.GetValueAt("Provider(1).ProviderLicensesRecord("_(k1)_").status_rtk")
			Set licencenumber=$zStrip(request.GetValueAt("Provider(1).ProviderLicensesRecord("_(k1)_").licensenumber.Value"),"<>W")
