  If $$$ISERR(tSC)
  {
     $$$LOGERROR( "Could not get Link for "_context.interchangeSenderID _"->"_context.interchangeReceiverID _", " _ context.version _ ", " _ context.mode _", Direction: " _ context.direction _"= " _ errStr)
     set context.errStr = errStr
  }
	     
   
   if ($$$ISOK(tSC))
   {
       $$$TRACE( context.interchangeReceiverID  _ ": Tp Info : " _ lnkInfo _", " _ errStr)
       set lnkId = $PIECE(lnkInfo, ",", 1)
