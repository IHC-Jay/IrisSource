<code name='Get TP information' xpos='470' ypos='1100' >
<![CDATA[  $$$TRACE("Get TP Info ...")
  set context.interchangeReceiverID = $ZSTRIP(context.inXmlDoc.GetValueAt("ISA:InterchangeReceiverID"), "<>W")
