<code name='X12 Store' xpos='740' ypos='1600' >
<![CDATA[ $$$TRACE( "Return ACKs- ISA:" _ context.tpLinkObj.ISAAck _", GS: " _ context.tpLinkObj.GSAck _", ST: " _ context.tpLinkObj.STAck _", SNIP: " _ context.tpLinkObj.SNIP)
 if ( context.tpLinkObj.GSAck [ "ALWAYS")
 {
   set AckFa= context.jsonMessage.ack  
   $$$TRACE( " ---> Send 999 to " _ context.tpLinkObj.Routing)
	                            
   set x12StCon = ##class(Ens.StreamContainer).%New()
   set x12StCon.Stream = ##class(%Stream.GlobalCharacter).%New()
   Do x12StCon.Stream.Write(AckFa)
   set x12StCon.OriginalFilename = context.FileName
   $$$TRACE( "  x12StCon " _ AckFa)
   $$$TRACE( "  x12FA " _ x12StCon)

   Set tSC1=process.SendRequestAsync(process.Output999TargetConfigName, x12StCon)
   $$$TRACE("Sent Ack as stream to Process: " _ process.Output999TargetConfigName_", status: " _ tSC1)
   set transObj = ##class(IHC.ITF.DStruc.TransTrackingRecord).%New()
   Do transObj.x12Message.CopyFrom(x12StCon.Stream)
 
   $$$TRACE( "  tranobj" _ transObj )
 

   if (AckFa [ "0X231A")
   {
     set transObj.TransTrackingMsg = "OUTGOING_999"
     $$$TRACE("TransTracking OUTGOING_999")
   }
   else
   {
     set transObj.TransTrackingMsg = "OUTGOING_TA1"
   }
 
   set transObj.FileName = context.FileName 
 
   set tStatus = process.SendRequestAsync(context.transTrackingTargetConfigName,transObj)
 
   if ('tStatus) {    
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected error sending the X12: " _ context.transTrackingTargetConfigName _ "."_$SYSTEM.Status.GetOneErrorText(tStatus))
   } 
 }
