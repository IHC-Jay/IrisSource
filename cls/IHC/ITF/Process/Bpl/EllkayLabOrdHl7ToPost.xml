<code name='Set Request object ORM' xpos='200' ypos='1000' >
<![CDATA[
 Do request.BuildMap()
 Set FirstObrSegment = request.FindSegment("OBR",.FirstObrIndex)
 $$$TRACE(FirstObrSegment_" Segment Index : "_FirstObrIndex)
 Set SegCnt = request.SegCount
 Set i = FirstObrIndex
 Set Path = ""
 While i<=SegCnt
 {
  Set Path = request.GetSegmentPath(i,.sts)
  Quit:Path=""
  If $Piece(Path,".",*) = "OBR"
  {
	$$$TRACE(i_" OBR Path : "_Path)
	Set context.ObjORMReq = ##class(IHC.ITF.Request.LabOrdHl7ToPost).%New()
	Set context.ObjORMReq.PatientFirstName = request.GetValueAt("PIDgrp.PID:5.2")

	Set context.ObjORMReq.PatientLastName = request.GetValueAt("PIDgrp.PID:5.1")

	Set context.ObjORMReq.PatientMidldleName = request.GetValueAt("PIDgrp.PID:5.3")
	Set dob = request.GetValueAt("PIDgrp.PID:7.1")

	Set context.ObjORMReq.PatientDOB = $Replace($Zdate($ZdateH($Extract(dob,1,8),8),2,,4)," ","-")

	Set context.ObjORMReq.PatientGender = request.GetValueAt("PIDgrp.PID:8")

	Set PID3 = request.GetValueAt("PIDgrp.PID:3(1).1")

	Set PID2 = request.GetValueAt("PIDgrp.PID:2.1")

	Set context.ObjORMReq.PatientId = ""

	//Novo is sending the PatentId in either of the fields and they are optional.logic to set that
	If $ZStrip(PID3,"<>W") = ""
	{
	  If $ZStrip(PID2,"<>W") = ""
	  {
		Set context.ObjORMReq.PatientId = ""
	  }
	  else
	  {
		Set context.ObjORMReq.PatientId = PID2
	  }  
	}
	else
	{
	  Set context.ObjORMReq.PatientId = PID3
	}

	Set context.ObjORMReq.OrderId = request.GetValueAt(Path_":21")
	Set context.ObjORMReq.TestId = request.GetValueAt(Path_":4.1")
	Set OrderDate = request.GetValueAt("MSH:7.1")
	Set context.ObjORMReq.OrderDate = $Replace($Zdate($ZdateH($Extract(OrderDate,1,8),8),2,,4)," ","-")
	Set context.ObjORMReq.PhysicianName = request.GetValueAt(Path_":16.3")_" "_request.GetValueAt(Path_":16.2")
	Set context.ObjORMReq.MessageType = "O01"
	Set context.ObjORMReq.SourceName = "ELLKAY"

	Set ServicedDate = request.GetValueAt(Path_":7.1") 
	//logic to update the serviced date, Service and IsActive flag
	 
	 
	Set context.ObjORMReq.ServicedDate = ""
	If (ServicedDate'="")
	{
	 Set context.ObjORMReq.ServicedDate = $Replace($Zdate($ZdateH($Extract(ServicedDate,1,8),8),2,,4)," ","-")
	  
	 If (($System.SQL.DATEDIFF("dd",$ZDATE($HOROLOG,3),$Zdate($ZdateH($Extract(ServicedDate,1,8),8),3))<=0))
	 {
		$$$TRACE("ServicedDate is less than or equal to current date,ServicedDate value :   "_ServicedDate )
		Set context.ObjORMReq.Serviced = "Y"
		Set context.ObjORMReq.IsActive = "N"
	 }
	 Else
	 {
		$$$TRACE("ServicedDate is greater than current date,ServicedDate value :   "_ServicedDate )
		Set context.ObjORMReq.Serviced = "N"
		Set context.ObjORMReq.IsActive = "Y"	     
	 }	     
	}
	Else
	{
	  $$$TRACE("ServicedDate is empty :   "_ServicedDate )
	  Set context.ObjORMReq.Serviced = "N"
	  Set context.ObjORMReq.IsActive = "Y"	     
	}
	
	//Call the Operation 
	Set status = process.SendRequestAsync(context.targetList.GetAt(1),context.ObjORMReq)
  }
  Set i=i+1
 }
 ]]]]><![CDATA[>
