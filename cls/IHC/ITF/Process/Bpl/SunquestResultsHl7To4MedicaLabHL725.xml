<Property name="Filter on OBX-9 for Micro">
<Description>
Filter on OBX-9 for Micro: (True = checked) This is used to filter out Micro OBX's with a value of N. 
These are not results LAB wants sent to any end system. The OBX will be skipped but not the rest of the record.</Description>
<Type>%Boolean</Type>
</Property>

<Property name="Match Location">
<Description>
Match Location: (True = checked) Setting to determine if we find the matching location from PV1-3 and send that
when doing ldap lookups. If there is no match then the record isn't sent when match location =true. If Match Location 
= false then we send to all locations returned by changing the location and sending a new result for each location.</Description>
<Type>%Boolean</Type>
</Property>

<Property name="Ldap Search Target">
<Description>
Ldap Search Target: Used to assing the target of Ldap search requests.</Description>
<Type>%String</Type>
<Parameter name="MAXLEN" value="2500"/>
</Property>

<Parameter name="SETTINGS">
<Default><![CDATA[Filter on OBX-9 for Micro:Additional, Match Location:Additional,Ldap Search Target:Additional:selector?multiSelect=1&context={Ens.ContextSearch/ProductionItems?TargetConfigNames=1&productionName=@productionId}]]></Default>
</Parameter>

<Method name="OnGetConnections">
<ClassMethod>1</ClassMethod>
<FormalSpec>*pArray:%String,item:Ens.Config.Item</FormalSpec>
<Implementation><![CDATA[
   #dim locArray As array Of %String;
   set tValue=""
   Set (tValue,tIndex)=""
   For {
      Set tIndex = item.Settings.Next(tIndex)
      Quit:tIndex=""
      Set tSetting = item.Settings.GetAt(tIndex)
      If (tSetting.Name["Ldap Search Target") || (tSetting.Name["TargetConfigNames"){    
         if (tValue '= "")
         {
            set tValue = tValue _ "," _ tSetting.Value
         } Else{
            Set tValue=tSetting.Value
         }
      }
   }
  
   For i=1:1:$L(tValue,",") {
     Set tOne=$P(tValue,",",i)
     Continue:""=tOne
     Set pArray(tOne)=""
   }
]]></Implementation>
</Method>

