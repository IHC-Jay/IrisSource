<code name='Setup filtering' xpos='470' ypos='1000' >
<![CDATA[ set pv12 = request.GetValueAt("PIDgrpgrp(1).PIDgrp.PV1grp.PV1:PatientClass")
 
 $$$TRACE("pv12 value : "_pv12)
 
 set pv12Status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestResultsHl7To4MedicaLabHL725.Lookup.Pv12Filter",pv12,.pv12Val)
 $$$TRACE("PV1-2 lookup value: "_pv12Val_". PV1-2 Lookup Status: "_pv12Status)
 if (($$$ISOK(pv12Status)) && (pv12Val '="Unknown")) {
    $$$TRACE("Passed PV1-2 check")
    
    //Get OBR-4
    if (request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceIdentifier.NameofAlternateCodingSystem") = "L" )
 {
   set obr4 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceIdentifier.AlternateIdentifier")
 }
 else
 {
 set obr4 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceIdentifier.Identifier")
 }
    
    //set obr4 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceIdentifier.Identifier")
    $$$TRACE("OBR-4: "_obr4)
    if (obr4 '="") {
       set obr4Status = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestResultsHl7To4MedicaLabHL725.Lookup.Obr4Filter",obr4,.obr4Val)
       $$$TRACE("OBR-4 lookup value: "_obr4Val_". OBR-4 Lookup Status: "_obr4Status)
       if (obr4Val ="Unknown") {
          $$$TRACE("Passed OBR4 check")
          set context.Room = $ZCONVERT(request.GetValueAt("PIDgrpgrp(1).PIDgrp.PV1grp.PV1:AssignedPatientLocation.PointofCare"),"U")
          set context.ProviderID= request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).ORC:OrderingProvider().IDNumber")
          set roomStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestResultsHl7To4MedicaLabHL725.Lookup.RoomFilter",context.Room,.roomVal)
          $$$TRACE("Provider ID: "_context.ProviderID)
          if ((roomVal '="Unknown") && (context.ProviderID '="")) {
             $$$TRACE("Passed PV1-3.1 room check")
             set context.Facility = request.GetValueAt("MSH:SendingFacility")
             set context.MessageType= request.GetValueAt("MSH:MessageType.MessageCode")
             set context.ProcessRecord = 1
             set context.RoomFound = 1
             set obx9FilterStatus = ##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Filter on OBX-9 for Micro", .obx9Filter)
             if ($$$ISOK(obx9FilterStatus)) {
                if (obx9Filter) {
                   set context.SkipObx9 = 1
                }else {
                   set context.SkipObx9 = 0
                }
                if (context.Facility ="652") {
                   set context.Facility ="153"
                }
             }
          }elseif (context.ProviderID '="") {
             $$$TRACE("In ProviderID check")
             // Call Ldapsearch
             set ldapRequest=##class(Ens.StringRequest).%New()
             set ldapResponse=""
             set ldapRequest.StringValue=context.ProviderID
             set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Ldap Search Target",.ldapConfigValue)
             if ( ($$$ISERR(pstatus)) || (ldapConfigValue = "") ) {
                set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Unable to determine Ldap Search Target, shutting down")
             }else{
                $$$TRACE("Ldap Search Target: " _ldapConfigValue )
                set ldapTarget = ldapConfigValue
                set tStatus=process.SendRequestSync(ldapTarget,ldapRequest,.ldapResponse)
                if ('tStatus) {
                   set status= ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to communicate properly with Ldap, shutting down") 
                }else {
                   if (ldapResponse.StringValue '="") {
                      set locationStatus = ##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Match Location", .matchLocation)
                      if ($$$ISOK(locationStatus)) {
                         set context.MatchLdapLocationWithPV1 = matchLocation
                         set context.Facility = request.GetValueAt("MSH:SendingFacility")
                         set context.MessageType= request.GetValueAt("MSH:MessageType.MessageCode")
                         For iTarget=1:1:$L(ldapResponse.StringValue,",") { 
                            Set tOneTarget=$ZStrip($P(ldapResponse.StringValue,",",iTarget),"<>W")  
                            Continue:""=tOneTarget
            
                            do context.ProvidersLdapLocations.Insert(tOneTarget)
                            $$$TRACE("Provider location(s): " _ tOneTarget)
                         }
                         set context.ProcessRecord = 1
                         set obx9FilterStatus = ##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Filter on OBX-9 for Micro", .obx9Filter)
                         if ($$$ISOK(obx9FilterStatus)) {
                            if (obx9Filter) {
                               set context.SkipObx9 = 1
                            }else {
                               set context.SkipObx9 = 0
                            }
                         }
                         if (context.Facility ="652") {
                            set context.Facility ="153"
                         }
                      }else {
                         set status= ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Unable to determine Match Location setting, shutting down") 
                      }
                   }else {
                   set context.SkipReason= " PV1-3.1 value "_context.Room_" is not accepted and LDAP Search returned Empty" 
                  }
                } 
             }
          }else {
          set context.SkipReason= " PV1-3.1 value "_context.Room_" is not accepted and ProviderID (ORC-12.1) is Empty " 
       }
       }else {
       set context.SkipReason= " OBR-4 value "_obr4_" is not accepted" 
    }
    }else {
       set status= ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to determine OBR-4 value, skipping record") 
    }
 }else {
       set context.SkipReason= " PatientClass(PV1-2) value "_pv12_" is not accepted"
 }
 $$$TRACE("Done with filter check")
 
]]]]><![CDATA[>
