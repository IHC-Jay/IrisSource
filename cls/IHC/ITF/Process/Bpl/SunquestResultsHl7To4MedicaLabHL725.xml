<code name='Setup room and location map' xpos='740' ypos='1250' >
<![CDATA[ set ldapLocationCount = $LENGTH(context.ProvidersLdapLocations)
 $$$TRACE("In location mapping. Provider ID: "_context.ProviderID_". Match location: "_context.MatchLdapLocationWithPV1_". Room found: "_context.RoomFound)
 if ((context.UnknownProviderID=context.ProviderID) || (context.MatchLdapLocationWithPV1)) {
