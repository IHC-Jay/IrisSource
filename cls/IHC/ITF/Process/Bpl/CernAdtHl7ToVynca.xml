<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
</context>
<sequence xend='200' yend='2050' >
<scope xpos='200' ypos='250' xend='200' yend='1950' >
<trace name='In BPL' value='"***In BPL: " _ $CLASSNAME() _ ", Process: " _ process.%ConfigName' xpos='200' ypos='350' />
<code name='Check ReplyCodeActions' xpos='200' ypos='450' >
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }
 	  ]]]]><![CDATA[>
</code>
<code name='MaxError &amp; Target Configs' xpos='200' ypos='550' >
<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)
 

 //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
   Set status = $$$ERROR("Initialization error, No TargetConfigNames found")
 }else{
      $$$TRACE("TargetConfigNames: " _configValue )
 }
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
    $$$TRACE("TargetConfigNames: " _context.targetList)
    $$$TRACE("Count: " _ context.targetList.Count())
 
 

 	  ]]]]><![CDATA[>
</code>
<code name='ValidateMessage' xpos='200' ypos='650' >
<![CDATA[ set validationSettingValue=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 set tempStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSettingValue)
 if (tempStatus'=$$$OK){
    set context.ValidationPassed=0    
    }]]]]><![CDATA[>
</code>
<code name='Event Type Lookup Tables' xpos='200' ypos='750' >
<![CDATA[
  set retVal = ##class(Ens.Util.LookupTable).%ExistsTable("IHC.ITF.Process.Bpl.CernAdtHl7ToVynca.Lookup.NotAllowedEventTypes")
  if (retVal = 0){
	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),"Lookup table IHC.ITF.Process.Bpl.CernAdtHl7ToVynca.Lookup.NotAllowedEventTypes not exists")  
  }

]]]]><![CDATA[>
</code>
<code name='Allowed Event Types Lookup' xpos='200' ypos='850' >
<![CDATA[
 set context.eventType = request.GetValueAt("MSH:MessageType.triggerevent")  
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToVynca.Lookup.NotAllowedEventTypes", context.eventType, .retVal )
 $$$TRACE("context.eventType:[" _ context.eventType _"]. Return Value: ["_retVal _"]") 
 if (retVal ="1") { 
 	  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid EventType:["_context.eventType_"]. Skipping the record." )     
     
 }else{ 
 }
]]]]><![CDATA[>
</code>
<code name='Help1 data check' xpos='200' ypos='950' >
<![CDATA[ $$$TRACE("Filter for A30, A31, and A34 merge messages only from Help1 with MSH-10 all numeric.")  
 set msh10 = request.GetValueAt("MSH:10")
 
 if ($ISVALIDNUM(msh10)=1)
 { 
     if ((context.eventType ="A30") || (context.eventType ="A31")|| (context.eventType ="A34"))
     {  
     
         $$$TRACE("This is a valid record from Help1 with context.eventType:[" _context.eventType_"] and context.facility:[" _context.facility_ "] and MSH-10 all in digit:[" _msh10_ "].")
     }
     else
     {
     	  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid EventType:["_context.eventType_"]. Skipping the record." )  
     
     }    
 }
 else
 {  	 
 }    

]]]]><![CDATA[>
</code>
<if name='Check If Message Is Valid' condition='context.ValidationPassed' xpos='200' ypos='1050' xend='200' yend='1700' >
<true>
<trace name='Message Validation Passed' value='"Message Validation Passed"' xpos='470' ypos='1200' />
<transform name='Transform' class='IHC.ITF.Transform.Dtl.CernAdtHl7ToVynca' source='request' target='response' xpos='470' ypos='1300' />
<foreach name='SendToEachTargetconfir' property='context.targetList' key='context.targetConfigIndex' xpos='470' ypos='1400' xend='200' yend='350' >
<call name='CallTargetConfigNames' target='@context.targetList.GetAt(context.targetConfigIndex)' async='1' xpos='200' ypos='250' >
<request type='Ens.Request' >
<assign property="callrequest" value="response" action="set" />
</request>
</call>
</foreach>
<trace name='RecordSent' value='"Record Sent !!!!... "' xpos='470' ypos='1500' />
<code name='ResetError' xpos='470' ypos='1600' >
<![CDATA[  
    Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)
]]]]><![CDATA[>
</code>
</true>
<false>
<trace name='Message Validation Failed' value='"Message Validation Failed"' xpos='200' ypos='1200' />
<code name='Skip if validation failed' xpos='200' ypos='1300' >
<![CDATA[   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Hl7 message validation failed, Skipping the record.") ]]]]><![CDATA[>
</code>
</false>
</if>
<faulthandlers>
<catchall xpos='200' ypos='1800' xend='200' yend='350' >
<code name='Call ProcessError' xpos='200' ypos='250' >
<annotation><![CDATA[Call error handler method]]]]><![CDATA[></annotation>
<![CDATA[ Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).ProcessError(..%Context.%LastError)
]]]]><![CDATA[>
</code>
</catchall>
</faulthandlers>
</scope>
</sequence>
</process>
]]></Data>
