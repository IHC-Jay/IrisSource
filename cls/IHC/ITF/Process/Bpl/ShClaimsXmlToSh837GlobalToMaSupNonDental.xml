     set tRequest = ##class(Ens.StreamContainer).%New("")	 
	 Set tStream=##Class(%Library.GlobalCharacterStream).%New()
	 Set pStatus = response.OutputToLibraryStream(tStream)
     set tRequest.Stream = tStream	 
	 set dt = $REPLACE($E($ZDATETIME($H,3,5),1,19),":","")
 	 set reqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream) 	  	 
 	 if (context.planType="HMO"){
	 	set reqObj.DestinationFileName = "HMOClaimsNonDental."_dt_"."_context.batchCountIndex_"of"_request.profBatchCounts_".TXT"
 	 	set context.destinationFileName="HMOClaimsNonDental."_dt_"."_context.batchCountIndex_"of"_request.profBatchCounts_".TXT"
	 	set reqObj.DestinationFilePath = context.destinationFilePath_"MASuppDentalHMO"
 	 	set context.targetConfig = context.outputTargetConfigName
 	 }elseif(context.planType="PPO"){
	 	set reqObj.DestinationFileName = "PPOClaimsDental."_dt_"."_context.batchCountIndex_"of"_request.profBatchCounts_".TXT"
	 	set context.destinationFileName="PPOClaimsDental."_dt_"."_context.batchCountIndex_"of"_request.profBatchCounts_".TXT"
	 	set reqObj.DestinationFilePath = context.destinationFilePath_"MASuppDentalPPO"
 	 	set context.targetConfig = context.outputTargetConfigName
	 }
	  $$$TRACE(	 " context.targetConfig : "_context.targetConfig)
	  set tStatus = process.SendRequestAsync(context.targetConfig,reqObj)	  
	  $$$TRACE(" File sent status: "_tStatus)
 	 if ('tStatus) {
	 	 set context.stProcReq.pJobStatus = "15"  		  
	 	 set errText = $System.Status.GetOneStatusText(..%Context.%LastError)	    	
	 	 set returnDesc = "Unable to write X12 files to the file system.."_context.destinationFileName_" "_errText
	 	 $$$TRACE(returnDesc)
	 	 set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcStsSetMaSup).createAndSendResponse("4",returnDesc,request.pScheduleId, request.pDestinationResponseFile,.process)    	 	 
      }else{
	     //X12 file sent to file sucessfully
	      set context.stProcReq.pJobStatus = "14"  		     		   
	  }	 
 	 $$$TRACE("After sending to file..."_reqObj.DestinationFileName )
]]]]><![CDATA[>
</code>
<code name='Call ShspMaSupJobStatusUpdate' xpos='200' ypos='750' >
<![CDATA[ 
	$$$TRACE(" Before SHSP_MaSup_JOB_STS_UPD call...")
	try{
		set context.stProcReq.pFileGuid = request.profGuid
      	set context.stProcReq.pBatchNumber = context.batchCountIndex
