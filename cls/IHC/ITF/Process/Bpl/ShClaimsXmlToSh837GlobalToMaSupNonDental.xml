        set context.stProcReq.pControlNum = context.pControlNum
        
    	set tstatus=process.SendRequestSync(context.updateJobTargetConfigName,context.stProcReq,.dbResponse)
    	set tstatus = $$$OK
    	$$$TRACE(" After SHSP_MaSup_JOB_STS_UPD call-status : "_tstatus)
    	if (tstatus'=$$$OK){
	    	$$$TRACE("$$$Inside  catch(tstatus NOT OK)....")
	    	set errText = $System.Status.GetOneStatusText(..%Context.%LastError)	    	
			set retDesc = "Error while calling the SP -- SHSP_MASUP_JOB_STS_UPD, Failed to update the claim status. BatchCount: ["_context.batchCountIndex_"]. "_errText	
			set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcStsSetMaSup).createAndSendResponse("8",retDesc,request.pScheduleId, request.pDestinationResponseFile,.process)    	 	 			
			set context.errMsg = context.errMsg_ " Batch Index: "_ context.batchCountIndex_" failed."
			set context.numErrBatchCounts =  context.numErrBatchCounts +1
    	}else{
	    	set context.numSuccessBatchCounts =  context.numSuccessBatchCounts +1
   			$$$TRACE(" Batch count ["_context.batchCountIndex_"] successful.")    		 		  	
    	}
	}catch(ex){
		$$$TRACE("$$$Inside update status catch....")	
		set errText = $System.Status.GetOneStatusText(..%Context.%LastError)	
		set retDesc = "Error while calling the SP -- SHSP_MASUP_JOB_STS_UPD, Failed to update the claim status. BatchCount: ["_context.batchCountIndex_"]"_errText	
		set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcStsSetMaSup).createAndSendResponse("8",retDesc,request.pScheduleId, request.pDestinationResponseFile,.process)    	 	 			  
	}  	
]]]]><![CDATA[>
