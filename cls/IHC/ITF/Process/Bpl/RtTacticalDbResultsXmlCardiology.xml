<Class name="IHC.ITF.Process.Bpl.RtTacticalDbResultsXmlCardiology">
<Description>
Routes the records to GeRis or iCentra results</Description>
<Super>IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL</Super>
<TimeCreated>64096,40961.909099</TimeCreated>

<XData name="BPL">
<Description>
BPL Definition</Description>
<XMLNamespace>http://www.intersystems.com/bpl</XMLNamespace>
<Data><![CDATA[
<process language='objectscript' request='Ens.Request' response='Ens.Response' height='2000' width='2000' >
<context>
<property name='errorStatus' type='%Status' initialexpression='$$$OK' instantiate='0' >
</property>
<property name='targetConfigIndex' type='%Integer' instantiate='0' >
</property>
<property name='targetList' type='%String' collection='list' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='ValidationPassed' type='%Boolean' initialexpression='1' instantiate='0' >
</property>

<property name='SqlSnapShot' type='EnsLib.SQL.Snapshot' instantiate='0' >
</property>

<property name='CernerTargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>

<property name='GeRisTargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>


</context>
<sequence xend='200' yend='1450' >
<scope xpos='200' ypos='250' xend='200' yend='1350' >
<trace name='InBPL' value=' "In BPL "' xpos='200' ypos='550' >
<annotation><![CDATA[Inside BPL]]]]><![CDATA[></annotation>
</trace>

<code name='Check ReplyCodeActions' xpos='200' ypos='450' >
<annotation><![CDATA[From settings tab]]]]><![CDATA[></annotation>
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }
 	  ]]]]><![CDATA[>
</code>
<code name='Trace MaxError and get Target Config Names' xpos='200' ypos='550' >
<annotation><![CDATA[Trace MaxError and get Target Config Names]]]]><![CDATA[></annotation>
<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)
 

   //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
   Set status = $$$ERROR("Initialization error, No TargetConfigNames found")
 }else{
      $$$TRACE("TargetConfigNames: " _configValue )
 }
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
    $$$TRACE("TargetConfigNames: " _context.targetList)
    $$$TRACE("Count: " _ context.targetList.Count())
 
 	  ]]]]><![CDATA[>
</code>

<code name='initializeTargets' xpos='470' ypos='1200' >
<![CDATA[ 
 set context.CernerTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","CernerTargetConfigName",.pstatus)
 if ($$$ISOK(pstatus)){
 	$$$TRACE("CernerTargetConfigName: " _ context.CernerTargetConfigName)
 }else{
	 Set status = $$$ERROR("Initialization error, No CernerTargetConfigName found")
 }
 
 set context.GeRisTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","GeRisTargetConfigName",.pstatus)
 if ($$$ISOK(pstatus)){
 	$$$TRACE("GeRisTargetConfigName: " _ context.GeRisTargetConfigName)
 }else{
	 Set status = $$$ERROR("Initialization error, No GeRisTargetConfigName: found")
 }
 
   ]]]]><![CDATA[>
</code>


<code name='Call Database Operation' xpos='200' ypos='750' >
<![CDATA[  
  $$$TRACE("Before Calling Database Operation")
  set tStatus=process.SendRequestSync(process.TargetConfigNames,request,.SqlResponse)
 if ($$$ISOK(tStatus)){
   set context.SqlSnapShot = SqlResponse
   set rowCount = context.SqlSnapShot.RowCount
   $$$TRACE(" Row Count: "_rowCount)   
 }
 $$$TRACE("After Calling Database Operation.."_tStatus)
 ]]]]><![CDATA[>
</code>

<while name='Loop through the Row' condition='context.SqlSnapShot.%Next()' xpos='200' ypos='950' xend='200' yend='950' >
  <trace name='AcctNum' value='context.SqlSnapShot.Get("ACCT_NO")' xpos='200' ypos='250' />  
  <trace name='empiNumber' value='request.Get("EMPI")' xpos='200' ypos='250' />
  <trace name='accessionNo' value='request.Get("ACCESSION_NO")' xpos='200' ypos='250' />
 <trace name='cardioResultId' value='request.Get("CARDIO_RESULT_ID")' xpos='200' ypos='250' />

  <code name='ValidateEmpiNUmber' xpos='200' ypos='750' >
<![CDATA[  
       	if (empiNumber = ""){
	       	set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "EmpiNumber is empty. Skipping the record. CardioResultId: ["_cardioResultId_"] AccessionNumber: ["_accessionNo_"]")  	
       	}
 ]]]]><![CDATA[>
</code>
  
  <if name='AccountNumber' condition='$LENGTH(context.SqlSnapShot.Get("ACCT_NO")) &gt; "9"' xpos='200' ypos='1450' xend='200' yend='2250' >
<true>  
  <call name='CallTargetConfigNames' target='@context.CernerTargetConfigName' async='1' xpos='200' ypos='250' >
<request type='Ens.Request' >
<assign property="callrequest" value="context.SqlSnapShot" action="set" />
</request>
<response type='Ens.Response' />
</call>
</true>
<false>
     <call name='CallTargetConfigNames' target='@context.GeRisTargetConfigName' async='1' xpos='200' ypos='250' >
<request type='Ens.Request' >
<assign property="callrequest" value="context.SqlSnapShot" action="set" />
</request>
<response type='Ens.Response' />
</call>
</false>
</if>

</while>

<faulthandlers>
<catchall xpos='200' ypos='1200' xend='200' yend='350' >
<code name='Call ProcessError' xpos='200' ypos='250' >
<annotation><![CDATA[Call error handler method]]]]><![CDATA[></annotation>
<![CDATA[ Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).ProcessError(..%Context.%LastError)
]]]]><![CDATA[>
</code>
</catchall>
</faulthandlers>
</scope>
</sequence>
</process>
]]></Data>
</XData>

