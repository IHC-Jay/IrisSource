<code name='Get Data file record count' xpos='200' ypos='1250' >
<![CDATA[ 
 //Code to get Data file count
 Set i =0
 Do request.Stream.Rewind()
 $$$TRACE(request.Stream.AtEnd_"request.Stream.AtEnd  before while _ "_i)
 
 While 'request.Stream.AtEnd
 {
  Set line = request.Stream.ReadLine()
  Set i = i+1
  //$$$TRACE(request.Stream.AtEnd_"request.Stream.AtEnd inside while _ "_i)
 }
 Set context.DataFileCnt = i
 $$$TRACE(request.Stream.AtEnd_"request.Stream.AtEnd after while _ "_i)]]]]><![CDATA[>
