</request>
<response type='Ens.Response' />
</call>
<trace name='SuccessEmail' value='context.filePath_context.encryptedFileName_"Generate Successful File Creation Email "_##class(%File).Exists(context.filePath_context.encryptedFileName)' xpos='200' ypos='2000' />
<code name='GenerateSuccessEmail' xpos='200' ypos='2100' >
<![CDATA[  
    set emailAlertRequest=##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnSuccess(context.successEmailSubject,context.successEmailText,context.configName)
 do process.SendAlert(emailAlertRequest)
]]]]><![CDATA[>
</code>
<code name='CreateteStreamforFileOperation' xpos='200' ypos='2200' >
<![CDATA[ // Create Stream
 set encryptedFileName=context.filePath_context.encryptedFileName
 if (##class(%File).Exists(encryptedFileName)=0){
     set status=$$$ERROR($$$GeneralError,"encrypted file does not exists")
 }
 
 Set streamFile=##class(%FileCharacterStream).%New()
 Do streamFile.LinkToFile(encryptedFileName)

 set stream=##class(%Stream.GlobalCharacter).%New()
 Set status = stream.CopyFromAndSave(streamFile)
 set context.fileRequest=##class(Ens.StreamContainer).%New(stream)
 set context.fileRequest.OriginalFilename = encryptedFileName
 
 ]]]]><![CDATA[>
</code>
