<code name='RetrieveTargetConfigNames' xpos='200' ypos='550' >
<![CDATA[  // Get Operation Name for calling the file Decryption
  set configValue=""
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNamesEncryption",.configValue)
  if ($$$ISERR(pstatus))
 {
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Initialization error, No TargetConfigNamesEncryption found") 
   
 }
  set context.TargetConfigNamesEncryption=configValue

  // Get File Operation Name  
  set configValue=""
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)
  if ($$$ISERR(pstatus))
 {
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Initialization error, No TargetConfigNames found") 
   
 }
  set context.targetConfigNames=configValue
  
  
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"FileFolder",.configValue)
 if ($$$ISERR(pstatus))
 {
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Initialization error, FileFolder setting not found to place the encrypted file ") 
   
 }
]]]]><![CDATA[>
