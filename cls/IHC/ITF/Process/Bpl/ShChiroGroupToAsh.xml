<code name='Get Trg file record count' xpos='200' ypos='1050' >
<![CDATA[ 
 //Code to get Trigger file count
 Set TrgFileTimestampPart1 = $P(context.fileName,".DAT",1)
 Set TrgFileTimestampPart2 = $P(context.fileName,".DAT",2)
 Set GrpFilePath = $P(context.OriginalFilename ,"/",1,$Length(context.OriginalFilename ,"/")-1)
 Set GrpTrgFile = TrgFileTimestampPart1_".DAT.TRG"_TrgFileTimestampPart2 
 $$$TRACE("Constructed Trg file from data file timestamp"_GrpTrgFile )
 Set TrgFile = GrpFilePath_"/"_GrpTrgFile
 $$$TRACE("Trg file after Zsearch"_TrgFile )
 Set bExists = ##class(%File).Exists(TrgFile)
 If bExists
 {
  Set TrgFileObj=##class(%File).%New(TrgFile)
  Do TrgFileObj.Open("RS")
  Set context.TrgFileCnt = TrgFileObj.ReadLine()

 }
 Else
 {
  $$$TRACE("Unable to find trigger file "_TrgFile)
  set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Unable to find the Trigger file : "_TrgFile) }]]]]><![CDATA[>
