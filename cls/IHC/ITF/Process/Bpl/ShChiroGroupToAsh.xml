<assign name="RetrieveFileName" property="context.fileName" value="request.OriginalFilename" action="set" xpos='200' ypos='650' />
<code name='RetrieveSettingsForFileNaming' xpos='200' ypos='750' >
<![CDATA[  // Retrieve the folder path for decrypting file and the Path
  set configValue=""
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"FileFolder",.configValue)
  set context.filePath=configValue
  set status=##class(IHC.ITF.ITFCOMMON.Utility).CreateDirectory(context.filePath)
  $$$TRACE(context.filePath_" Status of Create diretory from filepath "_status)
  set context.filePath=##class(Ens.Util.File).fixPath(context.filePath)

 
    // Get filename to be used for creating encrypted file
  set configValue=""
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"EncryptedFileName",.configValue)
  set context.encryptedFileName=##class(Ens.Util.File).CreateTimestamp("",configValue)
  
  $$$TRACE("Incoming request obj "_request)
  
  Set context.OriginalFilename = context.fileName 
  
  //Extract filename alone from context variable
  Set context.fileName = $P(context.fileName,"/",$Length(context.fileName,"/"))
  $$$TRACE("extracted file name _ "_context.fileName)
  
  //Create a file in the provided filepath from incoming stream
  Set obj = ##class(%Stream.FileCharacter).%New()
  Set obj.Filename = $ZStrip(context.filePath,">P")_"/"_context.fileName
  Set sts = obj.CopyFromAndSave(request.Stream)
  $$$TRACE("obj.CopyFromAndSave(request.Stream) status "_sts)]]]]><![CDATA[>
</code>
