<code name='Send X12' xpos='200' ypos='550' >
<![CDATA[  // Send the X12 to next components

  if ($IsObject(context.x12Rec))
  {
	  set stCon = ##class(Ens.StreamContainer).%New()
	  set stCon.Stream = ##class(%Stream.FileCharacter).%New()
	  
	  Set stCon.Stream = context.x12Rec.X12stream
	  set route = context.x12Rec.Route
	  if (route = "")
	  {
		 set route = "UnknownRoute"
		 $$$LOGERROR( " -*- Route not found for " _ context.x12Rec.ReceiverId)
	  }
	  
	  set stCon.OutputFilename = context.x12Rec.IsaUniqId _ "-" _ route _ "-" _ $ZDATETIME($HOROLOG,8, 1) _ ".txt"
	  set stCon.OriginalFilename = stCon.OutputFilename
	  set tStatus = $$$OK
	  set route = $ZCONVERT(route, "U")	
	  
	  set operation = ""
	  if (route  = "INTERMOUNTAINHEALTHCARE")
	  {
	     set operation ="Out-Sh-835-File-DNDERA835-IH"    
	  }
	  else
	  {
	      set operation = "Out-Sh-835-Sftp-DNDERA835-" _ route
	  }
	  set tStatus = process.SendRequestAsync(operation, stCon)
	  
	    	  
	  $$$TRACE(stCon.OriginalFilename _ " - Stream size: " _ stCon.Stream.Size _ " sent, Receiver: " _ context.x12Rec.ReceiverId _ ", Route: " _ route _ ", TpLinkId: " _ context.x12Rec.TpLinkId _", tStatus = " _ tStatus) 
	  
	  // Long term storage
	  set tStatus = process.SendRequestAsync("Sh-Remit_835-Store-DNDERA835", stCon)
	  
	  set context.x12Rec.Status = "Sent-" _ context.x12Rec.Status
	  
	  set context.x12Rec.FileName = stCon.OutputFilename
	  set context.x12Rec.ProcessedTime = $ZDATETIME($HOROLOG,3, 1)
	  Do context.x12Rec.%Save()
	  
  }
		
]]]]><![CDATA[>
