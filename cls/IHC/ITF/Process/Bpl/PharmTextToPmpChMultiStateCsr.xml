	}

	$$$TRACE(request.OriginalFilename_" (ID "_request.%Id()_") has been successfully saved to database. Stream OID is "_stream.%Oid()_"; Stream ID is "_stream.%Id()_".")
	set context.response=##class(IHC.ITF.ITFCOMMON.DataStructure.StreamWithFilePath).%New(stream)
	
	set context.response.NewFilePath = $PIECE(request.OriginalFilename, "/",*-1)
	
	set context.response.OriginalFilename = $PIECE(request.OriginalFilename, "/",*)
