<code name='ValidateMessage' xpos='200' ypos='650' >
<![CDATA[ set context.empiNumber=request.GetValueAt("PID:PatientIdentifierList().ID")
 $$$TRACE("EMPI Number: " _ context.empiNumber)  
 
 $$$TRACE("Is a Number(EMPI#) : " _ $ISVALIDNUM(context.empiNumber)) 
