<![CDATA[ set eventType =request.GetValueAt("MSH:9.2")
 if ((eventType ="A34") || (eventType ="A44")) { 
    set context.IsTransplant = "1"
 }else {
    set obxIndex="",tSC=1
    for { 
       Set obxIndex=request.GetNextIndex("OBX()",obxIndex,.tSCTrans)  Quit:obxIndex=""          
       set transplantCode = request.GetValueAt("OBX("_(obxIndex)_"):3.1")
       set transplantType = request.GetValueAt("OBX("_(obxIndex)_"):5(1)")
       if (((transplantCode ="TRANSPLANT") && (transplantType =context.solidOrganTransplantPatient))  || ((transplantCode ="LIVING_DONOR") && (transplantType =context.solidOrganDonorPatient))) {
          $$$TRACE("Record for transplant patient")
          set context.IsTransplant = "1"
       }
    }
 }]]]]><![CDATA[>
