      $$$TRACE( " Gross Sales Amount - Reward Amount:"_context.grossSalesAmt )
      if ( context.grossSalesAmt = 0)
      {
        set context.filterFlag=1
         $$$TRACE(" Filter out this record, this is a Discount/Coupon/Rewards transaction and Gross sales amount is zero")
      }
