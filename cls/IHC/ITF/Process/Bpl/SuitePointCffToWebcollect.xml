<code name='Filter Out transactions' xpos='470' ypos='1800' >
<![CDATA[  $$$TRACE(" value of transaction type :"_context.TransactionType )
  set targetStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SuitePointCffToWebcollect.lookup.FilterOut", context.TransactionType , .retVal )
    if ((retVal = 1)) {       
       $$$TRACE("Filter Out this record based on Lookup up file HC.ITF.Process.Bpl.SuitePointCffToWebcollect.lookup.FilterOut.")
     set context.filterFlag=1
    }
    
    if ( context.firstPaymentType = "Payroll Deduct" )
    {
    set context.filterFlag=1
     $$$TRACE(" Filter Out this record , it is a Payroll dedcuct")
    }
    
    //special case for Coupons , Discounts and Rewards
     set context.grossSalesAmt = request.GROSSSALESAMOUNT
      $$$TRACE(" GROSS AMOUNT :"_request.GROSSSALESAMOUNT )
    
    
    if ( request.DISCOUNTAMOUNT '= 0 )
     {
       $$$TRACE(" DISCOUNT AMOUNT :"_request.DISCOUNTAMOUNT )
      set context.grossSalesAmt = context.grossSalesAmt - request.DISCOUNTAMOUNT
      $$$TRACE( " Gross Sales Amount Discount Case :"_context.grossSalesAmt )
      if ( context.grossSalesAmt = 0)
      {
        set context.filterFlag=1
         $$$TRACE(" Filter out this record, this is a Discount/Coupon/Rewards transaction and Gross sales amount is zero")
      }
    } 
    
    if ( request.COUPONUSEDAMOUNT '= 0 )
    {
      $$$TRACE(" COUPON AMOUNT :"_request.COUPONUSEDAMOUNT )
      set context.grossSalesAmt = context.grossSalesAmt - request.COUPONUSEDAMOUNT
      $$$TRACE( " Gross Sales Amount - Coupons Case:"_context.grossSalesAmt )
      if ( context.grossSalesAmt = 0)
      {
        set context.filterFlag=1
         $$$TRACE(" Filter out this record, this is a Discount/Coupon/Rewards transaction ( everybodys Fav ) and Gross sales amount is zero")
      }
    } 
    
     if ( request.REWARDAMOUNT '= 0 )
