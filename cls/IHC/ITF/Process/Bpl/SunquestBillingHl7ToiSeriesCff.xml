<false>
<code name='Setup Cff Record' xpos='470' ypos='500' >
<annotation><![CDATA[Setup all the context variables for Cff Record]]]]><![CDATA[></annotation>
<![CDATA[  set ft113DeptCode = request.GetValueAt("FT1("_context.ft1count_"):Departmentcode.identifier")
   $$$TRACE("FT1("_context.ft1count_"):Departmentcode.identifier Value : "_ft113DeptCode)
   
   if (ft113DeptCode = "INSTB")
   {
     $$$TRACE("Inside INSTB")
     set context.CffAccountNumber="00000000000"
     set context.CffGuarantorReferenceNumber = request.GetValueAt("PID:PatientAccountNumber.PatientID")
     set context.CffPatientTypeLocation = "U96"
   }
   else
   {
     $$$TRACE("Inside Normal Patient")
     set context.CffAccountNumber = request.GetValueAt("PID:PatientAccountNumber.PatientID")
     set context.CffGuarantorReferenceNumber ="000000000"
   }
   
   ///Get ChargeNumber
   set ft17Transcode = request.GetValueAt("FT1("_context.ft1count_"):Transactioncode")
   if ($LENGTH(ft17Transcode) > 0)
   { 
     if ($LENGTH(ft17Transcode) > 10)
     {
        set context.CffChargeNumber = $EXTRACT(ft17Transcode,1,10)
     }
     else
     {
        set context.CffChargeNumber = ft17Transcode
     }
   }
   
   
   
   ///Set override amount and description
   if ($LENGTH(ft17Transcode) > 0) && ((ft17Transcode = "1803447911") || (ft17Transcode = "1805469998"))
   {
     set ft111TransAmount = request.GetValueAt("FT1("_context.ft1count_"):Transactionamountextended")
     $$$TRACE("FT1("_context.ft1count_"):Transactionamountextended Value : "_ft111TransAmount)
     
     set context.CffOverrideAmount = $REPLACE(ft111TransAmount,".","")
     $$$TRACE("ReplacedAmount : "_$REPLACE(ft111TransAmount,".",""))
     
     set ft18TransDesc = request.GetValueAt("FT1("_context.ft1count_"):Transactiondescription")
     set context.CffOverrideDescription = $EXTRACT(ft18TransDesc,1,35)
   }
   else
   {
     set context.CffOverrideAmount ="000000000"
   }
   
   ///Set Charge Quantity
   set ft110TransQuantity = request.GetValueAt("FT1("_context.ft1count_"):Transactionquantity")
   $$$TRACE("FT1("_context.ft1count_"):Transactionquantity Value : "_ft110TransQuantity)
   
   set context.CffChargeQuantity = ft110TransQuantity
   
   
   ///Set Performing Doctor
   set ft121OrderCode = request.GetValueAt("FT1("_context.ft1count_"):Orderedbycode.IDnumber")
   $$$TRACE("FT1("_context.ft1count_"):Orderedbycode.IDnumber Value : "_ft121OrderCode )
   
   if ($LENGTH(ft121OrderCode) > 0)
   {
      set context.CffPerformingDoctor = $EXTRACT(ft121OrderCode,1,5)
   }
   else
   {
      set context.CffPerformingDoctor = "00000"
   }
   
   
   /// Set Date of Service
   set ft14TransDate = request.GetValueAt("FT1("_context.ft1count_"):Transactiondate")
   $$$TRACE("FT1("_context.ft1count_"):Transactiondate Value : "_ft14TransDate)
   
   set ft14TransDate = $EXTRACT(ft14TransDate,3,*) /// Remove first 2 chars
   $$$TRACE("ft14TransDate after Extract : "_ft14TransDate)
   
   set context.CffDateOfService = ft14TransDate
   
   
   ///Set Name
   
   set lastName = request.GetValueAt("PID:PatientName.familiyname")
   set firstName = request.GetValueAt("PID:PatientName.givenname")
   set middleName = request.GetValueAt("PID:PatientName.middleinitialorname")
   
   set context.CffInstPatientName = lastName_", "_firstName_" "_middleName
   
   
   ///Set Record Status
   set context.CffRecordStatus ="A"
   
   
   ///Set CPT Code
   set ft119DiagCode = request.GetValueAt("FT1("_context.ft1count_"):Diagnosiscode(1).identifier")
   $$$TRACE("FT1("_context.ft1count_"):Diagnosiscode(1).identifier Value : "_ft119DiagCode)
   
   if ($LENGTH(ft119DiagCode) > 0)
   {
   
     if ($LENGTH(ft119DiagCode) > 5)
     {
       set context.CffCPTCode = $EXTRACT(ft119DiagCode,1,5)
       $$$TRACE("ft119DiagCode After Extract: "_$EXTRACT(ft119DiagCode,1,5))
     }
     else
     {
        set context.CffCPTCode = ft119DiagCode
     }
   }
   else
   {
     set context.CffCPTCode = "     "
   }
   
   
   set context.CffCalculatedServiceUnit = "00000"
   set context.CffNationalDrugCode ="00000000000"

   
   ///CreditFlag
   set ft16TransType = request.GetValueAt("FT1("_context.ft1count_"):Transactiontype")
   $$$TRACE("FT1("_context.ft1count_"):Transactiontype Value : "_ft16TransType )
   
   if (ft16TransType = "CR")
   {
     set context.CffExpansion1A2CreditFlag = "N"
   }
   
   
   
   // Make Sure all the fields length are not more than allowed
   
   
   //CffAccountNumber- length 11
   if ($LENGTH(context.CffAccountNumber) > 11)
     {
        set context.CffAccountNumber= $EXTRACT(context.CffAccountNumbe,1,11)
     }
     
     
   //CffGuarantorReferenceNumber - length 9
   if ($LENGTH(context.CffGuarantorReferenceNumber) > 9)
     {
        set context.CffGuarantorReferenceNumber= $EXTRACT(context.CffGuarantorReferenceNumber,1,9)
     }
   
   
    //CffOverrideAmount  - length 9
   if ($LENGTH(context.CffOverrideAmount) > 9)
     {
        set context.CffOverrideAmount = $EXTRACT(context.CffOverrideAmount,1,9)
     }
     
     //CffOverrideDescription- length 35
   if ($LENGTH(context.CffOverrideDescription) > 35)
     {
        set context.CffOverrideDescription= $EXTRACT(context.CffOverrideDescription,1,35)
     }
   
   //CffChargeQuantity- length 5
   if ($LENGTH(context.CffChargeQuantity) > 5)
     {
        set context.CffChargeQuantity= $EXTRACT(context.CffChargeQuantity,1,5)
     }
     
     
     //CffPerformingDoctor- length 5
   if ($LENGTH(context.CffPerformingDoctor) > 5)
     {
        set context.CffPerformingDoctor= $EXTRACT(context.CffPerformingDoctor,1,5)
     }]]]]><![CDATA[>
