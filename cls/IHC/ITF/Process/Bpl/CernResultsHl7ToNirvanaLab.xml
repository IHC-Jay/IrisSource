<code name='Filter to hospitals and inpatients only' xpos='470' ypos='1300' >
<![CDATA[ set pv12= request.GetValueAt("PIDgrpgrp(1).PIDgrp.PV1grp.PV1:PatientClass")
 if (pv12= "500") {
    set pv134= request.GetValueAt("PIDgrpgrp(1).PIDgrp.PV1grp.PV1:AssignedPatientLocation.facilityHD.namespaceID")
    $$$TRACE("Facility ID: "_pv134)
    set isHospital=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).isMember(context.HospitalDomain,pv134,context.hddTargetConfigName,.process)
    if ((isHospital["ITFCOMMON:10109") || (isHospital["Web service returned(error):")){
       $$$TRACE("HDD is member call returned error while trying to determine if PV1-3.4 (facility) is a Hospital. Unable to continue, shutting down.")
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "HDD is member call returned error while trying to determine if PV1-3.4 (facility) is a Hospital(Value:"_pv134_". Domain:("_context.HospitalDomain_".), shutting down. Error returned: "_isHospital)
       Throw ##class(%Exception.StatusException).ThrowIfInterrupt(status)
    }else {
       set context.IsInpatientHospital =isHospital
    }
    $$$TRACE("Is the record a hospital inpatient record? "_context.IsInpatientHospital)
 }]]]]><![CDATA[>
