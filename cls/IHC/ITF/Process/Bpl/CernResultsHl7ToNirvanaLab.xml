<![CDATA[
 $$$TRACE(" GetRepfromNcid Hdd Requests..")
 set pid8GenderNcid = request.GetValueAt("PIDgrpgrp(1).PIDgrp.PID:Sex") 
 $$$TRACE("PID;8 is " _ pid8GenderNcid)		  	
 if ((pid8GenderNcid '= "") && ($ISVALIDNUM(pid8GenderNcid)= "1")){
    set pid8=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(pid8GenderNcid,context.HelpContext,context.hddTargetConfigName,.process)
    if ((pid8["ITFCOMMON:10109") || (pid8["Web service returned(error):")){
       $$$TRACE("HDD ncid to rep call returned error while trying to determine Pid-8 Gender using ncid: "_pid8GenderNcid_". And context: "_context.HelpContext_". Unable to continue, shutting down.")
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "HDD ncid to rep call returned error while trying to determine Pid-8 Gender using ncid: "_pid8GenderNcid_". And context: "_context.HelpContext_". Unable to continue, shutting down.")
       Throw ##class(%Exception.StatusException).ThrowIfInterrupt(status)
    }elseif (pid8 ="") {
       $$$TRACE("HDD ncid to rep call returned nothing while trying to determine Pid-8 gender using ncid: "_pid8GenderNcid_". And context: "_context.HelpContext_". Skipping optional gender field.")
    }else {
       set context.Pid8 = pid8
    }		
 }	
	
 set k1="",tSC=1 
 For { 
    Set k1=request.GetNextIndex("PIDgrpgrp(1).ORCgrp()",k1,.tSCTrans) Quit:k1=""          
    set obr25Ncid = request.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBR:ResultStatus")
    $$$TRACE("OBR-25["_k1_"] is " _ obr25Ncid) 
    if ((obr25Ncid '= "") && ($ISVALIDNUM(obr25Ncid)= "1")){
       set obr25=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(obr25Ncid,context.NirvanaContext,context.hddTargetConfigName,.process)
       if ((obr25["ITFCOMMON:10109") || (obr25["Web service returned(error):")){
          $$$TRACE("HDD ncid to rep call returned error while trying to determine OBR-25 status using ncid: "_obr25Ncid_". And context: "_context.NirvanaContext_". Unable to continue, shutting down.")
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "HDD ncid to rep call returned error while trying to determine OBR-25 status using ncid: "_obr25Ncid_". And context: "_context.NirvanaContext_". Unable to continue, shutting down.")
          Throw ##class(%Exception.StatusException).ThrowIfInterrupt(status)
       }elseif (obr25 ="") {
          $$$TRACE("HDD ncid to rep call returned nothing while trying to determine Obr-25 status using ncid: "_obr25Ncid_". And context: "_context.NirvanaContext_". Skipping optional status field.")
       }else {
          do context.Obr25.SetAt(obr25,k1)
       }
    } 
    
    set k2="", tScc = 1
    For {
       Set k2=request.GetNextIndex("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp()",k2,.tSccTrans) Quit:k2=""  
       set obx8Value = request.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:AbnormalFlags(1)") 
       set obx8 =""
       if (obx8Value '="") {
          if ($ISVALIDNUM(obx8Value)= "1") {
             set obx8=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(obx8Value,context.NirvanaContext,context.hddTargetConfigName,.process)
             if ((obx8["ITFCOMMON:10109") || (obx8["Web service returned(error):")){
                $$$TRACE("HDD ncid to rep call returned error while trying to determine OBX-8 Abnormal Flag using ncid: "_obx8Value_". And context: "_context.NirvanaContext_". Unable to continue, shutting down.")
                set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "HDD ncid to rep call returned error while trying to determine OBX-8 abnormal flag using ncid: "_obx8Value_". And context: "_context.NirvanaContext_". Unable to continue, shutting down.")
                Throw ##class(%Exception.StatusException).ThrowIfInterrupt(status)
             }elseif (obx8 ="") {
                $$$TRACE("HDD ncid to rep call returned nothing while trying to determine OBX-8 abnormal flag using ncid: "_obx8Value_". And context: "_context.NirvanaContext_". Skipping optional status field.")
             }
          }else {
             set obx8=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepByRep(obx8Value,context.CernerOutboundContext,context.AbnormalFlagDomain,context.NirvanaContext,context.hddTargetConfigName,.process)
             if ((obx8["ITFCOMMON:10109") || (obx8["Web service returned(error):")){
                $$$TRACE("HDD rep to rep call returned error while trying to determine OBX-8 Abnormal Flag using ncid: "_obx8Value_". And source context: "_context.CernerOutboundContext_" with target context: "_context.NirvanaContext_" and domain: "_context.AbnormalFlagDomain_". Unable to continue, shutting down.")
                set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "HDD rep to rep call returned error while trying to determine OBX-8 Abnormal Flag using ncid: "_obx8Value_". And source context: "_context.CernerOutboundContext_" with target context: "_context.NirvanaContext_" and domain: "_context.AbnormalFlagDomain_". Unable to continue, shutting down.")
                Throw ##class(%Exception.StatusException).ThrowIfInterrupt(status)
             }elseif (obx8 ="") {
                $$$TRACE("HDD rep to rep call returned error while trying to determine OBX-8 Abnormal Flag using ncid: "_obx8Value_". And source context: "_context.CernerOutboundContext_" with target context: "_context.NirvanaContext_" and domain: "_context.AbnormalFlagDomain_". Skipping optional status field.")
             }
          }
          do context.Obx8.SetAt(obx8,k1_"-"_k2)
       }       
       set obx11Ncid = request.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ObservationResultStatus")          
       $$$TRACE("Value at OBX-11 ["_k1_"] ["_k2_"] is "_obx11Ncid)     
       if ((obx11Ncid '= "") && ($ISVALIDNUM(obx11Ncid)= "1")){
          set obx11=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(obx11Ncid,context.NirvanaContext,context.hddTargetConfigName,.process)
          if ((obx11["ITFCOMMON:10109") || (obx11["Web service returned(error):")){
             $$$TRACE("HDD ncid to rep call returned error while trying to determine OBX-11 result status using ncid: "_obx11Ncid_". And context: "_context.NirvanaContext_". Unable to continue, shutting down.")
             set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "HDD ncid to rep call returned error while trying to determine OBX-11 status using ncid: "_obx11Ncid_". And context: "_context.NirvanaContext_". Unable to continue, shutting down.")
             Throw ##class(%Exception.StatusException).ThrowIfInterrupt(status)
          }elseif (obx11 ="") {
             $$$TRACE("HDD ncid to rep call returned nothing while trying to determine OBX-11 result status using ncid: "_obx11Ncid_". And context: "_context.NirvanaContext_". Skipping optional status field.")
          }else {
             do context.Obx11.SetAt(obx11,k1_"-"_k2)
          }
       } 
    }
 }
