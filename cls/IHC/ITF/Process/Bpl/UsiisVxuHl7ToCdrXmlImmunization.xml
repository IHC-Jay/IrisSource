<code name='Call XMLPROXY service operation' xpos='200' ypos='1050' >
<![CDATA[  $$$TRACE("Call XML Proxy Operation")
  if ($LENGTH(response.OutputToString()) > 100) {
    set quote=""""
    set context.cdrMsgRequest = ##class(Ens.StringRequest).%New()
    set xmlSuffix="<?xml version="_quote_"1.0"_quote_" encoding="_quote_"UTF-8"_quote_ "?>"
    set context.cdrMsgRequest.StringValue = xmlSuffix_response.OutputToString()
    $$$TRACE("XML Proxy Request: "_context.cdrMsgRequest.StringValue)
    set status=process.SendRequestSync(process.TargetConfigNameXMLProxy,context.cdrMsgRequest,.strXmlProxyResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call XMLProxy Ok")
 //     set context.strXmlProxyResponse=strXmlProxyResponse
      $$$TRACE("XMLProxy Service response: "_strXmlProxyResponse.StringValue)
