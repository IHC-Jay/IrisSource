</code>
<code name='check empi' xpos='200' ypos='650' >
<![CDATA[ set context.empi=request.GetValueAt("PID:3.1")
 $$$TRACE("EMPI: " _ context.empi) 
 if ($ISVALIDNUM(context.empi)'="1"){	  
    $$$TRACE("Empi# is NOT a VALID number ")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName, "Hl7 message has invalid empi number: ["_context.empi_"]. Skip the record.")
 }
 else {   
   set trequest = ##class(Ens.StringRequest).%New("")
   set trequest.StringValue = context.empi
   set tStatus=process.SendRequestSync(process.CheckMmiTargetConfigNameOp,trequest,.checkMmiResponse)
   $$$TRACE(" Status value after CheckMmi call: "_tStatus)
   $$$TRACE(" Response value after CheckMmi call: "_checkMmiResponse.StringValue)
   if ('tStatus) {
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "MMI check is failed. Check if DSQL service is up and running...")	
   } else { 
     if checkMmiResponse.StringValue=1 {
        $$$TRACE("Empi: "_context.empi_" is in CDR.") 
     }
     else {
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Empi: "_context.empi_" is not in CDR. Skip the record.")
     }
   }
 }
  set stt=request.GetValueAt("MSH:7")
  $$$TRACE("Message time: "_stt)
  if ##class(Ens.Util.FunctionSet).Length(stt) > 7 {
    set context.obsGMTDt=##class(IHC.ITF.ITFCOMMON.Utility).getUTCDateTimeStr(stt)_".0Z"
    $$$TRACE("Message time: "_context.obsGMTDt)
  }
   set context.hddOpNm=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TargetConfigNameHddWebService",.pstatus)
   set context.prcs=process]]]]><![CDATA[>
</code>
<code name='check existing event id' xpos='200' ypos='750' >
<![CDATA[   set trequest = ##class(Ens.StringRequest).%New("")
   set trequest.StringValue = context.empi
   set tStatus=process.SendRequestSync(process.ImmuEventIdTargetConfigNameOp,trequest,.eventInfoResponse)
   $$$TRACE("Immunization event info after the call: "_eventInfoResponse.StringValue)
   if ('tStatus) {
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Retrieve Empi: "_context.empi_" immunization record event in CDR failed. Skip the record.")	
   } 
   else {
     if $LENGTH(eventInfoResponse.StringValue)>0 { 
       $$$TRACE("Event ID retrieve response: "_eventInfoResponse.StringValue)
       set context.eventId=$Piece(eventInfoResponse.StringValue,"|",1)
       set context.currEditVersion=$Piece(eventInfoResponse.StringValue,"|",2)
       set context.eventSUtcTime=$Piece(eventInfoResponse.StringValue,"|",3)
       $$$TRACE("Immunization event id: "_context.eventId)
       $$$TRACE("Immunization event edit version: "_context.currEditVersion)
       $$$TRACE("Immunization event stat UTC time: "_context.eventSUtcTime)
     } 
     else {
       $$$TRACE("Empi: "_context.empi_" has no immunization record in CDR.")
     }
   }
]]]]><![CDATA[>
</code>
<code name='retrieve action info' xpos='200' ypos='850' >
<![CDATA[ if context.eventId'="" {
   set trequest = ##class(Ens.StringRequest).%New("")
   set trequest.StringValue = context.eventId
   set tStatus=process.SendRequestSync(process.ActionInfoTargetConfigNameOp,trequest,.actionInfoResponse)
   $$$TRACE("Immunization event info after the call: "_actionInfoResponse.StringValue)
   if ('tStatus) {
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Retrieve action info for Event ID: "_context.eventId_" in CDR failed. Skip the record.")	
   } 
   else {
     if actionInfoResponse.StringValue'="" { 
       SET context.actionInfoCnt=$LENGTH(actionInfoResponse.StringValue,"&")
       SET countup=1
       FOR reps=context.actionInfoCnt:-1:1 {
         SET extract=$PIECE(actionInfoResponse.StringValue,"&",countup)
         $$$TRACE(countup_" "_extract)
         $$$TRACE(countup_" extract 1:"_$PIECE(extract,"|",1))
         $$$TRACE(countup_" extract 2:"_$PIECE(extract,"|",2))    
         $$$TRACE(countup_" extract 3:"_$PIECE(extract,"|",3))    
         $$$TRACE(countup_" extract 4:"_$PIECE(extract,"|",4))    
         $$$TRACE(countup_" extract 5:"_$PIECE(extract,"|",5))    
         $$$TRACE(countup_" extract 6:"_$PIECE(extract,"|",6))    
         $$$TRACE(countup_" extract 7:"_$PIECE(extract,"|",7))    
         $$$TRACE(countup_" extract 8:"_$PIECE(extract,"|",8))    
         $$$TRACE(countup_" extract 9:"_$PIECE(extract,"|",9))    
         $$$TRACE(countup_" extract 10:"_$PIECE(extract,"|",10))
         $$$TRACE(countup_" extract 10:"_$PIECE(extract,"|",11))                
         set st = context.clinicianIdNcids.Insert($PIECE(extract,"|",1))
         set st = context.actionTypeNcids.Insert($PIECE(extract,"|",2))
         set st = context.enteredByNcids.Insert($PIECE(extract,"|",3))
         set st = context.enteredTime.Insert($PIECE(extract,"|",4))
         set st = context.locationNcids.Insert($PIECE(extract,"|",5))
         set st = context.editVersions.Insert($PIECE(extract,"|",6))
         set st = context.reasonNcids.Insert($PIECE(extract,"|",7))
         set st = context.locationTypeNcids.Insert($PIECE(extract,"|",8))
         set st = context.pocTypeNcids.Insert($PIECE(extract,"|",9))
         set st = context.pocNcids.Insert($PIECE(extract,"|",10))
         set st = context.appNcids.Insert($PIECE(extract,"|",11))
         SET countup=countup+1
       }
     } 
     else {
       $$$TRACE("Event ID: "_context.eventId_" has no action info record in CDR.")
     }
   }
 }]]]]><![CDATA[>
</code>
