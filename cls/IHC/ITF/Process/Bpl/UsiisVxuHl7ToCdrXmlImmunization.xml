<code name='validate message' xpos='200' ypos='550' >
<![CDATA[ set validationSettingValue=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSettingValue)
 if (tStatus'=$$$OK){
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName,"SKIP record due to validation failure until the maximum error count. "_$SYSTEM.Status.GetOneErrorText(tStatus))
