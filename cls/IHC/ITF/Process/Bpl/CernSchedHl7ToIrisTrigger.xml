	     	$$$TRACE(" Calling GetRepFromNcid for "_ sexNcid_ " from Operation: "_context.hddTargetConfigName)	    
         	set tmpStatus = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getRepFromNcid(sexNcid,"PID-8",context.ihcIntfContext,context.hddTargetConfigName,.process, .retVal)
			$$$TRACE(" Returned Rep: " _ retVal_ " from the Ncid: "_sexNcid )	
			set context.sex=retVal		
     	}catch(exVar){
	     	set exVarData = $ZSTRIP(exVar.Data,"*C")
	     	$$$TRACE(" exVarData --> "_exVarData)
	     	if exVar.Code [ "ITFCOMMON:10108" {
		   // InutDataError - one of the input parameters from source is blank.
		    set tmpStatus=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,exVarData)
	   	 }   elseif exVar.Code [ "ITFCOMMON:10109" {
		     	Set alertRequest=##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError("HDD-Missing Mapping:"_sexNcid,exVarData,process.%ConfigName)
				do process.SendAlert(alertRequest)	
	     	}elseif(exVar.Code [ "ITFCOMMON:10106") {
				set tmpStatus = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,exVarData)
			}else{
		     	set tmpStatus = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Shutting down..Unknown Error."_exVarData)
		    }
     	}		    	
	} 
	else {
		set tmpStatus=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"PID-8: "_sexNcid_" is invalid ncid.")
	}
]]]]><![CDATA[>
