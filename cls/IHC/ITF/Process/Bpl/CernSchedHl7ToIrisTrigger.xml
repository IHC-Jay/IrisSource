<code name='PID-8(sex) ncid lookup' xpos='200' ypos='950' >
<![CDATA[  set sexNcid=request.GetValueAt("PIDgrp(1).PID:8")
  $$$TRACE("PID-8: "_sexNcid)
  
  	if (sexNcid '= "" && $ISVALIDNUM(sexNcid)= "1"){		
