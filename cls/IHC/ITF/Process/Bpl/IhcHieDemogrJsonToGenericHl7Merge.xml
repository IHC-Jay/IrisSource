	  set genderType = context.hieReadDemogrObj.data.genderType
 	  set retStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.IhcHieDemogrJsonToGenericHl7Merge.GenderType", genderType, .retVal )
	  $$$TRACE("retVal(Gender Lookup table) --> " _ retVal)
	  if (retVal="Unknown"){
		  $$$TRACE(" Gender value from Hie Get patient service is not in the looup table. Check the value with EMPI support. " _ retVal) 
		  do ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName, "genderType: ["_genderType_"] is invalid or not defined in the Lookup table. Blanking out the gender value.")
		  set context.gender=""
	  }else{
		  set context.gender = retVal
	  }
  }
