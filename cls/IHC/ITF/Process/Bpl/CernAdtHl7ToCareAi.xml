<code name='GetAllowedMSH4Settings' xpos='200' ypos='1350' >
<annotation><![CDATA[Verify allowed MSH4 Setting is set and get]]]]><![CDATA[></annotation>
<![CDATA[  $$$TRACE("MSH4 filtering work in progress")
 set filterInByMSH4=0
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"DoFilterInByMSH4",.filterInByMSH4)
 $$$TRACE("DoFilterInByMSH4 is: "_filterInByMSH4)  
 if (filterInByMSH4=1){
    set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedMSH4", .configValue)
    if ($$$ISOK(pstatus)){
        set context.FilterInMSH4 = configValue
        set context.doFilterInByMSH4 = filterInByMSH4
       $$$TRACE("FilterInMSH4 List: " _context.FilterInMSH4)	
    }else{
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "***Unable to get FilterInMSH4 List from Property Setting: AllowedMSH4 that is required for processing Order messages for the Pharmacy Order Data!")
    }
 }else{
    $$$TRACE("Not doing any MSH4 filtering. Processing All MSH4 locations.")
 }
 
 ]]]]><![CDATA[>
</code>
<code name='CheckMSH_4isAllowed' xpos='200' ypos='1450' >
<annotation><![CDATA[Check that the MSH-4 facility is an allowed facility]]]]><![CDATA[></annotation>
<![CDATA[  
  if (context.doFilterInByMSH4=1){
      set isAllowedMSH4 = 0
      
      For iTarget=1:1:$L(context.FilterInMSH4, ",") { 
            Set tOneTarget=$ZStrip($P(context.FilterInMSH4,",",iTarget),"<>W") 
            $$$TRACE("tOneTarget.. "_tOneTarget)
            Continue:""=tOneTarget
            
                    
            if (context.msh4Facility = tOneTarget)
            {
	            $$$TRACE("MSH-4 Facility Location is Allowed")
	            set isAllowedMSH4 = 1
	            QUIT
            } 
 
         }
     if (isAllowedMSH4  = 1){
	 $$$TRACE("MSH4 Facility is an allowed Location: "_context.msh4Facility)
     }else{
	 set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "***The Found MSH4 Facility is not an allowed Facility Location. ****PHI - HL7 Message Control ID: " _context.MSH10)
     }
 
  }else{
     $$$TRACE("HL7 is being being processed, with No FilterIn Logic being used in the processing.")
  }
  ]]]]><![CDATA[>
</code>
<code name='ValidateDischageDateTimeisA03' xpos='200' ypos='1550' >
<annotation><![CDATA[Check if there is Discharge Date time and if so is it an A03 else skip]]]]><![CDATA[></annotation>
<![CDATA[
  $$$TRACE("Getting message type")
  set context.MSH92 = request.GetValueAt("MSH:MessageType.triggerevent")
  $$$TRACE("Setting context.MSH92 to: " _context.MSH92)
  set context.PV1FortyFiveDischargeDT = request.GetValueAt("PV1:DischargeDateTime(1).timeofanevent")
  $$$TRACE("Discharge Date Time is set to: <"_context.PV1FortyFiveDischargeDT_">")
  if ((context.MSH92 '= "A03") &&(context.PV1FortyFiveDischargeDT '= "") && ($ISVALIDNUM(context.PV1FortyFiveDischargeDT))) {
			  $$$TRACE("Found MSH-9.2 Trigger Event with a Discharge DateTime that is not an A03. Not sending to the care.ai! ****Skipping Message.*****")
              set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "***Found a MSH-9.2 Trigger Event that is not an A03 with Discharge DateTime value in the PV1-45! ****PHI - HL7 Message Control ID: " _context.MSH10)
	 }
  
 ]]]]><![CDATA[>
</code>
<code name='GetMSH_9_2ValidateEvent' xpos='200' ypos='1650' >
<annotation><![CDATA[Get MSH_9_2 Trigger Event Validate Event against NotAllowedEvents setting]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Getting message type")
  set context.MSH92 = request.GetValueAt("MSH:MessageType.triggerevent")
  $$$TRACE("Setting context.MSH92 to: " _context.MSH92)
  set isAllowedEventType = 0
    $$$TRACE("AllowedEvents : "_context.FilterInADTEvents) 
    $$$TRACE("Allowed Events Count: "_$L(context.FilterInADTEvents, ",")) 
    For iTarget=1:1:$L(context.FilterInADTEvents, ",") 
        { 
        

            Set tOneTarget=$ZStrip($P(context.FilterInADTEvents,",",iTarget),"<>W") 
            $$$TRACE("tOneTarget.. "_tOneTarget)
            Continue:""=tOneTarget
            
                    
            if (context.MSH92 = tOneTarget)
            {
	            $$$TRACE("MSH-9.2 ADT Event Allowed")
	            set isAllowedEventType = 1
	            QUIT
            } 

         }

          
            
     if (isAllowedEventType = 1){
	     $$$TRACE("ADT Event Type is allowed: "_context.MSH92)
     }else{
	      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "***Found a MSH-9.2 Trigger Event that is not an allowed ADT event. ****PHI - HL7 Message Control ID: " _context.MSH10)
     }
	 
  $$$TRACE("Finished checking for allowed MSH-9.2 Events!!!!")
  ]]]]><![CDATA[>
