<code name='GetMSH4FacilityValidateFacility' xpos='200' ypos='1250' >
<annotation><![CDATA[Get MSH-4 value and ensure facility value is valid numeric value]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Validate msh4Facility(MSH-4)...") 
 Set context.msh4Facility=request.GetValueAt("MSH:SendingFacility.namespaceID")
 
 $$$TRACE("msh4Facility: " _ context.msh4Facility) 
 if ($ISVALIDNUM(context.msh4Facility)=0){	  
	  $$$TRACE("MSH-4 Facility value is NOT a VALID numeric value. ")
