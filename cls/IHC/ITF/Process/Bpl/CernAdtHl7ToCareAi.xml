]]]]><![CDATA[>
</code>
<code name='GetPID_18_FINAndValidate' xpos='200' ypos='1850' >
<annotation><![CDATA[Get PID_18 Cerner FIN Number and Validate it - make sure it is not blank.]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Getting PID-18 Encounter - Cerner FINANCIAL (FIN) number....")
 Set context.pid18=request.GetValueAt("PID:PatientAccountNumber.ID")
 $$$TRACE("PID-18.1 Account/Encounter (Cerner FIN) number:  " _context.pid18)
 $$$TRACE("$ISVALIDNUM(pid18) is: "_$ISVALIDNUM(context.pid18))
 if ($ISVALIDNUM(context.pid18)=1){	  
	  $$$TRACE("Account/Encounter (Cerner FIN) number is a VALID number...")
 }else{
	 $$$TRACE("Account/Encounter (Cerner FIN) number is NOT a VALID number ")
	 set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***HL7 message has invalid or missing Account/Encounter (Cerner FIN) number: ["_context.pid18_"].   ****HL7 MessageControlID: " _ context.MSH10)
 }
]]]]><![CDATA[>
</code>
<code name='GetPV1LocationValues' xpos='200' ypos='1950' >
<annotation><![CDATA[Get PV1 Location Values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Get PV1 Location Values....")
 //Get PointOfCareUnit and Room values and check against allowed rooms table
 set PointOfCareUnit = request.GetValueAt("PV1:AssignedPatientLocation.pointofcare")
 set Room = request.GetValueAt("PV1:AssignedPatientLocation.room")
 set POCUnitRoom = PointOfCareUnit_"^"_Room
 
   set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.AllowedRoomsTable,POCUnitRoom ,.returnVal)
   $$$TRACE("Return value from lookup table ="_returnVal)
 
   if ($$$ISOK(pstatus)&&(returnVal="FilterInPOCUnitRoom"))
   {
        $$$TRACE("Found an Allowed Unit and Room combo, so its Rooms are allowed! Get your Camera Ready!")
   }
   else
   {
	   set PreviousPointOfCareUnit = request.GetValueAt("PV1:PriorPatientLocation.pointofcare")
	   set PreviousRoom = request.GetValueAt("PV1:PriorPatientLocation.room")
	   set PreviousPOCUnitRoom = PreviousPointOfCareUnit_"^"_PreviousRoom
	   set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToCareAi.Lookup.AllowedPV1Rooms",PreviousPOCUnitRoom ,.returnVal)
       $$$TRACE("Return value from lookup table for PriorPatientLocation="_returnVal)
       
       if ($$$ISOK(pstatus)&&(returnVal="FilterInPOCUnitRoom"))
       {
	       $$$TRACE("Found an Allowed Unit and Room for PriorLocation Details!")
	   }
	   else{
		   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"HL7 record does not have an allowed room unit. Skipping this record.  ****HL7 MessageControlID: " _ context.MSH10)
		   
	   }
	   
     
   }
  
  
]]]]><![CDATA[>
