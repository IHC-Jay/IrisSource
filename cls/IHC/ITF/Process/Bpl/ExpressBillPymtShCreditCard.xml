<code name='Generate Decryption Filename' xpos='200' ypos='1250' >
<![CDATA[  //Extract filename alone from context variable
  Set context.fileName = $P(context.fileName,"/",$Length(context.fileName,"/"))
  $$$TRACE("extracted file name _ "_context.fileName)
  
   //Extract the input filename (Remove the extension)
  Set extractFileName = $P(context.fileName,".")
  
 //Remove the Date and timestamp from file Name
  Set context.decryptedFileName = $EXTRACT(extractFileName ,0,*-7)
  
 // Generate Time Stamp  
   Set currentDate = $ZDATETIME($HOROLOG)
	Set replaceDate = $REPLACE(currentDate," ","")
	Set replaceDate = $REPLACE(replaceDate,"/","")
	Set replaceDate = $REPLACE(replaceDate,":","")
	
