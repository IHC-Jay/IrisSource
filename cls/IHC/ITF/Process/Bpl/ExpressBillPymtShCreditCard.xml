<code name='Create Stream for FTP Output' xpos='200' ypos='1950' >
<![CDATA[ // Create Stream
 set decryptedFileName=context.filePath_context.decryptedFileName
 if (##class(%File).Exists(decryptedFileName)=0){     
 set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Decrypted file does not exists : "_decryptedFileName_" so unable to send the file to SelectHealth through SFTP Operation") 
   $$$TRACE("Decrypted file does not exists : "_decryptedFileName_" so unable to send the file to SelectHealth through SFTP Operation:>>"_decryptedFileName)
 }
 
 Set streamFile=##class(%FileCharacterStream).%New()
 Do streamFile.LinkToFile(decryptedFileName)

 set stream=##class(%Stream.GlobalCharacter).%New()
 Set status = stream.CopyFromAndSave(streamFile)
 set context.ftpRequest = ##class(Ens.StreamContainer).%New(stream)
 set context.ftpRequest.OriginalFilename = decryptedFileName
 
 // delete the file once streamed to output
 set deleteSuccess = ##class(%File).Delete(decryptedFileName)
 If $$$ISERR(deleteSuccess)
 {
  $$$TRACE("Unable to delete temporary file :"_decryptedFileName)
 }
 
 
 ]]]]><![CDATA[>
