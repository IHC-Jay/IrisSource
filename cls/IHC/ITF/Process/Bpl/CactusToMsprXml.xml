<code name='ValidateXMLResponse' xpos='200' ypos='450' >
<![CDATA[	  // Validate the response by loading it to the IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo structure
 set status=$$$OK
 set context.CallXmlProxy=0
 // If context.MSPRResponseString="" then set retry as 1 to execute remapAsInsert and call proxy Operation again
 If (context.strXmlProxyResponse.StringValue=""){
     $$$TRACE("No Response received from prvious call execute logic of MapAsInsert")
     set context.Retries=context.Retries+1
     If (context.Retries<=context.MaxRetries){
          set context.CallXmlProxy=1
     }Else
     {     
        set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR inspite of senting it as insert.")  
      }
     quit   
 }
 
 $$$TRACE("Validate the received response"_context.strXmlProxyResponse.StringValue)
 // Remove the XMl Version tag from start and Junk characters at the end
 set context.MSPRResponseString="<CiwsInfo"_$piece(context.strXmlProxyResponse.StringValue,"CiwsInfo",2)_"CiwsInfo>"
 $$$TRACE("Validate the received response"_context.MSPRResponseString)
 Set reader = ##class(%XML.Reader).%New()
 Set sc=reader.OpenString(context.MSPRResponseString)
 if '$$$ISOK(sc){
     set stattus=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
  } 
  Else {
      Do reader.Correlate("CiwsInfo","IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo")
      do reader.Next(.CiwsInfo,.sc)
      If $$$ISOK(sc){
	       $$$TRACE("Response back from MSPR parsed successfully.")
         // check if the the request was successfuly posted to MSPR
         set status=##class(IHC.ITF.Process.Bpl.CactusToMsprXml).ValidateMSPRResponse(CiwsInfo,process.%ConfigName,.pRetry)
         If $$$ISOK(status){
	         if (pRetry'=1){
		         $$$TRACE("Message posted successfuly to MSPR") 
	         }Else{
		         set context.Retries=context.Retries+1
		         If (context.Retries<=context.MaxRetries){
			         set context.CallXmlProxy=1
			     }Else
      				{     
          				set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR inspite of senting it as insert.")  
      				}  
	         }
         }
         else {
	         set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Validating Response From MSPR inspite of sending it as insert.")  
         }
      }Else
      {     
          set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
      }    
  }
  If ($$$ISOK(status)){
	  // Just remove the junk character at the end for sending it to the other destinations.
	  set context.MSPRResponseString=$piece(context.strXmlProxyResponse.StringValue,"</CiwsInfo>")_"</CiwsInfo>"
  }]]]]><![CDATA[>
