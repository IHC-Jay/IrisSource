<Method name="ValidateMSPRResponse">
<ClassMethod>1</ClassMethod>
<FormalSpec>pMsprResponse:IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo,pConfigName:%String,*pRetryMessage:%Integer=0</FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tSC AS %Status=$$$OK
	set pRetryMessage=0
	If ($ISOBJECT(pMsprResponse)){
		set smsg=$ZSTRIP(pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sSystemMessage.content,"<>W")
		set smsg=$Replace(smsg,"&gt;",">")
		if (($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sType.content),"<>W")="INF")&&
	   		($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).iNumber.content),"<>W")="0") && 
	   		($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sImess.Item.GetAt(1).sMess.content),"<>W")="Successful MSPR Transaction")){
		   		set tSC=$$$OK
	  	 }
		elseIf (($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).iNumber.content),"<>W")="40006") &&($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sType.content),"<>W")="SVR")&&($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sSystemMessage.content),"<>W")["truncated")){
			   set tSC=$$$OK
		}
		elseIf ((smsg="")||((smsg["Required element missing - memberInfo->names UNIT#")&&(smsg'["truncated to")&&(smsg'["ORA-00001"))){
			set tSC=$$$OK
			set pRetryMessage=1
		}
		Else {
			$$$TRACE("Posting To MSPR not successful - Invalid completion code received from MSPR")
	   		set tSC=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(pConfigName,"Posting To MSPR not successful - Invalid completion code received from MSPR")
		 }
	}else{s pRetryMessage=1}
   
	// Check If -- check for the unit number and userNcid present if not SKip the message
	If ((pRetryMessage'=1)&&($$$ISOK(tSC))){
		try {
			set wHddNcid=$zstrip(pMsprResponse.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).memberInfo.userNcid.ncid,"<>W")
	        set wUnitNumber=$zstrip(pMsprResponse.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).unitNumber.content,"<>W")
	        If ((wHddNcid="")||(wUnitNumber="")){
       			$$$TRACE("MSPR XML Proxy reply is missing in userNcid or unitNumber. Not a valid response for a successful reply")
		        set tSC=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(pConfigName,"MSPR XML Proxy reply is missing in userNcid or unitNumber. Not a valid response for a successful reply")
	        }

		}Catch {
			$$$TRACE("MSPR XML Proxy call failed with error response.")
			set tSC=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(pConfigName,"MSPR XML Proxy reply is missing in userNcid or unitNumber. Not a valid response for a successful reply")
		}

	}
	   
	   quit tSC
]]></Implementation>
</Method>

