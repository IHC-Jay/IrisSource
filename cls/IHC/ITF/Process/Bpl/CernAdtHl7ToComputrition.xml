<![CDATA[ set validationSettingValue=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSettingValue)
 if (tStatus'=$$$OK){
    set context.ValidationPassed=0
 	set context.errorStatus=tStatus}
 	
 $$$TRACE("Validate Empi(CMRN)...") 
 Set context.empiNumber=request.GetValueAt("PID:PatientIdentifierList(1).ID")         
 
 $$$TRACE("EMPI: " _ context.empiNumber) 
 if ($ISVALIDNUM(context.empiNumber)'="1"){	  
	  $$$TRACE("Empi# is NOT a VALID number ")
	  set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Hl7 message has invalid empi number: ["_context.empiNumber_"]. Skipping the record." _ "Hl7 Msg:" _ request.RawContent)
	  set context.ValidationPassed=0
 }
 
 $$$TRACE("Validate Facility(MSH-4)...") 
 Set context.Facility=request.GetValueAt("MSH:SendingFacility.namespaceID")
 
 $$$TRACE("Facility: " _ context.Facility) 
 if ($ISVALIDNUM(context.Facility)'="1"){	  
	  $$$TRACE("Facility# is NOT a VALID number ")
	  set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Hl7 message has invalid facility number: ["_context.Facility_"]. Skipping the record." _ "Hl7 Msg:" _ request.RawContent)
