<code name='Set Location Variables' xpos='470' ypos='1100' >
<![CDATA[ set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Utility).GetHddObject(context.HddRepResponse, context.LocationInfo)
 if (hddObj '= ""){
    set patLoc = hddObj.Rep
    $$$TRACE("Created HDD Req for " _context.LocationInfo_ " NCID: " _hddObj.NCID_ ", context: " _context.LocationContext)
 }

 $$$TRACE("Patient location: " _patLoc)
 set patLocList = $LISTFROMSTRING(patLoc, "-")
 set patLocListLength = $LISTLENGTH(patLocList)
 $$$TRACE("Pat Location(Cerner Rep) List count:"_patLocListLength)   
 if patLocListLength>3{
    set context.PointOfCareUnit = $LIST(patLocList,2) 
    set context.Room = $LIST(patLocList,3)   
    set context.Bed =  $LIST(patLocList,4) 
 }elseIF patLocListLength=3{	   
    set context.PointOfCareUnit = $LIST(patLocList,2) 
    set context.Room = $LIST(patLocList,3)   
    set context.Bed =  ""
 }elseIF  patLocListLength=2{	   
    set context.PointOfCareUnit = $LIST(patLocList,2) 
    set context.Room = ""   
    set context.Bed =  ""
 }
 
 if (context.PointOfCareUnit = "DSCSER") {
    $$$TRACE("Nurse unit set to DSCSER not a record wanted on this pathway, skipping record.")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Nurse unit set to DSCSER not a record wanted on this pathway, skipping record.")
 }
 
 set unitStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.BPL.CernAdtToComputrition.Lookup.NurseUnitToSend", context.Facility, .retVal )
 if ($$$ISERR(unitStat) || (retVal = "Unknown") || (retVal ="")) {       
    $$$TRACE("Unable to find Nurse Unit list on the lookup table this is unexpected as it passed the facility check, shutting down.")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to find Nurse Unit list on the lookup table this is unexpected as it passed the facility check, shutting down.")
 } else {
    if ($In(context.PointOfCareUnit, retVal) '="1")  {
           $$$TRACE("Unable to find Nurse Unit on the lookup table: " _context.PointOfCareUnit_ ", skipping message.")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Unable to find Nurse Unit on the lookup table: " _context.PointOfCareUnit_ ", skipping message.")
    }else {
       
    }
 }
