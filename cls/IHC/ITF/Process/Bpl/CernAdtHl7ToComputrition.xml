    if ($$$ISERR(targetStat) || (retVal = "Unknown") || (retVal ="")) {       
       $$$TRACE("Unable to get Target from the lookup table not a transaction needed on this pathway, skipping record")
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Unable to get Target from the lookup table not a transaction needed on this pathway, skipping record")
