 if ($$$ISOK(hddstatus)){
    set context.HddTargetConfigName = hddConfigValue
    $$$TRACE("HddTargetConfigName: " _ context.HddTargetConfigName)
 }else{
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to get HDDTargetConfigName, shutting down.")
 }

 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedEvents",.configValue)
 $$$TRACE("Allowed Events: " _configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = "")) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to find allowed events list in settings this is unexpected, shutting down.")
 }else {
    set context.TriggerEvent=request.GetValueAt("MSH:MessageType.triggerevent")
    $$$TRACE("Getting message type: " _context.TriggerEvent)
    set AllowedEvents = $LISTFROMSTRING(configValue, ",")
    if (context.TriggerEvent="A44") {
       ///Change to an A18
       set context.TriggerEvent="A18"
    }
    $$$TRACE("Checking against allowed events")
    if ($LISTFIND(AllowedEvents, context.TriggerEvent) =0) {
       $$$TRACE("Unable to find Trigger Event in the settings: " _context.TriggerEvent_ ", not an allowed event skipping message.")
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Unable to find Trigger Event in the settings, not an event wanted on this pathway: " _context.TriggerEvent_ ", skipping message. Hl7 Record: " _request.RawContent)
    }
 }
 if ((context.TriggerEvent="A08") && (request.GetValueAt("PV1:45.1")'="")) {
	 $$$TRACE("A08's with discharge date not wanted on this pathway skipping message.")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "A08's with discharge date not wanted on this pathway skipping message. Hl7 Record: " _request.RawContent)
 }
 
  if (context.TriggerEvent="A07")
  {
	  set context.PatientClass=request.GetValueAt("PV1:PatientClass")
	  $$$TRACE("Geting PatientClass: " _context.PatientClass)
	  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ToSkipA07PatientClass",.A07SkipPatientClass)
 	  $$$TRACE("Patient Class to Skip for A07: " _A07SkipPatientClass)
 	  set ListA07SkipPatientClass = $LISTFROMSTRING(A07SkipPatientClass, ",")
 	  
 	  if ($LISTFIND(ListA07SkipPatientClass, context.PatientClass) > 0)
