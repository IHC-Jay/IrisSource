 set context.HddTargetConfigName=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"HddTargetConfigName",.pstatus)
 if ($$$ISOK(pstatus)){
    $$$TRACE("HddTargetConfigName: " _ context.HddTargetConfigName)
 }else{
            Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to get HDDTargetConfigName, shutting down.")
 }
 set Ncid = request.GetValueAt("ZZZ(2):16VisitAdmitDXCode")
 if (Ncid '= "") {
    set context.LocationInfo = "ZZZ(2):16VisitAdmitDXCode"
 }else {
    set Ncid = request.GetValueAt("ZZZ(2):15VisitPatientType")
    if (Ncid '= "") {
       set context.LocationInfo = "ZZZ(2):15VisitPatientType"
    }else {
       set Ncid = request.GetValueAt("ZZZ(2).14VisitAdmitSource")
       if (Ncid '= "") {
          set context.LocationInfo = "ZZZ(2):14VisitAdmitSource"
       }
    }
 }
 if (Ncid '= "") {
    set context.HddRepRequest = ##class(IHC.ITF.ITFCOMMON.HDD.Utility).CreateHddRepReqObject()
    do ##class(IHC.ITF.ITFCOMMON.HDD.Utility).AddNcidToRepObject(context.HddRepRequest, Ncid, context.LocationContext, LocationInfo)
    $$$TRACE("Created HDD request for " _LocationInfo_ ". Using HddTargetConfigName: " _context.HddTargetConfigName)
 }]]]]><![CDATA[>
