<code name='process hdd filter response' xpos='200' ypos='950' >
<![CDATA[  $$$TRACE("Starting processing of hdd filtering")
 set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.ComputritionHddFilterResponse, "computritionfilter")
 $$$TRACE("After making hdd object")
 if (hddObj '= ""){
    $$$TRACE("After checking hdd object")
    if (hddObj.Rep '="") {
       $$$TRACE("After checking hdd object response")
       if (hddObj.Rep = "N") {
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Not a record wanted by Computrition , skipping record: " _request.RawContent)
       }elseif (hddObj.Rep = "Y"){
          //Wanted by computrition so keep processing.       
       }else {
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "Invalid response from the Hdd for Computrition filter"_context.HddErrorMessage)
