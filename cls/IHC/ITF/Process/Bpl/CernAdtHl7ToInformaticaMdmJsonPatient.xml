<code name='Convert XmlToJSON and Call Patient MDM' xpos='740' ypos='2400' >
<![CDATA[  
   $$$TRACE("Converting XML to JSON Operation.. ")
    set xmlStr=response.OutputToString()  
    set xmlStr = $ZSTRIP(xmlStr, "*C")
    $$$TRACE("DTL Output: ")
    if ($L(xmlStr)>2400){
		  $$$TRACE($E(xmlStr,1,1200))
		  $$$TRACE($E(xmlStr,1201,2400))
		  $$$TRACE($E(xmlStr,2401,$L(xmlStr)))
	}elseif($L(xmlStr)>1200){
		$$$TRACE($E(xmlStr,1,1200))
		$$$TRACE($E(xmlStr,1201,$L(xmlStr)))
	}else{
	      $$$TRACE(xmlStr)
	}
	
    set myList = $LISTBUILD("item")
    set json = ##class(IHC.ITF.ITFCOMMON.Util.XmlToJson2).CreateJson(xmlStr,myList)
    $$$TRACE("JSON string: "_json)      
    
    set jsonProcessRequest=##class(Ens.StringContainer).%New()
    set jsonProcessRequest.StringValue= ##class(Ens.Util.FunctionSet).SubString(json, 22, $LENGTH(json)-1)
    $$$TRACE("JSON string-Removed root XML element: "_jsonProcessRequest.StringValue) 
    
    
    // Create the target
	Set httpObj = ##class(EnsLib.HTTP.GenericMessage).%New()
	Set tStream = ""
	Set tStream = ##class(%Stream.GlobalCharacter).%New()
	Do tStream.Write(jsonProcessRequest.StringValue)
	Do tStream.Rewind()

	Do httpObj.HTTPHeaders.SetAt("application/json","content-type")
	Do httpObj.HTTPHeaders.SetAt("application/json","accept")
	
	Do httpObj.HTTPHeaders.SetAt(tStream.Size,"content-length")
	Set httpObj.Stream = ##class(%Stream.GlobalBinary).%New()
	Set tStatus = httpObj.Stream.CopyFrom(tStream)
	if (tStatus'=$$$OK){
		Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Error while converting JSON to http.")
	}
	Do tStream.Rewind()
	Set datStr = tStream.Read()
	$$$TRACE("JSON Request: " )
	if ($L(datStr)>2400){
		  $$$TRACE($E(datStr,1,1200))
		  $$$TRACE($E(datStr,1201,2400))
		  $$$TRACE($E(datStr,2401,$L(datStr)))
	}elseif ($L(datStr)>1200){
		  $$$TRACE($E(datStr,1,1200))
		  $$$TRACE($E(datStr,1201,$L(datStr)))
	}else{
	      $$$TRACE(datStr)
	}
			
    $$$TRACE("Call REST Operation")
  if (datStr'="") {
    $$$TRACE("Calling patient Mdm Service.... ")
    set status=process.SendRequestSync(context.patientMdmServiceTargetConfigName,httpObj,.httpPatientServiceResponse)
    if ($$$ISOK(status)){
	    $$$TRACE("RESPONSE from patent MDM :-- "_httpPatientServiceResponse.Stream.Read())
	    
	    Set respStream = ##class(%GlobalCharacterStream).%New()
        Set respStatus = respStream.CopyFrom(httpPatientServiceResponse.Stream)
        set respText =""
        While 'respStream.AtEnd {
          Set respText = respText_respStream.Read()
        } 
        $$$TRACE("Patient MDM service response: "_respText)
        
	    set statusLine=httpPatientServiceResponse.HTTPHeaders.GetAt("StatusLine")
        $$$TRACE(" Status Line: --> "_statusLine)	
        if statusLine [ "200"{
	        $$$TRACE(" Successful Response from Patient Service MDM ")
	        Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)
	    }else{		    
			    set respJSONstring = respText
           		set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respJSONstring)
                set iter = consumedJSONobj.%GetIterator()
                set errorCode = consumedJSONobj.%Get("errorCode")
                $$$TRACE(" errorCode: "_errorCode) 
                set errorMessage = consumedJSONobj.%Get("errorMessage")
                $$$TRACE(" errorMessage: "_errorMessage)
                $$$TRACE(" context.unknownErrors --> "_context.unknownErrors)
                $$$TRACE(" context.retrySameDisableErrorCodes --> "_context.retrySameDisableErrorCodes)
                $$$TRACE(" context.inputDataErrorCodes --> "_context.inputDataErrorCodes)
                if context.unknownErrors [ errorCode {
	                $$$TRACE(" DisableMsgError.. errorCode: "_errorCode)
	                Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," No Successful Response from Patient service: ["_respText_"]. Disabling the component.")
		        }
                if context.retrySameDisableErrorCodes [ errorCode  {
	                $$$TRACE(" RetryCheckError.. errorCode: "_errorCode)
	                Set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName," No Successful Response from Patient service: ["_respText_"]. Retried same record max times and disabling the component.")
		        }
		        if context.inputDataErrorCodes [ errorCode   {
			        $$$TRACE(" InputDataError.. errorCode: "_errorCode)
			        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," No Successful Response from Patient service: ["_respText_"]. Failing the record with alert.")
			        /*
			        if errorMessage [ "Not a JSON Object"{
				        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName," No Successful Response from Patient service: ["_respText_"]. Disabling the component.")
			        }elseif errorMessage [ "ValidationFailed"{
				        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName," Un issues in the JSON request. ["_respText_"]. ")
			        }else{
	                	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Unknown Input data related error: ["_respText_"]. Disabling the component.")
			        }
			        */
		        }
		        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Unhandled ErrorCode. No Successful Response from Patient service: ["_respText_"]. Disabling the component.")
		        		  		    
		     
		}	
    }else{
	    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Error calling the Patient MDM service. "_$SYSTEM.Status.GetOneErrorText(status))
	}
  }
    
	                              
 ]]]]><![CDATA[>
</code>
</false>
</if>
</true>
<false>
<trace name='Message Validation Failed' value='"Message Validation Failed"' xpos='200' ypos='900' />
<code name='SkipValidationFailed' xpos='200' ypos='1000' >
<![CDATA[ set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Hl7 message validation failed, Skipping the record.")
]]]]><![CDATA[>
</code>
</false>
</if>
<faulthandlers>
<catchall xpos='200' ypos='2700' xend='200' yend='350' >
<code name='Call ProcessError' xpos='200' ypos='250' >
<annotation><![CDATA[Call error handler method]]]]><![CDATA[></annotation>
<![CDATA[ 
    Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).ProcessError(..%Context.%LastError)
]]]]><![CDATA[>
</code>
</catchall>
</faulthandlers>
</scope>
</sequence>
</process>
]]></Data>
</XData>
</Class>
</Export>
