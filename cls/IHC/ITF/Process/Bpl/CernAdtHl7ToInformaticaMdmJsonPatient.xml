   set context.nonUSAddressFlag=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","NonUSAddressFlag",.pstatus)
    $$$TRACE("NonUSAddressFlag: " _ context.nonUSAddressFlag)
    set hasHomeAddress = "0"
       
       set k1="",tSC=1 
   For { 
     Set k1=request.GetNextIndex("PID:11()",k1,.tSCTrans)  Quit:k1="" 
     set pid117AddressTypeNcid = request.GetValueAt("PID:11("_k1_").7")     
     $$$TRACE(" PID-11.7 AddressType Ncid: " _ pid117AddressTypeNcid)
     set pid116CountryNcid = request.GetValueAt("PID:11("_k1_").6")
     $$$TRACE(" PID-11.6 Country Ncid: " _ pid116CountryNcid)
     
     if (pid117AddressTypeNcid = "199"){ 
         set hasHomeAddress = "1"
         if (pid116CountryNcid'="1800"){
	 	    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, " Home Address(Ncid 199) is International address in PID-11. Filtering out the record..IHC MRN#: "_context.ihcEmpiNum)  
	    	 break              
	 	}
     }
    }
    if (hasHomeAddress="0"){
	 	  set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, " No Home Address(Ncid 199) in the patient address in PID-11. Filtering out the record..IHC MRN#: "_context.ihcEmpiNum)  
    }
    
]]]]><![CDATA[>
