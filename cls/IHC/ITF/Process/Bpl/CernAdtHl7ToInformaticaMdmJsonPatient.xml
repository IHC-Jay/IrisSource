<code name='SetPersonIdFromOBX' xpos='740' ypos='1650' >
<![CDATA[ 
 set k1="",tSC=1
 For { 
     Set k1=request.GetNextIndex("OBX()",k1,.tSCTrans)  Quit:k1="" 
     Set obx5Value = request.GetValueAt("OBX("_k1_"):5(1)")
     set obx31= request.GetValueAt("OBX("_k1_"):3.1")     
     if (obx31 = "PERSON ID") {
        set context.personId = obx5Value 
     }
  }
  $$$TRACE(" context.personId --> "_context.personId )
  if (context.personId=""){
     	set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, " PERSON ID ["_ context.personId_"] OBX-5.1 is blank out of iCentra Adt. Filtering out the record..")                
     }
  ]]]]><![CDATA[>
