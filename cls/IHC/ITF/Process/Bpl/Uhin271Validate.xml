<code name='X12 Validate Document' xpos='740' ypos='1250' >
<![CDATA[  //$$$TRACE("X12ValidateDocument, SNIP: " _ context.tpLinkObj.SNIP _ " returned: " _ tSc)
  $$$TRACE("RDP Validation operation")
  $$$TRACE("tpLinkObj.SNIP: "_context.tpLinkObj.SNIP)
   if (context.tpLinkObj.SNIP > 0) { 
     set context.storeX12.SNIP = context.tpLinkObj.SNIP 
     set context.storeX12.version = context.version 
     set context.storeX12.transactionType = context.transType
     set context.storeX12.ValidationRuleFile = context.tpLinkObj.ValidationRuleFile
     set context.storeX12.streamContainer = ##class(Ens.StreamContainer).%New()
	 set context.storeX12.streamContainer.Stream = ##class(%Stream.GlobalCharacter).%New()
	 //Set tSC = request.OutputToLibraryStream(context.storeX12.streamContainer.Stream)
	 
	 if $IsObject(context.inpStream) {
		 Set tStream = context.inpStream
		 Set tData = tStream.Read()
		 $$$TRACE(tData)
    	 Set context.storeX12.streamContainer.Stream = tStream
	}else{
    	// Handle error: no stream contained in the request
	}
	
	 $$$TRACE("Stream size: " _ context.storeX12.streamContainer.Stream.Size)
	 $$$TRACE("Validation rule : " _ context.storeX12.ValidationRuleFile)
	 set context.storeX12.direction = context.direction
     set context.storeX12.status = "Processed"
     set context.storeX12.SessionID = process.%PrimaryRequestHeader.SessionId
        //End 
     set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"RdpCrystalTargetConfigName",.configValue)
     if ( ($$$ISERR(pstatus)) || (configValue = ""))
     {
	    $$$LOGERROR("RDP Crystal validation process not defined - RdpCrystalTargetConfigName")
	    set context.SNIPValidationStat = $$$OK
	 }
	 else
     {
	    $$$TRACE("Call: " _ configValue)
	    try {
	       Set tSC1=process.SendRequestSync(configValue, context.storeX12, .resp, 10)
           $$$TRACE("Send Sync Incoming Stream to RDP Validation operation, status: " _ tSC1 _", " _ resp.jsonMessage.%ToJSON())
           if $$$ISOK(tSC1)
           {
              set context.jsonMessage = resp.jsonMessage
              $$$TRACE("Validation status: " _ context.jsonMessage.status)
              if (context.jsonMessage.status = "PASS")
              {
                 set context.SNIPValidationStat = $$$OK
              }
              else
              {
                 set context.SNIPValidationStat = $$$ERROR($$$EnsErrGeneral, "RDP validation failed")
                 $$$TRACE("RDPCrystal ACK: " _ context.jsonMessage.ack)
              }
           }
           else
           {  
              set context.SNIPValidationStat = tSC1
           }
         } catch ex
         {
            Set errMsg = "Exception"
            If (ex.%IsA("%Exception.SystemException") && (ex.AsSystemError()["<NOTOPEN>")) {
			     Set errMsg = $system.Process.OSError()
			 }
			 else
			 {
			    Set errMsg = "Exception: " _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location
			 }
             $$$LOGERROR("Exception in calling the " _ configValue _ " : " _ errMsg )
             set context.SNIPValidationStat = 0
             set response = ##class(Ens.StringContainer).%New()
             set context.jsonMessage.ack = "ERROR: Could not validate X12"
             set context.jsonMessage.details = "Exception in calling validation, " _ errMsg 
          }
       }
  }
  else
  {
    $$$TRACE("Don't Perform Validation, SNIP: " _ context.tpLinkObj.SNIP)
    set context.SNIPValidationStat = $$$OK
  }
                         
]]]]><![CDATA[>
