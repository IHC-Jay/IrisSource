<code name='Get values from SourceFlagsLookup' xpos='470' ypos='900' >
<![CDATA[ set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"SourceFlagsLookup",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	$$$TRACE("Initialization error, SourceFlagsLookup not defined")
 }
 else
 {
   set context.sourceFlagsLookup = configValue
  
  
   try {
       set overrideSenderTP = "", overrideReceiverTP = ""
       
       DO ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.sourceFlagsLookup, process.%PrimaryRequestHeader.SourceConfigName, .retVal) 
       $$$TRACE("Flags from: " _ context.sourceFlagsLookup _", for: " _ process.%PrimaryRequestHeader.SourceConfigName _ " ::: " _ retVal)
       
       // Example:
       // DupCheck:no;UseISA:no;OverrideSenderTP:R035208; OverrideReceiverTP:HT15000-001,AckConnUnknownTP:BitBucket
       
       Set delim=";"
     SET countdown=$LENGTH(retVal,delim)
     set useIsa = "", overrideTP="" 

     FOR reps=1:1:countdown {
        set kv = $PIECE(retVal,delim,reps)
      
        if ($zconvert(kv, "l") [ "useisa")
        {
            set useIsa = $zconvert($PIECE(kv, ":", 2), "u") 
        }
        elseif ( $zconvert(kv, "l") [ "overridesendertp")
        {
            set overrideSenderTP= $PIECE(kv, ":", 2)
        }
        elseif ( $zconvert(kv, "l") [ "overridereceivertp")
        {
            set overrideReceiverTP= $PIECE(kv, ":", 2)
        }
        elseif ($zconvert(kv, "l") [ "dupcheck")
        {
            set context.duplicateCheck = $zconvert($PIECE(kv, ":", 2), "u")
        }
        elseif ($zconvert(kv, "l") [ "ackconnunknowntp")
        {
           //AckConnUnknownTP:BitBucket
           set context.ackConnUnknownTP = $PIECE(kv, ":", 2)
        }
        
        else
        {
          $$$LOGERROR("Invalid value: " _ kv)
        }
      }
      $$$TRACE(useIsa  _ ": " _ overrideReceiverTP _ ": " _ overrideSenderTP )
   
   
      if ((useIsa = "NO") && (overrideReceiverTP '= "" ))
      {
        $$$TRACE("New ISA Receivervalue: " _ overrideReceiverTP )
        set context.interchangeReceiverID = overrideReceiverTP 
      }
      if ((useIsa = "NO") && (overrideSenderTP '= "" ))
      {
        $$$TRACE("New ISA Sender value: " _ overrideSenderTP )
        set context.interchangeSenderID = overrideSenderTP 
      }
  
     } catch err
     {
       $$$LOGERROR("Value not found in Lookup table: " _ process.%PrimaryRequestHeader.SourceConfigName)
     }
   }
   
   
  
 
   ]]]]><![CDATA[>
