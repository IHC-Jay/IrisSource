<![CDATA[  
  // Creating obeject for original message since If any below condition fails then  original message will be send to outbound 
  set context.TransformedOrder = request.%ConstructClone()
  

  
  
  set k1="",tSC=1   
 For { 
   Set k1=request.GetNextIndex("ORCgrp()",k1,.tSCTrans)  Quit:k1="" 
   set k2="",tSC=1
   
   For { 
     Set k2=request.GetNextIndex("ORCgrp("_k1_").OBRuniongrp.OBXgrp()",k2,.tSCTrans)  Quit:k2="" 
     set obxDiagIdentifier = request.GetValueAt("ORCgrp("_k1_").OBRuniongrp.OBXgrp("_k2_").OBX:ObservationIdentifier.identifier")
     $$$TRACE(" obxDiagIdentifier : "_obxDiagIdentifier)
     
     
     
     if (obxDiagIdentifier ="Diagnosis Interpretation")
     {
       set obxObservNcid = request.GetValueAt("ORCgrp("_k1_").OBRuniongrp.OBXgrp("_k2_").OBX:ObservationValue(1)")
        $$$TRACE(" obxObservNcid : "_obxObservNcid)
       
       set context.obxObservRep = (##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(obxObservNcid, context.philipsContext, context.hddTargetConfigName, .process))
     
       $$$TRACE(" obxObservRep : "_context.obxObservRep)
       
       if (context.obxObservRep '= "")
       {
       
         do context.TransformedOrder.SetValueAt(context.obxObservRep,"ORCgrp("_k1_").OBRuniongrp.OBXgrp("_k2_").OBX:ObservationValue(1)")
         
         
         do context.TransformedOrder.%Save()
         
       }
       
     }
     
     
     
   }
   
 }
 
 
 if ($L(context.facilityName) > 0)
