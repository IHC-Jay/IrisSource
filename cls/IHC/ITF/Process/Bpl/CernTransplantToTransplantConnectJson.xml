<code name='Process Obx' xpos='470' ypos='1500' >
<annotation><![CDATA[Process Obx]]]]><![CDATA[></annotation>
<![CDATA[  set jsonObj = ##class(%DynamicObject).%New()  
  set jsonObj = ##class(%DynamicObject).%FromJSON(context.jsonStr)
   $$$TRACE("OBX@000" )
  
 set k1="",tSC=1 
 For { 
  $$$TRACE("OBX@001:" )
  
  Set k1=request.GetNextIndex("ORCgrp(1).OBRuniongrp.OBXgrp()",k1,.tSCTrans) Quit:k1=""   
    $$$TRACE("obx@1.1 k1:"_k1)   
    
      set obx31= request.GetValueAt("ORCgrp(1).OBRuniongrp.OBXgrp("_k1_").OBX:ObservationIdentifier.identifier")
        
    $$$TRACE("obx@1.2 obx31:"_obx31)      
  
   set obx5= request.GetValueAt("ORCgrp(1).OBRuniongrp.OBXgrp("_k1_").OBX:ObservationValue(1)")
  
   $$$TRACE("obx@1.3 obx5:"_obx5) 
   
   $$$TRACE("OBX3:"_obx31)
   set pattern=".N"
    //if Data?.N    
   
       if (obx31?@pattern = 1) {   // valid ncid   529964330
          // get irefferal json tag
          set obx3Rep=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(obx31, context.IreferralContext, context.hddOpNm, .process) 
          if (obx3Rep '= "") {
              $$$TRACE("OBX3:ObsValRep: "_obx3Rep)
              set jsonTag=obx3Rep
               $$$TRACE("obx@1.4 jsonTag:"_jsonTag) 
          }

            // get context for obx5 hdd call
          set obx3Rep=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(obx31,  context.IreferralObx3Context, context.hddOpNm, .process) 
          
   
          if (obx3Rep'="") {
              $$$TRACE("obx3Context: "_obx3Rep)
              set obx5Context = $PIECE(obx3Rep,"|",2)
              set obx5Domain = $PIECE(obx3Rep,"|",3)
              
          
              set obx5Rep=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepByRep(obx5, context.IreferralObx5Context, obx5Domain, obx5Context, context.hddOpNm, .process) 
        
              if (obx5Rep'="") {
                  $$$TRACE("OBX5:ObsValRep: "_obx5Rep)
                  $$$TRACE("jsonTag="_jsonTag) 
                 do jsonObj.%Set(jsonTag,obx5Rep)
  
              }
          }
    
       } // pattern
   
     }   //for

        set context.jsonStr = jsonObj.%ToJSON() 
        $$$TRACE("OBX@009 jsonStr  :"_context.jsonStr )]]]]><![CDATA[>
