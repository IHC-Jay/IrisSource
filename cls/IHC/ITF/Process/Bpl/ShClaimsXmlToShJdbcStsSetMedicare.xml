 	 set reqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream)
 	 set reqObj.DestinationFileName = scheduleId_".xml"
	 set reqObj.DestinationFilePath = destinationFilePath_"BiztalkScheduler/Response"
	 try{
 	 	set tmpStatus = process1.SendRequestAsync(claimsResponseFileTargetConfigName,reqObj)
	 }catch(ex){
		 Set tmpStatus = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Unable to write to file path :"_destinationFilePath_"Error:"_ex)   			 
