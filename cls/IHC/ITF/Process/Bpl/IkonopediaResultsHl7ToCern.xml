		set context.msh6ncid=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(msh6Rep, context.FACILITYDOMAIN, context.INTERFACECONTEXT, context.hddTargetConfigName, .process)  	  	
		$$$TRACE(" Ncid MSH-6 is " _ context.msh6ncid)	
		if (context.msh6ncid= ""){
			set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, " RepToNcid hdd call failed for Hl7 field: [MSH-6]. REP: ["_msh6Rep_"]. DOMAIN: ["_context.FACILITYDOMAIN_"]. CONTEXT: ["_context.INTERFACECONTEXT_"].")
		}	
	}
       else
       {
	set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH-6 is blank so not processing the record.")
	
       }
       
       
       
   set k1=""
       For { 
                set k1=request.GetNextIndex("PIDgrpgrp(1).ORCgrp()",k1,.tSCTrans)  Quit:k1="" 
                
                
                
                // Get Ncid for ORC-1    
                     
                set orc1rep= request.GetValueAt("PIDgrpgrp(1).ORCgrp("_(k1)_").ORC:OrderControl") 
                if (orc1rep'= "")
  	        {				                                                                                      
                   set orc1ncid=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(orc1rep, context.ORDERCONTROLDOMAIN, context.ORDERCONTROLCONTEXT, context.hddTargetConfigName, .process)  	  	
		$$$TRACE(" Ncid ORC-1("_k1_") is " _ orc1ncid)	
		if (orc1ncid= ""){
			set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, " RepToNcid hdd call failed for Hl7 field: [ORC-1("_k1_")]. REP: ["_orc1rep_"]. DOMAIN: ["_context.ORDERCONTROLDOMAIN_"]. CONTEXT: ["_context.ORDERCONTROLCONTEXT_"].")
		}
		else
		{
		  do context.orc1ncidList.InsertAt(orc1ncid,k1)
		}	
	}
       
       
       
       
       
       // Get Ncid for OBR-4   
                     
                set obr4rep= request.GetValueAt("PIDgrpgrp(1).ORCgrp("_(k1)_").OBR:UniversalServiceID.identifier") 
