<code name='GetNcidFromRep' xpos='200' ypos='1150' >
<![CDATA[  
  	$$$TRACE(" Calling getNcidFromRep...")  
  	
  		
  	set msh6Rep = request.GetValueAt("MSH:ReceivingFacility.namespaceID")     	  	
  	if (msh6Rep '= "")
