			set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, " RepToNcid hdd call failed for Hl7 field: [OBR-4("_k1_")]. REP: ["_obr4rep_"]. DOMAIN: ["_context.EXAMCODEDOMAIN_"]. CONTEXT: ["_context.EXAMCODECONTEXT_"].")
		}
		else
