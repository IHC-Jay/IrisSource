<code name='SetCernerAndUofUMrns' xpos='200' ypos='650' >
<annotation><![CDATA[Get EMPI(CMRN and UofU)]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Setting Empi(CMRN and UofU)...") 
  set context.empiNumber=""
  set k1="",tSC=1 
 For { 
     Set k1=request.GetNextIndex("PIDgrp(1).PID:3()",k1,.tSCTrans)  Quit:k1=""          
     If (request.GetValueAt("PIDgrp(1).PID:3("_(k1)_").4.1")="EMPI") {
         Set context.empiNumber=request.GetValueAt("PIDgrp(1).PID:3("_(k1)_").1")              
     }
     If (request.GetValueAt("PIDgrp(1).PID:3("_(k1)_").4.1")= context.UofUMrnTypeNcid) {
         Set context.uofuMrnNumber=request.GetValueAt("PIDgrp(1).PID:3("_(k1)_").1")              
     }     
 }
 $$$TRACE("Cerner MRN " _ context.empiNumber) 
 $$$TRACE("UofU MRN " _ context.uofuMrnNumber) 
 
 if ($ISVALIDNUM(context.uofuMrnNumber)'="1"){	 
  set k1="",tSC=1 
  For { 
     Set k1=request.GetNextIndex("NTEgrp.ZBX()",k1,.tSCTrans)  Quit:k1=""               
     If (request.GetValueAt("NTEgrp.ZBX:("_(k1)_").3(1).1")="Sch U MRN") {
         Set context.uofuMrnNumber=request.GetValueAt("NTEgrp.ZBX:("_(k1)_").5")              
     }     
  }
 }
 ]]]]><![CDATA[>
</code>

