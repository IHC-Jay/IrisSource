<code name='SetCernerAndUofUAndAmWellMrns' xpos='200' ypos='650' >
<annotation><![CDATA[Get EMPI(CMRN and UofU, AmWell)]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Setting Empi(CMRN and UofU)...") 
  set context.empiNumber=""
  set k1="",tSC=1 
 For { 
     Set k1=request.GetNextIndex("PIDgrp(1).PID:3()",k1,.tSCTrans)  Quit:k1=""          
     If (request.GetValueAt("PIDgrp(1).PID:3("_k1_").4.1")="EMPI") {
         Set context.empiNumber=request.GetValueAt("PIDgrp(1).PID:3("_k1_").1")              
     }
     If (request.GetValueAt("PIDgrp(1).PID:3("_k1_").4.1")= context.UofUMrnTypeNcid) {
         Set context.uofuMrnNumber=request.GetValueAt("PIDgrp(1).PID:3("_k1_").1")              
     }
        
     Set mrnType =request.GetValueAt("PIDgrp(1).PID:3("_k1_").4.1")
     $$$TRACE("mrnType: " _ mrnType) 
     set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"GenericMrnTypeNcids",.genMrnTYpes) 
     if ($$$ISOK(pstatus)&&(genMrnTYpes '="")){    	
    	$$$TRACE("Value of Generic MRN TYpes="_genMrnTYpes)
    	if ($LISTFIND($LISTFROMSTRING(genMrnTYpes,","), mrnType) = 1) {	     
	      Set context.GenericMrnTypesFlag = 1
        }
 	 } 
 }
 $$$TRACE("Cerner MRN " _ context.empiNumber) 
 $$$TRACE("UofU MRN " _ context.uofuMrnNumber) 
 $$$TRACE("Generic MRN Type: " _ context.GenericMrnTypesFlag) 
 
 if ($ISVALIDNUM(context.uofuMrnNumber)'="1"){	 
   $$$TRACE("UofU MRN (ZBX check) " _ context.uofuMrnNumber) 
  set k1="",tSC=1 
  For { 
     Set k1=request.GetNextIndex("NTEgrp.ZBX()",k1,.tSCTrans)  Quit:k1=""      
     If (request.GetValueAt("NTEgrp.ZBX("_k1_"):3(1).1")="Sch U MRN") {	     
         Set context.uofuMrnNumber=request.GetValueAt("NTEgrp.ZBX("_k1_"):5")               
     }                       
  }
 }
 $$$TRACE(" ZBX (UofU mrn#) " _ context.uofuMrnNumber)
 ]]]]><![CDATA[>
</code>

