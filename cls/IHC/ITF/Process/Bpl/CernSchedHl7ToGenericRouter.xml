<code name='CheckIfFacilityIsMember' xpos='1010' ypos='2400' >
<![CDATA[ 
     set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.IsMemberResponse, "IsMemberMSH4")    
     if (hddObj '= ""){
	     set context.isFacMemberResp = hddObj.Rep   
	     $$$TRACE("Value of 'IsMemberMSH4' from Hdd lookup: " _ context.isFacMemberResp) 	
     }
    if (context.isFacMemberResp = "1") {                      
       $$$TRACE("Facility in MSH-4: ["_context.facNcid_"] is a member of UofU Domain: ["_context.hddFacilityDomainIsMember_"]") 
    }else{
