 <code name='Check XY/XZ test patient' xpos='200' ypos='2150' >
<annotation><![CDATA[Check XY/XZ Test patient record]]]]><![CDATA[></annotation>
<![CDATA[
 set context.isTestFacility = 0
 if (context.flagTestRecord = "Y") {
	 set completePid5 = request.GetValueAt("PIDgrp.PID:PatientName()")
	 //$$$TRACE("PID-5 value is: " _ completePid5)
	 //$$$TRACE("PID-5 List length: " _ $LISTLENGTH($LISTFROMSTRING(completePid5, "~")))
	 for iTarget=1:1:$LENGTH(completePid5, "~"){ 
		set tOneTarget=$ZStrip($PIECE(completePid5,"~",iTarget),"<>W") 
		//$$$TRACE("PID-5 value at iteration: " _ iTarget _ " is: " _ tOneTarget)
		set tOneTargetId=$ZStrip($PIECE(tOneTarget,"^",7),"<>W")
		//$$$TRACE("PID-5.7 value at iteration: " _ iTarget _ " is: " _ tOneTargetId)
        continue:""=tOneTargetId
        if ($LOCATE(context.nameTypesMatch,tOneTargetId) > 0){
	        set tOneTargetLName = $ZStrip($PIECE(tOneTarget,"^",1),"<>W")
	        for jTarget=1:1:$LENGTH(context.lastNamesMatch, ","){ 
	        	set jOneTarget=$ZStrip($PIECE(context.lastNamesMatch,",",jTarget),"<>W") 
				//$$$TRACE("LastNameMatch value at iteration: " _ jTarget _ " is: " _ jOneTarget)				
	        	if ($LOCATE($ZCONVERT(tOneTargetLName,"U"),$ZCONVERT(jOneTarget,"U")) = 1 ){
		        	set context.isTestFacility = 1
		        	quit
	        	}
	        }
        }        
	 }	 
 }
 $$$TRACE("Value of 'isTestFacility' from calculation: " _ context.isTestFacility) 
 ]]]]><![CDATA[>
