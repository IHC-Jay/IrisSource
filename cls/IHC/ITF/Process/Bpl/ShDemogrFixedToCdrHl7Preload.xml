<code name='code for firstname checking' xpos='200' ypos='1050' >
<annotation><![CDATA[validating firstname]]]]><![CDATA[></annotation>
<![CDATA[  set context.modfirstname=$ZSTRIP(request.firstname,"<>W")
 
  set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ShDemogrFixedToCdrHl7Preload.Lookup.INVALID_FIRST_NAMES",context.modfirstname, .retVal )
  $$$TRACE("retVal for lookup:"_retVal_retStat)
  set RegExPattern=$MATCH(request.firstname,"^[a-zA-Z0-9,'-_\s]+$")
  set checkpattern=$MATCH(request.firstname,"^BABY.+$")
  
  if context.modfirstname=""
 {
 Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"SKIP THE RECORD firstname is empty")
 quit
  }
 else
 {
 s dotcheck=$E(request.firstname,1)
 if dotcheck '= "."
 {
  Set context.modfirstname=$Replace(request.firstname,"."," ")
 $$$TRACE("nodified firstname:"_context.modfirstname)
 }
 if ((retVal = "1")||(RegExPattern="0")||(checkpattern="1"))
 {
 Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"SKIP THE RECORD first name is not valid")
 quit 
 }

 }
 
]]]]><![CDATA[>
