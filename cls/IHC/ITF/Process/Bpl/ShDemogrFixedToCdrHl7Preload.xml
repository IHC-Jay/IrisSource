<code name='code for checking middlename lastname and ssn' xpos='200' ypos='1150' >
<annotation><![CDATA[validating firstname,firstname with middlename,middlename and lastnamethen skip the record. Validating the ssn and dateofbirth]]]]><![CDATA[></annotation>
<![CDATA[  set context.middlename=$ZSTRIP(request.middlename,"<>W")
  set context.lastname=$ZSTRIP(request.lastname,"<>W")
 //Invalid firstnames and mid names set lookup table
  set retStatofFNMN= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ShDemogrFixedToCdrHl7Preload.Lookup.INVALID_FIRST_NAMES_MIDNAME_TEST",context.modfirstname, .retValofFNMN )
  $$$TRACE("retStatofFNMNfor lookup:"_retValofFNMN_retStatofFNMN)
  //Invalid middlenames lookup table
  set retStatofMN= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ShDemogrFixedToCdrHl7Preload.Lookup.INVALID_MIDDLE_NAMES",context.middlename, .retValofMN )
  $$$TRACE("retStatofFNMNfor lookup:"_retValofMN_retStatofMN)
  //invalid last anmes lookup table
  
  set retStatofLN= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.ShDemogrFixedToCdrHl7Preload.Lookup.INVALID_LAST_NAMES",context.lastname, .retValofLN )
  $$$TRACE("retStatofFNMNfor lookup:"_retValofLN_retStatofLN)
  
  set RegExPatternLN=$MATCH(request.lastname,"^[a-zA-Z0-9,'-_\s]+$")



 //validate firstname with middle name
 
  if context.middlename=""
  {
   if ($Length(context.modfirstname)="1")
   {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"SKIP THE RECORD Firstname is a single char&&Middle name is empty")
   quit
   }
   if retValofFNMN ="1" 
   {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"SKIP THE RECORD Firstname is a invalid when middle name is empty")
   quit
   
   }
 }
 
 //validate  middlename and lastname 
  if ((retValofMN ="1")||(context.lastname=""))
  {
  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"SKIP THE RECORD Invalid middlename(can not be TEST XTEST) or Last name should not be empty")
   quit
  }
  else
  {
  s dotcheckLN=$E(context.lastname,1)
 if dotcheckLN '= "."
 
  set context.lastname=$REPLACE(request.lastname,"."," ")
   if ((retValofLN ="1")||(RegExPatternLN="0"))
   {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"SKIP THE RECORD Invalid lastname or last name contains non alpha dash astrop")
   quit

   
   }
  }
 
 
  set context.ssn=request.ssn
  $$$TRACE("ssn:"_context.ssn)
  s issamedigitssn=$MATCH(context.ssn,"^(0{9}|1{9}|2{9}|3{9}|4{9}|5{9}|6{9}|7{9}|8{9}|9{9})$")
  s isnondigit=$MATCH(context.ssn,"^*[0-9]*$")
  if issamedigitssn="1"
  {
  Set context.BadSSN="true"
  $$$TRACE(" Bad SSN - contains all same digit")
  
  }
  if ((issamedigitssn="0")&&(isnondigit="0"))
  {
  Set context.BadSSN="true"
  $$$TRACE(" Bad SSN -  Bad SSN - contains non digit")
  }
  else
  {
   if (($LENGTH(context.ssn)>0) && (context.ssn<500))
   {
    Set context.BadSSN="true"
  $$$TRACE(" Bad SSN - that ssn is less than 500")
   }
  
  }

  
 
   //set context.birthdatetime=request.birthdatetime
 //$$$TRACE("birthdatetime:"_context.birthdatetime)
 if ($L(request.birthdatetime)>8)
 {
 Set context.dob=($E(request.birthdatetime,0,8))
 $$$TRACE("context.dob:"_context.dob)
 }

 
 
 
 
 
    

 
 
 
 
 
 
 
 
 
  
    
]]]]><![CDATA[>
