<annotation><![CDATA[calling CDR operation]]]]><![CDATA[></annotation>
<![CDATA[ // Call MMI Add - Tuxedo Operation, Build the request
 $$$TRACE("INSIDE CALL MMI ADD")   
   set mmiAddRequest=##class(IHC.ITF.ITFCOMMON.Request.Hl7AddUpdateMmiStructure).%New()
   set mmiAddRequest.hl7Msg = context.Hl7response
   $$$TRACE("context.Hl7response in Call MMI code block:"_context.Hl7response)
   $$$TRACE(" Target Operation MmiHl7Add: " _ context.targetList.GetAt(1))
   set tStatus=process.SendRequestSync(process.TargetOperationForCdrCall,mmiAddRequest,.cdrResponse,"2700")
   $$$TRACE("tStatus in call MMI block:"_tStatus)
   if (tStatus = $$$OK)
   {
	  $$$TRACE("RESPONSE: " _ cdrResponse.StringValue)   
	  $$$TRACE("MEMBER DATA SUCCESSFULLY STORED INTO CDR LIVE FEED")  	  
   	   
	  
	   
   }
   else
   { $$$TRACE("MEMBER DATA NOT ABLE TO STORE INTO CDR")
	    set errText = $SYSTEM.Status.GetOneErrorText(tStatus)
	    if errText["CONNECTIONERROR"
	    {
		   //set status=$$$ERROR("ITFCOMMON:10107",$SYSTEM.Status.GetOneErrorText(tStatus))      //Retry max times and disable
		   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),errText)
	    }	    
	    	       
   } 
 	   	  
	   	   
	   	   	
   	]]]]><![CDATA[>
