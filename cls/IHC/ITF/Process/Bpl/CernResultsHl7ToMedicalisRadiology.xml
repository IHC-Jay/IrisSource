<code name='setup general hdd lookup' xpos='200' ypos='850' >
<annotation><![CDATA[Prepare RepFromNcid values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object") 

 set context.facId = request.GetValueAt("MSH:SendingFacility.namespaceID")  	
 if (context.facId '= "" && $ISVALIDNUM(context.facId)= "1") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.hddContextCernerToIhcLocation, "MSH4:Facility")  	  	
     $$$TRACE("Hdd Request MSH-4 Sending Facility is " _ context.facId )     		
 } else {
     // Skip message if MSH-4 is empty or invalid ncid
     set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH-4 Sending Facility ncid is empty or inalid. Skipping the record.")	 
 }
 
 set pid8Sex = request.GetValueAt("PID:Sex")  	
 $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)
 if (pid8Sex '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid8Sex, context.hddContextHelp, "PID8:Sex")  	  	
     $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 }
  
 set pid3DI = request.GetValueAt("PID:PatientDeathIndicator")  	
 if (pid3DI '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid3DI, context.hddContextHelp, "PID30:DeathIndicator")
     $$$TRACE("Hdd Request PID-30 Death Indicator is " _ pid3DI)     		
 }
 
  set patClass = request.GetValueAt("PV1:PatientClass")  	
 if (patClass '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, patClass, context.hddContextHelp, "PV12:Class")  	  	
     $$$TRACE("Hdd Request PV1-2 Patient Class is " _ patClass)     		
 }
 
 set pv13Pc= request.GetValueAt("PV1:AssignedPatientLocation.pointofcare")  
 if (pv13Pc'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv13Pc, context.hddContextCerner, "PV131:PC")  	  	
     $$$TRACE("Hdd Request PV1-3.1Point of Care is " _ pv13Pc)     		
 }

 set pv13Room= request.GetValueAt("PV1:AssignedPatientLocation.room")  
 if (pv13Room'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv13Room, context.hddContextCerner, "PV132:Room")  	  	
     $$$TRACE("Hdd Request PV1-3.2 Room is " _ pv13Room)     		
 }
 
 set pv13Bed= request.GetValueAt("PV1:AssignedPatientLocation.bed")  
 if (pv13Bed'="") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv13Bed, context.hddContextCerner, "PV133:Bed")  	  	
     $$$TRACE("Hdd Request PV1-3.3 Bed is " _ pv13Bed)     		
 }
 
 set pv134Fac= request.GetValueAt("PV1:3.4")  
 if (pv134Fac'="") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv134Fac, context.hddContextCerner, "PV134:Fac")  	  	
     $$$TRACE("Hdd Request PV1-3.3 Bed is " _ pv134Fac)     		
 }
 
 set obr4SvcId = request.GetValueAt("OBR:4.1") 
 set context.svcId=obr4SvcId
 $$$TRACE("Hdd Request OBR-4 Service id is " _ obr4SvcId)
 if (obr4SvcId '= "" && $ISVALIDNUM(obr4SvcId)= "1") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr4SvcId, context.hddExamCodeContext, "OBR4:USId")  	  	
     $$$TRACE("Hdd Request OBR-4 Service id is " _ obr4SvcId)     		
 }
 else {
    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "OBR-4.1 is Null or invalid NCID, Skipping the record.")
 }

  set obr25ResStatus = request.GetValueAt("OBR:25")  	
 if (obr25ResStatus '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr25ResStatus, context.hddResultStatusContext, "OBR25:ResultStatus")  	  	
     $$$TRACE("Hdd Request OBR-25 ResultStatus is " _ obr25ResStatus )     		
 }
 
 set k1="",tSC=1 
 For { 
     Set k1=request.GetNextIndex("OBXgrp()",k1,.tSCTrans)  Quit:k1=""          
     set obx11Ncid = request.GetValueAt("OBXgrp("_k1_").OBX:ObservationResultStatus")
     if (obx11Ncid '= ""){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obx11Ncid,  context.hddResultStatusContext, "OBX11:ResStatus"_k1)  	$$$TRACE("Hdd Request OBX-11(Status Ncid) is " _ obx11Ncid)		
     }     
  }

 $$$TRACE(" After setting all NCID values")  
 ]]]]><![CDATA[>
