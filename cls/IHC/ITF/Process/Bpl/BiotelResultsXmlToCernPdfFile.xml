<transform name='set context variables' class='IHC.ITF.Transform.Dtl.BiotelResultsXmlToCernPdfFile' source='request' target='response' xpos='200' ypos='550' />
<code name='Get PDF file and encode to stream' xpos='200' ypos='650' >
<![CDATA[  set fileName = $P($P(request.Source,"/",*),".",1)
  set pdfDirectory = $P(request.Source,"/",1,*-1)
  set fullPdfPath = pdfDirectory_"/"_fileName_".pdf"
  $$$TRACE("File: "_fullPdfPath)
  set tInputFile=##class(%Stream.FileBinary).%New()
  set tInputFile.Filename=fullPdfPath
  set context.PdfStream = ##class(Ens.StreamContainer).%New()
  set tmpPdfStream = ##class(%Stream.GlobalCharacter).%New()
  $$$TRACE("Done setting pdf stream.")
  while ('tInputFile.AtEnd) {
     do tmpPdfStream.Write(tInputFile.Read(5700))
  }
  $$$TRACE("Done reading in stream: "_tmpPdfStream.Read())
  set fileName = "Biotel^"_context.ReportDate_"^" _context.Mrn_"^"_context.Fin_"^2820625^"_context.ReportDate_"^00-00-00^CPDI^"_"2820625^"_context.MessageDate_".pdf"
  $$$TRACE("Filename: "_fileName)
  do tmpPdfStream.Rewind()
  set context.PdfStream.Stream =tmpPdfStream
  $$$TRACE("Streamcontainer set: "_context.PdfStream.Stream)
  set context.PdfStream.OriginalFilename = $ZSTRIP(fileName, "*W")
  do context.PdfStream.%Save()
  do ##class(%File).Delete(fullPdfPath)
]]]]><![CDATA[>
