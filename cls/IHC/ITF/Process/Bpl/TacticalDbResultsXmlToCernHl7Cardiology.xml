<code name='createHddRequests GetNcidFromRep' xpos='740' ypos='2300' >
<![CDATA[
  	$$$TRACE(" GetNcidFromRep Hdd Requests...")
  	set context.hddNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()  	
  	
  	set sendingFacility = request.Get("ASSIGNING_FACILITY")
  	$$$TRACE(" Sending Facility rep value: " _ sendingFacility)	
  	if (sendingFacility '= ""){
	  Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , sendingFacility,  context.hddFacilityDomain, context.hddInterfaceContext, "MSH4:SendingFacility")  	  	 	
  	}else{
	   set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Sending Facility is empty. Skipping the record. CardioResultId: ["_cardioResultId_"] AccessionNumber: ["_accessionNo_"]")  	
	}
	
	set examCodeDesc = request.Get("EXAM_CD")
	$$$TRACE(" Sending ExamCode Rep value: " _ examCodeDesc)	
  	if (examCodeDesc '= ""){
	  Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , examCodeDesc,  context.hddExamCodeDomain, context.hddExamCodeContext, "OBR:ExamCode")  	  	 	
  	}
	
]]]]><![CDATA[>
