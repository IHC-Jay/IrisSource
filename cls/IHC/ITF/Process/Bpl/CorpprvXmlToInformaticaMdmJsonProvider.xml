    $$$TRACE("MDMOrgRestOperation JSON string: "_json)             
    set jsonProcessRequest=##class(Ens.StringContainer).%New()
    set rootStr = "{""root"":"
    if (json [ rootStr)
    {
       set jsonProcessRequest.StringValue= ##class(Ens.Util.FunctionSet).SubString(json, $LENGTH(rootStr) + 1, $LENGTH(json)-1)
    }
    else
    {
