<code name='Converting XML to JSON Operation' xpos='335' ypos='700' >
<![CDATA[ $$$TRACE("Converting MDMOrgRestOperation XML to JSON Operation.. ")
    set context.orgJsonStrReq = ##class(Ens.StringRequest).%New()	       
