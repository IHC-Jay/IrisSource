<code name='Call the REST service to get attending doctor info' xpos='200' ypos='950' >
<![CDATA[ $$$TRACE("Call REST Operation")
  if (context.icentraSvcRequest'="") {
    set statusLine=""
    set statusCode=""
    set statusDesc=""
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync("Op-CernEdge-Wsrc-ATTENDINGDOCTOR",context.icentraSvcRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set context.restHttpResponse=httpRESTResponse
      set statusLine=context.restHttpResponse.HTTPHeaders.GetAt("StatusLine")
      if (statusLine'=""){
	set statusCode=$piece(statusLine," ",2)
	set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
		  // If status code is 200 the check the reponse to see if it got processed correctly or not
      if (statusCode'="200"){
        set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"iCentra Attending Doctor search service response with code: "_statusCode_"  Desc: "_statusDesc) 
      }
      else {
        Set tcharStream = ##class(%GlobalCharacterStream).%New()
        Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
        $$$TRACE("tcharStream size:"_tcharStream.Size)
        set text=""
        While 'tcharStream.AtEnd {
          Set text = text_tcharStream.Read($$$MaxStringLength)
        } 
        $$$TRACE("REST service response: "_text)
        If ($$$IsdefObject(tcharStream)) {
	  Do tcharStream.Rewind()
	  Set tConsumedJSON = ##class(%Library.DynamicAbstractObject).%FromJSON(tcharStream)
	  $$$TRACE("Status Message: "_tConsumedJSON.%Get("message"))
	  set iter = tConsumedJSON.%GetIterator()
	  set statusKey=""
	  set statusCode=""
	  #dim statusIter As %Iterator.Object
	  #dim detailIter As %Iterator.Array
	  do iter.%GetNext(.key , .value )
	  set iter = value.%GetIterator()
	  while iter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="service-status" {
	        set statusIter=value.%GetIterator()
	     }
	     elseif ((key="code") && (statusKey="service-status")) {
	       set statusCode=value
	     }
	     if key="status-details" {
	        if value'="" {
                  set detailIter = value.%GetIterator()
                }
                else {
                  set status=##class(IHC.ITF.ITFCOMMON.Utility).ProcessErrorExt(process.%ConfigName,"iCentra Attending Doctor search service did not find the Attending Doctor for this FIN: "_fin)
	          quit
                }
	     }
	     else {
	        continue
	     }
	  }
	  while statusIter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="code" {
	        set statusCode=value
	        if statusCode="000" {
	          while detailIter.%GetNext(.key , .value ) {
	            $$$TRACE("key = "_key_" , value = "_value)
	            set dtlItter=value.%GetIterator()
	            while dtlItter.%GetNext(.key , .value ) {
	               if key="NAME-FULL-FORMATTED" {
	                 $$$TRACE("FULL NAME: "_value)
	                 if value'="" {
	                   do context.attPrvdrLnms.Insert($P(value,",",1))
	                   do context.attPrvdrFnms.Insert($ZSTRIP($P(value,",",3),"<>W"))
	                   do context.attPrvdrMnms.Insert($ZSTRIP($P(value,",",2),"<>W"))
	                 }
                         else {
                            $$$TRACE("Full Name is null...")
                         }
	               }
	               elseif key="PROVIDER-ID" {
	                  $$$TRACE("key = "_key_" , value = "_value)
	                  do context.attPrvdrIds.Insert(value)
	               }
	            }
	          }
	          if context.attPrvdrIds.Size=0 {
	             set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"iCentra Attending Doctor search service does not find the attending doctor.")
	             quit
	          }
	        }
	        else {
	          set status=##class(IHC.ITF.ITFCOMMON.Utility).ProcessErrorExt(process.%ConfigName,"iCentra Attending Doctor search service failed with Status: "_value)
	          quit
	        }
	     }
	  }
        }
	$$$TRACE("REST Service response Status Code: "_statusCode)
      }
    }
    ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Post iCentra Attending Doctor search service request failed with Status Code: "_statusCode_" : Status Desc: "_statusDesc) 
    }
  }]]]]><![CDATA[>
