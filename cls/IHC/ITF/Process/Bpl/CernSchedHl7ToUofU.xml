<code name='GetTheLowestUofU' xpos='200' ypos='650' >
<annotation><![CDATA[Get the Lowest UofU MRN]]]]><![CDATA[></annotation>
<![CDATA[ 
  set uofuMrnNumber=""
  set k1="",tSC=1 
 For { 
     Set k1=request.GetNextIndex("PIDgrp(1).PID:3()",k1,.tSCTrans)  Quit:k1=""          
     
     If (request.GetValueAt("PIDgrp(1).PID:3("_(k1)_").4.1")="520912268") {
         Set uofuMrnNumber=request.GetValueAt("PIDgrp(1).PID:3("_(k1)_").1")_":"_uofuMrnNumber           
     }     
 } 
 if (uofuMrnNumber '= ""){
 $$$TRACE("UofU MRN " _ uofuMrnNumber) 
 set uofuMrnList = $LISTFROMSTRING(uofuMrnNumber, ":")
 set uofuMrnListLength = $LISTLENGTH(uofuMrnList) 
 
 Set lowUofUMrn = $List(uofuMrnList,1)
 For i=2:1:uofuMrnListLength {	 
	Set piece = $List(uofuMrnList,i)
	$$$TRACE(" Piece " _ piece) 
	 if (piece ]] lowUofUMrn){		 
	   $$$TRACE(" true ") 	 	   
	 }else{
		 $$$TRACE(" false ") 	 
		 if (piece > 0){
		   Set lowUofUMrn = piece
		   $$$TRACE( " MRN: " _lowUofUMrn)
		 }
	 }
}
   $$$TRACE(" Lowest UofU MRN " _ lowUofUMrn) 
   set context.UofUMrn = lowUofUMrn
 }
 ]]]]><![CDATA[>
</code>

