<code name='getUniqueChild' xpos='200' ypos='750' >
<annotation><![CDATA[getUniqueChild]]]]><![CDATA[></annotation>
<![CDATA[  
    
     set apptTypeNcid = request.GetValueAt("SCH:7.1")
     set parentNcidFieldName = "SCH-7.1"
     set relationshipNcid ="529994998"
     set contextNcid = "529994973"
     
     try{
	      $$$TRACE(" Calling getUniqueChild()" )
          set status = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getUniqueChild(apptTypeNcid, parentNcidFieldName, relationshipNcid, contextNcid, context.hddNewTargetConfigName, .process, .retStr)
          set context.UofUVisitTypeId = retStr
		  $$$TRACE(" retStr: " _ retStr)
		  if (retStr=""){
			  set context.UofUVisitTypeId = "3446"
			  set notificationMsg = "iCentra ApptType ncid in SCH-7.1 : ["_apptTypeNcid_"] does not have relationship NCID "_relationshipNcid_" Context Ncid: "_contextNcid_" [Has Epic Appointment Type] in HDD.  Assigning default UofU/Epic VisitType 3446. Please map to appropriate UofU/Epic VisitType from Domain NCID: 529996128."
			  Set emailAlertRequest=##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError("iCentra Scheduling to UofU", notificationMsg, process.%ConfigName) 					       		
		      set status = process.SendAlert(emailAlertRequest)
		  }
     }catch(exVar){
	     set exVarData = $ZSTRIP(exVar.Data,"*C")	     
	     $$$TRACE(" exVarData --> "_exVarData_ " exVar.Code -->"_exVar.Code)
	     set context.UofUVisitTypeId = "3446"
	     if exVar.Code [ "ITFCOMMON:10108" {
		     $$$TRACE("  Assigning default UofUVisitTypeId 3446. ")
		    set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,exVarData_". Using default UofUVisitTypeId 3446.")
	   	 }elseif(exVar.Code [ "ITFCOMMON:10109") {	
	   	     // Hdd data error. Complete. Send default UofUVisitTypeId to UofU	   	 
		     set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName,exVarData_". Using default UofUVisitTypeId 3446.")
		 }elseif(exVar.Code [ "ITFCOMMON:10106") {		
		     //Data retrieval error in HDD . Retry and Complete. Send default UofUVisitTypeId to UofU
		    set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,exVarData_". Using default UofUVisitTypeId 3446.")		  
		 }elseif(exVar.Code [ "ITFCOMMON:10103") {		   	 
		    set status = ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName,exVarData_". Using default UofUVisitTypeId 3446.")		  
		 }elseif(exVar.Code [ "ERROR #6242") {		   	 
		    set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,exVarData)		  
		 }else{
			 //Any other Unexpected error
			 set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Shutting down..Unknown Error."_exVarData)
		 }
	 }   
  ]]]]><![CDATA[>
