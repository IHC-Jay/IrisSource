<![CDATA[ set fileHeader= request.GetValueAt("FHS:Filecreationdatetime.timeofanevent")
 set facilityReport = "Facility Batch Record Counts:"
 $$$TRACE("Inside Code block send to router")     
 
 set fileKey = $g(^IHC.Sunquest.SplitHl7Key("FileName"))
 
 if fileKey '= ""{
 //Loop through the global
 set facKey = $ORDER(^IHC.Sunquest.StoreBatchHl7(fileKey,""))
 
 while (facKey'=""){
    set idKey = $ORDER(^IHC.Sunquest.StoreBatchHl7(fileKey,facKey,""))
    set facCount = 0
    while (idKey'=""){
      //Increment the Fac Count
      set facCount = facCount+1		
      set parent = ##class(EnsLib.HL7.Message).%OpenId(idKey)
      if $ORDER(^IHC.Sunquest.StoreBatchHl7(fileKey,facKey,idKey))=""{
      set facilityReport = facilityReport_$C(13,10)_"Facility ("_facKey_") Record Count:"_facCount
        // Indicate this a Last record
         //Create BTS String
          set BTSeg="BTS|"_facCount_"|"_facKey_"|"_facCount_"^0^0^0|"
          set BTSegX = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&"_BTSeg))  
          set clone = parent.%ConstructClone()       
          set status = clone.AppendSegment(BTSegX)
          do clone.%Save()
          $$$TRACE("Clone:"_clone.OutputToString())                         
          //Send the Message to Router
          set tStatus=process.SendRequestAsync(process.TargetConfigNames,clone)                          
      }else{        
        $$$TRACE("Output:"_parent.OutputToString())
         set tStatus=process.SendRequestAsync(process.TargetConfigNames,parent)  
      }
      set idKey = $ORDER(^IHC.Sunquest.StoreBatchHl7(fileKey,facKey,idKey))
    }
    set facKey = $ORDER(^IHC.Sunquest.StoreBatchHl7(fileKey,facKey))
 }
 
 //Instead of sending the entire file send only the FHS and FTS 
 set fhsSeg = request.GetValueAt("FHS")
 set ftsSeg = request.GetValueAt("FTS")
 
 //Create a new Message
 set fhsMsg= ##class(EnsLib.HL7.Message).ImportFromString(fhsSeg) 
 //Add Fts Segment
 set ftsSegx = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&"_ftsSeg))   
 set status = fhsMsg.AppendSegment(ftsSegx)
 set fhsMsg.DocType="2.3:FHS"
 do fhsMsg.%Save()
 
 set tStatus=process.SendRequestAsync(process.TargetConfigNames,fhsMsg)
 }]]]]><![CDATA[>
