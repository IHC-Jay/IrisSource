<code name='To Update Fee Schedule' xpos='1280' ypos='2050' >
<![CDATA[ set feeScheduleUpdated=0
 set newCloneId=""
 set transAlt=request.GetValueAt("FT1(1):Transactiondescriptionaltern")
 $$$TRACE("Afternate:"_transAlt)
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestBillingHl7.SunquestLocAndTestCodeToTelcorLoc",transAlt,.tfeeSchedule)
    if ($$$ISOK(tStatus)){
        set cloneMsg = request.%ConstructClone()          
        set s = cloneMsg.SetValueAt(tfeeSchedule,"FT1(1):Feeschedule")
        do cloneMsg.%Save()
        set feeScheduleUpdated = 1
        set newCloneId =cloneMsg.%Id()
        $$$TRACE("FeeSchedule:"_tfeeSchedule)       
        $$$TRACE("Updated Fee Schedule"_cloneMsg.OutputToString())
     }else{
        //Reset the values 
        set feeScheduleUpdated=0
        set newCloneId=""
     }
    ]]]]><![CDATA[>
