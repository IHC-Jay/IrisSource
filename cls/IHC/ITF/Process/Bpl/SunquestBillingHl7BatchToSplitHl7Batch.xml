<code name='Store Each MSH' xpos='1280' ypos='2150' >
<![CDATA[  $$$TRACE("feeScheduleUpdated:"_feeScheduleUpdated_"  "_"newCloneId:"_newCloneId)
  //Check and see if this is the first message in the file
  set isExist=$DATA(^SplitHl7CurFileName("FileName")) 
  $$$TRACE("isExist:"_isExist) 
   if 'isExist{
     set ^SplitHl7CurFileName("FileName") = $ZDATETIME($ZTIMESTAMP,3,1,6)  
  } 
  $$$TRACE("splitHl7CurFileName:>>"_^SplitHl7CurFileName("FileName"))
  
  //Key will be the combination of Facid and the date of the first message
  
  Set id = context.batchFacilityID_$g(^SplitHl7CurFileName("FileName")) 
  set isExists = ##class(IHC.ITF.Process.Bpl.SunquestBillingHl7.StoreBatchHl7).%ExistsId(id)
  
  if 'isExists {
      $$$TRACE("This Faclility Id is for the First Time")
      set facId=##class(IHC.ITF.Process.Bpl.SunquestBillingHl7.StoreBatchHl7).%New()
      set facId.Id = id
      set facId.FacilityId=context.batchFacilityID
      if (feeScheduleUpdated) && (newCloneId '="") {
      $$$TRACE("Messgae from Clone:"_##class(EnsLib.HL7.Message).%OpenId(newCloneId).OutputToString())
        do facId.Hl7Message.Insert(newCloneId)
      }else{
        do facId.Hl7Message.Insert(request.%Id())
      }
      do facId.%Save()      
      //Check if the Global is Present
      set ifGlobalExist = $DATA(^SunQuestBatchHL7("allIds"))      
      //If the Global is not present
      if 'ifGlobalExist{
          //Create and add
          set ^SunQuestBatchHL7("allIds") = $LISTBUILD(id)
      }else{
           //If present Update the List
           set listId = $g(^SunQuestBatchHL7("allIds"))
           $$$TRACE("Count:"_$LISTLENGTH(listId))
           //Set the end length
           set endLen = $LISTLENGTH(listId)+1         
           //Append the Id to the Last
	   set $LIST(listId,endLen) = id
	   //Set the value back to Global
	   set ^SunQuestBatchHL7("allIds") = listId
      }      
  }else{
   $$$TRACE("Another Facility ID")
   Set facId = ##class(IHC.ITF.Process.Bpl.SunquestBillingHl7.StoreBatchHl7).%OpenId(id)
   if (feeScheduleUpdated) && (newCloneId '="") {
      do facId.Hl7Message.Insert(newCloneId)
     }else {
      do facId.Hl7Message.Insert(request.%Id())
     }
     do facId.%Save()    
    
  }
  ]]]]><![CDATA[>
