<code name='Send to Router' xpos='470' ypos='1350' >
<![CDATA[ $$$TRACE("Inside Code block send to router")     
     set listId = $g(^SunQuestBatchHL7("allIds"))
       $$$TRACE("Global Length"_$LISTLENGTH(listId))          
      for i=1:1:$LISTLENGTH(listId){
             $$$TRACE("Id in Global:"_$LIST(listId,i))
             set isExists = ##class(IHC.ITF.Process.Bpl.SunquestBillingHl7.StoreBatchHl7).%ExistsId($LIST(listId,i))
               $$$TRACE("If Id Exists:"_isExists)
  if isExists {  
                //If the Id Exist
                Set facId = ##class(IHC.ITF.Process.Bpl.SunquestBillingHl7.StoreBatchHl7).%OpenId($LIST(listId,i))
                $$$TRACE("Fac Id in Table:"_facId.FacilityId)                
               set count = 1        
               Set listOfIds = facId.Hl7Message        
               $$$TRACE("Fac Id Count:"_listOfIds.Count())
               for ids=1:1:listOfIds.Count(){            
                    set parent = ##class(EnsLib.HL7.Message).%OpenId(listOfIds.GetAt(ids))
                    if count=listOfIds.Count(){
                         $$$TRACE("Inside final Record") 
                         //Create BTS String
                         set BTSeg="BTS|"_listOfIds.Count()_"|"_facId.FacilityId_"|"_count_"^0^0^0|"
                         set BTSegX = ##class(EnsLib.HL7.Segment).%New($LB(,0,,"|^~\&"_BTSeg))  
                         set clone = parent.%ConstructClone()       
                         set status = clone.AppendSegment(BTSegX)
                         do clone.%Save()
                         $$$TRACE("Clone:"_clone.OutputToString())                         
                         //Send the Message to Router
                         set tStatus=process.SendRequestAsync(process.TargetConfigNames,clone,.Response)                          
                   }else{
                        //Send the Message to Router  
                        set tStatus=process.SendRequestAsync(process.TargetConfigNames,parent,.Response)  
                        $$$TRACE("Output:"_parent.OutputToString())
                    }
                    set count = count+1
               }    
            }
          }
          //Once the Split is sent, send the FTS messgae
          set tStatus=process.SendRequestAsync(process.TargetConfigNames,request,.Response)  
          ]]]]><![CDATA[>
