<code name='Store Each MSH' xpos='1280' ypos='2150' >
<![CDATA[  $$$TRACE("feeScheduleUpdated:"_feeScheduleUpdated_"  "_"newCloneId:"_newCloneId)
  //Check and see if this is the first message in the file
   set isExist=$DATA(^IHC.Sunquest.SplitHl7Key("FileName")) 
  $$$TRACE("isExist:"_isExist) 
   if 'isExist{
     set ^IHC.Sunquest.SplitHl7Key("FileName") = $ZDATETIME($ZTIMESTAMP,3,1,6)  
  } 
  $$$TRACE("splitHl7CurFileName:>>"_^IHC.Sunquest.SplitHl7Key("FileName"))
  
