    if (feeScheduleUpdated) && (newCloneId '="") {
        set id = newCloneId
      }else{
        set id = request.%Id()
      }
      
      set key = $g(^IHC.Sunquest.SplitHl7Key("FileName"))
     
  $$$TRACE("Key:"_key)
  set ^IHC.Sunquest.StoreBatchHl7(key,context.batchFacilityID,id)=id
