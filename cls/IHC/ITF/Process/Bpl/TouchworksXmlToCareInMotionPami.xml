<code name='Get Clinical Doc' xpos='200' ypos='750' >
<![CDATA[    // <Document id="urn:uuid:7514ad34-90bd-4815-a8d9-de7e2dc5b136"><xop:Include 
    // href="cid:http://tempuri.org/1/637744707611774879"
    // Get Clin ID from Document section
     
    set docStart = $FIND(fileData, "Document id")
    set hrefStart = $FIND(fileData, "tempuri.org/1/", docStart)
    set context.clinID = $EXTRACT(fileData, hrefStart, $FIND(fileData, """", hrefStart) - 2 )
    $$$TRACE("Clin ID: " _ context.clinID)
    
    set direc = ##class(%File).GetDirectory(request.OriginalFilename)
    $$$TRACE("Looking for Clinical file in " _ direc _ ", Inbound filename: " _ request.OriginalFilename)
   set clinFileNm = direc _"/ClinicalDocument_" _ context.clinID
   set clinData = ""
    If ##class(%File).Exists(clinFileNm )
    {
       $$$TRACE( "clin File exists: " _ clinFileNm )
    
       Set clinFile=##class(%File).%New(clinFileNm)
	$$$TRACE("Clin doc size: " _ clinFile.Size)
	Do clinFile.Open("R")
	Do clinFile.Rewind()
	
	Do
	{
	   set len = 32000
		set data = clinFile.Read(.len, .sc)
		
		$$$TRACE("Read file: "_ data _ ", stat: " _ sc )
		set clinData = clinData _ data
	} while ( $L(clinData) < clinFile.Size)
        Do clinFile.Close()
  
        $$$TRACE( "Process clinData: " _ $L(clinData))
   }
   else
   {
    set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Clinical Document not found: " _ clinFileNm _" Clin ID: " _  context.clinID) 
   }]]]]><![CDATA[>
