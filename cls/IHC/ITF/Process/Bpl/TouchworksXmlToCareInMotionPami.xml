<code name='Read inbound stream' xpos='200' ypos='650' >
<![CDATA[ if ( ('$ISOBJECT(request.Stream)) || (request.Stream.Size <= 0) )
 {
    set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "No data in the Stream, filename: " _ request.OriginalFilename) 
      
 }
 else
 {
   $$$TRACE(request.Stream _ " - stream of size: " _ request.Stream.Size) 
 
   set fileData = ""
   set stream = request.Stream
   While 'stream.AtEnd 
    {
	 set len = 32000
	 set data = stream.Read(.len, .sc)		
	 $$$TRACE("Read: stat: " _ len) 
	 set fileData = fileData _ data
	 if ( $L(fileData ) >= request.Stream.Size)
		 QUIT
	} 

     $$$TRACE("Inbound Data: " _ $L(fileData))
  }
    ]]]]><![CDATA[>
