<code name='Get IdxID from TW Database' xpos='200' ypos='850' >
<![CDATA[    set pidStart = $FIND(fileData, "<rim:Value>PID-3")
    set pid3End = $FIND(fileData, "</rim:Value>", pidStart)
    set context.organizationMrn = $EXTRACT(fileData, pidStart+1, $FIND(fileData, "^", pidStart)-2)
    $$$TRACE( "PID-3: " _ pidStart _", " _ pid3End _": " _ context.organizationMrn)
    
     if (context.organizationMrn = "")
     {
       set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "PID-3 is Empty  from Inbound organizationMrn : " _ context.organizationMrn) 
      }
      else
      {
    
        // Call context.TwDbOpName
 	$$$TRACE("Calling: " _ context.TwDbOpName)
 	set databasLookupRequest = ##class(IHC.ITF.ITFCOMMON.Request.IdxDatabaseLookupRequest).%New()
 	set databasLookupRequest.TwPid = context.organizationMrn

 	set tStatus=process.SendRequestSync(context.TwDbOpName, databasLookupRequest ,.response)
 		
	if ($$$ISOK(tStatus)){      			
      			      			     
     	           $$$TRACE( context.TwDbOpName _ " returned value: IdxPid: " _ response.IdxPid _ " for MRN: " _ context.organizationMrn)

	}else{
      		   set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Error while calling : "_ context.TwDbOpName _ " Error Text: " _ $System.Status.GetErrorText(tStatus)) 
      	}
       		
 	if (response.IdxPid = ""){      			
      			      			       	          
      		   set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName, "PersonXID is Empty after calling : "_ context.TwDbOpName _ " for Inbound organizationMrn : " _ context.organizationMrn) 
      	}
      	else
      	{
       	   $$$TRACE( " Data from Operation: " _ response.IdxPid _ ", " _ response.EntryName)	 
           //Copy from TW Database lookup value
           set context.personXID = "NV-" _ response.IdxPid
    
           set NEWPID3 = context.personXID_ "^^^CAREINMOTION_NV&amp;" _ context.oID _ "&amp;ISO"
           
           //Modify PID-3 in ProvideAndRegisterDocumentSetRequest
    
           set newXmlStr = $EXTRACT(fileData, 1, pidStart)
           set newXmlStr = newXmlStr _ NEWPID3 _ "</rim:Value>"
           set newXmlStr = newXmlStr _ $EXTRACT(fileData, pid3End, *)
           $$$TRACE( "After PID-3 change:" _ $L(newXmlStr))
       }
       if ((response.EntryCode= "") || $NUMBER(response.EntryCode) < 0)
     {
       set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Insurance_Class_DE.EntryCode is Empty OR invalid number from Inbound organizationMrn : " _ context.organizationMrn) 
      }
      else
      {
        $$$TRACE( "Valid Insurance Type (EntryName): " _ $NUMBER(response.EntryCode))
      }
      
    }
    
]]]]><![CDATA[>
