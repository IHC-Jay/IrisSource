<code name='Create ClinData file' xpos='200' ypos='1050' >
<![CDATA[
     // CLIN DATA change:
    // <patientRole><id extension="80-1512265" root="1.3.6.1.4.1.22812.3.7017002.3" />
    // TO
    // <patientRole>
    // <id assigningAuthorityName="CAREINMOTION_NV" extension="NV-1982283" root="1.3.6.1.4.1.22812.8.205349.2"/>
    
     set patientStart = $FIND(clinData, "<patientRole>")
     set patientEnd = $FIND(clinData, "/>", patientStart)
    
    set NEWPATIENTEXT = "id assigningAuthorityName=""CAREINMOTION_NV"" extension="""_ context.personXID _ """ root="""  _ context.oID _ """/>"
    
    set newClinStr = $EXTRACT(clinData, 1, patientStart)
    set newClinStr = newClinStr _ NEWPATIENTEXT 
    set newClinStr = newClinStr _ $EXTRACT(clinData, patientEnd, *)
    $$$TRACE( "New Clin length:" _ $L(newClinStr))
 
    set newClinFileNm = context.workPath _ "ClinicalDocument-New-" _ context.clinID
    Set clinFile=##class(%File).%New(newClinFileNm)
    
	set stat = clinFile.Open("WN")
	$$$TRACE( newClinFileNm _" - Create CLIN File : " _ stat )
	Do clinFile.Write(newClinStr)
	Do clinFile.Close()
	
	// Get new SIZE and HASH value
	set clinFile=##class(%File).%New(newClinFileNm)
	set clinFileSz = clinFile.Size
        set sHA1Hash = ##class(%File).SHA1Hash(newClinFileNm, 1)
        $$$TRACE("New hash for clinical Doc: " _ sHA1Hash )]]]]><![CDATA[>
</code>
<code name='Create ProvideAndRegisterDocumentSetRequest file' xpos='200' ypos='1150' >
<![CDATA[    // Update Size and Hash in ProvideAndRegisterDocumentSetRequest
    // <rim:Slot name="hash"><rim:ValueList><rim:Value>91C94B16FD7B28DEDB78A990FA0ECE921985186B</rim:Value></rim:ValueList></rim:Slot>
    // <rim:Slot name="size"><rim:ValueList><rim:Value>208394</rim:Value></rim:ValueList></rim:Slot>

    set szStart = $FIND(newXmlStr, "size")
    $$$TRACE( "size start: " _ szStart)
    set szEnd = $FIND(newXmlStr, "</rim:Value>", szStart)
    set InXDRStr = $EXTRACT(newXmlStr, 1, szStart)
    set InXDRStr = InXDRStr _ "><rim:ValueList><rim:Value>" _ clinFileSz _ "</rim:Value>"
    set InXDRStr = InXDRStr _ $EXTRACT(newXmlStr, szEnd, *)
    
    set newXmlStr = InXDRStr
    set hStart = $FIND(newXmlStr, "hash")
    
    set hEnd = $FIND(newXmlStr, "</rim:Value>", hStart)
    $$$TRACE( "hash start: " _ hStart _", end: " _ hEnd _", sHA1Hash: " _ sHA1Hash)
    
    set InXDRStr = $EXTRACT(newXmlStr, 1, hStart)
    set InXDRStr = InXDRStr _ "><rim:ValueList><rim:Value>" _ sHA1Hash _ "</rim:Value>"
    set InXDRStr = InXDRStr _ $EXTRACT(newXmlStr, hEnd, *)


    set dataFileNm = context.workPath _"IN_XDR_TouchWorks_PnR-Referrals-" _ context.clinID  
    Set dataFile=##class(%File).%New(dataFileNm)	
    set stat = dataFile.Open("WN")
    
	$$$TRACE( dataFileNm _ "ProvideAndRegisterDocumentSetRequest file open: " _ stat )
	// Copy from BODY
	Do dataFile.Write($EXTRACT(InXDRStr, $FIND(InXDRStr, "</s:Header>"), *))
	Do dataFile.Close()
	]]]]><![CDATA[>
