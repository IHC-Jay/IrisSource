	     	set exVarData = $ZSTRIP(exVar.Data,"*C")
	     	$$$TRACE(" exVarData --> "_exVarData)
	       	Do ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName,exVarData)			
			set context.genderNcid=""
     	}	
    }
  ]]]]><![CDATA[>
