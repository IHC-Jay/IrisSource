  For { 
     Set k1=request.GetNextIndex("MRG(1):1()",k1,.tSCTrans)  Quit:k1=""          
     If (request.GetValueAt("MRG(1):1("_k1_").4.1")="EMPI") {
         Set context.delMrn=request.GetValueAt("MRG(1):1("_k1_").1.1")         
         quit
     }
  }
  $$$TRACE("Delete MRN: " _ context.delMrn) 
  if (context.delMrn '= "" && $ISVALIDNUM(context.delMrn)= "1"){
