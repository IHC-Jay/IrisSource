<Method name="OnGetConnections">
<ClassMethod>1</ClassMethod>
<FormalSpec>*pArray:%String,item:Ens.Config.Item</FormalSpec>
<Implementation><![CDATA[
   #dim locArray As array Of %String;
   set tValue=""
   set tKey=""
   Set (tValue,tIndex)=""
   set targetOperationTable=""
   For {
	  Set tIndex = item.Settings.Next(tIndex)
      Quit:tIndex=""
      Set tSetting = item.Settings.GetAt(tIndex)
      If (tSetting.Name["LocationOperationsTable")
      {    
         if (tSetting.Value '= "")
         {
            set targetOperationTable = $ZSTRIP(tSetting.Value,"<>W")
         }
      }
   }
   for {
      Set tKey=$O(^Ens.LookupTable(targetOperationTable,tKey))
      quit:tKey=""
      set value = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(targetOperationTable, tKey, .retValForLines )
      if (tValue ="") {
         set tValue = retValForLines
      }else {
         set tValue = tValue_","_retValForLines
      }
   }
   
   For i=1:1:$L(tValue,",") {
      Set tOne=$ZSTRIP($P(tValue,",",i),"<>W")
      Continue:""=tOne
      Set pArray(tOne)=""
   }
]]></Implementation>
</Method>

