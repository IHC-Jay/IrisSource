  }else{
	  if (context.MSH92 '= "A03"){
		  set context.PV1FortyFiveDischargeDT = request.GetValueAt("PV1:DischargeDateTime(1).timeofanevent")
		  if ((context.PV1FortyFiveDischargeDT '= "") && ($ISVALIDNUM(context.PV1FortyFiveDischargeDT))) {
			  $$$TRACE("Found MSH-9.2 Trigger Event with a Discharge DateTime that is not an A03. Not sending to the ParentView! ****Skipping Message.*****")
              set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "***Found a MSH-9.2 Trigger Event that is not an A03 with Discharge DateTime value in the PV1-45! ****PHI - HL7 Message Control ID: " _context.MSH10)
