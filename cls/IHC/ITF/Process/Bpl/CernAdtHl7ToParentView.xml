  $$$TRACE("Setting context.MSH92 to: " _context.MSH92)
  $$$TRACE("Checking context.MSH92 against not allowed events")
  if ($LISTFIND($GET(^IHC.CernAdtHl7ToParentView("NotAllowedEvents")),context.MSH92)>0) {
       $$$TRACE("Found a MSH-9.2 Trigger Event that matches the Not Allowed Events from the settings")
