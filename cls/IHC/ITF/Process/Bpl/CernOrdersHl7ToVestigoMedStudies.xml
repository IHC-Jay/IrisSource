<code name='GiveCodeText Filter (RXE-2.2)' xpos='200' ypos='950' >
<![CDATA[  set AllowedGiveCodeText=""
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedGiveCodeText",.AllowedGiveCodeText) 
 if ($$$ISOK(pstatus)&&(AllowedGiveCodeText'=""))
 {
    
    $$$TRACE("AllowedGiveCodeText="_AllowedGiveCodeText)
    set ListGiveCodeTexts=$LISTFROMSTRING(AllowedGiveCodeText,",")
    set ptr=0
    
      WHILE (($LISTNEXT(ListGiveCodeTexts,ptr,value)) &&  (context.FilterGiveCodeText = 1))
      {
        set value = $ZCONVERT(value,"U")
        set value = $ZSTRIP(value,"<>W")
        $$$TRACE("GiveCodeTexts from Settings ="_value)
    
     set k1=""
       For { 
                set k1=request.GetNextIndex("RXEgrp()",k1,.tSCTrans)  Quit:k1=""          
                set rxr22GiveCodeText= request.GetValueAt("RXEgrp("_(k1)_").RXE:GiveCode.text")             
                set rxr22GiveCodeText= $ZCONVERT(rxr22GiveCodeText,"U")
                $$$TRACE("rxr22GiveCodeTextvalue ="_rxr22GiveCodeText)
               
           
                 if ( $FIND(rxr22GiveCodeText,value) > 0 )
                {
                      set context.FilterGiveCodeText = 0
                      $$$TRACE("GiveCodeText matched")
                      quit
                }
                
            }
            kill k1
            
          }
            
    if (context.FilterGiveCodeText = 1)
   {
      $$$TRACE("Skip message since GiveCodeText is not accepted...") 
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "GiveCodeTexts are not accepted so Skipping message.")
   }
      
       }]]]]><![CDATA[>
