 	if ( dob '= "" )
 	{
 	 set age = ##class(IHC.ITF.Transform.Dtl.CalAge).CalAge(dob)
 	 $$$TRACE(" Age is :" _age)
 	 set application = request.GetValueAt("MSH:SendingApplication.namespaceID")
 	 if ( application = "iCENTRA" )
 	{
 	
 	$$$TRACE(" This is a record from iCentra ")
 	 set medServ = request.GetValueAt("ZZZ(2):25ERDocFill")
 	$$$TRACE(" Medical service value from zzz[2].25 is :" _medServ )
 	if ( context.facID '= "138")
 	{ // this is not a PCMC record 
 	
 	if ( medServ = "1165" )
 	{
 	 set context.billingType = "I"
         }
         else
         {
                      
                 if ( age < 19 )
                 {
                  set context.billingType = "N"
                 }
                 else
                 {
                  set context.validate = 0 
                  set context.errorMessage = " This record is neither a maternity patient nor a pediatric patient "
                 }
                       
                    
         } //end of non mat patients
         
         }// end of NON PCMC patients
         else
         {
           // This is a case for PCMC patients
               //Let all outpatient in with billing type N
             set context.billingType = "N"
        
            
         }
 	} //end of icentra patients
 	else
 	{
 	$$$TRACE(" This is a record from HELP1")
 	set pid21 = request.GetValueAt("PID:MothersIdentifier().ID")
	$$$TRACE(" PID-21 value from HELP " _pid21)
	if ( pid21 = "")
	{
	$$$TRACE(" PID-21 value is empty ")
	if ( age < 19 )
           {
           set context.billingType = "N"
           }
           else
           {
            set context.validate = 0 
           set context.errorMessage = " This record is neither a maternity patient nor a pediatric patient "
           }
	  
	 }
	
	} //end of HELP patients
 	
 	} 
 	} 
 	} ]]]]><![CDATA[>
