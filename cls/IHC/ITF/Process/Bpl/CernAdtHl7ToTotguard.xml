<![CDATA[ set context.eventType =request.GetValueAt("MSH:MessageType.triggerevent")
 set context.validate = 0 
 set context.errorMessage = ""

 $$$TRACE(" The event type is "_context.eventType)
 $$$TRACE(" The facility Id is "_context.facID )
 
 if (context.eventType'= "")
 {
   set retStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.BPl.CernAdtToTotguard.Lookup.EventTypeFilterIn", context.eventType , .retVal )
