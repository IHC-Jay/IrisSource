<![CDATA[ $$$TRACE("Process : " _ context.dndId)

 set list = ##class(IHC.ITF.DStruc.DndCoreEraRecord).%OpenId(context.dndId)
 if ('$IsObject(list))
 {
   set status = $$$ERROR($$$EnsErrGeneral, "Can't open DnD Object for Id: " _ context.dndId)
   QUIT
 }
 
 $$$TRACE( list.%Id() _", CKPYREFID: " _ list.CKPYREFID _", Status: " _ list.Status)
  

 set num =1
 set context.loopSegEleValueArr = ##class(%ArrayOfDataTypes).%New()
 set context.loopSegEleArr = ##class(%ArrayOfDataTypes).%New()

 set prevSEGMENT = ""

 set grpId = 1

 set fldNum = 0
 set fldExists = 0
 set eleNum = 0

 set prevLoop = ""
 set newLoop = 0
 set num1000A = 0
 set num1000B = 0
 set num2000 = 0
 set num2100 = 0
 set num2110 = 0
 set keyStr = "", base2000Str = "", base2100Str = ""
 set emptyFldVal = 0
 set svcFldVal = 0
 
 #dim ch as IHC.ITF.DStruc.DndCoreEraRecordFields;
 #dim rs As %SQL.Statement
	Set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT * FROM IHC_ITF_DStruc.DndCoreEraRecordFields where RecordId = '" _ context.dndId _ "' order by ID")
	
	set moreRows = rs.%Next()	
	While moreRows{
		set subId = 0	
		if (rs.%Get("ELEMENTVALUE") '= "")
		{
				set recId = rs.%Get("ID")
				
		
				 set segVal = rs.%Get("SEGMENT")
				 set loopNum = rs.%Get("LOOP")
				 set element = rs.%Get("ELEMENT")
				 set elementVALUE = rs.%Get("ELEMENTVALUE")
				 
				 $$$TRACE(  num _". LOOP: " _ loopNum _ ", SEG: " _	segVal _ ", ELE: " _ element _"= " _ elementVALUE)
				 
				 	 
				 set eleNum = $NUMBER(+element, "I")
				 if (prevLoop '= loopNum) 
				 {
					 set newLoop = 1
					 if ("1000A" = loopNum)
					 {
						 set num1000A = num1000A + 1
						 set num1000B = 0
						 set num2000 = 0
						 set keyStr = "1000A," _ num1000A
					 }
					 elseif ("1000B" = loopNum)
					 {
						 set num1000B = num1000B + 1
						 set num2000 = 0
						 set keyStr = "1000B," _ num1000B
					 }
					 elseif ("2000" = loopNum)
					 {
						 set num2000 = num2000 + 1
						 set num2100 = 0
						 set num2110 = 0
						 set num1000A = 0
			 			 set num1000B = 0
			 			 set keyStr = "2000," _ num2000
			 			 set base2000Str = keyStr
					 }
					 elseif ("2100" = loopNum)
					 {
						 set num2100 = num2100 + 1
						 set num2110 = 0
						 set keyStr = base2000Str _ ",2100," _ num2100
						 set base2100Str = keyStr
					 }
					 elseif ("2110" = loopNum)
					 {
						 set num2110 = num2110 + 1
						 set keyStr = base2100Str _ ",2110," _ num2110
					 }
					 else
					 {
						 set keyStr = loopNum
					 }
					 	
					 // WRITE !, keyStr
				 }
				 else
				 {
					 set newLoop = 0
				 }
				 
				 if ( (segVal = "SVC") && ($FIND(element, "01") = 3)) // First SVC field
				 {
					 
					 $$$TRACE(  " ------- SVC: " _ element )
					 if (newLoop = 0)
					 {
						 if ("2110" = loopNum)
						 {
							 set num2110 = num2110 + 1
							 set keyStr = base2100Str _ ",2110," _ num2110
						 }
					 }
					 
				 }
				 elseif ((element = 1) || (element = "01")) 
				 {
					 
					 if (prevSEGMENT = segVal)
					 {
						set grpId = grpId + 1
						
					 	 $$$TRACE(  " ------- ELEMENT = 1 --- " _ loopNum _ " " _ segVal _ " -- GROUP: " _ grpId)
					 }
					 else
					 {
						 set grpId = 1
					 }
					 set prevSEGMENT = segVal
				 }
				 
				 if (element [ "-") // Composite values- separate them with :
				 {
				 	set subId = 1
				 	set svcFldVal = svcFldVal + 1
				 	 set prevSubSegNm = segVal
					 set compSegVal = segVal
					 set compElement = element
					 set compElementVALUE = elementVALUE
					 While ( ( prevSubSegNm = compSegVal)  && ($FIND(compElement, "-" _ subId) = 5) ) 
					 {
						 set eleNum = $PIECE(compElement, "-", 1)
						 set eleNum = $NUMBER(+eleNum, "I")
						 if (subId = 1)
						 {
						 	set fldVal = $ZSTRIP(compElementVALUE, "<>W")
						 }
						 elseif ($ZSTRIP(compElementVALUE, "<>W") '= "")
						 {
						 	set fldVal = fldVal _ ":" _ $ZSTRIP(compElementVALUE, "<>W")
					 	 }
						 
						$$$TRACE(  " ------- Composite Value: " _ compElement _ "-" _ subId _": " _ "2100 ind: " _ num2100 _ ", 2110 ind: " _ num2110_ ", LOOP: " _ loopNum _ " " _ compSegVal _" " _ compElement _"= " _ compElementVALUE)
						 set prevSubSegNm = compSegVal
						 						 
						 set subId = subId + 1
						 set moreRows = rs.%Next()	
						 set num = num + 1
						 
						 set compSegVal = rs.%Get("SEGMENT")
						 set compLoopNum = rs.%Get("LOOP")
						 set compElement = rs.%Get("ELEMENT")
						 set compElementVALUE = rs.%Get("ELEMENTVALUE")
				 
					 } 
				 }
				 else
				 { 
				 	set fldVal = $ZSTRIP(elementVALUE, "<>W")
				 }

				 set insStr = keyStr _	"," _ segVal _"," _ grpId _ ","  _ eleNum 
				 $$$TRACE( " -> " _ num _". " _ insStr  _"= " _ fldVal  _ ", # of fields: " _ $LENGTH(insStr, ","))
				 set prevLoop = loopNum

				 
				 if (context.loopSegEleValueArr.GetAt(insStr))
				 {
					$$$LOGERROR( "  *** One or more fields overwritten: " _ insStr _ "= " _ context.loopSegEleValueArr.GetAt(insStr))
					 set fldExists = 1
					 QUIT
				 }
				  
			     set fldNum = fldNum + 1
			     Do context.loopSegEleArr.SetAt(insStr, fldNum)
			     Do context.loopSegEleValueArr.SetAt(fldVal, insStr)
			     if (insStr [ "835,ISA,1,8")
			     {
			        set context.SenderID = fldVal
			     }
     
		}
		else
		{
		    set emptyFldVal = emptyFldVal + 1
		}
		if (subId = 0) {
			set moreRows = rs.%Next()
			set num = num + 1
		}
		else
		{
		    set segVal = compSegVal 
		    set loopNum = compLoopNum 
		    set element = compElement 
		    set elementVALUE  = compElementVALUE 
		}
		
 	}
 
 if (fldExists = 1)
 {
	 set status = $$$ERROR($$$ObjectScriptError, "  *** One or more data fields overwritten *** ")
	 QUIT
 }
 $$$TRACE("loopSegEleArr.Count: " _ context.loopSegEleArr.Count() _ " -=- Got valid: " _ fldNum _ " fields from DB from DndCoreEraRecordFields: " _ num _ ", Empty values: " _ emptyFldVal _ ", # of subfields merge for SVC: " _ svcFldVal  )
]]]]><![CDATA[>
