<code name='CallFileHistoryInsertSP' xpos='200' ypos='650' >
<![CDATA[
	set fileHisInsReqObj = ##class(IHC.ITF.Request.FileHistoryInsertRequest).%New()  
	set fileHisInsReqObj.pGuid = context.guiId
	set fileHisInsReqObj.pFileName = context.fileName
	set fileHisInsReqObj.pInterchangeId = context.interchangeId
	set fileHisInsReqObj.pInterchangeSeq = context.interchangeSeq
	$$$TRACE(" Begin  SHSP_RCN_277CA_RES_FILE_INS SP Call(Begin)... ")
	set tStatus=process.SendRequestSync(context.sh277FileHistInsTargetConfigName,fileHisInsReqObj,.dbFileHistInsResp)
  	$$$TRACE(" After SHSP_RCN_277CA_RES_FILE_INS(end) .. : "_tStatus)
  	if ($$$ISOK(tStatus)){
       $$$TRACE(" GuidOut: "_dbFileHistInsResp.pGuidOut)  
       set guidOut = dbFileHistInsResp.pGuidOut
       if ( $L(guidOut) > 0){
	       $$$TRACE(" Received pGuidOut..")
	       set sh277CaX12ReqObj = ##class(IHC.ITF.Request.Sh277CAX12Request).%New()
	       set sh277CaX12ReqObj.pGuidOut = dbFileHistInsResp.pGuidOut
	       set sh277CaX12ReqObj.pFileName = context.fileName
	       set sh277CaX12ReqObj.pInterchangeId = context.interchangeId 
	       set sh277CaX12ReqObj.pInterchangeSeq = context.interchangeSeq
	       set sh277CaX12ReqObj.pSrcX12Doc = context.srcX12doc
	       
	       set tStatus = process.SendRequestAsync(context.sh277StoreProcsTargetConfigName,sh277CaX12ReqObj)  		
	 	   $$$TRACE(" Sent to "_context.sh277StoreProcsTargetConfigName)
	   }  
  	}else{	 	
		set returnDesc = "Error while calling the SP -- TPDS.PK_RCN_277CA_RES.SHSP_RCN_277CA_RES_FILE_INS, Failed to get the pGuidOut"
		Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,returnDesc)   		
  	}  	
 ]]]]><![CDATA[> 
</code>
