<code name='InitVariablesForFileHistoryInsert' xpos='200' ypos='650' >
<![CDATA[ 
    set guidTmp = $System.Util.CreateGUID()
    $$$TRACE(guidTmp)
	set context.guiId = $REPLACE(guidTmp,"-","")
	//set context.guiId = $E(context.guiId,1,32)
	$$$TRACE( "context.guiId: "_context.guiId)
	$$$TRACE(" ISA:InterchangeSenderID: "_context.srcX12doc.GetValueAt("ISA:InterchangeSenderID"))
	$$$TRACE(" ISA:InterchangeReceiverID: "_context.srcX12doc.GetValueAt("ISA:InterchangeReceiverID"))
	//set context.interchangeId = ##class(IHC.ITF.ITFCOMMON.X12utils).getControlNumber(process.%ConfigName,context.srcX12doc.GetValueAt("ISA:InterchangeSenderID"),context.srcX12doc.GetValueAt("ISA:InterchangeReceiverID"))
	set context.interchangeId = $zstrip($ZDATETIME($ZTIMESTAMP,3,1,4), "*P")
	$$$TRACE( " interchangeId: "_context.interchangeId)
	set context.interchangeSeq = "1"	
 ]]]]><![CDATA[> 
