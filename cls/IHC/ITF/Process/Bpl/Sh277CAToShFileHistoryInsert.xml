<code name='CheckInboundEDIdocumentIsX12AndGetFileName' xpos='200' ypos='650' >
<![CDATA[ 
	if (request.%IsA("EnsLib.EDI.X12.Document")){
		$$$TRACE(" is EnsLib.EDI.X12.Document ")
    	set context.srcX12doc = request
 	}else{
    	set context.srcX12doc = request.origMsg
 	}
 	set filePath = context.srcX12doc.Source
 	$$$TRACE(" X12 file path: "_ context.srcX12doc.Source)
 	if (filePath=""){
		set errMsg = "  Invalid EDI X12 data or the file is blank.. Skipping the record with error ststus.."
    	set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errMsg)
 	}else{
	 	Set list = $ListFromString(filePath,context.filePathSeparator)
		Set lenList = $ListLength(list)
		if (lenList=1){
			set errMsg = "Invalid file path:["_filePath_"]..  File separator character in the settings is ["_context.filePathSeparator _"] Skipping the record with error ststus.."
			set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errMsg)	
		}else{
			Set context.fileName = $List(list,lenList)
			$$$TRACE(" X12 file name: "_ context.fileName)
		}		
	}
 ]]]]><![CDATA[> 
</code>

