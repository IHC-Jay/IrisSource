    set stattus=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing CORPPRV Xml"_$SYSTEM.Status.GetOneErrorText(sc))  
 } 
 Else {
      Do reader.Correlate("CORPPRV_PROVIDER","IHC.ITF.DStruc.Schema.CORPPRVProviderRequest.CORPPRVPROVIDER")
     do reader.Next(.oracleHr,.sc)
     set context.Corpprv=oracleHr
     If $$$ISOK(sc){
	       $$$TRACE("Corpprv xml Parsed successfully.")
     // check if the the request was successfuly posted to MSPR                           
 }else{
   set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing  oracle HR record"_$SYSTEM.Status.GetOneErrorText(sc))       
