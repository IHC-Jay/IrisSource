<code name='createHddRequests' xpos='740' ypos='2300' >
<![CDATA[
  	$$$TRACE(" GetRepfromNcid Hdd Requests..")
  	set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
  	set pid8GenderNcid = request.GetValueAt("PIDgrpgrp(1).PIDgrp.PID:Sex") 
  	$$$TRACE("PID;8 is " _ pid8GenderNcid)		  	
  	if (pid8GenderNcid '= "" && $ISVALIDNUM(pid8GenderNcid)= "1"){
		Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , pid8GenderNcid,  context.hddContextHelp, "PID8:Gender")  	  	
		$$$TRACE("Hdd Request PID;8 is " _ pid8GenderNcid)		
	}	
	
	set k1="",tSC=1 
  For { 
     Set k1=request.GetNextIndex("PIDgrpgrp(1).ORCgrp()",k1,.tSCTrans) Quit:k1=""          
     set obr25 = request.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBR:ResultStatus")
     $$$TRACE("OBR-25["_k1_"] is " _ obr25) 
     if (obr25 '= "" && $ISVALIDNUM(obr25)= "1"){
       Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr25, context.hddContextRadiology, "OBR25"_k1) 
       $$$TRACE("NCID at OBR25 is " _ obr25) 
    } 
    
    set k2="", tScc = 1
      For{
	Set k2=request.GetNextIndex("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp()",k2,.tSccTrans) Quit:k2=""          
     set obx11 = request.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBXgrp("_k2_").OBX:ObservationResultStatus")          
     $$$TRACE("Value at OBX-11 ["_k1_"] ["_k2_"] is "_obx11)     
     if (obx11 '= "" && $ISVALIDNUM(obx11)= "1"){
       Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obx11, context.hddContextRadiology, "OBX11"_k1_k2) 
       $$$TRACE("NCID at OBX11 is " _ obx11) 
 	} 
      }
      
      set obr41 = request.GetValueAt("PIDgrpgrp(1).ORCgrp("_k1_").OBR:UniversalServiceID.identifier")      
     $$$TRACE("OBR-41["_k1_"] is " _ obr41) 
     if (obr41 '= "" && $ISVALIDNUM(obr41)= "1"){
	     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddIsMemberObject(context.IsMemberLookup, context.hddDomainCardLab, obr41, "OBR-41"_k1)
         $$$TRACE("NCID at OBR41 is " _ obr41) 
      }
  }
]]]]><![CDATA[>
