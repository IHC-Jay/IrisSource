<code name='Is Member Lookup' xpos='1010' ypos='2400' >
<![CDATA[ 
 // Call HDD Operation     
    set tStatus=process.SendRequestSync(context.hddTargetConfigName, context.IsMemberLookup,.hddResponse)
    if ('tStatus) {
       set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure") 
    }else { 
       set context.IsMemberResponse = hddResponse 
    }
    
    set k1="",tSC=1 
    set obrFlag = 0
  For { 
     Set k1=request.GetNextIndex("PIDgrpgrp(1).ORCgrp()",k1,.tSCTrans) Quit:k1=""          
    set isObr41Resp = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.IsMemberResponse, "OBR-41"_k1)    
    if (isObr41Resp '="") {                      
                     if (isObr41Resp.Rep '="0") {                         
                         set obrFlag = 1                        
                      } 
    }     	 
  }   
  $$$TRACE(" OBR41 is a MemberOf Lab "_ obrFlag)   	
  	if (obrFlag="1"){
	  $$$TRACE(" OBR41 [ " _ obr41_ "] is member of Card. LAB") 	                
  	}else{	
	  set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "OBR41 is NOT a member of Cardialogy LAB. Skipping record.")
	}
 ]]]]><![CDATA[>
</code>

