	if (request.%IsA("Ens.StreamContainer")){
	 	$$$TRACE("Process StreamContainer")
	 	if (request.Stream.Size > 108){
		 	set context.inXmlDoc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.Stream, .pStat )
		 	if (pStat '= $$$OK){  	
     			$$$TRACE("Failed to create X12 message from Stream" _ pStat)
     			set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "X12 ImportFromLibraryStream failed, Skipping the record." _ request)
        	}else{
		 		Set context.FileName = request.OriginalFilename
		 		$$$TRACE("Imported X12 from " _ request.OriginalFilename _", size: " _ request.Stream.Size _", stat: " _ pStat)
      			set context.inXmlDoc.DocType = "HIPAA_5010:Interchange:Group" 
	  			Set tSC =context.inXmlDoc.BuildMap()	
	  			if $$$ISERR(tSC){
		  			set fullErrorMsg = "Invalid X12, BuildMap failed: " _ tSC
		  			$$$TRACE(fullErrorMsg)
		  			Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"Invalid X12: " _ fullErrorMsg)		  			
	  			}else{
	  				Set context.inXmlDoc.DocType = "HIPAA_5010:Interchange"
					set context.inpStream = ##class(%Stream.GlobalCharacter).%New()
					Do context.inpStream.CopyFrom(request.Stream)
					$$$TRACE("context.FileName: " _ context.FileName)				
	  			}
        	}
	 	}else{
		 	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"Invlaid Inbound stream. Size: " _ request.Stream.Size)
	 	}
	}    	
    ]]]]><![CDATA[>
