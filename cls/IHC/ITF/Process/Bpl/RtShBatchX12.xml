<Method name="ValidateX12">
<ClassMethod>1</ClassMethod>
<FormalSpec><![CDATA[docType:%String,x12Doc:EnsLib.EDI.X12.Document,valStr:%String,&process:IHC.ITF.Process.Bpl.RtShBatchX12,&retStat,&fullErrMsg,&TA01Msg]]></FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tmpStatus AS %Status=$$$OK
    set retStat = "0"
    
    set stat = ##class(EnsLib.EDI.X12.Util.Validator).Validate(x12Doc, valStr)
		if ( $$$ISERR(stat) ){
		   set retStat = "1"
		   set errMsg = $system.Status.GetErrorText(stat)
	       $$$TRACE(errMsg)
	       set PayloadType = "Error"
	  	   if errMsg [ "HIPAA_5010:Interchange"{
	  	    	set fldInd = $FIND(errMsg, "ISA.  Field ")
	  	    	set fldNum = $ZSTRIP($EXTRACT(errMsg,fldInd, $FIND(errMsg, " ", fldInd)-1), "*W")
	  	    	$$$TRACE("Invalid Fld # " _ fldNum)
	  	    	set TA105 = $LISTBUILD("010","011","012","013","005","006","007","008","014","015","","","018","019","020", "026")
   		  	    set context = ##class(%DynamicObject).%New()
				set v = $LISTDATA(TA105,fldNum, val)
				set context.IsaErrorField = val	
	  	   	   
			 set sc=##class(IHC.ITF.Transform.Dtl.CR27xToTA1Batch).Transform(x12Doc,.target, .context)
			 if $$$ISERR(sc)
			  {
				  set fullErrMsg = "Error in generating TA1: " _ $system.Status.GetErrorText(sc)
			  		
			  }
			  else
			  {
		  		set TA01Msg = target.OutputToString()
		  	  }	
		  	  set fullErrMsg = "X12 validation failed, Invalid X12. " _ ", Error: " _ errMsg 	  			
	  		
		 }else{
			 set retStat = "0"
			 set TA01Msg = ""
			 set fullErrMsg = ""
		 }
		 
	    }
	    
    quit tmpStatus
]]></Implementation>
</Method>

