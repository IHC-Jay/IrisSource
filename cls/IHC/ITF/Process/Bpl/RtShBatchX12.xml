<code name='Get Transaction Type' xpos='470' ypos='1100' >
<![CDATA[  
  #dim individualGroup As EnsLib.EDI.X12.Document 
  set individualGroup = context.inXmlDoc.getNthChild(1,2)
  #dim STRecord As EnsLib.EDI.X12.Document 
  set STRecord=individualGroup.getNthChild(1,2)
  set transType = ##class(IHC.ITF.ITFCOMMON.X12.StoreEdiX12Data).GetTransType(STRecord)	
  $$$TRACE(" TransType: "_transType)
  set targetConfigName = ""
  if (transType="270"){
	set context.inXmlDoc.DocType = "HIPAA_5010:Interchange:Group:270"
	set targetConfigName = context.uhin270TargetConfigName	  
  }elseif (transType="276"){
	set context.inXmlDoc.DocType = "HIPAA_5010:Interchange:Group:276"
	set targetConfigName = context.uhin276TargetConfigName	  	
  }
   set tStat = ##class(IHC.ITF.Process.Bpl.RtShBatchX12).ValidateX12(context.inXmlDoc.DocType,context.inXmlDoc, "dmls", .process, .retStat,.fullErrMsg, .TA01Msg)
   if (retStat="1"){
	   set ta1Msg = ##class(Ens.StreamContainer).%New()
 	   set str = ##class(%Stream.GlobalCharacter).%New()
 	   Do str.Write(TA01Msg)
 	   set ta1Msg.Stream = str 	 
	   set tStatus = process.SendRequestAsync(context.TA1UhinTargetConfigName,ta1Msg)
	   $$$TRACE(" TA1 messages sent to: "_ context.TA1UhinTargetConfigName _ " Status: "_tStatus )
	   do ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, fullErrMsg)		
	   
	   
   }else{  
   		Do request.Stream.Rewind()
   		Set newReq = ##class(Ens.StreamContainer).%New()
   		If '$IsObject(newReq.Stream) {
			Set newReq.Stream = ##class(%Stream.GlobalCharacter).%New()
   		}
   		Do newReq.Stream.CopyFrom(request.Stream)
   		set newReq.OriginalFilename = context.FileName
     
  		if ($L(targetConfigName)>0){
  			set tStatus = process.SendRequestAsync(targetConfigName,newReq)
  			if ('tStatus) {    
    			set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Unexpected error while sending to: " _ targetConfigName _ "."_$SYSTEM.Status.GetOneErrorText(tStatus))
   			}else{
	   			$$$TRACE( " X12 sent to "_targetConfigName)
   			}
  		}else{
	 		$$$TRACE(" Invalid Transaction type: "_transType_" Skipping the message ")
	 		set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName," Skipping the message..Invalid transaction type: " _ transType)
  		}
   }
]]]]><![CDATA[>
