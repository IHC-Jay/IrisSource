<code name='55. Provider ID ' xpos='200' ypos='850' >
<![CDATA[  $$$TRACE("55. Check and prepare the provider ID for Cerner mapping...")
 	
  set context.providerID = request.GetValueAt("FT1(1):21.1") 
  $$$TRACE("55.1  FT1-21.1 Provider ID: " _context.providerID)
  if ($LENGTH(context.providerID) <= 0) {
     	$$$TRACE("55.2 FT1-21.1 Provider ID is empty: " _ context.providerID) 
     	set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The FT1-21.1 Provider ID is Null or empty. Skip the record.")  
  }elseif ($LENGTH(context.providerID) > context.providerIDMaxLength){
        set tmpStr = context.providerID
        set context.providerID = $EXTRACT(tmpStr, *-4, *-0) 	
    	$$$TRACE("55.3 Cut FT1-21.1 Provider ID down to its five characters: " _ context.providerID)  
