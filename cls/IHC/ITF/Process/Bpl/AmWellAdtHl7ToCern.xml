<code name='InsuranceMappings' xpos='740' ypos='1650' >
<![CDATA[ 
     if ((context.MsgType = "A04") || (context.MsgType = "A28")){
     	Set insPlanIdIN12 =request.GetValueAt("IN1(1):InsurancePlanID.identifierST")
     	$$$TRACE("IN1.2(InsurancePlanID): " _ insPlanIdIN12) 
     	if ($L($ZSTRIP(insPlanIdIN12,"*W"))>0){
	     	    set context.insPlanIdIN12Numeric = $ZSTRIP(insPlanIdIN12,"*PA")
	     	  	set context.in12 = context.insPlanIdIN12Numeric
		     	try{
		     		set context.insCompNcid = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getUniqueParent(context.insPlanIdIN12Numeric , context.hddTargetConfigName, .process)
		     		$$$TRACE("IN1.3(InsuranceompanyNID) from Hdd: " _ context.insCompNcid) 
		     	}catch exce{
					Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Unknown error while calling Hdd service, getUniqueParent IN1-2: ["_insPlanIdIN12_"]. Relationship Ncid:529857609. Context Ncid:2000  ")
				}	         	
     	}else{
	     	$$$TRACE("IN1.2 is empty. Looking for IN1-3 ...") 
	     	Set insPlanIdIN13Rep =request.GetValueAt("IN1(1):3(1).1")
	     	if (insPlanIdIN13Rep '= ""){		
				set context.in12=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(insPlanIdIN13Rep, "526050881", "529857606", context.hddTargetConfigName, .process)  	  	
				$$$TRACE(" context.in12 ncid is " _ context.in12)		
				if ( ($L(context.in12)=0) || (context.in12="ERROR") ){
					// context.in12 blank from HDD means its NOT defined in HDD.
					if ($L(context.in12)=0){
						$$$TRACE("IN1.2 from Hdd is blank: [" _ context.in12_"]. Sending the record without the insurance information.  The billing team would look up the insurance information and add it to the record. ")
						do ##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError("AmWell - No matching Insurance","No matching insurance defined in HDD with domain 526050881 and context 529857606 for the REP (IN1-3) : ["_insPlanIdIN13Rep _ "]. The billing team would look up the insurance information and add it to the record. ",process.%ConfigName)
					}else{
						Set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName,"getNcidFromRep Hdd call failed with domain 526050881 and context 529857606 for the REP (IN1-3) : "_insPlanIdIN13Rep,context.hddTargetConfigName)
					}
				}else{
					try{
						$$$TRACE("IN1.2 from Hdd: " _ context.in12)
		     			set context.insCompNcid = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getUniqueParent(context.in12, context.hddTargetConfigName, .process)
		     			$$$TRACE("IN1.3(InsuranceompanyNID) from Hdd: " _ context.insCompNcid) 
		     			if ( ($L(context.insCompNcid)=0) || (context.insCompNcid="ERROR") ){
			     			if ($L(context.insCompNcid)=0){
								$$$TRACE("Insurance Company Ncid from Hdd is blank: [" _ context.insCompNcid_"]. Sending the record without the insurance information.  The billing team would look up the insurance information and add it to the record. ")
								do ##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError("AmWell - No matching Insurance","getUniqueParent Hdd call failed to get the Insurance company ncid from the Insurance plan ncid: "_context.in12 _ " Relationship Ncid:529857609. Context Ncid:2000. The billing team would look up the insurance information and add it to the record. ",process.%ConfigName)
							}else{
								Set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName,"getUniqueParent Hdd call failed to get the Insurance company ncid from the Insurance plan ncid: "_context.in12 _ " Relationship Ncid:529857609. Context Ncid:2000  ")
							}
						}
		     		}catch exce{
						Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Unknown error while calling Hdd service, getUniqueParent IN1-2: ["_context.in12_"]. Relationship Ncid:529857609. Context Ncid:2000  ")
					}
				}
			}	     	
	    }
     }
