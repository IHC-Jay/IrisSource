<code name='CallWebServiceAccessTokenFromPing' xpos='470' ypos='2350' >
<![CDATA[ 
  $$$TRACE(" Target Operation to get AccessToken from Ping service " _ context.accessTokenTargetConfigName)   
   set httpRequestObj=##class(EnsLib.HTTP.GenericMessage).%New()   
   set status =  process.SendRequestSync(context.accessTokenTargetConfigName,httpRequestObj,.accessTokenResponse)
   if ($$$ISOK(status)){
      $$$TRACE("AcsessToken Operation status - OK")
      set context.restAccessTokenHttpResponse=accessTokenResponse      
      Set tcharStream = ##class(%GlobalCharacterStream).%New()
      Set tStatus = tcharStream.CopyFrom(context.restAccessTokenHttpResponse.Stream)
      set text=""
      While 'tcharStream.AtEnd {
        Set text = text_tcharStream.Read($$$MaxStringLength)
      } 
      set context.accessToken = text
      $$$TRACE("Accss Token from Ping Service: "_context.accessToken)
      if (context.accessToken=""){
	      $$$TRACE(" Access Token is blank/empty")
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," No Access Token from ping service. ") 
	  }      
    }
    else {
	    $$$TRACE("Calling Ping Service to get the Access Token failed!!!")
       set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Calling Ping Service to get the Access Token failed!!!") 
    }
   ]]]]><![CDATA[>
</code>

<code name='CallAmWellEncService' xpos='200' ypos='1250' >
<![CDATA[  
   $$$TRACE("Calling AmWell Encounter service.. ")
   set amwellEncRequest=##class(IHC.ITF.Request.AmWellEncRequest).%New()
   
   if (context.hasEncId = "Y"){
   	set amwellEncRequest.apptId = "0"
   	set amwellEncRequest.encounterId = context.finNumber
   }else{
	   set amwellEncRequest.apptId = context.finNumber
   	   set amwellEncRequest.encounterId = "0"
   }
   set amwellEncRequest.accessToken = context.accessToken
   Set jsonRequest = "{""finNumber"": """_amwellEncRequest.encounterId_""", ""scheduleID"": """_amwellEncRequest.apptId_"""}" 
   set status = process.SendRequestSync(context.amwellEncTargetConfigName,amwellEncRequest,.retRespObj)
   if ($$$ISOK(status)){
	      $$$TRACE("Call to amwell encounter service status successful... retValue:"_retRespObj.StringValue)	      
	      if ($ISVALIDNUM(retRespObj.StringValue)){
		      set context.codeValAlias = retRespObj.StringValue
		  }else{
			   $$$TRACE("Error response from AmWell Encounter srevice: "_retRespObj.StringValue)
			   set errMsg = retRespObj.StringValue _" JSON Request:"_jsonRequest
			   set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "AmWell Encounter service call failed, Error Message: "_errMsg)
		  }
    }else{
	     $$$TRACE("Calling amwell encounter service failed!!! ")
	     set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "AmWell Encounter service call failed, shutting down...... "_$SYSTEM.Status.GetOneErrorText(status))
     }
 ]]]]><![CDATA[>
