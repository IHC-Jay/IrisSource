<code name='Prep GetNcidFromRep' xpos='200' ypos='1150' >
<annotation><![CDATA[Prepare RepFromNcid values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object")  
 
 set i1=""
 for {
	 set i1 = request.GetNextIndex("PIDgrpgrp()",i1,.tSCPID)  quit:i1=""	 
	 
	 set pid8Sex = request.GetValueAt("PIDgrpgrp("_(i1)_").PIDgrp.PID:Sex")  	
 	 if (pid8Sex '= "") {
         Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , pid8Sex, context.hddContextSex, context.hddContextHelp, "PID8:Sex_"_i1)  	  	
     	 $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 	 }
 	 
 	 set j1=""
 	 for {	 	 
		 set j1 = request.GetNextIndex("PIDgrpgrp("_(i1)_").ORCgrp()",j1,.tSCORC)  quit:j1=""		 		 
		 
 		 set orc1OrderControl = request.GetValueAt("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").ORC:OrderControl")
 		 if (orc1OrderControl '= "") {
     	 	 Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , orc1OrderControl, context.hddDomainOrderControl, context.hddContextOrderControl, "ORC1:OrderControl_"_(i1)_"_"_j1)  	  	
     		 $$$TRACE("Hdd Request ORC-1 OrderControl is " _ orc1OrderControl)     		
 		 }		 
 		 
 		 set obr4UniversalSrvIdActualValue = request.GetValueAt("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").OBR:UniversalServiceID.identifier") 
 		 
 		 set obr4UniversalSrvId = $REPLACE(obr4UniversalSrvIdActualValue,"EMMI_","")
 		 		 
 		 if (obr4UniversalSrvId '= "") {
     	 	 Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , obr4UniversalSrvId, context.hddEMMIDomain, context.hddEMMIContext, "OBR41:UniversalServiceID_"_(i1)_"_"_j1)  	  	
     		 $$$TRACE("Hdd Request OBR-4 UniversalServiceId is " _ obr4UniversalSrvId)     		
 		 } 
 		 
 		 set k1=""
 		 for {	 		 
	 		 set k1 = request.GetNextIndex("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").OBXgrp()",k1,.tSCOBX)  quit:k1=""	 		 
	 		 set obx3ObservationId = request.GetValueAt("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").OBXgrp("_(k1)_").OBX:ObservationIdentifier.identifier")
 		 	 if (obx3ObservationId '= "") {
	 		 	 Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , obx3ObservationId, context.hddContextObservation, context.hddContextTelcorRespToCerner, "OBX3:ObservationID_"_(i1)_"_"_(j1)_"_"_k1)
     		 	 $$$TRACE("Hdd Request OBX-3 ObservationIdentifier is " _ obr4UniversalSrvId)
 		 	 }
 		 	 
 		 	 set obx6UnitId = request.GetValueAt("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").OBXgrp("_(k1)_").OBX:Units.identifier")
 		 	 if (obx6UnitId '= "") {	 		 	 	 		 	 
			     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , obx6UnitId, context.hddContextUnit, context.hddContextMicroLab, "OBX6:UnitsID_"_(i1)_"_"_(j1)_"_"_k1)
	 		 	 $$$TRACE("Hdd Request OBX-6 UnitsId is " _ obx6UnitId)
