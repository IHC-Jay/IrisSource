<code name='Populate MSH' xpos='470' ypos='2100' >
<![CDATA[ //Form a dummy HL7 for Tuxedo Services to work. PID will be used to update the address with the correct    //Hl7 from the CDR.
  
 //MSH
 do cdrAddressHl7.SetValueAt(context.SendingApp, "MSH:SendingApplication.namespaceID")
 do cdrAddressHl7.SetValueAt(context.FacilityId, "MSH:SendingFacility") 
 do cdrAddressHl7.SetValueAt(context.ReceivingApp, "MSH:ReceivingApplication")
 do cdrAddressHl7.SetValueAt(context.ReceivingFacility, "MSH:ReceivingFacility")
 
 //MSH 07: DateTimeStamp - YYYYMMDDHHmmSS - 20160817102220 
  set timeStamp = $ZDATE($H)_$ZTIME($H)
  set finalTimeStamp = $ZSTRIP(timeStamp, "*P")
  $$$TRACE("TimeStamp: " _finalTimeStamp)

 do cdrAddressHl7.SetValueAt(finalTimeStamp, "MSH:DateTimeofMessage.timeofanevent")
 do cdrAddressHl7.SetValueAt(context.messageType, "MSH:MessageType.messagetype")  
 do cdrAddressHl7.SetValueAt(context.triggerEvent, "MSH:MessageType.triggerevent") 
 do cdrAddressHl7.SetValueAt(context.messageControlID, "MSH:MessageControlID")
 do cdrAddressHl7.SetValueAt(context.versionID, "MSH:VersionID") 
 do cdrAddressHl7.SetValueAt(context.characterSet, "MSH:CharacterSet")

 ]]]]><![CDATA[>
