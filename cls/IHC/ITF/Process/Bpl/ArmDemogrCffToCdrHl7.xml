<![CDATA[ //AddressTargetConfigName
 $$$TRACE("Get: AddressTargetConfigName")
 set addressTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TargetConfigNames",.tStatus) 
 $$$TRACE("Get: AddressTargetConfigName: " _tStatus _", " _ addressTargetConfigName)
 if (($$$ISERR(tStatus))){
    $$$TRACE("Status: " _tStatus)     
 set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get addressTargetConfigName, shutting down.")
    
 } else { 
 set tStatus=process.SendRequestSync(addressTargetConfigName, cdrAddressHl7,.cdrAddressUpdateResponse)
 if ('tStatus) {
      $$$TRACE("Unable to update the address into CDR: " _request.MMINumber)
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unable to update the address into CDR. Error returned from operation: "_$SYSTEM.Status.GetOneErrorText(tStatus))
 } 
 else
 {
  $$$TRACE("Update the address into the CDR successfully")
 }
 }]]]]><![CDATA[>
