<code name='HL7 Mapping' xpos='470' ypos='1900' >
<![CDATA[  //HL7 Spec
 set cdrAddressHl7 = ##class(EnsLib.HL7.Message).%New()      
 set cdrAddressHl7.DocType="2.3:ADT_A01"
 do cdrAddressHl7.%Save() 
 $$$TRACE("HL7 DocType Set:"_cdrAddressHl7.DocType)

  //Form a dummy HL7 for Tuxedo Services to work. PID will be used to update the address with the correct    //Hl7 from the CDR.
  
 //MSH
 do cdrAddressHl7.SetValueAt(context.SendingApp, "MSH:SendingApplication.namespaceID")
 $$$TRACE("HL7 CDR MSH 03: " _cdrAddressHl7.GetValueAt("MSH:SendingApplication.namespaceID"))

 do cdrAddressHl7.SetValueAt(context.FacilityId, "MSH:SendingFacility")
 $$$TRACE("HL7 CDR MSH 04 " _cdrAddressHl7.GetValueAt("MSH:SendingFacility"))
 
 do cdrAddressHl7.SetValueAt(context.ReceivingApp, "MSH:ReceivingApplication")
 $$$TRACE("HL7 CDR MSH 05: " _cdrAddressHl7.GetValueAt("MSH:ReceivingApplication"))
 
 //MSH 06
 do cdrAddressHl7.SetValueAt(context.ReceivingFacility, "MSH:ReceivingFacility")
 $$$TRACE("HL7 CDR MSH 06: " _cdrAddressHl7.GetValueAt("MSH:ReceivingFacility")) 
  
 //MSH 07: DateTimeStamp - YYYYMMDDHHmmSS - 20160817102220
 
  set timeStamp = $ZDATE($H)_$ZTIME($H)
  set finalTimeStamp = $ZSTRIP(timeStamp, "*P")
  $$$TRACE("TimeStamp: " _finalTimeStamp)

  do cdrAddressHl7.SetValueAt(finalTimeStamp, "MSH:DateTimeofMessage.timeofanevent")
  $$$TRACE("HL7 CDR MSH 07: " _cdrAddressHl7.GetValueAt("MSH:DateTimeofMessage.timeofanevent")) 
  
 //MSH 08 - Leave blank 
 
 do cdrAddressHl7.SetValueAt(context.messageType, "MSH:MessageType.messagetype")
 $$$TRACE("HL7 CDR MSH 9.1: " _cdrAddressHl7.GetValueAt("MSH:MessageType.messagetype"))
  
 do cdrAddressHl7.SetValueAt(context.triggerEvent, "MSH:MessageType.triggerevent")
 $$$TRACE("HL7 CDR MSH 9.2: " _cdrAddressHl7.GetValueAt("MSH:MessageType.triggerevent")) 
 
 do cdrAddressHl7.SetValueAt(context.messageControlID, "MSH:MessageControlID")
 $$$TRACE("HL7 CDR MSH 10: " _cdrAddressHl7.GetValueAt("MSH:MessageControlID")) 
 
 //MSH 11 - Leave blank
 
  do cdrAddressHl7.SetValueAt(context.versionID, "MSH:VersionID")
 $$$TRACE("HL7 CDR MSH 12: " _cdrAddressHl7.GetValueAt("MSH:VersionID")) 
 
 //MSH 18
 do cdrAddressHl7.SetValueAt(context.characterSet, "MSH:CharacterSet")
 $$$TRACE("HL7 CDR MSH 18: " _cdrAddressHl7.GetValueAt(" MSH:CharacterSet")) 
 
  //EVN 01
  do cdrAddressHl7.SetValueAt(context.eventTypeCode, "EVN:EventTypeCode")
  $$$TRACE("HL7 EVN 01: " _cdrAddressHl7.GetValueAt("EVN:EventTypeCode")) 
  
  //EVN 02
  do cdrAddressHl7.SetValueAt(finalTimeStamp, "EVN:RecordedDateTime")
  $$$TRACE("HL7 EVN 02: " _cdrAddressHl7.GetValueAt("EVN:RecordedDateTime")) 

  //EVN 05     
  do cdrAddressHl7.SetValueAt(context.evnTimeEvent, "EVN:OperatorID")
  $$$TRACE("HL7 EVN 05: " _cdrAddressHl7.GetValueAt("EVN:OperatorID")) 
  
  
   //PID Address update    
  //PID 02.1 - Important to be accurate
  do cdrAddressHl7.SetValueAt(request.MMINumber, "PID:PatientIDExternalID.ID")
   $$$TRACE("HL7 CDR MMI Number: " _cdrAddressHl7.GetValueAt("PID:PatientIDExternalID.ID"))
 
 //PID 02.4
 do cdrAddressHl7.SetValueAt(context.evnAssigningAuthority,"PID:PatientIDExternalID.assigningauthority")
  $$$TRACE("HL7 PID 2.4: " _cdrAddressHl7.GetValueAt("PID:PatientIDExternalID.assigningauthority"))    
       
  //PID 2.5   
   do cdrAddressHl7.SetValueAt(context.mrnNumber,"PID:PatientIDExternalID.identifiertypecode")
    $$$TRACE("HL7 PID 2.5: " _cdrAddressHl7.GetValueAt("PID:PatientIDExternalID.identifiertypecode"))
  
  //PID 3.1   
  do cdrAddressHl7.SetValueAt(request.MMINumber,"PID:PatientIDInternalID(1).ID")
   $$$TRACE("HL7 PID 3.1: " _cdrAddressHl7.GetValueAt("PID:PatientIDInternalID(1).ID"))   

  //PID 3.5 
  do cdrAddressHl7.SetValueAt(context.empiNumber, "PID:PatientIDInternalID(1).identifiertypecode")
    $$$TRACE("HL7 PID 3.5: " _cdrAddressHl7.GetValueAt("PID:PatientIDInternalID(1).identifiertypecode"))
   
  //PID 4.1 
   do cdrAddressHl7.SetValueAt(request.MMINumber,"PID:AlternatePatientID")
  // $$$TRACE("HL PID 4.1, " _cdrAddressHl7.GetValueAt("PID:AlternatePatientID")) 
   
   do cdrAddressHl7.SetValueAt(context.PID42, "PID:AlternatePatientID.checkdigit")
  // $$$TRACE("HL PID 4.2, " _cdrAddressHl7.GetValueAt("PID:AlternatePatientID.checkdigit"))
   
   do cdrAddressHl7.SetValueAt(context.empiNumber, "PID:AlternatePatientID.assigningauthority") 
  // $$$TRACE("HL PID 4.4, " _cdrAddressHl7.GetValueAt("PID:AlternatePatientID.assigningauthority"))
   
  do cdrAddressHl7.SetValueAt(context.accountNumber, "PID:AlternatePatientID.identifiertypecode")
  // $$$TRACE("HL PID 4.5, " _cdrAddressHl7.GetValueAt("PID:AlternatePatientID.identifiertypecode")) 
   
   
 //PID 05
   do cdrAddressHl7.SetValueAt(context.cdrLastName, "PID:PatientName.familyname") 
 // $$$TRACE("HL7 CDR Patient LastName: " _cdrAddressHl7.GetValueAt("PID:PatientName.familyname"))
 
