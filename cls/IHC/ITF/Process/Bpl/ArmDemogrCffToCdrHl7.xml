<code name='Compare Old addr in rec with CDR' xpos='470' ypos='1800' >
<![CDATA[ set extAdd = $EXTRACT(context.cdrAddress1,1,$LENGTH(context.WrongAppend))
 $$$TRACE("ExtAddress " _extAdd)
 
 $$$TRACE("Adding code to remove - from the zip CDR Response")
 set cdrZip =  $ZSTRIP(context.cdrZip,"*P") 
 $$$TRACE("The CDR Zip: " _cdrZip) 
 
 if ((context.cdrLastName = request.LastName) && (context.cdrDob  = request.OldBirthdate) && (context.cdrAddress1 = request.OldAddress1)  && (context.cdrAddress2 = request.OldAddress2) && (context.cdrState = request.OldState) && (context.cdrCity = request.OldCity) && (cdrZip = request.OldZip) && ($ZCONVERT(extAdd, "U") '= $ZCONVERT(context.WrongAppend, "U")))   
  {
  set context.tmpAddress1 = context.WrongAppend_context.cdrAddress1
   $$$TRACE("CDR Address 1 Updated with Wrong cdrTempAddress1: " _context.tmpAddress1)
  }  
  else
  {
  set context.tmpAddress1 = context.cdrAddress1
  $$$TRACE("CDR Address1 Unchanged cdrTempAddress1: " _context.tmpAddress1)
  }
]]]]><![CDATA[>
