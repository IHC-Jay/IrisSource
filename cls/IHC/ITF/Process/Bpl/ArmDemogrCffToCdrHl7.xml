<![CDATA[  //CdrReadMmiTargetConfigName validation
 set cdrReadMmiTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","CdrReadMmiTargetConfigName",.tStatus) 
 if (($$$ISERR(tStatus))){
    $$$TRACE("Status: " _tStatus)     
  set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get CdrReadMmiTargetConfigName, shutting down.")
    
 } else {
 $$$TRACE("CdrReadMmiTargetConfigName: " _cdrReadMmiTargetConfigName)     
 set cdrReadMmiRequest = ##class(Ens.StringRequest).%New()  
 set cdrReadMmiRequest.StringValue = request.MMINumber
 set tStatus=process.SendRequestSync(cdrReadMmiTargetConfigName,cdrReadMmiRequest,.cdrReadMmiResponse)
 if ('tStatus) {
      $$$TRACE("MMI Record not available. Hence, skipping this record: " _request.MMINumber)
  set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"MMI Record not available. Hence, skipping this record. ")
 } else { 
  $$$TRACE("MMI Record available: " _request.MMINumber)
   set context.cdrReadMmiResponse= cdrReadMmiResponse   
   $$$TRACE("cdrReadMmiResponse.DataRecord: <"_cdrReadMmiResponse.DataRecord_">")
   set context.dataRecord = cdrReadMmiResponse.DataRecord
   $$$TRACE("context.dataRecord: <"_ context.dataRecord _">")   
   set context.mmiRecord = context.dataRecord.ListOfMMIRecords.GetAt(1)
   $$$TRACE("context.mmiRecord <"_ context.mmiRecord _">")
   set context.memberInfo = context.mmiRecord.MemberInfo
   $$$TRACE("context.memberInfo <"_ context.memberInfo _">")
 }
 }]]]]><![CDATA[>
