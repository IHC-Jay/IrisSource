<code name='createHddRequests GetRepFromNcid' xpos='740' ypos='2300' >
<![CDATA[
  	$$$TRACE(" GetRepfromNcid Hdd Requests..")
  	set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
  	set orc1OrderControl = request.GetValueAt("ORCgrp(1).ORC:OrderControl")  	
 if (orc1OrderControl '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , orc1OrderControl, context.hddContextOrderControl, "ORC1:OrderControl")  	  	
     $$$TRACE("Hdd Request ORC1-1 OrderControl is " _ orc1OrderControl)     		
 }
 
 
 set patClass = request.GetValueAt("PIDgrp.PV1grp.PV1:PatientClass")  	
 if (patClass '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, patClass, context.hddContextHelp, "PV12:Class")  	  	
     $$$TRACE("Hdd Request PV1-2 Patient Class is " _ patClass)     		
 }
 
 
 set pid8Sex = request.GetValueAt("PIDgrp.PID:Sex")  	
 if (pid8Sex '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid8Sex, context.hddContextHelp, "PID8:Sex")  	  	
     $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 }
 
 Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.hddContextCernerToIhcLocation, "MSH4:Facility")  	  	
 $$$TRACE("Hdd Request MSH-4 Sending Facility is " _ context.facId )     		


 set examCodeId = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceID.identifier")  
 if (examCodeId '= "" && $ISVALIDNUM(examCodeId)= "1") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , examCodeId, context.hddImgExamcodeContext, "OBR4:ExamCode")  	  	
     $$$TRACE("Hdd Request ExamCode is " _ examCodeId)     		
 }
 
      
 
]]]]><![CDATA[>
