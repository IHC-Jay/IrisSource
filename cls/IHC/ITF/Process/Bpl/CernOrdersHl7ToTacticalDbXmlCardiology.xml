  	$$$TRACE(" isMember Hdd Requests..")
    set context.isMemberHddRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateIsMemberObject()    
    
    set context.obr4ncid = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceID.identifier")  	
    $$$TRACE("Hdd isMember request OBR-4 " _ context.obr4ncid)
    if (context.obr4ncid '= "") {
	     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddIsMemberObject(context.isMemberHddRequest , context.hddIsMemberDomainNcid, context.obr4ncid, "obr4:memberNcid")  	  	
