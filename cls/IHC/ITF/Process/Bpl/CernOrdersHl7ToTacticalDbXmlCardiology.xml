<code name='CallIsMemberHddMethod' xpos='470' ypos='1400' >
<![CDATA[ set tStatus=process.SendRequestSync(context.hddTargetConfigName,context.isMemberHddRequest,.hddIsMemberResponse)
 if ('tStatus) {     
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))    
 }else { 
