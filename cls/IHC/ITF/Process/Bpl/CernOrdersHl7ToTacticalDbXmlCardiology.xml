<![CDATA[
   Set context.accessionNum = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:FillerOrderNumber.entityidentifier")
    if ($LENGTH(context.accessionNum)>0){ 
       set context.isValidationPassed=1	  	  
 	}else{
	 	$$$TRACE(" Invalid Filler Order Number: ["_context.accessionNum_"]")
	     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, " Skipping the record.. Invalid filler order number(AccessionNumber):["_context.accessionNum_"] for the empi number:["_context.empiNum_"]")
	  }
