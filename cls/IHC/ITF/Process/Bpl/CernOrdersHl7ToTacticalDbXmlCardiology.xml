<code name='ValidateIsMember' xpos='200' ypos='1350' >
<![CDATA[ set hddObjFac= ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.isMemberHddResponse, "obr4:memberNcid")  
  if (hddObjFac'= ""){
     if (hddObjFac.Rep '="") {
       $$$TRACE("Hdd returned Ismember (OBR-4.1): " _ hddObjFac.Rep)
       set memberFlag=hddObjFac.Rep
       $$$TRACE("member flag (OBR-4.1): " _ memberFlag)
       if (memberFlag = 0) {   		   
   		   set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, " Skipping the record.. Member is not valid Nucli or MRI cardio record: Accession Number: ["_context.accessionNum_"]. Empi number:["_context.empiNum_"]. OBR-4.1 Member Ncid: ["_context.obr4ncid_"]")
   		}
     }	 
   }  
   
]]]]><![CDATA[>
