<code name='ValidateAndSetSendingFacility' xpos='200' ypos='650' >
<![CDATA[
 set context.facId = request.GetValueAt("MSH:SendingFacility.namespaceID")  	
 if (context.facId '= "" && $ISVALIDNUM(context.facId)= "1") {
	 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernOrdersHl7ToTacticalDbXmlCardiology.Lookup.CernerFacilitiesIn",context.facId, .retVal )	
	 if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {       
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid facility:["_ context.facId _"] from iCentra Orders, Skipping the record." _ "Hl7 Msg:" _ request.RawContent)
     }       
	 set context.isValidationPassed=1	  	       
 } else {
     // Skip message if MSH-4 is empty or invalid ncid
  set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH-4 Sending Facility ncid is empty or inalid. Skipping the record.")	 
 }
 ]]]]><![CDATA[>
