	  set context.isValidationPassed=0
	  $$$TRACE("Empi# is NOT a VALID number ")
	  set Status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName," Skipping the record. Invalid empi number:["_context.empiNum_"]")
 	}
 	  ]]]]><![CDATA[>
