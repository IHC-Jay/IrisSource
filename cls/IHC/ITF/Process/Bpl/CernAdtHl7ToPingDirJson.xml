<![CDATA[ $$$TRACE("Call REST Operation")
  if (context.pingDirSvcRequest'="") {
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync(process.TargetConfigNames,context.pingDirSvcRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set statusLine=""
      set statusCode=""
      set statusDesc=""
      set context.restHttpResponse=httpRESTResponse
      set statusLine=context.restHttpResponse.HTTPHeaders.GetAt("StatusLine")
      if (statusLine'=""){
	set statusCode=$piece(statusLine," ",2)
	set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
		  // If status code is 200 the check the reponse to see if it got processed correctly or not
      if (statusCode'="200"){
        set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"REST service response with code: "_statusCode_"  Desc: "_statusDesc) 
      }
      else {
        Set tcharStream = ##class(%GlobalCharacterStream).%New()
        Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
        $$$TRACE("tcharStream size:"_tcharStream.Size)
        set text=""
        While 'tcharStream.AtEnd {
          Set text = text_tcharStream.Read($$$MaxStringLength)
        } 
        $$$TRACE("REST service response: "_text)
      }
    }
    ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Post request failed with Status Code: "_statusCode_" : Status Desc: "_statusDesc) 
    }
  }]]]]><![CDATA[>
