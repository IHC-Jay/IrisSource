<code name='CheckForLookupTables' xpos='470' ypos='1000' >
<annotation><![CDATA[CheckForLookupTables]]]]><![CDATA[></annotation>
<![CDATA[
  set retVal = ##class(Ens.Util.LookupTable).%ExistsTable("IHC.ITF.Process.Bpl.IhcHieDemogrJsonToCdrHl7.IhcHieToCdrAppsFacNcidMappings")
  if (retVal = 0){
	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Lookup table IHC.ITF.Process.Bpl.IhcHieDemogrJsonToCdrHl7.IhcHieToCdrAppsFacNcidMappings not exists")  
  }else{
	  set appName=$P(request.application,":",2)
	  $$$TRACE("appName --> " _ appName)
	  
	  if ($L(request.application)=0){
		  set appName = "Inspector"			    
	  }elseif($L(appName)=0){
		  set appName = request.application		    
	  }
	  set context.sendFacilityRep = appName	
	  set retStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.IhcHieDemogrJsonToCdrHl7.IhcHieToCdrAppsFacNcidMappings", appName, .retVal )
	  $$$TRACE("retVal --> " _ retVal)
	  if (retVal="Unknown"){
		  $$$TRACE("INVALID APPNAME: " _ appName) 
		  set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Application name: ["_appName_"] is invalid. Skip message.")
	  }else{
		  set context.appNameNcid = retVal
	  }	  	  	  
    }
    ]]]]><![CDATA[>
</code>


