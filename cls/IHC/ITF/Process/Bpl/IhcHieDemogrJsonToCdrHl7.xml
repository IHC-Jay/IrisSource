 set trequest = ##class(Ens.StringRequest).%New("")
 set trequest.StringValue = context.empiNum
 set tStatus=process.SendRequestSync(context.checkMmiTargetConfigName,trequest,.checkMmiResponse)
 $$$TRACE(" Status value after CheckMmi call: "_tStatus)
 if ('tStatus) {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected CheckMMI response returned or CheckMMI call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
 } else { 
 	 set context.mrnExistsInCdr = checkMmiResponse.StringValue  
 	 $$$TRACE(" EMPI# exists in CDR : ["_context.mrnExistsInCdr_"]")
