<code name='get the MSPR xml from Provider Info' xpos='200' ypos='950' >
<![CDATA[ // Validate the response by loading it to the IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo structure
 set status=$$$OK
 set replstr="<?xml version="_""""_"1.0"_""""_"?>"
 set context.MSPRResponseString=$Replace(context.MsprOutput.StringValue,replstr,"")
 // Remove the XMl Version tag from start and Junk characters at the end
 set context.MSPRResponseString="<CiwsInfo>"_$piece(context.MSPRResponseString,"<CiwsInfo>",2)
 set context.MSPRResponseString=$piece(context.MSPRResponseString,"</CiwsInfo>")_"</CiwsInfo>"
 $$$TRACE("MSPR Response: "_context.MSPRResponseString) 
 Set reader = ##class(%XML.Reader).%New()
 Set sc=reader.OpenString(context.MSPRResponseString)
 if '$$$ISOK(sc){
     set stattus=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing MSPR Output"_$SYSTEM.Status.GetOneErrorText(sc))  
  } 
  Else {
      Do reader.Correlate("CiwsInfo","IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo")
      do reader.Next(.CiwsInfo,.sc)
      set context.MsprResponse=CiwsInfo
      If $$$ISOK(sc){
	       $$$TRACE("MSPR Output parsed successfully.")
         // check if the the request was successfuly posted to MSPR
         set status=##class(IHC.ITF.Process.Bpl.MsprXmlToLdapOracleFromHrWorkday).ValidateMSPRResponse(CiwsInfo,process.%ConfigName)
         
         If $$$ISOK(status){
	        $$$TRACE("Message parsed successfuly to MSPR") 
         }
      }Else
      {     
          set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
      }    
  }
 
  $$$TRACE("ReponseString:"_context.MSPRResponseString)]]]]><![CDATA[>
</code>
