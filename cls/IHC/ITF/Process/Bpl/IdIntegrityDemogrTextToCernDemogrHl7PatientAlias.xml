<code name='initializeTargets' xpos='200' ypos='550' >
<![CDATA[ 
 set context.accessTokenTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","AccessTokenTargetConfigName",.pstatus)
 if ($$$ISOK(pstatus)){
