<code name='CallWebServiceAccessTokenFromPing' xpos='470' ypos='1200' >
<![CDATA[ 
  $$$TRACE(" Target Operation to get AccessToken from Ping service " _ context.accessTokenTargetConfigName)   
   set httpRequestObj=##class(EnsLib.HTTP.GenericMessage).%New()   
   set status =  process.SendRequestSync(context.accessTokenTargetConfigName,httpRequestObj,.accessTokenResponse)
   if ($$$ISOK(status)){
      $$$TRACE("AcsessToken Operation status - OK")
      set context.restAccessTokenHttpResponse=accessTokenResponse      
      Set tcharStream = ##class(%GlobalCharacterStream).%New()
      Set tStatus = tcharStream.CopyFrom(context.restAccessTokenHttpResponse.Stream)
      set text=""
      While 'tcharStream.AtEnd {
        Set text = text_tcharStream.Read($$$MaxStringLength)
      } 
      set context.accessToken = text
      $$$TRACE("Accss Token from Ping Service: "_context.accessToken)
      if (context.accessToken=""){
	      $$$TRACE(" Access Token is blank/empty")
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," No Access Token from ping service. ") 
	  }      
    }
    else {
	    $$$TRACE("Calling Ping Service to get the Access Token failed!!!")
       set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Calling Ping Service to get the Access Token failed!!!") 
    }
   ]]]]><![CDATA[>
</code>


<code name='InitializeValues' xpos='470' ypos='900' >
<![CDATA[ 
		set context.cmrn = request.CMRN
		set context.AliasType = request.AliasType
		set context.MrnToAdd = request.MrnToAdd
		if (context.MrnToAdd=""){ 
		 set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName," PatientAlias: ["_context.MrnToAdd_"] is empty. Skipping the record..")
		}
		if (context.AliasType=""){ 
		 set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName," AliasType ["_context.AliasType_"] is empty. Skipping the record..")
		}
   ]]]]><![CDATA[>
</code>

<code name='CallPatientServiceReadDemographics' xpos='470' ypos='900' >
<![CDATA[ 
   if ($L(context.cmrn)>0){ 
     $$$TRACE(" Target Operation to Patient service " _ context.patientServiceTargetConfigName) 
     set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.httpsRequestForPingService).%New() 
     set httpPingServiceRequestObj.accessToken = context.accessToken
     set httpPingServiceRequestObj.operationType = "READ"   
     set httpPingServiceRequestObj.assignAuth = "INMT"
     set httpPingServiceRequestObj.identifier = request.CMRN  
     $$$TRACE(" Calling Patient Service - GetPatientService:  "_context.patientServiceTargetConfigName)
     set status = process.SendRequestSync(context.patientServiceTargetConfigName,httpPingServiceRequestObj,.patientServiceResponse)
     
     if ($$$ISOK(status)){
      $$$TRACE("Call PatientService-GetPatientService Operation OK status. ")
      set restPatientServiceHttpResponse = patientServiceResponse
            
      set jsonPatient = restPatientServiceHttpResponse.Attributes.GetAt("Person")
      
      $$$TRACE("Json: " _ jsonPatient  )
      
      if (jsonPatient="NORESPONSE"){
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," CMRN: ["_context.cmrn_"] not exists in Verato. Skipping the record with error notification to EMPI support.")
      }
      
      set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(jsonPatient) 
      set statusVal = consumedJSONobj.%Get("status")  
      $$$TRACE("  statusVal: "_statusVal)     
      if (statusVal="SUCCESS"){ 
           			
      	set strContainer = ##class(Ens.StringContainer).%New()
      	set strContainer.StringValue = jsonPatient
      
	  	set context.hieReadDemogrObj = ##class(IHC.ITF.Util.Hie.HieServiceReadDemographics).%New()
	  	set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.HiePatientService).%New() 
      	set httpPingServiceRequestObj.streamObject = strContainer
    
      	set jsonObj = ##class(IHC.ITF.Util.IhcHieGetDemographicsParser).%New() 
      	set temp =  jsonObj.ParseGetDemogrJson(httpPingServiceRequestObj, .resp) 
    
      	$$$TRACE("Data:::"_temp)
    
      	$$$TRACE("resp:::"_resp)
    
      	set context.hieReadDemogrObj = resp
    
      
      	$$$TRACE(" ***json parsing done **")
      }elseif(statusVal="NO_MATCH"){
	  	set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," CMRN: ["_context.cmrn_"] not exists in Verato. Skipping the record with error notification to EMPI support.")
	  }else{
		  set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Shutting down..Unknown Error.")
	  }
    
    }else {
      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Error while calling the PatientService-GetPatientService") 
    }  
   }else{
	   set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName," CMRN: ["_context.cmrn_"] is empty. Skipping the record..")
   }
      
   ]]]]><![CDATA[>
</code>



