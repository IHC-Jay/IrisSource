<code name='convert to json' xpos='200' ypos='1350' >
<![CDATA[  
    $$$TRACE("Converting XML to JSON Operation.. ")
    set xmlStr=response.OutputToString()  
 
    
    $$$TRACE("DTL Output: "_xmlStr)  	       
    set myList = $LISTBUILD("item")
    set xmlStr = $ZSTRIP(xmlStr, "*C")
    set json = ##class(IHC.ITF.ITFCOMMON.Util.XmlToJson2).CreateJson(xmlStr,myList)
    

    $$$TRACE("JSON string: "_json)             
    set jsonProcessRequest=##class(Ens.StringContainer).%New()
    set rootStr = "{""root"":"
    if (json [ rootStr)
    {
       set jsonProcessRequest.StringValue= ##class(Ens.Util.FunctionSet).SubString(json, $LENGTH(rootStr) + 1, $LENGTH(json)-1)
    }
    else
    {
       set jsonProcessRequest.StringValue= json
    }
      
    set context.provJsonStrReq.StringValue  = jsonProcessRequest.StringValue
    $$$TRACE("JSON Ens.StringRequest.StringValue: "_context.provJsonStrReq.StringValue )         
    
   ]]]]><![CDATA[>
