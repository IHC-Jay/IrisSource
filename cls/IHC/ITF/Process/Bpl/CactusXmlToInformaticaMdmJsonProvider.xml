<code name='Get NCIDs for Specialities' xpos='200' ypos='850' >
<![CDATA[  $$$TRACE("Speciality HDDLookup")
  
  set currentRep=""
  set k1=""
 
  For {
		Set k1=request.GetNextIndex("Provider(1).ProviderSpecialtiesRecord()",k1,.tSCTrans)
		Quit:k1=""
		Set currentRep=$zStrip(request.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").specialty_rtk.ID"),"<>W")
		$$$TRACE("Speciality: "_currentRep_" #:"_k1)
		Set active=request.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").active.Value")
		If ((currentRep '="NONE") && (currentRep '="PRSPTYALTE") && (currentRep '="PRSPTYPRM") && (active = ".T.")) {
			do 
			
			set specNcid =##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(currentRep, "291", "50450833", context.hddTargetConfigName, .process)  
			$$$TRACE("NCID Speciality HDDLookup value: "_ specNcid _ ", Speciality: "_currentRep)
			
			Do context.listOfSpecialities.Insert(specNcid _ "," _ currentRep _"," _ $zStrip(request.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").specialtytype_rtk.ID"),"<>W") _ "," _ $zStrip(request.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").providerspecialty_k.Value"),"<>W") )
			
			 
		}
	}
	
	
                	
		
