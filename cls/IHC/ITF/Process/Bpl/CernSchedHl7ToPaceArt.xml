<code name='Check Event Type' xpos='200' ypos='850' >
<annotation><![CDATA[- Get event type (MSH.9.2)
- See if this is one we send to CPR+
- If not sent, write filter message to log & skip
]]]]><![CDATA[></annotation>
<![CDATA[ // get MSH.9.2  (Event Code)
 set inboundEventType = request.GetValueAt("MSH:MessageType.triggerevent")
  
 // Define, initialize 'AllowedEventTypes'
 set AllowedEventTypes=""
 
 // Initialize 'isAllowedEventType'
 set isAllowedEventType = 0
 
 // Retrieve AllowedEventTypes from 'Additional Setting' tab
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedEventTypes",.AllowedEventTypes)
  
 // If the 'AllowedEventTypes' setting was not found, signal error and shutdown
 // ELSE if the setting was found, but was empty, signal error and shutdown
 // ELSE check incoming event type
 if ($$$ISERR(pstatus))
 {
    // AllowedEventTypes setting was not found
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).Initialization(process.%ConfigName, "Initialization error, No configuration for AllowedEventTypes found. Shutting down")
 }
 elseif (AllowedEventTypes = "")
 {
    // AllowedEventTypes setting found, but was empty
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, AllowedEventTypes configuration is empty. Shutting down")
 }
 else
 {
    $$$TRACE("AllowedEventTypes : "_AllowedEventTypes) 
         
    // Loop thru each allowed event type from the 'AdditionalSettings' tab
    For iTarget=1:1:$L(AllowedEventTypes, ",") 
    { 
        
        Set tOneTarget=$ZStrip($P(AllowedEventTypes,",",iTarget),"<>W") 
        Continue:""=tOneTarget
            
        // If we found MSH.9.2 in list of allowed event types, then bail from loop    
        if (inboundEventType = tOneTarget)
        {
            $$$TRACE("Event type accepted")
	    set isAllowedEventType = 1
	    QUIT
        } 
    }
 
    // If this event type is not sent to CPR+, write filter message to log & skip
    if (isAllowedEventType = 0)
    {
       Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Event type ["_context.EventType_"] not sent to PaceArt. Skipping the record.") 
    }
 }]]]]><![CDATA[>
