<code name='CheckingForEmailAddress' xpos='200' ypos='1250' >
<annotation><![CDATA[CheckingEmailAddress()]]]]><![CDATA[></annotation>
<![CDATA[ 
    set addrIndex="",tSC=1 
    set addressFlag = 0
    For { 
      Set addrIndex=request.GetNextIndex("PIDgrp(1).PID:PatientAddress()",addrIndex,.tSCTrans)  Quit:addrIndex=""          
      set addrType = request.GetValueAt("PIDgrp(1).PID:PatientAddress("_addrIndex_").AddressType")
      $$$TRACE(" AddressType: "_addrType)
      if (addrType = "50450664" || addrType = "50450665"){
	      if (addrType = "50450664"){
		      set emailAddress = request.GetValueAt("PIDgrp(1).PID:PatientAddress("_addrIndex_").StreetAddress.StreetorMailingAddress") 
              if (emailAddress =""){	   	    
 	    		set context.errMsg = context.errMsg_" Required element in iCentra SIU: Home email address ["_emailAddress_"] is blank/invalid."_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	    		//set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
     		}
		  }
		  if (addrType = "50450665"){
		      set emailAddress = request.GetValueAt("PIDgrp(1).PID:PatientAddress("_addrIndex_").StreetAddress.StreetorMailingAddress") 
              if (emailAddress =""){	   	    
 	    		set context.errMsg = context.errMsg_" Required element in iCentra SIU: Office email address ["_emailAddress_"] is blank/invalid."_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	    		//set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
     		}
		  }	      
	  }
	 
	  if (addrType = "199"){
		   set addressFlag =1
		   set address1 = request.GetValueAt("PIDgrp(1).PID:PatientAddress("_addrIndex_").StreetAddress.StreetorMailingAddress")
		   if (address1 =""){	   	    
 	    		set context.errMsg = context.errMsg_" Required element in iCentra SIU: address ["_address1_"] is blank/invalid."_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	    		//set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
     		}
     		set city = request.GetValueAt("PIDgrp(1).PID:PatientAddress("_addrIndex_").City")
     		if (city =""){	   	    
 	    		set context.errMsg = context.errMsg_" Required element in iCentra SIU: city ["_city_"] is blank/invalid."_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	    		//set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
     		}
     		set state  = request.GetValueAt("PIDgrp(1).PID:PatientAddress("_addrIndex_").StateorProvince")
     		if (state =""){	   	    
 	    		set context.errMsg = context.errMsg_" Required element in iCentra SIU: state ["_state_"] is blank/invalid."_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	    		//set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
     		}
     		if ($L(state) '= 2){
	     		set context.errMsg = context.errMsg_" Length of state is not 2 letter in iCentra SIU: state ["_state_"] "_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	    		//set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
     		}
     		set zipCode = request.GetValueAt("PIDgrp(1).PID:PatientAddress("_addrIndex_").ZiporPostalCode")
     		if ($L(zipCode) '= 5){
	     		set context.errMsg = context.errMsg_" Length of zipcode is not 5 digit in iCentra SIU: zipCode ["_zipCode_"] "_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	    		//set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
     		}     		
	  }
    }
    
    $$$TRACE(" Address Flag: "_addressFlag)
    if (addressFlag = "0"){
	    set context.errMsg = context.errMsg_" Missing Address field PID-11 home address type 199 in iCentra SIU. "_$CHAR(10)
 	    		$$$TRACE(context.errMsg)
	}
 ]]]]><![CDATA[>
</code>
   

<code name='CheckDOB' xpos='200' ypos='650' >
<annotation><![CDATA[Check DOB ]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Check DOB...")
   set context.dob = request.GetValueAt("PIDgrp(1).PID:DateTimeofBirth")
       if (context.dob =""){	   	    
 	     set context.errMsg = context.errMsg_" Required element in iCentra SIU: DOB ["_context.dob_"] is blank/invalid."_$CHAR(10)
 	     $$$TRACE(context.errMsg)
	     //set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg)
       }else{       
       	if ($L(context.dob) < 8){
	      set context.errMsg = context.errMsg_" Length of DOB in iCentra SIU is less than 8: DOB ["_context.dob_"]"_$CHAR(10)
 	      $$$TRACE(context.errMsg)
	      //set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Skipping the record.."_context.errMsg) 		          	    
       	}else{
	       	if ($L(context.dob) = 8){
		       	$$$TRACE(" Calculating Patient age..")
		       	set patAge = ##class(IHC.ITF.Transform.Dtl.CalAge).CalAge(context.dob)
		       	$$$TRACE(" Age of the patient: "_patAge)
		       	if (patAge < 18){
			       	set context.errMsg = context.errMsg_" Minor patient. Age is < 18 in iCentra SIU: DOB ["_context.dob_"]"_$CHAR(10)
 	                $$$TRACE(context.errMsg)
			    }
	       	}
	     }
       }
]]]]><![CDATA[>
</code>




