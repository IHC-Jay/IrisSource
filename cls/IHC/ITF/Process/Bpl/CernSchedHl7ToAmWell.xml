<code name='getAmWellMRN#' xpos='200' ypos='650' >
<annotation><![CDATA[Get EMPI(CMRN and AmWell)]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Get AmWell MRN#...")   
  set k1="",tSC=1 
 For { 
     Set k1=request.GetNextIndex("PIDgrp(1).PID:3()",k1,.tSCTrans)  Quit:k1=""               
     If (request.GetValueAt("PIDgrp(1).PID:3("_k1_").4.1")= context.AmWellMrnTypeNcid) {
         Set context.AmWellMrnNumber=request.GetValueAt("PIDgrp(1).PID:3("_k1_").1")                     
     }  
     If (request.GetValueAt("PIDgrp(1).PID:3("_k1_").4.1")="EMPI") {
         Set context.empiNumber=request.GetValueAt("PIDgrp(1).PID:3("_k1_").1")                  
     }        
 } 
 $$$TRACE("AmWell MRN " _ context.AmWellMrnNumber)  
 if ($ISVALIDNUM(context.AmWellMrnNumber)'="1"){
  	$$$TRACE("No AmWell MRN.....") 
  //	set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "No AmWell MRN in the record. Skipping it...")
 }
 if ($ISVALIDNUM(context.empiNumber)'="1"){	  
	  $$$TRACE("EMPI# is NOT a number. SKipping the record.. ")
	  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.empiNumber, "Invalid Empi number: ["_ context.empiNumber _"]. Skipping the record.")
 } 
 ]]]]><![CDATA[>
