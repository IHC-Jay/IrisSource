<code name='Check facility' xpos='200' ypos='650' >
<annotation><![CDATA[- Get sending facility (MSH.4)
- See if this facility is one we do not send
- If not sent, write filter message to log & skip
]]]]><![CDATA[></annotation>
<![CDATA[
 // 
 // 5/24/2017 
 // RITM0067153
 // Add facility filter
 //
 
 // get MSH.4  (Sending Facility)
 set Facility = request.GetValueAt("MSH:SendingFacility")

   // Define, initialize 'ExcludedFacilities'
 set ExcludedFacilities=""
 
 // Initialize 'isExcludedFacility'
 set isExcludedFacility = 0

 // Retrieve ExcludedFacilities from 'Additional Setting' tab
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ExcludedFacilities",.ExcludedFacilities)
  
 // If the 'ExcludedFacilities' setting was not found, signal error and shutdown
 // ELSE if the setting was found, but was empty, signal error and shutdown
 // ELSE check incoming facility
 if ($$$ISERR(pstatus))
 {
    // ExcludedFacilities setting was not found
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, No configuration for ExcludedFacilities found. Shutting down")
 }
 elseif (ExcludedFacilities = "")
 {
    // ExcludedFacilities setting found, but was empty
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, ExcludedFacilities configuration is empty. Shutting down")
 }
 else
 {
    $$$TRACE("ExcludedFacilities : "_ExcludedFacilities) 
         
    // Loop thru each allowed facility from the 'AdditionalSettings' tab
    For iTarget=1:1:$L(ExcludedFacilities, ",") 
    { 
        
        Set tOneTarget=$ZStrip($P(ExcludedFacilities,",",iTarget),"<>W") 
        Continue:""=tOneTarget
            
        // If we found MSH.4 in list of excluded facilities, then bail from loop    
        if (Facility = tOneTarget)
        {
            $$$TRACE("Facility not to be sent")
	    set isExcludedFacility = 1
	    QUIT
        } 
    }
 
    // If this facility is not sent, write filter message to log & skip
    if (isExcludedFacility = 1)
    {
       Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Facility ["_Facility_"] not sent to TacticalDB. Skipping the record.") 
    }
 }  ]]]]><![CDATA[>
