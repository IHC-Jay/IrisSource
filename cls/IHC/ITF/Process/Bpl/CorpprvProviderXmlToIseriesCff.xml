<code name='Check if all Host and Site ID are Present' xpos='200' ypos='1750' >
<![CDATA[   set isError=0
   set errorMsg=""
   $$$TRACE("Fac Count:"_context.facNameList.Count() )
   set facNam=""
   For iallFac=1:1:context.facNameList.Count() 
        { 
            set facNam= context.facNameList.GetAt(iallFac)
            $$$TRACE("facNam:"_facNam)
            set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Corpprv.IseriesHostSiteIds",facNam,.tHostIdSiteId)
            if ($$$ISOK(tStatus)){
                if $l(tHostIdSiteId,",")=3{
                  set hostId = $P(tHostIdSiteId,",",1)
                  do context.hostId.SetAt(hostId,facNam)
                  set siteId = $P(tHostIdSiteId,",",2)
                  do context.siteId.SetAt(siteId,facNam)
                   $$$TRACE("After Adding"_facNam)
                }else{
                  set isError=1
                  set errorMsg="Look Up Value is not in Format (HostId,SiteId,Desc) for"_facNam_$C(13,10)
                }
            }else{
              set isError=1
              set errorMsg="Error in getting HostId/Site ID for Faciltity:"_facNam_$C(13,10)
            }
         }
         
         if isError{
           Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, errorMsg)
         }]]]]><![CDATA[>
