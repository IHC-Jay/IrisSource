<code name='Get all the Facilities from Look Up' xpos='200' ypos='1650' >
<![CDATA[ set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Corpprv.IseriesFacilities","allFac",.tallFacValue)
 if ($$$ISOK(tStatus)){
     set allFacValue= tallFacValue
     For iallFac=1:1:$L(allFacValue, ",") 
        { 
            Set tallFacName=$ZStrip($P(allFacValue,",",iallFac),"<>W")  
            Continue:""=tallFacName
            
            set stat = context.facNameList.Insert(tallFacName)
            $$$TRACE("tallFacName" _ tallFacName_ " " _ stat)
         }
 }]]]]><![CDATA[>
