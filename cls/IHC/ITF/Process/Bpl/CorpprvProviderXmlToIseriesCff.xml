     do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, val, "50453101", key) 
   }
 }
 //Call 
 $$$TRACE("Call HDD look up specialty rep")
 set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,context.hddRepRequest,.hddRepResponse)
 If $$$ISOK(tStatus){ 
   set context.hddResponse= hddRepResponse
   set key1=""
   For {
     set SpecialtyRepVal=""
     Set val = context.SpecialtyNcids.GetNext(.key1)
     Quit:key1=""	 
     $$$TRACE("Val:"_val_" key: "_key1)
     set context.hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddResponse,key1)
     $$$TRACE("SpecialtyRep:"_context.hddObj.Rep)      	 	        	 
     do context.SpecialtyNcids.SetAt(context.hddObj.Rep,key1)
   }
 }
