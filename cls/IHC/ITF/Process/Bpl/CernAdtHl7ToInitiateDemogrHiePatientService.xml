<code name='CallWebServiceAccessTokenFromPing' xpos='470' ypos='2350' >
<![CDATA[ 
  $$$TRACE(" Target Operation to get AccessToken from Ping service " _ context.accessTokenTargetConfigName)   
   set httpRequestObj=##class(EnsLib.HTTP.GenericMessage).%New()   
   set status =  process.SendRequestSync(context.accessTokenTargetConfigName,httpRequestObj,.accessTokenResponse)
   if ($$$ISOK(status)){
      $$$TRACE("AcsessToken Operation status - OK")
      set context.restAccessTokenHttpResponse=accessTokenResponse      
      Set tcharStream = ##class(%GlobalCharacterStream).%New()
      Set tStatus = tcharStream.CopyFrom(context.restAccessTokenHttpResponse.Stream)
      set text=""
      While 'tcharStream.AtEnd {
        Set text = text_tcharStream.Read($$$MaxStringLength)
      } 
      set context.accessToken = text
      $$$TRACE("Accss Token from Ping Service: "_context.accessToken)
      if (context.accessToken=""){
	      $$$TRACE(" Access Token is blank/empty")
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," No Access Token from ping service. ") 
	  }      
    }
    else {
	    $$$TRACE("Calling Ping Service to get the Access Token failed!!!")
       set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Calling Ping Service to get the Access Token failed!!!") 
    }
   ]]]]><![CDATA[>
</code>

<code name='ConvertXmlToJSONAndCallPatientService' xpos='1010' ypos='3150' >
<![CDATA[  
    $$$TRACE("Converting XML to JSON Operation.. ")
    set xmlStr=response.OutputToString()  
    $$$TRACE("DTL Output: "_xmlStr)  
    set myList = $LISTBUILD("sourceMrns","addresses","phones","names","emails","races")
    set json = ##class(IHC.ITF.ITFCOMMON.Util.XmlToJson2).CreateJson(xmlStr,myList)
    $$$TRACE("JSON string: "_json)             
    set jsonProcessRequest=##class(Ens.StringContainer).%New()
    set jsonProcessRequest.StringValue= ##class(Ens.Util.FunctionSet).SubString(json, 27, $LENGTH(json)-1)
    $$$TRACE("JSON string-Removed root XML element: "_jsonProcessRequest.StringValue)   
    
    $$$TRACE("Calling Update Patient service") 
    $$$TRACE(" IHC mrn# exists " _ context.ihcEmpiNum) 
    set operType = "UPDATE"        
    set tarConfigName = context.targetList.GetAt(1)
    $$$TRACE(" Target Operation: " _ tarConfigName) 
    set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.HiePatientService).%New() 
    set httpPingServiceRequestObj.accessToken = context.accessToken
    set httpPingServiceRequestObj.operationType = operType  
    set httpPingServiceRequestObj.identifier = context.ihcEmpiNum 
    set httpPingServiceRequestObj.streamObject = jsonProcessRequest
    
    $$$TRACE(" Calling Patient Service "_operType_" - BEGIN ")
    set status = process.SendRequestSync(tarConfigName,httpPingServiceRequestObj,.patientServiceResponse)
    $$$TRACE(" Calling Patient Service "_operType_" - END ")
     
    if (status=$$$OK){
	    $$$TRACE("Call PatientService "_operType_" Operation OK status.")      
        set patServiceResponseData=patientServiceResponse.Stream  
        set statusCode = patientServiceResponse.Attributes.GetAt("StatusCode")       
        set stream =   patServiceResponseData
       	set respData = ""
       	While 'stream.AtEnd { 
       		set respData = respData _ stream.ReadLine(,.sc,.eol)       		
       	}
        $$$TRACE(" httpStatusCode: "_statusCode)    
        
        set respdata = respData _ " JSON Request: "_jsonProcessRequest.StringValue
        
        if (statusCode'="200"){
	    	if (statusCode="401"){
		   		$$$TRACE("  CheckError... ")
		   		set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid access token. Response: ["_respData_"]. Retrying...") 
		   	} 
		   	if (statusCode="400"){
		    	$$$TRACE("  In Status Code 400... ")
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respData)
		    }else{
		    	$$$TRACE("  DisableMsgError.... ")
        		set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Response from Patient Service Post Operation: "_respData) 
		    }
		} else {
        		$$$TRACE("PatientService call status 200 OK !!! ")
        		Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName) 
        		
        		set respJSONstring = respData          		
          		
          		set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respJSONstring)          		
          		set iterator =  consumedJSONobj.%GetIterator()
                 while iterator.%GetNext(.key,.value) { 
                 	$$$TRACE(" Key: "_key_" Value: "_value)
                 	if (key="status"){
	                 	 if (value="SUCCESS"){
		                 	$$$TRACE(" Status: "_value)	                 	   
	                 	 }else{
		                 	 $$$TRACE(" Status: "_value)
		                 	 $$$TRACE(" respJSONstring (ERRTXT): "_respJSONstring)	
		                 	 if respJSONstring [ "line 1 limit is 30"{
			                 	 set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Length of the Address1 from iCentra Adt in PID-11.1 is more than 30. Response from Patient Service Post Operation: "_respJSONstring)	                
			                 }elseif respJSONstring [  "Patient not found for mrn"{
				                 set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Either keep cmrn:"_context.ihcEmpiNum_" or delete cmrn:"_context.deleteMmiNumber_" not exists in Hie. Response from Patient Service Post Operation: "_respJSONstring)	              
			                 }else{
				                 if respJSONstring [ "EINVAL" {
		                 	 		set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Response from Patient Service Post Operation: "_respJSONstring)
				                 }elseif respJSONstring [ "ENOREC"{
                                    set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Response from Patient Service Post Operation: "_respJSONstring)				                 
			                 	 }else{
					                 set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Response from Patient Service Post Operation: "_respJSONstring)
					             }	  
			                 }               	
		                 }
	                }
                 	
                }                 
        } 
    }else{
	    set errTxt = $SYSTEM.Status.GetOneErrorText(status)
	    $$$TRACE("Call PatientService ERR TEXT: "_errTxt)
	    set retryErrCodeList = $LISTFROMSTRING(context.retrySameDisableErrorCodes, ",")
	   	Set lenRetryErrCodeList = $ListLength(retryErrCodeList)
	   	$$$TRACE("  lenRetryErrCodeList : "_lenRetryErrCodeList)
	   	For i=1:1:lenRetryErrCodeList {
			Set isRetryErrCodeFound = errTxt[ i	
			$$$TRACE("  isRetryErrCodeFound:"_isRetryErrCodeFound_" ErrCode:"_i)				
		}

	    if isRetryErrCodeFound = 1 {
		    $$$TRACE(" RetryCheckError.. errorText "_ettTxt)
	        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"TimedOut. No Successful Response from Patient service: ["_errTxt_"]. Retrying ..")
		}else{
			$$$TRACE("Call PatientService ERR TEXT: "_errTxt)
	    	set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Unknown/Unhandled error: "_errTxt) 
		}    	   
    }          
]]]]><![CDATA[>
