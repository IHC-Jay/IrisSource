<code name='HddNcidToRepForCountry' xpos='470' ypos='1300' >
<![CDATA[  
  set k1="",tSC=1
  set context.homeAddrTypeIndex = 0
  set context.homeEmailAddressIndex = 0
  set addrTypeBlankIndex = 0
  For { 
     Set k1=request.GetNextIndex("PID:11()",k1,.tSCTrans)  Quit:k1=""   
     set pid117AddressTypeNcid = request.GetValueAt("PID:11("_k1_").7")
     if ((pid117AddressTypeNcid="199") && (context.homeAddrTypeIndex=0)){
	     set context.homeAddrTypeIndex = k1
	     break	     
	 }else{
		 if ((pid117AddressTypeNcid="") && (addrTypeBlankIndex=0)){
	     	set addrTypeBlankIndex = k1	     
	 	 }
	 	 if (pid117AddressTypeNcid="50450665"){
		     set context.homeEmailAddressIndex = k1
		 }
	 }
  }
  $$$TRACE(" context.homeAddrTypeIndex... " _ context.homeAddrTypeIndex)
  $$$TRACE(" context.homeEmailAddressIndex.. " _ context.homeEmailAddressIndex)
  $$$TRACE(" addrTypeBlankIndex... " _ addrTypeBlankIndex)
  if ((context.homeAddrTypeIndex = 0) && (addrTypeBlankIndex > 0) ){
	  $$$TRACE(" Setting  addrTypeBlankIndex to homeAddrTypeIndex..")
	  set context.homeAddrTypeIndex = addrTypeBlankIndex
  }
  if ((context.homeAddrTypeIndex > 0)){ 
  	set pid116CountryNcid = request.GetValueAt("PID:11("_context.homeAddrTypeIndex_").6")
  	$$$TRACE(" PID-11.6 Country Ncid: " _ pid116CountryNcid)
  	set context.pid116 =  ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(pid116CountryNcid, context.hddContextHelp, context.hddTargetConfigName, .process)
  	if (context.pid116 [ "ERROR"){
      Do ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "Error while calling the Hdd Webservice. Method: getRepFromNcid. Ncid (PID-11.6 for AddressType 199 from iCentra Adt): "_pid116CountryNcid_". Context: "_context.hddContextHelp)
      set context.pid116 = ""
  	}
  	$$$TRACE("PID-11.6(Country) is " _ context.pid116)
  } else {
	  set status =  ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName, " There is no home address type in the iCentra Adt record..")
  }
  
]]]]><![CDATA[>
