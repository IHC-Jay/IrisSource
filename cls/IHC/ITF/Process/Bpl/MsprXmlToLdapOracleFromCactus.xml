 {
       Set val = context.ProviderEntityRecordEntityK.GetNext(.key)
       Quit:key=""
       $$$TRACE("Cactus Entity Val:"_key)
       set newrep = $PIECE(key,"-")
       $$$TRACE("newrep: "_newrep)
       If (newrep '="") && (newrep '="Unaffiliat"){    
         set encid=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(newrep, "119", context.gCactusContext, hddOpNm, .process)      
         if encid '= "" {      	 	
           do context.ProviderEntityRecordEntityK.SetAt(encid,key)
           $$$TRACE("Add Entity ncid: "_encid_" with key: "_key)
         }
       }	   
 }]]]]><![CDATA[>
