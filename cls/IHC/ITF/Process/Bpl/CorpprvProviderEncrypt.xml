  set context.PublicKeyName=configValue
  $$$TRACE("PublicKeyName="_context.PublicKeyName)
  
  // Get passphrase
    set configValue=""
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"SecretKeyPassword",.configValue)
  set context.SecretKeyPassword=configValue]]]]><![CDATA[>
