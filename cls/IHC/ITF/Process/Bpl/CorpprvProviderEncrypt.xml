<code name='Calling Encryption' xpos='200' ypos='1050' >
<![CDATA[        set Encryptobj=##class(IHC.ITF.ITFCOMMON.DStruc.FileEncrypt).%New()
        set Encryptobj.encryptedDirectory=context.FilePath 
        set Encryptobj.encryptedFilename=context.EncryptedFilename  
        set Encryptobj.publicKeyRingFile=context.IHCPUBLICKEYRINGFILE          
        set Encryptobj.secretKeyRingFile=context.IHCPRIVATEKEYRINGFILE         
        set Encryptobj.secretKeyRingPwd=context.SecretKeyPassword  
        set Encryptobj.unencryptedDirectory=context.FilePath  
        set Encryptobj.unencryptedFilename =context.Filename  
        set Encryptobj.publicKeyName=context.PublicKeyName  
        set context.TimeOutForEncryptResponse=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TimeOutForEncryptOperation",.pstatus)
  $$$TRACE("timeout:"_context.TimeOutForEncryptResponse)

        set tStatus=process.SendRequestSync(context.TargetConfigNamesEncryption,Encryptobj,.response,context.TimeOutForEncryptResponse)
 if ('tStatus) {
     set status=$$$ERROR("ITFCOMMON:10107",$SYSTEM.Status.GetOneErrorText(tStatus)) }
 else { 
      $$$TRACE("Success")
 }
]]]]><![CDATA[>
</code>
<trace name='Encyption Success' value='"Success Trace"_context.FilePath_context.EncryptedFilename_"Generate Successful File Creation  "_##class(%File).Exists(context.FilePath_context.EncryptedFilename)' xpos='200' ypos='1150' />
<code name='Creating stream' xpos='200' ypos='1250' >
<![CDATA[ set context.EncryptedFilename=context.FilePath_context.EncryptedFilename
 if (##class(%File).Exists(context.EncryptedFilename)=0){
     $$$TRACE("Not able to find the encrypted file in this path")
     set status=$$$ERROR("ITFCOMMON:10107","Not able to find the encrypted file in this path : "_context.EncryptedFilename) 
     quit
 }
   
 Set streamFile=##class(%FileCharacterStream).%New()
 Do streamFile.LinkToFile(context.EncryptedFilename)

 set stream=##class(%Stream.GlobalCharacter).%New()
 Set status = stream.CopyFromAndSave(streamFile)
 set context.FileRequest=##class(Ens.StreamContainer).%New(stream)
 set context.FileRequest.OriginalFilename = context.EncryptedFilename
 
   // delete the file once saved into global and streamed to output
 set deleteSuccess = ##class(%File).Delete(context.EncryptedFilename)
 If $$$ISERR(deleteSuccess)
 {
  $$$LOGERROR("Unable to delete temporary file: "_context.EncryptedFilename)
 } 
 else {
 	$$$TRACE("Temporary File "_context.EncryptedFilename_" has been deleted.")
 }]]]]><![CDATA[>
