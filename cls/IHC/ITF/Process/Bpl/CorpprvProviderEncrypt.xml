<call name='Call encryption' target='@context.TargetConfigNamesEncryption' async='0' timeout='"PT1H"' xpos='200' ypos='1050' >
<request type='IHC.ITF.ITFCOMMON.DStruc.FileEncrypt' >
<assign property="callrequest.encryptedDirectory " value="context.FilePath " action="set" />
<assign property="callrequest.encryptedFilename" value="context.EncryptedFilename " action="set" />
<assign property="callrequest.publicKeyRingFile" value="context.IHCPUBLICKEYRINGFILE" action="set" />
<assign property="callrequest.secretKeyRingFile" value="context.IHCPRIVATEKEYRINGFILE" action="set" />
<assign property="callrequest.secretKeyRingPwd" value="context.SecretKeyPassword " action="set" />
<assign property="callrequest.unencryptedDirectory" value="context.FilePath" action="set" />
<assign property="callrequest.unencryptedFilename" value="context.Filename" action="set" />
<assign property="callrequest.publicKeyName " value="context.PublicKeyName" action="set" />
</request>
<response type='Ens.Response' />
</call>
<trace name='Success Trace' value='context.FilePath_context.EncryptedFilename_"Generate Successful File Creation  "_##class(%File).Exists(context.FilePath_context.EncryptedFilename)' xpos='200' ypos='1150' />
<code name='Create stream' xpos='200' ypos='1250' >
<![CDATA[ set context.EncryptedFilename=context.FilePath_context.EncryptedFilename
 if (##class(%File).Exists(context.EncryptedFilename)=0){
     $$$TRACE("Not able to find the encrypted file in this path")
 }
   
 Set streamFile=##class(%FileCharacterStream).%New()
 Do streamFile.LinkToFile(context.EncryptedFilename)

 set stream=##class(%Stream.GlobalCharacter).%New()
 Set status = stream.CopyFromAndSave(streamFile)
 set context.FileRequest=##class(Ens.StreamContainer).%New(stream)
 set context.FileRequest.OriginalFilename = context.EncryptedFilename
 
   // delete the file once saved into global and streamed to output
 set deleteSuccess = ##class(%File).Delete(context.EncryptedFilename)
 If $$$ISERR(deleteSuccess)
 {
  $$$LOGERROR("Unable to delete temporary file: "_context.EncryptedFilename)
 } 
 else {
 	$$$TRACE("Temporary File "_context.EncryptedFilename_" has been deleted.")
 }]]]]><![CDATA[>
</code>
<call name='Outgoing operation' target='@context.TargetConfigNames' async='0' xpos='200' ypos='1350' >
<request type='Ens.StreamContainer' >
<assign property="callrequest" value="context.FileRequest" action="set" />
</request>
<response type='Ens.Response' />
</call>
