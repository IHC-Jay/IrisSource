<code name='Send X12 to Partner' xpos='470' ypos='2200' >
<![CDATA[   $$$TRACE("*** Send X12 Data to Partner")
   set scTp = ##class(IHC.ITF.DStruc.Record.StreamContainerWithProtocolAndTP).%New()
   set scTp.Stream = ##class(%Library.FileCharacterStream).%New()
 
   set scTp.TpName = context.lnkNm
   set scTp.Protocol = context.protocol
   set scTp.Folder = context.folder
   set scTp.TransTypeName = context.transTypeName
   set scTp.TradingPartnerName = context.tradingPartnerName
   set scTp.AliasName = context.aliasName
   set scTp.TransFileName = context.transFileName
   
   set stat = response.OutputToLibraryStream(scTp.Stream) 

   if ('stat) { 
      set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," Unexpected response returned from Stream Copy." _$SYSTEM.Status.GetOneErrorText(stat))    
   }
   else
   {
      $$$TRACE("OutputToLibraryStream OK")
   }
   set flNm = ##class(%File).GetFilename(request.OriginalFilename)
   
   // Use FileName from TP Link setup
   set workFileName = context.transFileName
   if (context.aliasName '= "") {
     set workFileName = $REPLACE(workFileName, "%Partner", context.aliasName _ "_" _ context.tradingPartnerName)
   }
   else {
	 set workFileName = $REPLACE(workFileName, "%Partner", context.tradingPartnerName) 
   }
   set workFileName = $REPLACE(workFileName, "%TransactionType", context.transTypeName)
   set workFileName = $REPLACE(workFileName, "%DtTm", $ZDATETIME($ZTIMESTAMP,8,1,9))
   set workFileName = $REPLACE(workFileName, "%MsgId", request.%Id())
   
   $$$TRACE("Output Filename: " _ workFileName)
   set scTp.OutputFilename = workFileName
   set scTp.OriginalFilename = scTp.OutputFilename
 
 FOR ind=1:1:context.targetList.Count()
 {
    $$$TRACE("Send Data to Operations: " _ context.targetList.GetAt(ind) _ ", stream size:" _ scTp.Stream.Size)
   
    set tStatus=process.SendRequestAsync(context.targetList.GetAt(ind), scTp, "Outbound Message")
    if ('tStatus) { 
       set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," Unexpected response returned or call failure." _$SYSTEM.Status.GetOneErrorText(tStatus))    
    }
 }]]]]><![CDATA[>
</code>
<code name='Store Data' xpos='470' ypos='2300' >
<![CDATA[   $$$TRACE("*** Store Outbound X12 Data")
 set status = ##class(IHC.ITF.ITFCOMMON.ErpUtil).StoreErpX12Data(scTp.Stream, ##class(%File).GetFilename(scTp.OriginalFilename), context.sessionID) 
 
 $$$TRACE("*** Store Inbound XML Data")
