<code name='Get Receiver Id' xpos='470' ypos='1100' >
<![CDATA[ $$$TRACE("Get Receiver Id")
 set context.docType = context.xmlDoc.Name
 set context.xmlReceiverIdPath = "/" _ context.docType _ "/HeaderDetail/EdiDocumentInfo/GroupReceiverId"
 $$$TRACE("xml Receiver Id Path:" _ context.xmlReceiverIdPath)
 set context.applicationReceiversCode = context.xmlDoc.GetValueAt(context.xmlReceiverIdPath)
]]]]><![CDATA[>
</code>
<code name='Find Partner' xpos='470' ypos='1200' >
<![CDATA[ $$$TRACE("Find Partner ReceiverId: " _ context.docType _ ", " _ context.applicationReceiversCode)
				  		
 set stat = ##class(IHC.ITF.ITFCOMMON.ErpUtil).GetOutboundTpLinkGS(context.applicationReceiversCode, context.docType, context.direc, .retVal)
  
 $$$TRACE( "GetOutboundTpLinkGS: " _ retVal)
   
 if (retVal '= ",,,,,,,,,,")
 {
   set context.TPID = $PIECE(retVal, ",")
   set context.lnkNm = $PIECE(retVal, ",", 2)
   $$$TRACE("Link: " _ context.TPID _ ", " _ context.lnkNm )
  
   set context.folder= $PIECE(retVal, ",", 3)
   if (context.folder = "")
   {
	  set context.folder= $PIECE(retVal, ",", 4)
   }
   set context.protocol = $PIECE(retVal, ",", 5)
   set context.transTypeName = $PIECE(retVal, ",", 6)
   set context.transTypeProtocol = $PIECE(retVal, ",", 7)
   set context.transTypeVersion = $PIECE(retVal, ",", 8)
   set context.tradingPartnerName =  $PIECE(retVal, ",", 9)
   set context.aliasName =  $PIECE(retVal, ",", 10)
   set context.transFileName =  $PIECE(retVal, ",", 11)
  
   set context.PartnerFound = 1
   $$$TRACE( "Partner Found")
 } else
   {
	  set context.PartnerFound = 0
	  $$$TRACE( "Partner Not Found")
   }
]]]]><![CDATA[>
