<code name='EncryptFileCode' xpos='1010' ypos='1200' >
<![CDATA[  
    // Append control record to the end of workfile for the service ID
  Do {
      $$$TRACE("Encrypting file context.FileName")
      set file=##class(%File).%New(context.FileName)
      set tStatus=file.Open("AWU")
      quit:'$$$ISOK(tStatus)
      set tStatus=file.Write("FTS|"_^IHCPowerPathToProfBill("Counter",process.%SessionId,context.serviceIDForSession)_"|")
      quit:'$$$ISOK(tStatus)
      // Call Encryption operation
      set encRequest=##class(IHC.ITF.ITFCOMMON.DStruc.FileEncrypt).%New()
      set encRequest.unencryptedDirectory=process.FilePath
      set encRequest.unencryptedFilename=process.%SessionId_context.serviceIDForSession_".TXT"
      set encRequest.encryptedDirectory=process.FilePath
      set encRequest.encryptedFilename="enc"_encRequest.unencryptedFilename
      set encRequest.publicKeyRingFile=process.IHCPUBLICKEYRINGFILE
      set encRequest.secretKeyRingFile=process.IHCSECRETKEYRINGFILE 
      set encRequest.publicKeyName=context.encryptionKeyName
      set encRequest.secretKeyRingPwd=""
  
      //Get the Encrypted Stream.
      set tStatus=process.SendRequestSync(process.TargetConfigNamesEncryption,encRequest,.response)
      quit:'$$$ISOK(tStatus)
      If ('##class(%File).Exists(process.FilePath_encRequest.encryptedFilename)){
	      set tStatus= ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "File Encryption for context.FileName Failed.")
	      Quit
      }
      //Create stream from Encrypted file.
      // Create Stream from the file . Also add the control record at the end of strind
      Set streamFile=##class(%FileCharacterStream).%New()
      Do streamFile.LinkToFile(process.FilePath_encRequest.encryptedFilename)
	  set stream=##class(%Stream.GlobalCharacter).%New()
      Set tStatus = stream.CopyFrom(streamFile)
      quit:'$$$ISOK(tStatus)
      set ftpRequest=##class(Ens.StreamContainer).%New(stream)
      set ftpRequest.OriginalFilename = encRequest.encryptedFilename
      // Call Ftp Operation
      do process.SendRequestAsync(context.ftpOperationName,ftpRequest)
  
  }while(0)
  set status=tStatus
  try {
	  set tStatus=##class(%Library.File).Delete(process.FilePath_encRequest.encryptedFilename)
  }Catch{}]]]]><![CDATA[>
