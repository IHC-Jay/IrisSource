 		    set isBadMessage = 1
 		}
 	} 
 	
 	     $$$TRACE("chargeNumber :"_+chargeNumber )
 	
 set accountNumber = request.GetValueAt("PID:PatientAccountNumber.ID")
 If ""'= accountNumber {
       if $ISVALIDNUM(accountNumber ){
 		    set context.errorMsg = context.errorMsg _ "Account Number is not numeric"_","
  		    set isBadMessage = 1
 		}
 }
 
      $$$TRACE("accountNumber :"_+accountNumber )
      
 set context.facilityIdNumeric= request.GetValueAt("PV1:AssignedPatientLocation.building")
 If ""'= context.facilityIdNumeric{
       if context.facilityIdNumeric = context.FacilityIdLdsOld{
            $$$TRACE("Updated the Facility IDs")
           set context.facilityIdNumeric = context.FacilityIdLds
       }
       if $ISVALIDNUM(context.facilityIdNumeric){
 		    set context.errorMsg = context.errorMsg _ "facilityIdNumeric is not numeric"_","
 		}
 }
       $$$TRACE("context.facilityIdNumeric:"_+context.facilityIdNumeric)

 set institutionalGuarantor= request.GetValueAt("PV1:AssignedPatientLocation.floor")
 If ""'= institutionalGuarantor{
       set context.institutionalGuarantor = institutionalGuarantor
       if $ISVALIDNUM(institutionalGuarantor){
 		  set context.errorMsg = context.errorMsg _ "institutionalGuarantor is not numeric"_","
  		    set isBadMessage = 1
 		}
 }
 
        $$$TRACE("institutionalGuarantor:"_+institutionalGuarantor)
 
 set performingDoctor= request.GetValueAt("FT1grp("_context.sourceFt1Index_").FT1:OrderedByCode(1).IDnumberST",,.status)
