  $$$TRACE("Before Calling Database Operation, check values of accession no "_context.accessionNum_" and addendum"_context.addendum )
  set context.tacDbRequest.ACCESSIONNO = context.accessionNum
  set context.tacDbRequest.ADDENDUM = context.addendum

  set tStatus=process.SendRequestSync(context.DBTargetConfigName,context.tacDbRequest,.SqlResponse)
 if ($$$ISOK(tStatus)){
   set context.SqlSnapShot = SqlResponse
   set rowCount = context.SqlSnapShot.RowCount
   set ClmCount = context.SqlSnapShot.ColCountGet() 
   
   $$$TRACE(" Row Count , Column count : "_rowCount_" , "_ClmCount)
   set context.discreteValueCnt = rowCount  
   
   if ( rowCount = 0)
   {
         set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Skipping the record.. This filler order number(AccessionNumber):["_context.accessionNum_"] returned zero synoptic elements from the iActivity data base ")
  
    }   
   
    
   For ObxIndex = 1:1:rowCount
   {  
   set Ncid = context.SqlSnapShot.GetData(4,ObxIndex )
   set Text = context.SqlSnapShot.GetData(3,ObxIndex )
   set numVal = context.SqlSnapShot.GetData(8,ObxIndex )
   set unit = context.SqlSnapShot.GetData(10,ObxIndex )
   set StrVal = context.SqlSnapShot.GetData(7,ObxIndex )
