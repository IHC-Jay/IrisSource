    $$$TRACE("Ncid of discrete value :"_Ncid)
     $$$TRACE("Text of discrete value :"_Text)
      $$$TRACE("discrete value Str :"_StrVal)
       $$$TRACE("discrete value num :"_numVal)
        $$$TRACE("unit value :"_unit)
       $$$TRACE(" Exam completed time in MST :"_examCTime ) 
        
     
        
        do context.listObx31.Insert(Ncid) 
        do context.listObx32.Insert(Text) 
        if ( StrVal '= "")
         {
          $$$TRACE("Add discrete String val to OBX-5 - "_StrVal)
          do context.listObx5.Insert(StrVal) 
            do context.listObx2.Insert("ST") 
          }
          else
          {
            $$$TRACE("Add discrete Number val to OBX-5 - "_numVal)
           do context.listObx5.Insert(numVal) 
             do context.listObx2.Insert("NM") 
         
           }   
       do context.listObx6.Insert(unit) 
       do context.listObx14.Insert(examCTime) 
    }
 }
 else
 { 
