<code name='Get MMIDataRecord' xpos='200' ypos='350' >
<![CDATA[
   $$$TRACE("Getting MMIDataRecord... "_request) 
  set context.cdrReadMmiResponse= request      
   set context.dataRecord = context.cdrReadMmiResponse.DataRecord   
   set context.mmiRecord = context.dataRecord.ListOfMMIRecords.GetAt(1)   
   set context.memberInfo = context.mmiRecord.MemberInfo   
   $$$TRACE(" EMPI Number: <"_ request.DataRecord.mmiEventRow.UnitNumber _">")
   $$$TRACE(" FacilityCid: <"_ request.DataRecord.mmiEventRow.FacilityCid _">")
   if (request.DataRecord.mmiEventRow.TxTypeCid = "203"){
      set context.triggerEvent = "A04"
   }elseif (request.DataRecord.mmiEventRow.TxTypeCid = "204"){
      set context.triggerEvent = "A08"
   }elseif (request.DataRecord.mmiEventRow.TxTypeCid = "205"){
      set context.triggerEvent = "A18"
   }else {
      $$$LOGINFO("Invalid Transaction CID: " + request.DataRecord.mmiEventRow.TxTypeCid)
   }
   ]]]]><![CDATA[>
