<code name='Prep GetRepFromNcid' xpos='200' ypos='450' >
<![CDATA[ 
 $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object") 
  
 do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , request.DataRecord.mmiEventRow.FacilityCid, context.hddContextHelp, "Pid2:PatientID")  	  			 
 $$$TRACE("Hdd Request Pid2:PatientID is " _ request.DataRecord.mmiEventRow.FacilityCid)
 set facIndex = context.memberInfo.ListOfFacilities.Next("")
 while (facIndex '= ""){
	 set facility = context.memberInfo.ListOfFacilities.GetAt(facIndex)
	 set mmiFacilityCid = facility.MmiFacilityCid
	 if (mmiFacilityCid '= ""){
		 do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , mmiFacilityCid, context.hddContextHelp, "Pid34Facility_"_facIndex)  	  			 
     	 $$$TRACE("Hdd Request Pid34Facility_" _facIndex _" is " _ mmiFacilityCid)
	 }	 
	 set facIndex = context.memberInfo.ListOfFacilities.Next(facIndex)
	 kill facility
	 kill mmiFacilityCid
	 
 }  
 kill facIndex
 
 set nameIndex = context.memberInfo.ListOfNames.Next("")
 while (nameIndex '= ""){
	 set name = context.memberInfo.ListOfNames.GetAt(nameIndex)
	 set firstName = name.FirstName
	 if (firstName = ""){
		 //Skip the record, if first name is empty
		 set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "FirstName is empty/blank, Skipping the record..")
     }
	 set nameTypeCid = name.NameTypeCid
	 if (nameTypeCid '= ""){
		 do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , nameTypeCid, context.hddContextHelp, "Pid5NameType_"_nameIndex)
		 $$$TRACE("Hdd Request Pid5NameType_" _nameIndex _" is " _ nameTypeCid)
	 }
	 set nameIndex = context.memberInfo.ListOfNames.Next(nameIndex)
	 kill name
	 kill firstName
	 kill nameTypeCid
 }
 kill nameIndex
 
 if (context.memberInfo.RaceCid '= "") {
 	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.memberInfo.RaceCid, context.hddContextHelp, "Pid10:Race")  	  			 
 	$$$TRACE("Hdd Request Pid10:Race is " _ context.memberInfo.RaceCid)
 }
 set addressIndex = context.memberInfo.ListOfAddresses.Next("")
 while (addressIndex){
	 set address = context.memberInfo.ListOfAddresses.GetAt(addressIndex)
	 set addressTypeCid = address.AddressTypeCid
	 if (addressTypeCid '= ""){
	 	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , addressTypeCid, context.hddContextHelp, "Pid11AddressType_"_addressIndex)
	 	$$$TRACE("Hdd Request Pid11AddressType" _addressIndex _" is " _ addressTypeCid)
	 }
	 set addressIndex = context.memberInfo.ListOfAddresses.Next(addressIndex)
	 kill address
	 kill addressTypeCid
 }
 kill addressIndex
 
 set phoneIndex = context.memberInfo.ListOfPhones.Next("")
 while (phoneIndex){
	 set phone = context.memberInfo.ListOfPhones.GetAt(phoneIndex)
	 set phoneTypeCid = phone.PhoneTypeCid
	 if (phoneTypeCid '= ""){
	 	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , phoneTypeCid, context.hddContextHelp, "PidTelecomUse_"_phoneIndex)
	 	$$$TRACE("Hdd Request PidTelecomUse" _phoneIndex _" is " _ phoneTypeCid)
	 }
	 set phoneIndex = context.memberInfo.ListOfPhones.Next(phoneIndex)
	 kill phone
	 kill phoneTypeCid
	 
 }
 kill phoneIndex
 
 if (context.memberInfo.MaritalStatusCid '= "") {
 	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.memberInfo.MaritalStatusCid, context.hddContextHelp, "Pid16:MaritalStatus")  	  			 
 	$$$TRACE("Hdd Request Pid16:MaritalStatus is " _ context.memberInfo.MaritalStatusCid)
 }
 if (context.memberInfo.ReligionCid '= "") {
 	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.memberInfo.ReligionCid, context.hddContextHelp, "Pid17:Religion")  	  			 
 	$$$TRACE("Hdd Request Pid17:Religion is " _ context.memberInfo.ReligionCid)
 }
 $$$TRACE(" After setting all NCID values") 
]]]]><![CDATA[>
</code>


