 }
 
 if ($LENGTH(warnMsg) > 0) {
	 //Send email alert
	 set alert= ##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError(##Class(%SYS.System).GetNodeName()_ " - ITF_IEMPI_WARNINGS " - process.%ConfigName, warnMsg, process.%ConfigName) 	 
 	 do process.SendRequestSync("Ens.Alert",alert) 
 	 
	 //Send to notification
	 set tRequest = ##class(Ens.StreamContainer).%New("")
	 set tStream = ##class(%Stream.GlobalCharacter).%New("")
