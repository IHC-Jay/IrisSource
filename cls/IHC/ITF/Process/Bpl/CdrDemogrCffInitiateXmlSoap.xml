<code name='Call InitiateMerge' xpos='200' ypos='350' >
<![CDATA[ 

  set tStatus=process.SendRequestSync(context.targetConfigName,context.iniMergeRequest,.initiateMergeResponse)
  
   $$$TRACE(" Status after EmpiMerge " _ tStatus)
  if ('tStatus) {	 
	 $$$TRACE(" Status Error text: " _ $SYSTEM.Status.GetOneErrorText(tStatus))
	 set errText = $SYSTEM.Status.GetOneErrorText(tStatus)
	 if ((errText["#6246")){
		 set context.iniMergeResponse = ""
		 set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to MergePerson into Initiate. empi#: ["_request.DataRecord.mmiEventRow.UnitNumber_". Audit#: "_request.DataRecord.mmiEventRow.AuditNumber_"]. Skipping the record." _errText)
		 quit
	 }
	 if ((errText["INITIATE_ENOREC")){
		 set context.iniMergeResponse = ""
