<code name='Skip &amp; Support Email for invalid OBR-2.2' xpos='200' ypos='1150' >
<![CDATA[ //AIKB-12423 - Update Lab Order Interface to Include Error Monitoring for Medicity orders
  
 set obr22 = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:PlacerOrderNumber.placerapplication")

 $$$TRACE("Obr2.2 is "_obr22)
 
 if ( obr22 = "IH")
 {
   $$$TRACE("IH in Obr2.2 is the valid code.  "_obr22)
 }
 else
 {
   set curTime = $ZTIME($PIECE($HOROLOG,",",2),1) 
  $$$TRACE("curTime  is (e.g, 17:29:05)-->"_curTime)
  
  set curDate = $ZDATE($PIECE($HOROLOG,",",1),1)   
  $$$TRACE("curDate is MM/DD/YYYY: -->"_curDate)
  
  set curDay = $System.SQL.DAYNAME(+$H) 
  $$$TRACE("curDay is (e.g, Sunday) -->"_curDay)
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.NovoLabOrdersHl7ToSunquest.Lookup.HolidaysLookupTable",curDate,.retValue)
 $$$TRACE("Looking up the current date in the HolidaysLookupTable (Match=1) -->" _retValue_ "<--.")
    
 if (retValue = "1") {   
 
      Set context.isHoliday = retValue
 }
  
   if ((context.isHoliday = "1") || (curDay = "Staturday") || (curDay = "Sunday"))
  {
   set status = ##class(IHC.ITF.ITFCOMMON.Utility).SuspendMsgError(process.%ConfigName,"Medicity (Novo) Order came in with the wrong extension [" _obr22_ "] on the order ID in OBR2.2, which should be 'IH'.  Skip the message and send support email as configured in the ITFCOMMONSuspendMsgError (10104) support page for none business hours.")
   $$$TRACE("Use support email for none business hours (" _curDay_ " and " _curTime_ ")  to send the error message for invalid OBR-2.2 (" _obr22_ ").")
  }elseif(curTime '= "")
  {
   $$$TRACE("curTime is ->"_curTime) 
   $$$TRACE("context.busStartTime is ->"_context.busStartTime) 
   $$$TRACE("context.busEndTime is ->"_context.busEndTime) 
 
  if ( (curTime > context.busStartTime ) && (curTime < context.busEndTime) )
  {
   set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Medicity (Novo) Order came in with the wrong extension [" _obr22_ "] on the order ID in OBR2.2, which should be 'IH'.  Skip the message and send support email as configured in the ITFCOMMONFailMsgError (10105) support page during business hours.")
   $$$TRACE("Use business hours (" _curTime_ ") support email to send the error message for invalid OBR-2.2 (" _obr22_ ").")
  }
  else
  {
   set status = ##class(IHC.ITF.ITFCOMMON.Utility).SuspendMsgError(process.%ConfigName,"Medicity (Novo) Order came in with the wrong extension [" _obr22_ "] on the order ID in OBR2.2, which should be 'IH'.  Skip the message and send support email as configured in the ITFCOMMONSuspendMsgError (10104) support page outside business hours.")
   $$$TRACE("Use off business hours (" _curTime_ ") support email to send the error message for invalid OBR-2.2 (" _obr22_ ").")
  }
 }
 else
 {
	   // Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"The variavle isHoliday["_isHoliday_"] or curTime :["_curTime_"]is invalid for the record with PID (" _context.empiNumber_ ") and FIN (" _context.encNumber_  ").")
 }
 } 
