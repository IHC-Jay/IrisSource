<code name='Check for deceased Prv' xpos='200' ypos='2250' >
<![CDATA[  set time = $ZDATE($HOROLOG,1)
  set diff=$SYSTEM.SQL.DATEDIFF("D",context.termDate,time)
   if 'context.DeceasedPrivilage{
     set context.iSeriesCff.PRIVILAGECODE=""
     set context.iSeriesCff.PRIVILAGECODEIND=""
     if ($L(context.priv)<1) || ($ZCVT(context.priv,"L")="none") || (context.entActive="0") && ($L(context.termDate)>0) && (diff>=0){
       set context.iSeriesCff.PRIVILAGECODE="0"
       set context.iSeriesCff.PRIVILAGECODEIND="U"
     }
  }else{
     set context.iSeriesCff.PRIVILAGECODE="3"
