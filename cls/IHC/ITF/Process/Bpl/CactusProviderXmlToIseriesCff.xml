<code name='Assign Host and Site Id' xpos='200' ypos='350' >
<![CDATA[ set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Cactus.IseriesHostIds",context.facName,.hostId)
