<code name='set license number' xpos='200' ypos='450' >
<![CDATA[ $$$TRACE("Set State License Number... ")
 if ((context.facName="Cassia") && (context.idahoPROFLICENSENUM'="")) {
     set context.iSeriesCff.PROFLICENSENUM=context.idahoPROFLICENSENUM
