<code name='Call Hdd For Provider status' xpos='200' ypos='1450' >
<![CDATA[
  Set val = context.CactusRequest.GetValueAt("Provider(1).ProviderDemographicsRecord.status_rtk.ID")
  Set context.ProvStat=val
  $$$TRACE("Provider Status:"_context.ProvStat)
	      // Create request
    set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
   If val '="" {        
   do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest ,val,  context.gProviderStatusIDDomain,"50450833","AdvProviderPrvdrStatusId") 
	 //Call 
  	$$$TRACE("Call HDD look up AdvProviderPrvdrStatusId")
 	set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pNcidRequest,.hddNcidResponse)
 	If $$$ISOK(tStatus){ 
   		set context.hddResponse= hddNcidResponse
        	set context.hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddResponse,"AdvProviderPrvdrStatusId")
        	 	$$$TRACE("AdvProviderPrvdrStatusId:"_context.hddObj.NCID)
        	set context.AdvProviderPrvdrStatusIdRepVal=context.hddObj.NCID
 	}

 }
 
 if context.AdvProviderPrvdrStatusIdRepVal'=""{
    // Create request
    set pRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
   If val '="" {        
   do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(pRepRequest  ,context.AdvProviderPrvdrStatusIdRepVal,context.gMsprContext,"AdvProviderPrvdrStatusIdRep") 
	 //Call 
  	$$$TRACE("Call HDD look up Rep")
 	set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pRepRequest  ,.hddNcidResponse)
 	If $$$ISOK(tStatus){ 
   		set context.hddResponse= hddNcidResponse
        	set context.hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddResponse,"AdvProviderPrvdrStatusIdRep")
        	 	$$$TRACE("AdvPrvdrPrfsnlTypeIdRepVal:"_context.hddObj.Rep)
        	set context.AdvProviderPrvdrStatusIdRepVal=context.hddObj.Rep
 	}

 }
 }
 
 if context.AdvProviderPrvdrStatusIdRepVal="" {
     set errorMessage = "Can't get context 2000 representation for Provider Status: "_val_" For CORPPRV context 50450906 in Domain"_context.gProfessionalTypeDomain
      $$$TRACE("errorMessage:"_errorMessage)
