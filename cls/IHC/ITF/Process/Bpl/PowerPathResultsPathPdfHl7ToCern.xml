<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object")  
 
 set msh6Facility = request.GetValueAt("MSH:ReceivingFacility.namespaceID")  	
 if (msh6Facility '= "") {
 	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , msh6Facility, context.hddContextFac, context.hddContextInterface, "MSH4:Facility")  	  	
    $$$TRACE("Hdd Request MSH-6 ReceivingFacility is " _ msh6Facility)
 }
 
 set i1=""
 for {
	 set i1 = request.GetNextIndex("PIDgrpgrp()",i1,.tSCPID)  quit:i1=""	 
	 
	 set pid8Sex = request.GetValueAt("PIDgrpgrp("_(i1)_").PIDgrp.PID:AdministrativeSex")  	
 	 if (pid8Sex '= "") {
         Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , pid8Sex, context.hddContextSex, context.hddContextHelp, "PID8:Sex_"_i1)  	  	
     	 $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 	 }
 	 
 	 set j1=""
 	 for {	 	 
		 set j1 = request.GetNextIndex("PIDgrpgrp("_(i1)_").ORCgrp()",j1,.tSCORC)  quit:j1=""		 		 
		 
 		 set obr3FillerOrdNum = request.GetValueAt("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").OBR:FillerOrderNumber.entityidentifier") 		 
 		 set obr4UniversalSrvId = request.GetValueAt("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").OBR:UniversalServiceIdentifier.identifier") 
 		 $$$TRACE("OBR-3 value is: " _ obr3FillerOrdNum)
 		 $$$TRACE("OBR-4 value is: " _ obr4UniversalSrvId)		 
 		 if (obr4UniversalSrvId '= "") {
	 		 $$$TRACE("OBR-4 not NULL")		 
	 		 if (obr4UniversalSrvId = "SURG") {		 		 
	 		 	if ($extract(obr3FillerOrdNum, 3) = "F") {
		 			set context.obr4Ncid = "111109"
	 		 	} else {
		 			Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , obr4UniversalSrvId, context.hddContextPathology, context.hddContextPathologyInterface, "OBR41:UniversalServiceID_"_(i1)_"_"_j1)  	  	
     		 		$$$TRACE("Hdd Request OBR-4 UniversalServiceId is " _ obr4UniversalSrvId) 	
	 		 	}
	 		 } else {
		 		$$$TRACE("OBR-4 not SURG")
     	 	 	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , obr4UniversalSrvId, context.hddContextPathology, context.hddContextPathologyInterface, "OBR41:UniversalServiceID_"_(i1)_"_"_j1)  	  	
     		 	$$$TRACE("Hdd Request OBR-4 UniversalServiceId is " _ obr4UniversalSrvId)  		
 		 	 }
 		 }
	 }
 }
