<code name='validateMsgStructure' xpos='200' ypos='550' >
<annotation><![CDATA[unMarshall - Check if the message passes the message validation as set in the Validation Settings ]]]]><![CDATA[></annotation>
<![CDATA[ 
 Set context.validationSettingValue=""
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Validation",.configValue)  
  if ($$$ISOK(pstatus)){
     set context.validationSettingValue=configValue
  } 
  
 $$$TRACE("Validate Message Begins...") 
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,context.validationSettingValue) 
 if (tStatus'=$$$OK){ 
 	set context.isValidationPassed=0 
    $$$TRACE("Failed Validation Settings " _ context.validationSettingValue)
    // Skip the record.
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "Hl7 message data structure validation failed, Skipping the record." _ "Hl7 Msg:" _ request.RawContent)
 }else{
	  $$$TRACE("Passed Validation Settings: " _ context.validationSettingValue) 
 }
 ]]]]><![CDATA[>
