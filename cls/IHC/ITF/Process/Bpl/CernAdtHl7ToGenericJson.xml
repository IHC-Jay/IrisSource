<code name='Convert xml string to JSON string' xpos='200' ypos='950' >
<![CDATA[  $$$TRACE("Call XxmlStrML to JSON Operation")
  set xmlStr=response.OutputToString()
  $$$TRACE("XML STR: "_xmlStr)
  if ($LENGTH(xmlStr) > 100) {
   //set json = ##class(IHC.ITF.ITFCOMMON.Util.XmlToJson).CreateJson(xmlStr)
   //$$$TRACE("JSON string: "_json)
    set context.xmlStrRequest = ##class(Ens.StringContainer).%New()
    set context.xmlStrRequest.StringValue = xmlStr
    set status=process.SendRequestSync(process.TargetConfigNameXmlToJson,context.xmlStrRequest,.jStrResponse)
    $$$TRACE("Call XmlToJson Ok")
    $$$TRACE("XML to JSON call response: "_jStrResponse.StringValue)
    set strLen = ##class(Ens.Util.FunctionSet).Length(jStrResponse.StringValue)
    set jStr = ##class(Ens.Util.FunctionSet).SubString(jStrResponse.StringValue, 20, strLen -1)
    set context.jsonRequest=##class(Ens.StringContainer).%New()
    set context.jsonRequest.StringValue=jStr
  }
  ELse {
    set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,$SYSTEM.Status.GetOneErrorText(status)) 
  }]]]]><![CDATA[>
</code>
