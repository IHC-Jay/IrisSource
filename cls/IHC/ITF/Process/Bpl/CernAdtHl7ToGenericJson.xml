<code name='get empi' xpos='200' ypos='650' >
<![CDATA[  set context.empiNum=""
  set k1="",tSC=1 
  For { 
     Set k1=request.GetNextIndex("PID:3()",k1,.tSCTrans)  Quit:k1=""          
     If (request.GetValueAt("PID:3("_(k1)_").4.1")="EMPI") {
         Set context.empiNum=request.GetValueAt("PID:3("_(k1)_").1.1")         
         quit
     }
  }
  $$$TRACE("EMPI: " _ context.empiNum) 
  if ($ISVALIDNUM(context.empiNum)'="1"){	  
    $$$TRACE("Empi# is NOT a VALID number ")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName, "Hl7 message has invalid empi number: ["_context.empiNum_"]. Skipping the record.")
  }]]]]><![CDATA[>
