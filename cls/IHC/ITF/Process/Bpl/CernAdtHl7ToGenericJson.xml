<code name='Call PingDir service' xpos='200' ypos='1150' >
<![CDATA[ $$$TRACE("Call REST Operation")
 Do context.restSrvcRequest.HTTPHeaders.SetAt(context.empiNum,"mrn")
 //Do context.restSrvcRequest.HTTPHeaders.SetAt("540601087","mrn")
 if (context.restSrvcRequest'="") {
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync(process.TargetConfigNames,context.restSrvcRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set statusLine=""
      set statusCode=""
      set statusDesc=""
      set context.restHttpResponse=httpRESTResponse
      set statusLine=context.restHttpResponse.HTTPHeaders.GetAt("StatusLine")
      $$$TRACE("StatusLine: "_statusLine)
      if (statusLine'=""){
	set statusCode=$piece(statusLine," ",2)
	set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
      // If status code is 200 the check the reponse to see if it got processed correctly or not
      Set tcharStream = ##class(%GlobalCharacterStream).%New()
      Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
      set text=""
      While 'tcharStream.AtEnd {
        Set text = text_tcharStream.Read($$$MaxStringLength)
      } 
      $$$TRACE("REST service response: "_text)
      if (statusCode'="200"){
        if ((statusCode="500") || (statusCode="404")){
           $$$TRACE("This record does not exist in PingDir.")
        }
        else {
          set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"REST service response with code: "_statusCode_"  Response: "_text) 
        }
      }
      else {
        $$$TRACE("Service call is Ok. :")
      }
    }
    ELse {
      set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Failed to post the request... "_$System.Status.DisplayError(status)) 
    }
  }]]]]><![CDATA[>
