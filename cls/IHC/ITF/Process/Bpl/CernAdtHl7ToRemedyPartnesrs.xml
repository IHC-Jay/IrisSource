<code name='Call HDD to get DischargeDisposition' xpos='200' ypos='1050' >
<![CDATA[
  	set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()  	
  	Set dischargeDispNcid =request.GetValueAt("ZZ1:ZZ120DischargeDispNcid") 
  	if (dischargeDispNcid'= ""){	  	

          Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , dischargeDispNcid,  context.hddContextRemedyPartners, "ZZ1:ZZ120DischargeDispNcid")  	  	
		$$$TRACE("Hdd Request ZZ120:dischargeDispNcid is " _ dischargeDispNcid)		
		
	  // Call HDD Operation
          set tStatus=process.SendRequestSync(context.hddTargetConfigName, context.hddRepRequest,.hddResponse)
          if ('tStatus) {
            set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure") 
          }
          else { 
               set context.hddRepResponse = hddResponse 
               
               Set hddObjRep = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddRepResponse, "ZZ1:ZZ120DischargeDispNcid")
               $$$TRACE("Hdd rep for ZZ1:ZZ120DischargeDispNcid: " _ hddObjRep.Rep)
               if ($L(hddObjRep.Rep) > 0)
               {
                   set context.dischargeDispositionVal = hddObjRep.Rep
               }
         }
       }
       else
       {
          $$$TRACE("ZZ1:ZZ120DischargeDispNcid is empty") 
       }]]]]><![CDATA[>
