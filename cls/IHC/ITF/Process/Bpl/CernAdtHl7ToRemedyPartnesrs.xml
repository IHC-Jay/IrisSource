<code name='Get NPI from NCID' xpos='200' ypos='1150' >
<![CDATA[  Set provId =request.GetValueAt("PV1:AttendingDoctor().IDnumberST") 
  $$$TRACE("Call HDD look up NPI for provider:" _ provId)
  if ($L(provId ) > 0)
  {
    set context.repToRepRequest  = 
    ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddUniqueRepByRepObject()
    
    // ClassMethod AddUniqueRepByRepObject
    // (reqObj As IHC.ITF.ITFCOMMON.HDD.Interface.UniqueRepByRepLookupRequest, srcRep As %String, 
    // srcContext As %String, globalDomainContext As %String, returnRepContext As %String

    // srcContext = IHC Interface Context,  50035
    // globalDomainContext  = User,  1000000000
    // returnRepContext  = NPI context, 510097850
    DO ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddUniqueRepByRepObject(context.repToRepRequest, provId, "50035","1000000000","510097850","NPI") 
    
    //Call  
    set tStatus=process.SendRequestSync(context.hddTargetConfigName,context.repToRepRequest,.hddRepResponse)
    If $$$ISOK(tStatus)
    { 
      set context.hddRepResponse = hddRepResponse
     
      set hddObjRep = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddRepResponse,"NPI")
      $$$TRACE("From HDD, NPI:"_ hddObjRep.Rep)      	 	        	 
     
      if ($L(hddObjRep.Rep) > 0)
      {
         set context.NPInum = hddObjRep.Rep
      } 
    }
  }
   ]]]]><![CDATA[>
