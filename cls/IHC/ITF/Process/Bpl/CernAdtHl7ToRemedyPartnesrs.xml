<code name='validateEmpiNumber' xpos='200' ypos='850' >
<annotation><![CDATA[Get EMPI(CMRN)]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Validate Empi(CMRN)...") 
 Set context.empiNumber=request.GetValueAt("PID:3(1).1.1")         
