<code name='get HL7 msg' xpos='605' ypos='1250' >
<![CDATA[ set context.hl7RecCount = request.ChildCount
   $$$TRACE("HL7 msgs # " _  context.hl7RecCount)
 set context.hl7Msg = request.NextChild()
  set sndStr = context.hl7Msg.RawContent
  $$$TRACE("Raw Content string before parsing PID18: "_ sndStr )
 
  set context.hl7Msg = ##class(EnsLib.HL7.Message).ImportFromString(sndStr)  
  Set context.hl7Msg.DocType="2.3:DFT_P03"
  
 ]]]]><![CDATA[>
</code>
<while name='check all pid-18' condition='context.hl7RecNum &lt;=  context.hl7RecCount' xpos='605' ypos='1350' xend='200' yend='700' >
<code name='check pid-18' xpos='200' ypos='250' >
<![CDATA[  $$$TRACE("BSH  MSH-7: " _ context.hl7Msg.GetValueAt("MSH:7"))
  set pid181 = context.hl7Msg.GetValueAt("PID:18.1")
   $$$TRACE("BSH  Rec #: " _ context.hl7RecNum _ " pid18.1 value:  " _ pid181)
   //If PID-18.1 has more than than 9 characters, route to the Cerner outbound operation
   if ( (pid181'="") && ($LENGTH(pid181) <= 9) )
   {  
      set context.iSeries = 1
      set context.arupHl7Rec = context.hl7Msg
      $$$TRACE("BSH  - Found a iSeries record")
   }
   
  ]]]]><![CDATA[>
