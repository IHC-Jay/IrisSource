<code name='Get Fax number' xpos='335' ypos='1400' >
<![CDATA[  // Check if FaxNumber present 
  
  set inputFaxNumber = request.GetValueAt("FaxNumber")
   $$$TRACE("Fax number from input Message :"_inputFaxNumber)
  
  
  // Get FaxNumber from DB
  
  set context.D3DE =request.GetValueAt("IDXDictEntryInternalNumber")
 
  $$$TRACE("context.D3DE value: "_context.D3DE)
  
  if (context.D3DE="")
  {
      Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError("IDX Dictionary", "No IDXDictEntryInternalNumber present in the XML . Skipping the record.") 
  }
  
  set isRecordExist = ##class(IHC.ITF.ITFCOMMON.Operation.ProviderFax).%ExistsId(context.D3DE)
  $$$TRACE("isRecordExist in Table :"_isRecordExist)
  
  if (isRecordExist )
  {
    set FaxObj = ##class(IHC.ITF.ITFCOMMON.Operation.ProviderFax).%OpenId(context.D3DE)
    set DBFaxNumber= FaxObj.Fax
    $$$TRACE("Fax number from Table :"_FaxObj.Fax)
  }
  else
  {
    set DBFaxNumber= ""
    $$$TRACE("Record does not exist in DB. setting DB fax number to empty")
  }
  
  
  // Check if Fax needs to be updated
  
  if ($L(inputFaxNumber) < 10)
  {
     set context.FaxNumber = DBFaxNumber
     $$$TRACE("Fax number from input is less than length of 10 so passing Fax number from DB")
  }
  elseif ( inputFaxNumber = DBFaxNumber )
  {
     set context.FaxNumber = inputFaxNumber
     $$$TRACE("Fax number from input is same as DB")
  }
  elseif (inputFaxNumber '= DBFaxNumber )
  {
      // Need to update DB fax number
       $$$TRACE("Fax number from input is different from DB. update DB fax number")
       set FaxObj = ##class(IHC.ITF.ITFCOMMON.Operation.ProviderFax).%OpenId(context.D3DE)
       set FaxObj.Fax = inputFaxNumber
       Do FaxObj.%Save()
       set context.FaxNumber = inputFaxNumber
  }
  else
  {
     $$$TRACE("Inside else setting DB FaxNumber")
     set context.FaxNumber = DBFaxNumber
  }]]]]><![CDATA[>
