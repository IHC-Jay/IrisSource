<code name='Filter Message' xpos='200' ypos='950' >
<![CDATA[ 
  // check Dictionary Type
  if (context.DictionaryID="3")
  {
      set context.BlockMsg = 0
  }
  else
  {
      set context.BlockMsg = 1
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Dictionary Message type not 3,  Skip the message.")
  }
  
  
  // Check Provider NPI
  set ProviderNPI =request.GetValueAt("NpiNumber")
  $$$TRACE("ProviderNPI value: "_ProviderNPI )
  
 if ((ProviderNPI '="") || ($L(ProviderNPI) > 0) )
  {
      set context.BlockMsg = 0
  }
  else
  {
      set context.BlockMsg = 1
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "ProviderNPI (NpiNumber) value is empty,  Skip the message.")
  }
  
  
  // Check ProviderType
  set ProviderType =request.GetValueAt("ProviderType")
  $$$TRACE("ProviderType value: "_ProviderType )
  
 if (ProviderType= "Provider") 
  {
      set context.BlockMsg = 0
  }
  else
  {
      set context.BlockMsg = 1
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "ProviderType  value is not Provider,  Skip the message.")
  }]]]]><![CDATA[>
</code>
<code name='Populate Globals' xpos='200' ypos='1050' >
<![CDATA[     set context.GBMarket =""
     set BlockMsg = "Y"
     set firstValidBillingArea =""
     
     // Get GB_Market
     
     set HcpRegionsValue =request.GetValueAt("HcpRegions")
     $$$TRACE("HcpRegionsValue  value: "_HcpRegionsValue )
     
     set HcpRegionsValue = $REPLACE(HcpRegionsValue,"[","")
     set HcpRegionsValue = $REPLACE(HcpRegionsValue,"]","")
     set FirstHcpRegions = $PIECE(HcpRegionsValue , ",")
      $$$TRACE("After HcpRegionsValue  value: "_HcpRegionsValue )
      $$$TRACE("FirstHcpRegions value: "_FirstHcpRegions)
     
     if ($L(FirstHcpRegions) < 1)
     {
        set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "HcpRegions value is Empty,  Skip the message.")
     }
     else
     {
        set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.IdxXmlToCareInMotionMfnHl7DemoLoader.Lookup.CimHCPRegion",FirstHcpRegions,.result)
        
        if ((result = "Unknown") || (result =""))
         {
            set context.GBMarket = FirstHcpRegions 
         }
         else
         {
           set context.GBMarket = result
         }  
        
     }
       $$$TRACE("context.GBMarket value: "_context.GBMarket )
     
 
    // GB_BillingAreaMnemonic
    
    set BillingAreasValue =request.GetValueAt("BillingAreas")
    $$$TRACE("BillingAreasValue  value: "_BillingAreasValue )
     set BillingAreasValue = $REPLACE(BillingAreasValue,"[","")
     set BillingAreasValue = $REPLACE(BillingAreasValue,"]","")
     set FirstPieceBillingAreasValue = $PIECE(BillingAreasValue , ",")
     $$$TRACE("After BillingAreasValue  value: "_BillingAreasValue )
      $$$TRACE("FirstPieceBillingAreasValue   value: "_FirstPieceBillingAreasValue  )
     
     if ( $L(BillingAreasValue) < 1 )
     {
        set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "BillingAreasValue value is Empty,  Skip the message.")
     }
     else
     {
     
       if (context.GBMarket = "CA")
       {
           SET delim=","
           SET countdown=$LENGTH(BillingAreasValue ,delim)
           SET countup=1
           FOR reps=countdown:-1:1 
           {
                SET extract=$PIECE(BillingAreasValue,delim,countup)
               $$$TRACE("billingAreaDescArray["_countup_"] value: "_extract )
                 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.IdxXmlToCareInMotionMfnHl7DemoLoader.Lookup.CimBillingAreaFilter",extract,.result)
        
                if ((result = "Unknown") || (result =""))
                {
                    $$$TRACE("Skip Message" )
                    set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "This is a CA record and BillingAreasValue value : "_extract_" is not in the CimBillingAreaFilter lookup table,  Skip the message.")
                      
                }
                else
                {
                    set BlockMsg = "N"
                    set firstValidBillingArea = extract
                    
                }  
                
               SET countup=countup+1
          
           }
		   }
        else
        {
           set firstValidBillingArea = FirstPieceBillingAreasValue
        } 
           
           $$$TRACE("After firstValidBillingArea value: "_firstValidBillingArea)
            set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.IdxXmlToCareInMotionMfnHl7DemoLoader.Lookup.CimBillingAreaMnemonic",firstValidBillingArea,.result)
             if ((result = "Unknown") || (result =""))
                {
                    $$$TRACE("no values in lookup setting GBBillingAreaMnemonic as empty" )
                    set context.GBBillingAreaMnemonic = ""
                    set context.GBBillingAreaDesc = firstValidBillingArea
                      
                }
                else
                {
                     set context.GBBillingAreaMnemonic = result
                     set context.GBBillingAreaDesc = firstValidBillingArea
                    
                }  
                
                 $$$TRACE("context.GBBillingAreaMnemonic value: "_context.GBBillingAreaMnemonic)
                 $$$TRACE("context.GBBillingAreaDesc value: "_context.GBBillingAreaDesc)
           
       }
     
     
     
    
     
   ]]]]><![CDATA[>
</code>
<switch name='DictionaryID' xpos='200' ypos='1150' xend='200' yend='1700' >
<case condition='context.DictionaryID = "3"' name='DictionayType 3' >
