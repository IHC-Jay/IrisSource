<code name='Create inter-hospital message' xpos='200' ypos='250' >
<![CDATA[ 
  $$$TRACE("Prepare for Inter-hospital message send")

 set context.InterHospitalMessage = context.cernerTransformedMsg.%ConstructClone(1)
 
 set newMRN  = $PIECE(context.InterHospitalMRNandFIN,":",1)
 set newPatientAccountNumber = $PIECE(context.InterHospitalMRNandFIN,":",2)
 $$$TRACE("newMRN value is : "_newMRN)
 $$$TRACE("newPatientAccountNumber value is : "_newPatientAccountNumber)

 do context.InterHospitalMessage.SetValueAt(newMRN, "PID:PatientIDInternalID(1).PatientID")
 do context.InterHospitalMessage.SetValueAt(newPatientAccountNumber, "PID:PatientAccountNumber.PatientID")
]]]]><![CDATA[>
