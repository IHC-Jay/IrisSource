<code name='Check InterHospital Billing' xpos='470' ypos='1200' >
<![CDATA[ 
 /* Changes for AIKB-17596
 
   LOGIC USED :
          Lookup table contains MSH-6 value as Key and each FT1-17 value and corresponding MRN and FIN separated by "-" .each FT1-17 value is separated by ","
          (Example :  
                    Key - 120
                    Value - " LO-648853045:1251741158,MK-99999:1111111 " )
        
        1. First get corresponding value from lookup table if available 
        2. Get count of "," in the lookup table value to see if that key contains more than one matching FT1-17 values
        3. For loop with comma count and do a PIECE condition to split the each values by "," ( if no "," is present PIECE will still return back the whole original value)
        4.Split the first resulting value using "-" to get the FT1-17 value to see if it matches with the message's FT1-17,if it matches we set Interhospital billing flag 
        5.Split the second resulting value using "-" to get the corresponding MRN and FIN value to send for the interhospital billing
        
          
  */        
 
 set Msh6=request.GetValueAt("MSH:Receivingfacility")
 set FT117=request.GetValueAt("FT1(1):Feeschedule")
   
     set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestHl7ToCernerHl7.Lookup.InterHospitalFacility", Msh6, .retVal )

  if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) 
  {       
    $$$TRACE("MSH-6 value not found in Table. Not a InterHospital Record")
    set context.isInterHospitalRecord = 0
  } 
  else
  {
    // get the actual Value from Lookup table
    set actualLookupvalue = retVal
    $$$TRACE("value of actualLookupvalue from table is : "_actualLookupvalue )
    
    // Get number of times "," appears in the actualLookupvalue (NOTE: if no comma present it still returns 1)
    set commacount = $LENGTH(actualLookupvalue,",")
     $$$TRACE(" no of time comma occurs is : "_commacount )
    
     
     FOR i=1:1:commacount {
       
        set lookupvalue= $PIECE(actualLookupvalue,",",i)  // Note : if no comma is in actualLookupvalue , PIECE returns the whole actualLookupvalue as it is
         $$$TRACE("value of lookupvalue  is : "_lookupvalue )
         
         //Get FT1-17 value from lookup table by splitting with -
      set FT117LookupValue= $PIECE(lookupvalue,"-",1)
      $$$TRACE("value of FT117LookupValue is : "_FT117LookupValue)
   
      //Get Interhospital MRN and FIN value from lookup table by splitting with -
      set context.InterHospitalMRNandFIN = $PIECE(lookupvalue,"-",2)
      $$$TRACE("value of context.InterHospitalMRNandFIN is : "_context.InterHospitalMRNandFIN)
   
   
    
      // Check if FT1-17 value is present in Lookup table value
      if ($FIND(FT117LookupValue, FT117 ) > 0)
      {
         $$$TRACE("FT117LookupValue contains FT1-17 value in it. It is a InterHospital Record")
         set context.isInterHospitalRecord = 1
         quit
      }
      else
      {
        $$$TRACE("LookupValue Does NOT contains FT-17 value in it. Not a InterHospital Record")
        set context.isInterHospitalRecord = 0
      }
    
       
       }
  
  }
  
  $$$TRACE("Value of context.isInterHospitalRecord is : "_context.isInterHospitalRecord)
  $$$TRACE("Value of context.InterHospitalMRNandFIN is : "_context.InterHospitalMRNandFIN )]]]]><![CDATA[>
</code>
