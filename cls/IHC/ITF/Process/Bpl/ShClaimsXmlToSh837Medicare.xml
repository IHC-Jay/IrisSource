     set tRequest = ##class(Ens.StreamContainer).%New("")	 
	 set tStream = ##class(%Stream.GlobalCharacter).%New("")	 
	 do tStream.Write(response.RawContent)	
	 set tRequest.Stream = tStream	 
	 set dt = $REPLACE($E($ZDATETIME($H,3,5),1,19),":","")
 	 set reqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream)
 	 $$$TRACE(	 " context.totalBatchCounts : "_context.totalBatchCounts)
 	 if (context.planType="HMO"){
	 	 if (context.medicareType="P"){
 	 		set reqObj.DestinationFileName = "ClaimsPROF."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
 	 		set context.destinationFileName="ClaimsPROF."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
	 	 }else{
		 	 set reqObj.DestinationFileName = "ClaimsINST."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
 	 		set context.destinationFileName="ClaimsINST."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
		 }
 	 	set reqObj.DestinationFilePath = context.destinationFilePath_"MedicareEdifecs"
 	 	set context.targetConfig = context.claimsHmoFileTargetConfigName
 	 }elseif(context.planType="PPO"){
	 	 if (context.medicareType="P"){
	 	 	set reqObj.DestinationFileName = "PPOClaimsPROF."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
	 	 	set context.destinationFileName="PPOClaimsPROF."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
	 	 }else{
		 	 set reqObj.DestinationFileName = "PPOClaimsINST."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
	 	 	set context.destinationFileName="PPOClaimsINST."_dt_"."_context.batchCountIndex_"of"_context.totalBatchCounts_".DAT"
		 }
 	 	set reqObj.DestinationFilePath = context.destinationFilePath_"MedicarePPO"
 	 	set context.targetConfig = context.claimsPpoFileTargetConfigName
	 }
	  $$$TRACE(	 " context.targetConfig : "_context.targetConfig)
 	 set tStatus = process.SendRequestSync(context.targetConfig,reqObj)
 	 if ('tStatus) {
	 	 set context.isFileSent="0" 
	 	 set context.returnCode ="12"
	 	 set context.returnDesc = "Unable to write X12 files to the file system.."_context.destinationFileName
	 	 set context.isStatusSuccess="N"
		 set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected error while writing X12 to file system: " _ context.claimsFileTargetConfigName _ $SYSTEM.Status.GetOneErrorText(tStatus))
      }else{
	   set context.isFileSent="1"    	
	   set context.isStatusSuccess="Y"   
	  }	 
 	 $$$TRACE("After sending to file..."_reqObj.DestinationFileName )
]]]]><![CDATA[>
