		 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,context.returnDesc)
  	}else{	  	  	
		if ($IsObject(dbResponse)){
	 		set context.dbRefCursorsResponse= dbResponse  
	}else{
			$$$TRACE(" dbResponse Response is null. ")
			// Returncode 8.. don't shutdown
			set context.returnCode ="8"
