<![CDATA[ set status=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(status)) || (configValue = "") )
 {
   Set status = $$$ERROR("Initialization error, No TargetConfigNames found")
 }
 $$$TRACE("ConfigName:"_configValue )]]]]><![CDATA[>
</code>
<code name='CallTargetConfig' xpos='200' ypos='650' >
<![CDATA[  //Call the Target config Syncrounously if the transaciton is delivered successfuly increment the Iseries global
 set tStatus=process.SendRequestSync(process.TargetConfigNames,request,.Response)
 if ($$$ISOK(tStatus)){
     $$$TRACE("Successfully Sent to Tcp/Ip")
    set currentCount=$g(^SAFETRACETOISERIES("ISERIES"_$ZDATE($H,8)))
    if currentCount > 0{
      set ^SAFETRACETOISERIES("ISERIES"_$ZDATE($H,8))=currentCount-1
    }
 }
 $$$TRACE("Date:"_$ZDATE($H,8))
 $$$TRACE("Global Value:"_$g(^SAFETRACETOISERIES("ISERIES"_$ZDATE($H,8))))]]]]><![CDATA[>
