<code name='Validate X12 and Set Filename' xpos='200' ypos='850' >
<![CDATA[  Set Filename = $P(request.OriginalFilename,"/",$Length(request.OriginalFilename,"/"))
  $$$TRACE("Inside code block _"_Filename)
  Set context.NewFileName = Filename
  If $P(Filename,"5010_MP",1)=""
 {
   Set context.NewFileName = "5010_SH"_$P(Filename,"5010_MP",2)
 }
 Do request.Stream.Rewind()
 $$$TRACE("request.Stream.Read(3)   "_request.Stream.Read(3))
 Do request.Stream.Rewind()
 If ($ZStrip(request.Stream.Read(3),"<>W")="ISA")
 {
	 $$$TRACE("Inside ISA if condition   "_request.Stream.Read(110))
	 Do request.Stream.Rewind()
	 Set X12Msg110Str = request.Stream.Read(110)
	 Do request.Stream.Rewind()
	 Set X12Msg250Str = request.Stream.Read(250)

  Set status = ##class(IHC.ITF.ITFCOMMON.Util.X12Util).getSegDelimX12(X12Msg110Str,.SegDelim,context.configName)
  Set status = ##class(IHC.ITF.ITFCOMMON.Util.X12Util).getFieldDelimX12(X12Msg110Str,.FieldDelim,context.configName)
  
   $$$TRACE("Inside code block SegDelim _"_SegDelim)
   $$$TRACE("Inside code block FieldDelim _"_FieldDelim)
  
  Set iGSSegBegin = $Find(X12Msg250Str,SegDelim_"GS")
  $$$TRACE("iGSSegBegin _  "_iGSSegBegin)
  If iGSSegBegin>=0
  {
	  Set iGSSegBegin=iGSSegBegin-1
	  Set iGSSegEnd = $Find(X12Msg250Str,SegDelim,iGSSegBegin+1)
	  $$$TRACE("iGSSegEnd _  "_iGSSegEnd)
	  If iGSSegEnd>=0
	  {
	  	Set GSSeg = $Extract(X12Msg250Str,iGSSegBegin+1,iGSSegEnd-1)
	  }
	  Else
	  {
		  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName,"Unable to split out GS segment from  <" _X12Msg250Str_">")
	  }
  }
  Else
  {
	   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName,"Unable to split out GS segment from  <" _X12Msg250Str_">")
  }

 $$$TRACE("Inside code block GSSeg _"_GSSeg)
 Set status = ##class(IHC.ITF.ITFCOMMON.Util.X12Util).getX12Field(GSSeg,SegDelim,FieldDelim,"9",.GS08Val,context.configName)
 
 $$$TRACE("Inside code block GS08Val _"_GS08Val) 
  
 }
 
