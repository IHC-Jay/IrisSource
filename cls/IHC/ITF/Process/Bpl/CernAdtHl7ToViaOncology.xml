]]]]><![CDATA[>
</code>
<code name='Check for Help1 merge record' xpos='200' ypos='1150' >
<![CDATA[ $$$TRACE("Check for valid merge data from Help1 whose MSH-10 has all numeric values.")  
 set msh10 = request.GetValueAt("MSH:10")

 if ($ISVALIDNUM(msh10) = "1")
 { 
     set servingFacPv139 = request.GetValueAt("PV1:ServicingFacility") 
     
     if ((context.eventType ="A31") && (servingFacPv139 = "DX")) 
     {      
          $$$TRACE("This is a valid merge record from Help1 with context.eventType:[" _context.eventType_"], MSH-10 :[" _msh10_ "], and servingFacPv139:[" _servingFacPv139_ "].")    
     }
     else
     {
	  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid event type in MSH-9.2 and/or serving facility code in PV1-39. Skipping the record." )
	  
	  $$$TRACE("Skip this record from Help1 MSH-10 :[" _msh10_ "] due to invalid context.eventType:[" _context.eventType_"] or servingFacPv1-39:[" _servingFacPv139_ "].") 	  	  
     }       
 }
 else
 {
 }
]]]]><![CDATA[>
