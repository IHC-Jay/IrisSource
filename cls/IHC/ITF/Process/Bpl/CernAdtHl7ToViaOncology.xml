<code name='Lookup Allowed Facilities' xpos='200' ypos='850' >
<![CDATA[	  
 set context.facilityId = request.GetValueAt("MSH:SendingFacility")  
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToViaOncology.Lookup.AllowedFacilities", context.facilityId, .retVal )
 $$$TRACE("context.facilityId:[" _context.facilityId_"]. Return Value: ["_retVal _"]") 
 if (retVal ="1") 
 {   
      //LDS Bone Marrow unit must match both MSH-4 NCID and PV1-3.1 values below
    if (context.facilityId = "128")
    {
        set unitId = request.GetValueAt("PV1:AssignedPatientLocation.pointofcare") 
        $$$TRACE("PV1-3.1 Unit value is: " _unitId ) 
        if ((unitId'= "") && (unitId = "LD_Lvlnd BMTInf"))
        {
           set context.unitIdPV131 = unitId
           $$$TRACE("The context.unitIdPV131 variable got its value from the PV1-3.1 input: " _context.unitIdPV131) 
        }
        else
        {
           set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid unit in PV1-3.1: ["_unitId_"]. Skipping the record." )	
        }
    }
    else
    {
    }  
     
 }else{
	  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid Facility in MSH-4:["_context.facilityId_"]. Skipping the record." )	  	  
 }
]]]]><![CDATA[>
</code>
