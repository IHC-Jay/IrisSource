<code name='Facility Lookup Table' xpos='200' ypos='750' >
<![CDATA[  set retVal = ##class(Ens.Util.LookupTable).%ExistsTable("IHC.ITF.Process.Bpl.CernAdtHl7ToViaOncology.Lookup.AllowedFacilities")
  if (retVal = 0){
	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError($CLASSNAME(),"Lookup table IHC.ITF.Process.Bpl.CernAdtHl7ToViaOncology.Lookup.AllowedFacilities not exists")  
  }
