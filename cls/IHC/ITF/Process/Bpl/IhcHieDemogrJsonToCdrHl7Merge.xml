<code name='Create Merge notification' xpos='470' ypos='1600' >
<![CDATA[
 $$$TRACE("Create merge notification and send notification")
 set mergeNotifMsg = "KEEP: " _ context.empiNum _ $CHAR(9) _ " DELETE: " _ context.deletEmpiNum
 set mergeNotifMsg = mergeNotifMsg _ $CHAR(10) _ "MERGE STATUS:"
 set mergeNotifMsg = mergeNotifMsg _ $CHAR(10) _ context.empiNum _ " ! " _ context.deletEmpiNum _ $CHAR(10)_$CHAR(10)
 $$$TRACE("MergeNotifMsg: " _ mergeNotifMsg)
 set trequest = ##class(Ens.StreamContainer).%New("")
 set tStream = ##class(%GlobalCharacterStream).%New("")
 do tStream.WriteLine(mergeNotifMsg)
 set trequest.Stream = tStream
 do process.SendRequestSync(context.notifyMergeTargetConfigName,trequest,.result) 	
