 ]]]]><![CDATA[>
</code>
<code name='Create Error Stream Container' xpos='470' ypos='900' >
<![CDATA[   $$$TRACE("Create Error Stream Container")
 Do request.Stream.Rewind()
 $$$TRACE("Send Error" _ request.OriginalFilename _ ", Stream data size: " _ request.Stream.Size)
 
 set context.streamContainer.Stream=##class(%FileCharacterStream).%New()
 set stat = context.streamContainer.Stream.CopyFromAndSave(request.Stream)
        
 $$$TRACE("Document Stream: " _ context.streamContainer.Stream.Size _", copy status: " _ stat )
 
 set context.streamContainer.OutputFilename =   context.errorMessage _ "-" _ ##class(%File).GetFilename(request.OriginalFilename)
 set context.streamContainer.OriginalFilename = context.errorMessage _ "-" _ ##class(%File).GetFilename(request.OriginalFilename) 
]]]]><![CDATA[>
