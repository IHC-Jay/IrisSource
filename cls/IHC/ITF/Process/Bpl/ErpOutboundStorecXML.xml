<code name='Store Data' xpos='200' ypos='900' >
<![CDATA[   $$$TRACE("*** Store Outbound cXML Data")
  set status = ##class(IHC.ITF.ITFCOMMON.ErpUtil).StoreErpXmlData(request.Stream, ##class(%File).GetFilename(request.OriginalFilename), context.sessionID, 1) 
 ]]]]><![CDATA[>
</code>
