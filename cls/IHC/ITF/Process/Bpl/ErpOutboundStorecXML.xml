<code name='Check ReplyCodeActions' xpos='200' ypos='450' >
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }
 	  ]]]]><![CDATA[>
</code>
<code name='Validate cXML Message' xpos='200' ypos='550' >
<![CDATA[ Set tDocument=##class(EnsLib.EDI.XML.Document).ImportFromLibraryStream(request.Stream, .tSC)
     	 
 if ( ($$$ISOK(tSC)) && ($IsObject( tDocument)))
 {
    $$$TRACE( "**** cXML Data Filename " _ request.OriginalFilename)
    set context.xmlDoc = tDocument
    set context.ValidationPassed = 1
 }
 else
 {
    $$$TRACE( "**** Invalid cXML Data Filename " _ request.OriginalFilename)
    set context.ValidationPassed = 0
    //$$$LOGERROR($System.Status.GetErrorText(tSC))
 }]]]]><![CDATA[>
</code>
<if name='Check If cXML is Valid' condition='context.ValidationPassed' xpos='200' ypos='650' xend='200' yend='1100' >
