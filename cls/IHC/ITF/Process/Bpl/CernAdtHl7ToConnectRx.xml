<code name='Set Location Variables' xpos='200' ypos='2050' >
<annotation><![CDATA[Set Location Variables and do filtering]]]]><![CDATA[></annotation>
<![CDATA[ set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.HddRepResponse, context.LocationInfo)
 if (hddObj '= ""){
    set patLoc = hddObj.Rep
    $$$TRACE("Created HDD Request and got response back for " _context.LocationInfo_ " NCID: " _hddObj.NCID_ ", context: " _context.PV1ThreeLocationContext)
 }

 $$$TRACE("Patient encounter location representation received from HDD: " _patLoc)
 set patLocList = $LISTFROMSTRING(patLoc, "|")
 set patLocListLength = $LISTLENGTH(patLocList)
 $$$TRACE("Pat Location(Cerner Rep) List count:"_patLocListLength)   
 if patLocListLength>=5{
    set context.pointOfCareUnit = $LIST(patLocList,3) 
    set context.Room = $LIST(patLocList,4)_$LIST(patLocList,5)  
    set context.Bed =   ""
 }elseIF patLocListLength>=4{	   
    set context.pointOfCareUnit = $LIST(patLocList,3) 
    set context.Room = $LIST(patLocList,4)   
    set context.Bed =  ""
 }elseIF  patLocListLength>=3{	   
    set context.pointOfCareUnit = $LIST(patLocList,3) 
    set context.Room = ""   
    set context.Bed =  ""
 }elseIF patLocListLength<=2{
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName, "****HDD ERRROR****Unable to get required location representation for setting PV1-3 values. HDD rep returned was: "_patLoc_"HDD request created for " _context.LocationInfo_ ". For Location NCID: "_context.locationNcid _" Using HddTargetConfigName: " _context.HddTargetConfigName _ "Using HDD Context: " _context.PV1ThreeLocationContext _ "***HL7 Msg:" _ request.RawContent)
 
 }
]]]]><![CDATA[>
