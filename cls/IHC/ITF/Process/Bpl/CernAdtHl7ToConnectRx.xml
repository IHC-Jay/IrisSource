<code name='Lookup Location in HDD' xpos='200' ypos='2250' >
<annotation><![CDATA[Get HDD response from the call to get representation from NCID]]]]><![CDATA[></annotation>
<![CDATA[ // Call HDD Operation
 $$$TRACE("Actually sending the HDD REQUEST")
 set tStatus=process.SendRequestSync($GET(^IHC.CernAdtHl7ToConnectRx("HddTargetConfigName")),context.HddRepRequest,.hddResponse)
 if ('tStatus) {
	 if ($LISTFIND($GET(^IHC.CernAdtHl7ToConnectRx("AllowedEventsWithNoLocNcids")),context.MSH92)>0){
		$$$TRACE("The HDD Request did not process as expected. However, we have an ADT event that does not need the HDD response for the PV1-3 values. Continuing to Process the Order. Emailing HDD to look at error.")
		Do ..%Process.ItfSendEmailOnError("****HDD ERRROR****Unexpected response back from HDD. Unable to get required Pharmacy Location representation for setting PV1-3 values for unit, room, and bed - Not stopping procesing of ADT message for this error. HDD status returned was: "_tStatus_"HDD request created for " _context.LocationInfo_ ". For Location NCID: "_context.locationNcid _" Using HddTargetConfigName: " _$G(^IHC.CernAdtHl7ToConnectRx("HddTargetConfigName")) _ "Using HDD Context specific to Pharmacy: " _$G(^IHC.CernAdtHl7ToConnectRx("PV1ThreeLocationContext")) _ "***HL7 Pharmacy ADT Details (PHI): FIN/Encounter#" _context.finPID18_" Patient EMPI: "_context.empiNumber_" ADT HL7 MSH-10 MessageControlID: "_context.MSH10)
	 }
     else{
	  set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure")   
	 }
 }
 else {
   set context.HddRepResponse = hddResponse
   $$$TRACE("Actually received HDD RESPONSE")
 }
]]]]><![CDATA[>
</code>
<code name='Set Location Variables' xpos='200' ypos='2350' >
<annotation><![CDATA[Set Location Variables and do filtering]]]]><![CDATA[></annotation>
<![CDATA[ set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.HddRepResponse, context.LocationInfo)
 if (hddObj '= ""){
	set patLoc = hddObj.Rep
	$$$TRACE("Created HDD Request and got response back for " _context.LocationInfo_ " NCID: " _hddObj.NCID_ ", HDD Context: " _$G(^IHC.CernAdtHl7ToConnectRx("PV1ThreeLocationContext")))

	$$$TRACE("Patient encounter location representation received from HDD: " _patLoc)
	set patLocList = $LISTFROMSTRING(patLoc, "|")
	set patLocListLength = $LISTLENGTH(patLocList)
	$$$TRACE("Pat Location(Cerner Rep) List count:"_patLocListLength)   
	if patLocListLength>=5{
		set context.pointOfCareUnit = $LIST(patLocList,3) 
		set context.Room = $LIST(patLocList,4)_$LIST(patLocList,5)  
		set context.Bed =   ""
	}elseIF patLocListLength>=4{	   
		set context.pointOfCareUnit = $LIST(patLocList,3) 
		set context.Room = $LIST(patLocList,4)   
		set context.Bed =  ""
	}elseIF  patLocListLength>=3{	   
		set context.pointOfCareUnit = $LIST(patLocList,3) 
		set context.Room = ""   
		set context.Bed =  ""
	}elseIF patLocListLength<=2{
