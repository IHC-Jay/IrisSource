 $$$TRACE("Created HDD request object for " _context.LocationInfo_ ". For Location NCID: "_context.locationNcid _" Using HddTargetConfigName: " _$G(^IHC.CernAdtHl7ToConnectRx("HddTargetConfigName")) _ "Using HDD Context: " _$G(^IHC.CernAdtHl7ToConnectRx("PV1ThreeLocationContext")))]]]]><![CDATA[>
