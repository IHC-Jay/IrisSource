<code name='GetLocationNcidFromZzz' xpos='200' ypos='2050' >
<annotation><![CDATA[Get LocationNcidFrom Zzz and Set context Values]]]]><![CDATA[></annotation>
<![CDATA[
 //Check the second ZZZ segment for NCIDS that Cerner used for PV1 locations
 set Ncid = request.GetValueAt("ZZZ(2):16VisitAdmitDXCode")
 if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
    set context.LocationInfo = "ZZZ(2):16VisitAdmitDXCode - Cerner Patient Bed "
    set context.locationNcid = Ncid
    $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDD Context: " _$G(^IHC.CernAdtHl7ToConnectRx("PV1ThreeLocationContext")))
 }else {
    set Ncid = request.GetValueAt("ZZZ(2):15VisitPatientType")
    if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
       set context.LocationInfo = "ZZZ(2):15VisitPatientType - Cerner Patient Room"
       set context.locationNcid = Ncid
       $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDD Context: " _$G(^IHC.CernAdtHl7ToConnectRx("PV1ThreeLocationContext")))
    }else {
       set Ncid = request.GetValueAt("ZZZ(2):14VisitAdmitSource")
       if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
          set context.LocationInfo = "ZZZ(2):14VisitAdmitSource - Cerner Patient POC Unit"
          set context.locationNcid = Ncid
          $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDDContext: " _$G(^IHC.CernAdtHl7ToConnectRx("PV1ThreeLocationContext")))
       }
    }
 }
 if (Ncid="" || '$ISVALIDNUM(Ncid)){
	 if ($LISTFIND($GET(^IHC.CernAdtHl7ToConnectRx("AllowedEventsWithNoLocNcids")),context.MSH92)=0) {
        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***Unable to get required location value for setting PV1-3 values. No valid NCID found in: ZZZ(2):16VisitAdmitDXCode, ZZZ(2):15VisitPatientType, or ZZZ(2):14VisitAdmitSource. Found: ["_Ncid_"]. HL7 Pharmacy ADT Details (PHI): FIN/Encounter#" _context.finPID18_" Patient EMPI: "_context.empiNumber_" ADT HL7 MSH-10 MessageControlID: "_context.MSH10)
	 }else{
		 $$$TRACE("Have ADT event that does not need/expect to have Patient Location values for PV1-3 found in the ZZZ(2) segment.")
	 }
 }else{
	 $$$TRACE("Found NCIDs for location values for PV1-3 in ZZZ(2) segment. Going to work HDD Lookup.")
 }
 ]]]]><![CDATA[>
</code>
<code name='SetHDDRepRequest' xpos='200' ypos='2150' >
