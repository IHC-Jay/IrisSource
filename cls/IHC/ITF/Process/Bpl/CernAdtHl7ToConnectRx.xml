<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"EnterpriseLoopLocations",.LoopLocations) 
 $$$TRACE("Value of Loop Locations="_LoopLocations)
