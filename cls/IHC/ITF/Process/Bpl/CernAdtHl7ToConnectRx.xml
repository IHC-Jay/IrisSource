<code name='GetLocationNcidFromZzz' xpos='200' ypos='1750' >
<annotation><![CDATA[Get LocationNcidFrom Zzz and Set context Values]]]]><![CDATA[></annotation>
<![CDATA[ set Ncid = request.GetValueAt("ZZZ(2):16VisitAdmitDXCode")
 if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
    set context.LocationInfo = "ZZZ(2):16VisitAdmitDXCode - Cerner Patient Bed "
    set context.locationNcid = Ncid
    $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ". Context: " _context.PV1ThreeLocationContext)
 }else {
    set Ncid = request.GetValueAt("ZZZ(2):15VisitPatientType")
    if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
       set context.LocationInfo = "ZZZ(2):15VisitPatientType - Cerner Patient Room"
       set context.locationNcid = Ncid
       $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ". Context: " _context.PV1ThreeLocationContext)
    }else {
       set Ncid = request.GetValueAt("ZZZ(2):14VisitAdmitSource")
       if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
          set context.LocationInfo = "ZZZ(2):14VisitAdmitSource - Cerner Patient POC Unit"
          set context.locationNcid = Ncid
          $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ". Context: " _context.PV1ThreeLocationContext)
       }
    }
 }
 if (Ncid="" || '$ISVALIDNUM(Ncid)){
     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***Unable to get required location value for setting PV1-3 values. No valid NCID found in: ZZZ(2):16VisitAdmitDXCode, ZZZ(2):15VisitPatientType, or ZZZ(2):14VisitAdmitSource. Found: "_Ncid_"***HL7 Msg:" _ request.RawContent)
 }]]]]><![CDATA[>
