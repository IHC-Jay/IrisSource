<![CDATA[  set nameTypeNcidValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").nametypecode")
  set lastNameValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").familyname")
 
  $$$TRACE("Before AllowedNametypes")
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedNameTypes",.configValue)
 $$$TRACE("setting value of AllowedNameTypes: " _configValue)
 set AllowedNameTypesList = $LISTFROMSTRING(configValue, ",")
 

 
 
 ///nameTypeNcidValueis present in List and if lastNameValue is not empty and if the nameTypeNcidValue is present in list ListPid5NameTypes (which means we have already got one name with that nametype)
 if (($LENGTH(lastNameValue) '= 0) && ($LISTFIND(AllowedNameTypesList , nameTypeNcidValue) > 0) && (context.ListPid5NameTypes.Find(nameTypeNcidValue) = ""))
 {
    $$$TRACE("Inside accepted NameType present")
    
    ///Insert nametype ncid into the list
    do context.ListPid5NameTypes.Insert(nameTypeNcidValue)
    $$$TRACE("Inserted NametypeNcid "_nameTypeNcidValue_" into ListPid5NameTypes") 
    
    ///Map other values
    
    ///Last Name
    do context.familyname.SetAt(lastNameValue,context.NameArrayCount)
    $$$TRACE("familyname in Array position "_context.NameArrayCount_" : "_context.familyname.GetAt(context.NameArrayCount))


    ///First Name
    set givennameValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").givenname")
    do context.givenname.SetAt(givennameValue,context.NameArrayCount)
    $$$TRACE("GivenName in Array position "_context.NameArrayCount_" : "_context.givenname.GetAt(context.NameArrayCount))
    
    
    ///Middle Name
    set secondandfurthergivennamesorValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").secondandfurthergivennamesor")
    do context.secondandfurthergivennamesor.SetAt(secondandfurthergivennamesorValue,context.NameArrayCount)
    $$$TRACE("secondandfurthergivennamesor in Array position "_context.NameArrayCount_" : "_context.secondandfurthergivennamesor.GetAt(context.NameArrayCount))
    
    
    ///suffix
    set suffixValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").suffix")
    do context.suffix.SetAt(suffixValue,context.NameArrayCount)
    $$$TRACE("suffix in Array position "_context.NameArrayCount_" : "_context.suffix.GetAt(context.NameArrayCount))
    
    
    ///nametypecode
    set nametypecodeValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").nametypecode")
    do context.nametypecode.SetAt(nametypecodeValue,context.NameArrayCount)
    $$$TRACE("nametypecode in Array position "_context.NameArrayCount_" : "_context.nametypecode.GetAt(context.NameArrayCount))
    
    
    ///Increment NameArrayCount 
    set context.NameArrayCount = context.NameArrayCount + 1
    
 }
 else
 {
     $$$TRACE("NameType not accepted")
    
 }
 
 
 
 
]]]]><![CDATA[>
</code>
</foreach>
<foreach name='Iterate PID9' property='request.{PID:PatientAlias()}' key='context.PID9Count' xpos='200' ypos='1450' xend='200' yend='350' >
<code name='Populate PID9 names' xpos='200' ypos='250' >
<![CDATA[  set nameTypeNcidValue= request.GetValueAt("PID:PatientAlias("_context.PID9Count_").nametypecode")
  set lastNameValue= request.GetValueAt("PID:PatientAlias("_context.PID9Count_").familyname")
  set firstNameValue= request.GetValueAt("PID:PatientAlias("_context.PID9Count_").givenname")
 
  $$$TRACE("Before PID-9 AllowedNametypes")
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedNameTypes",.configValue)
 $$$TRACE("setting value of AllowedNameTypes: " _configValue)
 set AllowedNameTypesList = $LISTFROMSTRING(configValue, ",")
 
 
 
 ///nameTypeNcidValueis present in List and if lastNameValue is not empty and if the nameTypeNcidValue is present in list ListPid5NameTypes (which means we have already got one name with that nametype)
 if (($LISTFIND(AllowedNameTypesList , nameTypeNcidValue) > 0) && (context.ListPid5NameTypes.Find(nameTypeNcidValue) = ""))
 {
    $$$TRACE("Inside PID-9 accepted NameType present")
    
    ///Insert nametype ncid into the list
    do context.ListPid5NameTypes.Insert(nameTypeNcidValue)
    $$$TRACE("Inserted NametypeNcid "_nameTypeNcidValue_" into ListPid5NameTypes") 
    
    
    if ((context.keepMmiInCDR = 1) || (($LENGTH(lastNameValue) '= 0) && ($LENGTH(firstNameValue) '= 0)))
    {
    
      ///Map other values
    
      ///Last Name
      do context.familyname.SetAt(lastNameValue,context.NameArrayCount)
      $$$TRACE("familyname in Array position "_context.NameArrayCount_" : "_context.familyname.GetAt(context.NameArrayCount))


      ///First Name
      do context.givenname.SetAt(firstNameValue,context.NameArrayCount)
      $$$TRACE("familyname in Array position "_context.NameArrayCount_" : "_context.givenname.GetAt(context.NameArrayCount))
    
    
      ///Middle Name
      set secondandfurthergivennamesorValue= request.GetValueAt("PID:PatientAlias("_context.PID9Count_").secondandfurthergivennamesor")
      do context.secondandfurthergivennamesor.SetAt(secondandfurthergivennamesorValue,context.NameArrayCount)
      $$$TRACE("secondandfurthergivennamesor in Array position "_context.NameArrayCount_" : "_context.secondandfurthergivennamesor.GetAt(context.NameArrayCount))
    
    
      ///suffix
      set suffixValue= request.GetValueAt("PID:PatientAlias("_context.PID9Count_").suffix")
      do context.suffix.SetAt(suffixValue,context.NameArrayCount)
      $$$TRACE("suffix in Array position "_context.NameArrayCount_" : "_context.suffix.GetAt(context.NameArrayCount))
    
    
      ///nametypecode
      set nametypecodeValue= request.GetValueAt("PID:PatientAlias("_context.PID9Count_").nametypecode")
      do context.nametypecode.SetAt(nametypecodeValue,context.NameArrayCount)
      $$$TRACE("nametypecode in Array position "_context.NameArrayCount_" : "_context.nametypecode.GetAt(context.NameArrayCount))
    
    
      ///Increment NameArrayCount 
      set context.NameArrayCount = context.NameArrayCount + 1
    
    }
    
 }
 else
 {
     $$$TRACE("PID9 NameType not accepted")
    
 }
 
 
 
 
]]]]><![CDATA[>
</code>
</foreach>
<foreach name='Populate PID11 values' property='request.{PID:PatientAddress()}' key='context.PID11Count' xpos='200' ypos='1550' xend='200' yend='450' >
<code name='Get Wrap Properties' xpos='200' ypos='250' >
<![CDATA[ set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AddrWrapLogic",.configValue)
 $$$TRACE("setting value of AddrWrapLogic: " _configValue)
 
 set AddrWrapLogicValue = configValue
 
 
 
    $$$TRACE("Before AddrWrapKeywords ")
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AddrWrapKeywords",.configValue)
 $$$TRACE("setting value of AddrWrapKeywords: " _configValue)
 
 set AddrWrapKeywordsList = $LISTFROMSTRING(configValue, ",")
 
]]]]><![CDATA[>
</code>
<code name='Populate Values' xpos='200' ypos='350' >
<![CDATA[ set addressTypeValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").addresstype")
 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedAddressTypes",.configValue)
 $$$TRACE("setting value of AllowedAddressTypes: " _configValue)
 
 set AllowedAddressTypesValues = $LISTFROMSTRING(configValue, ",")
 
 ///addressTypeValue is present in List or if addressTypeValue is empty
 if (($LISTFIND(AllowedAddressTypesValues, addressTypeValue) > 0) || ($LENGTH(addressTypeValue) = 0))
 {
    $$$TRACE("Inside accepted Addresstype present")
    /// Insert "Yes" to the list so that in DTL we can check if this PID11 should be mapped or not
    do context.AddressToProcess.SetAt("Yes",context.PID11Count)
    $$$TRACE("AddressToProcess in List position "_context.PID11Count_" : Yes" )  
    
    ///Address Wrap logic
    set addrLine1 = request.GetValueAt("PID:PatientAddress("_context.PID11Count_").streetaddressSAD")
    set addrLine2 = request.GetValueAt("PID:PatientAddress("_context.PID11Count_").otherdesignation")
    set street1 =""
    set street2 =""
    set isWrapped = 0 ///Flag so check if wrap happened
    
    $$$TRACE("$LISTLENGTH(AddrWrapKeywordsList) :"_$LISTLENGTH(AddrWrapKeywordsList))
    $$$TRACE("$LENGTH(addrLine1) :"_$LENGTH(addrLine1))
    $$$TRACE("AddrWrapLogicValue  :"_AddrWrapLogicValue)
    $$$TRACE("$LENGTH(addrLine2) :"_$LENGTH(addrLine2))
    
    if (($LISTLENGTH(AddrWrapKeywordsList) > 0) && ($LENGTH(addrLine1) > 25) && (AddrWrapLogicValue = "Y") && ($LENGTH(addrLine2) = 0))
    {
       $$$TRACE("Inside need wrapping")
       
       ///Below while will loop through all the content in the list and in each iteration the current list value will be in "addrWrap"
       SET ptr=0
       WHILE 1=$LISTNEXT(AddrWrapKeywordsList,ptr,addrWrap) 
       {
          $$$TRACE("addrWrap value :"_addrWrap)
          set addrWrap = " "_addrWrap
          set addrLine1L = $ZCONVERT(addrLine1 ,"L") ///Converting to Lowercase
          set addrWrapL = $ZCONVERT(addrWrap,"L")
          
          ///Below $FIND will give the ending index+1 of the word in "addrWrapL"
          set indexAddrLine1 = $FIND(addrLine1L,addrWrapL)
          if (indexAddrLine1 > 0)
          {
            $$$TRACE("Inside indexfound at: "_indexAddrLine1 )
             ///Need to minus the length addrWrapL since we have the ending index+1 in previous step
             set street1 = $EXTRACT(addrLine1L,0,indexAddrLine1-$LENGTH(addrWrapL)-1)
             $$$TRACE("street1 Value in List position "_context.PID11Count_" : "_street1)
             
             ///* will get till the end of the string
             set street2 = $EXTRACT(addrLine1L,indexAddrLine1-$LENGTH(addrWrapL),*)
             $$$TRACE("street2 Value in List position "_context.PID11Count_" : "_street2 )
             
             ///We are interchanging street1 and street2 values when we map just bcas Egate does that
             do context.streetaddressSAD.SetAt(street2,context.PID11Count)
             do context.otherdesignation.SetAt(street1,context.PID11Count)
             set isWrapped = 1
             
          }
          
       }
       
       if (isWrapped = 0) ///If wrap did not happen
       {
          $$$TRACE("Inside isWrapped is 0" )
         set streetaddressSADValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").streetaddressSAD")
         do context.streetaddressSAD.SetAt(streetaddressSADValue,context.PID11Count)
          $$$TRACE("streetaddressSADValueValue in List position "_context.PID11Count_" : "_streetaddressSADValue)
         
         set otherdesignationValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").otherdesignation")
         do context.otherdesignation.SetAt(otherdesignationValue,context.PID11Count)
         $$$TRACE("otherdesignationValuein List position "_context.PID11Count_" : "_otherdesignationValue)
          
       }
    
    }
    else /// else part of second if which mean we have to map incoming values without change
    {
       $$$TRACE("Inside else part of second if" )
         set streetaddressSADValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").streetaddressSAD")
         do context.streetaddressSAD.SetAt(streetaddressSADValue,context.PID11Count)
          $$$TRACE("streetaddressSADValueValue in List position "_context.PID11Count_" : "_streetaddressSADValue)
         
         set otherdesignationValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").otherdesignation")
         do context.otherdesignation.SetAt(otherdesignationValue,context.PID11Count)
         $$$TRACE("otherdesignationValuein List position "_context.PID11Count_" : "_otherdesignationValue)
    }
    
    ///Map other values
    
     $$$TRACE("Mapping other values" )
    
    ///City
    set cityValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").city")
    do context.city.SetAt(cityValue,context.PID11Count)
     $$$TRACE("cityValue in List position "_context.PID11Count_" : "_cityValue)
     $$$TRACE("context.city.GetAt(2) :"_context.city.GetAt(context.PID11Count))
      $$$TRACE("context.city.GetAt(1) :"_context.city.GetAt(1))
    
    
    ///State
    set stateorprovinceValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").stateorprovince")
    do context.stateorprovince.SetAt(stateorprovinceValue,context.PID11Count)
    $$$TRACE("stateorprovinceValue in List position "_context.PID11Count_" : "_stateorprovinceValue)
    
    ///Zipcode
      set ziporpostalcodeValue= request.GetValueAt("PID:PatientAddress("_context.PID11Count_").ziporpostalcode")
      ///Replace "-" to "" in zipcode
      set ziporpostalcodeValue = $REPLACE(ziporpostalcodeValue,"-","")
      do context.ziporpostalcode.SetAt(ziporpostalcodeValue ,context.PID11Count)
      $$$TRACE("ziporpostalcodeValueValue in List position "_context.PID11Count_" : "_ziporpostalcodeValue )
      
    
    ///Country
    
    set hddObjRep=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddRepResponse, "PID11:Country"_context.PID11Count)
  if (hddObjRep'="")
   {
      if ( hddObjRep.Rep '="")
      {
        $$$TRACE("country Rep value: "_hddObjRep.Rep)
        do context.country.SetAt(hddObjRep.Rep,context.PID11Count)
        $$$TRACE("country in List position "_context.PID11Count_" : "_hddObjRep.Rep )
      }
  }
    
    ///AddressType
    do context.addresstype.SetAt(addressTypeValue,context.PID11Count)
    $$$TRACE("AddressType in List position "_context.PID11Count_" : "_addressTypeValue)
 }
 else
 {
     $$$TRACE("AddressType not accepted")
    /// Insert "No" to the list so that in DTL we can check if this PID11 should be mapped or not
    do context.AddressToProcess.SetAt("No",context.PID11Count)
    $$$TRACE("AddressToProcess in List position "_context.PID11Count_" : No") 
 }
 
 
 
 
]]]]><![CDATA[>
</code>
</foreach>
