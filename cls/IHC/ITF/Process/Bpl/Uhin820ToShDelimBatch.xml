<code name='Parse ISA and collect GS level' xpos='200' ypos='650' >
<annotation><![CDATA[Parse X12 and split at GS level]]]]><![CDATA[></annotation>
<![CDATA[ /* Allocating assigned memory for the process */
 
 set memValue = ""
 
 set mstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AssignedMemory",.memValue)
  
 if ( ($$$ISERR(mstatus)) || (memValue= ""))
 {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName,"Assigned Memory value is missing from configuration.")
 }
 else
 {  
  SET $ZSTORAGE=memValue  
 }
 
 ///$$$TRACE("Memory Value Assigned : "_memValue)
 
 /* Check if the received data is a X12 file or not and report error if it is not a X12 message. Parse the Interchange Level and extract number of Group level (GS-GE) count, SenderID (ISA06), ControlNumber (ISA13) and UsageIndicator (ISA15). Iterate through each GS level and place each group object in a collection list */
 
 
 if (request.%Extends("EnsLib.EDI.X12.Document"))
 {
 
   try
   {          
       /* Setting request message to X12 Interchange structure and gather number of child segment (GS-GE) count */
       
       set request.DocType = "HIPAA_5010:Interchange:Group" 
       set context.GSCounter = request.ChildCount
       
       /* Extracting InterchangeSenderID, Interchange ControlNumber and Interchange usage indicator values from X12 */
 
       set context.ISA06 = $ZSTRIP(request.GetValueAt("ISA:InterchangeSenderID"),"<>W") 
       set context.ISA13 = $ZSTRIP(request.GetValueAt("ISA:InterchangeControlNumber"),"<","0")
       set context.ISA15 = request.GetValueAt("ISA:UsageIndicator")
 
       /* Iterates through available number of group's and collects group level information and sets to gsDoc object */
          
          for i=1:1:context.GSCounter
          { 
            set x = request.getNthChild(i,2)
            do context.gsDoc.SetAt(x,i) 
          }  
         
    }
    Catch ex 
    { 
      if 1=ex.%IsA("%Exception.SystemException") 
      {
        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Interchange level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
      }
      else 
      {       
       Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Interchange level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)  
      }  
    }  
 } 
 else
 {
  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message ")
 } 
]]]]><![CDATA[>
</code>
<foreach name='for each Group level (GS-GE)' property='context.gsDoc' key='context.GSCounter' xpos='200' ypos='750' xend='200' yend='450' >
<annotation><![CDATA[Iterate through each GS level ]]]]><![CDATA[></annotation>
<code name='Parse GS and collect ST level' xpos='200' ypos='250' >
<annotation><![CDATA[Iterate and collect ST level details for each Group]]]]><![CDATA[></annotation>
<![CDATA[  /* Parse at Group level and extract Transaction set (ST-SE) count, SenderID (GS02), Date (GS04), Time (GS05), ControlNumber (GS06). Iterate through each ST level and place each group object in a collection list */

 try {
        
        /* Getting the stored group message (GS-GE) and setting X12 Group structure */
        
        set individualGroup = context.gsDoc.GetAt(context.GSCounter)         
        set individualGroup.DocType = "HIPAA_5010:Group"
        
               
        /* Extracting GroupSenderID, GroupDate and Group ControlNumber values from X12 */
 
        
        set context.GS02 = individualGroup.GetValueAt("GS:ApplicationSendersCode")        
        set context.GS04 = individualGroup.GetValueAt("GS:Date")
        set context.GS05 = individualGroup.GetValueAt("GS:Time")
        set context.GS06 = individualGroup.GetValueAt("GS:GroupControlNumber")
 

        
        $$$TRACE("Envelope values Extracted for mapping : ISA06-"_context.ISA06_", ISA13-"_context.ISA13_", ISA15-"_context.ISA15_", GS02-"_context.GS02_", GS04-"_context.GS04_", GS05-"_context.GS05_", GS06-"_context.GS06)
        
        /* Gather number of child segment (ST-SE) count */
 
        set context.STCounter = individualGroup.ChildCount        
        
        
        /* Iterates through available number of TransactionSets and set ST level information to stDoc object */
 
        For i=1:1:context.STCounter
        { 
          do context.stDoc.SetAt(individualGroup.getNthChild(i,2),i) 
        }        
        
     }
     Catch ex
     {  
       if 1=ex.%IsA("%Exception.SystemException") 
       {
         Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Functional Group GS level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
       }
      else 
      {  
        Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Functional Group GS level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
      }       
   }
    
]]]]><![CDATA[>
</code>
<foreach name='for each TransactionSet level (ST-SE)' property='context.stDoc' key='context.STCounter' xpos='200' ypos='350' xend='200' yend='450' >
<annotation><![CDATA[Process individual Transaction sets ]]]]><![CDATA[></annotation>
<code name='Generate Temp FileName' xpos='200' ypos='250' >
<annotation><![CDATA[Generate temporary filename for each transaction set (ST-SE)]]]]><![CDATA[></annotation>
<![CDATA[
 /* Parse at Transaction set level and extract Transactionset controlnumber (ST02) to be used to generate temporary filename. Each ST in the X12 will have its own Delimited flat file */

 try {
      
       set context.individualST=context.stDoc.GetAt(context.STCounter)
       
       /* Extract GroupID information from X12 to be used in filename */
  
        set refGroupIDpath="REF(1)"
        set refGroupIDind=context.individualST.GetSegmentIndex(refGroupIDpath,.refGroupIDstatus)  
        set GroupID=context.individualST.GetValueAt(refGroupIDind_":2")
 
 
       /* Generate a new filename for each Transaction Set as one CFF file needs to be created for one X12 Transaction Set */
 
       set context.filesCounter = context.filesCounter + 1
 
       set context.FileName = context.TemporaryFileLocation_"-" _ GroupID _"."_$ZSTRIP($ZDATETIME($NOW(360),8,1,3) ,"*P")
       
       $$$TRACE("Temporary FileName : "_ context.FileName)
       
       /* Create list with output filenames */
 
       do context.OutputFiles.SetAt(context.FileName,context.filesCounter)
 
       /* Set variable values */
 
       set context.iterator = 1 
       set context.ENTParsing="0"
        
     }
     Catch ex
     {  
       if 1=ex.%IsA("%Exception.SystemException") 
    {
      Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Transaction level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
    }
    else 
    {  
      Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Transaction level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
    }
       
     }
  
  

 
 ]]]]><![CDATA[>
</code>
<while name='X12 Transaction Iteration' condition='context.ENTParsing="0"' xpos='200' ypos='350' xend='200' yend='1000' >
<annotation>iterate through all the segments of the X12 transaction set (ST-SE)</annotation>
<code name='Split individual X12 records' xpos='200' ypos='250' >
<annotation><![CDATA[Split large X12 into individual X12 files with single ENT loop]]]]><![CDATA[></annotation>
<![CDATA[ /* Parse at TransactionSet level and extract ST ControlNuber, Total repetitions of 2300A and 2000B loops. */
 

 /* set variable values */
 
 set i = context.iterator
 set IndividualENTRecord = ""
 set ENTIterator = "true"
 
 
 /* Setting message to X12 820 TransactionSet */
 
 set STRecord=context.individualST 
 set STRecord.DocType="HIPAA_5010:820" 
 
 /* Define ENT segment path's for both 2000A , 2000B and next iteration of 2000B loop */
 
 set cur2000Apath="loop2000A.ENT"
 set cur2000Aind=STRecord.GetSegmentIndex(cur2000Apath,.cur2000Astatus)
   
 set cur2000Bpath="loop2000B("_i_").ENT"
 set cur2000Bind=STRecord.GetSegmentIndex(cur2000Bpath,.cur2000Bstatus)
   
 set nxt2000Bpath="loop2000B("_(i+1)_").ENT"
 set nxt2000Bind=STRecord.GetSegmentIndex(nxt2000Bpath,.nxt2000Bstatus)
 
 /* Capture the closing segment(SE) of Transaction Set */
 
 set sesegment=STRecord.GetValueAt(STRecord.SegCount)   

  
 try
 {
   /* Repeat iteration until next ENT record is encountered */
   
   While(ENTIterator = "true")
   {
    
    /* Below if & elseif logic would create individual X12 records with one ENT loop. The logic iterates through the X12 segments and gathers the header information (ST - PER) into "X12HeaderRecord" variable and each ENT loop would then be appended to the Header record creating individual records */ 	
	
    if ((i'=1) && (cur2000Bstatus=1))
     { 
      
        /* Move header information to IndividualENTRecord variable before appending all segments and trailing segment SE to create individual ST-SE record with one ENT record */
	  
        set IndividualENTRecord=context.X12HeaderRecord
      
       /* Logic : if next ENT record is available, capture all segments until the next ENT record. Else capture until end of SE segment */
	   
       if (nxt2000Bstatus=1)
       { 
         for j=cur2000Bind:1:(nxt2000Bind-1)
          { 
            set IndividualENTRecord=IndividualENTRecord_"~"_STRecord.GetValueAt(j)     
          } 
          
          set ENTIterator = "false"		 
       }
       elseif (nxt2000Bstatus'="1")
       { 
         for j=cur2000Bind:1:(STRecord.SegCount-1)
         { 
           set IndividualENTRecord=IndividualENTRecord_"~"_STRecord.GetValueAt(j)     
         }
         
         set context.ENTParsing = "1"
         set ENTIterator = "false"
         	 
       }      
    }
    elseif ((i=1) && (cur2000Bstatus=1))
    { 
      
       /* Logic : This loop executes for the first iteration where the entire heareder information is captured until the first occurence of ENT loop ends. */
	  
      if (nxt2000Bstatus=1)
      { 
        for j=1:1:(nxt2000Bind-1)
        { 
          if ($L(IndividualENTRecord) > 0)
          { 
            set IndividualENTRecord=IndividualENTRecord_"~"_STRecord.GetValueAt(j)
         
            if (((cur2000Astatus=1) && (j<cur2000Aind)) || ((cur2000Astatus'=1) && (j<cur2000Bind)))
            { 
              set context.X12HeaderRecord=context.X12HeaderRecord_"~"_STRecord.GetValueAt(j)
            }			
          }
          else
          { 
            set IndividualENTRecord=STRecord.GetValueAt(j)
            set context.X12HeaderRecord=STRecord.GetValueAt(j)       
          }            
        }  
            set ENTIterator = "false"
      }
      elseif (nxt2000Bstatus'=1)
      { 
         for j=1:1:(STRecord.SegCount-1)
         { 
            set IndividualENTRecord=IndividualENTRecord_"~"_STRecord.GetValueAt(j)     
         }
         
            set context.ENTParsing = "1"
            set ENTIterator = "false"	
      }      
    }
    else
    {
        set context.ENTParsing = "1"
	set ENTIterator = "false"
        QUIT
    }
   } 
	
    /* Create output record for individual X12 with one ENT loop */
	
    set IndividualENTRecord=IndividualENTRecord_"~"_sesegment
    	
    set context.dtlInput=##class(EnsLib.EDI.X12.Document).ImportFromString(IndividualENTRecord)      
    set context.dtlInput.DocType="HIPAA_5010:820"      
      
    set context.iterator=context.iterator + 1   
    
    
   
 }
 Catch ex
 {	
    if 1=ex.%IsA("%Exception.SystemException") 
    {
      Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while splitting the file into individual Transactions. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
    }
    else 
    {  
      Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while splitting the file into individual Transactions: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
    }	 
 }
  

]]]]><![CDATA[>
</code>
<if name='check first record' condition='context.iterator=2' xpos='200' ypos='350' xend='200' yend='700' >
<annotation><![CDATA[First Record may have 2000A loop ENT which needs to be mapped separately ]]]]><![CDATA[></annotation>
<true>
<code name='Split RMR records' xpos='335' ypos='500' >
<annotation><![CDATA[Split X12 with 2000A RMR records into individual records with one RMR loop]]]]><![CDATA[></annotation>
<![CDATA[ /* Extract the count of 2300A loop repetitions and then process the same message to while loop for DTL mapping */
 

 /* Initialization of variables */
 
 set recordCount = 0
 set IndividualENTRecord2300A = ""
 set context.HeaderRecordite = 1
 do context.dtlHeader.Clear()
 
 /* Setting message to X12 820 TransactionSet */
 
 set HeaderRecord=context.dtlInput 
 set HeaderRecord.DocType="HIPAA_5010:820" 
 
 /* Get the SE segment value to be appended at the end of record */
 
 set sesegment2000A=HeaderRecord.GetValueAt(HeaderRecord.SegCount)
 
 /* Iterate through the repetition of RMR segment under 2300A loop and create individual records */
 
  try
 {
 
 /* iterate through each repetitions of the segments and generate the individual records as needed */
 
 for i=1:1:HeaderRecord.SegCount
 {
    /* Define RMR and ENT segment path's for 2300A and 2000B loop */ 

     set cur2300Apath="loop2000A.loop2300A("_i_").RMR"
     set cur2300Aind=HeaderRecord.GetSegmentIndex(cur2300Apath,.cur2300Astatus)
   
     set nxt2300Apath="loop2000A.loop2300A("_(i+1)_").RMR"
     set nxt2300Aind=HeaderRecord.GetSegmentIndex(nxt2300Apath,.nxt2300Astatus)
	 
     set cur2000Bpath="loop2000B(1).ENT"
     set cur2000Bind=HeaderRecord.GetSegmentIndex(cur2000Bpath,.cur2000Bstatus)
    

    /* Below if & elseif logic would create individual X12 records with one RMR loop. The logic iterates through the X12 segments and gathers the header information (ST - ENT) into "headerIndividualENTRecord2300A" variable and each RMR loop would then be appended to the Header record creating individual records. Finally SE segment would be appended at the end */ 	
 
    if ((i'=1) && (cur2300Astatus=1))
    {       
      /* Move header information to IndividualENTRecord2300A variable before appending all segments and trailing segment SE to create individual ST-SE record with one RMR record */
      
	  set IndividualENTRecord2300A=headerIndividualENTRecord2300A
	  
	  /* Logic : if next ENT record is available, capture all segments until the next ENT record. Else capture until end of SE segment */
      
      if (nxt2300Astatus=1)
       { 
          for j=cur2300Aind:1:(nxt2300Aind-1)
          { 
            set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_HeaderRecord.GetValueAt(j)     
          }  

          set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_sesegment2000A 		  
       }
       elseif (nxt2300Astatus'=1)
       { 
         for j=cur2300Aind:1:(cur2000Bind-1)
         { 
           set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_HeaderRecord.GetValueAt(j)     
         } 

         set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_sesegment2000A   
		 
       }        
    }
    elseif ((i=1) && (cur2300Astatus=1))
    { 
      /* Logic : This loop executes for the first iteration where the entire heareder information is captured until the first occurence of ENT loop ends. */
	  
   if (nxt2300Astatus=1)
      { 
        for j=1:1:(nxt2300Aind-1)
        {           
         if ($L(IndividualENTRecord2300A) > 0)
          { 
            set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_HeaderRecord.GetValueAt(j)
         
            if ((cur2300Astatus=1) && (j<cur2300Aind))
            { 
              set headerIndividualENTRecord2300A=headerIndividualENTRecord2300A_"~"_HeaderRecord.GetValueAt(j)
            }
          }
          else
          { 
            set IndividualENTRecord2300A=HeaderRecord.GetValueAt(j)
            set headerIndividualENTRecord2300A=HeaderRecord.GetValueAt(j)       
          }		  
        }  

        set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_sesegment2000A      
        
      }
      elseif (nxt2300Astatus'="1")
      { 
         for j=1:1:(cur2000Bind-1)
         { 
            set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_HeaderRecord.GetValueAt(j)     
         }
		 
	     set IndividualENTRecord2300A=IndividualENTRecord2300A_"~"_sesegment2000A            
	    
      }       
    }
    else
    {       
       QUIT       
    }
	
  /* Create output record for individual X12 with one RMR loop */
  
  set outputRecord=##class(EnsLib.EDI.X12.Document).ImportFromString(IndividualENTRecord2300A) 
  set outputRecord.DocType="HIPAA_5010:820"
  
  /* Place the generated output record in a list variable */
  
  set recordCount=recordCount + 1
  do context.dtlHeader.SetAt(outputRecord,recordCount) 

  /* Reset the variables */  
  
  set IndividualENTRecord2300A = ""
  
  }
  }
 Catch ex
 {	
    if 1=ex.%IsA("%Exception.SystemException") 
    {
      Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while splitting the header record into individual Transactions. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
    }
    else 
    {  
      Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while splitting the header record into individual Transactions: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
    }	 
 }

 /* Set total number for individual 2000A RMR records created */
 set context.HeaderRecordCount = recordCount 
 

  

  
]]]]><![CDATA[>
