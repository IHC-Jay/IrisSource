<annotation><![CDATA[Send to output records to Target component]]]]><![CDATA[></annotation>
<code name='create response stream' xpos='200' ypos='250' >
<annotation><![CDATA[Pull output records from temporary location and send records to target component]]]]><![CDATA[></annotation>
<![CDATA[ /* Iterate through OutputFiles array and read temporary files to be delivered to target configuration */
 
 /* Increment iterator count*/
 set context.outputFileIterator  = context.outputFileIterator+1
 
 /* Generate target filename */
 set filename = context.OutputFiles.GetAt(context.outputFileIterator)
 set outputfilename = $E(filename, 6, $L(filename))
 
 /* Reset variables */  
 set response = ""

 try
 { 
  
  /* Read file from temporary location and process it to target configuration */
  
  
   if ((##class(%File).Exists(filename)))
   {  
      set stream=##class(%Stream.FileCharacter).%New()
      set stm = ##class(%GlobalCharacterStream).%New()
      
      set sc=stream.LinkToFile(filename)
      
      While 'stream.AtEnd 
      {
  
        set line=stream.Read()
        
  
        if ($L(line) > 0)
        {
           do stm.Write(line)              
        }    
      }
      
      /* close the stream */  
      set stream = "" 
      
      
      $$$TRACE("Send file: " _ filename)
      set reqObj = ##class(Ens.StreamContainer).%New(stm)
      set reqObj.OriginalFilename = outputfilename 
      
  
      
      set tStatus = process.SendRequestAsync(context.updatedFileTargetConfigName,reqObj,.res)
     
      $$$TRACE(context.outputFileIterator _ ". SendRequestAsync complete: " _ tStatus)  
	 
	  
      If $$$ISERR(tStatus) 
      {
         set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while delivering output file to target config for file : "_ filename)
      }
      else
      {
         /* Deleting the temporary file created */
         
         set dstatus = ##class(%File).Delete(filename)
      }
    }
    else
    {
      set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while reading temporary file from temporary  : "_ filename)
    }
 }
 Catch ex
 {	
    if 1=ex.%IsA("%Exception.SystemException") 
    {
      
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while reading and reporting output file to target configuration. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
    }
    else 
    {  
      set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while reading and reporting output file to target configuration: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
    }	
    
    
 }
 
 
]]]]><![CDATA[>
