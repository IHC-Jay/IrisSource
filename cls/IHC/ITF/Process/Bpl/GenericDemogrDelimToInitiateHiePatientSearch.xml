<code name='CallWebServiceAccessTokenFromPing' xpos='470' ypos='2350' >
<![CDATA[ 
  $$$TRACE(" Target Operation to get AccessToken from Ping service " _ context.accessTokenTargetConfigName)   
   set httpRequestObj=##class(EnsLib.HTTP.GenericMessage).%New()   
   set status =  process.SendRequestSync(context.accessTokenTargetConfigName,httpRequestObj,.accessTokenResponse)
   if ($$$ISOK(status)){
      $$$TRACE("AcsessToken Operation status - OK")
      set context.restAccessTokenHttpResponse=accessTokenResponse      
      Set tcharStream = ##class(%GlobalCharacterStream).%New()
      Set tStatus = tcharStream.CopyFrom(context.restAccessTokenHttpResponse.Stream)
      set text=""
      While 'tcharStream.AtEnd {
        Set text = text_tcharStream.Read($$$MaxStringLength)
      } 
      set context.accessToken = text
      $$$TRACE("Accss Token from Ping Service: "_context.accessToken)
      if (context.accessToken=""){
	      $$$TRACE(" Access Token is blank/empty")
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," No Access Token from ping service. ") 
	  }      
    }
    else {
	    $$$TRACE("Calling Ping Service to get the Access Token failed!!!")
       set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Calling Ping Service to get the Access Token failed!!!") 
    }
   ]]]]><![CDATA[>
</code>


<code name='callPatientSearchService' xpos='1010' ypos='3150' >
<![CDATA[  

       
      set context.statusValue = ""
      $$$TRACE("Calling Patient search service(1111) to get IHC CMRN#..") 
      set operType = "SEARCH"
      set tarConfigName = context.targetList.GetAt(1)
      
      set streamRequest=##class(Ens.StringContainer).%New()
      set streamRequest.StringValue= context.demogrParams
     
      $$$TRACE(" Target Operation: " _ tarConfigName) 
      set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.HiePatientService).%New() 
      set httpPingServiceRequestObj.accessToken = context.accessToken
      set httpPingServiceRequestObj.operationType = operType  
      set httpPingServiceRequestObj.identifier = ""
      set httpPingServiceRequestObj.streamObject = streamRequest
      
      $$$TRACE(" Calling Patient Service "_operType_" - BEGIN ")
      set status = process.SendRequestSync(tarConfigName,httpPingServiceRequestObj,.patientServiceResponse)
      $$$TRACE(" Calling Patient Service "_operType_" - END ")
      
      $$$TRACE("  Patient Service: "_status)
      if (status=$$$OK){
	    $$$TRACE("Call Hie Patient Service "_operType_" Operation OK status.")      
        set patServiceResponseData=patientServiceResponse.Stream  
        set statusCode = patientServiceResponse.Attributes.GetAt("StatusCode")       
        set stream =   patServiceResponseData
       	set respData = ""
       	While 'stream.AtEnd { 
       		set respData = respData _ stream.ReadLine(,.sc,.eol)       		
       	}
        $$$TRACE(" httpStatusCode(11): "_statusCode) 
        
        if (statusCode'="200"){
	    	if (statusCode="401"){
		   		$$$TRACE("  CheckError... ")
		   		set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid access token. Response: ["_respData_"]. Retrying...") 
		   	}elseif (statusCode="400"){
		    	$$$TRACE("  In Status Code 400... ")
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respData)
		    }elseif(statusCode="500"){
			    $$$TRACE("  In Status Code 500... ")
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respData)
		    }else{
		    	$$$TRACE("  DisableMsgError.... ")
        		set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Response from Patient Service Post Operation: "_respData) 
		    }
		} else {
        		$$$TRACE("PatientService call status 200 OK !!! ")
        		Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName) 
        		
        		set respJSONstring = respData          		
          		
          		set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respJSONstring) 
          		set statusVal = consumedJSONobj.%Get("status")  
          		$$$TRACE("  statusVal: "_statusVal)     
      			if (statusVal="SUCCESS"){ 
      				set mrn = ((consumedJSONobj.%Get("data")).%Get("mrn"))
      				
      				//set patientsArr = consumedJSONobj.%Get("data")
      				
      				//$$$TRACE(" patientsArr: "_patientsArr) 
        	        //set mrn = patientsArr.%Get(0).%Get("mrn")
        	        $$$TRACE(" CMRN#: "_mrn)
        	        
				 set tRequest = ##class(Ens.StreamContainer).%New("")	 
		 		 set tStream = ##class(%Stream.GlobalCharacter).%New("")	 
	 			 do tStream.Write(request.ID_"|"_mrn_$CHAR(10))	 
	 			 set tRequest.Stream = tStream
 	 			 set tStatus = process.SendRequestSync(context.cmrnTargetConfigName,tRequest)
 	 			 if ('tStatus) {
      	 			set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected error while writing the record to a file system. "_$SYSTEM.Status.GetOneErrorText(tStatus))
      	 		 }
 	  			}elseif(statusVal="NO_MATCH"){
	 	  			set context.statusValue = "YES"
	 	  			/*
       				set lastNameUpd = $ZCVT($ZSTRIP(request.LastName,"<=>"," "),"O","URL")
                    set firstNameUpd = $ZCVT($ZSTRIP(request.FirstName,"<=>"," "),"O","URL")
                    set midNameUpd = $ZCVT($ZSTRIP(request.MiddleName,"<=>"," "),"O","URL")
                     */
                    set lastNameUpd = $ZCVT(request.LastName,"O","URL")
                    set firstNameUpd = $ZCVT(request.FirstName,"O","URL")
                    set midNameUpd = $ZCVT(request.MiddleName,"O","URL")
                    
	 	  			set context.demogrParams = "givenName="_firstNameUpd_"&familyName="_lastNameUpd_"&middleName="_midNameUpd_"&dob="_request.BirthDate_"&gender="_request.Gender_"&zip="_request.Zip_"&phone="_$ZSTRIP(request.Phone,"*P")_"&ssn="_request.SSN_"&fetchMultiple=true&rows=3"
	 	  		}          		                
		}   
      }
    
    
   ]]]]><![CDATA[>
</code>

