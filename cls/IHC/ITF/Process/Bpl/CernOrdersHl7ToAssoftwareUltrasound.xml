     $$$TRACE("Hdd Request OBR4-1 Code is " _obr4)     		
 }
 
 
 set orc1OrderControl = request.GetValueAt("ORCgrp(1).ORC:OrderControl")  	
 if (orc1OrderControl '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , orc1OrderControl, context.hddContextOrderControl, "ORC1:OrderControl")  	  	
