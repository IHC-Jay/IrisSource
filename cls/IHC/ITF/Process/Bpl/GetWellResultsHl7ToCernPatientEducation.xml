<code name='Get OBX3  Ncid FROM REP' xpos='200' ypos='1150' >
<annotation><![CDATA[Get OBX3  Ncid FROM REP]]]]><![CDATA[></annotation>
<![CDATA[ set k1=""
 for {	
 
    set k1 = request.GetNextIndex("OBXgrp()",k1,.tSCOBX)  quit:k1=""	 		 
     set obx3ObservationId = 
    request.GetValueAt("OBXgrp("_(k1)_").OBX:ObservationIdentifier.identifier")
    
     set context.obx3ObservationId = obx3ObservationId
     
     
     if (obx3ObservationId '= "") {
  	 set obx3ObservationId  =
  	      ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(obx3ObservationId,context.hddGetWellResultsDomain,context.hddGetWellContext,context.hddTargetConfigName,.process)
     
    if ((obx3ObservationId ["ITFCOMMON:10109") || (obx3ObservationId ["Web service returned(error):")){  
     
     
       set status =##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "There was a problem with either the data used for the GetWell Patient Education NcidFromRep lookup for OBX-3(using domain: "_context.hddGetWellResultsDomain_" and rep: "_context.obx3ObservationId_" and context: "_context.hddGetWellContext_") or the lookup returned an error, shutting down. Error returned: "_obx3ObservationId_". If blank after error returned then it is a domain/data issue.")  
     
     
     
     
     
      }else {
               do context.obx3ObservationIdList.InsertAt(obx3ObservationId,k1)
	
     }
     
     
             
    
    
    }     
 
     }
]]]]><![CDATA[>
