<code name='Get Facility Ncid' xpos='200' ypos='950' disabled="true">
<annotation><![CDATA[Get Facility Ncid]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE(" Get Facility Ncid")      
    set msh4Facility = request.GetValueAt("MSH:SendingFacility.namespaceID") 
    set msh4FacilityNcid = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(msh4Facility,
            ,hddGetWellDomain,hddGetWellContext,        
             context.hddTargetConfigName,.process)
         if ((msh4FacilityNcid["ITFCOMMON:10109") || (msh4FacilityNcid["Web service returned(error):")){
             set status =##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "There was a problem with either the data used for the GetWell Patient Education  NcidFromRep lookup for MSH4(using domain: "_context.hddDomainFac_" and rep: "_msh4Facility_" and context: "_context.hddContextInterface_") or the lookup returned an error, shutting down. Error returned: "_msh4FacilityNcid_". If blank after error returned then it is a domain/data issue.")
          }else {
             set context.FacilityNcid = msh4FacilityNcid
         }]]]]><![CDATA[>
</code>
<code name='Get OBR4 Ncid' xpos='200' ypos='1050' >
