<![CDATA[ $$$TRACE(" Get OBR4 Ncid")      
 set context.obr4UniServId = request.GetValueAt("OBR:UniversalServiceID.identifier") 
 set obr4UniServId  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(context.obr4UniServId,context.hddGetWellDomain,context.hddGetWellContext,context.hddTargetConfigName,.process)

 if ((obr4UniServId ["ITFCOMMON:10109") || (obr4UniServId ["Web service returned(error):")){
    set status =##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "There was a problem with either the data used for the GetWell Patient Education NcidFromRep lookup for OBR-4.1(using domain: "_context.hddGetWellDomain_" and rep: "_context.obr4UniServId_" and context: "_context.hddGetWellContext_") or the lookup returned an error, shutting down. Error returned: "_obr4UniServId_". If blank after error returned then it is a domain/data issue.")
  }else {
      set context.obr4UniServId  = obr4UniServId 
 }]]]]><![CDATA[>
