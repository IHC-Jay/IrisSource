 $$$TRACE(" After creating Ncid Hdd lookup request object")  
 
 set i1=""
 for {
	 set i1 = request.GetNextIndex("PIDgrpgrp()",i1,.tSCPID)  quit:i1=""	 
	 
	 set pid8Sex = request.GetValueAt("PIDgrpgrp("_(i1)_").PIDgrp.PID:Sex")  	
 	 if (pid8Sex '= "") {
         Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , pid8Sex, context.hddContextSex, context.hddContextHelp, "PID8:Sex_"_i1)  	  	
     	 $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 	 }
 	 
 	 set j1=""
 	 for {	 	 

 		 
 		 set obr4UniversalSrvIdActualValue = request.GetValueAt("PIDgrpgrp("_(i1)_").ORCgrp("_(j1)_").OBR:UniversalServiceID.identifier") 
 		 
 		 set obr4UniversalSrvId = $REPLACE(obr4UniversalSrvIdActualValue,"EMMI_","")
 		 		 
 		 if (obr4UniversalSrvId '= "") {
     	 	 Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest , obr4UniversalSrvId, context.hddGetWellDomain, context.hddGetWellContext, "OBR41:UniversalServiceID_"_(i1)_"_"_j1)  	  	
     		 $$$TRACE("Hdd Request OBR-4 UniversalServiceId is " _ obr4UniversalSrvId)     		
 		 } 
 		 
 		 
 		 
 		 set k1=""
 		 
	 }
 }
 $$$TRACE(" After setting all NCID values")  
