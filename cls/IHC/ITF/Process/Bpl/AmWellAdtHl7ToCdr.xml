<code name='CallHl7MmiAdd' xpos='470' ypos='1400' >
<![CDATA[  
 // Call MMI Add - Tuxedo Operation, Build the request   
   set mmiAddRequest=##class(IHC.ITF.ITFCOMMON.Request.Hl7AddUpdateMmiStructure).%New()
   set mmiAddRequest.hl7Msg = responseEmpi   
   $$$TRACE(" Target Operation MmiHl7Add: " _ process.TargetOperationMmiHl7Add)
   set tStatus=process.SendRequestSync(process.TargetOperationMmiHl7Add,mmiAddRequest,.cdrResponse)
   if (tStatus = $$$OK){
	  $$$TRACE("RESPONSE: " _ cdrResponse.StringValue)   
	  set indexMSA = $F(cdrResponse.StringValue, "MSA|AA")    	  
   	  if (indexMSA > 0){
		$$$TRACE("SUCCESS!!!..Ack received from MMIAddUpdate. "_cdrResponse.StringValue) 
		set indexZEX = $F(cdrResponse.StringValue, "ZEX|")
		if (indexZEX > 0){	    			 
			 set patEmpi = $LISTGET($LISTFROMSTRING(cdrResponse.StringValue,"|"),*)	 
			 set context.PatientEmpi =$TRANSLATE(patEmpi,$C(13),"")  			
			 $$$TRACE(" empiNum: [" _context.PatientEmpi_"]")
			 set context.isIhcMrnExists = "Y"	    						 
		}
   	  }else{	   		  
	     $$$TRACE(" NACK received from MMIAddUpdate. "_cdrResponse.StringValue)  	  
	     set indexZEX = $F(cdrResponse.StringValue, "ZEX|")
		if (indexZEX > 0){	   
		     $$$TRACE(" NACK received from MMIAddUpdate. But Cdr MMI allocated. "_cdrResponse.StringValue)  	   			 
			 set patEmpi = $LISTGET($LISTFROMSTRING(cdrResponse.StringValue,"|"),*)	 
			 set context.PatientEmpi =$TRANSLATE(patEmpi,$C(13),"")  			
			 $$$TRACE(" empiNum: [" _context.PatientEmpi_"]")
			 set context.isIhcMrnExists = "Y"	    						 
		}else{
			$$$TRACE("FAILED!!!..NACK received from MMIAddUpdate. "_cdrResponse.StringValue)  	   			 
	     	set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, " NACK Response from CDR. Failed to update the CDR. Invalid Data. Please check Tuxedo logs table for the details. Response: "_cdrResponse.StringValue)
		}
	  } 	   	  	
   }else{
	    set errText = $SYSTEM.Status.GetOneErrorText(tStatus)
	    if errText["CONNECTIONERROR"{
		   //set status=$$$ERROR("ITFCOMMON:10107",$SYSTEM.Status.GetOneErrorText(tStatus))      //Retry max times and disable
		   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),errText)
	    }	    
	    if errText["RESEND"{
		   //set status=$$$ERROR("AMWELL:12",$SYSTEM.Status.GetOneErrorText(tStatus))      //Retry max times and disable
		   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError($CLASSNAME(),errText)
	    }
	    if errText["DATAERROR"{
		   //set status=$$$ERROR("AMWELL:13",$SYSTEM.Status.GetOneErrorText(tStatus))      //Disable
		   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),errText)
	    }
	    if errText["SHUTDOWN"{
		   //set status=$$$ERROR("AMWELL:14",$SYSTEM.Status.GetOneErrorText(tStatus))      //Disable
		   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),errText)
	    } 	       
   } 
 ]]]]><![CDATA[>
</code>


