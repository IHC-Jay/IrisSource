 }
 
 $$$TRACE("Setting target")
 set targetStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.BPL.CernAdtToSafeTraceBb.Lookup.FacilityToServer", context.newFacId, .retVal )
 if ($$$ISERR(targetStat) || (retVal = "Unknown") || (retVal ="")) {       
