<![CDATA[ set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"EnterpriseLoopLocations",.LoopLocations) 
 $$$TRACE("Value of Loop Locations="_LoopLocations)
 set length = $L(LoopLocations, ",")
 $$$TRACE("Length of Loop Locations=" _length)
 if ($$$ISOK(pstatus)&&(LoopLocations'=""))
 {
    For iTarget=1:1:$L(LoopLocations, ",") 
        { 
            Set tOneTarget=$ZStrip($P(LoopLocations,",",iTarget),"<>W")  
            Continue:""=tOneTarget
            
            set stat = context.targetList.Insert(tOneTarget)
            $$$TRACE("tOneTarget " _ tOneTarget _ " " _ stat)
         }
          $$$TRACE("targetList count " _ context.targetList.Count())
 }else{
	 $$$TRACE("Config setting for EnterpriseLoopLocations not Available")
	 set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Initialization error, No configuration for EnterpriseLoopLocations found")
	 }]]]]><![CDATA[>
