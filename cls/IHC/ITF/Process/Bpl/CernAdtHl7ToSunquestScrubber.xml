<![CDATA[ set zzz18 = request.GetValueAt("ZZZ(2):18VisitRoomType")
 $$$TRACE("PV1.20 value from cerner which comes in ZZZ18 is :"_zzz18)
 if (zzz18  = "526051371") 
 {
   $$$TRACE("Skipping Insurance Filter Step")
   set context.FilterInsurance = 0
 }
 else
 { 
   $$$TRACE("Proceeding with Insurance Filter Step")
   set InsuranceNames=""
   set In122= request.GetValueAt("IN1grp(1).IN1:InsurancePlanID.text")
   set In122= $ZCONVERT(In122,"U")
   $$$TRACE("In122 value ="_In122)
 
   set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToSunquestScrubber.Lookup.InsuranceFilter",1,.InsuranceNames)
   $$$TRACE("Insurance names present in lookup table ="_InsuranceNames)
 
   if ($$$ISOK(pstatus)&&(InsuranceNames'=""))
   {
      set ListIns=$LISTFROMSTRING(InsuranceNames,",")
   
      set ptr=0
   
      WHILE $LISTNEXT(ListIns,ptr,value) 
      {
        set value = $ZCONVERT(value,"U")
        $$$TRACE("Insurance name from lookup Table ="_value)
      
        if ( In122 = value )
        {
       
         set context.FilterInsurance = 0
         $$$TRACE("Insurance name matched")

        }
      
      }
   
   }
 
 }
  $$$TRACE("context.FilterInsurance ="_context.FilterInsurance)]]]]><![CDATA[>
