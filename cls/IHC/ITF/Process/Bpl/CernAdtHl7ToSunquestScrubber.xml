<code name='StoreOldLocationToCacheTable' xpos='1550' ypos='2000' >
<![CDATA[ Set FinNo =  request.GetValueAt("PID:PatientAccountNumber")
 Set OriginalLocation = request.GetValueAt("PV1:AssignedPatientLocation.room")
 
 set OriginalFullPv13 = request.GetValueAt("PV1:AssignedPatientLocation")
 
 Set EmpiNo = request.GetValueAt("PID:PatientIdentifierList(1).ID")
 $$$TRACE("EmpiNo : "_EmpiNo)
 $$$TRACE("OriginalFullPv13 : "_OriginalFullPv13)
 
 $$$TRACE("Outofnetwork value is 1")
 if ( FinNo = "" ) || ( OriginalLocation = "" )
 {
	$$$TRACE("Fin Number or Location is empty. Doing nothing")
 }
 else
 {
	 set isExists = ##class(IHC.ITF.Operation.OriginalPatientLocation).%ExistsId(FinNo)
	 
	 if 'isExists 
	 {
		 $$$TRACE("value does not exist")
		 set LocationObj =  ##class(IHC.ITF.Operation.OriginalPatientLocation).%New()
		 
		 set LocationObj.FinNumber = FinNo
		 set LocationObj.EMPI = EmpiNo
		 set LocationObj.Location = OriginalLocation
		 set LocationObj.PV13Full = OriginalFullPv13
		 
		 set clock=$NOW()  //Get current Date
		 set LocationObj.DateTime = $ZDATETIME(clock,1,1,2)
		 Do LocationObj.%Save()
	 
	 }
	 else
	 {
		 $$$TRACE("value exist")
		 set LocationObj =  ##class(IHC.ITF.Operation.OriginalPatientLocation).%OpenId(FinNo)
		 $$$TRACE("Location from Table :"_LocationObj.Location)
		 
		 if LocationObj.Location '= OriginalLocation
		 {
			set LocationObj.Location = OriginalLocation
			set LocationObj.PV13Full = OriginalFullPv13
		 	set clock=$NOW()  //Get current Date
		 	set LocationObj.DateTime = $ZDATETIME(clock,1,1,2)
		 	$$$TRACE("Timestamp from Table :"_LocationObj.DateTime)
		 	Do LocationObj.%Save()
		 }
		 else
		 {
			$$$TRACE("No table update needed as Location did not change")	 
		 }
		 
		 
	 }
	 set context.clone = request.%ConstructClone()
	 Do context.clone.SetValueAt("QARUPC", "PV1:AssignedPatientLocation.room")
	 Do context.clone.SetValueAt("", "PV1:AssignedPatientLocation.pointofcare")
	 Do context.clone.SetValueAt("", "PV1:AssignedPatientLocation.bed")
	 Do context.clone.%Save()
	 
	
 }]]]]><![CDATA[>
