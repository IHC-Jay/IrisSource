<code name='CallPatientServiceUpdate' xpos='740' ypos='1850' >
<![CDATA[ 
     $$$TRACE(" IHC mrn# exists " _ context.ihcEmpiNum) 
     $$$TRACE(" Target Operation to Patient service " _ context.patientServiceTargetConfigName) 
     set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.httpsRequestForPingService).%New() 
     set httpPingServiceRequestObj.accessToken = context.accessToken
     set httpPingServiceRequestObj.operationType = "UPDATE"   
     set httpPingServiceRequestObj.identifier = context.ihcEmpiNum 
     set httpPingServiceRequestObj.streamObject = context.jsonRequest
     $$$TRACE(" Calling Patient Service - Update:BEGIN ")
     set status = process.SendRequestSync(context.patientServiceTargetConfigName,httpPingServiceRequestObj,.patientServiceUpdateResponse)
     $$$TRACE(" Calling Patient Service - Update:END ")
     if ($$$ISOK(status)){
      $$$TRACE("Call PatientService-Update Operation OK status.")      
      set context.restPatientServiceHttpResponse=patientServiceUpdateResponse  
