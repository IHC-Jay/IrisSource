<code name='validateMsgStructure' xpos='200' ypos='450' >
<annotation><![CDATA[unMarshall - Check if the message passes the message validation as set in the Validation Settings ]]]]><![CDATA[></annotation>
<![CDATA[  
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Validation",.configValue)  
  if ($$$ISOK(pstatus)){
     set context.validationSettingValue=configValue
  } 
  
 $$$TRACE("Validate Message Begins...") 
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,context.validationSettingValue) 
 if (tStatus'=$$$OK){  	
    $$$TRACE("Failed Validation Settings " _ context.validationSettingValue)
    // Skip the record.
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Hl7 message validation failed, Skipping the record." _ "Hl7 Msg:" _ request.RawContent)
 }else{
	  $$$TRACE("Passed Validation Settings: " _ context.validationSettingValue) 
 }
 
 set context.MsgCode = request.GetValueAt("MSH:MessageType.MessageCode")]]]]><![CDATA[>
</code>
<code name='initializePortalSettings' xpos='200' ypos='550' >
<annotation><![CDATA[Check/Initialize for Management Portal Settings]]]]><![CDATA[></annotation>
<![CDATA[ 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = "")) { 	
 	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),"Initialization error, No ReplyCodeActions found")
 } 
 
 set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: [" _ maxErr+"]")
 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AdtTargetConfigNames",.adtConfigValue)
 if ( ($$$ISERR(pstatus)) || (configValue = "")) { 	
 	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),"Initialization error, No Adt Target found")
 }else {
    For iTarget=1:1:$L(adtConfigValue, ",") { 
       Set tOneTarget=$ZStrip($P(adtConfigValue,",",iTarget),"<>W")  
       Continue:""=tOneTarget
       set stat = context.AdtTargetList.Insert(tOneTarget)
       $$$TRACE("tOneTarget " _ tOneTarget _ " " _ stat)
    }
 } 
 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"SiuTargetConfigNames",.siuConfigValue)
 if ( ($$$ISERR(pstatus)) || (configValue = "")) { 	
 	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),"Initialization error, No Siu Target found")
 }else {
    For iTarget=1:1:$L(siuConfigValue, ",") { 
       Set tOneTarget=$ZStrip($P(siuConfigValue,",",iTarget),"<>W")  
       Continue:""=tOneTarget
       set stat = context.SiuTargetList.Insert(tOneTarget)
       $$$TRACE("tOneTarget " _ tOneTarget _ " " _ stat)
    } 
 } 
 
 
]]]]><![CDATA[>
