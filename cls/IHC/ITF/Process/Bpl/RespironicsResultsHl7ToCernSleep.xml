<Method name="OnGetConnections">
<ClassMethod>1</ClassMethod>
<FormalSpec>*pArray:%String,item:Ens.Config.Item</FormalSpec>
<Implementation><![CDATA[
   #dim locArray As array Of %String;
   set tValue=""
   set tKey=""
   Set (tValue,tIndex)=""
   set targetOperationTable=""
   For {
	  Set tIndex = item.Settings.Next(tIndex)
      Quit:tIndex=""
      Set tSetting = item.Settings.GetAt(tIndex)
      If (tSetting.Name["LocationOperationsTable")
      {    
         if (tSetting.Value '= "")
         {
            set targetOperationTable = $ZSTRIP(tSetting.Value,"<>W")
         }
      }
      If (tSetting.Name["HddTargetConfigName")
      {    
         if (tSetting.Value '= "")
         {
            set hddOperationName = $ZSTRIP(tSetting.Value,"<>W")
         }
      }
   }
   for {
      Set tKey=$O(^Ens.LookupTable(targetOperationTable,tKey))
      quit:tKey=""
      set value = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(targetOperationTable, tKey, .retValForLines )
      if (tValue ="") {
         set tValue = retValForLines
      }else {
         set tValue = tValue_","_retValForLines
      }
   }
   if (tValue =""){
	   set tValue = hddOperationName
   }else {
	   set tValue = tValue_","_hddOperationName
   }
   For i=1:1:$L(tValue,",") {
      Set tOne=$ZSTRIP($P(tValue,",",i),"<>W")
      Continue:""=tOne
      Set pArray(tOne)=""
   }
]]></Implementation>
</Method>

<Method name="hddWork">
<ClassMethod>1</ClassMethod>
<FormalSpec>process:IHC.ITF.Process.Bpl.RespironicsResultsHl7ToCernSleep,hddTargetConfigName:%String,hddNcid:%String,hddContext:%String,hl7Detail:%String</FormalSpec>
<ReturnType>%String</ReturnType>
<Implementation><![CDATA[
	$$$TRACE("HDD work for NCID to REP starting now")
		try{
			Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getRepFromNcid(hddNcid, hl7Detail, hddContext, hddTargetConfigName, process, .hddreturnrep) 
			$$$TRACE("hddreturnrep length: **"_$LENGTH(hddreturnrep)_"**")
			if ((hddreturnrep '= "") && ($LENGTH(hddreturnrep)>0)){
				$$$TRACE("Created HDD Request and got response back for " _hl7Detail_ " NCID: " _hddNcid_ ", HDD Context: " _hddContext )
				$$$TRACE("Returned representation received from HDD: " _hddreturnrep)
			}else{
				$$$TRACE("Unexpected HDD Return - no value or null value returned from HDD Call! HDD did not return a representation for this HDD NCIDtoRep lookup: ["_hl7Detail_ "]. For NCID: ["_hddNcid _"].  Using HDD Context: [" _hddContext _"]. Using HddTargetConfigName: [" _hddTargetConfigName_"].")
				set hddreturnrep="NORETRUNREP--Zero length rep returned or rep returned was empty string!"
			}
		
		}Catch (eException) {
			//$ZSTRIP(string,action)
			//*	Strip all characters that match the mask code(s).
			//C	Strip control characters (0-31, 127-159).
			Set errorData = $ZSTRIP(eException.Data,"*C")
			$$$TRACE("Exception Error Status Data: "_errorData)
			$$$TRACE("There was an ERROR returned instead of an HDD Response.  HDD NCIDtoRep lookup: -->"_hl7Detail_ "<--. For NCID: -->"_hddNcid _"<--. Using HDD Context: -->"_hddContext_"<--.  Using HddTargetConfigName: -->"_hddTargetConfigName_"<--.")
			if (eException.Code["ITFCOMMON:10108"){
			   // InutDataError - one of the input parameters from source is blank.
			   set hddreturnrep ="ERROR--One or more of the input parameters for HDD call is missing!"
			}elseif( eException.Code["ITFCOMMON:10109"){
			   set hddreturnrep="NOREPFOUND--No HDD Return Rep Found in NCIDtoREP lookup!"
			}elseif( eException.Code["ITFCOMMON:10106"){
			   set hddreturnrep="ERROR--Retry Error calling HDD call!"
			}else{ 
			   set hddreturnrep="ERROR--Unkown error occurred calling HDD!"
			}
	
		}
		return hddreturnrep
]]></Implementation>
</Method>

