<code name='Get ReportDate from CDR Drc Table' xpos='200' ypos='950' >
<annotation><![CDATA[Get MMIEvents table from drc.DRC_DUPLICATE]]]]><![CDATA[></annotation>
<![CDATA[ 
   $$$TRACE("Getting ReportDate from drc.DRC_DUPLICATE table... ")
   set tStatus=process.SendRequestSync(context.cdrReportDateTargetConfigName,request,.opCdrGetReportDateResponse)
 if ('tStatus) {
	 $$$TRACE("Unknown error. Unable to get report date from drc.DRC_DUPLICATE tables .. ")
     set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Unexpected CDR DSQL response returned or CDR DSQL call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))     
 } else { 
   set context.opCdrGetReportDateResponse= opCdrGetReportDateResponse
   $$$TRACE(" Received ReportDate from DRC tables. ReportDate: ["_context.opCdrGetReportDateResponse.reportDate_"]")
 }
  kill tStatus
]]]]><![CDATA[>
</code>

<if name='hasLastRunCdrReportDate' condition='($length(context.opCdrGetReportDateResponse.reportDate) &gt; 0)' xpos='200' ypos='850' xend='200' yend='5750' >
<true>
  <code name='Get Initiate Context' xpos='200' ypos='950' >
<annotation><![CDATA[Get MMIEvents table from drc.DRC_DUPLICATE]]]]><![CDATA[></annotation>
<![CDATA[ 
   $$$TRACE("Getting Initiate context... ")
   // Call Tuxedo code - Build the request      
   set reqObj=##class(Ens.StringRequest).%New()
   set reqObj.StringValue = context.opCdrGetReportDateResponse.reportDate 
   
    set tStatus=process.SendRequestSync(context.cdrTaskSearchTargetConfigName,reqObj,.opCdrInitiateContextResponse)
 	if ('tStatus) {
		 $$$TRACE("Unknown error. Unable to get Initiate context .. ")
     	set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Unexpected CDR DSQL response returned or CDR DSQL call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))     
 	} else {  	
 		set respMsg = opCdrInitiateContextResponse.Stream.Read()
	    $$$TRACE("OpCdrAndInitiateDemogrDrcDuplicates (Response): <" _ respMsg _ ">")
	    	  
 		$$$TRACE(" RESPONSE: ["_respMsg_"]")
 		if ($L(respMsg)>0){
 			$$$TRACE(" Got Error Response!!!! ")
 			$$$TRACE(" RESPONSE: ["_respMsg_"]")
 			set tStatus=process.SendRequestSync(context.notifyTargetConfigName,opCdrInitiateContextResponse,.opNotifyRespMsg)
 	        $$$TRACE(" Status of Sending Email Notification: ["_tStatus_"]")
 	        if ('tStatus) {
		       $$$TRACE("Unknown error. Unable to Send Email Notification .. ")
     	       set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Email Notification failed!!! "_$SYSTEM.Status.GetOneErrorText(tStatus))     
 	        }
 			if respMsg["10106"{
	 			Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,respMsg)
	 		}
	 		if respMsg["ENOREC"{
	 			Set status = ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName,respMsg)
	 		}	 		
	 		
 		}else{
	 		$$$TRACE(" Got Success Response!!!! ")
	 	}
 	}
  kill tStatus
]]]]><![CDATA[>
