<code name='Text extract' xpos='200' ypos='250' >
<annotation><![CDATA[Call OpWssPdfClient]]]]><![CDATA[></annotation>
<![CDATA[  
 set xhtmlStr = context.obx5List.GetAt(context.targetConfigIndex)
 set htmlStr = $SYSTEM.Encryption.Base64Decode(xhtmlStr)
 $$$TRACE("HTML Doc: (#"_context.targetConfigIndex_") "_htmlStr)

 Set tcharStream = ##class(%GlobalCharacterStream).%New()
 do tcharStream.Write(htmlStr)
 Set tStatus = tcharStream.Rewind()
 set context.htmlOut = ##class(Ens.StreamContainer).%New(tcharStream)
  
 set textStr=##class(%iKnow.Source.Converter.Html).StripHTML(.htmlStr,1,"title,meta,head,script,style", 0, .tSc)
 
 if ('tSc) {  
   set status=$$$ERROR("ITFCOMMON:10108",$SYSTEM.Status.GetOneErrorText("Extract text from xhtml is failed. "_$SYSTEM.Status.GetOneErrorText(tSc)))    
 } else { 
   Set newStr = ""
   SET countdown=$LENGTH(textStr,$CHAR(10))
   SET countup=1
   FOR reps=countdown:-1:1 {
      SET extract=$PIECE(textStr,$CHAR(10),countup)
      set extract=$ZSTRIP(extract,"<>CW")
      if $l(extract)>0 {
        if newStr ="" {
          set newStr = extract
        }
        else {
          set tStr =$ZSTRIP(extract,">", ":") 
          if $L(extract)>$L(tStr) {
            set newStr = newStr _"\.br\\.br\"_extract
          }
          else {
            set newStr = newStr _"\.br\"_extract
          }
        }
      }
      SET countup=countup+1
   }
   ///set extract=$ZSTRIP(extract,"<","\.br\")
   $$$TRACE("NEW TEXT Doc: "_newStr)
   do context.obx5List.SetAt(newStr, context.targetConfigIndex)    
 }
]]]]><![CDATA[>
