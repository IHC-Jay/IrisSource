<code name='Validate OBX Segment' xpos='200' ypos='1750' >
<annotation><![CDATA[OBX2 should present, OBX-5 should have Base64Header]]]]><![CDATA[></annotation>
<![CDATA[ 
 set i1=""
 set j1="" 
 for {
 	set i1 = request.GetNextIndex("OBXgrp()",i1,.iSC) quit:i1="" 	
 	set obx2Value = request.GetValueAt("OBXgrp("_(i1)_").OBX:ValueType")
 	if (obx2Value = ""){
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "OBX-2 value not exist, skip msg.")
       quit
  	} 	
 	
 	set obx5Value = "" 	
 	for {	 	
	 	set j1 = request.GetNextIndex("OBXgrp("_(i1)_").OBX:ObservationValue()",j1,.jSC) quit:j1="" 	 				    
 		set obx5 = request.GetValueAt("OBXgrp("_(i1)_").OBX:ObservationValue("_(j1)_")") 									   
 		
 		if (obx5 = ""){
       		set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "OBX-5 value not exist, skip msg.")       
       		quit
 		} 		
 		if (context.base64Header '= $EXTRACT(obx5, 1, ($LENGTH(context.base64Header)))) {
	   		set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "OBX-5 doesn't have Base64Header, skip msg.")
	   		quit
    	}  	  		
  		set obx5Value  = obx5Value _ $EXTRACT(obx5, ($LENGTH(context.base64Header)+1), $LENGTH(obx5))  	
 	}    
 	if ($LENGTH(obx5Value)#4 '= 0){
		set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "OBX-5 Errors with Base64 format: Base64 Message Length error "_$LENGTH(obx5Value)#4_", skip msg.")
		quit
 	}
 	do context.obx5List.Insert(obx5Value)
 }
