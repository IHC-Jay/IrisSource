<code name='Fetch PCP details' xpos='200' ypos='3050' >
<![CDATA[   
   set txa5 = request.GetValueAt("TXA:PrimaryActivityProviderCodeN(1).IDnumberST")
   $$$TRACE("source PCP Id value  : "_txa5)
   
   if txa5 = ""
   {
   
   $$$TRACE("Source PCP ID is empty so need to call service to get PCP ID")
   
   set mrnNumber = request.GetValueAt("PID:PatientID.ID") 
   $$$TRACE("Mrn Number  : "_mrnNumber)
 
   
   Set httpObj = ##class(EnsLib.HTTP.GenericMessage).%New()
	Set tStream = ""
	Set tStream = ##class(%Stream.GlobalCharacter).%New()
	Do tStream.Write(mrnNumber)
	Do tStream.Rewind()

	Do httpObj.HTTPHeaders.SetAt("text/plain","content-type")

	
	Do httpObj.HTTPHeaders.SetAt(tStream.Size,"content-length")
	Set httpObj.Stream = ##class(%Stream.GlobalBinary).%New()
	Set tStatus = httpObj.Stream.CopyFrom(tStream)
	
	
	set status = process.SendRequestSync(context.PCPServiceTargetConfigName,httpObj,.PcpResponse)
   //$$$TRACE("Call to PCP Service complete.. ")
   
  // set respJSONstring = PcpResponse
           // set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respJSONstring)
           // set iter = consumedJSONobj.%GetIterator()
            //set statusVal = consumedJSONobj.%Get("status-details")
            //$$$TRACE(" Value of Success "_statusVal) 
            
     if ($$$ISOK(status)){
	    $$$TRACE("RESPONSE from PCP Service:-- "_PcpResponse.Stream.Read())
	    
	    Set respStream = ##class(%GlobalCharacterStream).%New()
        Set respStatus = respStream.CopyFrom(PcpResponse.Stream)
        set respText =""
        While 'respStream.AtEnd {
          Set respText = respText_respStream.Read()
        } 
        $$$TRACE("PCP service response: "_respText)
        
		 set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respText)
            set iter = consumedJSONobj.%GetIterator()
            set Repstatus = consumedJSONobj.%Get("response").%Get("service-status").%Get("status")
            $$$TRACE(" Value of response Status "_Repstatus) 
		
	    
        if Repstatus [ "SUCCESS"{
	        $$$TRACE(" Successful Response from PCP Service ")
	        // set context.PCPID = consumedJSONobj.%Get("response").%Get("status-details")
	         // $$$TRACE(" Value of PCPID  "_context.PCPID)
	         
	         set ArraySize = consumedJSONobj.%Get("response").%Get("status-details").%Size()
	         $$$TRACE(" Value of ArraySize "_ArraySize)
	         
	         if ArraySize > 0
	         { 
	         
	          set context.PCPID = consumedJSONobj.%Get("response").%Get("status-details").%Get(0).%Get("providerID")
	          $$$TRACE(" Value of PCPID  "_context.PCPID)
	         
	         set context.PCPFirstName = consumedJSONobj.%Get("response").%Get("status-details").%Get(0).%Get("firstName")
	          $$$TRACE(" Value of PCPFirstName   "_context.PCPFirstName)
	          
	          set context.PCPMiddleName = consumedJSONobj.%Get("response").%Get("status-details").%Get(0).%Get("middleName")
	          $$$TRACE(" Value of PCPMiddleName "_context.PCPMiddleName)
	          
	           set context.PCPLastName = consumedJSONobj.%Get("response").%Get("status-details").%Get(0).%Get("lastName")
	          $$$TRACE(" Value of PCPLastName "_context.PCPLastName)
	         
	        Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)
	        
	        }else{
	           $$$TRACE(" Service returned empty value due to invalid MRN number" )
	        }
	    }else{
		    if Repstatus [ "ERROR"{
			    
			$$$TRACE("No Successful Response from PCP Service. Disabling the component." )    
	                
		        }
                
                  }
    }else{
            $$$TRACE("Error calling the Patient MDM service." ) 
	    
	}  
	
 }]]]]><![CDATA[>
