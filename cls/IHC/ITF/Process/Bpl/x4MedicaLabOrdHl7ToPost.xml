 Set context.ObjORMReq.PatientGender = request.GetValueAt("PIDgrp.PID:Sex")
 Set context.ObjORMReq.PatientId = request.GetValueAt("PIDgrp.PID:PatientIDInternalID(1).PatientID")
 Set context.ObjORMReq.OrderId = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:PlacerOrderNumber.uniqueplacerid")
 Set context.ObjORMReq.TestId = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceID.identifier")
 Set context.ObjORMReq.OrderDate = request.GetValueAt("MSH:DateTimeofmessage.timeofanevent")
 Set context.ObjORMReq.PhysicianName = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:OrderingProvider.givenname")_" "_request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:OrderingProvider.familiyname")
 Set context.ObjORMReq.MessageType = "O01"
 
 Set ServicedDate = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:Observationdatetime.timeofanevent")
 
 //logic to update the serviced date, Service and IsActive flag
 
 $$$TRACE("ServicedDate "_ServicedDate)
 
 Set context.ObjORMReq.ServicedDate = ""
 If (ServicedDate'="")
 {
  Set context.ObjORMReq.ServicedDate = $Replace($Zdate($ZdateH($Extract(ServicedDate,1,8),8),2)," ","-")
  
  If (($System.SQL.DATEDIFF("dd",$ZDATE($HOROLOG,3),$Zdate($ZdateH($Extract(ServicedDate,1,8),8),3))<=0))
   {
   $$$TRACE("ServicedDate is less than or equal to current date,ServicedDate value :   "_ServicedDate )
    Set context.ObjORMReq.Serviced = "Y"
    Set context.ObjORMReq.IsActive = "N"
   }
   Else
   {
     $$$TRACE("ServicedDate is greater than current date,ServicedDate value :   "_ServicedDate )
     Set context.ObjORMReq.Serviced = "N"
     Set context.ObjORMReq.IsActive = "Y"
	     
   }	     
 }
 Else
 {
   $$$TRACE("ServicedDate is empty :   "_ServicedDate )
