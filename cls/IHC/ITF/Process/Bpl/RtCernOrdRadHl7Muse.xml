<code name='Prep IsMemberObject For Ncid' xpos='200' ypos='950' >
<annotation><![CDATA[Prepare IsMemberObject req values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Prepare for IsMemberObject Hdd request lookup call")  	
 set context.hddIsMemberRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateIsMemberObject()
 
  set context.ordNcid= request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:4.1")  
  if (context.ordNcid '= "" && $ISVALIDNUM(context.ordNcid)= "1"){	
    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddIsMemberObject(context.hddIsMemberRequest , context.iCentraCardiologyOrdDomain, context.ordNcid, "isIcentraCardiologyOrd")	  	
    $$$TRACE("Hdd isMember Request for (OBR-4.1): " _ context.ordNcid)     		
 } else {
   // Skip message if PV1-3.4 is empty
   set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "OBR-4.1 Universal Service ID is empty or Non-Numerical. Skipping the record.")	 
 }
 ]]]]><![CDATA[>
