<![CDATA[ set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddIsMemberResponse, "isIcentraCardiologyOrd")
 if (hddObj '= ""){
    set context.isIcentraCardOrd = hddObj.Rep
    $$$TRACE("Value of 'isIcentraCardOrd' from Hdd lookup: " _ context.isIcentraCardOrd)
 }]]]]><![CDATA[>
