<code name='Get JMS properties' xpos='200' ypos='650' >
<![CDATA[ $$$TRACE("# of Properties: " _ request.Properties.Count())
 set context.transTrackDateTimeStamp = request.Properties.GetAt("RemitTransTrackDateTimeStamp")
 if ($L(context.transTrackDateTimeStamp) > 0)
 {
     $$$TRACE("Found RemitTransTrackDateTimeStamp")
      
 }
 set context.transTrackDateTimeStamp = $REPLACE(context.transTrackDateTimeStamp,"]", "")
 
 // <PropertiesItem PropertiesKey="obConnection">UMRBatch</PropertiesItem>
 set context.obConnection = request.Properties.GetAt("obConnection")
 ]]]]><![CDATA[>
</code>
<if name='TrackDateTimeStamp is valid' condition='($L(context.transTrackDateTimeStamp) &gt; 0) ' xpos='200' ypos='750' xend='200' yend='1100' >
