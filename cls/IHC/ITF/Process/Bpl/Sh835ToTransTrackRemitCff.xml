<code name='Get TRN 02 or 04 and call the operation' xpos='470' ypos='900' >
<![CDATA[ set ediDoc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.Message, .pStat )
 if (pStat '= $$$OK){  	
  $$$TRACE("Failed to create X12 message from Stream" _ pStat)
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "X12 message validation failed, Skipping the record." _ request.RawContent)
 }
 set ediDoc.DocType="HIPAA_5010:Interchange"
 $$$TRACE("Interchange: # of chidren: " _ ediDoc.ChildCount)
 // Get GS
 set groupDoc = ediDoc.NextChild()
 set groupDoc.DocType="HIPAA_5010:Group"
  $$$TRACE("Group: # of children:" _ groupDoc.ChildCount )
 set num =1
 // Get ST
 set transactionDoc = ""
 set transactionDoc = groupDoc.NextChild(transactionDoc)
 while ((transactionDoc '= "") && (num <= groupDoc.ChildCount))
 {
 	set transactionDoc.DocType="HIPAA_5010:835"
 	
 	//Get TRN-02
  	set trnsNum = transactionDoc.GetValueAt("TRN:RefId", , .pStat)
  	$$$TRACE(trnsNum _ ", " _ pStat)
  	
  	set value = ""
  	set stat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Sh835ToTransTrackRemitCff.Lookup.obConnectionForTRN4", context.obConnection,.value)
  	$$$TRACE("ItfLookup stat: " _ stat _ ", value: " _ value)
  	if (($$$ISOK(stat)) && ($L(value) > 0))
    	{
  	    //Get TRN-04
  	    set trnsNum = transactionDoc.GetValueAt("TRN:RefId2", , .pStat)
  	    $$$TRACE("UMR: TRN4: " _ trnsNum _ ", " _ pStat)
  	}
  	

  	//TRIM the number
  	if ($L(trnsNum) > 16)
  	{
  	    set trnsNum = $E(trnsNum, 1, 16)
  	}
  	if ($L(trnsNum) < 1)
  	{
  	   set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "TRN:RefId in X12 message is not valid, Skipping the record." _ request.RawContent)
  	}
  	else
  	{
  	    set transTrackRec = ##class(IHC.ITF.DStruc.Message.ShTransTrackRemitCff).%New()
  	
            set transTrackRec.transactionNumber =  trnsNum 
            set transTrackRec.transTrackDateTimeStamp = context.transTrackDateTimeStamp

            $$$TRACE("Targets: " _ context.targetConfigNames)
            For iTarget=1:1:$L(context.targetConfigNames, ",") 
            { 
               Set tOneTarget=$ZStrip($P(context.targetConfigNames,",",iTarget),"<>W")  
               Continue:""=tOneTarget
	       $$$TRACE(" Sync Call to Target Operation: " _ tOneTarget)
		set tStatus=process.SendRequestSync(tOneTarget, transTrackRec)
		if (tStatus '= $$$OK){
			$$$TRACE("ERROR in calling: " _ tOneTarget)
			Set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,"ERROR in calling: " _ tOneTarget _ ", Retry the record." _ request.RawContent)
		}
	    }
	}
		
  	set transactionDoc = groupDoc.NextChild(transactionDoc)

  	set num = num + 1
 }
]]]]><![CDATA[>
