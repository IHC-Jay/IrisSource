</parameters>
</property>
<property name='configName' type='%String' initialexpression='""' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='100' />
</parameters>
</property>
</context>
<sequence xend='200' yend='1550' >
<scope xpos='200' ypos='250' xend='200' yend='1450' >
<assign name="setConfigName" property="context.configName" value="process.%ConfigName" action="set" xpos='200' ypos='350' />
<code name='setFilterFlag' xpos='200' ypos='450' >
<![CDATA[ set context.cApplyRoomFacilityFilter=0
	$$$TRACE("Checking Custom setting for Filtering ..")
	#dim configValue=""
	set configValue=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","ItfCustomProperty1",.pstatus)
	$$$TRACE("Value of ItfCustomProperty1 ="_configValue)
	if (configValue="TRUE"){
		$$$TRACE("ItfCustomProperty1 "_configValue)
		set context.cApplyRoomFacilityFilter=1
	}  
  ]]]]><![CDATA[>
</code>
<trace name='InsideBP' value='"Inside configName "_process.%ConfigName' xpos='200' ypos='550' />
<code name='Validate Message' xpos='200' ypos='650' >
<annotation><![CDATA[Check if the message needs to be filtered out]]]]><![CDATA[></annotation>
<![CDATA[ 
 #dim validMessage AS %Boolean=1
 #dim wRoom,wFacility,wOBR15Field1,wOBR15Field2
 #dim wOBR26Field1,wOBR26Field2 As %String=""
 #dim validRoom,validFacility
 #dim exception As %Exception.SystemException
 set context.errorStatus=$$$OK
 $$$TRACE("Validate Message "_context.configName_" "_request.%ClassName(1)) 
 do {
	try {
		if (request.%ClassName(1)'["EnsLib.HL7.Message"){
		s validMessage=0
		set context.errorStatus=$$$ERROR(5001,"Invalid class Name")
		quit
		}
		$$$TRACE("Message Doctype / Category  "_request.DocType_"/"_request.DocTypeCategory)
		//Check if it is Valid message
		if ((request.DocType'["ORU_R01")){
			s validMessage=0
			set context.errorStatus=$$$ERROR(5001,"Invalid Message Type")
			quit
		}

		// If excute filter is set on then only process the Message  having ROOM and bed set in the look up tables
		If (context.cApplyRoomFacilityFilter){
			$$$TRACE("Check Filter Facility/Room ") 
			//Get Facility 
			set wFacility=request.GetValueAt("MSH:6.1")
			// Get Room
			set wRoom=request.GetValueAt("PIDgrpgrp(1).PIDgrp.PV1grp.PV1:AssignedPatientLocation.PointofCare")
			//
			$$$TRACE("Check Filter Facility/Room "_wFacility_"/"_wRoom) 
			set context.errorStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.ROOMLOOKUPTABLENAME, wRoom, .validRoom )
			$$$TRACE("Lookup Result for ROOM  "_context.ROOMLOOKUPTABLENAME_" "_context.errorStatus_" "_validRoom) 
			if (('context.errorStatus)||('validRoom)) {
				s validMessage=0
				quit
			}
			set context.errorStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.FACILITYLOOKUPTABLENAME, wFacility, .validFacility )
			$$$TRACE("Lookup Result for ROOM  "_context.FACILITYLOOKUPTABLENAME_" "_context.errorStatus_" "_validFacility) 
			if (('context.errorStatus)||('validFacility)) {
				s validMessage=0
				quit
			}
		}

		// Check for OBR 15 and OBR 26 
		s wOBR15Field1 =request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:15.1")
		s wOBR15Field2 =request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:15.2")
		s wOBR26Field1 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:26.1")
		s wOBR26Field2 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:26.2")
		$$$TRACE("Value in OBR:15.1/OBR:15.2 - OBR:26.1/OBR:26.2 "_wOBR15Field1_"/"_wOBR15Field2_" - "_wOBR26Field1_"/"_wOBR26Field2)
		// IF OBR:15.1 ="" or OBR:26.1'="" skip record
		if ((wOBR15Field1="")||(wOBR26Field1'="")){
		s validMessage=0
		set context.errorStatus=$$$ERROR(5001,"Either strOBR15_1 --> "_wOBR15Field1_" <-- is empty or strOBR_26.1_ObservID -->"_wOBR26Field1_"<-- is not empty.")
		quit
		}
		// IF OBR:15.2 ="" or OBR:26.2'="" skip record
		if ((wOBR15Field2="")||(wOBR26Field2'="")){
		s validMessage=0
		set context.errorStatus=$$$ERROR(5001,"Either strOBR15_2 --> "_wOBR15Field2_" <-- is empty or strOBR_26.2_ObservTxt -->"_wOBR26Field2_"<-- is not empty.")
		quit
		}
	}
	catch(exception){s context.errorStatus=exception.AsStatus() 
	set validMessage=0}
	}while (0)	]]]]><![CDATA[>
</code>
<if name='ValidMessage' condition='(validMessage=1)' xpos='200' ypos='750' xend='200' yend='1200' >
<annotation><![CDATA[IF the Message passed all the filtering criteria]]]]><![CDATA[></annotation>
<true>
<transform name='DTL-TransformPowerpathToNovoApp0' class='IHC.ITF.Transform.Dtl.PowerPathReultsHl7ToNovoApp0' source='request' target='context.hl7' xpos='470' ypos='900' />
<code name='ResetErrorCode' xpos='470' ypos='1000' >
<annotation><![CDATA[Reset The Error Code]]]]><![CDATA[></annotation>
<![CDATA[ Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(context.configName)]]]]><![CDATA[>
</code>
<call name='SendHL7ToNovo' target='Out-Novo-Results-Hl7tcp-App0' async='1' xpos='470' ypos='1100' >
<request type='Ens.Request' >
<assign property="callrequest" value="context.hl7" action="set" />
</request>
<response type='Ens.Response' />
</call>
</true>
<false>
<trace name='SkipMessage' value='"Message did not pass filter logic"' xpos='200' ypos='900' />
<code name='Ignore Message' xpos='200' ypos='1000' >
<![CDATA[ Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(context.configName, "SKIP record. "_$SYSTEM.Status.GetOneErrorText(context.errorStatus))
  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName)
]]]]><![CDATA[>
</code>
</false>
</if>
