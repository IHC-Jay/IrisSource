<code name='Parse ISA and collect GS level' xpos='200' ypos='650' >
<annotation><![CDATA[Parse X12 and split at GS level]]]]><![CDATA[></annotation>
<![CDATA[ /* Allocating assigned memory for the process */
 
 set memValue = ""
 
 set mstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AssignedMemory",.memValue)
  
 if ( ($$$ISERR(mstatus)) || (memValue= ""))
 {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName,"Assigned Memory value is missing from configuration.")
 }
 else
 {  
  SET $ZSTORAGE=memValue  
 }
 if (request.%Extends("EnsLib.EDI.X12.Document"))
 {
	 set context.x12Doc = request
 }
 elseif (request.%Extends("Ens.StreamContainer"))
 {
	 set context.x12Doc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.Stream)
 }
 else
 {
	   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message: " _ request)
 }
 
 ///$$$TRACE("Memory Value Assigned : "_memValue)
 
 /* Check if the received data is a X12 file or not and report error if it is not a X12 message. Parse the Interchange Level and extract number of Group level (GS-GE) count, SenderID (ISA06), ControlNumber (ISA13) and UsageIndicator (ISA15). Iterate through each GS level and place each group object in a collection list */
 
 
 if (context.x12Doc.%Extends("EnsLib.EDI.X12.Document"))
 {
 
   try
   {          
       /* Setting request message to X12 Interchange structure and gather number of child segment (GS-GE) count */
       
       set context.x12Doc.DocType = "HIPAA_5010:Interchange:Group" 
       set context.GSCounter = context.x12Doc.ChildCount
       
       /* Extracting InterchangeSenderID, Interchange ControlNumber and Interchange usage indicator values from X12 */
 
       set context.ISA06 = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeSenderID"),"<>W") 
       set context.ISA13 = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeControlNumber"),"<","0")
       set context.ISA15 = context.x12Doc.GetValueAt("ISA:UsageIndicator")
 
       /* Iterates through available number of group's and collects group level information and sets to gsDoc object */
          
          for i=1:1:context.GSCounter
          { 
            set x = context.x12Doc.getNthChild(i,2)
            do context.gsDoc.SetAt(x,i) 
          }  
         
    }
    Catch ex 
    { 
      if 1=ex.%IsA("%Exception.SystemException") 
      {
        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Interchange level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
      }
      else 
      {       
       Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Interchange level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)  
      }  
    }  
 } 
 else
 {
  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message ")
 } 
]]]]><![CDATA[>
</code>
<foreach name='for each Group level (GS-GE)' property='context.gsDoc' key='context.GSCounter' xpos='200' ypos='750' xend='200' yend='450' >
<annotation><![CDATA[Iterate through each GS level ]]]]><![CDATA[></annotation>
<code name='Parse GS and collect ST level' xpos='200' ypos='250' >
<annotation><![CDATA[Iterate and collect ST level details for each Group]]]]><![CDATA[></annotation>
<![CDATA[  /* Parse at Group level and extract Transaction set (ST-SE) count, SenderID (GS02), Date (GS04), Time (GS05), ControlNumber (GS06). Iterate through each ST level and place each group object in a collection list */

 try {
        
        /* Getting the stored group message (GS-GE) and setting X12 Group structure */
        
        set individualGroup = context.gsDoc.GetAt(context.GSCounter)         
        set individualGroup.DocType = "HIPAA_5010:Group"
        
               
        /* Extracting GroupSenderID, GroupDate and Group ControlNumber values from X12 */
 
        
        set context.GS02 = individualGroup.GetValueAt("GS:ApplicationSendersCode")        
        set context.GS04 = individualGroup.GetValueAt("GS:Date")
        set context.GS05 = individualGroup.GetValueAt("GS:Time")
        set context.GS06 = individualGroup.GetValueAt("GS:GroupControlNumber")
 

        
        $$$TRACE("Envelope values Extracted for mapping : ISA06-"_context.ISA06_", ISA13-"_context.ISA13_", ISA15-"_context.ISA15_", GS02-"_context.GS02_", GS04-"_context.GS04_", GS05-"_context.GS05_", GS06-"_context.GS06)
        
        /* Gather number of child segment (ST-SE) count */
 
        set context.STCounter = individualGroup.ChildCount        
        
        
        /* Iterates through available number of TransactionSets and set ST level information to stDoc object */
 
        For i=1:1:context.STCounter
        { 
          do context.stDoc.SetAt(individualGroup.getNthChild(i,2),i) 
        }        
        
     }
     Catch ex
     {  
       if 1=ex.%IsA("%Exception.SystemException") 
       {
         Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Functional Group GS level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
       }
      else 
      {  
        Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Functional Group GS level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
      }       
   }
    
]]]]><![CDATA[>
</code>
<foreach name='for each TransactionSet level (ST-SE)' property='context.stDoc' key='context.STCounter' xpos='200' ypos='350' xend='200' yend='450' >
