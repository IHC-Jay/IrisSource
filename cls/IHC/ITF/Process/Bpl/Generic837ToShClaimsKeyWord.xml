<![CDATA[ /* Setting message to X12 837 TransactionSet */
 
 set STRecord=context.individualST 
 set STRecord.DocType="HIPAA_5010:837P" 

 
 /* Define HL segment path's for both 2300 and next iteration of 2300 loop */
 
 set cur2300path="loop2000A("_(context.loopAind)_").loop2000B("_context.loopBind_").loop2000C("_(context.loopCind)_").loop2300("_context.loopClmInd_").CLM"
 set cur2300ind=STRecord.GetSegmentIndex(cur2300path,.cur2300status)
 $$$TRACE(cur2300path _": " _ context.loopClmInd _ "= " _ STRecord.GetValueAt(cur2300ind))
 if (cur2300status = 1)
 {
    set context.cur2300status = 1
    
    set cur2300nxt="loop2000A("_(context.loopAind)_").loop2000B("_context.loopBind_").loop2000C("_(context.loopCind)_").loop2300("_(context.loopClmInd+1)_").CLM"
    set nxt2300ind=STRecord.GetSegmentIndex(cur2300nxt,.cur2300status)
   
 
   set context.loop2300ite = context.loop2300Count + 1
   if (cur2300status = 1)
   {
     set context.loop2300Count = nxt2300ind - 1
     // $$$TRACE("Next 2000C 2300: " _ context.loop2300Count)
   }
   else
