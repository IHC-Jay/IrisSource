	<request type='Ens.Request' >
	<assign property="callrequest" value="response" action="set" />
	</request>
	</call>
	<code name='RESETERROR' xpos='470' ypos='2600' >
	<![CDATA[  Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)
	]]]]><![CDATA[>
	</code>
</foreach>

</true>
<false>
