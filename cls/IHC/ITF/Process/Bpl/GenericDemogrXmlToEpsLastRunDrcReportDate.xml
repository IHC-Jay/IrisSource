<code name='Check CernGetReportDateTargetConfigName configuration' xpos='200' ypos='650' >
<annotation><![CDATA[Get Cerner Last Report Date configuration from settings]]]]><![CDATA[></annotation>
<![CDATA[ 
 set context.CernGetReportDateTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","CernGetReportDateTargetConfigName",.pStatus)
 if (($$$ISERR(pStatus)) || (context.CernGetReportDateTargetConfigName = "")){
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get CernGetReportDateTargetConfigName in the Ensmeble settings, shutting down.")
 } else {
    $$$TRACE("CernGetReportDateTargetConfigName " _ context.CernGetReportDateTargetConfigName)   
 }]]]]><![CDATA[>
</code>
<code name='CallToGetLastRunReportDateFromCern' xpos='200' ypos='1250' >
<![CDATA[  
   $$$TRACE("Calling drt-getreportdate service.. ")
   set httpRequestObjReportDate=##class(IHC.ITF.Request.DrcRequest).%New()
   set status = process.SendRequestSync(context.CernGetReportDateTargetConfigName,httpRequestObjReportDate,.cernLastReportResp)
   $$$TRACE("Call to drt-getreportdate service complete... ")
   set context.CernLastRunReportDate = ""
   if ($$$ISOK(status)){
	    $$$TRACE("RESPONSE from drt-getreportdate :"_cernLastReportResp.StringValue)
	    set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(cernLastReportResp.StringValue)
        set statusVal = ((consumedJSONobj.%Get("response")).%Get("service-status")).%Get("status")        
      	if (statusVal="SUCCESS"){
    		set statusDetailsArr = ((consumedJSONobj.%Get("response")).%Get("status-details"))    		
    		 // Loop through a JSON Array
  			Set arrObj = statusDetailsArr.%GetIterator()
  			
  			while arrObj.%GetNext(.key, .value) {	  			
	  			  Set arrElemObj = value.%GetIterator()	 
	  			  while arrElemObj.%GetNext(.key, .value) {
		  			  if (key = "REPORTED_DATE"){
		  			  	Set context.CernLastRunReportDate = value 
		  			  }	  			     
	  			  }	   			 
	   	   }
	   	   $$$TRACE( "ReportDate from Cerner:: "_context.CernLastRunReportDate)
	   	   set response.StringValue = context.CernLastRunReportDate
    	}
     }else{
	     $$$TRACE("Calling drt-getreportdate failed!!! ")
	     set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get Last Run ReportDate from drt-getreportdate service , shutting down...... "_$SYSTEM.Status.GetOneErrorText(status))
	 }
 ]]]]><![CDATA[>
</code>
<if name='hasLastRunCdrReportDate' condition='($length(context.CernLastRunReportDate) &gt; 0)' xpos='200' ypos='1350' xend='200' yend='1950' >
