  	set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()	
  	
   set clinicFlag = request.GetValueAt("ZZZ(2):27UB92Condition") 	
  
   if (clinicFlag = "CLIN_REG"){
		set locationContext = context.hddContextICentraToIHC50035
	}else{
		set locationContext = context.hddContextiCentraLocationHierDisp
   }	

   set bedNcid = request.GetValueAt("ZZZ(2):16VisitAdmitDXCode") 	 
   $$$TRACE(" ZZZ(2):16VisitAdmitDXCode BED is " _bedNcid )	 	
   if (bedNcid '= "" && $ISVALIDNUM(bedNcid)= "1"){
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, bedNcid,  locationContext, "ZZ2:VisitLocation")  	
   }
	   else{
		set roomNcid = request.GetValueAt("ZZZ(2):15VisitPatientType") 	
		$$$TRACE("roomNcid is " _roomNcid)	
		if (roomNcid  '= "" && $ISVALIDNUM(roomNcid)= "1"){
			Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, roomNcid,  locationContext, "ZZ2:VisitLocation")  	  	
		    $$$TRACE("Hdd roomNcid is " _roomNcid)		
		} else{
			set pointOfCareNcid = request.GetValueAt("ZZZ(2):14VisitAdmitSource") 	
			$$$TRACE("ZZZ(2):14VisitAdmitSourceNCID is " _ pointOfCareNcid)		
		     if (pointOfCareNcid '= "" && $ISVALIDNUM(pointOfCareNcid)= "1"){
			    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pointOfCareNcid,  locationContext, "ZZ2:VisitLocation")  	  
		     } 	
		}
	}]]]]><![CDATA[>
