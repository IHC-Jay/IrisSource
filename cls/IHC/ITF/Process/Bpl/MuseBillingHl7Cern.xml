<code name='InterHospitalBilling Logic ' xpos='200' ypos='350' >
<![CDATA[ set billingComboKey =""
 set ft12data= request.GetValueAt("FT1grp("_context.ft1Count_").FT1:TransactionID")
 
 
 $$$TRACE("FT1grp("_context.ft1Count_").TransactionID Value : "_ft12data)
 $$$TRACE("Facility Id :"_context.FacilityId )
 
 if ($LENGTH(ft12data) > 1) 
 {
    if (context.FacilityId ="146")
    {
       $$$TRACE("Facility is Valley View 146")
       set ft12data= $E(ft12data,1,3)
       $$$TRACE("ft12data value after substring : "_ft12data)
    }
    else
    {
       set ft12data= $E(ft12data,1,2)
       $$$TRACE("ft12data value after substring : "_ft12data)
    
    }
    
    set billingComboKey = context.FacilityId_"-"_ft12data
    $$$TRACE("billingComboKey value :"_billingComboKey)
    
   
 }
 
 set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerPathDftHl7ToCerner.Lookup.InterHospitalBilling", billingComboKey, .retVal )
    
     $$$TRACE("Lookup.InterHospitalBillingvalue for "_billingComboKey_" is "_retVal)
    
    if (($LENGTH(retVal) > 0) && (retVal '= "Unknown"))
    {
       set context.interHospitalValue = retVal
       
       $$$TRACE("Initial interHospitalValue :"_context.interHospitalValue)
    
    }
    
    
 
 if ($LENGTH(context.interHospitalValue) > 0)
 {
    set context.isInterhospitalBilling = 1
    ///$$$TRACE("This is InterHospitalBilling Record")
    $$$TRACE("context.ft1Count first block :"_context.ft1Count)
    
    set commaPosition = $F(context.interHospitalValue,",")
    $$$TRACE("Comma Position : "_commaPosition)
    
    if ( commaPosition > 0 )
    {
       set strComboValue = context.interHospitalValue
       set tempInterHospitalValue = $E(strComboValue,1,commaPosition-2)
       set tempInterHospitalMRNValue = $E(strComboValue,commaPosition,*)
       
       set context.interHospitalValue = tempInterHospitalValue
       set context.interHospitalMRNValue = tempInterHospitalMRNValue
       
       
       $$$TRACE("Final interHospitalValue :"_context.interHospitalValue)
       $$$TRACE("interHospitalMRNValue:"_context.interHospitalMRNValue)
    
    
    }
    
    
 }
 
 ///Steve's Tracker Changes
    /// Tracker 32124 - Do not consider for InterHospitalBilling if FT1.3 = P
     set ft13Data = request.GetValueAt("FT1grp("_context.ft1Count_").FT1:TransactionBatchID")
    if (ft13Data = "P")
    {
      set context.isInterhospitalBilling = 0
      $$$TRACE("This is NOT a InterHospitalBilling Record")
      set context.interHospitalValue = ""
      
    }
    elseif ($LENGTH(context.interHospitalValue) > 0)
    {
      set context.isInterhospitalBilling = 1
      $$$TRACE("This is InterHospitalBilling Record")
    }]]]]><![CDATA[>
