<![CDATA[ set ft13Data = request.GetValueAt("FT1grp("_context.ft1Count_").FT1:TransactionBatchID")
 set docCode =request.GetValueAt("FT1grp("_context.ft1Count_").FT1:PerformedByCode.IDnumberST") 
 $$$TRACE("FT1grp("_context.ft1Count_").TransactionBatchID Value : "_ft13Data)
 $$$TRACE("FT1grp("_context.ft1Count_").PerformedByCode Value : "_docCode)
 
 if ($LENGTH(ft13Data) > 0) && (ft13Data = "P")
 {
    $$$TRACE("Inside ft13Data = P ")
    set context.considerP = 1

    set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerPathDftHl7ToCerner.Lookup.IHCOnlyBillingDocs", docCode, .retVal )
    
    $$$TRACE("Lookup.IHCOnlyBillingDocs value for "_docCode_" is "_retVal)
    if (retVal ="1") 
    {
       $$$TRACE("Inside isIHCBillling check pass ")
       set context.isIHCBillling = 1
       set tmpTransCode = $E((request.GetValueAt("FT1grp("_context.ft1Count_").FT1:TransactionCode.identifier")),1,5)
       $$$TRACE("FT1grp("_context.ft1Count_").TransactionCode Value after Substring : "_tmpTransCode)
       
       set retStatTrans= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerPathDftHl7ToCerner.Lookup.TransCodeMap", tmpTransCode, .retValTrans)
    
     $$$TRACE("Lookup.TransCodeMap value for "_tmpTransCode_" is "_retValTrans)
      
    if (($LENGTH(retValTrans) > 0) && (retValTrans'= "Unknown"))
    {
       $$$TRACE("TransCodeMap has billcode value "_retValTrans_" For tmpTransCode "_tmpTransCode)
       set context.billCode = retValTrans
       $$$TRACE("billcode value :"_retValTrans)
    }
    else
    {
      $$$TRACE("TransCodeMap does not have billcode value so setting Billcode value as 0 ")
      set context.billCode = 0
       $$$TRACE("billcode value is set to 0 " )
    }
       
   }
   else
   {
      set context.isIHCBillling = 0
   }
    
 }]]]]><![CDATA[>
