<code name='Build HDD Request' xpos='200' ypos='1050' >
<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object") 

 set context.facId = request.GetValueAt("MSH:SendingFacility.namespaceID")  	
 if (context.facId '= "" && $ISVALIDNUM(context.facId)= "1") 
 {
   //Facility Name 
   Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.DefaultContext, "MSH4:Facility")  	  	
    
   //Facility Address
   Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.StreetContext, "MSH4:STREET")  	  	
   
   //Facility City
   Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.CityContext, "MSH4:CITY")  	  	
   

   //Facility State
   Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.StateContext, "MSH4:STATE")  	  	

   //Facility Zip
   Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.ZipContext, "MSH4:ZIP")  	  	
   
    	
 } else {
     // Skip message if MSH-4 is empty or invalid ncid
     set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH-4 Sending Facility ncid is empty or inalid. Skipping the record.")	 
 }
 

 set obr4SvcId = request.GetValueAt("OBR:4.1") 
 set context.svcId=obr4SvcId
 $$$TRACE("Hdd Request OBR-4 Service id is " _ obr4SvcId)
 if (obr4SvcId '= "" && $ISVALIDNUM(obr4SvcId)= "1") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr4SvcId, context.ReportContext, "OBR4:USId")  	  	
     $$$TRACE("Hdd Request OBR-4 Service id is " _ obr4SvcId)     		
 }
 else {
    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "OBR-4.1 is Null or invalid NCID, Skipping the record.")
 }

 set obr25ResStatus = request.GetValueAt("OBR:25")  	
 if (obr25ResStatus '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , obr25ResStatus, context.StatusContext, "OBR25:ResultStatus")  	  	
     $$$TRACE("Hdd Request OBR-25 ResultStatus is " _ obr25ResStatus )     		
 }
 
 set pv1Class= request.GetValueAt("PV1:PatientClass")  
 if (pv1Class'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pv1Class, context.PatTypeContext, "PV1:PatientClass")  	  	
         		
 }


 set pid8Sex = request.GetValueAt("PID:Sex")  	
 $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)
 if (pid8Sex '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid8Sex, context.DefaultHelpContext, "PID8:Sex")  	  	
     $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 }


 set pid10 = request.GetValueAt("PID:PrimaryLanguage.identifier")  	
 
 if (pid10 '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid10 , context.DefaultHelpContext, "PID10:Race")  	  	
     	
 }

 
 set pid16 = request.GetValueAt("PID:MaritalStatus.identifier")  	
 
 if (pid16 '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid16 , context.DefaultHelpContext, "PID16:MARSTATUS")  	  	
     	
 }
  

 set pid15 = request.GetValueAt("PID:Race(1).identifier")  	
 
 if (pid15 '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid15 , context.DefaultHelpContext, "PID15:LANG")  	  	
     	
 }

 
 $$$TRACE(" After setting all NCID values")  
 ]]]]><![CDATA[>
