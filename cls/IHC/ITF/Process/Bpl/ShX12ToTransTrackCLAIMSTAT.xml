<code name='Read request' xpos='200' ypos='550' >
<![CDATA[ 
		$$$TRACE(request)
	if (request.%IsA("EnsLib.EDI.X12.Document")){
		$$$TRACE( " Request: EnsLib.EDI.X12.Document ")
		set context.inXmlDoc = request
		set context.inXmlDoc.DocType = "HIPAA_5010:Interchange" 
		set individualGroup = context.inXmlDoc.getNthChild(1,2)
		set STRecord=individualGroup.getNthChild(1,2)
		set context.msgType = ##class(IHC.ITF.ITFCOMMON.X12.StoreEdiX12Data).GetTransType(STRecord)	
  		$$$TRACE(" context.transType : "_context.msgType)
		set context.FileName = request.Source 
 	}elseif (request.%IsA("Ens.StreamContainer")){
	 	$$$TRACE("StreamContainer: " _ request.OriginalFilename _ ", Stream size: " _ request.Stream.Size)
	 	do request.Stream.Rewind()
 		set context.inXmlDoc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.Stream, .tStatus )
 	
	 	if (tStatus '= $$$OK){  	
     		$$$TRACE("Failed to create X12 message from Stream: " _ tStatus)
     		$$$TRACE("tStatus: "_$System.Status.GetOneStatusText(tStatus))
     		set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "X12 ImportFromLibraryStream failed, Skipping the record." _ request)
        }else{
       		$$$TRACE("Created context.inXmlDoc")
       		set context.FileName = request.OriginalFilename
       		set context.inXmlDoc.DocType="HIPAA_5010:Interchange"
       		$$$TRACE("Copy Stream")
      		set context.inpStream = ##class(%Stream.GlobalCharacter).%New()
      		//Do request.Stream.Rewind()
      		$$$TRACE(request.Stream.Size)
      		set tSC = context.inpStream.CopyFrom(request.Stream) 
      		
      		$$$TRACE("Copy Status="_tSC)
			$$$TRACE("After Copy Dest Size="_context.inpStream.Size)
			
			Do context.inpStream.Rewind()
			$$$TRACE("After Rewind AtEnd="_context.inpStream.AtEnd)

      		Set x12=""
      		While 'context.inpStream.AtEnd {
	      		Set x12 = x12 _ context.inpStream.Read(32000)
      		}
      		//$$$TRACE("X12:"_x12)
	      	For i=1:1:$L(x12,"~"){
		      	Set seg=$Piece(x12,"~",i)
		      	set st=$ZSTRIP($P(seg,"*",1),"<>W")
		      	   if (st["ST") {			      	   
			      	Set context.msgType=$P(seg,"*",2)
			      	Quit    
			      }
			 }
			 $$$TRACE(" context.MsgType:"_context.msgType)      	
   		}
     }else{
	    $$$LOGERROR("Could not process data, invalid inbound class: " _ request)
  		Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"Could not process data, invalid inbound class: " _ request)
 	 }
 		$$$TRACE("Process: " _ context.FileName)
 	]]]]><![CDATA[></code>


