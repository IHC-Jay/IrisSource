<![CDATA[ //Calling StoredProcedure
 	$$$TRACE("Send the first trans track data")
 	set tStatus=process.SendRequestSync(context.targetConfigNames,context.arr,.response,context.TimeOutForSPCall)
	$$$TRACE("context.arr value:"_context.arr_". Status:"_tStatus)
	
 	if ('tStatus){
           Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Unable to insert Eligibility request  record into IHCSP_EDITRK_TRANX_INSERT table")
    }else{ 
      	$$$TRACE("Success")
     	$$$TRACE("response.StringValue:"_response.StringValue)
     	Set context.PEdick=$PIECE(response.StringValue,"|",1)
     	Set PErrorcode=$PIECE(response.StringValue,"|",2)
     	Set PErrorDescription=$PIECE(response.StringValue,"|",3)
	   
	    $$$TRACE("PEdick:"_context.PEdick)
 		$$$TRACE("Errorcode:"_PErrorcode)
 		$$$TRACE("ErrorDesc:"_PErrorDescription)     
 		if PErrorcode="0"{
     	     $$$TRACE("Success response from operation class 1")
        }else{
     		do ..%Process.ItfSendEmailOnError("Unable to insert new Eligibility request  record into SHSP_EDI_TRANSACTION_INSERT table","--- Unable to insert Eligibility record into SHSP_EDI_TRANSACTION_INSERT table"_"The get SHSP_EDI_TRANSACTION_INSERT() call returned an error code of"_PErrorcode_"("_PErrorDescription_")"_"Parameter in SP call="_"TtUniqueId=<"_context.arr.TtUniqueId_">|"_"strTtBatchReal=<"_context.arr.strTtBatchReal_">|"_"TimeStamp=<"_context.arr.TimeStamp_">|"_"TtMsgType=<"_context.arr.TtMsgType_">|")      
     		Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Unable to insert Eligibility record into SHSP_EDI_TRANSACTION_INSERT table")
          }
