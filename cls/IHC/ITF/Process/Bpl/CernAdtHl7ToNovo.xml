<code name='Patient Relationship' xpos='470' ypos='1600' >
<![CDATA[ set context.relationshipCode  = ""	
 set k1="",tSC=1
 For 
 { 

	set k1=request.GetNextIndex("IN1grp()",k1,.tSCTrans)  Quit:k1=""
	set in1171Insurer2PatRelshipNcid = request.GetValueAt("IN1grp("_k1_").IN1:InsuredsRelationshipToPatien.identifierST")
	$$$TRACE("IN1-17.1 RelationshipToPatient NCID in Loop "_k1_":" _in1171Insurer2PatRelshipNcid )
						
	set in272Pat2InsurerRelshipNcid = request.GetValueAt("IN1grp("_k1_").IN2:72.1")
	$$$TRACE("IN2-72 RelationshipToPatient NCID in Loop "_k1_":" _in272Pat2InsurerRelshipNcid )
						
	set in143Sex = request.GetValueAt("IN1grp("_k1_").IN1:43")
	$$$TRACE("IN1-43 Sex NCID:" _in143Sex )
	 
	if (in1171Insurer2PatRelshipNcid '= "")
	{
	
	  if ($ISVALIDNUM(in1171Insurer2PatRelshipNcid)=1)
          {
  
             do context.relationshipCode.Insert(##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(in1171Insurer2PatRelshipNcid, "510105653", context.hddTargetConfigName, .process))
   	     $$$TRACE(" Patient Relationship for loop ["_k1_"]:" _context.relationshipCode.GetAt(k1))    
 
          
             if ((context.relationshipCode.GetAt(k1) = "Unknown") || (context.relationshipCode.GetAt(k1)="") || (context.relationshipCode.GetAt(k1)= "ERROR"))      
             {
	      	  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "No Rep defined. getRepFromNcid Hdd call with in1171Insurer2PatRelshipNcid(SrcRep) : ["_in1171Insurer2PatRelshipNcid_"], display context: 510105653, and context.hddTargetConfigName: ["_context.hddTargetConfigName_"].")   
	     }

          }
          else
          {    
             	 $$$TRACE("Incoming patient relationship value in IN1-17.1 is not NCID:   " _in1171Insurer2PatRelshipNcid)  
          }
      	
	}
	else  // The alternative approach
	{
          $$$TRACE("IN1-17.1 RelationshipToPatient is blank:   [" _in1171Insurer2PatRelshipNcid_ "].  Then use the alternative approach of calling getRepByRep method to get the relationship code.") 

           if ((in272Pat2InsurerRelshipNcid '="" ) && ($ISVALIDNUM(in272Pat2InsurerRelshipNcid)=1) && (in143Sex '=""))
           {
             
                  $$$TRACE("IN1-43 gender value:   " _in143Sex)             
          
                  set relationship = in272Pat2InsurerRelshipNcid_ "|" _in143Sex
                  $$$TRACE("The concatenated string of in272Pat2InsurerRelshipNcid and in143Sex is " _relationship) 
                    
                  do context.relationshipCode.Insert(##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepByRep(relationship, "529774672", "1012", "526051384", context.hddTargetConfigName, .process))
                   if ((context.relationshipCode.GetAt(k1) = "Unknown") || (context.relationshipCode.GetAt(k1) ="") || (context.relationshipCode.GetAt(k1) = "ERROR"))
                   {
	                   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "No Rep defined. getRepByRep Hdd call with relationship(SrcRep) : ["_relationship_"], SrcContext: 529774672, DomainNcid: 1012, TargetContext: 526051384, and context.hddTargetConfigName: ["_context.hddTargetConfigName_"]")   
	      	           $$$TRACE("HDD call of getRepByRep returned no rep:   " _context.relationshipCode.GetAt(k1))  
                   }
                   
          	   $$$TRACE("HDD call of getRepByRep returned rep:   " _context.relationshipCode.GetAt(k1))                 
            }

          	    $$$TRACE("Not in HDD call of getRepByRep block due to the invalid variable conditions of in272Pat2InsurerRelshipNcid [" _in272Pat2InsurerRelshipNcid_ "] and/or in143Sex [" _in143Sex_ "]")  
             
	} //end if (in1171Insurer2PatRelshipNcid '= "")
	
		 
 } //end of FOR loop
 
 $$$TRACE("The relationship Code outside the FOR loop block:   " _context.relationshipCode  ) ]]]]><![CDATA[>
