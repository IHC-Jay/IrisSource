<code name='Patient Relationship' xpos='470' ypos='1600' >
<![CDATA[ set context.relationshipCode  = ""	
 set k1="",tSC=1
 For 
 { 

	set k1=request.GetNextIndex("IN1grp()",k1,.tSCTrans)  Quit:k1=""
	set in1171Insurer2PatRelshipNcid = request.GetValueAt("IN1grp("_k1_").IN1:InsuredsRelationshipToPatien.identifierST")
	$$$TRACE("IN1-17.1 RelationshipToPatient NCID in Loop "_k1_":" _in1171Insurer2PatRelshipNcid )
						
	set in272Pat2InsurerRelshipNcid = request.GetValueAt("IN1grp("_k1_").IN2:72.1")
	$$$TRACE("IN2-72 RelationshipToPatient NCID in Loop "_k1_":" _in272Pat2InsurerRelshipNcid )
						
	set in143SexNcid = request.GetValueAt("IN1grp("_k1_").IN1:43")
	$$$TRACE("IN1-43 Sex NCID:" _in143SexNcid )
	 
	if (in1171Insurer2PatRelshipNcid '= "")
	{
	
	     if ($ISVALIDNUM(in1171Insurer2PatRelshipNcid)=1)
         {
  
           set in1171Insurer2PatRelationshipRep = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(in1171Insurer2PatRelshipNcid, 510105653, context.hddTargetConfigName, .process)
 
          
           if ((in1171Insurer2PatRelationshipRep = "Unknown") || (in1171Insurer2PatRelationshipRep ="") || (in1171Insurer2PatRelationshipRep = "ERROR"))      
           {
	      	  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(in1171Insurer2PatRelationshipRep, " The IN1-17.1 RelationshipToPatient NCID: " _in1171Insurer2PatRelationshipNcid_ " has no rep found in HDD lookup with context: 510105653.  Skip the record with error email." )
	      	  
	       }
	       else
	       {
 	         $$$TRACE("The rep for The IN1-17.1 RelationshipToPatient NCID:   " _in1171Insurer2PatRelationshipRep ) 
 	       
 	         set context.relationshipCode  = in1171Insurer2PatRelationshipRep
 	       }
         }
         else
         {    
           Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError("IN1-17.1 RelationshipToPatient: " _in1171Insurer2PatRelshipNcid_ " is an invalid NCID.  Skip the record." )
         }
      	
	}
	else  // The alternative approach
	{
          $$$TRACE("IN1-17.1 RelationshipToPatient is blank:   [" _in1171Insurer2PatRelshipNcid_ "].  Then use the alternative approach to get the relationship code.") 

           if ((in272Pat2InsurerRelshipNcid '="" ) && ($ISVALIDNUM(in272Pat2InsurerRelshipNcid)=1) && (in143SexNcid '="") && ($ISVALIDNUM(in143SexNcid)=1))
           {
             
             set in143SexRep = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(context.in143SexNcid, context.hddContextICentraToIHC50035, context.hddTargetConfigName, .process)
 
          
            if ((in143SexRep = "Unknown") || (in143SexRep ="") || (in143SexRep = "ERROR"))
            {
	      	  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(in143SexRep, " IN2-72 RelationshipToPatient NCID: " _coin143exNcid _ " has no HDD lookup return value with HDD context: " _context.hddContextICentraToIHC50035_ ".  Skip the record with error email." )
	        }
             $$$TRACE("The representation from HDD lookup for IN1-43 Sex NCID:   " _in143SexRep)             

           
             set context.relationship = in272Pat2InsurerRelshipNcid_ "|" _in143SexRep
             
             set context.relationshipCode  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepByRep(context.relationship, 529774672, 1012, context.hddContextICentraToIHC50035, context.hddTargetConfigName, .process)
            if ((context.relationshipCode = "Unknown") || (context.relationshipCode ="") || (context.relationshipCode = "ERROR"))
            {
	      	  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.relationshipCode, " The getRepByRep call failed to get the relationship code with IN2-72.1 RelationshipToPatient NCID: [" _in272Pat2InsurerRelshipNcid _ "] and the in143SexRep: [" _in143SexRep_ "].  Skip the record with error email." )
	        }
            $$$TRACE("The representation from getRepByRep()method:   " _context.relationshipCode)  
               
           }
             set msgStr = "IN1-17.1 RelationshipToPatient is blank:   [" _in1171Insurer2PatRelshipNcid_ "].  So, the alternative to get the relationship code is using in272Pat2InsurerRelshipNcid ["_in272Pat2InsurerRelshipNcid_ "] and the in143SexNcid [" _in143SexNcid_ "].  So, the relationship code is [" _context.relationshipCode_ "]."
             $$$TRACE(msgStr)
             
	   } //end if (in1171Insurer2PatRelshipNcid '= "")
	
		 
 } //end of FOR loop
 
 $$$TRACE("The relationshipCode after the FOR loop block:   " _context.relationshipCode  ) ]]]]><![CDATA[>
</code>
<code name='Insurance Segment' xpos='470' ypos='1700' >
<![CDATA[ set k1="",tSC=1   
 For { 
   Set k1=request.GetNextIndex("IN1grp()",k1,.tSCTrans)  Quit:k1=""   
   set In142EmpStatusNcid = request.GetValueAt("IN1grp("_k1_").IN1:42")
   $$$TRACE(" IN1 Employment Status Ncid "_k1_":" _ In142EmpStatusNcid )
   do context.in142.Insert(##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(In142EmpStatusNcid, context.hddContextHelp, context.hddTargetConfigName, .process))   
    
   //set In143SexNcid = request.GetValueAt("ZZ1:26("_k1_")")
   set In143SexRep = request.GetValueAt("IN1grp("_k1_").IN1:43")
   $$$TRACE("  In143SexRep :" _In143SexRep)
   $$$TRACE(" Calling getNcidFromRep...")  	  	
  	if (In143SexRep '= "" ){		
		set context.in143 = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(In143SexRep, "1209", context.hddContextHelp, context.hddTargetConfigName, .process)
		$$$TRACE(" context.in143..."_context.in143)  	 
	}
	$$$TRACE(" context.in143..."_context.in143)  	 
   
   set ZNI3relationshipNcid = request.GetValueAt("IN1grp("_k1_").ZNI:3")
   $$$TRACE("  ZNI3relationshipNcid :" _ZNI3relationshipNcid)
   do context.in1Rel.Insert(##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getHelp1PatRelationship(ZNI3relationshipNcid, context.in143, context.hddTargetConfigName, .process))     
   $$$TRACE("  context.in1Rel :" _context.in1Rel.GetAt(k1))
   
   
 }
 ]]]]><![CDATA[>
