<![CDATA[   $$$TRACE("13. In process OBX-5.")
   $$$TRACE("The pv12PatClasPV1-2 Patient Class Rep should be Emergency: " _ context.pv12PatClass ) 
   
   
    set context.obx5StrOut = ""
    set tmp = "" 
    
    $$$TRACE("PV1-2 Patient Class should be Emergency  (NCID=499) at this point: " _ context.pv12PatClass )
   	   
   //Mapping this value with HDD rep will follow De's code.
    $$$TRACE("The OBR-25 result status should be A or F -->" _ context.obr25ResStatus  _"<--")
    	  	
    if (context.obr25ResStatus ="A"){  //Addendum case
 	  $$$TRACE("The OBR-25 result status is a Final report: " _ context.obr25ResStatus )
 	  
 	  //Prepare the OBX-5 output string with the predefined message
 	  set context.obx5StrOut = context.PredefinedMsgForAddendumRpt
 	  $$$TRACE("The context.PredefinedMsgForAddendumRpt is: " _ context.obx5StrOut) 
 	  	  	 
    }elseif (context.obr25ResStatus ="F"){  //Final-Impression case
          $$$TRACE("The Final report with Impression case: " _ context.obr25ResStatus)      
	 
	  //OBX-5 loop
	  set hasImpressionFlag = "0"
	  set hasFinalRptFlag = "0"
	  set impressionStr = "" 
	  
 	  set k1="",tSC=1 
 	  For { 
             Set k1=request.GetNextIndex("OBXgrp()",k1,.tSCTrans)  Quit:k1=""          
             set obx5StrIn = request.GetValueAt("OBXgrp("_k1_").OBX:ObservationValue()")
                                  
             if (obx5StrIn '= "" && hasImpressionFlag = "0"){
                  set obx5StrInTmp = obx5StrIn 
 	          $$$TRACE("OBX-5 tmp string before uppercase is " _ obx5StrInTmp )	
 	           
 	          set obx5StrInTmp = ##class(Ens.Util.FunctionSet).ToUpper(obx5StrInTmp)
 	          $$$TRACE("OBX-5 tmp string all has the upper case: " _ obx5StrInTmp)	
 	           
 	          set impressionStartPos = -1
 	          set impressionStartPos = $FIND(obx5StrInTmp, "IMPRESSION:")
  	
 	 	  if (impressionStartPos > 0){
 	  	     $$$TRACE("The impressionStartPos: is " _ impressionStartPos )
 	  	     set hasImpressionFlag = "1"
 	  	     $$$TRACE("The hasImpressionFlag is true: " _ hasImpressionFlag )
 	  	   
 	  	     //set impressionStr = "" 	  	   
 	  	     set impressionStr = $EXTRACT(obx5StrIn, impressionStartPos,*) 
 	  	     $$$TRACE("This is the first substring after Impression: " _ impressionStr )
 	  	  }else{
 	  	     //Set flag for OBX-5 text with no Impression in it. 
 	  	     set hasFinalRptFlag = "1"
 	  	     $$$TRACE("The hasFinalRptFlag has turned on: " _ hasFinalRptFlag)
 	  	  }	 
 	  	   
 	     }elseif (obx5StrIn '= "" && hasImpressionFlag = "1"){
     	  	   set impressionStr = obx5StrIn
 	  	   $$$TRACE("This is the sebsequent substring after Impression: " _ impressionStr )
             }else{
                  //Ignore empty obx5StrIn string
             }
 	  	  		  	  	
 	     //Append subsequent OBX-5 text to the Impression report
 	     //Add space at the end of each OBX-5 repeat to separate the following one
 	     set context.obx5StrOut = context.obx5StrOut _impressionStr _"  "
 	  	
  	     $$$TRACE("The obx5StrOut built with Impression or its subsequent repeat text. " _ context.obx5StrOut )        
 	           
 	   } //end of For loop
	 
	   if (context.obx5StrOut '= "" && hasImpressionFlag = "1"){
	      set context.obx5StrOut = "Impression: " _context.obx5StrOut
	   }elseif(hasFinalRptFlag = "1"){
	      set context.obx5StrOut = context.obx5StrOut  _context.PredefinedMsgForAddendumRpt
 	      $$$TRACE("The context.PredefinedMsgForFinalRptWithNoChange is: " _ context.PredefinedMsgForFinalRptWithNoChange) 
 	   } 
     
      } //end of all possible three obr25ResStatus cases
 	

   
   $$$TRACE("The whole OBX-5 output build at the end of Step#17 is " _ context.obx5StrOut)
  ]]]]><![CDATA[>
</code>
<code name='14. OBX-5 outtput length' xpos='200' ypos='2250' >
<![CDATA[   //The text display in the handset device has 5,000 characters limit.
   $$$TRACE("14. OBX-5 string after Max size check." ) 	 
   set obx5StrOutTemp = ""
   set tmpStrForObx5 = ""
   
   set obx5StrOutTemp = context.obx5StrOut
   $$$TRACE("14.1  obx5StrOutTemp: "  _obx5StrOutTemp)   
   
    if ($LENGTH(context.obx5StrOut) <= 0){
     	//Add error out handling code
     	$$$TRACE("14.2 OBX-5 text string is empty at the size-check: " _ context.obx5StrOut ) 
     	set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The OBX-5 build is Null or empty. Skip the record." _ request.RawContent) 
     	                                           
    }elseif ($LENGTH(context.obx5StrOut) > context.obx5StrOutLimit){
 	
    	$$$TRACE("14.3 OBX-5 string is beyond the size limit: " _ context.obx5StrOutLimit)
    	 set obx5StrOutTemp = context.obx5StrOut
    	 
    	 set sizeLimit = context.obx5StrOutLimit
     	 
    	 set tmpStrForObx5 = $EXTRACT(obx5StrOutTemp, 0, sizeLimit)
    	 $$$TRACE("14.4 context.tmpStr after max limit sizing: " _ tmpStrForObx5)
    	 	
  	if (tmpStrForObx5 = ""){
  	    //Erorr occured in down sizing the OBX-5 string to its limit.
  	    $$$TRACE("14.5 OBX-5 text string is empty after max size cut. Error out and skip record.")
  	  
  	    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The OBX-5 build after resize is empty. Skip the record." _ request.RawContent) 	
  	}else {
  	    set context.obx5StrOut = tmpStrForObx5  _obx5StrOverSizeNotice
   	    $$$TRACE("14.6 OBX-5 text with its over size notice: " _ context.obx5StrOut ) 	
  	}	  	 
     
    }else{
    //
    }
    
   $$$TRACE("14.7 OBX-5 string after Max size check: " _ context.obx5StrOut ) 	
    ]]]]><![CDATA[>
</code>
<code name='15. Populate the OBX-5' xpos='200' ypos='2350' >
<annotation><![CDATA[Populate the OBX-5 with the one of the six scenario text]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("15. Before calling the setValueAt  OBX-5 text with its over size notice: " _ context.obx5StrOut ) 
 
  Do context.updatedMsg.SetValueAt(context.obx5StrOut, "OBXgrp(1).OBX:ObservationValue(1)")
  
  $$$TRACE("15.1  After calling the updateMsg.SetValueAt with the OBX-5 output: " _ context.obx5StrOut ) ]]]]><![CDATA[>
</code>
<trace name='16. Output after transforms' value='"Message after Transform: " _ context.updatedMsg.OutputToString()' xpos='200' ypos='2450' >
<annotation><![CDATA[Echo translated output]]]]><![CDATA[></annotation>
</trace>
<code name='17. setup target list' xpos='200' ypos='2550' >
<![CDATA[   
 //TargetConfigNames validation
 set targetConfigNames=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TargetConfigNames",.pstatus)
 if ( ($$$ISERR(pstatus)) || (targetConfigNames= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get targetConfigNames, shutting down.")   
 } else {
    $$$TRACE("TargetConfigNames: " _ targetConfigNames)
    set pstatus = ##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList)
    $$$TRACE("TargetListCount: " _ context.targetList.Count())   
 }
   $$$TRACE("Count: " _ context.targetList.Count())
 ]]]]><![CDATA[>
</code>
<foreach name='18. Sent to target' property='context.targetList' key='context.targetConfigIndex' xpos='200' ypos='2650' xend='200' yend='350' >
