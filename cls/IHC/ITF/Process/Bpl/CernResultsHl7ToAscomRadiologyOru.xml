<code name='12. Prepare OBR-16 Dr. Info' xpos='200' ypos='1850' >
<![CDATA[ $$$TRACE("12  Prepare Dr.ID to map to OBR-16.") 
 
  set drIdObr161 = request.GetValueAt("OBR:16(1).1") 
      $$$TRACE("drIdObr161 is " _ drIdObr161 ) 
  set drLastNameObr162 = request.GetValueAt("OBR:16(1).2.1") 
      $$$TRACE("drLastNameObr162 is " _drLastNameObr162 ) 
  set drFirstNameObr163 = request.GetValueAt("OBR:16(1).3") 
  set drMidInitialObr164 = request.GetValueAt("OBR:16(1).4") 
  
  set drIdPv171 = request.GetValueAt("PV1:7(1).1")
      $$$TRACE("drIdPv171 is " _ drIdPv171) 
      
  set drLastNamePv172 = request.GetValueAt("PV1:7(1).2.1")
      $$$TRACE("drLastNamePv172 is " _ drLastNamePv172 ) 
      
  set drFirstNamePv173 = request.GetValueAt("PV1:7(1).3") 
      $$$TRACE("drFirstNamePv173 is " _ drFirstNamePv173) 
  
  set drMidInitialPv174 = request.GetValueAt("PV1:7(1).4")
      $$$TRACE("drMidInitialPv174 is " _ drMidInitialPv174)   

  if ((drIdObr161 '= "") && (drLastNameObr162 '= ""))
  {
    set context.OrderDrID = drIdObr161 
    $$$TRACE("OBR-16.1 Ordering Doctor ID is " _ context.OrderDrID ) 
    
    set context.OrderDrLastName = drLastNameObr162
    $$$TRACE("OBR-16.2 Ordering Doctor last name is " _ context.OrderDrLastName ) 
    
    set context.OrderDrFirstName = drFirstNameObr163
    $$$TRACE("OBR-16.3 Ordering Doctor first name is " _ context.OrderDrFirstName) 
    
    set context.OrderDrMidInitial = drMidInitialObr164
    $$$TRACE("OBR-16.4 Ordering Doctor middle initial is " _ context.OrderDrMidInitial)         
    
  } 
  elseif ((drIdPv171 '= "") && (drLastNamePv172 '= ""))
  {
    set context.OrderDrID = drIdPv171
    $$$TRACE("PV1-7.1 attending Doctor ID is " _ context.OrderDrID) 
    
    set context.OrderDrLastName = drLastNamePv172
    $$$TRACE("PV1-7.2 Doctor last name is " _ context.OrderDrLastName ) 
    
    set context.OrderDrFirstName = drFirstNamePv173
    $$$TRACE("PV1-7.3 Doctor first name is " _ context.OrderDrFirstName)     
    
    set context.OrderDrMidInitial = drMidInitialPv174
    $$$TRACE("PV1-7.4 Doctor middle initial is " _ context.OrderDrMidInitial)   
    
  }
  else 
  {
    set context.OrderDrID = context.OBR16OrderDrEmptyValue
    $$$TRACE("OBR-16.1 Ordering Doctor ID is set to empty" _ context.OrderDrID ) 
    
    set context.OrderDrLastName = context.OBR16OrderDrEmptyValue
    $$$TRACE("OBR-16.2 Ordering Doctor last name is set to empty" _ context.OrderDrLastName )

    set context.OrderDrFirstName = context.OBR16OrderDrEmptyValue
    $$$TRACE("OBR-16.3 Ordering Doctor last name is set to empty" _ context.OrderDrFirstName)     
    
    set context.OrderDrMidInitial = context.OBR16OrderDrEmptyValue
    $$$TRACE("OBR-16.4 Ordering Doctor middle initial is set to empty" _ context.OrderDrMidInitial)     
     
  }]]]]><![CDATA[>
</code>
<code name='13. Prepare OBR-32 ' xpos='200' ypos='1950' >
<![CDATA[ $$$TRACE("13 Prepare principal interpreter info to map to OBR-32.") 
 
  //set context.Obr32DrId = ""
  set drIdObr321 = request.GetValueAt("OBR:32(1).1.1") 
  set drLastNmObr322 = request.GetValueAt("OBR:32(1).1.2.1") 
  set drFirstNmObr323 = request.GetValueAt("OBR:32(1).1.3") 
  set drMidInitilObr324 = request.GetValueAt("OBR:32(1).1.4") 
    
  set drIdObx161 = request.GetValueAt("OBXgrp(1).OBX:16(1).1")
  set drLastNmObx162 = request.GetValueAt("OBXgrp(1).OBX:16(1).2.1")
  set drFirstNmObx163 = request.GetValueAt("OBXgrp(1).OBX:16(1).3")
  set drMidInitilObx164 = request.GetValueAt("OBXgrp(1).OBX:16(1).4")
  
  
  if ((drIdObr321 '= "") && (drLastNmObr322 '= ""))
  {
    set context.Obr32DrId = drIdObr321
    $$$TRACE("OBR-32.1 principal interpreter ID is " _ context.Obr32DrId) 
    
    set context.Obr32DrLastName = drLastNmObr322
    $$$TRACE("OBR-32.2 principal interpreter last name is " _ context.Obr32DrLastName) 
    
    set context.Obr32DrFirstName = drFirstNmObr323
    $$$TRACE("OBR-32.3 principal interpreter first name is " _ context.Obr32DrFirstName) 
    
    set context.Obr32DrMidInitial = drMidInitilObr324
    $$$TRACE("OBR-32.4 principal interpreter middle initial is " _ context.Obr32DrMidInitial)         
    
  } 
  elseif ((drIdObx161 '= "") && (drLastNmObx162 '= ""))
  {
    set context.Obr32DrId = drIdObx161
    $$$TRACE("OBX-16-1 Ordering Doctor ID is " _ context.Obr32DrId) 
    
    set context.Obr32DrLastName = drLastNmObx162
    $$$TRACE("OBX-16-2 Ordering Doctor last name is " _ context.Obr32DrLastName ) 
    
    set context.Obr32DrFirstName = drFirstNmObx163
    $$$TRACE("OBX-16-3 Ordering Doctor first name is " _ context.Obr32DrFirstName )     
    
    set context.Obr32DrMidInitial = drMidInitilObx164
    $$$TRACE("OBX-16-4 Ordering Doctor middle initial is " _ context.Obr32DrMidInitial )   
    
  }
  else 
  {
    set context.Obr32DrId = context.principalInterpreterIdSetToDefault
    $$$TRACE("OBR-32.1 principal interpreter ID is set to default -->" _ context.Obr32DrId ) 
    
    set context.Obr32DrLastName = context.principalInterpreterLastNmSetToToDefault 
    $$$TRACE("OBR-32.2 principal interpreter last name is set to default -->" _ context.Obr32DrLastName )

    set context.Obr32DrFirstName = context.principalInterpreterFirstNmSetToToDefault
    $$$TRACE("OBR-32.3 principal interpreter last name is set to default -->" _ context.Obr32DrFirstName )     
    
    set context.Obr32DrMidInitial = context.principalInterpreterMidInitialSetToToDefault
    $$$TRACE("OBR-32.4 principal interpreter middle initial is set to default -->" _ context.Obr32DrMidInitial)     
     
  }
  
  //To mimic GeRis to Ascom mapping for OBR-32, which is not confirming to the true HL7 standard, 
  //a single string needs to be formed with all the doctor info in it separated with "^" and map
  //it to the OBR-32.1 field.
  
  set context.Obr32DrId = context.Obr32DrId _"^" _context.Obr32DrLastName _"^" _context.Obr32DrFirstName _"^" _context.Obr32DrMidInitial
  
  $$$TRACE("OBR-32 single string for principal interpreter credential is -->" _ context.Obr32DrId )
  ]]]]><![CDATA[>
</code>
<transform name='14. Transform' class='IHC.ITF.Transform.Dtl.CernResultsHl7ToAscomRadiologyOru' source='request' target='context.updatedMsg' xpos='200' ypos='2050' >
<annotation><![CDATA[translate to Ascom HL7 format]]]]><![CDATA[></annotation>
</transform>
<code name='15.  process OBX-5' xpos='200' ypos='2150' >
<annotation><![CDATA[process OBX-5
]]]]><![CDATA[></annotation>
<![CDATA[   $$$TRACE("15. In process OBX-5.")
   $$$TRACE("The pv12PatClasPV1-2 Patient Class Rep should be Emergency: " _ context.pv12PatClass ) 
   
    set context.obx5StrOut = ""
   // set tmp = "" 
    
    $$$TRACE("PV1-2 Patient Class should be E(mergency) at this point: " _ context.pv12PatClass )
   	   
   //Mapping this value with HDD rep will follow De's code.
    $$$TRACE("The OBR-25 result status should be A or F -->" _ context.obr25ResStatus  _"<--")
    	  	
    if (context.obr25ResStatus ="A"){  //Addendum case
 	  $$$TRACE("The OBR-25 result status is a Final report: " _ context.obr25ResStatus )
 	  
 	  //Prepare the OBX-5 output string with the predefined message
 	  set context.obx5StrOut = context.PredefinedMsgForAddendumRpt
 	  $$$TRACE("The context.PredefinedMsgForAddendumRpt is: " _ context.obx5StrOut) 
 	  	  	 
    }elseif (context.obr25ResStatus ="F"){  //Final-Impression case and Final with no Impression case
          $$$TRACE("The Final report with Impression case: " _ context.obr25ResStatus)      
	 
	  //OBX-5 loop
	  set hasImpressionFlag = "0"
	  set noImpressionNoAddendumRptFlag = "0"
	  set impressionStr = "" 
	  
 	  set k1="",tSC=1 
 	  For { 
             Set k1=request.GetNextIndex("OBXgrp()",k1,.tSCTrans)  Quit:k1=""          
             set obx5StrIn = request.GetValueAt("OBXgrp("_k1_").OBX:ObservationValue()")
                                  
             if (obx5StrIn '= "" && hasImpressionFlag = "0"){
                  set obx5StrInTmp = obx5StrIn 
 	          $$$TRACE("OBX-5 tmp string before uppercase is " _ obx5StrInTmp )	
 	           
 	          set obx5StrInTmp = ##class(Ens.Util.FunctionSet).ToUpper(obx5StrInTmp)
 	          $$$TRACE("OBX-5 tmp string all has the upper case: " _ obx5StrInTmp)	
 	           
 	          set impressionStartPos = -1
 	          set impressionStartPos = $FIND(obx5StrInTmp, "IMPRESSION:")
  	
 	 	  if (impressionStartPos > 0){
 	  	     $$$TRACE("The impressionStartPos: is " _ impressionStartPos )
 	  	     set hasImpressionFlag = "1"
 	  	     $$$TRACE("The hasImpressionFlag is true: " _ hasImpressionFlag )
 	  	   
 	  	     //set impressionStr = "" 	  	   
 	  	     set impressionStr = $EXTRACT(obx5StrIn, impressionStartPos,*) 
 	  	     $$$TRACE("This is the first substring after Impression: " _ impressionStr )
 	  	     
 	  	     //Replace all the tildes in the string with a space char
 	  	     set tmp = impressionStr
 	  	     $$$TRACE("The string with tildes in it before space char replacement-->" _ tmp )
 	  	     set impressionStr = $TRANSLATE(tmp, "~", " ")
  	  	     $$$TRACE("The string after space char replacement should have no tildes in it-->" _impressionStr )	  	     
 	  	     
 	  	  }else{
 	  	     //This OBX-5 repeat search found no Impression in it.
 	  	     //Set up a flag to indicate this OBX-5 has no Impression
 	  	     set noImpressionNoAddendumRptFlag = "1"
 	  	     $$$TRACE("The noImpressionNoAddendumRptFlag has turned on: " _ noImpressionNoAddendumRptFlag)
 	  	  }	 
 	  	   
 	     }elseif (obx5StrIn '= "" && hasImpressionFlag = "1"){
 	      	     set tmp = obx5StrIn
 	  	     $$$TRACE("The string has tildes in it before space char replacement-->" _ tmp )
 	  	     set obx5StrIn = $TRANSLATE(tmp, "~", " ")
  	  	     $$$TRACE("The string after space char replacement should have no tildes in it-->" _impressionStr )	
  	  	     
 	             //Add a space char both before the OBX-5 string to as separator.
 	       	     set impressionStr = " " _obx5StrIn
 	  	     $$$TRACE("Each subsequent OBX-5 string appended to the first Impression string should have a space in between as a separator.-->" _ impressionStr _"<--" )
             }else{

 	  	   $$$TRACE("If coming into the block, that means this OBX-5 is empty.  Then just ignore it.")
             }
 	  	  		  	  	
 	     //Append subsequent OBX-5 text to the Impression report
 	     //Add space at the end of each OBX-5 repeat to separate the following one
 	     set context.obx5StrOut = context.obx5StrOut _impressionStr
 	  	
  	     $$$TRACE("The obx5StrOut built with Impression is: " _ context.obx5StrOut )        
 	           
 	   } //end of For loop
	 
	   if ((context.obx5StrOut '= "") && (hasImpressionFlag = "1"))
	   {
	      set context.obx5StrOut = "Impression: " _context.obx5StrOut
	   } 
	    elseif (noImpressionNoAddendumRptFlag = "1")
	   {
	      set context.obx5StrOut = context.PredefinedMsgForFinalRptWithNoChange
 	      $$$TRACE("This is a case of Final report with no Impression and no Addendem in it.  The display message context.PredefinedMsgForFinalRptWithNoChange is: " _ context.PredefinedMsgForFinalRptWithNoChange) 
 	   }
 	   else
 	   { 
 	     $$$TRACE("This is the case when the obx5StrOut is empty.  Just ignore it.")
 	   }
     
      } //end of all possible three obr25ResStatus cases
 	

   
   $$$TRACE("The whole OBX-5 output build at the end of Step#17 is " _ context.obx5StrOut)
  ]]]]><![CDATA[>
</code>
<code name='16. OBX-5 outtput length' xpos='200' ypos='2250' >
<![CDATA[   //The text display in the handset device has 5,000 characters limit.
   $$$TRACE("16. OBX-5 string after Max size check." ) 	 
   set obx5StrOutTemp = ""
   set tmpStrForObx5 = ""
   
   set obx5StrOutTemp = context.obx5StrOut
   $$$TRACE("16.1  obx5StrOutTemp: "  _obx5StrOutTemp)   
   
    if ($LENGTH(context.obx5StrOut) <= 0){
     	//Add error out handling code
     	$$$TRACE("16.2 OBX-5 text string is empty at the size-check: " _ context.obx5StrOut ) 
     	set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The OBX-5 build is Null or empty. Skip the record." _ request.RawContent) 
     	                                           
    }elseif ($LENGTH(context.obx5StrOut) > context.obx5StrOutLimit){
 	
    	$$$TRACE("16.3 OBX-5 string is beyond the size limit: " _ context.obx5StrOutLimit)
    	 set obx5StrOutTemp = context.obx5StrOut
    	 
    	 set sizeLimit = context.obx5StrOutLimit
     	 
    	 set tmpStrForObx5 = $EXTRACT(obx5StrOutTemp, 0, sizeLimit)
    	 $$$TRACE("16.4 context.tmpStr after max limit sizing: " _ tmpStrForObx5)
    	 	
  	if (tmpStrForObx5 = ""){
  	    //Erorr occured in down sizing the OBX-5 string to its limit.
  	    $$$TRACE("16.5 OBX-5 text string is empty after max size cut. Error out and skip record.")
  	  
  	    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The OBX-5 build after resize is empty. Skip the record." _ request.RawContent) 	
  	}else {
  	    set context.obx5StrOut = tmpStrForObx5  _context.obx5StrOverSizeNotice
   	    $$$TRACE("16.6 OBX-5 text with its over size notice: " _ context.obx5StrOut ) 	
  	}	  	 
     
    }else{
    //
    }
    
   $$$TRACE("16.7 OBX-5 string after Max size check: " _ context.obx5StrOut ) 	
    ]]]]><![CDATA[>
</code>
<code name='17. Populate the OBX-5' xpos='200' ypos='2350' >
<annotation><![CDATA[Populate the OBX-5 with the one of the six scenario text]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("15. Before calling the setValueAt  OBX-5 text with its over size notice: " _ context.obx5StrOut ) 
 
  Do context.updatedMsg.SetValueAt(context.obx5StrOut, "OBXgrp(1).OBX:ObservationValue(1)")
  
  $$$TRACE("15.1  After calling the updateMsg.SetValueAt with the OBX-5 output: " _ context.obx5StrOut ) ]]]]><![CDATA[>
</code>
<trace name='18. Output after transforms' value='"Message after Transform: " _ context.updatedMsg.OutputToString()' xpos='200' ypos='2450' >
<annotation><![CDATA[Echo translated output]]]]><![CDATA[></annotation>
</trace>
<code name='19. setup target list' xpos='200' ypos='2550' >
<![CDATA[   
 //TargetConfigNames validation
 set targetConfigNames=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TargetConfigNames",.pstatus)
 if ( ($$$ISERR(pstatus)) || (targetConfigNames= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get targetConfigNames, shutting down.")   
 } else {
    $$$TRACE("TargetConfigNames: " _ targetConfigNames)
