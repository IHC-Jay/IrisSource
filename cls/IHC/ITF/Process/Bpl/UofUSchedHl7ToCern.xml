<code name='getMessageType.TriggerEvent' xpos='200' ypos='650' >
<annotation><![CDATA[get Message type]]]]><![CDATA[></annotation>
<![CDATA[     
     Set msgType =request.GetValueAt("MSH:MessageType.TriggerEvent")
     $$$TRACE("Trigger Event: " _ msgType) 
     set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedEventTypes",.AllowedSiuEvents) 
     if ($$$ISOK(pstatus)&&(AllowedSiuEvents '="")){    	
    	$$$TRACE("Value of allowed SIU events="_AllowedSiuEvents)
    	if ($LISTFIND($LISTFROMSTRING(AllowedSiuEvents,","), msgType) = 0) {	     
	      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "***Found an event type: ["_msgType_"] that does not match a value from the Allowed list of event types :["_AllowedSiuEvents_"]")
     	}else{
	     	Set apptStatus =request.GetValueAt("SCH:25.1")
     		$$$TRACE("Appointment Status: " _ apptStatus) 
     		set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedApptStatus",.allowedApptStatus) 
     		if ($$$ISOK(pstatus)&&(allowedApptStatus '="")){  
     		  $$$TRACE("Value of allowed appt status ="_allowedApptStatus) 	
     		  if ($LISTFIND($LISTFROMSTRING(allowedApptStatus,","), apptStatus) = 0) {	     
	     		 set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "***Found an Appointment Status: ["_apptStatus_"] that does not match a value from the Allowed list of appt status :["_allowedApptStatus_"]")
     		  }		       		
     		}
	    }     	
 	 } else {
    	$$$TRACE("Config setting for AllowedSiuEvents not Available")
    	set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Initialization error, No configuration for AllowedEventTypes found in the Additional Settings.")
 	 }
    ]]]]><![CDATA[>
