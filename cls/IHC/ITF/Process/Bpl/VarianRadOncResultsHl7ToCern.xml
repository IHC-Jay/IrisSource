<transform name='Translate VarianRadOnc Hl7 MDM to Cerner Hl7' class='IHC.ITF.Transform.Dtl.VarianRadOncResultsHl7ToCern' source='request' target='response' xpos='200' ypos='1350' />
<code name='GetTargetConfigList' xpos='200' ypos='1450' >
<![CDATA[ ///   set st = ##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList)
 ///$$$TRACE("Count: " _ context.targetList.Count())
  set facId = "CERN-"_##class(Ens.Util.FunctionSet).ToUpper(request.GetValueAt("MSH:4"))
  $$$TRACE("Sending facility: " _ facId ) 
  
  
  set targetConfigNames = ##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TargetConfigNames",.pstatus)
 if ($$$ISOK(pstatus)){
 	$$$TRACE("TargetConfigNames: " _ targetConfigNames)
 }else{
	 Set status = $$$ERROR("Initialization error, Target Config Names is not set.")
 } 
   
   SET countdown=$LENGTH(targetConfigNames,",")
   SET countup=1
   FOR reps=countdown:-1:1 {
      SET extract=$PIECE(targetConfigNames,",",countup)
      $$$TRACE(countup_" "_extract)
      set tfac = ##class(Ens.Util.FunctionSet).ToUpper(extract)
      if ((##class(Ens.Util.FunctionSet).Contains(tfac, "OUT")) || (##class(Ens.Util.FunctionSet).Contains(tfac, facId))) {
        set st = context.targetList.Insert(extract)
        $$$TRACE("Added target: "_extract)
      }
      SET countup=countup+1
   }
   $$$TRACE("Final Target Count: " _ context.targetList.Count())]]]]><![CDATA[>
