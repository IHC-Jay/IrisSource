<![CDATA[ $$$TRACE("Create rep to ncid request Object...")
 set context.hddNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()  
 set facId = request.GetValueAt("MSH:4.1") 
 $$$TRACE("MSH-4.1: "_facId)
 if (facId '="") {
    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, facId, context.IhcFacDomain,context.ihcInterfaceContext, "MSH4:SendingFac")   
 }	
 
 set pidSexRep = request.GetValueAt("PID:8") 
 $$$TRACE("PID-8: "_pidSexRep)
 if (pidSexRep '="") {
    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, pidSexRep, context.ihcGenderDomain,context.ihcInterfaceContext, "PID8:Sex")   
 }
 
 set pClass = request.GetValueAt("PV1:2") 
 $$$TRACE("PV1-2: "_pClass)
 if (pClass '="") {
    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, pClass, context.IhcPClassDomain,"6490387", "PV12:PClass")   
 }
 
 set docType= request.GetValueAt("TXA:2") 
 $$$TRACE("TXA-2: "_docType)
 if (docType'="") {
    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, docType, context.ReportTypeDomain,context.VarianRadOncContext, "TXA2:RptType")   
 }
 else {
     // Skip message if TXA-2 is empty or invalid ncid
     set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "TXA-2 - Document type id is missing. Skip the record.")	 
 }
 
 set docCompStatus= request.GetValueAt("TXA:17") 
 $$$TRACE("TXA-17: "_docCompStatus)
 if (docCompStatus'="") {
    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, docCompStatus, context.DocCompStatusDomain,context.VarianRadOncContext, "TXA17:DocCompStatus")   
 }
 
  set k1="",tSC=1 
