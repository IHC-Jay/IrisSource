<code name='VerifyOrderType' xpos='200' ypos='1050' >
<annotation><![CDATA[Only allowing Pharmacy Orders]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Verify we have Pharmacy Order... ")
 set msh9MessageType= request.GetValueAt("MSH:MessageType.messagetype")
 $$$TRACE("Here is the Message Type: "_ msh9MessageType)
 set getFirstThreeChar = $Extract(msh9MessageType,1,3)
 $$$TRACE("Here is the compare string: "_getFirstThreeChar ) 
 if ((getFirstThreeChar="RDE") || (getFirstThreeChar="RDS")){
   $$$TRACE("We have a Pharmacy Order! Order Type is: "_ getFirstThreeChar)
 }else{
 $$$TRACE("We don't have a Pharmacy Order, filtering out and skipping record. Order type: "_ msh9MessageType)
 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "HL7 message is not an expected RDE or RDS message type.") 
 }
 ]]]]><![CDATA[>
</code>
<code name='ClinicFiltering' xpos='200' ypos='1150' >
<annotation><![CDATA[Filter Clinic - Checking PV1-18 Patient Type for Clinic and allowed list of clinics against MSH-4]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Do Clinic check. Only a select few are allowed to go to pharmacy.")
 set context.pv1PatientType = request.GetValueAt("PV1:PatientType")
 
 $$$TRACE("Checking against not allowed clinics and clinic patient types")

 $$$TRACE("Here is the patient type value to check against from PV1-18: "_context.pv1PatientType)
 
 if ($LISTFIND($GET(^IHC.CernConnectRxPharmacy("NotAllowedPatientTypes")),context.pv1PatientType )>0) {
 
    $$$TRACE("Found a patient type that matches the not allowed clinic patient type.")
    $$$TRACE("Now checking to see if the MSH-4 is an allowed clinic. ")
     if ($LISTFIND($GET(^IHC.CernConnectRxPharmacy("AllowedPharmClinic")),context.msh4Facility)>0) {
        $$$TRACE("MSH-4 is an allowed Clinic MSH-4 value, it is: " _context.msh4Facility)
     }else{
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "***Found a MSH-4 value that is not in the AllowedPharmClinic List!")
     }
 }
 $$$TRACE("Finished checking for allowed clinics and clinic patient types!!!!")
 
 ]]]]><![CDATA[>
</code>
