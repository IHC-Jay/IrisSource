<code name='SetTargetFromLookup' xpos='200' ypos='2950' >
<annotation><![CDATA[get list of targets to send to for the MSH-4]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Setting target")
 $$$TRACE("Set Target From Lookup - MSH-4 is the KEY and gets Ensemble Operation Name as return value.")
 set targetStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.TargetOperationTable, context.msh4Facility, .retVal )
 if ($$$ISERR(targetStat) || (retVal = "Unknown") || (retVal ="")) {
    set errMsg = "****ERROR: Unable to get a matching Target from the lookup table. ****ERROR MSH-4 VALUE MAYBE MISSING FROM LOOKUP Table: "_$G(^IHC.CernConnectRxPharmacy("LocationOperationsTable"))      
       $$$TRACE(errMsg)
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, errMsg)
 } else {
    $$$TRACE("Target: " _retVal)
    set context.Target = retVal
 }]]]]><![CDATA[>
</code>
<code name='BuildTargetListFromTarget' xpos='200' ypos='3050' >
<annotation><![CDATA[Building Target List from Target value from lookup table]]]]><![CDATA[></annotation>
<![CDATA[ set length = $L(context.Target, ",")
 $$$TRACE("Length of Target Locations=" _length)
 if ((length >=1)&&(context.Target'=""))
 {
    For iTarget=1:1:$L(context.Target, ",") 
        { 
            Set tOneTarget=$ZStrip($P(context.Target,",",iTarget),"<>W")  
            Continue:""=tOneTarget
            
            set stat = context.TargetList.Insert(tOneTarget)
            $$$TRACE("tOneTarget " _ tOneTarget _ " " _ stat)
        }
          $$$TRACE("targetList count " _ context.TargetList.Count())
 }else{
	 $$$TRACE(errMsg)
	 set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errMsg)
 }]]]]><![CDATA[>
</code>
<foreach name='Send To Targets' property='context.TargetList' key='context.TargetIndex' xpos='200' ypos='3150' xend='200' yend='450' >
<annotation><![CDATA[Sending to ConnectRx targets and Vigilanz target]]]]><![CDATA[></annotation>
<call name='SendToEachTarget' target='@context.TargetList.GetAt(context.TargetIndex)' async='1' xpos='200' ypos='250' >
<request type='Ens.Request' >
<assign property="callrequest" value="response" action="set" />
</request>
<response type='Ens.Response' />
</call>
<trace name='TraceOutSendInfo' value='"TargetCountIndex: "_context.TargetIndex_", Message Sent to target: "_ context.TargetList.GetAt(context.TargetIndex)' xpos='200' ypos='350' />
</foreach>
<faulthandlers>
<catchall name='CatchAll' xpos='200' ypos='3250' xend='200' yend='250' >
<annotation><![CDATA[Get and set error status]]]]><![CDATA[></annotation>
</catchall>
</faulthandlers>
</scope>
</sequence>
</process>
