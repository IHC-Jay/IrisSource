<code name='workPV1ThreeLocation' xpos='200' ypos='1750' >
<annotation><![CDATA[Get LocationNcidFrom PV1-3 and Set context Values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Verify we have valid PV1-3 locations for Pharmacy.")
  //Check the PV1-3 location values for NCIDS that Cerner used for Pharmacy locations
 //Check Bed first
 set Ncid = request.GetValueAt("PV1:AssignedPatientLocation.bed")
 if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
    set context.LocationInfo = "PV1:AssignedPatientLocation.bed - Cerner Patient Bed "
    set context.locationNcid = Ncid
    $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDD Context: " _$G(^IHC.CernConnectRxPharmacy("PV1ThreeLocationContext")))
 }else {
    //Otherwise check room next
    set Ncid = request.GetValueAt("PV1:AssignedPatientLocation.room")
    if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
       set context.LocationInfo = "PV1:AssignedPatientLocation.room - Cerner Patient Room"
       set context.locationNcid = Ncid
       $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDD Context: " _$G(^IHC.CernConnectRxPharmacy("PV1ThreeLocationContext")))
    }else {
	   //Well, now you only have the unit (pointofcare) to check next
       set Ncid = request.GetValueAt("PV1:AssignedPatientLocation.pointofcare")
       if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
          set context.LocationInfo = "PV1:AssignedPatientLocation.pointofcare - Cerner Patient POC Unit"
          set context.locationNcid = Ncid
          $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDDContext: " _$G(^IHC.CernConnectRxPharmacy("PV1ThreeLocationContext")))
       }
    }
 }
 if (Ncid="" || '$ISVALIDNUM(Ncid)){
