<code name='HDDCallGetHelp1BillingData' xpos='200' ypos='1650' >
<annotation><![CDATA[Use PV1-18 and PV1-10 to get HDD Help1 Billing return values]]]]><![CDATA[></annotation>
<![CDATA[ set tStatus=process.SendRequestSync(context.hddTargetConfigName,context.hddBillingTypeRequest,.hddHelp1BillingTypeResponse)

 if ('tStatus) {

    set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure when trying to get Help1 Billing Reference Data. "_$SYSTEM.Status.GetOneErrorText(tStatus))    
 
 }
 else {
   set context.hddBillingTypeResponse= hddHelp1BillingTypeResponse
   $$$TRACE( "HDD Return Object Count(GetHelp1BillingType): " _ context.hddBillingTypeResponse.listOfHDDobj.Count())
   set hddObjBillType = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddBillingTypeResponse, "PVOne18And10:PatientTypeAndClass")
   if (hddObjBillType.BillingType '=""){
       set billingTypeString = hddObjBillType.BillingType
       set billingTypeList = $LISTFROMSTRING(billingTypeString, ":")
       $$$TRACE("BillingType List count: "_$LISTLENGTH(billingTypeList))
       set context.pv1PatientType = $LIST(billingTypeList,2)
       set context.pv1PatientClass = $LIST(billingTypeList,1)
   
