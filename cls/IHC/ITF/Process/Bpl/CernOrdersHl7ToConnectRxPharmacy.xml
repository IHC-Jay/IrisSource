      $$$TRACE("Did not get data back from HDD Lookup for PV1-2 and PV1-18.")
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***Cerner Pharmacy Order HL7 message has missing encounter related patient billing data for PV1-2 and PV1-18 from HDD GetHelp1Billing lookup.***")
