 	} 
 }
 $$$TRACE("context.performingLab :"_context.performingLab)
 
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SafeTraceBbBillingHl7.TMISTelcorOnlyFacilities",context.facilityIdNumeric,.ttelcorFac)
    if ($$$ISOK(tStatus)){        
        set context.isTelcorOnlyBilling=1
     }
     $$$TRACE("context.isTelcorOnlyBilling:"_+context.isTelcorOnlyBilling)
     
     
     // Get the Performing LabId
      set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SafeTraceBbBillingHl7.TMISPerformingLabID",context.performingLab,.tperformingLab)
    if ($$$ISOK(tStatus)){        
