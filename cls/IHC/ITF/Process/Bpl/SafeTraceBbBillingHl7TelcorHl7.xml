<code name='Get the Exploding Code' xpos='200' ypos='250' >
<![CDATA[ //Get the Account Number
  set ft1AccountNumbe=request.GetValueAt("FT1grp("_context.ft1Count_").FT1:TransactionCode.identifier",,.statusr)
  
  //Get the Exploding Codes from Look Up
  set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SafeTraceBbBillingHl7.SafeTraceExplodingCodes",ft1AccountNumbe,.taccountNumber)
    if ($$$ISOK(tStatus)){        
        set context.accountNumFromLookUp=taccountNumber
     }else{
        set context.accountNumFromLookUp=ft1AccountNumbe
     }
     
     $$$TRACE("context.accountNumFromLookUp>>"_context.accountNumFromLookUp)
     
     //Clear the list 
     set stat = context.accountNumberList.Clear()
     //SPlit the accountnumber
     For iacc=1:1:$L(context.accountNumFromLookUp, ",") 
        { 
            Set taccnum=$ZStrip($P(context.accountNumFromLookUp,",",iacc),"<>W")  
            Continue:""=taccnum
            
            set stat = context.accountNumberList.Insert(taccnum)
            $$$TRACE("taccnum" _ taccnum_ " " _ stat)
         }
         $$$TRACE("context.accountNumberList count " _ context.accountNumberList.Count())
         
         $$$TRACE("context.ft1Count" _ context.ft1Count)
         ]]]]><![CDATA[>
