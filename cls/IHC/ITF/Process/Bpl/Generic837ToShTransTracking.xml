<code name='Get BHT' xpos='200' ypos='250' >
<annotation><![CDATA[Generate temporary filename for each transaction set (ST-SE)]]]]><![CDATA[></annotation>
<![CDATA[
 try {
       
       set context.individualST=context.stDoc.GetAt(context.STCounter)
       
       /* Extract GroupID information from X12 to be used in filename */
  
        set bhtIDpath="BHT"
        set bhtIDind=context.individualST.GetSegmentIndex(bhtIDpath,.bhtIDstatus)  
        set context.refID=context.individualST.GetValueAt(bhtIDind_":3")
        set context.transSetControlNumber=context.individualST.GetValueAt("ST:2")
 
       
       
        $$$TRACE("BHT:" _ bhtIDpath _ bhtIDind _": " _ context.refID _", ST:2: " _ context.transSetControlNumber)
       
       
     
       set context.loopAind = 1
       set context.HLParsing="0"
        
     }
     Catch ex
     {  
       if 1=ex.%IsA("%Exception.SystemException") 
    {
      Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Transaction level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
    }
    else 
    {  
      Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Transaction level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
    }
       
     }
  
  

 
 ]]]]><![CDATA[>
