<code name='Parse ISA and collect GS level' xpos='200' ypos='750' >
<annotation><![CDATA[Parse X12 and split at GS level]]]]><![CDATA[></annotation>
<![CDATA[
 
 if (request.%Extends("IHC.ITF.DStruc.TransTrackingRecord"))
 {
    if (request.x12Message.%Extends("%Stream.GlobalCharacter"))
    {
        $$$TRACE("Import X12 from: " _ request.x12Message)
	 set context.x12Doc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.x12Message, .pStatus)
	 $$$TRACE("ImportFromLibraryStream status: " _ pStatus)
	 
    }
    else
    {
       Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"request.x12Message is not Stream " _ request.x12Message)
       
    }
	 
 }

 else
 {
	   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message: " _ request)
 }
 
 
 /* Check if the received data is a X12 file or not and report error if it is not a X12 message. Parse the Interchange Level and extract number of Group level (GS-GE) count, SenderID (ISA06), ControlNumber (ISA13) and UsageIndicator (ISA15). Iterate through each GS level and place each group object in a collection list */
 
 
 if (context.x12Doc.%Extends("EnsLib.EDI.X12.Document"))
 {
 
   try
   {          
       /* Setting request message to X12 Interchange structure and gather number of child segment (GS-GE) count */
       
       set context.x12Doc.DocType = "HIPAA_5010:Interchange:Group" 
       set context.GSCounter = context.x12Doc.ChildCount
       
       /* Extracting InterchangeSenderID, Interchange ControlNumber and Interchange usage indicator values from X12 */
 
       set context.ISA06 = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeSenderID"),"<>W") 
       set context.ISA13 = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeControlNumber"),"<","0")
       set context.ISA15 = context.x12Doc.GetValueAt("ISA:UsageIndicator")
 
       /* Iterates through available number of group's and collects group level information and sets to gsDoc object */
          
          for i=1:1:context.GSCounter
          { 
            set x = context.x12Doc.getNthChild(i,2)
            do context.gsDoc.SetAt(x,i) 
          }  
         
    }
    Catch ex 
    { 
      if 1=ex.%IsA("%Exception.SystemException") 
      {
        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Interchange level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
      }
      else 
      {       
       Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Interchange level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)  
      }  
    }  
 } 
 else
 {
  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message ")
 } 
]]]]><![CDATA[>
