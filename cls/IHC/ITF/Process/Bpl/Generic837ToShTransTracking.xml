<while name='X12 2000A Iteration' condition='context.HLParsing="0"' xpos='200' ypos='800' xend='200' yend='900' >
<annotation>iterate through all the segments of the X12 2000A set </annotation>
<code name='Split individual X12 records' xpos='200' ypos='250' >
<annotation><![CDATA[Split large X12 into individual X12 files with single 2000A loop]]]]><![CDATA[></annotation>
<![CDATA[ /* Setting message to X12 837 TransactionSet */
 
 set STRecord=context.individualST 
 set STRecord.DocType="HIPAA_5010:837P" 

 
 /* Define HL segment path's for both 2000A and next iteration of 2000A loop */
 
 set cur2000Apath="loop2000A("_context.loopAind_").HL"
 set cur2000Aind=STRecord.GetSegmentIndex(cur2000Apath,.cur2000Astatus)
 $$$TRACE(cur2000Apath _": " _ cur2000Aind _ "= " _ STRecord.GetValueAt(cur2000Aind))
 if (cur2000Astatus '= 1)
 {
   set context.HLParsing = "1"
   /* Capture the closing segment(SE) of Transaction Set */
   set sesegment=STRecord.GetValueAt(STRecord.SegCount)  
   $$$TRACE("SE # " _ STRecord.SegCount _": " _ sesegment)
   set context.loop2000Aite = context.loop2000ACount + 1
   set context.cur2000Astatus = 0
  
 }
 else
 {
   set context.cur2000Astatus = 1
   set context.cur2000Bstatus = 1
   set context.loop2000Bite = 1
   set context.loopBind = 1
   set context.loop2000Aite = cur2000Aind
   set cur2000Anxt="loop2000A("_(context.loopAind+1)_").HL"
   set nxt2000Aind=STRecord.GetSegmentIndex(cur2000Anxt,.cur2000Astatus)

  if (cur2000Astatus = 1)
  {
    set context.loop2000ACount = nxt2000Aind - 1
    // $$$TRACE("Next loop A: " _ context.loop2000ACount)
  }
  else
  {
      set context.loop2000ACount = STRecord.SegCount - 1
   }
   // $$$TRACE(cur2000Anxt_": " _ nxt2000Aind _ " -> " _ STRecord.GetValueAt(context.loop2000ACount) )
   
  }
  
]]]]><![CDATA[>
</code>
<if name='More' condition='context.loop2000ACount &gt;= context.loop2000Aite' xpos='200' ypos='350' xend='200' yend='800' >
<true>
<trace name='splited each 2000A X12' value='"Loop A " _ context.loop2000Aite _ " B: " _ context.loopBind' xpos='470' ypos='500' />
<while name='X12 2000B Iteration' condition='context.cur2000Bstatus = 1' xpos='470' ypos='600' xend='200' yend='1450' >
<annotation>iterate through all the segments of the X12 2000B set </annotation>
<code name='Split individual X12 records' xpos='200' ypos='250' >
<annotation><![CDATA[Split large X12 into individual X12 files with single 2000B loop]]]]><![CDATA[></annotation>
<![CDATA[ /* Setting message to X12 837 TransactionSet */
 
 set STRecord=context.individualST 
 set STRecord.DocType="HIPAA_5010:837P" 

 
 /* Define HL segment path's for both 2000B and next iteration of 2000B loop */
 
 set cur2000Bpath="loop2000A("_(context.loopAind)_").loop2000B("_context.loopBind_").HL"
 set cur2000Bind=STRecord.GetSegmentIndex(cur2000Bpath,.cur2000Bstatus)
 $$$TRACE(cur2000Bpath _": " _ cur2000Bind _ "= " _ STRecord.GetValueAt(cur2000Bind) _"; B current status: " _ cur2000Bstatus)
 if (cur2000Bstatus =1)
 {
	set context.childCode = STRecord.GetValueAt(cur2000Bpath_":4")
	if (context.childCode = 1)
	{
		$$$TRACE("Get Loop 2000C for " _ cur2000Bpath)
	}
      set context.cur2000Bstatus = 1
      set context.cur2300status = 1
      set context.loop2300ite = 1
      set context.loopClmInd = 1
      set cur2000Bnxt="loop2000A("_(context.loopAind)_").loop2000B("_(context.loopBind+1)_").HL"
      set nxt2000Bind=STRecord.GetSegmentIndex(cur2000Bnxt,.cur2000Bstatus)
   
 
     set context.loop2000Bite = cur2000Bind
     
     // $$$TRACE("Next B: " _ cur2000Bnxt _ ", index: " _ nxt2000Bind _ "; status: " _ cur2000Bstatus)
     
     if (cur2000Bstatus = 1)
     {
       set context.loop2000BCount = nxt2000Bind - 1
