<code name='ValidateDeleteEmpiForMergeType' xpos='200' ypos='850' >
<annotation><![CDATA[Validate Delete Mrn]]]]><![CDATA[></annotation>
<![CDATA[     Set msgType = request.GetValueAt("MSH:MessageType.triggerevent")
      $$$TRACE("Trigger Event: " _ msgType)      
     if (msgType ="A18") {  
       $$$TRACE(" Merge Record ") 
       if (request.GetValueAt("MRG:1(1).4.1")="UN"){
	       set context.deletEmpiNum = request.GetValueAt("MRG:1(1).1")
	       if ($ISVALIDNUM(context.deletEmpiNum) '= "1") {	     
		     set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "MRG-1.1 Delete EMPI :["_context.deletEmpiNum_"] is not valid, skip message.")    		 
		     quit
	       }
	   }
     }   
    ]]]]><![CDATA[>
</code>

<code name='ValidatePatientLastAndFirstName' xpos='200' ypos='850' >
<![CDATA[ 
        set i1=""  
 for {
	 set i1 = request.GetNextIndex(" PID:PatientName()",i1,.tSC)  quit:i1=""
	 if (request.GetValueAt("PID:PatientName("_i1_").familyname.surname") = "") {		 
         set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "PID-5.1 Patient LastName is empty, skip message.")
    	 quit
	 }
	 if (request.GetValueAt("PID:PatientName("_i1_").givenname") = "") {		 
		 set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "PID-5.2 Patient FirstName is empty, skip message.")
    	 quit
	 }
 }
    ]]]]><![CDATA[>
