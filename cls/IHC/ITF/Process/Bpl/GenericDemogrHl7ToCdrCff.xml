<code name='validateMsgStructure' xpos='200' ypos='550' >
<annotation><![CDATA[unMarshall - Check if the message passes the message validation as set in the Validation Settings ]]]]><![CDATA[></annotation>
<![CDATA[  
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Validation",.configValue)  
  if ($$$ISOK(pstatus)){
     set validationSettingValue=configValue
  }
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSettingValue) 
 if (tStatus'=$$$OK){  	
    $$$TRACE("Failed Validation Settings:: " _validationSettingValue)
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Hl7 message validation failed, Skipping the record." _ "Hl7 Msg:" _ request.RawContent)
 }else{
	  $$$TRACE("Passed Validation Settings: " _validationSettingValue) 
 }
 
 ]]]]><![CDATA[>
