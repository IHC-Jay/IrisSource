<code name='CallHddMethodForEvn5' xpos='200' ypos='750' >
<annotation><![CDATA[CallHddMethod- get employee name from Employee Ncid]]]]><![CDATA[></annotation>
<![CDATA[ 
  set employeeNcid = request.GetValueAt("ZZZ:Employee") 
  $$$TRACE("Employee Ncid is " _ employeeNcid)		  	
  	if (($ISVALIDNUM(employeeNcid)= "1") && (employeeNcid '="100")){		
		set context.userName=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(employeeNcid, context.hddContextName, context.hddTargetConfigName, .process)
		$$$TRACE("User Name is " _ context.userName)	
		if (context.userName = "" || context.userName = "ERROR"){
			$$$TRACE("UserName is NOT defined in HDD - Employee Ncid: ["_employeeNcid_"]. Context: ["_context.hddContextName_"]. Hdd Method: getUniqueRepByNcid")	
			set status = ##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "UserName is NOT defined in HDD - Employee Ncid: ["_employeeNcid_"]. Context: ["_context.hddContextName_"]. Hdd Method: getRepFromNcid.")
			$$$TRACE(" Assigning default User Name "_context.defaultUserName)
			set context.userName = context.defaultUserName
		}
	}else{
		if (employeeNcid = "100"){			
			set context.userName = "CERNER,SYSTEM"
		}		
	}
 ]]]]><![CDATA[>
</code>

