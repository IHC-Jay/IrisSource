<code name='CreateHddRepObjectAndAdd' xpos='740' ypos='2400' >
<![CDATA[		  	
  	set context.hddNcidReq  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
  	for {
  		set i1 = request.GetNextIndex("PID:PatientIdentifierList()",i1,.tSC)  quit:i1=""
  		set pid34FacilityVal= request.GetValueAt("PID:PatientIdentifierList("_i1_").assigningauthority.namespaceID")
  		$$$TRACE("pid34FacilityVal--> " _ pid34FacilityVal)
  		if ((pid34FacilityVal '= "") && (pid34FacilityVal'="UN")){
	  		Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidReq , pid34FacilityVal, context.hddFaciltyDomin, context.hddCbContext,  "PID:34"_i1) 
  		} 		 
  	}
]]]]><![CDATA[>
