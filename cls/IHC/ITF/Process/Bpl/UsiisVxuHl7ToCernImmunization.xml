<code name='Call service to get IHC Immunization from iCentra' xpos='200' ypos='950' >
<![CDATA[  $$$TRACE("Call REST Operation")
      set statusCode=""
      set statusDesc=""
      
  if (context.icentraSvcRequest'="") {
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync(process.TargetConfigNameCernEdgeWsrcIMMUNIZATION,context.icentraSvcRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set statusLine=""
      set context.restHttpResponse=httpRESTResponse
      set statusLine=context.restHttpResponse.HTTPHeaders.GetAt("StatusLine")
      if (statusLine'=""){
	set statusCode=$piece(statusLine," ",2)
	set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
		  // If status code is 200 the check the reponse to see if it got processed correctly or not
      if (statusCode'="200"){
        set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"iCentra Attending Doctor search service response with code: "_statusCode_"  Desc: "_statusDesc) 
      }
      else {
        Set tcharStream = ##class(%GlobalCharacterStream).%New()
        Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
        $$$TRACE("tcharStream size:"_tcharStream.Size)
        set text=""
        While 'tcharStream.AtEnd {
          Set text = text_tcharStream.Read($$$MaxStringLength)
        } 
        $$$TRACE("REST Service response data:"_text)
        if (text="") {
           set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Service returned empty string, patient empi may not exist in iCentra, Skip the record. ") 
        }
        else {
           set immuXmlStr=##class(Ens.Util.FunctionSet).SubString(text,39)
           $$$TRACE("IHC Immu data:"_immuXmlStr)
           set context.immuXml=##class(EnsLib.EDI.XML.Document).ImportFromString(immuXmlStr)
           set context.immuXml.DocType="immunizationXmlNN:immunizations"    
           Set cernEmpi=context.immuXml.GetValueAt("immunizations-empi")
           $$$TRACE("Cern EMPI:"_cernEmpi)
           Set k1=""
           set status=$$$OK
           $$$TRACE("Check ADM DT for each drug...")
           For {
	     Set k1=context.immuXml.GetNextIndex("immunization-detail()",k1,.tSCTrans)
	     Quit:k1=""
	     Set admDt= context.immuXml.GetValueAt("immunization-detail("_(k1)_").administered-dt-tm")
	     Set drugId= context.immuXml.GetValueAt("immunization-detail("_(k1)_").drug-identifier")
	     $$$TRACE("Drug ID:"_drugId_"  Adm DT: "_admDt)
	     If (admDt="") {
                set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"Returned immunization does not have administered date. Skip the record for empi: "_cernEmpi) 
                Quit
	     }
           }
        }
      }
    }
    ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Post iCentra Attending Doctor search service request failed with Status Code: "_statusCode_" : Status Desc: "_statusDesc) 
    }
  }  
  ]]]]><![CDATA[>
