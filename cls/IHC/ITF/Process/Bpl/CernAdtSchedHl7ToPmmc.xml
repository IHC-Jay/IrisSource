<code name='FinNumber' xpos='200' ypos='650' >
<annotation><![CDATA[get FinNumber]]]]><![CDATA[></annotation>
<![CDATA[     
     set context.finNumber = ""
     Set pid18 =request.GetValueAt("PID:PatientAccountNumber.ID")
     $$$TRACE("FinNumber(pid-18): " _ pid18) 
     if ($ISVALIDNUM(pid18)){
	     set context.finNumber = pid18
	 }else{
		 set pv119 = request.GetValueAt("PV1:VisitNumber.ID")
		 if ($ISVALIDNUM(pv119)){
			  set context.finNumber = pv119
		 }else{
			 set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, " Invalid or blank fin number: "_context.finNumber_" from iCentra adt. Skipping the record..")
		 }		 
