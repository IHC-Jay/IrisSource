<code name='CheckForSelfPay' xpos='200' ypos='650' >
<annotation><![CDATA[Check SelfPay]]]]><![CDATA[></annotation>
<![CDATA[
    set isSelfPay = "0"
	set k1="",tSC=1  
    
    For { 
     Set k1=request.GetNextIndex("IN1grp()",k1,.tSCTrans)  Quit:k1=""      	     
     
	 	set insPlanDesc = request.GetValueAt("IN1grp("_k1_").IN1:InsurancePlanID.text") 
	 	$$$TRACE("Insurance plan Description:: " _ insPlanDesc)   
	 	if ($ZCONVERT(insPlanDesc,"U")["SELF PAY"){
		 	set isSelfPay = "1"
		}  
     
    }
    
    if (isSelfPay="0"){
	    set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, " Insurance plan is not Self pay. Skipping the record..")
	}  
     
    ]]]]><![CDATA[>
</code>




