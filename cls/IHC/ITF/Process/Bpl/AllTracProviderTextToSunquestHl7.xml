<code name='First and/or Mid Names' xpos='200' ypos='650' >
<![CDATA[  //Check if there is a blank space in between the string  
  set nameList= $LISTFROMSTRING(context.FirstNameCombo, " ")
  $$$TRACE("First name combo list: " _nameList )  
  set nameListLength = $LISTLENGTH(nameList) 
  $$$TRACE("First name elements: " _nameListLength )        

  
  if nameListLength=1{	
         set context.FirstName = $LIST(nameList,1)
         $$$TRACE("Just first name with no mid-name initial: " _context.FirstName)  
  
  }elseIF nameListLength>1{
   
	 set nameList1 = $LIST(nameList,1) 
         set nameList2= $LIST(nameList,2)
         $$$TRACE("The nameList1 has the value: " _nameList1_ ".  The nameList2 has the value: " _nameList2)    
          
              
         if (( $LENGTH(nameList1)>2) && ( $LENGTH(nameList2)>2)){
             set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The nameList1 is: " _nameList1_ "The nameList2 is: " _nameList2_ "Usually the first name in full is followed by the middle name initial.  But here both names are in full, hard to tell which is the middle name. Skip the record and send it to business support group via support email for fix."  )               
         }  

                

         if ($LENGTH(nameList2)<3){
             set lastChar = $EXTRACT(nameList2,*)
             if ((lastChar =".") || ($LENGTH(nameList2)=1)){
                 set context.MidName = nameList2 
                 set context.FirstName = nameList1 
                 $$$TRACE("The nameList2 is the mid-name initial with/out a dot: " _context.FirstName)     
             }else{
                 set lastChar = $EXTRACT(nameList1,*)
                 if ((lastChar =".") || ($LENGTH(nameList1)=1)){
                     set context.MidName = nameList1 
