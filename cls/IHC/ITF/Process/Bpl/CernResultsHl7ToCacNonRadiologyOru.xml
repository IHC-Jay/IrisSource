    $$$TRACE("ExcludedLocations : "_ExcludedLocations) 
    $$$TRACE("ExcludedLocations Count: "_$L(ExcludedLocations, ",")) 
    For iTarget=1:1:$L(ExcludedLocations, ",") 
        { 
        
        //$$$TRACE("For loop index "_iTarget) 
            Set tOneTarget=$ZStrip($P(ExcludedLocations,",",iTarget),"<>W") 
            $$$TRACE("tOneTarget.. "_tOneTarget)
            Continue:""=tOneTarget
              
            
            if (context.Location = tOneTarget)
            {
	            $$$TRACE("Location Excluded")
	            set context.isAcceptedLocation = 0
	            QUIT
            } 
    

         }

 }else{
	 $$$TRACE("Config setting for ExcludedLocation not Available")
