<![CDATA[ // Route the X12 based on TP
 set x12Doc = response
	 if ( ($ISOBJECT(x12Doc)) && (x12Doc.%Extends("EnsLib.EDI.X12.Document")) )
	 {
	    set x12Doc.docType ="277_X0B3:Interchange"
	    set tSC =x12Doc.BuildMap()
	    set InterchangeReceiverID = $ZSTRIP(x12Doc.GetValueAt("ISA:InterchangeReceiverID"), "<>W")
            set tpInfo = ##class(IHC.ITF.ITFCOMMON.EdiX12utils).GetTpLinkInfo(InterchangeReceiverID , "277", "V5010X214", "Batch")
            $$$TRACE(InterchangeReceiverID _ ": Tp Info : " _ tpInfo)
            set snipLevel = $PIECE(tpInfo, "#", 3)
            
            set tSC = ##class(Ens.X12.FunctionSet).X12ValidateDocument(x12Doc, "SNIP", snipLevel)

			if ($$$ISERR(tSC))
			{
				$$$LOGERROR( " -*- X12 Validation failed, " _ tpInfo _ ", RawContent length: " _ $L(x12Doc.RawContent))
				#dim replyDoc as EnsLib.EDI.X12.Document
				set replyDoc = ##class(Ens.X12.FunctionSet).X12BatchReply(x12Doc, "All", "SNIP", snipLevel, "All") 
				  if ($IsObject(replyDoc))
				  {
				  	 
					  $$$TRACE("X12 Error: " _  replyDoc.RawContent)
					  
				  }

                        }
                        else
                        {
                            $$$TRACE("Validation passed. SNIP level: " _ snipLevel)
                            $$$TRACE("Send X12 to " _ $PIECE(tpInfo, "#", 1))
                            set tRequest = ##class(Ens.StreamContainer).%New("")
                            set tStream=##Class(%Library.GlobalCharacterStream).%New()
                            set pStatus = response.OutputToLibraryStream(tStream)
                            set tRequest.Stream = tStream  

	//set reqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream)

	//set reqObj.DestinationFileName = "sample277CA"
	set tStatus = process.SendRequestAsync("Out-Uhin-277CA-Sftp-SH",tRequest)
                        } 
 }
 else
 {
     $$$LOGERROR(x12Doc  _ " - Not a X12 document")
 }]]]]><![CDATA[>
