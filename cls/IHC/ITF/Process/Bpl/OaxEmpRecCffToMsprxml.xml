 set tmspr=##class(IHC.ITF.DStruc.Schema.MasterProviderRequest.MSPR).%New()
 set tmspr.content=context.MSPRResponseString
 set context.msprMasterRequest.MSPR=tmspr
 set status=request.XMLExportToString(.strOax)
 If ($$$ISOK(status)){
    set tOax=##class(IHC.ITF.DStruc.Schema.MasterProviderRequest.OAX).%New()
    set tOax.content=strOax
    set context.msprMasterRequest.OAX=tOax
