<code name='validate MSPR response' xpos='200' ypos='1450' >
<![CDATA[  // Validate the response by loading it to the IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo structure
 set status=$$$OK
 set replstr="<?xml version="_""""_"1.0"_""""_"?>"
 set context.MSPRResponseString=$Replace(context.strXmlProxyResponse.StringValue,replstr,"")
 // Remove the XMl Version tag from start and Junk characters at the end
 set context.MSPRResponseString="<CiwsInfo>"_$piece(context.MSPRResponseString,"<CiwsInfo>",2)
 set context.MSPRResponseString=$piece(context.MSPRResponseString,"</CiwsInfo>")_"</CiwsInfo>"
 Set reader = ##class(%XML.Reader).%New()
 Set sc=reader.OpenString(context.MSPRResponseString)
 if '$$$ISOK(sc){
     set stattus=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
  } 
  Else {
      Do reader.Correlate("CiwsInfo","IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo")
      do reader.Next(.CiwsInfo,.sc)
      If $$$ISOK(sc){
	       $$$TRACE("Resposne back from MSPR parsed successfully.")
         // check if the the request was successfuly posted to MSPR
         set status=##class(IHC.ITF.Process.Bpl.OaxEmpRecCffToMsprxml).ValidateMSPRResponse(CiwsInfo,process.%ConfigName)
         
         If $$$ISOK(status){
	        $$$TRACE("Message posted successfuly to MSPR") 
         }
      }Else
      {     
          set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
      }    
  }
  If ($$$ISOK(status)){
	  // Just remove the junk character at the end for sending it to the other destinations.
	  set context.MSPRResponseString=$piece(context.strXmlProxyResponse.StringValue,"</CiwsInfo>")_"</CiwsInfo>"
  }
  $$$TRACE("ReponseString:"_context.MSPRResponseString)]]]]><![CDATA[>
</code>
<code name='Check for MSPR warning' xpos='200' ypos='1550' >
<![CDATA[ set msprRespVal="<context><completionCode><sType>INF</sType><iNumber>0</iNumber>"
 
 if context.MSPRResponseString'[msprRespVal{
    $$$TRACE("MSPR doesnt containd a valid response there might be warning")
    set msprWar="<context><completionCode><sType>SVR</sType><iNumber>"
    if context.MSPRResponseString'[msprWar{   
         $$$TRACE("skip the message as warning tag is not present")
         set errorMsg="Error in the XML proxy request --- "_context.MSPRResponseString
         set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, errorMsg)         
    }else{
       set errorExtract = $piece(context.MSPRResponseString,"<context><completionCode><sType>SVR</sType><iNumber>",2)
       set error = $EXTRACT(errorExtract,1,5)
       if (error <50000) && (error >39999)  {
         $$$TRACE("Error code received:"_error_"is a warning , message can be processed ") 
       }else{
         $$$TRACE("skip the message as error code is different")
         set errorMsg="Error in the XML proxy request --- "_context.MSPRResponseString
         set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, errorMsg)
       }
    }   
 }]]]]><![CDATA[>
</code>
<code name='To Get the Unit Number and Id' xpos='200' ypos='1650' >
<![CDATA[ if context.MSPRResponseString [ "<msprRecords><Item><unitNumber>" {
 
    set unitnumber=$piece(context.MSPRResponseString,"<msprRecords><Item><unitNumber>",2)
    set msprId=$piece(unitnumber,"</unitNumber>")
    set context.msprIdNum=msprId
 
     $$$TRACE("context.msprIdNum:::"_context.msprIdNum)
 

    set userncid=$piece(context.MSPRResponseString,"<userNcid ncid="_"""",2)
    set userncid=$piece(userncid,""""_"></userNcid>")
    set context.userNcid=userncid
 
    $$$TRACE("context.userNcid:::"_context.userNcid)
 }else{
    $$$TRACE("skip the message as UNIT NUMBER IS NULL")
    set errorMsg="Mspr reply error : UNIT NUMBER IS NULL,  MSPR response :  "_context.MSPRResponseString
    set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, errorMsg)
 }
 ]]]]><![CDATA[>
</code>
<code name='Create the master msg' xpos='200' ypos='1750' >
