<Method name="ValidateMSPRResponse">
<ClassMethod>1</ClassMethod>
<FormalSpec>pMsprResponse:IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo,pConfigName:%String</FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tSC AS %Status=$$$OK
	if (($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sType.content),"<>W")="INF")&&
	   ($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).iNumber.content),"<>W")="0") && 
	   ($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sImess.Item.GetAt(1).sMess.content),"<>W")="Successful MSPR Transaction")){
		   set tSC=$$$OK
	   }else {
		   If (($ZSTRIP((pMsprResponse.ServiceMessage.MsprInfo.hemsInfo.context.completionCode.GetAt(1).sSystemMessage.content),"<>W")["truncated")){
			   set tSC=$$$OK
		   }Else {
			   set tSC=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(pConfigName,"Posting To MSPR not successful - Invalid completion code received from MSPR")
		   }
	   }
	   quit tSC
]]></Implementation>
</Method>

