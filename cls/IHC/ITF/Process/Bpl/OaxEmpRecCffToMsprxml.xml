<code name='Call Mspr Operation' xpos='200' ypos='1350' >
<![CDATA[   $$$TRACE("Call XML Proxy Operation")
  set status=process.SendRequestSync(process.TargetConfigNameXMLProxy,context.strXmlproxyRequest,.strXmlProxyResponse)
  //convert string to XMLclass
  if ($$$ISOK(status)){
     set context.strXmlProxyResponse=strXmlProxyResponse
  }ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,$SYSTEM.Status.GetOneErrorText(status)) }]]]]><![CDATA[>
