<code name='Get the UserType Details' xpos='200' ypos='750' >
<![CDATA[  $$$TRACE("UserType:"_context.UserType)
   set UserType=""
   set errorMsg=""
   set isValid=0
   set isKeyMissing=0
   set keyName=""
 set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Oax.UserType","VOLUNTEERS",.tVlounteers)
 if ($$$ISOK(tStatus)){       
    $$$TRACE("tVlounteers:"_tVlounteers)
    if tVlounteers [ context.UserType{
        set errorMsg = ""     
        set context.UserType="Volunteer" 
    }else{
          set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Oax.UserType","STUDENTS",.tStudent)
      if ($$$ISOK(tStatus)){       
           $$$TRACE("tStudent:"_tStudent)
           if tStudent [ context.UserType{
               set errorMsg = ""
               set context.UserType="Student"
           }else{ 
                   set tStatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Oax.UserType","INSTRUCTORS",.tInstructor)
                  if ($$$ISOK(tStatus)){     
                     $$$TRACE("tInstructor :"_tInstructor )  
                     if tInstructor [ context.UserType{
                       set errorMsg = "" 
                       set context.UserType="Instructor"
                    } else{
                       set errorMsg =" Unidentified type of User "
                    }
               }else{
			     set isKeyMissing=1
				 set keyName="INSTRUCTORS"
			   }
 
           }
        }else{
		  set isKeyMissing=1
		  set keyName="STUDENTS"
		}

     }
 }else{
   set isKeyMissing=1 
   set keyName="VOLUNTEERS"
 }
 

    
    if errorMsg '=""{
       $$$TRACE("Skipping the Message:"_errorMsg)
       set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, errorMsg)
    }
 ]]]]><![CDATA[>
