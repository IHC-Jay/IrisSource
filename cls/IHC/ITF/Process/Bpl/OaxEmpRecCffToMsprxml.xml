 	If $$$ISOK(tStatus){ 
   		set context.hddResponse= hddNcidResponse
        	set context.entNcid = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddResponse,context.entNcidIndex)
