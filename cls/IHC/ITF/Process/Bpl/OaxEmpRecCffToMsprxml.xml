<transform name='Call Mspr Request' class='IHC.ITF.Transform.Dtl.OaxEmpRecCffToMsprResquestXml' source='request' target='context.MsprRequest' xpos='200' ypos='1050' />
<code name='create XMl Request' xpos='200' ypos='1150' >
<![CDATA[    set quote=""""
   set status=context.MsprRequest.XMLExportToString(.strXmlproxyRequest)
    $$$LOGINFO("XMLproxy String conversion Status "_status)
 If ($$$ISOK(status)){
    set context.strXmlproxyRequest=##class(Ens.StringRequest).%New()
    set xmlSuffix="<?xml version="_quote_"1.0"_quote_" encoding="_quote_"UTF-8"_quote_ "?>"
    set context.strXmlproxyRequest.StringValue=xmlSuffix_strXmlproxyRequest
    $$$TRACE("XMLproxy String "_context.strXmlproxyRequest.StringValue)
 } Else {
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%CongigName,"Issue creating XMLProxy request to be sent to MSPR - "_$SYSTEM.Status.GetOneErrorText(status))
 }]]]]><![CDATA[>
</code>
<code name='Call Mspr Operation' xpos='200' ypos='1250' >
<![CDATA[   $$$TRACE("Call XML Proxy Operation")
  set status=process.SendRequestSync(process.TargetConfigNameXMLProxy,context.strXmlproxyRequest,.strXmlProxyResponse)
  //convert string to XMLclass
  if ($$$ISOK(status)){
     set context.strXmlProxyResponse=strXmlProxyResponse
  }ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,$SYSTEM.Status.GetOneErrorText(status)) }]]]]><![CDATA[>
</code>
<code name='validate MSPR response' xpos='200' ypos='1350' >
<![CDATA[  // Validate the response by loading it to the IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo structure
 set status=$$$OK
 set replstr="<?xml version="_""""_"1.0"_""""_"?>"
 set context.MSPRResponseString=$Replace(context.strXmlProxyResponse.StringValue,replstr,"")
 // Remove the XMl Version tag from start and Junk characters at the end
 set context.MSPRResponseString="<CiwsInfo>"_$piece(context.MSPRResponseString,"<CiwsInfo>",2)
 set context.MSPRResponseString=$piece(context.MSPRResponseString,"</CiwsInfo>")_"</CiwsInfo>"
 Set reader = ##class(%XML.Reader).%New()
 Set sc=reader.OpenString(context.MSPRResponseString)
 if '$$$ISOK(sc){
     set stattus=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
  } 
  Else {
      Do reader.Correlate("CiwsInfo","IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo")
      do reader.Next(.CiwsInfo,.sc)
      If $$$ISOK(sc){
	       $$$TRACE("Resposne back from MSPR parsed successfully.")
         // check if the the request was successfuly posted to MSPR
         set status=##class(IHC.ITF.Process.Bpl.OracleHrEmpRecCffToMsprXml).ValidateMSPRResponse(CiwsInfo,process.%ConfigName)
         
         If $$$ISOK(status){
	        $$$TRACE("Message posted successfuly to MSPR") 
         }
      }Else
      {     
          set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
      }    
  }
  If ($$$ISOK(status)){
	  // Just remove the junk character at the end for sending it to the other destinations.
	  set context.MSPRResponseString=$piece(context.strXmlProxyResponse.StringValue,"</CiwsInfo>")_"</CiwsInfo>"
  }
  $$$TRACE("ReponseString:"_context.MSPRResponseString)]]]]><![CDATA[>
</code>
<code name='To Get the Unit Number and Id' xpos='200' ypos='1450' >
<![CDATA[ set unitnumber=$piece(context.MSPRResponseString,"<msprRecords><Item><unitNumber>",2)
