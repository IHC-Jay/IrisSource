<code name='Call HDD' xpos='200' ypos='950' >
<![CDATA[  // Create request
 set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
 set facNumber=request.FACILITYNUMBER
 
 If facNumber'="" {
        
 	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest ,facNumber,  "119","50035",context.entNcidIndex)
 
	 //Call 
  	$$$TRACE("Call HDD look up facNumber")
