    $$$TRACE("TargetListCount: " _ context.targetList.Count())   
 }
 
 //CheckForLookupTables
 set retVal = ##class(Ens.Util.LookupTable).%ExistsTable("IHC.ITF.Process.Bpl.CernAdtHl7ToSunquest.Lookup.FacilityToServer")
 if (retVal = 0){
 	set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),"IHC.ITF.Process.Bpl.CernAdtHl7ToSunquest.Lookup.FacilityToServer not exists")  
 }
 
 //Validate the message against schema
 set context.validationSetting=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.validationSetting = "")) {
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to get validationSetting, shutting down.")
 } else {
    $$$TRACE("ValidationSetting: " _ context.validationSetting) 
    set pStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,context.validationSetting)
	if (pStatus'=$$$OK) {
	    set context.isValidationPassed=0
	    set context.errorStatus=pStatus
	    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Message Validation failed using"_ context.validationSetting _" .")
	}
 } 
 
 //Filter message if PID-3.1 is empty
 set pid3 = request.GetValueAt("PID:PatientIdentifierList(1).ID")
 if (pid3 ="") {
     $$$TRACE("PID-3.1 is empty, so skip message")
     set context.isValidationPassed=0
     set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "PID-3 is empty. Skipping the record.")
 }
 
 //Filter message if MSH-4 is '122' and PV1-3.2 is 'CRLR' 
 set msh4 = request.GetValueAt("MSH:SendingFacility.namespaceID") 
