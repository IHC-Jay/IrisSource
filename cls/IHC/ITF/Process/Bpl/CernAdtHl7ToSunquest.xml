     //Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid Facility:["_context.sendingFacility_"]. Skipping the record.")	  	      	
     set context.broadCastFacility = ""
     $$$TRACE("Value of BroadCastFacilities: "_context.sendingFacility )
   }else{
     set context.broadCastFacility = retVal
     set list = $LISTFROMSTRING(context.broadCastFacility, ",")      
     for index=1:1:$LISTLENGTH(list){	  
