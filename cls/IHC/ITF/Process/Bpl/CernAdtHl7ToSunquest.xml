<code name='Facility Lookup' xpos='335' ypos='900' >
<![CDATA[ try {
    set clinicFlag =request.GetValueAt("ZZZ(2):27UB92Condition") 
    if (clinicFlag ="") {
       set errMsg =""
       $$$TRACE("Looking up facility Rep 1.")
       set facility = request.GetValueAt("ZZZ(2):12VisitRemarks")
       if (facility '="") {
          set facilityRequest = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
          $$$TRACE("Looking up facility Rep 2.")
          Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(facilityRequest,facility,context.FacilityContext,"1")
          $$$TRACE("Looking up facility Rep 2.1.")
          set tStatus=process.SendRequestSync(context.HddTargetConfigName,facilityRequest,.hddResponse)
          $$$TRACE("Looking up facility Rep 2.2.")
          if ('tStatus) {
             $$$TRACE("Looking up facility Rep 3.")
             set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure") 
          }else {
             $$$TRACE("Looking up facility Rep 4.")
             set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddResponse, "1")
             if (hddObj '="") {
                $$$TRACE("Looking up facility Rep 5.")
                if (hddObj.Rep '="") {
                   if ($ZCONVERT(hddObj.Rep,"U") '="ERROR"){
                      $$$TRACE("Looking up facility Rep 6.")
                      set context.sendingFacility = hddObj.Rep
                   }else {
                      set errMsg = "Error returned from HDD lookup used to retrieve facility using Context: "_context.FacilityContext_", for Ncid: "_facility_", unable to send record without a facility. Skipping message."
                      throw errMsg
                   }
                }else {
                   set errMsg = "Nothing returned from HDD lookup used to retrieve facility using Context: "_context.FacilityContext_", for Ncid: "_facility_", unable to send record without a facility. Skipping message."
                   throw errMsg       
                }
             }
          }
       }else {
          set context.sendingFacility = request.GetValueAt("MSH:4.1")
       }
    }else {
       set context.sendingFacility = request.GetValueAt("MSH:4.1")
    }
 }catch error {
    if (errMsg '="") {
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, errMsg)
    }
 }]]]]><![CDATA[>
