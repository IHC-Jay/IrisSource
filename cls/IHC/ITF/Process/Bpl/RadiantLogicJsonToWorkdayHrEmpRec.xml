        Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
        $$$TRACE("tcharStream size:"_tcharStream.Size)
        set text=""
        While 'tcharStream.AtEnd {
          Set text = text_tcharStream.Read($$$MaxStringLength)
        } 
        Set text = ##class(Ens.Util.FunctionSet).ReplaceStr(text,"\","")
        Set text = ##class(Ens.Util.FunctionSet).ReplaceStr(text,$C(34)_"{","{")  
        Set text = ##class(Ens.Util.FunctionSet).ReplaceStr(text,"}"_$C(34),"}")    
        $$$TRACE("REST service response: "_text)
	$$$TRACE("REST Service response Status Code: "_statusCode)
	If ($$$IsdefObject(tcharStream)) {
	  Set tConsumedJSON = ##class(%Library.DynamicAbstractObject).%FromJSON(text)
	  $$$TRACE("Success Status: "_tConsumedJSON.%Get("success"))
	  set iter = tConsumedJSON.%GetIterator()
	  set statusKey=""
	  set statusCode=""
	  #dim contentIter As %Iterator.Object
	  #dim notificationIter As %Iterator.Array
	  do iter.%GetNext(.key , .value )
	  while iter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="content" {
	        set contentIter=value.%GetIterator()
	     }
	     else {
	        continue
	     }
	  }
	  set nval=""
	  while contentIter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="notifications" {
	        set nval=value
	     }
	     elseif key="hasNext" {
	       set context.hasNext=value
	     }
	     else {
	        continue
	     }
	  }
	  if (##class(Ens.Util.FunctionSet).Contains(nval,"DynamicArray")) {
	    set notificationIter=nval.%GetIterator()
	    set source=""
	    while notificationIter.%GetNext(.key , .value ) {
	      $$$TRACE("nkey = "_key_" , nvalue = "_value)
	      set dtlItter=value.%GetIterator()
	      set rec=##class(IHC.ITF.DStruc.Record.WorkdayHr.Record).%New()
	      while dtlItter.%GetNext(.key , .value ) {
	        if key="body" {
	      	  set bdIter=value.%GetIterator()
	          while bdIter.%GetNext(.key , .value ) {
	            $$$TRACE("key = "_key_" , value = "_value)
	            if key="nativeId" {
	              $$$TRACE("EMPI: "_value)
	              if value'="" {
	               set rec.Lpi=value
	              }
	            }
	            elseif key="newLinkId" {
	              set rec.Empi=value
	            }
	            elseif key="previousLinkId" {
	              set rec.oldEmpi=value
	            }
	            elseif key="source" {
	              set source=value
	            }
	          }
                }
                elseif key="ts" {
                  $$$TRACE("TS: "_value)
                  set strLen=##class(Ens.Util.FunctionSet).Length(value)
                  set ns = ##class(Ens.Util.FunctionSet).SubString(value,0,strLen-3)
                  set rec.processedDtTm=$ZDATETIME($ZDATETIMEH(ns,-2),3,,3)
                  $$$TRACE("TS: "_rec.processedDtTm)
                }
	        else {
	          continue
	        }
	      }
	      if ((source="inmt.nvpm") && (rec.Lpi'="")) {
	        do context.notificationList.Insert(rec)
	      }
	    }
	    if context.hasNext {
	      set context.pageNum=context.pageNum+1
	    }
	  }
        }
      }
    }
    ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Post iCentra Attending Doctor search service request failed with Status Code: "_statusCode_" : Status Desc: "_statusDesc) 
    }
  }
