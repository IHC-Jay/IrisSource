<code name='Parse json string and send Workday record to down stream' xpos='200' ypos='450' >
<![CDATA[ $$$TRACE("Test Parsing Json String...")
 set jsonObj=##class(%DynamicAbstractObject).%FromJSON(restResponse.StringValue)
 If ($$$IsdefObject(jsonObj)) {
   $$$TRACE("Parsing Json String is done.")
   set numRecds=jsonObj.totalResults
   $$$TRACE("Record Count: "_numRecds)
   if numRecds<context.rlRequest.count {
     set context.hasNext=0
   }
   else {
	   set context.stIndx=numRecds+context.rlRequest.startIndex
   }
   set resObj=jsonObj.Resources
   #dim resIter As %Iterator.Array
   set resIter =  resObj.%GetIterator()
   if (##class(Ens.Util.FunctionSet).Contains(resObj,"DynamicArray")) {
     while resIter.%GetNext(.key,.dvalue) { 
       $$$TRACE("KEY: "_key)
       set context.workdayRec=##class(IHC.ITF.DStruc.Record.WorkdayHr.Record).%New()
       if $isObject(dvalue) {
         $$$TRACE("UnitNum: "_dvalue.externalId)
         set context.workdayRec.UnitNumber=dvalue.externalId
         $$$TRACE("ID: "_dvalue.id)
         set mtObj=dvalue.meta
         $$$TRACE("Resource Type: "_mtObj.resourceType)
         $$$TRACE("Created: "_mtObj.created)
         set lmDt=mtObj.lastModified
         $$$TRACE("Last Modified: "_lmDt)
         $$$TRACE("Latest Modified Datetime: "_context.lastModifiedDt)
         set strLen=##class(Ens.Util.FunctionSet).Length(lmDt)
         set ms = ##class(Ens.Util.FunctionSet).SubString(lmDt,strLen-4,strLen-1)
         $$$TRACE("LastModifiedDt: "_$ZDATETIME($ZDATETIMEH(context.lastModifiedDt,3,7),-2))
         $$$TRACE("Last Modified: "_$ZDATETIME($ZDATETIMEH(lmDt,3,7),-2))
         if $ZDATETIME($ZDATETIMEH(context.lastModifiedDt,3,7),-2) < $ZDATETIME($ZDATETIMEH(lmDt,3,7),-2) {
	         set context.lastModifiedDt = lmDt 
	         set context.lastMdMs = ms
	         $$$TRACE("Update the search Datetime...")
         }
         else {
	         if $ZDATETIME($ZDATETIMEH(context.lastModifiedDt,3,7),-2) = $ZDATETIME($ZDATETIMEH(lmDt,3,7),-2) {
               if ms > context.lastMdMs {
	              set context.lastModifiedDt = lmDt
	              set context.lastMdMs = ms
	              $$$TRACE("Update the search Datetime(MS)...")
               } 
	         }
         }
         $$$TRACE("location: "_mtObj.location)
         $$$TRACE("Usrname: "_dvalue.userName)
         set nmObj=dvalue.name
         $$$TRACE("Last Name : "_nmObj.familyName)
         set context.workdayRec.LastName=nmObj.familyName
         $$$TRACE("First Name: "_nmObj.givenName)
         set context.workdayRec.FirstName=nmObj.givenName
         $$$TRACE("Title: "_dvalue.title)
         set context.workdayRec.PositionTitle=dvalue.title
         $$$TRACE("User Type: "_dvalue.userType)
         set context.workdayRec.JobProfile=dvalue.userType
         set emObj=dvalue.emails
         if $isObject(emObj) {
         #dim emIter As %Iterator.Array
         set emIter =  emObj.%GetIterator()
         if (##class(Ens.Util.FunctionSet).Contains(emObj,"DynamicArray")) {
	     while emIter.%GetNext(.key,.evalue) { 
           if $isObject(evalue) {
	       $$$TRACE("Email Type : "_evalue.type)
	           if evalue.type="work" {
	              set context.workdayRec.EmailAddress=evalue.value
               }
               $$$TRACE("Email: "_evalue.value)
             }
	       }
         }
         }
         set phObj=dvalue.phoneNumbers
         if $isObject(phObj) {
         #dim phIter As %Iterator.Array
         set phIter =  phObj.%GetIterator()
         if (##class(Ens.Util.FunctionSet).Contains(phObj,"DynamicArray")) {
	       while phIter.%GetNext(.key,.pvalue) { 
             if $isObject(pvalue) {
	           $$$TRACE("Phone Type : "_pvalue.type)
	           if pvalue.type="work" {
		         set context.workdayRec.PhoneNumber=pvalue.type
	           }
               $$$TRACE("Phone #: "_pvalue.value)
             }
	       }
         }
         }
         set euObj=dvalue.%Get("urn:ietf:params:scim:schemas:extension:enterprise:2.0:User")
         $$$TRACE("Enterprise User...")
         $$$TRACE("Employee Number: "_euObj.employeeNumber)
         set context.workdayRec.EmployeeID=euObj.employeeNumber
         $$$TRACE("Department: "_euObj.department)
         set mgObj=euObj.manager
         $$$TRACE("Value "_mgObj.value)
         set context.workdayRec.SupervisorID=mgObj.value
         set cuObj=dvalue.%Get("urn:ietf:params:scim:schemas:extension:custom:2.0:User")
         $$$TRACE("Custom User...")
         $$$TRACE("Position ID: "_cuObj.positionID)
         set context.workdayRec.PrimaryPosition=cuObj.positionID
         $$$TRACE("Birth Date: "_cuObj.birthDate)
         set context.workdayRec.BirthDate=cuObj.birthDate
         set context.workdayRec.Gender=cuObj.gender
         set context.workdayRec.SocialSecurityNumber=cuObj.ssn
         $$$TRACE("Hire Date: "_cuObj.hireDate)
         set context.workdayRec.HireDate=cuObj.hireDate
         $$$TRACE("Business Site: "_cuObj.businessSite)
         set context.workdayRec.BusinessSite=cuObj.businessSite
         set context.workdayRec.BusinessSiteName=cuObj.businessSiteName
         $$$TRACE("Department Number: "_cuObj.departmentNumber)
         set context.workdayRec.Dept=cuObj.departmentNumber
         $$$TRACE("Job Family: "_cuObj.jobFamily)
         set context.workdayRec.JobFamily=cuObj.jobFamily
         set context.workdayRec.CertificationName=cuObj.certificationName
         $$$TRACE("Termination Date: "_cuObj.terminationDate)
         set context.workdayRec.TerminationDate=cuObj.terminationDate
         set pnObj=cuObj.preferredName
         $$$TRACE("Preferred Firt Name: "_pnObj.givenName)
         set context.workdayRec.PreferredFirstName =pnObj.givenName
         $$$TRACE("Preferred Last Name: "_pnObj.familyName)
         set context.workdayRec.PreferredLastName =pnObj.familyName
         $$$TRACE("Target Process: "_context.targetList.GetAt(1))
         set status=process.SendRequestAsync(context.targetList.GetAt(1),context.workdayRec,.wdresponse)
         if ($$$ISOK(status)){
            $$$TRACE("A Workday record is sent ...")
         }
         else {
            $$$TRACE("Send a Workday record failed ...")
         }
       }
     }
   }
 }
 else {
	 $$$TRACE("Failed to parse the JSON string ...")
 }
 ]]]]><![CDATA[>
</code>
</while>
