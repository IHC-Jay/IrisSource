<code name='Validate message structure' xpos='200' ypos='550' >
<annotation><![CDATA[Get Validation setting from settings & test against the structure]]]]><![CDATA[></annotation>
<![CDATA[
 //Validate the message against schema
 set validationSetting=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 if ( ($$$ISERR(pstatus)) || (validationSetting = "")) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get ValidationSetting, shutting down.")
    quit
 } else {
    $$$TRACE("ValidationSetting: " _ validationSetting) 
    set pStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSetting)    
	if (pStatus'=$$$OK) {		
	    $$$TRACE("Failed Validation Settings: " _ validationSetting)
	    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Validation against data structure is failed. Skipping the record.")
	    quit
	} else {
		$$$TRACE("Passed Validation Settings: " _ validationSetting)
	}
 }]]]]><![CDATA[>
</code>
<code name='Check Configuration' xpos='200' ypos='650' >
<annotation><![CDATA[Get Configuration from settings]]]]><![CDATA[></annotation>
<![CDATA[
  //ReplyCodeActions validation
 set replyCodeActions=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","ReplyCodeActions",.pstatus)
 if ( ($$$ISERR(pstatus)) || (replyCodeActions= "")) {
 	set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get ReplyCodeActions, shutting down.")   
 	quit
 } else {
    $$$TRACE("ReplyCodeActions: " _ replyCodeActions)
 }
 
 //HddTargetConfigName validation
 set context.hddTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","HddTargetConfigName",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.hddTargetConfigName= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get HddTargetConfigName, shutting down.")   
    quit
 }
 
]]]]><![CDATA[>
</code>
<code name='Filter Message' xpos='200' ypos='750' >
<![CDATA[ 
 set txType = request.GetValueAt("ZZZ:Transactiontype")
 set app = request.GetValueAt("ZZZ:OriginalSendingApplication")
 set intFlg = request.GetValueAt("ZZZ:InstituteFlag")
 set deactFlg = request.GetValueAt("ZZZ:DeactiveFlag")
 
  if (txType = 205) || (txType = 204 && app ="IDX" ) || (app = "CB_Bounce") || (app = "IHCMergeWork") || (intFlg ="Y")
  {
   $$$TRACE("Do not send this TX Type:  "_txType_" App: " _app_"  Audit num: "_request.GetValueAt("ZZZ:AuditNumber"))
   
  set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Do not send this TX Type:  "_txType_" App: " _app_"  Audit num: "_request.GetValueAt("ZZZ:AuditNumber")_", skip message.")
  
 
  }
  
 
]]]]><![CDATA[>
</code>
<code name='Populate MSH-9.2' xpos='200' ypos='850' >
<![CDATA[ set msgTypeTrg = request.GetValueAt("MSH:MessageType.triggerevent")
 
 if (msgTypeTrg = "A04")
 {
    set msgTypeTrg = "P01"
 }
 elseif (msgTypeTrg = "A08")
 {
    if (deactFlg = "Y")
    {
      set msgTypeTrg = "P02"
    }
    else
    {
      set msgTypeTrg = "P05"
    }
 
 }
 else
 {
    set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Invalid message type,  skip message.") 
 }
 
 set context.eventid = msgTypeTrg]]]]><![CDATA[>
</code>
<code name='Prep NcidToRep object' xpos='200' ypos='950' >
<![CDATA[ $$$TRACE("Prepare for Rep to Ncid request lookup call")  	
 set context.hddNcidRequest = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
 

 
 //Language
 
  set pid15LanguageRep = request.GetValueAt("PID:PrimaryLanguage.identifierST")  
  
  $$$TRACE("Value of Race pid15LanguageRep : "_pid15LanguageRep)
 
 do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, pid15LanguageRep, context.LanguageDomain, context.helpContext, "PID15:Lang")
 
 
 
 //Ethnicity
 
  set pid22EthnicRep = request.GetValueAt("PID:EthnicGroup(1).identifierST")  
 
 do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(context.hddNcidRequest, pid22EthnicRep, context.EthnicityDomain, context.helpContext, "PID22:Ethnic")]]]]><![CDATA[>
</code>
<code name='Call GetNcidFromRep' xpos='200' ypos='1050' >
<![CDATA[ set tStatus=process.SendRequestSync(context.hddTargetConfigName,context.hddNcidRequest,.hddNcidResponse)
 if ('tStatus) {     
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
 } else { 
   set context.hddNcidResponse= hddNcidResponse
 }
 
 
 //For Language
 
   set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddNcidResponse, "PID15:Lang")
 $$$TRACE("Just setup Language hdd object")
 if (hddObj '= ""){
     $$$TRACE("Just checked Language hdd object")
    if (hddObj.NCID '= ""){
       $$$TRACE("Just checked Language hdd object response")
       set context.ncidLanguage = hddObj.NCID
       $$$TRACE("Created HDD Response for Language. NCID: " _hddObj.NCID_ ", context: " _context.helpContext_", domain: " _context.LanguageDomain)
    }
   }
   
   
   
   //For Ethnic
 
   set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddNcidResponse, "PID22:Ethnic")
 $$$TRACE("Just setup Ethnic hdd object")
 if (hddObj '= ""){
     $$$TRACE("Just checked Ethnic hdd object")
    if (hddObj.NCID '= ""){
       $$$TRACE("Just checked Ethinic hdd object response")
       set context.ncidEthnic = hddObj.NCID
       $$$TRACE("Created HDD Response for Ethinic. NCID: " _hddObj.NCID_ ", context: " _context.helpContext_", domain: " _context.EthnicityDomain)
    }
   }]]]]><![CDATA[>
</code>
<code name='Prep GetRepFromNcid' xpos='200' ypos='1150' >
<annotation><![CDATA[Filter Message]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object") 
  	
 if (context.ncidLanguage'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.ncidLanguage, context.CBContext, "NCID:Lang")  	  	
     $$$TRACE("Hdd Request ncidLang is " _context.ncidLanguage)	
     }
     
     
     if (context.ncidEthnic'= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.ncidEthnic, context.CBContext, "NCID:Ethnic")  	  	
     $$$TRACE("Hdd Request ncidEthnic is " _context.ncidEthnic )	
     }]]]]><![CDATA[>
</code>
<code name='Call GetRepFromNcid' xpos='200' ypos='1250' >
<![CDATA[  set tStatus=process.SendRequestSync(context.hddTargetConfigName,context.hddRepRequest,.hddRepResponse)
 if ('tStatus) {     
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
 } else { 
   set context.hddRepResponse= hddRepResponse
 }

  
  //Language - Ncid to Rep
  
  set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddRepResponse, "NCID:Lang")
 if (hddObj '= ""){
     $$$TRACE("Just checked NCID Language hdd object")
    if (hddObj.Rep '= ""){
       $$$TRACE("Just checked NCID Language hdd object response")
       set context.helpRepLanguage = hddObj.Rep
       $$$TRACE("Created HDD Response for NCID Language. Rep: " _hddObj.Rep_ ", context: " _context.CBContext)
    }
   }
   
   
   
   
   //Ethnic - Ncid to Rep
  
  set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddRepResponse, "NCID:Ethnic")
 if (hddObj '= ""){
     $$$TRACE("Just checked NCID Ethnic hdd object")
    if (hddObj.Rep '= ""){
       $$$TRACE("Just checked NCID Ethnic hdd object response")
       set context.helpRepEthnic = hddObj.Rep
       $$$TRACE("Created HDD Response for NCID Ethnic. Rep: " _hddObj.Rep_ ", context: " _context.CBContext)
    }
   }]]]]><![CDATA[>
