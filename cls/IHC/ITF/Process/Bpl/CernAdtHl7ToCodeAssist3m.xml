<ReturnType>%String</ReturnType>
<Implementation><![CDATA[
    $$$TRACE("HDD work for NCID to REP starting now")
	set HddRepRequest = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(HddRepRequest, hddNcid, hddContext, hl7Detail)
	$$$TRACE("Created HDD request object for: " _hl7Detail_ ". For NCID: "_hddNcid _" Using HddTargetConfigName: " _hddTargetConfigName_ " Using HDD Context: " _hddContext)
	$$$TRACE("Actually sending the HDD REQUEST from local class method...")
	set tStatus=process.SendRequestSync(hddTargetConfigName,HddRepRequest,.hddResponse)
	if ('tStatus){
	    set tSC=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure")
    }else{
		
		$$$TRACE("Actually received HDD RESPONSE")
		set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddResponse, hl7Detail)
		if (hddObj '= ""){
				set hddreturnrep = hddObj.Rep
				$$$TRACE("Created HDD Request and got response back for " _hl7Detail_ " NCID: " _hddObj.NCID_ ", HDD Context: " _hddContext )
				$$$TRACE("Returned representation received from HDD: " _hddreturnrep)
		}else{
				//throw error
				set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected Error - no or null value returned from HDD Call!")
		}	
	}
	quit hddreturnrep
]]></Implementation>
