 Set pv1ThreePOC=request.GetValueAt("ZZ1:ZZ114PointOfCareNcid")
 $$$TRACE("pv1ThreePOC " _ pv1ThreePOC) 
  set Ncid = pv1ThreePOC 
  set HL7SpecValue= "PV1:AssignedPatientLocation.pointofcare - iCentra Patient POC Unit from ZZ1:ZZ114PointOfCareNcid"
 if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
    
    $$$TRACE("Set values are: Ncid: " _ Ncid _ ". Hl7 Specific Value: " _HL7SpecValue_ ".  HDD Context going to be used in lookup: " _context.hddncidtorepcontext)
    // call local HDD class Method
    $$$TRACE("Calling local HDD class methond.")
    
    Try {
    	set hddreturnrep=##class(IHC.ITF.Process.Bpl.CernAdtHl7ToCodeAssist3m).hddWork(process,context.hddTargetConfigName,Ncid,context.hddncidtorepcontext,HL7SpecValue)
    	// work return value
        if ($LENGTH(hddreturnrep)>0){
	         $$$TRACE("Rep from local HDD calls call: "_hddreturnrep)
             $$$TRACE("HDD Ncid TO Rep Lookup was successfuly!!!") 
        }else{     
             set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error while Processing HDD Ncid TO Rep lookup.")  
        }  
    } Catch eException {
	 	Set exceptStatus = eException.AsStatus()
	 	$$$LOGSTATUS(exceptStatus)
	 	set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error while Processing HDD Ncid TO Rep lookup:"_exceptStatus)     
    }
    
     

   //After HDD call set context specific variable to use in setting DTL
   set context.pointOfCareUnit = hddreturnrep
   



 }else {
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***Unable to get location value for working PV1-3 POC Unitvalue for the clinic. No valid NCID found in: PV1:AssignedPatientLocation.pointofcare. Found - PHI: ["_Ncid_"]***HL7 Message Control ID: "_context.msh10MsgControlID)
   
