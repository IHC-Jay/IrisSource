<sequence xend='200' yend='1300' >
<scope xpos='200' ypos='250' xend='200' yend='1200' >
<trace name='incomingMessage' value=' "New SearchNotification call "' xpos='200' ypos='350' >
<annotation><![CDATA[Incoming Record is request.RawContent]]]]><![CDATA[></annotation>
