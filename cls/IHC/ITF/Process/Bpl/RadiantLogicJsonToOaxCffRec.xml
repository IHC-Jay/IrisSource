<code name='Check ReplyCodeActions' xpos='200' ypos='450' >
<annotation><![CDATA[From settings tab]]]]><![CDATA[></annotation>
<![CDATA[  
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = "")) { 	
 	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError($CLASSNAME(),"Initialization error, No ReplyCodeActions found")
 }
 ]]]]><![CDATA[>
</code>
<code name='Set MaxError' xpos='200' ypos='550' >
<annotation><![CDATA[Set MaxError]]]]><![CDATA[></annotation>
<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)   
 
 //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = "")){
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Initialization error,  No TargetConfigNames found")	 
 }else{
      $$$TRACE("TargetConfigNames: " _configValue )
 } 
 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
    $$$TRACE("Count: " _ context.targetList.Count())
 set context.rsOpNm=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","RadiantSrvcTargetConfigName",.pstatus)

 ]]]]><![CDATA[>
</code>
<code name='Initial request' xpos='200' ypos='650' >
<![CDATA[ $$$TRACE("Set Initial Request string... ") 
    Set tSC=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"InitialStartDate",.iSDt)
    if iSDt'="" {
	   $$$TRACE("InitialStartDate: "_iSDt_" CS: "_$ZDATETIME($ZDATETIMEH(iSDt,3,7),-2))
       if ^lastSearchDtOax="" {
           set ^lastSearchDtOax=iSDt
           $$$TRACE("Set StartDate: "_iSDt)
       }
    }
    else {
	   $$$TRACE("Set StartDate: "_$ZDATETIME($ZTIMESTAMP,3,7,3))
       set ^lastSearchDtOax = $ZDATETIME($ZTIMESTAMP,3,7,3)
    }

 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"numMsgPg",.nMsg)
 if ($$$ISERR(pstatus)){
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"numMsgPg Setting is not found. Required for processing data.")  
 }

 $$$TRACE("Number of messages per page: "_nMsg)
 set context.nMsg=nMsg
 if (nMsg=0) {
   set context.nMsg=30
   $$$TRACE("Number of messages per page is set to 0. Use default value 30")
 } 
 $$$TRACE("lastSearchDtOax: "_^lastSearchDtOax)
 set context.lastModifiedDt=^lastSearchDtOax
 set strLen=##class(Ens.Util.FunctionSet).Length(context.lastModifiedDt)
 set context.lastMdMs = ##class(Ens.Util.FunctionSet).SubString(context.lastModifiedDt,strLen-4,strLen-1)
 $$$TRACE("Start at: "_context.lastModifiedDt)
 $$$TRACE("M seconds: "_context.lastMdMs)
  ]]]]><![CDATA[>
</code>
<while name='Service call loop' condition='context.hasNext' xpos='200' ypos='750' xend='200' yend='550' >
<trace value='"In service call loop: "_context.rlRequest.startIndex' xpos='200' ypos='250' />
<code name='Call RadiantLogic service' xpos='200' ypos='350' >
<![CDATA[  $$$TRACE("Call RadiantLogic REST Operation")
  set context.rlRequest=##class(IHC.ITF.DStruc.Request.RLRequest).%New()
 set context.rlRequest.count=context.nMsg
 set context.rlRequest.startIndex=context.stIndx
 set sDt=$Replace(^lastSearchDtOax,"-","")
 set sDt=$Replace(sDt,"T","")
 set sDt=$Replace(sDt,":","")
 set sDt=$Replace(sDt,".","")
 set context.rlRequest.startDt=sDt
 $$$TRACE("Start TIMESTAMP: "_context.rlRequest.startDt)
 set context.rlRequest.sourceSystem="OAX"
  set status=process.SendRequestSync(context.rsOpNm,context.rlRequest,.restResponse)
  if ($$$ISOK(status)){
     $$$TRACE("REST service response data: "_restResponse.StringValue)
  }
  else {
     $$$TRACE("Radiant service call failed. "_restResponse.StringValue)
     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Calling Radiant Service failed, please check the operation alert for the specific error.")  
  }]]]]><![CDATA[>
</code>
<code name='Parse json string and send Workday record to down stream' xpos='200' ypos='450' >
<![CDATA[ $$$TRACE("Parsing Json String...")
 set jsonObj=##class(%DynamicAbstractObject).%FromJSON(restResponse.StringValue)
 If ($$$IsdefObject(jsonObj)) {
   $$$TRACE("Parsing Json String is done.")
   set numRecds=jsonObj.itemsPerPage
   set toTalNumRecds=jsonObj.totalResults
   $$$TRACE("Total Record Count: "_toTalNumRecds_" Number Rec returned: "_numRecds)
   set context.stIndx=numRecds+context.rlRequest.startIndex
   if context.stIndx>toTalNumRecds {
     set context.hasNext=0
   }
   set resObj=jsonObj.Resources
   #dim resIter As %Iterator.Array
   set resIter =  resObj.%GetIterator()
   if (##class(Ens.Util.FunctionSet).Contains(resObj,"DynamicArray")) {
     while resIter.%GetNext(.key,.dvalue) { 
       $$$TRACE("KEY-: "_key)
       $$$TRACE("VALUE-: "_dvalue)
       set context.oaxRec=##class(IHC.ITF.Oax.Dstruc.OaxDelimited.Record).%New()
       if $isObject(dvalue) {
         set context.oaxRec.PERSONID=dvalue.PERSONID
         $$$TRACE("ID: "_dvalue.id)
         set mtObj=dvalue.meta
         $$$TRACE("Resource Type: "_mtObj.resourceType)
         $$$TRACE("Created: "_mtObj.created)
         set lmDt=mtObj.lastModified
         $$$TRACE("Last Modified: "_lmDt)
         $$$TRACE("Latest Modified Datetime: "_context.lastModifiedDt)
         set strLen=##class(Ens.Util.FunctionSet).Length(lmDt)
         set ms = ##class(Ens.Util.FunctionSet).SubString(lmDt,strLen-4,strLen-1)
         if $ZDATETIME($ZDATETIMEH(context.lastModifiedDt,3,7),-2) < $ZDATETIME($ZDATETIMEH(lmDt,3,7),-2) {
	         set context.lastModifiedDt = lmDt 
	         set context.lastMdMs = ms
	         $$$TRACE("Update the search Datetime...")
         }
         else {
	         if $ZDATETIME($ZDATETIMEH(context.lastModifiedDt,3,7),-2) = $ZDATETIME($ZDATETIMEH(lmDt,3,7),-2) {
               if ms > context.lastMdMs {
	              set context.lastModifiedDt = lmDt
	              set context.lastMdMs = ms
	              $$$TRACE("Update the search Datetime(MS)...")
               } 
	         }
         }
         $$$TRACE("location: "_mtObj.location)
         set context.oaxRec.LASTNAME=dvalue.LASTNAME
         set context.oaxRec.FIRSTNAME=dvalue.FIRSTNAME
         set context.oaxRec.MIDDLENAME=dvalue.MIDDLENAMES
         set context.oaxRec.NAMESUFFIX=dvalue.NAMESUFFIX
         set context.oaxRec.PREFERREDNAME=dvalue.PREFERREDNAME         
         set context.oaxRec.USERTYPE=dvalue.USERTYPE
         $$$TRACE("User Type: "_dvalue.USERTYPE)
         set context.oaxRec.EMAILADDRESS=dvalue.EMAILADDRESS
         set context.oaxRec.SUPERVISORMSPRID=dvalue.SUPERVISORRLUID
         $$$TRACE("Birth Date: "_dvalue.DOB)
         set dob=dvalue.DOB
         if ($Length(dob) > 7) {
           set dob=##class(Ens.Util.FunctionSet).SubString(dob, 1, 4)_"-"_##class(Ens.Util.FunctionSet).SubString(dob, 5,6)_"-"_##class(Ens.Util.FunctionSet).SubString(dob, 7, 8)
         }
         set context.oaxRec.DATEOFBIRTH=dob_" 00:00:00.0"
         set context.oaxRec.GENDER=dvalue.GENDER
         set context.oaxRec.SSN=dvalue.SSN
         set sdt=dvalue.STARTDATE
         if ($Length(sdt) > 7) {
           set sdt=##class(Ens.Util.FunctionSet).SubString(sdt, 1, 4)_"-"_##class(Ens.Util.FunctionSet).SubString(sdt, 5,6)_"-"_##class(Ens.Util.FunctionSet).SubString(sdt, 7, 8)
         }
         set context.oaxRec.STARTDATE=sdt_" 00:00:00.0"
         set edt=dvalue.ENDDATE
         if ($Length(edt) > 7) {
           set edt=##class(Ens.Util.FunctionSet).SubString(edt, 1, 4)_"-"_##class(Ens.Util.FunctionSet).SubString(edt, 5,6)_"-"_##class(Ens.Util.FunctionSet).SubString(edt, 7, 8)
         }
         set context.oaxRec.ENDDATE=edt_" 00:00:00.0"
         set context.oaxRec.FACILITYNUMBER=dvalue.FACILITYNUMBER
         set context.oaxRec.INTERMOUNTAINEMP=dvalue.INTERMOUNTAINEMP
         set context.oaxRec.ACCESSSTATUS=dvalue.USERSTATUS
         set context.oaxRec.NONUSID=dvalue.NONUSNATIONALIDENTIFIER
         $$$TRACE("Target Process: "_context.targetList.GetAt(1))
         set process.%SuperSession="" // make each transaction a new session
         set process.%SessionId="" // make each transaction a new session
         set status=process.SendRequestAsync(context.targetList.GetAt(1),context.oaxRec,0)
         if ($$$ISOK(status)){
            $$$TRACE("A Workday record is sent ...")
            //set ^lastSearchDtOax=context.lastModifiedDt
         }
         else {
            $$$TRACE("Send a Oax record failed ...")
         }
       }
     }
   }
 }
 else {
	 $$$TRACE("Failed to parse the JSON string ...")
 }
 ]]]]><![CDATA[>
</code>
</while>
<code name='reset ^lastSearchDtOax' xpos='200' ypos='850' >
<![CDATA[    
	$$$TRACE("Update ^lastSearchDtOax: "_context.lastModifiedDt)
    set ^lastSearchDtOax=context.lastModifiedDt
  ]]]]><![CDATA[>
</code>
