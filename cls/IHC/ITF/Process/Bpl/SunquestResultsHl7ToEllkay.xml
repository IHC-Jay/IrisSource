<code name='Verify OBX-5 length and truncate if too long' xpos='1010' ypos='1500' >
<![CDATA[ set orcIndex =""
 set obxIndex =""
 set obx5New =""
 for {
    set orcIndex=request.GetNextIndex("PIDgrpgrp(1).ORCgrp()",orcIndex,.tSCTrans) Quit:orcIndex=""
    for {
       set obxIndex=request.GetNextIndex("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp()",obxIndex,.tSCTrans) Quit:obxIndex=""
       set obx2 =request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:ValueType")
       if ((obx2 ="CE") || (obx2 ="CWE")) {
          set obx5Text =request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:ObservationValue(1).Text")
          set obx5Length = $L(obx5Text)
          if (obx5Length > 250) {
             set obx5New =$EXTRACT(obx5Text,1,250)
             do request.SetValueAt(obx5New, "PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:ObservationValue(1).Text")
          } 
       } 
    }
 }]]]]><![CDATA[>
