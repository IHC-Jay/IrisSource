       if (($$$ISOK(facilityStatus)) && (facilityVal =1)) {
          set roomStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.SunquestResultsHl7ToEllkay.Lookup.RoomFilter",context.Room,.roomVal)
          $$$TRACE("roomStatus: " _ roomStatus)
          $$$TRACE("roomVal: " _ roomVal)
          if (($$$ISOK(roomStatus)) && (roomVal '="Unknown")) {
             set context.ProcessRecord = 1
          }
       }
    }else {
       set context.ProcessRecord = 1
    }
 }
 $$$TRACE("context.ProcessRecord: " _ context.ProcessRecord)
 
 set obx9FilterStatus = ##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"Filter on OBX-9 for Micro", .obx9Filter)
