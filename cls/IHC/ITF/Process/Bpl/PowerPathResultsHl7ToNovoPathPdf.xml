<code name='check if message has continued pointer' xpos='200' ypos='550' >
<![CDATA[    Set doTrans=0
    set ContdPointer = request.GetValueAt("MSH:ContinuationPointer")
    $$$TRACE("ContdPointer: " _ ContdPointer)
    if (ContdPointer'="") {
      if (ContdPointer=^SavedContdPointer) {
         set cMsg = request.RawContent
         set newMsg = $P(^SavedPPMessage,"DSC|",1)_$P(cMsg,ContdPointer_$Char(13),2)         
         set ^SavedPPMessage=""
	 set ^SavedContdPointer=""
         $$$TRACE("NEW MSG: "_newMsg)
         set context.MsgRequest=##class(EnsLib.HL7.Message).ImportFromString(newMsg)
         set context.MsgRequest.DocType="PowerpathPath:ORU_R01"
         set doTrans=1
      }
      else {
         set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Message Continuation Pointer: "_ContdPointer_" does not match the saved Continuation Pointer: "_^SavedContdPointer_". Please check the messages in the queue.")   
      }
    }
    else {
       set DSCContdPointer = request.GetValueAt("DSC:ContinuationPointer")
       $$$TRACE("DSCContdPointer: " _ DSCContdPointer)
       if (DSCContdPointer'="") {
           set ^SavedContdPointer=DSCContdPointer
           set ^SavedPPMessage=request.RawContent
           Set doTrans=0
       }
       else {
          set context.MsgRequest=request
          Set doTrans=1
       }
    }
    //Set doTrans=0
