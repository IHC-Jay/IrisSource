<code name='Do NCID to REP' xpos='200' ypos='750' >
<![CDATA[ 	
  
  set obr4ProcedureID = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceID.identifier")  	
 if (obr4ProcedureID '= "") {
 
  try{
  $$$TRACE(" Calling getRepFromNcid().... " )
        set status=##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getRepFromNcid(obr4ProcedureID, "OBR-4", context.obr4Context, context.hddTargetConfigName, .process, .resp)  
        
     set context.obr4ProcedureID = resp
      $$$TRACE(" Returned Rep(obr4) from HDD: [" _ resp _ "] for the ncid: "_ obr4ProcedureID)
     }catch(exVar){
	     set exVarData = $ZSTRIP(exVar.Data,"*C")
	     $$$TRACE(" exVarData --> "_exVarData)
	     if exVar.Code [ "ITFCOMMON:10108" {
		   // InutDataError - one of the input parameters from source is blank.
		    set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,exVarData)
	   	 }elseif(exVar.Code [ "ITFCOMMON:10109") {
		   // HddDataError - one of the input parameters from source is invalid or not defined in HDD		   		   		   
		    set status=##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName,exVarData)
		 }elseif(exVar.Code [ "ITFCOMMON:10106") {
		   	 // RetrMsgError - one of the input parameters from source is invalid or not defined in HDD
		   	    set status = ##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,exVarData)		  
		 }else{
			 //Any other Unexpected error
			 set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Shutting down..Unknown Error."_exVarData)
		 }
	 }
     	   	  	
     $$$TRACE("Hdd REP OBR-4 ProcedureCode is " _ context.obr4ProcedureID)     		
 }]]]]><![CDATA[>
