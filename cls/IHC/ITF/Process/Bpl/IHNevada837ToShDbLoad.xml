<code name='Split individual X12 records' xpos='200' ypos='250' >
<annotation><![CDATA[Split large X12 into individual X12 files with single 2000B loop]]]]><![CDATA[></annotation>
<![CDATA[ /* Setting message to X12 837 TransactionSet */
 
 set STRecord=context.individualST 
 set STRecord.DocType="HIPAA_5010:837P" 

 
 /* Define HL segment path's for both 2000B and next iteration of 2000B loop */
 
 set cur2000Bpath="loop2000A("_(context.loopAind)_").loop2000B("_context.loopBind_").HL"
 set cur2000Bind=STRecord.GetSegmentIndex(cur2000Bpath,.cur2000Bstatus)
 
 if (cur2000Bstatus =1)
 {
      $$$TRACE(cur2000Bpath _": " _ cur2000Bind _ "= " _ STRecord.GetValueAt(cur2000Bind) _"; B current status: " _ cur2000Bstatus)
	set context.childCode = STRecord.GetValueAt(cur2000Bpath_":4")
	if (context.childCode = 1)
	{
		$$$TRACE("Get Loop 2000C for " _ cur2000Bpath)
	}
      set context.cur2000Bstatus = 1
      set context.cur2300status = 1
      set context.loop2300ite = 1
      set context.loopClmInd = 1
      set cur2000Bnxt="loop2000A("_(context.loopAind)_").loop2000B("_(context.loopBind+1)_").HL"
      set nxt2000Bind=STRecord.GetSegmentIndex(cur2000Bnxt,.cur2000Bstatus)
   
 
     set context.loop2000Bite = cur2000Bind
     
     // $$$TRACE("Next B: " _ cur2000Bnxt _ ", index: " _ nxt2000Bind _ "; status: " _ cur2000Bstatus)
     
     if (cur2000Bstatus = 1)
     {
       set context.loop2000BCount = nxt2000Bind - 1
       // $$$TRACE("Next loop B: " _ context.loop2000BCount)
     }
     else
     {
         set context.loop2000BCount = STRecord.SegCount - 1
      }
      // $$$TRACE(cur2000Bnxt_": " _ nxt2000Bind _ " -> " _ STRecord.GetValueAt(context.loop2000BCount) )
   
  }
  else
  {
    set context.loop2000Bite = context.loop2000BCount + 1
    set context.cur2000Bstatus = 0
  }
  
]]]]><![CDATA[>
</code>
