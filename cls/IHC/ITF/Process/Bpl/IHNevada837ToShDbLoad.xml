<code name='Split individual X12 records' xpos='200' ypos='250' >
<annotation><![CDATA[Split large X12 into individual X12 files with single 2000A loop]]]]><![CDATA[></annotation>
<![CDATA[ /* Setting message to X12 837 TransactionSet */
 
 set STRecord=context.individualST 
 set STRecord.DocType=context.docType 

 
 /* Define HL segment path's for both 2000A and next iteration of 2000A loop */
 
 set cur2000Apath="loop2000A("_context.loopAind_").HL"
 set cur2000Aind=STRecord.GetSegmentIndex(cur2000Apath,.cur2000Astatus)
 
 if (cur2000Astatus '= 1)
 {
   $$$TRACE(cur2000Apath _": " _ cur2000Aind _ "= " _ STRecord.GetValueAt(cur2000Aind))
   set context.HLParsing = "1"
   /* Capture the closing segment(SE) of Transaction Set */
   set sesegment=STRecord.GetValueAt(STRecord.SegCount)  
   $$$TRACE("SE # " _ STRecord.SegCount _": " _ sesegment)
   set context.loop2000Aite = context.loop2000ACount + 1
   set context.cur2000Astatus = 0
  
 }
 else
 {
   set context.cur2000Astatus = 1
   set context.cur2000Bstatus = 1
   set context.loop2000Bite = 1
   set context.loopBind = 1
   set context.loop2000Aite = cur2000Aind
   set cur2000Anxt="loop2000A("_(context.loopAind+1)_").HL"
   set nxt2000Aind=STRecord.GetSegmentIndex(cur2000Anxt,.cur2000Astatus)

  if (cur2000Astatus = 1)
  {
    set context.loop2000ACount = nxt2000Aind - 1
    // $$$TRACE("Next loop A: " _ context.loop2000ACount)
  }
  else
  {
      set context.loop2000ACount = STRecord.SegCount - 1
   }
   // $$$TRACE(cur2000Anxt_": " _ nxt2000Aind _ " -> " _ STRecord.GetValueAt(context.loop2000ACount) )
   
  }
  
]]]]><![CDATA[>
