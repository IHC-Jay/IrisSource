<![CDATA[ /* Setting message to X12 837 TransactionSet */
 
 set STRecord=context.individualST 
 set STRecord.DocType="HIPAA_5010:837P" 

 
 /* Define HL segment path's for both 2000C and next iteration of 2000C loop */
 
 set cur2000Cpath="loop2000A("_(context.loopAind)_").loop2000B("_context.loopBind_").loop2000C("_context.loopCind_").HL"
 set cur2000Cind=STRecord.GetSegmentIndex(cur2000Cpath,.cur2000Cstatus)
 $$$TRACE(cur2000Cpath _": " _ cur2000Cind _", Status: " _ cur2000Cstatus )
 if (cur2000Cstatus =1)
 {
    
   set context.cur2000Cstatus = 1
   set context.cur2300status = 1
   set context.loop2300ite = 1
   set context.loopClmInd = 1
   set cur2000Cnxt="loop2000A("_(context.loopAind)_").loop2000B("_context.loopBind_").loop2000C("_(context.loopCind+1)_").HL"
   set nxt2000Cind=STRecord.GetSegmentIndex(cur2000Cnxt,.cur2000Cstatus)
   
 
   set context.loop2000Cite = cur2000Cind
   if (cur2000Cstatus = 1)
   {
     set context.loop2000CCount = nxt2000Cind - 1
     // $$$TRACE("Next loop C: " _ context.loop2000CCount)
   }
   else
   {
       set context.loop2000CCount = STRecord.SegCount - 1
    }
    // $$$TRACE(cur2000Cnxt_": " _ nxt2000Cind _ " -> " _ STRecord.GetValueAt(context.loop2000CCount) )
   
  }
  else
  {
    set context.loop2000Cite = context.loop2000CCount + 1
    set context.cur2000Cstatus = 0
  }
  
]]]]><![CDATA[>
