<code name='CheckAllowedFacilities' xpos='200' ypos='1250' >
<![CDATA[ set AcceptedLocations=""
  //set Location = request.GetValueAt("MSH:SendingFacility")
   set Location = context.FacilityRep
  set context.isAcceptedLocation = 0
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedFacilities",.AcceptedLocations) 
 $$$TRACE("Trigger Location= "_Location)
 if ($$$ISOK(pstatus)&&(AcceptedLocations'=""))
 {
    $$$TRACE("AcceptedLocations : "_AcceptedLocations) 
    $$$TRACE("AcceptedLocations Count: "_$L(AcceptedLocations, ",")) 
    For iTarget=1:1:$L(AcceptedLocations, ",") 
        { 
        
        //$$$TRACE("For loop index "_iTarget) 
            Set tOneTarget=$ZStrip($P(AcceptedLocations,",",iTarget),"<>W") 
            $$$TRACE("tOneTarget.. "_tOneTarget)
            Continue:""=tOneTarget
            
            //$$$TRACE(" Trig Event:  "_context.TriggerEvent) 
            
            if ((Location = tOneTarget)  || (tOneTarget ="*"))
            {
	            $$$TRACE("Location Accepted")
	            set context.isAcceptedLocation = 1
	            QUIT
            } 
    

         }

 }else{
	 $$$TRACE("Config setting for AcceptedLocation not Available")
