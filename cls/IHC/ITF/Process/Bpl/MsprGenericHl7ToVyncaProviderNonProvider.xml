<code name='CallPersonIDService' xpos='200' ypos='1350' >
<![CDATA[      $$$TRACE("The IHC MSPR# is" _ context.msprNum) 
     $$$TRACE(" Target Operation to MSPR Person ID Search " _ context.msprPersonIdSearchTargetConfigName) 
     set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.httpsRequestForPingService).%New() 
     set httpPingServiceRequestObj.accessToken = context.accessToken 
     set httpPingServiceRequestObj.identifier = context.msprNum  
     set status = process.SendRequestSync(context.msprPersonIdSearchTargetConfigName,httpPingServiceRequestObj,.msprPersonIdSearchResponse)
     
     if ($$$ISOK(status)){
      $$$TRACE("Call MSPR Person ID Search-Operation OK status.")      
      set context.restMsprPersonIdSearchHttpResponse=msprPersonIdSearchResponse  
      set statusService = context.restMsprPersonIdSearchHttpResponse.Attributes.GetAt("STATUS")
      if (statusService="Y"){
      set context.isMsprPersonIdInMspr = context.restMsprPersonIdSearchHttpResponse.Attributes.GetAt("pid")
      if (context.isMsprPersonIdInMspr = "")
      {
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"No person ID found from MSPR service.  Skip the record.")
       
      }
      }else{
	      set errTxt = context.restMsprPersonIdSearchHttpResponse.Attributes.GetAt("ERRTXT")
	      $$$TRACE(" ERROR :"_errTxt)
	      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," ERROR :"_errTxt) 
	      }     
      $$$TRACE("### isMsprPersonIdInMspr: "_context.isMsprPersonIdInMspr_" ####")      
    }else {
      set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Error while calling the MsprPersonIdSearchInMspr.") 
    }    
   ]]]]><![CDATA[>
