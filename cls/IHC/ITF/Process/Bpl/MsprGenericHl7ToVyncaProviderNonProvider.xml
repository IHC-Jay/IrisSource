<code name='Get provider ID and Name' xpos='200' ypos='650' >
<![CDATA[ $$$TRACE("Get the provider's id and name.")
 set context.providerIdStf11 =""
 set context.LastNameSTF31 = ""
 set FirstNameSTF32 = ""
 set SourceAppMSH3 =""
 set SourceAppMSH3 = request.GetValueAt("MSH:3.1")
 $$$TRACE("The message is from --->"_SourceAppMSH3 ) 
  
 set k1="",tSC=1 
 
 For { 
 
         $$$TRACE("***INSIDE THE FOR LOOP for Name.***")
         $$$TRACE(" k1 of loopIndex: " _k1) 
         
         set k1=request.GetNextIndex("MFEgrp(1).STF:3()",k1,.tSCTrans) Quit:k1=""   
    
         set context.providerIdStf11 = request.GetValueAt("MFEgrp(1).STF:1("_k1_").1.1")
         $$$TRACE("context.providerIdStf11 --->"_context.providerIdStf11  ) 
  
         set context.LastNameSTF31 = request.GetValueAt("MFEgrp(1).STF:3("_k1_").1.1")
         $$$TRACE("LastNameSTF31 --->"_context.LastNameSTF31 ) 
                    
        set FirstNameSTF32 = request.GetValueAt("MFEgrp(1).STF:3("_k1_").2") 
        $$$TRACE("FirstNameSTF32--->"_FirstNameSTF32)
                    
      if (context.providerIdStf11 = "")
      { 

            set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The message from the source system: " _SourceAppMSH3_ " has invalid provider ID in STF-6.1.  Skip this message for the source system to fix.")
      }
      else 
      {
      if ((context.LastNameSTF31 = "") && (FirstNameSTF32 = ""))
      {
    
            $$$TRACE("Provider's name is blank." ) 
            set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "The message from the source system:" _SourceAppMSH3_ "  has blank provider Last Name in STF-3.1 and provider First Name STF-3.2.  Skip the message for the source system to fix.")

      }
      else
      {
                    
            $$$TRACE("Provider ID and Name are not missing." ) 

      }  
   }
  }
  ]]]]><![CDATA[>
