    set context.strXmlproxyRequest.StringValue=xmlSuffix_$Replace(strXmlproxyRequest,"!REPLACEWITHNULL!","")
    $$$TRACE("XMLproxy String "_context.strXmlproxyRequest.StringValue)
 } Else {
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Issue creating XMLProxy request to be sent to MSPR - "_$SYSTEM.Status.GetOneErrorText(status))
 }]]]]><![CDATA[>
</code>
