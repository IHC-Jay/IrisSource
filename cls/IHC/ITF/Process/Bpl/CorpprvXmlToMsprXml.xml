<code name='Create REquest/Call and Validate HDD' xpos='200' ypos='1050' >
<![CDATA[  //Provider speciality
  set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
  set specStrs=""
  for i=1:1:request.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.Count() {
	if (request.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content'=""){
	    set specStr = request.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content
	    set specStrs=specStrs_" "_specStr
	   do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , specStr, "291", "50450840",  context.cProviderSpecialityID_specStr)
	} 
  }
 // Call HDD
  If (specStrs'=""){
     set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pNcidRequest,.hddNcidResponse)
     If $$$ISOK(tStatus){ 
        set context.hddAdvProviderSpecialityResponse= hddNcidResponse
        $$$TRACE("HDD Call for Provider Speciality ID Successful")
        // Validate to make sure all the Specialities were found.
        for i=1:1:request.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.Count() {
	    if (request.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content'=""){
	       set specStr = request.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content
	       set hddObj =  ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddNcidResponse,context.cProviderSpecialityID_specStr)	  
	       if ((hddObj ="")||(hddObj.NCID="")){
	      	 set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Cant get NCID for speciality: "_specStr_" in context 50450840, domain 291" )	
	      	 }	  
            }
        }
     }Else {
         set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Cant get NCID for speciality: "_specStrs_" in context 50450840, domain 291"  )
         
     }         
  } ]]]]><![CDATA[>
</code>
<trace name='HDD State code' value='"State Code HDD Look up"' xpos='200' ypos='1150' />
<code name='CreateHDD Request/Call/Validate' xpos='200' ypos='1250' >
<![CDATA[  //Professional licenseInfolicenseNo state code
  set stCodeStr=""
  set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
  If (request.MatchINFO.MatchProfessionalLicenseinfoLicenseNo.content'="") {
	 set st=request.MatchINFO.MatchProfessionalLicenseinfoStateCd.content
	 do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , st, "204648", "50450833",  context.cStateCode_st)
	 set stCodeStr=stCodeStr_","_st
  }
  //Licence Info State code
 for i=1:1:request.LICENSEINFO.Count(){
	set st=request.LICENSEINFO.GetAt(i).PROVIDERLICENSESTATECD.content
	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , st, "204648", "50450833",  context.cStateCode_st)
	set stCodeStr=stCodeStr_","_st
 }	
 
  
 // Call HDD
  If (stCodeStr'=""){
     set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pNcidRequest,.hddNcidResponse)
     If $$$ISOK(tStatus){ 
        set context.hddStateCodeResponse= hddNcidResponse
        $$$TRACE("HDD Call for State Code Successfull")
        // Validate to make sure all the StateCode were found.
        for i=1:1:$length(stCodeStr,",") {
			set st = $piece(stCodeStr,",",i)
			if (st'=""){
				set hddObj =  ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddNcidResponse,context.cStateCode_st)	  
				if ((hddObj ="")||(hddObj.NCID="")){
					set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Can't get NCID for assigning state: "_st_" in context 204648, domain 50450833" )	
					quit
				}
			}	  
        }
        
     }Else {
         set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Can't get NCID for assigning state: "_stCodeStr_" in context 204648, domain 50450833"  )
         
     }         
  } ]]]]><![CDATA[>
</code>
