<Method name="createHDDObject">
<FormalSpec>pRequest:IHC.ITF.DStruc.Schema.CORPPRVProviderRequest.CORPPRVPROVIDER,*pNcidRequest:IHC.ITF.ITFCOMMON.HDD.NcidLookupRequest</FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tSC AS %Status=$$$OK
	// Title Name
	set cTitleNm="ADVPROVIDERTITLENM"
	set cProviderSpecialityID="ADVPRVDRSPCLTYSPCLTYID"
	set cProcessionalLicenceStCd="MatchProfessionalLicenseinfoStateCd"
	set cProviderLicenceStCd="PROVIDERLICENSESTATECD"
	set cAffFacInfoEntId="ADVFACILITYAFFILIATIONAFFILENTITYID"
	set cAffiFac="ADVFACILITYAFFILIATIONFCILITY"
	set cAffFacType="ADVFACILITYAFFILIATIONAFFILENTITYTYPEID"
	set cAffFacRoleStr="ADVFACILITYAFFILIATIONPROVIDERROLEID"
	//
	set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
	set titleNm=##class(Ens.Util.FunctionSet).ToUpper(pRequest.PROVIDERDEMOGRAPHIC.ADVPROVIDERTITLENM.content)
	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , titleNm,  "520673334", "50035",  cTitleNm_titleNm)    
	//Provider speciality
	for i=1:1:pRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.Count() {
		if (pRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content'=""){
			set specStr = pRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content
			do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , specStr, "291", "50450840",  cProviderSpecialityID_specStr)
		} 
		
	}
	//Professional licenseInfolicenseNo state code
	If (pRequest.MatchINFO.MatchProfessionalLicenseinfoLicenseNo.content'="") {
		If (pRequest.MatchINFO.MatchProfessionalLicenseinfoStateCd.content'="") {
			set st=pRequest.MatchINFO.MatchProfessionalLicenseinfoStateCd.content
			do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , st, "204648", "50450833",  cProcessionalLicenceStCd_st)
			
		}
	
	}
	//Licence Info
	for i=1:1:pRequest.LICENSEINFO.Count(){
		set st=pRequest.LICENSEINFO.GetAt(i).PROVIDERLICENSESTATECD.content
		do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , st, "204648", "50450833",  cProviderLicenceStCd_st)
	}
	
	//Facility INFO
	for i=1:1:pRequest.FACILITYINFO.Count(){
		//Entity ID NCID
		set facEntId=pRequest.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONAFFILENTITYID.content
		do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , facEntId, "50450816", "50450930",  cAffFacInfoEntId_facEntId)
		//Affiliation facility
		set affiFac=pRequest.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONFCILITY.content
		if (affiFac'=""){
			do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , affiFac, "119", "50481739",  cAffiFac_affiFac)
		}
		//Fac type
		set facType=pRequest.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONAFFILENTITYTYPEID.content
		do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , facType, "50481701", "50035",  cAffFacType_facType)
		//Fac Role Str	
		set facRoleStr=pRequest.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONPROVIDERROLEID.content
		if (facRoleStr'=""){
			do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , facRoleStr, "272", "50481969",  cAffFacRoleStr_facRoleStr)
		}
		
	}
	
	
	quit tSC
]]></Implementation>
</Method>

