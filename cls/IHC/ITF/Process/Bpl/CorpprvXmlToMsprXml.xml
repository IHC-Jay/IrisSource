<code name='SetmsprMasterRequest' xpos='200' ypos='2250' >
<![CDATA[ set context.msprMasterRequest=##class(IHC.ITF.DStruc.Schema.MasterProviderRequest.PROVIDERINFO).%New()
 set context.msprMasterRequest.sourceSystem="CORPPRV"
 set tmspr=##class(IHC.ITF.DStruc.Schema.MasterProviderRequest.MSPR).%New()
 set tmspr.content=context.MSPRResponseString
 set context.msprMasterRequest.MSPR=tmspr
 set status=request.XMLExportToString(.strCorpPrv)
 If ($$$ISOK(status)){
    set tCorpprv=##class(IHC.ITF.DStruc.Schema.MasterProviderRequest.CORPPRV).%New()
    set tCorpprv.content=strCorpPrv
    set context.msprMasterRequest.CORPPRV=tCorpprv
    $$$TRACE("CorpPrv HR Record "_strCorpPrv)
    $$$TRACE("MSPR Response "_context.MSPRResponseString)
 }Else {
      set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,$SYSTEM.Status.GetOneErrorText(status))
  }]]]]><![CDATA[>
