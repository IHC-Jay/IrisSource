	set facEntId=request.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONAFFILENTITYID.content
	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , facEntId, "50450816", "50450930",  context.cAffFacInfoEntId_facEntId)
	//Affiliation facility
	set affiFac=request.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONFCILITY.content
	if (affiFac'=""){
		do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , affiFac, "119", "50481739",  context.cAffiFac_affiFac)
	}
	//Fac type
	set facType=request.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONAFFILENTITYTYPEID.content
	do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , facType, "50481701", "50035",  context.cAffFacType_facType)	//Fac Role Str	
	set facRoleStr=request.FACILITYINFO.GetAt(i).ADVFACILITYAFFILIATIONPROVIDERROLEID.content
    if (facRoleStr'=""){
	     do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , facRoleStr, "272", "50481969",  context.cAffFacRoleStr_facRoleStr)
	}
  }  
  set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pNcidRequest,.hddNcidResponse)
  set context.hddFacilityInfoNcidResponse=hddNcidResponse]]]]><![CDATA[>
