<code name='Create MSPR Proxy Request' xpos='200' ypos='1650' >
<![CDATA[   //set status=context.msprRequest.%Save()
  // $$$LOGINFO("status of save "_status)
   set quote=""""
   set status=context.msprRequest.XMLExportToString(.strXmlproxyRequest)
    $$$LOGINFO("XMLproxy String conversion Status "_status)
 If ($$$ISOK(status)){
    set context.strXmlproxyRequest=##class(Ens.StringRequest).%New()
