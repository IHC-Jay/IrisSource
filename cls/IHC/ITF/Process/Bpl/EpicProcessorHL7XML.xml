<![CDATA[  $$$TRACE("*** Create Stream Container")
   // set context.scTp = ##class(IHC.ITF.DStruc.Record.StreamContainerWithTransType).%New()
   set context.scTp.Stream = ##class(%Library.FileCharacterStream).%New()
 
   set context.scTp.TpName = context.partnerName
   set context.scTp.Folder = "hl7"
   set context.scTp.TransType = context.transTypeName
   set context.scTp.TradingPartnerName = context.partnerName
