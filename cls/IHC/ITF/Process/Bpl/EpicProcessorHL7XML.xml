   set context.scTp.TransFileName = ""
   
   set stat = response.OutputToLibraryStream(context.scTp.Stream) 

   if ('stat) { 
      set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName," Unexpected response returned from Stream Copy." _$SYSTEM.Status.GetOneErrorText(stat))    
   }
   else
   {
      $$$TRACE("OutputToLibraryStream OK")
   }
   set flNm = context.hl7Msg.DocType
   
   set workFileName = context.partnerName _ "_" _ context.transTypeName _ "_" _ $ZDATETIME($ZTIMESTAMP,8,1,9) _ "_" _ request.%Id() _ ".xml"
   
   $$$TRACE("Output Filename: " _ workFileName)
