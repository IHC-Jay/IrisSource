 set context.hddTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","HddTargetConfigName",.pstatus)
 if ($$$ISOK(pstatus)){
 	$$$TRACE("HddTargetConfigName: " _ context.hddTargetConfigName)
