<code name='ValidateAndSetEmpiNumber' xpos='200' ypos='650' >
<![CDATA[
 Set context.ellkayMrn = request.GetValueAt("PIDgrp.PID:PatientID.ID")
 $$$TRACE("ELLKAY mrn#: "_context.ellkayMrn)
     	
    if ($ISVALIDNUM(context.ellkayMrn)'="1"){
	  set context.isValidationPassed=0
	  $$$TRACE("Empi# is NOT a VALID number ")
	  //set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName," Skipping the record. Invalid ELLKAY mrn#:["_context.ellkayMrn_"]")
 	}
 	  ]]]]><![CDATA[>
</code>


<code name='ValidateAndSetOrderStatus' xpos='200' ypos='650' >
<![CDATA[
 set context.orc5OrderStatus = request.GetValueAt("ORCgrp(1).ORC:OrderStatus")  
 if (context.orc5OrderStatus '= "") {
	 $$$TRACE(" Order Status: ["_context.orc5OrderStatus_"]")     
 }else{
	 set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, " Skipping the record.. Order Status is empty/blank. Empi number:["_context.ellkayMrn_"].")
	 } 
 ]]]]><![CDATA[>
</code>



<switch name='OrderStatus' xpos='335' ypos='1800' xend='335' yend='2050' >

<case condition='"M"=context.orc5OrderStatus' name='CompleteManualTriggerTransmitWithPossibleBatching' >
<assign name="OrdStausTransmit" property="context.ellKayTargetConfig" value='"Out-Sunquest-Hl7-BRIDGE-Ens-TO-EnsLAB-ELLKAY"' action="set" xpos='470' ypos='1950' />
</case>
<case condition='context.orc5OrderStatus="E"' name='CompleteRTtransmit' >
<assign name="OrdStausManualTrigger" property="context.ellKayTargetConfig" value='"Out-Sunquest-Hl7-BRIDGE-Ens-TO-EnsLAB-ELLKAY"' action="set" xpos='470' ypos='1950' />
</case>

<case condition='context.orc5OrderStatus="I"' name='Uncollected' >
<assign name="OrdStausIncomplete" property="context.ellKayTargetConfig" value='"Out-Cern-LabOrd-Hl7tcp-ELLKAY"' action="set" xpos='470' ypos='1950' />
</case>

<case condition='context.orc5OrderStatus="P"' name='Uncollected' >
<assign name="OrdStausIncomplete" property="context.ellKayTargetConfig" value='"Out-Cern-LabOrd-Hl7tcp-ELLKAY"' action="set" xpos='470' ypos='1950' />
</case>

<default/>
</switch>

<code name='GetNcidFromRep' xpos='470' ypos='1400' >
<![CDATA[
  	$$$TRACE(" Calling getNcidFromRep...")  	
  	set obr15Rep = request.GetValueAt("OBR:ORCgrp().OBRuniongrp.OBRunion.OBR:15")     	  	
  	if (obr15Rep '= ""){		
		try{
	     	$$$TRACE(" Calling hdd GetNcidFromRep for "_ obr15Rep)	    
         	set status = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.TerminalogyLookupUtil).getNcidFromRep(obr15Rep,"OBR-15","10446","526037059",hddTargetConfigName,.process, .retVal)
         	$$$TRACE(" Returned Ncid: " _ retVal_ " from the Rep: "_obr15Rep )	
			set context.obr15 = retVal		
     	}catch(exVar){
	     	set exVarData = $ZSTRIP(exVar.Data,"*C")
	     	set context.obr15 = "" 
     	}	
		$$$TRACE(" Ncid OBR:15 is " _ context.obr15)		
	}  
	
]]]]><![CDATA[>
</code>

<transform name='Transform' class='IHC.ITF.Transform.Dtl.EllkayLabOrdHl7ToSunquestCern' source='request' target='response' xpos='200' ypos='1450' >
