</transform>

<code name='SendEllkayOrder' xpos='200' ypos='750' >
<![CDATA[  
  $$$TRACE("Sending Order to.."_context.ellKayTargetConfig)
  if ($L(context.ellKayTargetConfig)>0){
  	set tStatus=process.SendRequestSync(context.ellKayTargetConfig,response)
  }else{
	  	 set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, " Skipping the record.. Order Status:["_context.orc5OrderStatus _"] is invalid from ELLKAY. Empi number:["_context.ellkayMrn_"].")
  }
 if ($$$ISOK(tStatus)){
    $$$TRACE(" Order sent Successfully.. ")
 } 
 ]]]]><![CDATA[>
</code>


