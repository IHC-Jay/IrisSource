<code name='manipulate NU room and Bed' xpos='470' ypos='1200' >
<![CDATA[ set nu = request.GetValueAt("PV1:3.1")
 $$$TRACE(" Nursing unit at PV1-3.1:"_nu)
  set NUList = $LISTFROMSTRING(nu,"_")
 if ((NUList '= "") &&( $LISTLENGTH(NUList) > 1))
 {
    set hospital = $LIST(NUList,1)
    set length = $LENGTH(hospital)
     $$$TRACE(" Length of hospital:"_length)
     
    set nursingUnit = $REPLACE(nu,"_","")
     $$$TRACE(" after replacing the _ with blanks "_nursingUnit)
    
    set nursingUnit = $REPLACE(nursingUnit," ","")
     set totallength = $LENGTH( nursingUnit)
    set nursingUnit =  $WEXTRACT(nursingUnit,length+1,totallength)
    
     $$$TRACE(" nursing unit value "_nursingUnit)
     set length = $LENGTH(nursingUnit )
     
    $$$TRACE(" Length of NU PV1-3.1:"_length)
    if ( length > 12 )
   {
     set context.NU =  $WEXTRACT(nursingUnit,0,12)
   }
   else
   {
     set context.NU = nursingUnit
   }
 }
 else
 {
 set context.NU = nu
 }

 
  set patRoom = request.GetValueAt("PV1:3.2")
  set context.Room = $REPLACE(patRoom," ","")
  $$$TRACE("Room value after removing space:"_context.Room)
 set context.RoomLength = $LENGTH(context.Room)
 if ( context.RoomLength > 12)
 {
  
  set patRoomList = $LISTFROMSTRING(patRoom," ")

   if (patRoomList '= "") 
 {
 
 $$$TRACE(" List is not empty")
 set context.splitRoom = 1
  set context.RLcount = $LISTLENGTH(patRoomList)
 $$$TRACE("Room Location List count:"_context.RLcount) 
 Do context.patRoomList.InsertList(patRoomList)
 }
 else
 {
 set context.Room =  $WEXTRACT(context.Room,0,12)
 }
  
  
  } 
 
