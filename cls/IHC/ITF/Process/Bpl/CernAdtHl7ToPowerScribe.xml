<Data><![CDATA[
<process language='objectscript' request='Ens.Request' response='Ens.Response' height='2100' width='2000' >
<context>
<property name='errorStatus' type='%Status' initialexpression='$$$OK' instantiate='0' >
</property>
<property name='isValidationPassed' type='%Boolean' initialexpression='1' instantiate='0' >
</property>
<property name='configValue' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='100' />
</parameters>
</property>
<property name='validationSetting' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='replyCodeActions' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='100' />
</parameters>
</property>
<property name='targetConfigNames' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='100' />
</parameters>
</property>
<property name='targetList' type='%String' collection='list' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='targetConfigIndex' type='%Integer' instantiate='0' >
</property>
<property name='failedReason' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='triggerEvent' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
</context>
<sequence xend='200' yend='1550' >
<scope xpos='200' ypos='250' xend='200' yend='1450' >
<trace name='Debug' value='"In BPL: " _ $CLASSNAME() _ ", Process: " _ process.%ConfigName' xpos='200' ypos='350' />
<trace name='Incoming Message' value=' "Incoming Message: "_request.RawContent' xpos='200' ypos='450' />
<code name='Initialization &amp; Validation' xpos='200' ypos='550' >
<annotation><![CDATA[initialize the bp using the configuration and validate the rules]]]]><![CDATA[></annotation>
<![CDATA[ 
 //MaxErrors
 set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)

 //ReplyCodeActions validation
 set context.replyCodeActions=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","ReplyCodeActions",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.replyCodeActions= "")) {
 	set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to get ReplyCodeActions, shutting down.")   
 } else {
    $$$TRACE("ReplyCodeActions: " _ context.replyCodeActions)
 }
 
 //TargetConfigNames validation
 set context.targetConfigNames=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","TargetConfigNames",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.targetConfigNames= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to get targetConfigNames, shutting down.")   
 } else {
    $$$TRACE("TargetConfigNames: " _ context.targetConfigNames)
    set pstatus = ##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList)
    $$$TRACE("TargetListCount: " _ context.targetList.Count())   
 }
 
 //Validate the message against schema
 set context.validationSetting=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.validationSetting = "")) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to get validationSetting, shutting down.")
 } else {
    $$$TRACE("ValidationSetting: " _ context.validationSetting) 
    set pStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,context.validationSetting)
	if (pStatus'=$$$OK) {
	    $$$TRACE("Message validation failed against schema")
	    set context.isValidationPassed=0
	    set context.failedReason="Validation"
	}
 }
 
 //Filter message if TriggerEvent is not present in TriggerEventFilter LT
 set context.triggerEvent=request.GetValueAt("MSH:MessageType.TriggerEvent") 
 $$$TRACE("TriggerEvent [" _context.triggerEvent_"]")
    
 set retStat = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToPowerScribe.Lookup.TriggerEventFilter", context.triggerEvent, .retVal )	
 if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {   
     set context.isValidationPassed=0
     set context.failedReason="TriggerEvent"
 }]]]]><![CDATA[>
</code>
<if name='IsValidMessage' condition='context.isValidationPassed' xpos='200' ypos='650' xend='200' yend='1200' >
<true>
<transform name='Transform' class='IHC.ITF.Transform.Dtl.CernerAdtHl7ToPowerScribe' source='request' target='response' xpos='470' ypos='800' >
<annotation><![CDATA[translate legacy ADT to PowerScribe ADT format]]]]><![CDATA[></annotation>
</transform>
<trace name='Transform Output' value='"Message after Transform: " _ response.RawContent' xpos='470' ypos='900' />
<foreach name='Send To Each Target Conf' property='context.targetList' key='context.targetConfigIndex' xpos='470' ypos='1000' xend='200' yend='350' >
<call name='CallTargetConfigNames' target='@context.targetList.GetAt(context.targetConfigIndex)' async='1' xpos='200' ypos='250' >
<request type='Ens.Request' >
<assign property="callrequest" value="response" action="set" />
</request>
<response type='Ens.Response' />
</call>
</foreach>
<code name='Reset Error' xpos='470' ypos='1100' >
<![CDATA[ Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)]]]]><![CDATA[>
</code>
</true>
<false>
<code name='Skip Message' xpos='200' ypos='800' >
<![CDATA[ 
 if (context.failedReason = "TriggerEvent") {
   set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "TriggerEvent:["_context.triggerEvent_"]. Skipping the record." _ "Hl7 Msg:[" _ request.RawContent  _"]")
  } elseif (context.failedReason = "Validation") {
   set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Validation against schema failed. Skipping the record." _ "Hl7 Msg:[" _ request.RawContent  _"]")  
  }]]]]><![CDATA[>
</code>
</false>
</if>
<faulthandlers>
<catchall xpos='200' ypos='1300' xend='200' yend='350' >
<code name='Call ProcessError' xpos='200' ypos='250' >
<annotation><![CDATA[Call error handler method]]]]><![CDATA[></annotation>
<![CDATA[ Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).ProcessError(..%Context.%LastError)
]]]]><![CDATA[>
</code>
</catchall>
</faulthandlers>
</scope>
</sequence>
</process>
]]></Data>
</XData>

