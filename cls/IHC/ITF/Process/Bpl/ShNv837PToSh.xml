<code name='Get 2010BA NM1' xpos='335' ypos='1450' >
<![CDATA[ if (context.x12Doc.DocType = "")
	 {
 		set context.x12Doc.DocType = "HIPAA_5010:Interchange:Group"
	 }
	  Set tSC =context.x12Doc.BuildMap()
	  if ($$$ISERR( tSC ))
	  {
		  $$$TRACE("Invalid DocType")
		  QUIT
	  }
	  set GSCounter = context.x12Doc.ChildCount
  
		   	
 	#dim individualGroup As EnsLib.EDI.X12.Document = $$$NULLOREF
	for gsInt=1:1:GSCounter
    { 
        
        set individualGroup = context.x12Doc.NextChild(individualGroup) // context.x12Doc.getNthChild(gsInt,2)

		$$$TRACE( "# of STs: " _ individualGroup.ChildCount )
		  #dim STRecord As EnsLib.EDI.X12.Document = $$$NULLOREF
		  FOR stInd=1:1:individualGroup.ChildCount
		  
		  {
			  		  
			  set STRecord=individualGroup.NextChild(STRecord)  
			  
			  if (STRecord.DocType = "")
			  {	
			  	set STRecord.DocType = "HIPAA_5010:837P"
			  }
			  set segPath = STRecord.GetSegmentPath(1, .stat)	  	
			  set stCtrl = STRecord.GetValueAt(segPath_":2",, .stat)
			  		    
	  		  set firstHL = 0, loop2010AHL = 0, prevHL = 0
	  		  
			  FOR ind=1:1:STRecord.SegCountGet()
			  {		
			    	  
				set segPath = STRecord.GetSegmentPath(ind, .stat)	  	
			  	set segVal = STRecord.GetValueAt(segPath,, .stat)
			  				  	
			  	if (segPath [ "loop2010BA.NM1!1=IL") 
			  	{
			  	        // target.FunctionalGroups(k1).TransactionSets(k2).{loop2000A(k3).loop2000B(k4).loop2010BA.NM1!1=IL:IdentificationCode}
				  	set sbId = $EXTRACT(STRecord.GetValueAt(segPath_":9",, .stat), 1, 9)
				  	if ($GET(sbIdArr(sbId)) = 1)
				  	{
				  	   $$$TRACE( gsInt _"." _ stInd _"."_ ind _": REPEAT name" _" - " _ segPath _"= " _ sbId _", " _ segVal )
				  	   
				  	}
				  	else
				  	{
				  	    // $$$TRACE( gsInt _"." _ stInd _"."_ ind _": " _ segPath _"= " _ sbId _", " _ segVal )
				  	    set sbIdArr(sbId) = 1
				  	}
			  	}
			  }
		  }
    }
    set context.facList = ##class(IHC.ITF.DStruc.ListOfSbSb).%New()

    SET key=$ORDER(sbIdArr(""))
    WHILE (key'="") {
         set facObj = ##class(IHC.ITF.DStruc.FacetsInformation).%New()
	 set facObj.SbSbId = key
         Do context.facList.lst.Insert(facObj)
         // Get next subscript 
         SET key = $ORDER(sbIdArr(key))
   }
   $$$TRACE( "loop2010BA NM1 List count: " _ context.facList.lst.Count() )
   
   ]]]]><![CDATA[>
