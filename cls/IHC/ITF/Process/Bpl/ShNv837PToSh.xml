<code name='Remove segments' xpos='200' ypos='2150' >
<![CDATA[ 
 if (response.DocType = "")
 {
	set response.DocType = "HIPAA_5010:Interchange"
 }
    #dim individualGroup As EnsLib.EDI.X12.Document = $$$NULLOREF
    
    
    set GSCounter = response.ChildCount
    for gsInt=1:1:GSCounter
    { 
        
        set individualGroup = response.NextChild(individualGroup) // response.getNthChild(gsInt,2)

		$$$TRACE( individualGroup.DocType _ " # of STs: " _ individualGroup.ChildCount _", Seg # " _ individualGroup.SegCount)
		
		if (individualGroup.DocType = "")
		 {
	 		set individualGroup.DocType = "HIPAA_5010:Group"
		 }
		  #dim STRecord As EnsLib.EDI.X12.Document = $$$NULLOREF
		  FOR stInd=1:1:individualGroup.ChildCount
		   {
			set STRecord=individualGroup.NextChild(STRecord) 
			if (STRecord.DocType = "")
		 	{
	 			set STRecord.DocType = "HIPAA_5010:837P"
		 	}		  
			  // $$$TRACE(stInd _ ". ST: " _ STRecord.SegCountGet())
			  set remInd = 1, remInd(1) = 0, delInd = 0, clmFreqCode = 0
			  FOR ind=1:1:STRecord.SegCountGet()
			  {					    
				set segPath = STRecord.GetSegmentPath(ind, .stat)	  	
			  	set segVal = STRecord.GetValueAt(segPath,, .stat)
			  	
			  	if ($FIND(segVal, "CLM") = 4)
			  	{
			  	  set clmFreqCode = STRecord.GetValueAt(segPath _":5.3",, .stat)
			  	  if (clmFreqCode = 7)
			  	  {
			  	    Do STRecord.SetValueAt("1", segPath _":5.3")
			  	    // $$$TRACE(segVal _", " _ clmFreqCode )
			  	  }
			  	  // $$$TRACE(segVal _", " _ clmFreqCode )
			  	}
			  	
				// WRITE !, segPath _ ": " _ segVal
				set matStr = $MATCH(segPath, ".*loop2300\(\d+\)\.DTP\(\d+\).*")
				if ( matStr )
			  	{
				  	// WRITE !, ind _". DTP = " _ segPath _ ": " _ segVal
				  	if (STRecord.GetValueAt(segPath _":3",, .stat) = "")
				  	{
					  	
					  	Do $INCREMENT(delInd)
					  	set remInd(delInd) = ind
				  	 
				  	}
			  	}
			  	set matStr = $MATCH(segPath, ".*loop2310A\(\d+\)\.NM1.*")
				if ( matStr )
			  	{
				  	$$$TRACE(stInd _". " _ ind _". NM1 = " _ segPath _ ": " _ segVal)
				  					  	
					Do $INCREMENT(delInd)
					set remInd(delInd) = ind
			  	}
			  	if (clmFreqCode = 7)
			  	{
			  	   set matStr = $MATCH(segPath, ".*loop2300\(\d+\)\.REF.*")
			  	   if ( matStr )
			  	   {
			  	
			  	        
				  	if (STRecord.GetValueAt(segPath _":1",, .stat) = "F8")
				  	{
					  	
					  	Do $INCREMENT(delInd)
					  	set remInd(delInd) = ind
					  	$$$TRACE("Delete: " _ ind _". REF = " _ segPath _ ": " _ segVal _", CLM 5.3: " _ clmFreqCode)
				  	 
				  	}
				  	
			  	   }
			  	}
			  	
			  	
			  }
			  
			  if (delInd >= 1)
			  {
			     set origSegCnt = STRecord.SegCount
			     FOR ind=delInd:-1:1
			     {
			  	$$$TRACE( "Remove: " _ remInd(ind) _ ", segCount: " _ STRecord.SegCount )
			  	Do STRecord.RemoveSegmentAt(remInd(ind))
			     }
			  	
			     $$$TRACE("Deleted: " _ delInd _ " segments. Replace GS with New ST: " _ STRecord.%Id() _ ". New count: " _ STRecord.SegCount _ ", Orig # " _ origSegCnt )
			  	
			     Set response.FunctionalGroups(gsInt).TransactionSets(stInd)=STRecord

		
			  }
			   
		  }
		    		  
		  
   }
 		 
 set context.outStreamContainer.Stream = ##class(%Stream.GlobalCharacter).%New()
 set tSC= response.OutputToLibraryStream(context.outStreamContainer.Stream)
  $$$TRACE("Modified X12 OutputToLibraryStream. stat: " _ tSC _ ", Stream size: " _ context.outStreamContainer.Stream.Size)
  
  set tempNm = $REPLACE($REPLACE(request.OriginalFilename, "SH_SEN_837P_", "MAClaimsPROF.IHNV."), ".837", ".TXT") 
 
  set context.outStreamContainer.OriginalFilename = $E(tempNm, 1, $FIND(tempNm, "TXT")-1) // Remove everything after TXT
]]]]><![CDATA[>
