   if '$$$ISOK(sc){
      set stattus=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
   } 
   Else {
      Do reader.Correlate("CORPPRV_PROVIDER","IHC.ITF.DStruc.Schema.CORPPRVProviderRequest.CORPPRVPROVIDER")
        do reader.Next(.CorpprvProvider,.sc)
      If $$$ISOK(sc){
	    set context.CorpprvRequest=CorpprvProvider
	    Set context.proId=CorpprvProvider.PROVIDERDEMOGRAPHIC.ADVPROVIDERPRVDRID.content
	    set context.cProviderStatusID = CorpprvProvider.PROVIDERDEMOGRAPHIC.ADVPROVIDERPRVDRSTATUSID.content // JIRA - AIKB-3051
      }
      Else {	  
         set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Parsing the Corpprv String"_$SYSTEM.Status.GetOneErrorText(sc))  
      } 
  }]]]]><![CDATA[>
