<code name='HDD Call for Specialty Code' xpos='605' ypos='1350' >
<![CDATA[   //Provider specialty
  $$$TRACE(" HDD Call for Provider specialty")
  set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
  set pRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
  set hasSpecialtyId=0
  set status=$$$OK
  Set k1="",tSC=1
  For {
		Set k1=context.CactusRequest.GetNextIndex("Provider(1).ProviderSpecialtiesRecord()",k1,.tSCTrans)
		Quit:k1=""	
		Set spcltyId=$ZSTRIP(context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").specialty_rtk.ID"),"<>W")
		Set active=context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").active")
		$$$TRACE("ACTIVE: "_active)
		if ((spcltyId '="") && ((active=1) || (active=".T."))) {
		   $$$TRACE("Provider Specialty ID: "_spcltyId)
		   set hasSpecialtyId=1
	       do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , spcltyId, context.SPECLTYDMN, context.CACTUSCNTXT, spcltyId)
		}
 } 
  
 // Call HDD
  set createRepObj=0
  set ncidStr=""
  If (hasSpecialtyId){
     set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pNcidRequest,.hddNcidResponse)
     If $$$ISOK(tStatus){ 
        set context.hddProviderSpecNcidResponse= hddNcidResponse
        $$$TRACE("HDD Call for Provider Specialty ID Successful")
        // Validate to make sure all the Specialities were found.
        Set k1="",tSC=1
		For {
		   Set k1=context.CactusRequest.GetNextIndex("Provider(1).ProviderSpecialtiesRecord()",k1,.tSCTrans)
		   Quit:k1=""
	       Set spcltyId=$ZSTRIP(context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").specialty_rtk.ID"),"<>W")
		   Set active=context.CactusRequest.GetValueAt("Provider(1).ProviderSpecialtiesRecord("_(k1)_").active")
     	   if ((spcltyId '="") && ((active=1) || (active=".T."))) {
 	          set hddObj =  ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddNcidResponse,spcltyId)	  
	                  $$$TRACE("HDD Call for Provider Specialty ID Successful-2")
	          if ((hddObj '="")||(hddObj.NCID'="")){
		                  $$$TRACE("HDD Call for Provider Specialty ID Successful-3")
			    do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(pRepRequest , hddObj.NCID, context.TEXTCNTXT,  spcltyId)
			    set ncidStr=ncidStr_" "_hddObj.NCID
			    set createRepObj=1
			   }
     	   } 
         }
      }
      else {
         set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"****HDD NCID for specialty call failed... ")
     }         

  }
          $$$TRACE("HDD Call for Provider Specialty ID Successful-4")
  
  If (($$$ISOK(status))&&(createRepObj=1)){
     set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pRepRequest,.hddNcidResponse)
     If $$$ISOK(tStatus){ 
	     set context.hddProviderSpecRepResponse= hddNcidResponse 
     }Else {
