<code name='Parse MSPR Response message' xpos='200' ypos='850' >
<![CDATA[  // Parse MSPR Response
   
  $$$TRACE("Parse MSPR response String")
  set replstr="<?xml version="_""""_"1.0"_""""_"?>"
  set MSPRResponseString=$Replace(request.MSPR.content,replstr,"")
  // Remove the XMl Version tag from start and Junk characters at the end
  set MSPRResponseString="<CiwsInfo>"_$piece(MSPRResponseString,"<CiwsInfo>",2)
  set MSPRResponseString=$piece(MSPRResponseString,"</CiwsInfo>")_"</CiwsInfo>"
  Set reader = ##class(%XML.Reader).%New()
  Set sc=reader.OpenString(MSPRResponseString)
  $$$TRACE(MSPRResponseString)
  if '$$$ISOK(sc){
      set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
  } 
  Else {
      Do reader.Correlate("CiwsInfo","IHC.ITF.DStruc.Schema.XMLPROXYMSPRRESPONSE.CiwsInfo")
      do reader.Next(.CiwsInfo,.sc)
      If $$$ISOK(sc){
	      set context.msprResponse=CiwsInfo
	      try { 
	         $$$TRACE("Check Unit Number")
	         set context.UnitNumber=context.msprResponse.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).unitNumber.content
	        $$$TRACE(" Unit Number "_context.UnitNumber)
	        //set ^IHC("MSprPRoviderToGenericHl7","SExCdBpl")=context.msprResponse.ServiceMessage.MsprInfo.dataRecord.msprRecords.Item.GetAt(1).memberInfo.sex.content
	        If ((context.UnitNumber="")){
	           set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Unit number missing from MSPR response please contact the sorce system and MSPR to resolve the issue") 
	        }
	      }catch {
	           set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Unit number missing from MSPR response please contact the source system and MSPR to resolve the issue") 
	      }  
	      
      }
      Else {	  
          set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error Processing Response Back From MSPR"_$SYSTEM.Status.GetOneErrorText(sc))  
      }    
  } ]]]]><![CDATA[>
</code>
