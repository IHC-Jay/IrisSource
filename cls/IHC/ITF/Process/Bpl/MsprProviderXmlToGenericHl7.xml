<code name='HDDLookUpProvSpecialty' xpos='200' ypos='1200' >
<![CDATA[   //Provider specialty
   $$$TRACE("HDD Call for Corpprv Provider Specialty")
  set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
  set pRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
  set specStrs=""
  set hasSpecialtyNcid=0
  set status=$$$OK
  for i=1:1:context.CorpprvRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.Count() {
	if (context.CorpprvRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content'=""){
	    set specStr = context.CorpprvRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content
	    set hasSpecialtyNcid=1
	   do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddRepToNcidObject(pNcidRequest , specStr, context.SPECLTYDMN, context.CORPPRVCNTXT,  context.cProviderSpecialtyID_specStr)
	} 
  }
 // Call HDD
  set createRepObj=0
  If (hasSpecialtyNcid){
     set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pNcidRequest,.hddNcidResponse)
     If $$$ISOK(tStatus){ 
        set context.hddAdvProviderSpecialtyNcidResponse= hddNcidResponse
        $$$TRACE("HDD Call for Provider Specialty ID Successful")
        // Validate to make sure all the Specialities were found.
        for i=1:1:context.CorpprvRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.Count() {
	    if (context.CorpprvRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content'=""){
	       set specStr = context.CorpprvRequest.PROVIDERDEMOGRAPHIC.ADVPRVDRSPCLTYSPCLTYID.GetAt(i).content
	       set hddObj =  ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddNcidResponse,context.cProviderSpecialtyID_specStr)	  
	       if ((hddObj ="")||(hddObj.NCID="")){
	      	 set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"*Cant get NCID for specialty: "_specStr_" in context 50450840, domain 291" )	
	       }Else{
		     // Construct the NCIDToRep object 
			 do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(pRepRequest , hddObj.NCID, context.TEXTCNTXT,  context.cProviderSpecialtyID_hddObj.NCID)
			 set createRepObj=1
			}
			 
         }
        }
     }Else {
         set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"**NCID for specialty HDD cal failed... ")
         
     }         
  } 
  
  If (($$$ISOK(status))&&(createRepObj=1)){
     set tStatus=process.SendRequestSync(process.TargetConfigNameHddWebService,pRepRequest,.hddNcidResponse)
     If $$$ISOK(tStatus){ 
	     set context.hddAdvProviderSpecialtyResponse= hddNcidResponse 
     }Else {
         set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"***HDD Rep for specialty call failed... ")
    }  
  }]]]]><![CDATA[>
