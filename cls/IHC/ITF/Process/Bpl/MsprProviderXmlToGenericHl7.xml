<code name='ProviderEntityHddCall' xpos='605' ypos='1450' >
<![CDATA[ //Provider Entity HDD Call
 $$$TRACE(" HDD Call for Provider Entity Elements ")
 set pNcidRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddNcidReqObject()
 set pParentRepByChildRepRequest = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateUniqueParentRepByChildRepObject()
 Set prvstatus=##class(Ens.Util.FunctionSet).ToUpper(context.CactusRequest.GetValueAt("Provider(1).ProviderDemographicsRecord.status_rtk"))
 Set prvdrActive = context.CactusRequest.GetValueAt("Provider(1).ProviderDemographicsRecord.active")
 set callHdd=0
 //Call HDd to check if the Procider Entetity category has Admit priviledge by calling UniqueParentRepByChildRep
 If ((prvstatus'="DECEASED")) {
	Set k1="",tSC=1
	For {
		Set k1=context.CactusRequest.GetNextIndex("Provider(1).ProviderEntityRecord()",k1,.tSCTrans)
		Quit:k1=""
		Set fac=context.CactusRequest.GetValueAt("Provider(1).ProviderEntityRecord("_(k1)_").entity_k")
	        Set entActive=context.CactusRequest.GetValueAt("Provider(1).ProviderEntityRecord("_(k1)_").active")
	        Set tmdt=context.CactusRequest.GetValueAt("Provider(1).ProviderEntityRecord("_(k1)_").termination_date")
	        If ((context.ParticipationCredentialedPrvdr="N") && ((prvdrActive=1) || (prvdrActive=".T."))) {
	            $$$TRACE( "Active Provider...")
	            If (((entActive=1) || (entActive=".T."))&& (tmdt="")) {
	                $$$TRACE( "Active Entity..."_fac)
	                set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.Cactus.CredentialedEntities", fac, .retVal )
                        If (retVal =1) {
                           $$$TRACE( "Set participation credentialed flag...")
                           set context.ParticipationCredentialedPrvdr="Y"
                        }
	            }
	        }
	        If (##class(Ens.Util.FunctionSet).NotIn(fac,"ALL,Health,Physician,UCR,AVESC,Unaffiliat")) {
			Set priv=context.CactusRequest.GetValueAt("Provider(1).ProviderEntityRecord("_(k1)_").category_rtk.ID")
