<foreach name='Call SH WebService 270/271' property='context.batchReq.RequestList' key='context.reqIndx' xpos='200' ypos='650' xend='200' yend='750' >

<code name='Call SH service' xpos='200' ypos='450' >
<![CDATA[
    $$$TRACE(" Processing Response: "_context.reqIndx)
	set listObj = context.batchReq.RequestList.GetAt(context.reqIndx)
	set flag = 0
    if (listObj.subscriberID = ""){
	  set flag = flag + 1
	}	
	if (listObj.dateOfBirth = ""){
	  set flag = flag + 1
	}		
	if (listObj.patientFirstName = ""){
	  set flag = flag + 1
	}		
	if (listObj.patientLastName = ""){
	  set flag = flag + 1
	}	
	if (listObj.serviceTypeCodes = "" && ($L(serviceTypeCodes)>0)){
	  set flag = flag + 3
	}		
	if ( flag > 1){		
	  set context.isValid = "False"		
	}else{
	  set context.isValid = "True"
	}	
	$$$TRACE("Subscriber flag : "_ listObj.subscriberFlag _ "||subscriberID : "_ listObj.subscriberID _ "|| patientDOB : "_ listObj.dateOfBirth _ "|| patientFirstName : "_ listObj.patientFirstName _ "|| patientLastName : "_ listObj.patientLastName _ "|| patientSSN : "_ listObj.patientSsn _ "|| eligibilityStartDate : "_ listObj.eligibilityStartDate _ "|| eligibilityEndDate : "_ listObj.eligibilityEndDate _ "|| serviceTypeCodes : "_ listObj.serviceTypeCodes)
 	set tStatus=process.SendRequestSync(context.ShWsTargetConfigName, listObj, .wsResponse)
 	if ($$$ISOK(tStatus)){
	 	$$$TRACE("After SH Webservice Call: " _ context.reqIndx_" RESP:"_wsResponse)
	 	if ($IsObject(wsResponse)){     
 			Do context.batchResp.ResponseList.Insert(wsResponse)
 			set respObj = context.batchResp.ResponseList.GetAt(context.reqIndx).GetOutbound271Result
        	$$$TRACE("Op-Sh-270-Wssc returned: " _ wsResponse_ ", SubscriberId : " _ respObj.SubscriberId _", SubscriberFlag : " _ respObj.SubscriberFlag)
  	    	if ( (respObj.MemberFoundCode '= "Y") || ($L(respObj.MemberNotFoundReasonCodes) > 1) || (respObj.ErrorFlag = "Y") ) {
    	    	$$$LOGERROR(" MemberFoundCode :" _ respObj.MemberFoundCode _ ", MemberNotFoundReasonCodes: " _ respObj.MemberNotFoundReasonCodes _ ", ErrorFlag: " _ respObj.ErrorFlag )
     		}
	 	}
 	}else{
		set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Unexpected error while calling SelectHealth 270/271 service "_$SYSTEM.Status.GetOneErrorText(tStatus)) 	
	}
 ]]]]><![CDATA[>
</code>
</foreach>

