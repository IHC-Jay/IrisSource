<![CDATA[    set context.hddTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","HddTargetConfigName",.pstatus)
    if ($$$ISOK(pstatus)){
        $$$TRACE("HddTargetConfigName: " _ context.hddTargetConfigName)
    }
    else {
        Set status = $$$ERROR("Initialization error, No HddTargetConfigName found")
    } 

    $$$TRACE("GetRepfromNcid Hdd Requests..")
    set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
    
   
    set AIS31UniversalServiceIdentifierIdentifier = request.GetValueAt("RGSgrp(1).AISgrp(1).AIS:UniversalServiceIdentifier.Identifier")
    $$$TRACE("AIS-3.1 Universal Service Identifier Identifier REP is " _ AIS31UniversalServiceIdentifierIdentifier)
    if (AIS31UniversalServiceIdentifierIdentifier '= "")
    {
        $$$TRACE("Calling getNcidFromRep for " _ AIS31UniversalServiceIdentifierIdentifier _ "...")
        set context.AIS31UniversalServiceIdentifierIdentifier=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(AIS31UniversalServiceIdentifierIdentifier, context.hddVarianAriaAppointmentDomain, context.hddVarianAriaContext, context.hddTargetConfigName, .process)                              
        $$$TRACE("AIS-3.1 Universal Service Identifier Identifier NCID is " _ context.AIS31UniversalServiceIdentifierIdentifier)
    }
    if (context.AIS31UniversalServiceIdentifierIdentifier = ""){
        set status=##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "RepToNCID hdd call failed in Varian Radiology Oncology scheduling to iCentra interface. Hl7 field: [AIS-3.1]. REP: ["_AIS31UniversalServiceIdentifierIdentifier_"]. DOMAIN: ["_context.hddVarianAriaAppointmentDomain_"]. CONTEXT: ["_context.hddVarianAriaContext_"].")
    }

     set AIL31PointOfCare = request.GetValueAt("RGSgrp(1).AILgrp(1).AIL:LocationResourceID(1).PointofCare")
    $$$TRACE("AIL-3.1 Point of Care REP is " _ AIL31PointOfCare)
    if (AIL31PointOfCare '= "")
    {
        $$$TRACE("Calling getNcidFromRep for " _ AIL31PointOfCare_"...")
        set context.AIL31PointOfCare=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(AIL31PointOfCare, context.hddVarianAriaLocationInclusionDomain, context.hddVarianAriaContext, context.hddTargetConfigName, .process)                              
        $$$TRACE("AIL-3.1 Point of Care NCID is " _ context.AIL31PointOfCare)
    }
    if (context.AIL31PointOfCare = ""){
        set status=##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName, "RepToNCID hdd call failed in Varian Radiology Oncology scheduling to iCentra interface. Hl7 field: [AIL-3.1]. REP: ["_AIL31PointOfCare_"]. DOMAIN: ["_context.hddVarianAriaLocationInclusionDomain_"]. CONTEXT: ["_context.hddVarianAriaContext_"].")
    }

	set SCH71AppointmentReasonIdentifier = request.GetValueAt("SCH:AppointmentReason.Identifier")
    $$$TRACE("SCH-7.1 Appointment Reason Identifier Text REP is " _ SCH71AppointmentReasonIdentifier)
    if (SCH71AppointmentReasonIdentifier '= "")
    {
        $$$TRACE("Calling getNcidFromRep for " _ SCH71AppointmentReasonIdentifier_"...")
        set context.SCH71AppointmentReasonIdentifier=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getNcidFromRep(SCH71AppointmentReasonIdentifier, context.hddVarianAriaAppointmentDomain, context.hddVarianAriaContext, context.hddTargetConfigName, .process)                              
        $$$TRACE("SCH-7.1 Appointment Reason Identifier NCID is " _ context.SCH71AppointmentReasonIdentifier)
    }
