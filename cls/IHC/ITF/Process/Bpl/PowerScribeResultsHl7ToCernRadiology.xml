<transform name='get REST request' class='IHC.ITF.ITFCOMMON.Transform.JsonToHttp' source='context.jsonRequest' target='context.icentraSvcRequest' xpos='200' ypos='1650' />
<code name='Call the REST service to get attending doctor info' xpos='200' ypos='1750' >
<![CDATA[ $$$TRACE("Call REST Operation")
  if (context.icentraSvcRequest'="") {
    set statusLine=""
    set statusCode=""
    set statusDesc=""
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync("Op-CernEdge-Wsrc-ENCNTRTYPE",context.icentraSvcRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set context.restHttpResponse=httpRESTResponse
      set statusLine=context.restHttpResponse.HTTPHeaders.GetAt("StatusLine")
      if (statusLine'=""){
	set statusCode=$piece(statusLine," ",2)
	set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
		  // If status code is 200 the check the reponse to see if it got processed correctly or not
      if (statusCode'="200"){
	      if (statusCode="504"){
		    set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,"iCentra Encounter Type search service got Gateway timeout.  Retry...") 
	      }
	      else { 
        	set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"iCentra Encounter Type search service response with code: "_statusCode_"  Desc: "_statusDesc) 
	      }
      }
      else {
        Set tcharStream = ##class(%GlobalCharacterStream).%New()
        Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
        $$$TRACE("tcharStream size:"_tcharStream.Size)
        set text=""
        While 'tcharStream.AtEnd {
          Set text = text_tcharStream.Read($$$MaxStringLength)
        } 
        $$$TRACE("REST service response: "_text)
        If ($$$IsdefObject(tcharStream)) {
	  Do tcharStream.Rewind()
	  Set tConsumedJSON = ##class(%Library.DynamicAbstractObject).%FromJSON(tcharStream)
	  $$$TRACE("Status Message: "_tConsumedJSON.%Get("message"))
	  set iter = tConsumedJSON.%GetIterator()
	  set statusKey=""
	  set statusCode=""
	  #dim statusIter As %Iterator.Object
	  #dim detailIter As %Iterator.Array
	  do iter.%GetNext(.key , .value )
	  set iter = value.%GetIterator()
	  while iter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="service-status" {
	        set statusIter=value.%GetIterator()
	     }
	     elseif ((key="code") && (statusKey="service-status")) {
	       set statusCode=value
	     }
	     if key="status-details" {
	        if value'="" {
                  set detailIter = value.%GetIterator()
                }
                else {
                  set status=##class(IHC.ITF.ITFCOMMON.Utility).ProcessErrorExt(process.%ConfigName,"iCentra Encounter Type search service did not find the encounter type for this FIN: "_fin)
	          quit
                }
	     }
	     else {
	        continue
	     }
	  }
	  while statusIter.%GetNext(.key , .value ) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if key="code" {
	        set statusCode=value
	        if statusCode="000" {
	          while detailIter.%GetNext(.key , .value ) {
	            $$$TRACE("Detail key = "_key_" , value = "_value)
                if key="ENCNTR-TYPE" {
	               $$$TRACE("Check Lookup Table for encounter type: "_value)
	               set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.PowerscibeResultsHl7CernRadiology.Lookup.EncntrTypeFilterOut", value, .retVal )
                   $$$TRACE("Lookup Table value: "_retVal)
                   if (retVal="1")
                   {    
	                  set status=##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Skip the record for the encounter type: "_value_"\")
	                  $$$TRACE("Skip the record for the encounter type: "_value_"\r")
	                  quit
	               }
	                 
	            }
	          }
	        }
	        else {
	          set status=##class(IHC.ITF.ITFCOMMON.Utility).ProcessErrorExt(process.%ConfigName,"iCentra Encounter Type service failed with Status: "_value)
	          quit
	        }
	     }
	  }
        }
      }
    }
    ELse {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Post iCentra Encounter Type service request failed with Status Code: "_statusCode_" : Status Desc: "_statusDesc) 
    }
  }]]]]><![CDATA[>
