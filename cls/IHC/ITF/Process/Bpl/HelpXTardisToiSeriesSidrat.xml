<code name='Get Facility Id' xpos='200' ypos='650' >
<![CDATA[  set context.facId= request.GetValueAt("header.facility")
  $$$TRACE("Facility: " _context.facId)
  if (context.facId="" || $ISVALIDNUM(context.facId)'="1"){	  
    $$$TRACE("Facility Id is NOT a VALID number ")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName, "Input message has invalid facility id number: ["_context.facId_"]. Skipping the record." _ "Xml Msg:" _ request.RawContent)
  }
  set context.trnsCd= request.GetValueAt("header.transactionCode")
  $$$TRACE("Transaction Code: " _context.trnsCd)
  if (context.trnsCd="" || $ISVALIDNUM(context.trnsCd)'="1"){	  
    $$$TRACE("Transaction code is NOT a VALID number ")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName, "Input message has invalid transaction code: ["_context.trnsCd_"]. Skipping the record." _ "Xml Msg:" _ request.RawContent)
  }
  set context.trnsCd = ##class(Ens.Util.FunctionSet).Pad(context.trnsCd,-2,0)
  set empi= request.GetValueAt("patient.idNumbers.urnum")
  $$$TRACE("EMPI: " _empi)
  if (empi="" || $ISVALIDNUM(empi)'="1"){	  
    $$$TRACE("EMPI is NOT a VALID number ")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName, "Input message has invalid EMPI ["_empi_"]. Skipping the record." _ "Xml Msg:" _ request.RawContent)
  }
  if (context.facId="1") {
     set context.facId = "128"
  }
 ]]]]><![CDATA[>
