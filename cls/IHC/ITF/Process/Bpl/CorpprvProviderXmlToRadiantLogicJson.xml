<code name='check employment status type id' xpos='200' ypos='750' >
<![CDATA[ set context.pid=$zstrip(request.PROVIDERDEMOGRAPHIC.ADVPROVIDERPRVDRID.content,"<>W")
 $$$TRACE("Provider ID: " _ context.pid) 
 if (context.pid'="" && ($ISVALIDNUM(context.pid)'="1")){	  
    $$$TRACE("Provider ID # is NOT a VALID number ")
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Corpprv message has invalid provider id number: ["_context.pid_"]. Skip the record.")
 }
 
 set stringObj=##class(Ens.StringRequest).%New()
 set stringObj.StringValue=context.pid
 
 $$$TRACE("Calling corpprv Database Operation")
 set tStatus=process.SendRequestSync(process.TargetConfigNameCorpprvOp,stringObj,.SqlResponse)
 if ($$$ISOK(tStatus)){ 
   set emplmntStTypeId=SqlResponse.StringValue
   $$$TRACE("Employment Status Type Id:"_emplmntStTypeId)
   if (##class(Ens.Util.FunctionSet).Contains(filteroutEmplStsTpIds,$CHAR(34)_emplmntStTypeId_$CHAR(34))) {
     Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"Record's employment status type id: "_emplmntStTypeId_" is in the filterout list, SKIP the record. ")
   }
 }
 else {
    Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Calling employment status type id query operation failed, shutdown the component. Error: "_$SYSTEM.Status.GetOneErrorText(tStatus))

 }

