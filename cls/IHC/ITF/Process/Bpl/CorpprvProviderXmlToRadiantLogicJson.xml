<code name='Call RadiantLogic service' xpos='470' ypos='800' >
<![CDATA[  $$$TRACE("Call RadiantLogic REST Operation")
  $$$TRACE("Json String: "_context.jsnStr.StringValue)
  if context.existingPrvdr=1 {
    set context.jsnStr.StringValue=context.pid_"|"_context.jsnStr.StringValue
  }
  else {
	set context.jsnStr.StringValue="0|"_context.jsnStr.StringValue
  }
  set status=process.SendRequestSync(context.rsOpNm,context.jsnStr,.restResponse)
  if ($$$ISOK(status)){
     $$$TRACE("REST service response data: "_restResponse.StringValue)
     set jObj=##class(%DynamicAbstractObject).%FromJSON(restResponse.StringValue)
     If ($$$IsdefObject(jObj)) {
        $$$TRACE("Parsing Json String is done. Check the unit number in the response")
        set context.unitNum=jObj.unitnumber
        if (context.unitNum'="") && ($ISVALIDNUM(context.unitNum)) {
	      $$$TRACE("Reponse has unit number...")
        }
        else {
	       if context.existingPrvdr=0 {
		     set retryCnt=1
		     while (retryCnt < 5) && (context.unitNum="") {
	           $$$TRACE("Call RadiantLogic REST Operation to get the unit number")
	           $$$TRACE("Hang for "_context.retryIntvl_ " seconds to wait Radiant grap the unit number.")
	           hang context.retryIntvl
	           
               set context.prvdrId.StringValue=context.pid
               set status=process.SendRequestSync(context.rsOpNm,context.prvdrId,.restResponse)
               if ($$$ISOK(status)){
                 $$$TRACE("REST service response data: "_restResponse.StringValue)
               }
               else {
                 $$$TRACE("Radiant service call failed. "_restResponse)
                 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Calling Radiant Service failed, please check the operation alert for the specific error.")  
               }
               set jsObj=##class(%DynamicAbstractObject).%FromJSON(restResponse.StringValue)
               set rsObj=jsObj.Resources
               #dim resIter As %Iterator.Array
               set resIter =  rsObj.%GetIterator()
               if (##class(Ens.Util.FunctionSet).Contains(rsObj,"DynamicArray")) {
                 while resIter.%GetNext(.key,.dvalue) { 
                   $$$TRACE("KEY-: "_key)
                   $$$TRACE("VALUE-: "_dvalue)
                   if $isObject(dvalue) {
                     $$$TRACE("Parsing Json String is done.")
                     set context.unitNum=dvalue.unitnumber
                     $$$TRACE("Unit Number from Radiant: "_context.unitNum)

                     if (context.unitNum'="") && ($ISVALIDNUM(context.unitNum)) {
	                   $$$TRACE("Reponse has unit number...")
                     }
                   }
                 }
                 set retryCnt=retryCnt+1
               }
		     }
             if (context.unitNum="") {
                 set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "RadiantLogic service response does not have the unit number. Skip message.")
             }
          }
          else {
             set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "RadiantLogic service response does not have the unit number. Skip message.")
          }

        }   
     }
     set context.pdata=##class(IHC.ITF.DStruc.Request.PrvdrRecodComb).%New()
     set context.pdata.sourceSystem="Corpprv"
     set context.pdata.RLResponse=restResponse.StringValue
     set status=request.XMLExportToString(.strCorpPrv)
     set context.pdata.srcMsg=strCorpPrv
  }
  else {
     $$$TRACE("Radiant service call failed. "_restResponse)
     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Calling Radiant Service failed, please check the operation alert for the specific error.")  
  }]]]]><![CDATA[>
