<code name='Parse trigger events to a list' xpos='470' ypos='2500' >
<annotation><![CDATA[Parse trigger events to a list]]]]><![CDATA[></annotation>
<![CDATA[ //Parse multiple trigger events from context.triggerEvent
 $$$TRACE("Checking for multiple trigger events")
 IF ($FIND(context.triggerEvent,",")>0) //comma delimited string?
 {
    SET context.multipleTriggerEventsFlag = 1
    SET triggerEventList = $LISTFROMSTRING(context.triggerEvent, ",")
    SET context.count = 1
    $$$TRACE("Multiple trigger events Detected getting first element from list")
    SET st = context.triggerEventList.Insert($LISTGET(triggerEventList, context.count, ""))
    while context.triggerEventList.GetAt(context.count) '= ""
    {
       $$$TRACE("context.triggerEventList position " _context.count _" is: " _context.triggerEventList.GetAt(context.count))       
       SET context.count = context.count + 1
       SET st = context.triggerEventList.Insert($LISTGET(triggerEventList, context.count, ""))
    }
 }
 ELSE
 {
    $$$TRACE("No multiple trigger events found")
    SET triggerEventList = $LISTFROMSTRING(context.triggerEvent, ",")
    SET st = context.triggerEventList.Insert($LISTGET(triggerEventList, context.count, ""))
    $$$TRACE("context.triggerEventList position " _context.count _" is: " _context.triggerEventList.GetAt(context.count))       
 }]]]]><![CDATA[>
