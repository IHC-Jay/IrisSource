    set isSelfPay = "0"
	set k1="",tSC=1  
    
    For { 
     Set k1=request.GetNextIndex("NTEgrp.NTE()",k1,.tSCTrans)  Quit:k1=""      	     
     
	 	set insPlanDesc = request.GetValueAt("NTEgrp.NTE("_k1_"):Comment()") 
	 	$$$TRACE("Insurance plan Description:: " _ insPlanDesc)   
