<code name='CheckInsuranceIsSelfPay' xpos='200' ypos='1450' >
<![CDATA[   
	set jsonRequest=##class(Ens.StringRequest).%New()
    set jsonRequest.StringValue="{"_$CHAR(34)_"ATT_JSON"_$CHAR(34)_":{"_$CHAR(34)_"FIN"_$CHAR(34)_":"_$CHAR(34)_context.finNumber_$CHAR(34)_"}}" 
    Set httpObj = ##class(EnsLib.HTTP.GenericMessage).%New()
	Set tStream = ""
	Set tStream = ##class(%Stream.GlobalCharacter).%New()	
	Do tStream.Write(jsonRequest.StringValue)
	Do tStream.Rewind()	
	Do httpObj.HTTPHeaders.SetAt("application/json","content-type")
	Do httpObj.HTTPHeaders.SetAt(tStream.Size,"content-length")
	Set httpObj.Stream = ##class(%Stream.GlobalBinary).%New()
	Set tStatus = httpObj.Stream.CopyFrom(tStream)
	$$$TRACE("Calling SelfPay Rest service - Begin..")
	set status = process.SendRequestSync(context.selfPayWsrcTargetConfigName,httpObj,.selfPayResp)
	$$$TRACE("Calling SelfPay Rest service - End..")
    if ($$$ISOK(status)){	  
      	set serviceResp=selfPayResp
       	set statusLine=serviceResp.HTTPHeaders.GetAt("StatusLine")
       	$$$TRACE("statusLine : "_statusLine)
      	if (statusLine'=""){
			set statusCode=$piece(statusLine," ",2)
			set statusDesc=$piece(statusLine," ",3)
      	}
      	$$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)	
      	Set respStream = ##class(%GlobalCharacterStream).%New()
        Set respStatus = respStream.CopyFrom(serviceResp.Stream)
        set respText =""
        While 'respStream.AtEnd {
         		Set respText = respText_respStream.Read()
        } 
        $$$TRACE("SelfPay service response: "_respText)                	
      	if (statusCode'="200"){
        	$$$TRACE("Error in Service Call. StatusCode :"_statusCode)
        	if (statusCode="400"){
		    	$$$TRACE("  In Status Code 400... ")		    
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.   Response: "_respText)
   		    }elseif(statusCode="415"){
	   		    $$$TRACE("  In Status Code 415... ")		    
		    	set status=##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid/Bad request.Unsupported type sent to the service.   Response: "_respText)
   		    }elseif ($E(statusCode,1)="5"){
			    $$$TRACE("  HTTP status codes starting 5.. ")
		   		set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Response: ["_respText_"].") 
		    }else{
		    	$$$TRACE("  DisableMsgError.... ")
        		set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName," Response from SelfPay Service: "_respText) 
		    }
      	} else {	    	
	        set consumedJSONobj = ##class(%DynamicAbstractObject).%FromJSON(respText)
            set iter = consumedJSONobj.%GetIterator()
            set respStatus = consumedJSONobj.%Get("response").%Get("service-status").%Get("status")
            $$$TRACE(" Value of response Status "_respStatus) 
			if (respStatus="SUCCESS"){
	        	$$$TRACE(" Successful Response from SelfPay Service!!! ")	        	
	            set context.isSelfPay = consumedJSONobj.%Get("response").%Get("status-details").%Get("IS-SELF-PAY")	            
	            $$$TRACE(" context.isSelfPay:  ["_context.isSelfPay_"]")
	            if context.isSelfPay ="Self Pay"{
		            set context.selfPayDesc = "Self Pay"
	            	$$$TRACE(" Patient has SelfPay Insurance..")
	            }else{
		            set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, " Insurance plan is not Self pay. Skipping the record..")
		        }
			}else{
				set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, " Service is unable to fetch the data. Skipping the record..")
			}
		}
    }else{
    	$$$TRACE("No Successful Response from SelfPay Service.")
    	set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, " No successful response from the service..Failing the record with an error..")
	}  	
 ]]]]><![CDATA[>
</code>

