<![CDATA[
  set context.LocationID = request.GetValueAt("MSH:4")
  $$$TRACE("Value of Location ID From Input HL7 : "_context.LocationID)
   set context.IsValidLocation =0
   	set LocList = context.LocationList.Next("")
	while ( LocList '= "")
	{
		set PropLocation = context.LocationList.GetAt(LocList)
		if (context.LocationID = PropLocation)
		{
			set context.IsValidLocation = 1
			
		}
		set LocList = context.LocationList.Next(LocList)
	}
	
    set context.TriggerEvent = request.GetValueAt("MSH:MessageType.triggerevent")
    set context.IsValidEventID =0
    $$$TRACE("Value of TriggerEvent From Input HL7: "_ context.TriggerEvent)
    set EveList = context.EventList.Next("")
	while ( EveList '= "")
	{
		set PropEvent = context.EventList.GetAt(EveList)
		if (context.TriggerEvent = PropEvent)
		{
			set context.IsValidEventID = 1
		}
		set EveList = context.EventList.Next(EveList)
	}
	
	//If PV1:PatientClass is present than assign BillingCode
	if (request.GetValueAt("PV1:PatientClass") '= "")
	{
		set context.BillingCode = request.GetValueAt("ZZZ(1):33")
		$$$TRACE("Value of BillingCode in PV1:PatientClass From Input HL7 "_context.BillingCode)
		
	}

	
	//If ZZZ(1):33 is present than assign BillingCode
	if (request.GetValueAt("ZZZ(1):33") '= "")
	{
		set context.BillingCode = request.GetValueAt("ZZZ(1):33")
		$$$TRACE("Value of BillingCode in ZZZ From Input HL7 "_context.BillingCode)
		
	}
	$$$TRACE("Billing Code Final " _ context.BillingCode)
	
	set context.IsValidBillingCode =0
	set BillCodeList = context.BillingCodeList.Next("")
	while ( BillCodeList '= "")
	{
		set PropBillCode = context.BillingCodeList.GetAt(BillCodeList)
		//$$$TRACE(context.BillingCode)
		//$$$TRACE(PropBillCode)	
		if (context.BillingCode = PropBillCode)
		{
			set context.IsValidBillingCode = 1
		}
		set BillCodeList = context.BillingCodeList.Next(BillCodeList)
	}
	
	
	set context.IsValidBillingServiceCode =0
   	set BillCodeServList = context.BillingServCodeList.Next("")
	while ( BillCodeServList '= "")
	{
		set PropBillServCode = context.BillingServCodeList.GetAt(BillCodeServList)
		//$$$TRACE(PropBillCode)
		if (context.BillingCode = PropBillServCode)
		{
			set context.IsValidBillingServiceCode = 1
		}
		set BillCodeServList = context.BillingServCodeList.Next(BillCodeServList)
	}
	
	
	
	set context.ServiceCode= request.GetValueAt("PV1:HospitalService")
	
		
	set context.IsValidServiceCode =0
	
	if ( context.BillingCode ="M96")
	{
		set M96BillCode = context.M96CodeList.Next("")
	while ( M96BillCode '= "")
	{
		set PropM96Code = context.M96CodeList.GetAt(M96BillCode)
		if (context.ServiceCode = PropM96Code)
		{
			set context.IsValidServiceCode = 1
		}
		set M96BillCode = context.M96CodeList.Next(M96BillCode)
	}
		
	}
	elseif ( context.BillingCode ="S96")
	{
	   set S96BillCode = context.S96CodeList.Next("")
	while ( S96BillCode '= "")
	{
		set PropS96Code = context.S96CodeList.GetAt(S96BillCode)
		if (context.ServiceCode = PropS96Code)
		{
			set context.IsValidServiceCode = 1
		}
		set S96BillCode = context.S96CodeList.Next(S96BillCode)
	}
		
	}
	
	set context.PatientID= request.GetValueAt("PID:PatientIdentifierList(1).ID") 
	set context.IsPatientIDNotNull =0
	if (context.PatientID '="")
	{
		set context.IsPatientIDNotNull =1
	}]]]]><![CDATA[>
