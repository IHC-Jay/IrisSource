<code name='Prep GetRepFromNcid' xpos='200' ypos='1050' >
<annotation><![CDATA[get RepFromNcid values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set hddOpNm=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","HddTargetConfigName",.pstatus)

 set facNcid= request.GetValueAt("MSH:SendingFacility.namespaceID")  	
 if (facNcid'= "" && $ISVALIDNUM(facNcid)= "1"){
   set context.facId =##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(facNcid, context.hddContextCernerToIhcLocation, hddOpNm, .process) 
   $$$TRACE("MSH-4 is " _ context.facId)
 }
 
 set pid8Sex = request.GetValueAt("PIDgrp.PID:Sex")  	
 if (pid8Sex '= "" && $ISVALIDNUM(pid8Sex )= "1"){
   set context.sex =##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(pid8Sex, context.hddContextInterface, hddOpNm, .process) 
   $$$TRACE("Sex: " _ context.sex)
 }
 
 set patClass = request.GetValueAt("PIDgrp.PV1grp.PV1:PatientClass")  	
 if (patClass '= "" && $ISVALIDNUM(patClass)= "1"){
   set context.patClass=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(patClass, context.hddContextInterface, hddOpNm, .process) 
   $$$TRACE("PV1-2 Patient Class: " _ context.patClass)     		
 }
  
 set orc1OrderControl = request.GetValueAt("ORCgrp(1).ORC:OrderControl")  	
 if (orc1OrderControl '= "" && $ISVALIDNUM(orc1OrderControl)= "1"){
   set context.ordType=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(orc1OrderControl, context.hddContextInterface, hddOpNm, .process) 
    $$$TRACE("ORC1-1 OrderControl: " _ context.ordType)      		
 }
 
 set pv131PointOfCareNcid = request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.pointofcare")  
 $$$TRACE("PV1-3.1 is " _ pv131PointOfCareNcid)		
 if (pv131PointOfCareNcid '= "" && $ISVALIDNUM(pv131PointOfCareNcid)= "1"){
   set context.pv131=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(pv131PointOfCareNcid, context.hddContextCernerToIhcLocation, hddOpNm, .process)
   set isMember=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).isMember(context.provationInclusionDomain, pv131PointOfCareNcid, hddOpNm, .process)
   if (isMember=1){
     set newFacId=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(pv131PointOfCareNcid, context.SLToContext, hddOpNm, .process)  
     $$$TRACE("New FacId: " _ newFacId)
     if (newFacId'="") {
	set context.facId= newFacId
     }	  
   } 	
 }
 
 set pv133BedNcid = request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.bed") 	 
 $$$TRACE(" PV1-3.3 is " _ pv133BedNcid)	
 if (pv133BedNcid '= "" && $ISVALIDNUM(pv133BedNcid )= "1"){ 	
   set context.pv133=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(pv133BedNcid, context.hddContextCernerToIhcLocation, hddOpNm, .process)
 }
 
 set pv132RoomNcid = request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.room") 	
 $$$TRACE("PV1-3.2 is " _ pv132RoomNcid)	
 if (pv132RoomNcid '= "" && $ISVALIDNUM(pv132RoomNcid )= "1"){
   set context.pv132=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getRepFromNcid(pv132RoomNcid, context.hddContextCernerToIhcLocation, hddOpNm, .process)
 }
