            $$$TRACE("ProdTestFlag: " _ptFlg) 
	    if (ptFlg = "Y") {
	      set context.isProdTestPatient = 1
	    }
	  }
       }
     
    } else {
         set context.isFilterInFac = retVal
	 $$$TRACE(" iCentra facility :" _ context.facilityId)
    }
   ]]]]><![CDATA[>
