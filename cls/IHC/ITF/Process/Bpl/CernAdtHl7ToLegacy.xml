    if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="0")) { 
       set context.isFilterInFac = 0      
       $$$TRACE("Non iCentra facility..."_context.facilityId)
       if (context.regApp = "CPM") {
           $$$TRACE("Clinic Reg..."_context.facilityId)
	   set context.clinReg = 1
       }
