      set assignAuth= request.GetValueAt("MRG(1):1("_k1_").4")
      $$$TRACE(" Assigning authority: " _ assignAuth) 
      if (assignAuth="EMPI") {
       set pempi= request.GetValueAt("MRG(1):1("_k1_").1.1")
