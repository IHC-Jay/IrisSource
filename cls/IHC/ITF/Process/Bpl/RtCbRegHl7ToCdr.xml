<XData name="BPL">
<Description>
BPL Definition</Description>
<XMLNamespace>http://www.intersystems.com/bpl</XMLNamespace>
<Data><![CDATA[
<process language='objectscript' request='Ens.Request' response='Ens.Response' height='4450' width='2015' >
<context>
<property name='addTargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='100' />
</parameters>
</property>
<property name='updateTargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='200' />
</parameters>
</property>
<property name='mmiPresent' type='%Boolean' initialexpression='0' instantiate='0' />
<property name='mminumber' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='GetMMITargetConfigName' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='mrnnumber' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='empiNum' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='50' />
</parameters>
</property>
<property name='clone' type='Ens.Request' instantiate='0' />
</context>
<sequence xend='200' yend='1650' >
<scope xpos='200' ypos='250' xend='200' yend='1550' >
<trace name='Debug' value='"In BPL: " _ $CLASSNAME() _ ", Process: " _ process.%ConfigName' xpos='200' ypos='350' />
<trace name='Incoming Message' value=' "Incoming Message: "_request.RawContent' xpos='200' ypos='450' >
<annotation><![CDATA[Log incoming message]]]]><![CDATA[></annotation>
</trace>
<code name='Validate message structure' xpos='200' ypos='550' >
<annotation><![CDATA[Get Validation setting from settings & test against the structure]]]]><![CDATA[></annotation>
<![CDATA[
 //Validate the message against schema
 set validationSetting=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","Validation",.pstatus)
 if ( ($$$ISERR(pstatus)) || (validationSetting = "")) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get ValidationSetting, shutting down.")
    quit
 } else {
    $$$TRACE("ValidationSetting: " _ validationSetting) 
    set pStatus=##class(IHC.ITF.ITFCOMMON.Utility).OnValidate(request,validationSetting)    
	if (pStatus'=$$$OK) {		
	    $$$TRACE("Failed Validation Settings: " _ validationSetting)
	    set status =  ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, "Validation against data structure is failed. Skipping the record.")
	    quit
	} else {
		$$$TRACE("Passed Validation Settings: " _ validationSetting)
	}
 }]]]]><![CDATA[>
</code>
<code name='Check Configuration' xpos='200' ypos='650' >
<annotation><![CDATA[Get Configuration from settings]]]]><![CDATA[></annotation>
<![CDATA[
 //ReplyCodeActions validation
 set replyCodeActions=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","ReplyCodeActions",.pstatus)
 if ( ($$$ISERR(pstatus)) || (replyCodeActions= "")) {
 	set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get ReplyCodeActions, shutting down.")   
 	quit
 } else {
    $$$TRACE("ReplyCodeActions: " _ replyCodeActions)
 }
 
 //GetMMITargetConfigName validation
 set context.GetMMITargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","GetMMITargetConfigName",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.GetMMITargetConfigName= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get GetMMITargetConfigName, shutting down.")   
    quit
 }
 
 //AddTargetConfigName validation
 set context.addTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","AddTargetConfigName",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.addTargetConfigName= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get AddTargetConfigName, shutting down.")   
    quit
 }
 
 //UpdateTargetConfigName validation
 set context.updateTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","UpdateTargetConfigName",.pstatus)
 if ( ($$$ISERR(pstatus)) || (context.updateTargetConfigName= "") ) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get UpdateTargetConfigName, shutting down.")   
    quit
 }
 
]]]]><![CDATA[>
</code>
<code name='Filter Message' xpos='200' ypos='750' >
<annotation><![CDATA[Filter Message]]]]><![CDATA[></annotation>
<![CDATA[
 //PID-3 Filter
 set i1=""  
 for {
	 set i1 = request.GetNextIndex("PID:PatientIdentifierList()",i1,.tSC)  quit:i1=""
	 if ((request.GetValueAt("PID:PatientIdentifierList("_(i1)_").assigningauthority.namespaceID") = "IDX") && (request.GetValueAt("PID:PatientIdentifierList("_(i1)_").identifiertypecodeID") = "MRN"))   
	 {
	     $$$TRACE("Inside IDX^MRN")
	    set context.mrnnumber = request.GetValueAt("PID:PatientIdentifierList("_(i1)_").ID")
	    $$$TRACE("context.mrnnumber : "_context.mrnnumber)
	    set indexEG = $FIND(context.mrnnumber,"EG")
            if (indexEG > 0)
            { 
	       $$$TRACE("Institutional Patient Record")	     
	       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Patients MRNs beginning with 'EG' from IDX are institutional patient records.  They do not go to the MMI, skip message.")
    	       quit
	     }			 
	 }		 
 }
 ]]]]><![CDATA[>
</code>
<code name='Is MMI Present' xpos='200' ypos='850' >
<![CDATA[
 	
  set MmiInCDR = ""
  
 //Check if MMI present
 set patIdcount = request.GetValueAt("PID:PatientIdentifierList(*)")  
 $$$TRACE("count value for patIdcount : "_patIdcount)
 for {
	  
	 set i1 = request.GetNextIndex("PID:PatientIdentifierList()",i1,.tSC)  
	 quit:i1=""
	 
 $$$TRACE("identifiertypecode:"_request.GetValueAt("PID:PatientIdentifierList("_(i1)_").assigningauthority"))
	 
	 if (request.GetValueAt("PID:PatientIdentifierList("_(i1)_").assigningauthority") = "MMI")   
	 {
	     $$$TRACE("Inside MMI")
	     
	     set context.mmiPresent = 1	
	     
	     set context.mminumber = request.GetValueAt("PID:PatientIdentifierList("_(i1)_").ID")
	     $$$TRACE("mminumber : "_context.mminumber)	 
	     
	     
	 }
	 
	 if (request.GetValueAt("PID:PatientIdentifierList("_(i1)_").identifiertypecodeID") = "MRN")   
	 {
	     $$$TRACE("Inside MRN")
	     
	    	
	     
	     set context.empiNum = request.GetValueAt("PID:PatientIdentifierList("_(i1)_").ID")
	     $$$TRACE("empiNum : "_context.empiNum)	 
	     
	     
	 }		 
 }
 
 //If MMI not present we still need to hit CDR and Check with MRN no
 if ( context.mmiPresent = 0 )
 {
     set trequest = ##class(Ens.StringRequest).%New("")
     set trequest.StringValue = context.empiNum

     
     set tStatus=process.SendRequestSync(context.GetMMITargetConfigName,trequest,.getMmiResponse)
 if ('tStatus)
    {
        set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected CheckMMI response returned or CheckMMI call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
    } 
    else
    { 
 	set MmiInCDR = getMmiResponse.StringValue
    }
 
 }
 
  $$$TRACE("MmiInCDR Value : "_MmiInCDR)
  $$$TRACE("MmiInCDR Length: "_$L(MmiInCDR))

  
  //Create a clone. we will modify the value in clone if GetMMI fetch some result else the clone will be uses as it is
  set context.clone = request.%ConstructClone(1)
  Do context.clone.%Save()
 
 //If MMI is found Update will be called
 
 if ($L(MmiInCDR) > 1)
  {
    set context.mmiPresent = 1
	set patIdcount = patIdcount + 1
	$$$TRACE("Position Value : "_patIdcount)
  
  Do context.clone.SetValueAt(MmiInCDR, "PID:PatientIdentifierList("_(patIdcount)_").ID")
  Do context.clone.SetValueAt("MMI", "PID:PatientIdentifierList("_(patIdcount)_").assigningauthority")
  Do context.clone.SetValueAt("OAN", "PID:PatientIdentifierList("_(patIdcount)_").identifiertypecodeID")
	 	
  Do context.clone.%Save()
    
  }
 ]]]]><![CDATA[>
</code>
<if name='MMI Present' condition='context.mmiPresent' xpos='200' ypos='950' xend='200' yend='1200' >
<true>
<code name='Send to Update operation' xpos='470' ypos='1100' >
<![CDATA[  $$$TRACE("Calling Update Operation") 
 do process.SendRequestAsync(context.updateTargetConfigName,context.clone) ]]]]><![CDATA[>
</code>
</true>
<false>
<code name='Send to Add operation' xpos='200' ypos='1100' >
<![CDATA[	
 $$$TRACE("Calling Add Operation") 
 do process.SendRequestAsync(context.addTargetConfigName,request) 
]]]]><![CDATA[>
</code>
</false>
</if>
<code name='Reset Error' xpos='200' ypos='1300' >
<annotation><![CDATA[Reset the Error count so that we start from beginning]]]]><![CDATA[></annotation>
<![CDATA[
 Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)]]]]><![CDATA[>
</code>
<faulthandlers>
<catchall xpos='200' ypos='1400' xend='200' yend='350' >
<code name='Call ProcessError' xpos='200' ypos='250' >
<annotation><![CDATA[Call error handler method]]]]><![CDATA[></annotation>
<![CDATA[ Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).ProcessError(..%Context.%LastError)
]]]]><![CDATA[>
</code>
</catchall>
</faulthandlers>
</scope>
</sequence>
</process>
]]></Data>
