<code name='Check facility' xpos='200' ypos='850' >
<annotation><![CDATA[- Get sending facility (MSH.4)
- See if this facility is one we send to CPR+
- If not sent, write filter message to log & skip
]]]]><![CDATA[></annotation>
<![CDATA[
 // get MSH.4  (Sending Facility)
 set context.Facility = request.GetValueAt("MSH:SendingFacility")
  
 // Define, initialize 'AllowedFacilities'
 set AllowedFacilities=""
 
 // Initialize 'isAllowedFacility'
 set context.isAllowedFacility = 0
 
 // Retrieve AllowedFacilities from 'Additional Setting' tab
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedFacilities",.AllowedFacilities)
  
 // If the 'AllowedFacilities' setting was not found, signal error and shutdown
 // ELSE if the setting was found, but was empty, signal error and shutdown
 // ELSE check incoming facility
 if ($$$ISERR(pstatus))
 {
    // AllowedFacilities setting was not found
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, No configuration for AllowedFacilities found. Shutting down")
 }
 elseif (AllowedFacilities = "")
 {
    // AllowedFacilities setting found, but was empty
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, AllowedFacilities configuration is empty. Shutting down")
 }
 else
 {
    $$$TRACE("AllowedFacilities : "_AllowedFacilities) 
         
    // Loop thru each allowed facility from the 'AdditionalSettings' tab
    For iTarget=1:1:$L(AllowedFacilities, ",") 
    { 
        
        Set tOneTarget=$ZStrip($P(AllowedFacilities,",",iTarget),"<>W") 
        Continue:""=tOneTarget
            
        // If we found MSH.4 in list of allowed facilities, then bail from loop    
        if (context.Facility = tOneTarget)
        {
            $$$TRACE("Facility accepted")
	    set context.isAllowedFacility = 1
	    QUIT
        } 
    }
 
    // If this facility is not sent to CPR+, write filter message to log & skip
    if (context.isAllowedFacility = 0)
    {
       Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Facility ["_context.Facility_"] not sent to CPR+. Skipping the record.") 
    }
 }
 
  ]]]]><![CDATA[>
