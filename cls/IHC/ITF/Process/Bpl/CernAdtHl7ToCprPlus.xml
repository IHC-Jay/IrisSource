<code name='Get NCIDs to send to HDD' xpos='200' ypos='1450' >
<annotation><![CDATA[- Retrieve Next of Kin Relation NCID's from HL7 message
- Load these values into variable 'hddRepRequest'
- These will be used to call HDD from within DTL]]]]><![CDATA[></annotation>
<![CDATA[
  $$$TRACE(" GetNext of kin relation NCIDs..")
  
  //
  // Retrieve all NextOfKin Relation NCID's & add to 'hddRepRequest
  //
  set k1 = 1
  set ZKI2 = request.GetValueAt("ZKI("_k1_"):PatientRelationship")
  
  while((ZKI2 '= "") && ($ISVALIDNUM(ZKI2) = "1"))
  {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , ZKI2,  context.hddNextOfKinRelationContext, "ZKI:Relation"_k1)  
        
     set k1 = k1 + 1
     set ZKI2 = request.GetValueAt("ZKI("_k1_"):PatientRelationship")
  }
  
  // Subtract 1 from k1 to get the correct number of NCID's
  set k1 = k1 - 1
  $$$TRACE("Retrieved "_k1_" NextOfKin Relation NCID's")]]]]><![CDATA[>
