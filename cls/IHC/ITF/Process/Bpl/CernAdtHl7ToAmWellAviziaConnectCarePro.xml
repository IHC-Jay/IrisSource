 	     } 
	     if (isPatLocInAdultValueSet = "0") {
		     try {
	             set isPatLocInPedsValueSet = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).isMember(context.hddPedsDomain, context.pv131PatLocPointOfCare, context.hddTargetConfigName, .process)
