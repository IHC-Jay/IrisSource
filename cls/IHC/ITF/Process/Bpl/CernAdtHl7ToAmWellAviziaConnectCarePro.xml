						Set emailAlertRequest=##class(IHC.ITF.ITFCOMMON.Utility).CreateSendEmailOnError(" Patient Location PV1-3.1 [" _ context.pv131PatLocPointOfCare_"] is NOT in Adult/Peda domain set. Converting Transfer to Discharge..",process.%ConfigName)
					    do process.SendAlert(emailAlertRequest)
					    
			         	set priorPatLoc = request.GetValueAt("PV1:6.1")
			         	$$$TRACE("Hdd isMember request(checking Peds or Adults Valueset) PV1-6.1: " _ context.priorPatLoc)
			         	if (context.priorPatLoc '= "") {
	     					try {
	       						set isPatLocInAdultValueSet = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).isMember(context.hddAdultDomain, context.priorPatLoc, context.hddTargetConfigName, .process)
	       						$$$TRACE(" isPatLocInAdultValueSet(PV1-6.1) --> "_isPatLocInAdultValueSet)	       
	     					}CATCH exceptionvar{
	    						Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Unknown error while calling the isMember Hdd method. PV1-6.1: ["_context.priorPatLoc_"] Domain Ncid: ["_context.hddAdultDomain_ "]")
