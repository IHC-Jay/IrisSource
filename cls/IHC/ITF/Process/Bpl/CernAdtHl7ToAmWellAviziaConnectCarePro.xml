		             					set context.pv139 = "P"
		             					set context.msgType ="A03"
		         					}
	         					}CATCH exceptionvar{
	    	     					Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, " Unknown error while calling the isMember Hdd method. PV1-3.1 ["_context.pv131PatLocPointOfCare_"] Domain Ncid: ["_context.hddPedsDomain_ "]")
 	         					}	   
	     					}else{       
