	 	set table = consumedJSONobj.table
	 	$$$TRACE( "Table :"_table)
	 	$$$TRACE(" Columns :"_consumedJSONobj.columns )
	 	// read this array to find the data needed
	 	
	 	// Loop through a JSON Array
  				Set arrObj = consumedJSONobj.columns.%GetIterator()
  				while arrObj.%GetNext(.key, .value, .type ) 
  				{
  				
  				   $$$TRACE("  Key: "_key_" Value: "_value_" Type: "_type)
  				   	  			
	  			     Set arrElemObj = value.%GetIterator()	 
	  			     while arrElemObj.%GetNext(.key, .value) {
	  			     $$$TRACE("  Key: "_key_" Value: "_value_" Type: "_type)
	  			     
	  			      if ( key ="name") 
