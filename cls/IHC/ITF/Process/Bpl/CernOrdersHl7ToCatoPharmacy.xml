 if (hddObj '= ""){
    set patLoc = hddObj.Rep
    $$$TRACE("Created HDD Request and got response back for " _context.LocationInfo_ " NCID: " _hddObj.NCID_ ", HDD Context: " _$G(^IHC.CernCatoPharmacy("PV1ThreeLocationContext")))
 }

 $$$TRACE("Patient Pharmacy FIN/Encounter Location Representation received from HDD: " _patLoc)
 set patLocList = $LISTFROMSTRING(patLoc, "|")
 set patLocListLength = $LISTLENGTH(patLocList)
 $$$TRACE("Pat Location Cerner Rep List count: "_patLocListLength)
 
 if (patLocListLength > 4){
    $$$TRACE("Setting Bed, Room, and Unit")
    set context.pointOfCareUnit = $LIST(patLocList,3) 
    set context.Room = $LIST(patLocList,4)  
    set context.Bed =   $LIST(patLocList,5)
    set context.Building = $LIST(patLocList,2)
    set context.Facility = $LIST(patLocList,1)
 }elseIF (patLocListLength = 4){
    $$$TRACE("Setting Room and Unit")	   
    set context.pointOfCareUnit = $LIST(patLocList,3) 
    set context.Room = $LIST(patLocList,4)   
    set context.Bed =  ""
    set context.Building = $LIST(patLocList,2)
    set context.Facility = $LIST(patLocList,1)
 }elseIF  (patLocListLength = 3){
    $$$TRACE("Setting Unit")	   
    set context.pointOfCareUnit = $LIST(patLocList,3) 
    set context.Room = ""   
    set context.Bed =  ""
    set context.Building = $LIST(patLocList,2)
    set context.Facility = $LIST(patLocList,1)
 }elseIF (patLocListLength < 3){
   $$$TRACE("Patient Location is not sufficient to set for Pharmacy. Erroring Out!")
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName, "****HDD ERRROR****Unexpected response back from HDD. Unable to get required BD Cato Pharmacy Location representation for setting PV1-3 values for unit, room, and bed. HDD rep returned was - PHI: "_patLoc_"HDD request created for " _context.LocationInfo_ ". For Location NCID: "_context.locationNcid _" Using HddTargetConfigName: " _$G(^IHC.CernCatoPharmacy("HddTargetConfigName")) _ "Using HDD Context: " _$G(^IHC.CernCatoPharmacy("PV1ThreeLocationContext")) _ "***")
