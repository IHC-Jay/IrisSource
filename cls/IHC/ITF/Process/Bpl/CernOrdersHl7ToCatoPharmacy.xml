		}else{
				//throw error
				set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected Error - no or null value returned from HDD Call!")
		}	
	}
	quit hddreturnrep
]]></Implementation>
