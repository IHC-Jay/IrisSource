    // call local HDD class Method
    $$$TRACE("Calling local HDD class methond.")
    
    Try {
    	set context.hddreturnrep=##class(IHC.ITF.Process.Bpl.CernOrdersHl7ToCatoPharmacy).hddWork(process,context.hddTargetConfigName,context.Ncid,context.hddncidtorepcontext,context.HL7SpecValue)
    	// work return value
        if ($LENGTH(context.hddreturnrep)>0){
	         $$$TRACE("Rep from local HDD calls call: "_context.hddreturnrep)
             $$$TRACE("HDD Ncid TO Rep Lookup was successfuly!!!") 
        }else{     
             set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error while Processing HDD Ncid TO Rep lookup")  
        }  
    } Catch eException {
	 	Set exceptStatus = eException.AsStatus()
	 	$$$LOGSTATUS(exceptStatus)
	 	set status=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Error while Processing HDD Ncid TO Rep lookup:"_exceptStatus)     
    }
    
     

   //After HDD call set context specific variable to use in setting DTL
   set context.msh4Facility = context.hddreturnrep
   



 }else {
    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***No NCID found - unable to get required data for doing the HDD lookup for MSH-4 Facility: " _context.HL7SpecValue_". Found - PHI: "_context.Ncid_"***")
   
 }]]]]><![CDATA[>
