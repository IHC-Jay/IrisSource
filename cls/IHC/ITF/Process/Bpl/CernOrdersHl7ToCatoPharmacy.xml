<code name='VerifyOrderType' xpos='200' ypos='950' >
<annotation><![CDATA[Only allowing Pharmacy Orders]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Verify we have Pharmacy Order... ")
 set msh9MessageType= request.GetValueAt("MSH:MessageType.messagetype")
 $$$TRACE("Here is the Message Type: "_ msh9MessageType)
 set getFirstThreeChar = $Extract(msh9MessageType,1,3)
 $$$TRACE("Here is the compare string: "_getFirstThreeChar ) 
 if ((getFirstThreeChar="RDE") || (getFirstThreeChar="RDS")){
   $$$TRACE("We have a Pharmacy Order! Order Type is: "_ getFirstThreeChar)
 }else{
 $$$TRACE("We don't have a Pharmacy Order, filtering out and skipping record. Order type: "_ msh9MessageType)
 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "HL7 message is not an expected RDE or RDS message type.") 
 }
 ]]]]><![CDATA[>
</code>
<code name='BDCatoOrder' xpos='200' ypos='1050' >
<annotation><![CDATA[Verify is BD Cato Order]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Verifying if we have BD Cato Specific Pharmacy Order... ")
 set rxeThirtyVal= request.GetValueAt("RXEgrp(1).RXE:DispensePackageMethod")
 $$$TRACE("Here is the RXE-30 Value: "_ rxeThirtyVal)
 $$$TRACE("Getting variable length for the RXE-30 value.")
 set rxeThirtyValLength = $LENGTH(rxeThirtyVal)
 $$$TRACE("Here is the length of the RXE-30 Value: "_ rxeThirtyValLength)

 if ((rxeThirtyValLength <= 0)|| (rxeThirtyValLength <= 8)){
	$$$TRACE("We don't have a BD Cato Pharmacy Order, filtering out and skipping record.")
	Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "HL7 message is not an expected BD Cato Pharmacy Order.") 
 } else {
	$$$TRACE("Getting starting position for the last seven chars of RXE-30.") 
	set startPosition = (rxeThirtyValLength-7)+1
	$$$TRACE("Start looking for BD Cato at position: " _ startPosition )

	set lastSevenCharsOfRxeThirty = $Extract(rxeThirtyVal,startPosition,rxeThirtyValLength)
	$$$TRACE("Here is the last seven chars of the RXE-30: " _ lastSevenCharsOfRxeThirty )
	$$$TRACE("Here's the length of the string we think is the last seven chars: "_$LENGTH(lastSevenCharsOfRxeThirty ))

	if (lastSevenCharsOfRxeThirty="BD Cato"){
		$$$TRACE("We have a BD Cato Pharmacy Order!")
	}else{
		$$$TRACE("We don't have a BD Cato Pharmacy Order, filtering out and skipping record.")
		Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "HL7 message is not an expected BD Cato Pharmacy RXE-30 message.") 
	}

 }
]]]]><![CDATA[>
