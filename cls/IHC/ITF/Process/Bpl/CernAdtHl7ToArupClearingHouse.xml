<code name='FilterByInsurance' xpos='470' ypos='1300' >
<![CDATA[ set pv120= request.GetValueAt("PV1:FinancialClass(1).FinancialClass")
 $$$TRACE("PV1.20 value from cerner is :"_pv120)
 if (pv120  = "526051371") 
 {
   $$$TRACE("Skipping Insurance Filter Step")
   
 }
 else
 { 
   set InsuranceNames=""
   set In122= request.GetValueAt("IN1grp(1).IN1:InsurancePlanID.text")
   set In122= $ZCONVERT(In122,"U")
   $$$TRACE("In122 value ="_In122)
 
   set isMatchingInsFound = 0

 
   set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToArupClearingHouse.Lookup.InsuranceFilter",1,.InsuranceNames)
   $$$TRACE("Insurance names present in lookup table ="_InsuranceNames)
 
   if ($$$ISOK(pstatus)&&(InsuranceNames'=""))
   {
      set ListIns=$LISTFROMSTRING(InsuranceNames,",")
   
      set ptr=0
   
      WHILE $LISTNEXT(ListIns,ptr,value) 
      {
        set value = $ZCONVERT(value,"U")
        $$$TRACE("Insurance name from lookup Table ="_value)
      
        if ( In122 = value )
        {
       
         set isMatchingInsFound = 1
         $$$TRACE("Insurance name matched")

        }
      
      }
    
      if (isMatchingInsFound = 0)
      {
     
          Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError("ArupClearingHouse", "Insurance Text is not allowed name:["_In122_"]. Skipping the record." _ "Hl7 Msg:[" _ request.RawContent  _"]") 
        
          QUIT
      }
   
   }
 }]]]]><![CDATA[>
