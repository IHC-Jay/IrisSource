<![CDATA[ Set FileStream = ##class(%Stream.FileCharacter).%New()
 set sc = FileStream.LinkToFile(context.filelistobj.GetAt(context.FilelistIndex))
 
 //Journal the data into global
 Set stream=##class(%Stream.GlobalCharacter).%New()
 Set tSC = stream.CopyFromAndSave(FileStream)
 $$$TRACE(context.filelistobj.GetAt(context.FilelistIndex)_" (ID "_FileStream.%Id()_") has been successfully saved to database. Stream OID is "_stream.%Oid()_"; Stream ID is "_stream.%Id()_".")
 If $$$ISERR(tSC)
 {
  Set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Copy the file stream to global failed, Error : "_$System.Status.GetErrorText(tSC))
  Quit
 }
 
 Set context.FileStreamobj = ##class(Ens.StreamContainer).%New()
 Set context.FileStreamobj.Stream = stream
 Set context.FileStreamobj.OriginalFilename = context.filelistobj.GetAt(context.FilelistIndex)]]]]><![CDATA[>
