<code name='Read from Stream' xpos='200' ypos='850' >
<![CDATA[ Set Fileobj = ##class(%Stream.FileCharacter).%New()
 set sc = Fileobj.LinkToFile($Piece(request.StringValue,"~",2))
 Set TotRowsCount = $Piece(request.StringValue,"~",3)
 Set context.filelistobj = ##class(%Library.ListOfDataTypes).%New()
 $$$TRACE("context.FileBasePath"_context.FileBasePath)
 Set i=1
 Set currISA06Val = ""
  Set currISA08Val = ""
  Set prevISA06Val = ""
  Set prevISA08Val = ""
  Set prevsplitSegLoop = ""
  Set prevsplitSegName = ""
  Set prevsplitSegNumber = ""
  Set prevsplitSegVal = ""
  set currSegOrder=1
 While 'Fileobj.AtEnd
 {
  Set str = Fileobj.ReadLine()
 
  Set currsplitSegLoop = $ZStrip($Piece(str,"%%%%",3),"<>W")
  Set currsplitSegName = $ZStrip($Piece(str,"%%%%",4),"<>W")
  Set currsplitSegNumber = $ZStrip($Piece(str,"%%%%",5),"<>W")
  Set currsplitSegVal = $ZStrip($Piece(str,"%%%%",6),"<>W")
  
  If (currsplitSegName = "ISA") && (currsplitSegNumber="06")
  {
    $$$TRACE("Inside ISA 06")
    Set currISA06Val = currsplitSegVal
    
  }
  If (currsplitSegName = "ISA") && (currsplitSegNumber="08")
  {
    Set currISA08Val = currsplitSegVal
    $$$TRACE("Inside ISA 08"_currISA08Val)
    Set FileDate = $Piece($ZDT($H,8)," ",1)
    Set FileTime = $Translate($Piece($ZDT($H,8)," ",2),":")
    Set fileName = context.FileBasePath_currISA06Val_"_"_currISA08Val_"_"_context.DNDType_"_5010"_"_"_FileDate_"_"_FileTime_"_"_i
    
    //Create the properties file name same as actual file with different extension
    Set PropFileName = context.FileBasePath_currISA06Val_"_"_currISA08Val_"_"_context.DNDType_"_5010"_"_"_FileDate_"_"_FileTime_"_"_i_".properties"
    $$$TRACE("PropFileName "_PropFileName )
                
                //Create the properties file, if not present and then write the total rows from DB
                If '(##class(%File).Exists(PropFileName))
                {
                $$$TRACE(TotRowsCount_"Inside if prop file exists")
                Set NewPropFile = ##class(%File).%New(PropFileName)
                Do NewPropFile.Open("WSN")
                Set sts = NewPropFile.WriteLine("TotalCount="_TotRowsCount)
                $$$TRACE("Propertyfile write status"_sts)
                
                }    
    
                If '(##class(%File).Exists(fileName))
                {
                 
                Set NewFile = ##class(%File).%New(fileName)
                Do NewFile.Open("WSN")
                }
                Else
                {
                Set NewFile = ##class(%File).%New(fileName)
                Do NewFile.Open("WS")
                }
                //Insert the properties file first                
                Do context.filelistobj.Insert(PropFileName)
                //Insert the data file next
                Do context.filelistobj.Insert(fileName)
  
       Set i = i+1
  }
   $$$TRACE(currISA08Val_"currISA06Val and 08val"_currISA06Val)
  If (currISA06Val'="") && (currISA08Val'="")
  {   
  
    $$$TRACE("Inside ISA not empty")     
    If ((prevsplitSegName=currsplitSegName) && (+prevsplitSegNumber<=+currsplitSegNumber))
   {
    $$$TRACE("Inside prevsplitSegName = currsplitSegName"_prevsplitSegName _ currsplitSegName)
    
    If ($G(^DND835Seg(currSegOrder,prevsplitSegName))="")
    {
     Set ^DND835Seg(currSegOrder,prevsplitSegName) = prevsplitSegNumber_"="_prevsplitSegVal_"%%%%"
    }
    Else
    {
     Set ^DND835Seg(currSegOrder,prevsplitSegName) = $G(^DND835Seg(currSegOrder,prevsplitSegName))_prevsplitSegNumber_"="_prevsplitSegVal_"%%%%"
    }

    
    $$$TRACE("Inside ISA not empty"_^DND835Seg(currSegOrder,prevsplitSegName))
   }
   else
   {          
                
    Do NewFile.WriteLine(prevsplitSegLoop_"-"_prevsplitSegName_"####"_$G(^DND835Seg(currSegOrder,prevsplitSegName))_prevsplitSegNumber_"="_prevsplitSegVal_"%%%%")
                Set ^DND835Seg(currSegOrder,prevsplitSegName) = ""
                Set currSegOrder=currSegOrder+1
                
   }
 
  }
   Set prevsplitSegLoop = currsplitSegLoop
   Set prevsplitSegName = currsplitSegName
   Set prevsplitSegNumber = currsplitSegNumber
   Set prevsplitSegVal = currsplitSegVal
  }
  Do NewFile.WriteLine(prevsplitSegLoop_"-"_prevsplitSegName_"####"_$G(^DND835Seg(currSegOrder,prevsplitSegName))_prevsplitSegNumber_"="_prevsplitSegVal_"%%%%")
 Kill ^DND835Seg
]]]]><![CDATA[>
