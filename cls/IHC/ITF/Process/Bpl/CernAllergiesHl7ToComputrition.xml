<code name='Patient Type setup' xpos='470' ypos='2400' >
<![CDATA[ set pv110HospitalServiceNcid = request.GetValueAt("PV1:HospitalService")     	
 $$$TRACE(" PV1.10 hosp. service ncid value: " _ pv110HospitalServiceNcid)	
 set pv118PatientTypeNcid = request.GetValueAt("PV1:PatientType")     	
 $$$TRACE(" PV1.18 Patient Type ncid value: " _ pv118PatientTypeNcid)	
 if (pv118PatientTypeNcid '= "" && $ISVALIDNUM(pv118PatientTypeNcid)= "1"){
    set patTypeResponse=##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).getBillingType(pv118PatientTypeNcid,pv110HospitalServiceNcid,context.HddTargetConfigName,.process)
    if ((patTypeResponse["ITFCOMMON:10109") || (patTypeResponse["Web service returned(error):")){
       $$$TRACE("HDD Call Returned Error")
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to communicate with HDD system, shutting down. Error returned: "_patTypeResponse)
    }elseif (patTypeResponse="") {
       set status=##class(IHC.ITF.ITFCOMMON.Utility).HddDataError(process.%ConfigName,"Unable to determine Help 1 billing type using the getHelp1BillingType hdd method with key: "_pv118PatientTypeNcid_"|"_pv110HospitalServiceNcid_". Skipping record. Patient information: Hospital Service(PV1-10): "_pv110HospitalServiceNcid_". Patient Type(PV1-18): "_pv118PatientTypeNcid)
    }
    set patTypeList = $LISTFROMSTRING(patTypeResponse, ":")
    set patTypeListLength = $LISTLENGTH(patTypeList)
    if (patTypeListLength >=2) {
       set context.PatientClass = $LIST(patTypeList, 2)
       set context.PatientType = $LIST(patTypeList, 4)
    }
 }else {
    set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName,"Patient type is not present, unable to process record, skipping record. Patient Type(PV1-18): "_pv118PatientTypeNcid)
 
 }
]]]]><![CDATA[>
