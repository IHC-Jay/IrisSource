<code name='A08 filtering logic' xpos='470' ypos='2300' >
<![CDATA[ if ((context.TriggerEvent = "A08") && ((context.Room = "") && (context.Bed = ""))) {
    $$$TRACE("A08 can't have blank room and bed, skipping record. Hl7 Record: " _request.RawContent)
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "A08 can't have blank room and bed, skipping record. Hl7 Record.")
 }]]]]><![CDATA[>
