     $$$TRACE(" Allergy Type Code: " _ allergyTypeNcid)
     do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.HddRepRequest, allergyTypeNcid, context.AllergyContext,  "AllergyType"_al1Index)
     if (allergyTypeNcid =context.FoodAllergyNcid) {
        set allergyDescriptionNcid =request.GetValueAt("AL1grp("_(al1Index)_").AL1:3.1")
        $$$TRACE(" Allergy Description: " _ allergyDescriptionNcid)
        do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.HddRepRequest, allergyDescriptionNcid, context.AllergyContext,  "AllergyDescription"_al1Index)
     }
     set allergyStatusNcid =request.GetValueAt("AL1grp("_(al1Index)_").ZAL:6")
     $$$TRACE(" Allergy Status: " _ allergyStatusNcid)
     do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.HddRepRequest, allergyStatusNcid, context.AllergyContext,  "AllergyStatus"_al1Index)
 }]]]]><![CDATA[>
