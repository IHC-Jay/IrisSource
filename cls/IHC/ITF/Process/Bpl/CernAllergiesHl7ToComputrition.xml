             {
                $$$TRACE(" This Allergy NCID is a valid member of the computrition Allergy Domain")
                set validNcid = 1
              }
          }
        }
        else
         {
         // This is the case where there is no Ncid and it is not type food
         $$$TRACE(" This Allergy type is non Food but an NCID is not present , will skip this allergy")
