<Method name="OnGetConnections">
<ClassMethod>1</ClassMethod>
<FormalSpec>*pArray:%String,pItem:Ens.Config.Item</FormalSpec>
<Implementation><![CDATA[
	$$$TRACE("Inside  Method OnGetConnections")
	Do ##super(.pArray,pItem)
	set numInstance = pItem.GetModifiedSetting("NumOfInstances",.numIn)
	For j=0:1:numIn-1{
	If pItem.GetModifiedSetting("CdrLoadTargetConfigName",.tValue) {
		For i=1:1:$L(tValue,",") { Set tOne=$ZStrip($P(tValue_"-"_j,",",i),"<>W")  Continue:""=tOne  Set pArray(tOne)="" }
	}
	}
]]></Implementation>
</Method>

