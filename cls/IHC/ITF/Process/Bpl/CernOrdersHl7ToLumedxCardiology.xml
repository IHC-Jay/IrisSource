<code name='CheckForWantedMSH4Loc' xpos='200' ypos='950' >
<![CDATA[ set getAllowedLocations=""
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedLocations",.getAllowedLocations)

 $$$TRACE("Return Value From setting the getAllowedLocation from AllowedLocation Global Property - pstatus: "_pstatus)
 $$$TRACE("Value of Allowed Locations="_getAllowedLocations)
 if ($$$ISOK(pstatus)&&(getAllowedLocations'=""))
 {
    $$$TRACE("Inside if clause starting for loop setting up allowed location LIST")
    set context.LocationID = request.GetValueAt("MSH:4")
    $$$TRACE("Value of Location ID : "_context.LocationID) 
    For iTarget=1:1:$L(getAllowedLocations, ",") 
        { 
            Set tOneTarget=$ZStrip($P(getAllowedLocations,",",iTarget),"<>W")  
            Continue:""=tOneTarget
            if (context.LocationID = tOneTarget)
            {
                $$$TRACE("MSH-4 Has Match in the Allowed Location List")
		set context.isValidLocation = 1
		QUIT:context.isValidLocation=1
	    }
            
            
        }
        
        $$$TRACE("Boolean IsValidLocation is: " _context.isValidLocation)
 }else{
            $$$TRACE("Config setting for AllowedLocations not Available")
            Set pstatus = $$$ERROR("Initialization error, No configuration for AllowedLocations found! Must have at least one MSH-4 Allowed value. Verify with Cardiology Team and Lumedx Group.")
            
 }
]]]]><![CDATA[>
