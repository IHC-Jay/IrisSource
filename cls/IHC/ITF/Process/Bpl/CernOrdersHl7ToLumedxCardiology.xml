<code name='VerifyOrderType' xpos='200' ypos='750' >
<annotation><![CDATA[Only allowing Cardio Rad Orders]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Verify we have Lumedx specific radiology order... ")
 set orderObrFillerNumber= request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:FillerOrderNumber.entityidentifier")
 $$$TRACE("Here is the Order: "_ orderObrFillerNumber)
 set getFirstChar = $Extract(orderObrFillerNumber,1,1)
 $$$TRACE("Here is the compare string: "_getFirstChar ) 
 if (getFirstChar="C"){
   $$$TRACE("We have a Cardiology Order!")
 }else{
 $$$TRACE("We don't have a Cardology Order, filtering out and skipping record. Order: "_ orderObrFillerNumber)
 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError("Cern-OrdersCardiology-Hl7_Lumedx", "PHI - Order type OBR-3 is not expected. Order value is: ["_orderObrFillerNumber_"]. Skipping the record." _ "Hl7 Msg:[" _ request.RawContent  _"]") 
 }
 ]]]]><![CDATA[>
