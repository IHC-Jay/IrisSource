<code name='VerifyOrderType' xpos='200' ypos='650' >
<annotation><![CDATA[Only allowing Cardio Rad Orders]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Verify we have Lumedx specific radiology order... ")
 set orderObrFillerNumber= request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:FillerOrderNumber.entityidentifier")
 $$$TRACE("Here is the Order: "_ orderObrFillerNumber)
 set getFirstChar = $Extract(orderObrFillerNumber,1,1)
 $$$TRACE("Here is the compare string: "_getFirstChar ) 
 if (getFirstChar="C"){
   $$$TRACE("We have a Cardiology Order!")
 }else{
     $$$TRACE("We don't have a Cardology Order, Checking for other types  "_ orderObrFillerNumber)
     
     set context.obr4ncid = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceID.identifier")  	
     $$$TRACE("Hdd isMember request OBR-4 " _ context.obr4ncid)
     if (context.obr4ncid '= "") {
	     try {
	       set isObrExisits = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).isMember(context.hddIsMemberDomainNcid, context.obr4ncid, context.hddTargetConfigName, .process)		     
	     }CATCH exceptionvar{
		     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError("Cern-OrdersCardiology-Hl7_Lumedx", " Unknown error while calling the isMember Hdd method. OBR-4.1: ["_context.obr4ncid_"] Domain Ncid: ["_context.hddIsMemberDomainNcid_ "]")
 		 } 
	    if (isObrExisits = "0") {   		   
   		   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError("Cern-OrdersCardiology-Hl7_Lumedx", " Skipping the record.. Member is not valid Nucli or MRI cardio record: OBR-4.1: ["_context.obr4ncid_"] Domain Ncid: ["_context.hddIsMemberDomainNcid_ "]")
   		}         
     }
 }
 ]]]]><![CDATA[>
