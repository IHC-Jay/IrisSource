<code name='FilterOutOrdTypesOBR4' xpos='200' ypos='850' >
<annotation><![CDATA[FilterOut OBR4 Order Types]]]]><![CDATA[></annotation>
<![CDATA[ set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"FilterOutOrdTypesOBR4Table", .configValue)
 set obr4ID = request.GetValueAt("ORCgrp(1).OBRuniongrp.OBRunion.OBR:UniversalServiceID.identifier")
 $$$TRACE("OBR4 Order Type found in HL7: " _obr4ID)
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.FilterOutOrdTypesOBR4TableName,obr4ID,.returnVal)
     $$$TRACE("Return value from lookup table ="_returnVal)
 
   if ($$$ISOK(pstatus)&&(returnVal="FilterOut")){
