<annotation><![CDATA[Replace Patient Location for Lumedx]]]]><![CDATA[></annotation>
<![CDATA[
  set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject() 
  set bedNcid=request.GetValueAt("ZZ1:ZZ112BedNcid")
  set retStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToLumedx.Lookup.HddContext", "CONTEXT.iCentraToIhc50035", .retVal )
  set hddContextICentraToIhc50035 = retVal 		
	
  set retStatus = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernAdtHl7ToLumedx.Lookup.HddContext", "CONTEXT.iCentraLocationHierarchyDisplay", .retVal )
  set hddContextiCentraLocationHierDisp = retVal
  set zz29ClinicsFlag = request.GetValueAt("ZZ2:ZZ29ClinicsFlag")  		
  if (zz29ClinicsFlag = "Y"){
   	  set locationContext = hddContextICentraToIhc50035
  }else{
       set locationContext = hddContextiCentraLocationHierDisp
  }
 		

  $$$TRACE(" bedNcid ZZ1-12 is " _ bedNcid) 
  if (bedNcid '= "" && $ISVALIDNUM(bedNcid)= 1)
  {
	 $$$TRACE("Rick Debug1 - In the if statement Skipping the else")
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , bedNcid, locationContext, "ZZ:CernerPatLoc") 
     $$$TRACE("Hdd Request ZZ1-12 is bedNcid " _ bedNcid) 
  } 
  else
  {
     set roomNcid = request.GetValueAt("ZZ1:ZZ113RoomNcid") 
     $$$TRACE("roomNcid ZZ1-13 is " _ roomNcid) 
     if (roomNcid '= "" && $ISVALIDNUM(roomNcid)= 1)
     {
        Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , roomNcid, locationContext, "ZZ:CernerPatLoc") 
        $$$TRACE("Room Ncid ZZ1-13 is roomNcid " _ roomNcid) 
     } 
     else
     {
        set pointOfCareNcid = request.GetValueAt("ZZ1:ZZ114PointOfCareNcid") 
        $$$TRACE("PointOfCareNcid ZZ1-14 is " _ pointOfCareNcid) 
        if (pointOfCareNcid '= "" && $ISVALIDNUM(pointOfCareNcid)= 1)
        {
           Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , pointOfCareNcid, locationContext, "ZZ:CernerPatLoc") 
           $$$TRACE("Hdd Request ZZ1-15 is pointOfCareNcid " _ pointOfCareNcid) 
        }
        else
        {
           set buildingNcid = request.GetValueAt("PV1:AssignedPatietnLocation.building") 
           $$$TRACE("buildingNcid PV1-3-7 is " _ buildingNcid)
           if (buildingNcid '= "" && $ISVALIDNUM(buildingNcid)= 1)
           {
              Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , buildingNcid, locationContext, "ZZ:CernerPatLoc") 
              $$$TRACE("Hdd Request PV1-3-7 is " _ buildingNcid) 
           }                                                   
        }
     }
  }
  ]]]]><![CDATA[>
