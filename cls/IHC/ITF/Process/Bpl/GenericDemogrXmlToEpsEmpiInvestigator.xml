  <code name='Get Initiate Context' xpos='200' ypos='950' >
<annotation><![CDATA[Get Initiate Context]]]]><![CDATA[></annotation>
<![CDATA[ 
   $$$TRACE("Getting Initiate context... ")       
   $$$TRACE("Calling Initiate API thru JavaGateway to get the details from Initiate Tasks.. ")   
   set tStatus=process.SendRequestSync(context.InitiateTasksMrnTargetConfigName,request,.initiateResponse) 
   $$$TRACE("Calling .. "_context.InitiateTasksMrnTargetConfigName_" ..complete...")  
    $$$TRACE("initiateResponse:  "_initiateResponse)  
   if ($$$ISOK(tStatus)){
	   $$$TRACE("Calling Initiate API thru JavaGateway to get the details from Initiate Tasks.. Done!!! ")
	   set initiateInfoObj = ##class("IHC.ITF.Response.InitiateInfo").%New()
       set initiateInfoObj = initiateResponse
       set context.initiateInfoResp = initiateResponse
       
       if ($isObject(initiateInfoObj)){	 
       	set initiateInfoObjIndex = initiateInfoObj.ListOfInitiateRowLists.Next("")                       
		while (initiateInfoObjIndex '= ""){	
		    $$$TRACE(" In Row Loop..Row Index(initiateInfoObjIndex)"_initiateInfoObjIndex) 			
	 		set rowListObj = initiateInfoObj.ListOfInitiateRowLists.GetAt(initiateInfoObjIndex)
	 		if ($isObject(rowListObj)){
				set rowListObjIndex = rowListObj.ListOfInitiateMmiInfos.Next("")
				set masterFlag = "0"
				while (rowListObjIndex '= ""){
					$$$TRACE(" In Task Loop..ROW: "_initiateInfoObjIndex_" TASK: "_rowListObjIndex)
					set mmiInfoObj = rowListObj.ListOfInitiateMmiInfos.GetAt(rowListObjIndex)			 			
					if ($isObject(mmiInfoObj)){
						set empiId = mmiInfoObj.InitiateMemberInfo.empiId
			 			$$$TRACE("Calling GetNameAndDOB service.. ROW:"_initiateInfoObjIndex_" TASK:"_rowListObjIndex_" EMPI ID(Initiate): "_empiId)
   						set httpRequestNameAndDobObj =##class(IHC.ITF.Request.DrcRequest).%New()
   						set httpRequestNameAndDobObj.mrnNum = empiId
   						set status = process.SendRequestSync(context.CernDemographicsTargetConfigName,httpRequestNameAndDobObj,.cernDemogrResp)
   							
   						if ($$$ISOK(status)){
	   						$$$TRACE("Calling GetNameAndDOB service status success..... ")   							
   							$$$TRACE("Storing the names and dob in the mmiInfo Object for empi#.. "_empiId)
   							set mmiInfoObj.InitiateMemberInfo.dob = cernDemogrResp.dob
   							set mmiInfoObj.InitiateMemberInfo.lastName = cernDemogrResp.lastName
   							set mmiInfoObj.InitiateMemberInfo.firstName = cernDemogrResp.firstName
   							set mmiInfoObj.InitiateMemberInfo.midName = cernDemogrResp.midName
   							//set mmiInfoObj.InitiateMemberInfo.validMmiInfoFlag	= "1"
   							if ( (masterFlag="0") && ($L(cernDemogrResp.firstName)>0 && $L(cernDemogrResp.lastName)>0)){
	   							set mmiInfoObj.InitiateMemberInfo.masterFlag = "M"
	   							set masterFlag = "1"	   								
   							}else{
	   							set mmiInfoObj.InitiateMemberInfo.masterFlag = "D"
	   						}				 		   								
    					}else{
	   						$$$TRACE("Calling GetNameAndDOB service..Failed.. ")
	   						set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Error calling GetNameAndDOB service , shutting down... "_$SYSTEM.Status.GetOneErrorText(status))
   						}
					}
					set rowListObjIndex = rowListObj.ListOfInitiateMmiInfos.Next(rowListObjIndex)
		 		}
	 		}
	 		set initiateInfoObjIndex = initiateInfoObj.ListOfInitiateRowLists.Next(initiateInfoObjIndex)	
		}
      }
      // Iterate thru Initiate Info Object...       
      if ($isObject(initiateInfoObj)){	
        $$$TRACE(" Iterating thru Initiate object and storing names and DOB to response objects..") 
        set initiateInfoObjIndex = initiateInfoObj.ListOfInitiateRowLists.Next("")                       
		while (initiateInfoObjIndex '= ""){	
			$$$TRACE(" Row Indx(initiateInfoObjIndex)"_initiateInfoObjIndex) 			
	 		set rowListObj = initiateInfoObj.ListOfInitiateRowLists.GetAt(initiateInfoObjIndex)
	 		set context.duplicateExists = "0"	
	 		if ($isObject(rowListObj)){
		 		set rowListObjIndex = rowListObj.ListOfInitiateMmiInfos.Next("")
		 		set empiFromTasks = ""	
		 		set hasMasterDupFlagExists = "0" 					 				 			
		 		while (rowListObjIndex '= ""){			 			
			 		$$$TRACE(" Task Index(rowListObjIndex) "_rowListObjIndex)
			 		set mmiInfoObj = rowListObj.ListOfInitiateMmiInfos.GetAt(rowListObjIndex)			 			
			 		if ($isObject(mmiInfoObj)){	
			 			set empiId = mmiInfoObj.InitiateMemberInfo.empiId		 				
			 			$$$TRACE("empiId from Initiate..:  "_empiId)
			 			set firstName = mmiInfoObj.InitiateMemberInfo.firstName
			 			set lastName = mmiInfoObj.InitiateMemberInfo.lastName
			 			$$$TRACE("firstName from Cerner:  "_mmiInfoObj.InitiateMemberInfo.firstName_ " lastName from Cerner:  "_mmiInfoObj.InitiateMemberInfo.lastName)
			 							 				
			 			if (($L(firstName)>0 && $L(lastName)>0)){
				 			set empiFromTasks = empiFromTasks_empiId_"|"
				 			//set mmiInfoObj.validMmiInfoFlag	= "1"
				 			if (mmiInfoObj.InitiateMemberInfo.masterFlag="M"){
				 				set hasMasterDupFlagExists = "1"
				 				set context.mBirthDate = mmiInfoObj.InitiateMemberInfo.dob
	   							set context.mEmmiNo = empiId
	   							set context.mFirstName = mmiInfoObj.InitiateMemberInfo.firstName
	   							set context.mMidName = mmiInfoObj.InitiateMemberInfo.midName
	   							set context.mLastName = mmiInfoObj.InitiateMemberInfo.lastName
				 			}			 				
				 		}else{
								$$$TRACE(" firstname and/or lastname from Cerner is blank. Ignoring the task with index: "_rowListObjIndex)
						}
			 		}	 					   						
			 		set rowListObjIndex = rowListObj.ListOfInitiateMmiInfos.Next(rowListObjIndex)			 			
		 		}
		 		$$$TRACE("	ROW: "_initiateInfoObjIndex_"::: MRN#s for all tasks::"_empiFromTasks)		 		    
	 		}
	 		Set empiFromTasksList = $LISTFROMSTRING(empiFromTasks, "|")
   			Set lenEmpiFromTasksList = $ListLength(empiFromTasksList)-1
   			$$$TRACE("	lenEmpiFromTasksList::"_lenEmpiFromTasksList_"  hasMasterDupFlagExists: "_hasMasterDupFlagExists)
   			set context.mrnsCern = ""
	 		if ((lenEmpiFromTasksList>1) && (hasMasterDupFlagExists="1")){
		 		For taskIndex=1:1:lenEmpiFromTasksList{	   						
					Set empiFromTasksListItem = $List(empiFromTasksList,taskIndex)
					$$$TRACE("ROW: "_initiateInfoObjIndex_" Task Processing. EMPI# from Initiate: "_empiFromTasksListItem_ " TASK Index: " _taskIndex)
					$$$TRACE("Calling GetDrcDuplicatesID service -Get DupId from Cerner for a Task in Initiate mrn#.. "_empiFromTasksListItem)
   					set httpRequestNameAndDobObj =##class(IHC.ITF.Request.DrcRequest).%New()
   					set httpRequestNameAndDobObj.mrnNum = empiFromTasksListItem
   		
   					set status = process.SendRequestSync(context.CernDrcDuplicatesTargetConfigName,httpRequestNameAndDobObj,.cernDrcDuplResp)
   					$$$TRACE("Calling GetDrcDuplicatesID service complete.. ")
   						
   					if ($$$ISOK(status)){
	   					$$$TRACE(" DupIds: "_cernDrcDuplResp.StringValue)
	   					Set dupIdList = $LISTFROMSTRING(cernDrcDuplResp.StringValue, "|")
   						Set lenDupIdList = $ListLength(dupIdList)-1
   						$$$TRACE(" DupIds Length: "_lenDupIdList)	
	   					if (lenDupIdList>0){
   							For listItemIndex=1:1:lenDupIdList {
								Set dupIdListItem = $List(dupIdList,listItemIndex)
								$$$TRACE("dupIdListItem: "_dupIdListItem)
								if ($L(dupIdListItem)>0){
									$$$TRACE("Calling drt-getDuplicateData service.. dupIdListItem: "_dupIdListItem_ "empiFromTasksListItem: "_empiFromTasksListItem)
   									set httpRequestCernMrnForDupId =##class(IHC.ITF.Request.DrcRequest).%New()
   									set httpRequestCernMrnForDupId.duplicateId = dupIdListItem
   									set status = process.SendRequestSync(context.CernMrnForDupIdsTargetConfigName,httpRequestCernMrnForDupId,.cernDemogrMrnForDupIdResp)
   									$$$TRACE("Calling drt-getDuplicateData service complete..... "_cernDemogrMrnForDupIdResp.StringValue)
   									if ($L(cernDemogrMrnForDupIdResp.StringValue)>0){
   										set context.mrnsCern = context.mrnsCern_cernDemogrMrnForDupIdResp.StringValue  
   										$$$TRACE("mrnsCern... "_context.mrnsCern) 
   									}else{
	   									$$$TRACE("****There is no Cerner MRNs(EMMI_NO) from the service drt-getDuplicateData. ")
	   								}   												
								}else{
									$$$TRACE(" DuplicateIdListItem is blank ")
								}	
  							} 
	   					}else{
		   					$$$TRACE(" There is no duplicate id....Not calling drt-getDuplicateData service.. ")
		   				}	
   					}else{
	   					$$$TRACE("Calling drt-getDuplicateData service..Failed.. ")
	   					set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Error calling drt-getDuplicateData service , shutting down... "_$SYSTEM.Status.GetOneErrorText(status))
	   				}
		 		}
		 		$$$TRACE("************* Finding DupiIDs and Cerner mrns COMPLETE *******END*****")
		 		Set mrnsCernList = $LISTFROMSTRING(context.mrnsCern, "|")
   				Set lenMrnsCernList = $ListLength(mrnsCernList)
   				$$$TRACE(" cernMrnsList1111 : "_mrnsCernList_" Length: "_lenMrnsCernList)
   				$$$TRACE(" initiateMrnsList : "_empiFromTasksList_" Length: "_lenEmpiFromTasksList)
   				set context.duplicateExists = "0"
   				if ((lenMrnsCernList-1)=lenEmpiFromTasksList){
	   				set context.duplicateExists = "1"   				       
					For i=1:1:lenEmpiFromTasksList {
