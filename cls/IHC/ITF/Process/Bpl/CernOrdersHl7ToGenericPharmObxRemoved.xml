 set context.jsonRequest=##class(Ens.StringRequest).%New()
 set context.jsonRequest.StringValue="{"_$CHAR(34)_"IVX_IN_JSON"_$CHAR(34)_":{"_$CHAR(34)_"ORDER_ID"_$CHAR(34)_":"_$CHAR(34)_context.PharmOrderPlacerNumber_$CHAR(34)_"}}"]]]]><![CDATA[>
