<![CDATA[ $$$TRACE("Verify we have Pharmacy Order... ")
 set context.MSH9MsgType= request.GetValueAt("MSH:MessageType.messagetype")
 $$$TRACE("Here is the Message Type: "_ context.MSH9MsgType)
 set getFirstThreeChar = $Extract(context.MSH9MsgType,1,3)
 $$$TRACE("Here is the compare string: "_getFirstThreeChar ) 
 if ((getFirstThreeChar="RDE") || (getFirstThreeChar="RDS")){
   $$$TRACE("We have a Pharmacy Order! Order Type is: "_ getFirstThreeChar)
   set context.MSH9MsgType=getFirstThreeChar
   
 }else{
 $$$TRACE("We don't have a Pharmacy HL7 MSG Event Type for Pharmacy Med Orders, Sending Error and record will be skipped. Order type: "_ context.MSH9MsgType)
 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "HL7 message is not an expected RDE or RDS message type.") 
 }
 
 $$$TRACE("Next step is to check if we are doing Dispense From Location Filtering In.")
