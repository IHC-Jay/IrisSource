<code name='WorkDispenseFromLocation' xpos='200' ypos='350' >
<annotation><![CDATA[Check and Work DISPENSEFROMLOC-WORKFLOW Sequence logic]]]]><![CDATA[></annotation>
<![CDATA[ if ((context.doDispenseFromLocFilterOut=1)&&(context.FoundIVXDispenseLocation=0)&&(context.MSH9MsgType="RDS")){
      //check OBX-3.1 check values: DISPENSEFROMLOC and 530215754
      set OBXObservationIdentiferID = request.GetValueAt("RXOgrp("_context.RXOGroupCount_").OBX("_context.RXOOBXCount_"):ObservationIdentifier.identifier")
      if (OBXObservationIdentiferID="DISPENSEFROMLOC"){
          //GET OBX-5 and parse string for IVX substring
          set context.OBXFiveObservationValue = request.GetValueAt("RXOgrp("_context.RXOGroupCount_").OBX("_context.RXOOBXCount_"):ObservationValue(1)")
          set ALLUPPERCASEOBXFIVE = $ZCONVERT(context.OBXFiveObservationValue,"U")
          $$$TRACE("Have DISPENSEFROMLOC - OBX-5 value found is: "_ALLUPPERCASEOBXFIVE)
          set findReturnVal = $FIND(ALLUPPERCASEOBXFIVE,"IVX")
          $$$TRACE("Searching OBX-5 for IVX substring - value of 1 or greater it is found, value of 0 it is not. Find Method return value is: ["_findReturnVal_"]")
          if (findReturnVal=0){
              $$$TRACE("Got to check next OBXs for valid FilterOut data set - just checked DISPENSEFROMLOC OBX.  ")
          }else{
              $$$TRACE("FOUND IVXCLOUD DISPENSEFROMLOC!!")
              set context.FoundIVXDispenseLocation = 1
          }
          
      }elseif (OBXObservationIdentiferID="530215754"){
          //GET OBX-5 and parse string for IVX substring
          set context.OBXFiveObservationValue = request.GetValueAt("RXOgrp("_context.RXOGroupCount_").OBX("_context.RXOOBXCount_"):ObservationValue(1)")
          set ALLUPPERCASEOBXFIVE = $ZCONVERT(context.OBXFiveObservationValue,"U")
          $$$TRACE("Have Work Flow Sequence - OBX-5 values found is: "_ALLUPPERCASEOBXFIVE)
          set findReturnVal = $FIND(ALLUPPERCASEOBXFIVE,"IVX")
          $$$TRACE("Searching OBX-5 for IVX substring - value of 1 or greater it is found, value of 0 it is not. Find Method return value is: ["_findReturnVal_"]")
          if (findReturnVal=0){
              
              $$$TRACE("Got to check next OBXs for valid FilterOut data set - just checked Work Flow Sequence NCID 530215754 OBX.  ")
              
          
          }else{
              $$$TRACE("FOUND WORKFLOW SEQUENCE FOR IVXCLOUD!!")
              set context.FoundIVXDispenseLocation = 1
              
          }
          
       }else{
          $$$TRACE("Got to check next OBXs for valid FilterOut data set - just checked OBX was niether DISPENSEFROMLOC or Work Flow Sequence data.  ")
          
       }
 }else{
     $$$TRACE("Don't need to do Dispense From Location or Work Flow Sequence FilterIn Logic work.")
     set context.doneWithfilterIn=1
 }
 
 ]]]]><![CDATA[>
</code>
