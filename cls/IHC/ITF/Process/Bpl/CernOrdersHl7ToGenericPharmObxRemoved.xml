<code name='WorkJSONHTTPSCall' xpos='335' ypos='900' >
<annotation><![CDATA[Sent REST iCentra WebEdge Call and Work Response]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Call REST Operation")
  $$$TRACE("Call REST Operation")
 set statusCode=""
 set statusDesc=""
 if (context.icentraSvcRequest'="") {
    $$$TRACE("Call REST Service.... ")
    set status=process.SendRequestSync(context.webEdgeTarget,context.icentraSvcRequest,.httpRESTResponse)
    if ($$$ISOK(status)){
      $$$TRACE("Call REST Operation Ok")
      set statusLine=""
      set context.restHttpResponse=httpRESTResponse
      set statusLine=context.restHttpResponse.HTTPHeaders.GetAt("StatusLine")
      if (statusLine'=""){
          set statusCode=$piece(statusLine," ",2)
          set statusDesc=$piece(statusLine," ",3)
      }
      $$$TRACE("StatusCode "_statusCode_" statusDesc "_statusDesc)
	  // If status code is not 000 the check the reponse to see if it got processed correctly or not 
      if (statusCode'="000"){
        set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"REST service response with code: "_statusCode_"  Desc: "_statusDesc) 
      }else {
        Set tcharStream = ##class(%GlobalCharacterStream).%New()
        Set tStatus = tcharStream.CopyFrom(context.restHttpResponse.Stream)
        $$$TRACE("tcharStream size:"_tcharStream.Size)
        set text=""
        While ('tcharStream.AtEnd) {
          Set text = text_tcharStream.Read($$$MaxStringLength)
        } 
        $$$TRACE("REST service response: "_text)
        If ($$$IsdefObject(tcharStream)) {
		Do tcharStream.Rewind()
		Set tConsumedJSON = ##class(%Library.DynamicAbstractObject).%FromJSON(tcharStream)
		$$$TRACE("Status Message: "_tConsumedJSON.%Get("message"))
		set iter = tConsumedJSON.%GetIterator()
		set statusKey=""
		set statusCode=""
		#dim statusIter As %Iterator.Object
		#dim detailIter As %Iterator.Array
		do iter.%GetNext(.key , .value )
		set iter = value.%GetIterator()
		while (iter.%GetNext(.key , .value )) {
	     $$$TRACE("key = "_key_" , value = "_value)
	     if (key="service-status") {
	        set statusIter=value.%GetIterator()
	     }elseif ((key="code") && (statusKey="service-status")) {
	       set statusCode=value
	     }
	     if (key="status-details") {
                set detailIter = value.%GetIterator()
	     }else {
	        continue
	     }
		}
		while (statusIter.%GetNext(.key , .value )) {
			$$$TRACE("key = "_key_" , value = "_value)
			if (key="code") {
				set statusCode=value
				if (statusCode="000") {
					while (detailIter.%GetNext(.key , .value )) {
						$$$TRACE("key = "_key_" , value = "_value)
						if (key="DISP_LOCATION") {
							$$$TRACE("key = "_key_" , value = "_value)
							if (value '=""){
							     set webEdgeDispenseFromLocation=##class(Ens.Util.FunctionSet).ToUpper(value)
							     $$$TRACE("Have DISP_LOCATION WebEdge value found is: "_webEdgeDispenseFromLocation)
                                 set findReturnVal = $FIND(_webEdgeDispenseFromLocation,"IVX")
                                 $$$TRACE("Searching DISP_LOCATION for IVX substring - return value of 1 or greater means IVX string is found, value of 0 it is not found. Find Method return value is: ["_findReturnVal_"]")
                                 if (findReturnVal=0){
                                     $$$TRACE("Cern WebEdge REST call did not find IVX.  ")
                                     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"HL7 record does not have an allowed IVXCloud Pharmacy Order Med. Skipping this record.  ****HL7 MessageControlID: " _ context.MSH10)
                                 }else{
                                     $$$TRACE("FOUND IVXCLOUD DISPENSEFROMLOC!!")
                                 }
							}else{
							     set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryMsgError(process.%ConfigName,"CernWebEdge call did not find a return value for DISPENSEFROMLOC for OrderId: ["_context.PharmOrderPlacerNumber_"]" )
							}
							
						}elseif (key="ORDER_ID") {
							$$$TRACE("key = "_key_" , value = "_value)
							set webEdgeMedOrderID=value
							$$$TRACE("OrderId returned is: ["_webEdgeMedOrderID_"] *** OrderId sent as part of JSON REST calls was: ["_context.PharmOrderPlacerNumber_"]***")
						}
					}
				}else {
					set status=##class(IHC.ITF.ITFCOMMON.Utility).ProcessErrorExt(process.%ConfigName,"iCentra service failed to query for Med Order Dispense From Location for Pharmacy ORDER_ID:"_context.PharmOrderPlacerNumber_" with Status: "_value)
					quit
				}
			}
		}
	}
	$$$TRACE("REST Service response Status Code: "_statusCode)
      }
    }else {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName,"Post request failed with Status Code: "_statusCode_" : Status Desc: "_statusDesc) 
    }
 }]]]]><![CDATA[>
