<code name='GetORCTwoPlacerNumber' xpos='335' ypos='600' >
<annotation><![CDATA[Get and verify ORC-2]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Get ORC-2 OrderID-PlacerNumber")
 $$$TRACE("Validate Pharmacy Order Number(ORC-2)...") 
 Set context.PharmOrderPlacerNumber=request.GetValueAt("ORC:PlacerOrderNumber.entityidentifier")
 $$$TRACE("PharmOrderPlacerNumber: " _context.PharmOrderPlacerNumber) 
 if ($ISVALIDNUM(context.PharmOrderPlacerNumber)=0){
     $$$TRACE("ORC-2 PharmOrderPlacerNumber value is NOT a VALID numeric value. ")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***HL7 message for Pharmacy Med Orders has an invalid ORC-2 Pharm Order (Placer) Number value supplied from Cerner! iCentra Value received is - PHI: ["_context.PharmOrderPlacerNumber_"].  Expecting numeric Values.***")
  }
 
 
