<code name='VerifyIVXDispenseLocation' xpos='200' ypos='350' >
<annotation><![CDATA[FilterOut IVXCloud Dispense From Location or Work Flow Sequences]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("context.FoundIVXDispenseLocation is set to: ["_context.FoundIVXDispenseLocation_"]")
 if (context.FoundIVXDispenseLocation=1){
   Set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName,"HL7 record does have the RDS IVXCloud Pharmacy Med ORDER with DISPENSEFROMLOC or Work Flow Sequence data set present. Skipping this record.  ****HL7 MessageControlID: " _ context.MSH10)
 }elseif ((context.MSH9MsgType="RDS")&& (context.doneWithfilterIn=0)&&(context.FoundIVXDispenseLocation=0) && (context.OBXFiveObservationValue="") ){
    if (context.doCernWebEdgeCall=1){
	    set context.doCallForDispenseFromLoc=1
	}else{
		//If not doing Cern WebEdge REST call for Dispense From Location then we have to let the RDS med order pass to downstream system to handle
		$$$TRACE("No more work or logic for filtering based on Dispense From Location.")
		set context.doneWithfilterIn=1
	}
 }else{
    $$$TRACE("The Med Order is not an IVXCloud Med Order and will be continued to be processed.")
    set context.doneWithfilterIn=1
 }
 
 ]]]]><![CDATA[>
