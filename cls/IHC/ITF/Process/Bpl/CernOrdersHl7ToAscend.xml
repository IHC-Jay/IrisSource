  set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH-4 Sending Facility ncid is empty or invalid. Skipping the record.")	 
 }
 
 set patLoc = request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.PointOfCare")  	
 $$$TRACE(" Value at PV1-3.1 :"_patLoc )
 if (patLoc '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, patLoc, context.hddContextInterface, "PV131:Loc")  	  	
       		
 }

  set drId = request.GetValueAt("PV1:7(1).1")
 if (drId '="") {
