<code name='setup record to send' xpos='200' ypos='450' >
<![CDATA[ try {
    #Dim sc as %Status
    // Create HL7 message object
    set pHL7=##class(EnsLib.HL7.Message).ImportFromString(context.StandardLabToSend.GetAt(index),.sc) $$$ThrowOnError(sc)
        
    // Determine DocType from MSH
    set tDocType=##class(EnsLib.HL7.Schema).ResolveSchemaTypeToDocType("SunquestResultsToCdr","ORU_R01", sc) $$$ThrowOnError(sc)
      
    // Set DocType and build map
    set pHL7.DocType=tDocType
    set sc=pHL7.BuildMap() $$$ThrowOnError(sc)
    
 }catch ex {
    set status =##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Error creating standard lab record to send, shutting down. Record: "_context.StandardLabToSend.GetAt(index))
 
