<code name='Does micro have obx&apos;s to send' xpos='1010' ypos='1350' >
<![CDATA[ $$$TRACE("Checking for obx's to send")
 set orcIndex =""
 
 for { 
    Set orcIndex=request.GetNextIndex("PIDgrpgrp(1).ORCgrp()",orcIndex,.tSCTrans)  Quit:orcIndex=""
    set obxIndex =""
    for { 
       Set obxIndex=request.GetNextIndex("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp()",obxIndex,.tSCTrans)  Quit:obxIndex=""
       set hiddenValue =0
       set obx13 =request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:13")
       if (obx13 ="N"){
          set hiddenValue =1
       }
       set obx5 =request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:5(1).1")
       if (request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:3.1") = "L") {
          set obx3 =request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:3.1")
       }else{
          set obx3 =request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:3.4")
       }
       $$$TRACE("OBX-3: "_obx3)
       $$$TRACE("At micro obx check")
       if (('hiddenValue) && ($FIND(obx5,"Performed at") '=13) && (obx3 '="SREQ")) {
          $$$TRACE("In micro obx check")
          if (context.ObrWithObxToTranslate ="") {
             set context.ObrWithObxToTranslate ="["_orcIndex_"]"
          } else {
             set context.ObrWithObxToTranslate = context.ObrWithObxToTranslate_",["_orcIndex_"]"
          }
          $$$TRACE("After list insert in obx check")
          set context.MicroHasObxToSend =1
          $$$TRACE("Has obx's to send")
       }
    }
 }]]]]><![CDATA[>
