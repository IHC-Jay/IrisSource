    Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, Unable to find Send Micro setting.")
 }else{
    $$$TRACE("Send Micro? " _sendMicro)
 }
 //Read TargetConfigNames
 if (sendMicro){
    set context.SendMicro = 1  
    set microStatus = ##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName, "MicroTargetConfigNames", .microTargets)
    For iTarget=1:1:$L(microTargets, ",") { 
       Set tOneTarget=$ZStrip($P(microTargets,",",iTarget),"<>W")  
       Continue:""=tOneTarget
       set stat = context.MicroTargetList.Insert(tOneTarget)
       $$$TRACE("tOneTarget " _ tOneTarget _ " " _ stat)
    }
    if (($$$ISERR(microStatus))){
       Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, No MicroTargetConfigNames found")
    }else{
       $$$TRACE("Micro Target Count: " _ context.MicroTargetList.Count())
    }
 }
 
