<Method name="createAndSendResponse">
<ClassMethod>1</ClassMethod>
<FormalSpec><![CDATA[retCode:%String,retDesc:%String,scheduleId:%String,destinationFilePath:%String,&process1:IHC.ITF.Process.Bpl.ShClaimsXmlToShClaimsStsSetMaSup]]></FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tmpStatus AS %Status=$$$OK
	
	set tRequest = ##class(Ens.StreamContainer).%New("")	 
	 set tStream = ##class(%Stream.GlobalCharacter).%New("")
	 set respStr = "<AppResponse><ReturnCode>"_retCode_"</ReturnCode><ReturnDesc>"_retDesc_"</ReturnDesc></AppResponse>"	 
	 do tStream.Write(respStr)	 
	 set tRequest.Stream = tStream	 
	 	  	 	  
	 set jobResponseTargetConfigName=##class(Ens.Director).GetItemSettingValue(process1.%ConfigName,"Host","JobResponseTargetConfigName",.pstatus)
 	 if ($$$ISOK(pstatus)){
 		$$$TRACE("JobResponseTargetConfigName " _ jobResponseTargetConfigName) 	
 	 }	 
 	 set reqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream)
 	 set reqObj.DestinationFileName = scheduleId_".xml"
	 set reqObj.DestinationFilePath = destinationFilePath
	 $$$TRACE( " --> reqObj.DestinationFilePath : "_reqObj.DestinationFilePath)
	 try{
 	 	set tmpStatus = process1.SendRequestSync(jobResponseTargetConfigName,reqObj)
 	 	if ($$$ISOK(tmpStatus)){
	 	 	$$$TRACE("Response file sent..."_reqObj.DestinationFileName )
 	 		set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process1.%ConfigName, retDesc)
 	 	}
	 }catch(ex){
		 Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process1.%ConfigName,"Unable to write to file path :"_destinationFilePath_"Error:"_ex)   			 
	 }
 	  	 	 
 	 
    
   quit status
]]></Implementation>
</Method>

