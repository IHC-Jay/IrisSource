<code name='Get MMIDataRecord' xpos='200' ypos='750' >
<![CDATA[ 
 $$$TRACE(" Getting MMI Data Record.. " )
 set cdrReadMmiRequest = ##class(Ens.StringRequest).%New()  
 set cdrReadMmiRequest.StringValue = request.StringValue
 set cdrReadMmiResp = ##class(IHC.ITF.Response.MmiEventsRow).%New()
 set tStatus=process.SendRequestSync(context.cdrReadMmiTargetConfigName,cdrReadMmiRequest,.cdrReadMmiResp)
 $$$TRACE(" Status after ReadMmi " _ tStatus)
 $$$TRACE(" cdrReadMmiResp: " _ cdrReadMmiResp _ "IDs: " _ cdrReadMmiResp.%Id() _ ", " _ cdrReadMmiResp.%Oid())
 if ('tStatus) {
	 $$$TRACE(" Status Error text: " _ $SYSTEM.Status.GetOneErrorText(tStatus))
	 set errText = $SYSTEM.Status.GetOneErrorText(tStatus)
	 if ((errText["#5023")){		 
		 set status = ##class(IHC.ITF.ITFCOMMON.Utility).SuspendMsgError(process.%ConfigName, "Unable to Read CDR data. EMPI# ["_request.StringValue_"]. Skipping the record. ErrorText: " _errText)
		 quit
	 }
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected CDR READMMI response returned or CDR READMMI call failure. EMPI# "_request.StringValue_"ErrText: "_$SYSTEM.Status.GetOneErrorText(tStatus))     
    // set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName, " RETRYING.. Unexpected CDR READMMI response returned or CDR READMMI call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))     
     $$$TRACE(" Status ItfGeneralError " _ status)
     
 } else {    
  if ($IsObject(cdrReadMmiResp)){
   set context.cdrReadMmiResponse= cdrReadMmiResp    
   set context.dataRecord = cdrReadMmiResp.DataRecord   
   set context.mmiRecord = context.dataRecord.ListOfMMIRecords.GetAt(1)   
   set context.memberInfo = context.mmiRecord.MemberInfo   
  // set context.cdrReadMmiResponse.DataRecord.mmiEventRow = request   
      
      //set curTimeStamp = $zstrip($ZDATETIME($ZTIMESTAMP,3,1,4), "*P")
      //set context.mmiEventLog = curTimeStamp _ ":" _ context.mmiRow.UnitNumber _ "|"_ context.mmiRow.AuditNumber_ "|"_ context.mmiRow.TxTypeCid _ "|"_ context.mmiRow.TxTime _ "|" _ context.mmiRow.Employee _ "|" _ context.mmiRow.Application _ "|" _ context.mmiRow.ApplicationVersion _ "|" _ context.mmiRow.MmiVersion _ "|" _ context.mmiRow.FacilityCid _ ":" _ context.mmiRow.DelUnitNumber
      
      set mmiEventRespObj =##class(IHC.ITF.Response.MmiEventsRow).%New()
      set mmiEventRespObj.UnitNumber = request.StringValue      
      //set context.mmiEventRespObj.AuditNumber = context.mmiRow.AuditNumber
      set mmiEventRespObj.TxTypeCid = "204"
      set mmiEventRespObj.TxTime = $E($zstrip($ZDATETIME($ZTIMESTAMP,3,1,4), "*P"),1,12)
      set mmiEventRespObj.Employee = "100"
      set mmiEventRespObj.Application = "Inspector"
      set mmiEventRespObj.ApplicationVersion = "2.3"
      set mmiEventRespObj.MmiVersion = "1.0"
      set mmiEventRespObj.FacilityCid = "1450530"
     // set mmiEventRespObj.DelUnitNumber = request.DeleteMrn
      set context.cdrReadMmiResponse.DataRecord.mmiEventRow = mmiEventRespObj 
      
  }else{
	  $$$TRACE(" CdrMmiRead Response is null. ")
	  Set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName," RETRYING..CdrMmi Read Response is empty/null.")	  
	  kill status
	 }   
 }    
   kill cdrReadMmiRequest
   kill cdrReadMmiResp
   kill tStatus
 ]]]]><![CDATA[>
</code>
