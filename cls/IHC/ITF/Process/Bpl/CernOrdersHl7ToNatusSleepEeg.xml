<code name='PV1-3 location Work' xpos='200' ypos='1550' >
<![CDATA[ 

   //Check the PV1-3 location values for NCIDS that iCentra used for Sleep and EEG locations
 //Check Bed first
 set Ncid = request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.bed")
 if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
    set context.LocationInfo = "PIDgrp.PV1grp.PV1:AssignedPatientLocation.bed - iCentra Patient Bed "
    set context.locationNcid = Ncid
    $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDD Context: " _context.PV1ThreeLocHDDContext)
 }else {
    //Otherwise check room next
    set Ncid = request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.room")
    if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
       set context.LocationInfo = "PV1:PIDgrp.PV1grp.PV1:AssignedPatientLocation.room - iCentra Patient Room"
       set context.locationNcid = Ncid
       $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDD Context: " _context.PV1ThreeLocHDDContext)
    }else {
	   //Well, now you only have the unit (pointofcare) to check next
       set Ncid = request.GetValueAt("PIDgrp.PV1grp.PV1:AssignedPatientLocation.pointofcare")
       if (Ncid '= "" && $ISVALIDNUM(Ncid)) {
          set context.LocationInfo = "PIDgrp.PV1grp.PV1:AssignedPatientLocation.pointofcare - iCentra Patient POC Unit"
          set context.locationNcid = Ncid
          $$$TRACE("Set values are: Ncid: " _ context.locationNcid _ ". Location: " _context.LocationInfo_ ".  HDDContext: " _context.PV1ThreeLocHDDContext)
       }
    }
 }
 if (Ncid="" || '$ISVALIDNUM(Ncid)){
     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "***Unable to get required location value for setting PV1-3 values. No valid NCID found in: PV1:AssignedPatientLocation.bed, PV1:AssignedPatientLocation.room, or PV1:AssignedPatientLocation.pointofcare. Found - PHI: "_Ncid_"***")
