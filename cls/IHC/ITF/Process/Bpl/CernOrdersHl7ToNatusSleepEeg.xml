<code name='CheckForNotWantedMSH4Loc' xpos='200' ypos='1050' >
<![CDATA[ set getNotAllowedLocations=""
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"NotAllowedLocations",.getNotAllowedLocations)
 //MSH-4 is going to be an NCID - NotAllowedLocation setting value will have to match that
 $$$TRACE("Return Value From setting the getNotAllowedLocation from  NotAllowedLocation Property - pstatus: "_pstatus)
 $$$TRACE("Value of Not Allowed Locations="_getNotAllowedLocations)
 if ($$$ISOK(pstatus)&&(getNotAllowedLocations'=""))
 {
    $$$TRACE("Inside if clause starting for loop setting up not allowed location LIST")
    set context.LocationID = request.GetValueAt("MSH:4")
    $$$TRACE("Value of Location ID : "_context.LocationID) 
    For iTarget=1:1:$L(getNotAllowedLocations, ",") 
        { 
            Set tOneTarget=$ZStrip($P(getNotAllowedLocations,",",iTarget),"<>W")  
            Continue:""=tOneTarget
            if (context.LocationID = tOneTarget)
            {
                $$$TRACE("MSH-4 Has Match in the Not Allowed Location List")
		        set context.isNotValidLocation = 1
		        QUIT:context.isNotValidLocation=1
	        }
	         
        }
        
        $$$TRACE("Boolean IsNotValidLocation is: " _context.isNotValidLocation)
 }else{
            $$$TRACE("Config setting for NotAllowedLocations not set or all locations allowed.")
                       
 }
]]]]><![CDATA[>
