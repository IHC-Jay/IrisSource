	if ('tStatus){
	    set tSC=##class(IHC.ITF.ITFCOMMON.Utility).CheckError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure for this HDD request for:"_hl7Detail_ ". For NCID: "_hddNcid _"Using HDD Context: " _hddContext _" Using HddTargetConfigName: " _hddTargetConfigName)
    }else{
		
		$$$TRACE("Actually received HDD RESPONSE")
		set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(hddResponse, hl7Detail)
		if ((hddObj '= "") && ($LENGTH(hddObj.Rep)>0)){
				set hddreturnrep = hddObj.Rep
				$$$TRACE("Created HDD Request and got response back for " _hl7Detail_ " NCID: " _hddObj.NCID_ ", HDD Context: " _hddContext )
				$$$TRACE("Returned representation received from HDD: " _hddreturnrep)
