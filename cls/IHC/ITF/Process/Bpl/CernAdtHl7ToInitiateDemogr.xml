 <code name='validateEmpiNumber' xpos='200' ypos='650' >
<annotation><![CDATA[Get EMPI(CMRN)]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Validate Empi(CMRN)...") 
  set context.ihcEmpiNum=""  
  set k1=""
  For { 
     Set k1=request.GetNextIndex("PID:3()",k1,.tSCTrans)  Quit:k1=""          
     If (request.GetValueAt("PID:3("_k1_").4.1")="EMPI") {
         Set context.ihcEmpiNum=request.GetValueAt("PID:3("_k1_").1.1")                  
     }
     If (request.GetValueAt("PID:3("_k1_").4.1")= context.UofUMrnTypeNcid) {
         Set context.uofuMrnNumber=request.GetValueAt("PID:3("_k1_").1")              
     }
  } 
 $$$TRACE("EMPI: " _ context.ihcEmpiNum)  
 $$$TRACE("UofU MRN (From PID): " _ context.uofuMrnNumber) 
 
 if ($ISVALIDNUM(context.ihcEmpiNum)'="1"){	  
	  $$$TRACE("Empi# is NOT a VALID number ")
	  set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Hl7 message has invalid empi number: ["_context.ihcEmpiNum_"]. Skipping the record.")
 } 
 
 if ($ISVALIDNUM(context.uofuMrnNumber)'="1"){	 
        set k1="",tSC=1 
    For { 
     Set k1=request.GetNextIndex("OBX()",k1,.tSCTrans)  Quit:k1="" 
     Set obx5Value = request.GetValueAt("OBX("_k1_"):5(1)")
     set obx31= request.GetValueAt("OBX("_k1_"):3.1")
     if (obx31 = "U_MRN") {	       
             set context.uofuMrnNumber = obx5Value
             set context.uofuMrnInObx = "1"
      }                 
    }              
     }
     $$$TRACE("UofU MRN (From OBX): " _ context.uofuMrnNumber) 
     
     
 ]]]]><![CDATA[>
</code>

