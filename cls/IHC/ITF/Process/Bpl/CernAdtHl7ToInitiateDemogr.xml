<foreach name='Iterate PID5' property='request.{PID:PatientName()}' key='context.PID5Count' xpos='200' ypos='1350' xend='200' yend='350' >
<code name='Populate PID5 names' xpos='200' ypos='250' >
<![CDATA[  
  set nameTypeNcidValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").nametypecode")
  set lastNameValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").familyname") 
  $$$TRACE("Before AllowedNametypes")
  
  set AllowedNameTypesList = $LISTFROMSTRING(context.allowedNameTypes, ",")
 
  ///nameTypeNcidValueis present in List and if lastNameValue is not empty and if the nameTypeNcidValue is present in list ListPid5NameTypes (which means we have already got one name with that nametype)
 if (($LENGTH(lastNameValue) '= 0) && ($LISTFIND(AllowedNameTypesList , nameTypeNcidValue) > 0) && (context.ListPid5NameTypes.Find(nameTypeNcidValue) = "")){
    $$$TRACE("Inside accepted NameType present")
        
    ///Insert nametype ncid into the list
    do context.ListPid5NameTypes.Insert(nameTypeNcidValue)
    $$$TRACE("Inserted NametypeNcid "_nameTypeNcidValue_" into ListPid5NameTypes") 
    
    ///Map other values
    
    ///Last Name
    do context.familyname.SetAt(lastNameValue,context.NameArrayCount)
    $$$TRACE("familyname in Array position "_context.NameArrayCount_" : "_context.familyname.GetAt(context.NameArrayCount))

    ///First Name
    set givennameValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").givenname")
    do context.givenname.SetAt(givennameValue,context.NameArrayCount)
    $$$TRACE("GivenName in Array position "_context.NameArrayCount_" : "_context.givenname.GetAt(context.NameArrayCount))
    
    ///Middle Name
    set secondandfurthergivennamesorValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").secondandfurthergivennamesor")
    do context.secondandfurthergivennamesor.SetAt(secondandfurthergivennamesorValue,context.NameArrayCount)
    $$$TRACE("secondandfurthergivennamesor in Array position "_context.NameArrayCount_" : "_context.secondandfurthergivennamesor.GetAt(context.NameArrayCount))
    
    ///suffix
    set suffixValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").suffix")
    do context.suffix.SetAt(suffixValue,context.NameArrayCount)
    $$$TRACE("suffix in Array position "_context.NameArrayCount_" : "_context.suffix.GetAt(context.NameArrayCount))
    
    ///nametypecode
    set nametypecodeValue= request.GetValueAt("PID:PatientName("_context.PID5Count_").nametypecode")
    do context.nametypecode.SetAt(nametypecodeValue,context.NameArrayCount)
    $$$TRACE("nametypecode in Array position "_context.NameArrayCount_" : "_context.nametypecode.GetAt(context.NameArrayCount))
    
    
    ///Increment NameArrayCount 
    set context.NameArrayCount = context.NameArrayCount + 1    
 }else {
     $$$TRACE("NameType not accepted")    
 }
]]]]><![CDATA[>
</code>
