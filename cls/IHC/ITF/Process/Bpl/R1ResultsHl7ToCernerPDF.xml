<code name='Get Hl7 values and create the file' xpos='200' ypos='650' >
<![CDATA[  set obx5Stat = request.GetFieldStreamBase64(.obxStream, "PIDgrpgrp(1).ORCgrp(1).OBXgrp(1).OBX:5.5")
  $$$TRACE("GetFieldStreamBase64 OBX:5.5 status: " _ obx5Stat)

 if (obx5Stat = 1)
 {
     $$$TRACE("GetFieldStreamBase64 status: " _ obx5Stat _ ", OBX5 stream length: " _ $L(obxStream))
     set context.fileStream = ##class(Ens.StreamContainer).%New()

 
     set pid31 = $ZSTRIP(request.GetValueAt("PIDgrpgrp(1).PIDgrp.PID:PatientIdentifierList(1).ID"),"<>W")
     set pid18 = $ZSTRIP(request.GetValueAt("PIDgrpgrp(1).PIDgrp.PID:PatientAccountNumber.ID"),"<>W")

     set obx24 = $ZSTRIP(request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:DiagnosticServSectID"),"<>W")
     set Obr7 = $ZSTRIP(request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:ObservationDateTime.timeofanevent"),"<>W")
     set aliasId = $ZSTRIP(request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:UniversalServiceID"),"<>W")
 
 
     set obx52 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBXgrp(1).OBX:5.2")
     $$$TRACE("HL7 values: " _ pid31 _ ", " _ pid18 _ ", " _ obx52 _ ", " _ obx24 _ ", " _ Obr7 _ ", UniversalServiceID: " _ aliasId )
 
    
    
     Set context.fileStream.Stream = obxStream
     $$$TRACE("Set stream")
     // BATCH_CLASS^BATCH_NAME^MRN^FIN^ALIAS^DOS^TOS^PROVIDER^UNIQUEID.PDF
     set filename = "Phreesia^" _ Obr7  _ "^" _ pid31 _"^" _ pid18 _"^" _ aliasId _ "^" _ Obr7 _ "^00-00-00^CPDI^" _ obx52 _"-"  _ Obr7 _ ".PDF"
  
     set context.fileStream.OriginalFilename = $ZSTRIP(filename, "*W")
     Do context.fileStream.%Save()
     $$$TRACE("Stream save: file " _ context.fileStream.OriginalFilename)  
 }
 else
 {
   set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(context.configName, "Skip the ORU record. Invalid message, can't decode OBX:5.5, status: " _ obx5Stat )
	  
 }
 ]]]]><![CDATA[>
