<code name='Get OBX-5' xpos='200' ypos='750' >
<![CDATA[ set obx5 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBXgrp(1).OBX:ObservationValue()")
 $$$TRACE("OBX5 length: " _ $L(obx5))
 set context.fileStream = ##class(Ens.StreamContainer).%New()

 
 set pid31 = request.GetValueAt("PIDgrpgrp(1).PIDgrp.PID:PatientIdentifierList(1).ID")
 set pid18 = request.GetValueAt("PIDgrpgrp(1).PIDgrp.PID:PatientAccountNumber.ID")

 set obx24 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:DiagnosticServSectID")
 set Obr7 = request.GetValueAt("PIDgrpgrp(1).ORCgrp(1).OBR:ObservationDateTime.timeofanevent")
 
 if ($L(obx5) > 0)
 {
    set obx52 = $PIECE(obx5, "^", 2)
    $$$TRACE("HL7 values: " _ pid31 _ ", " _ pid18 _ ", " _ obx52 _ ", " _ obx24 _ ", " _ Obr7 )
 
    
    Set fbStream=##class(%Stream.FileBinary).%New()
    
    // pdf text
    set pdfTxt = $PIECE(obx5, "^", 5)
    Do fbStream.Write(pdfTxt)
    
    Set context.fileStream.Stream = fbStream
    $$$TRACE("Set stream")
    set context.fileStream.OriginalFilename = pid31 _"-" _ pid18 _"-" _ obx52 _"-" _ obx24 _"-" _ Obr7 _ ".pdf"
  
    
    Do context.fileStream.%Save()
    $$$TRACE("Stream save: file " _ context.fileStream.OriginalFilename)  
 }
 ]]]]><![CDATA[>
