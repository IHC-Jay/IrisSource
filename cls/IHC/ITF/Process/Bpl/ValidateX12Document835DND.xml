<code name='Parse ISA and collect GS level' xpos='200' ypos='650' >
<annotation><![CDATA[Parse X12 and split at GS level]]]]><![CDATA[></annotation>
<![CDATA[ /* Allocating assigned memory for the process */
 
 set memValue = ""
 
 set mstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AssignedMemory",.memValue)
  
 if ( ($$$ISERR(mstatus)) || (memValue= ""))
 {
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).WarnMsgError(process.%ConfigName,"Assigned Memory value is missing from configuration.")
 }
 else
 {  
  SET $ZSTORAGE=memValue  
 }
 if (request.%Extends("EnsLib.EDI.X12.Document"))
 {
	 set context.x12Doc = request
 }
 elseif (request.%Extends("Ens.StreamContainer"))
 {
	 set context.x12Doc = ##class(EnsLib.EDI.X12.Document).ImportFromLibraryStream(request.Stream)
 }
 else
 {
	   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message: " _ request)
 }
 
 ///$$$TRACE("Memory Value Assigned : "_memValue)
 
 /* Check if the received data is a X12 file or not and report error if it is not a X12 message. Parse the Interchange Level and extract number of Group level (GS-GE) count, SenderID (ISA06), ControlNumber (ISA13) and UsageIndicator (ISA15). Iterate through each GS level and place each group object in a collection list */
 
 
 if (context.x12Doc.%Extends("EnsLib.EDI.X12.Document"))
 {
 
   try
   {          
       /* Setting request message to X12 Interchange structure and gather number of child segment (GS-GE) count */
       
       set context.x12Doc.DocType = "HIPAA_5010:Interchange:Group"
       Set tSC = context.x12Doc.BuildMap()
		    
       
       
       /* Extracting InterchangeSenderID, Interchange ControlNumber and Interchange usage indicator values from X12 */
 
       set context.ISA06 = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeSenderID"),"<>W") 
       set context.ISA13 = $ZSTRIP(context.x12Doc.GetValueAt("ISA:InterchangeControlNumber"),"<","0")
       set context.ISA15 = context.x12Doc.GetValueAt("ISA:UsageIndicator")
       
       #dim individualGroup As EnsLib.EDI.X12.Document 
       set individualGroup = context.x12Doc.getNthChild(1,2)
       set context.gsVer = individualGroup.GetValueAt("GS:VersionReleaseIndustryIdenti")
       
       $$$TRACE("X12, ISA sender: " _ context.ISA06  _ " Ctrl # " _ context.ISA13 _", GS:Version: " _  context.gsVer)
 
              
    }
    Catch ex 
    { 
      if 1=ex.%IsA("%Exception.SystemException") 
      {
        Set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported while parsing and collecting Interchange level details. Exception Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
      }
      else 
      {       
       Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported while parsing and collecting Interchange level details: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)  
      }  
    }  
 } 
 else
 {
  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Received an invalid X12 file. Please verify and reprocess the message ")
 } 
]]]]><![CDATA[>
</code>
<code name='Call Edifecs validation Operation' xpos='200' ypos='750' >
<![CDATA[ $$$TRACE("Call Edifecs X12 validation, SNIP: " _ context.SNIP)
 
 set response = ""

 try
 { 
 
   set stringValue = ""
   set x12MsgReq = ##class(IHC.ITF.Request.x12MessageReq).%New() 
 
   Do request.Stream.Rewind()
 
   if (request.Stream.Size > 3000000)
   {     
          set x12MsgReq.StreamPayload = ##class(%FileCharacterStream).%New()
          Do x12MsgReq.StreamPayload.CopyFromAndSave(request.Stream)
          $$$TRACE("Send Stream: " _ x12MsgReq.StreamPayload.Size)
   }
   else
   {
                
        While (request.Stream.AtEnd = 0) {
    	   Set len = 10000
    	   set stringValue = stringValue _ request.Stream.Read(.len)    	
        }
	set x12MsgReq.Payload = stringValue 
	$$$TRACE("Send String: " _ $L(x12MsgReq.Payload) )  
   }
       
       set x12MsgReq.pTransactionFileName = ##class(%File).GetFilename(request.OriginalFilename)
       set x12MsgReq.TimeStamp = $ZDATETIME($HOROLOG,1,1,9)
       if (context.SNIP = 1)
       {
           set x12MsgReq.Esf = "L1.esf"
       }
       else
       {
           set x12MsgReq.Esf = "L1-L2.esf"
       }
                
       set tStatus = process.SendRequestSync("Out-EdifecsValidation-REST", x12MsgReq, .resp)
     
       $$$TRACE("SendRequestsync complete. Status: " _ tStatus)  
	 
	  
       If $$$ISERR(tStatus) 
       {
          set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Error reported while delivering output to target ")
       }
       else
       {         
          set context.x12MsgResp = resp 
          $$$TRACE("999 from Edifecs: " _    context.x12MsgResp.Resp999Payload) 
       }
    
          
 }
 Catch ex
 {	
    if 1=ex.%IsA("%Exception.SystemException") 
    {
      
      set status = ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"System exception reported  Name: " _ ex.Name _ ", Location: "_ ex.Location _", ex: " _ ex)
    }
    else 
    {  
      set status =  ##class(IHC.ITF.ITFCOMMON.Utility).FailMsgError(process.%ConfigName,"Exception reported to target: " _ "Error code=" _ ex.Code _ ", data=" _ ex.Data _ ", location=" _ ex.Location)
    }	
    
    
 }]]]]><![CDATA[>
</code>
<code name='Parse response' xpos='200' ypos='850' >
<![CDATA[  if $IsObject(context.x12MsgResp)
  {
            $$$TRACE("Edifecs Validation Time: " _ context.x12MsgResp.TimeStamp _" -> " _ context.x12MsgResp.RespTimeStamp) 
            if ($L(context.x12MsgResp.RespBadPayload) <= 0)
            {
                set context.edifecsVal = $$$OK
                $$$TRACE("Edifecs Validation: Inbound X12 passed the validation, good X12 length: " _ $L(context.x12MsgResp.RespGoodPayload) )
                
            }
            else
            {
                $$$TRACE("Good X12 from Edifecs: " _ context.x12MsgResp.RespGoodPayload)              
            }
   }]]]]><![CDATA[>
</code>
<code name='IRIS validation' xpos='200' ypos='950' >
<![CDATA[  
  If ""=context.x12Doc.DocType 
  {
      set context.x12Doc.DocType = "HIPAA_5010:Interchange:Group"
  }
   $$$TRACE("Call X12ValidateDocument, SNIP: " _ context.SNIP)
   
   set stat = ##class(EnsLib.EDI.X12.Util.Validator).PerformSNIPValidation(context.x12Doc, context.SNIP, "All" )  
   // set stat = ##class(Ens.X12.FunctionSet).X12ValidateDocument(context.x12Doc, "SNIP", context.SNIP)
  
  
  if ($$$ISOK(stat))
  {
     $$$TRACE("IRIS X12ValidateDocument OK. SNIP: " _ context.SNIP _", status: " _ stat)
     set context.irisVal = stat
     
     
     // set context.replyDoc = ##class(Ens.X12.FunctionSet).X12BatchReply(context.x12Doc, "All", "SNIP", context.SNIP, "All") 
     set context.replyDoc = ##class(EnsLib.EDI.X12.Util.Validator).ConstructBatchReply(context.x12Doc, .stat, "All", 0, "Indiv", "SNIP:"_ context.SNIP) 
	 if ('$IsObject(context.replyDoc))
	 {				  	 
		 $$$TRACE( "IRIS Could not create X12 Reply" )
	 }
     
     
     
	 
  }
  else
  {
  
    $$$TRACE( "X12ValidateDocument failed. Create error and good batch")
	set context.errBat = ##class(Ens.X12.FunctionSet).X12BatchErrors(context.x12Doc, "SNIP", context.SNIP)
	if ($IsObject(context.errBat))
	{
	   $$$TRACE("Create X12BatchErrors: " _ context.errBat.RawContent)
	}
	    
	set context.succBat = ##class(Ens.X12.FunctionSet).X12BatchSuccesses(context.x12Doc, "SNIP", context.SNIP)
	$$$TRACE( "Create X12BatchSuccesses: " _ context.succBat)
	if ($IsObject(context.succBat))
	 {
	   $$$TRACE( "Success X12 data: " _ context.succBat.RawContent)
	 }
	 
	 
	set context.replyDoc = ##class(Ens.X12.FunctionSet).X12BatchReply(context.x12Doc, "All", "SNIP", context.SNIP, "All") 
	 if ($IsObject(context.replyDoc))
	 {
				  	 
		 $$$TRACE( "X12 Reply Error: " _  context.replyDoc.RawContent)
	 }
  }
	 ]]]]><![CDATA[>
</code>
