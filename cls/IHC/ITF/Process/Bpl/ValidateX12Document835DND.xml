<code name='Parse 999' xpos='200' ypos='1400' >
<![CDATA[  
  set edifecsSckDetails = ""
  set irisAckDetails = ""
  
  #dim x12Doc as EnsLib.EDI.X12.Document
  $$$TRACE("Parse Edifecs 999")
  if ( $L(context.x12MsgResp.Resp999Payload) > 0) 
  {
 
    set x12Doc = ##class(EnsLib.EDI.X12.Document).ImportFromString(context.x12MsgResp.Resp999Payload, .stat)
    
    if (x12Doc.%Extends("EnsLib.EDI.X12.Document"))
    {
	    set edifecsSckDetails = ##class(IHC.ITF.ITFCOMMON.EdiX12utils).Parse999(x12Doc, context.x12Doc)
	    $$$TRACE( "ImportFromString of Edifecs 999 successful: " _ edifecsSckDetails )	 	
	 }
	 else
	 {
	    $$$TRACE( "ImportFromString failed, Not X12: " _ x12Doc)
    }
  }
  else
  {
      $$$TRACE( "Not a valid 999 from Edifecs"  _ context.x12MsgResp.Resp999Payload)
  }
	 
  
  if (context.replyDoc.%Extends("EnsLib.EDI.X12.Document"))
	 {
	    set irisAckDetails = ##class(IHC.ITF.ITFCOMMON.EdiX12utils).Parse999(context.replyDoc, context.x12Doc)
	    $$$TRACE( "replyDoc from IRIS is a good X12: " _ irisAckDetails)	 	
	 }
	 else
	 {
		 $$$TRACE( "replyDoc from IRIS Not X12: " _ context.replyDoc)
	 }
	 set iVal = $PIECE(irisAckDetails, ";", 2 )
	 $$$TRACE("IRIS Validation: " _  iVal )
	 set eVal = $PIECE(edifecsSckDetails, ";", 2 )
	 $$$TRACE("Edifecs Validation: " _ eVal )
	 
	 set iDet = $PIECE(irisAckDetails, ";", 1 )
	 $$$TRACE("IRIS: " _ iDet  )
	 set eDet = $PIECE(edifecsSckDetails, ";", 1 )
	 $$$TRACE("Edifecs: " _  eDet )
	 
	 set flNm = ##class(%File).GetFilename(request.OriginalFilename)
	 set dtTm =$ZDATETIME($HOROLOG,1,1,9)
	 set match = (iVal = eVal)
	 set verRel = context.gsVer
	 set snip = context.SNIP
	 	 
	 &SQL(INSERT INTO IHC_ITF_ITFCOMMON_X12.SnipValidation (FileName, TimeStamp, ValidationMatch, IrisAk5, EdifecsAk5, IrisDetails, EdifecsDetails, VersionReleaseIndustryIdenti, SNIP) VALUES (:flNm, :dtTm, :match, :iVal, :eVal, :iDet, :eDet, :verRel, :snip ))
	 $$$TRACE("INSERT INTO IHC_ITF_ITFCOMMON_X12.SnipValidation: " _ SQLCODE)
	 if (SQLCODE '= 0)
	 {
	     $$$TRACE("INSERT failed: " _ flNm_", " _ dtTm_", " _ match_", " _ iVal_", " _ eVal_", " _ iDet_", " _ eDet )
	 }]]]]><![CDATA[>
</code>
