          set obx3=request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:3.1")
          set obx5=request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:5.1")
          if ((obx3="COMPON") && (obx5="RHIGX")) {
             set checkForStatus =1 
          }
       }
    } 
    if (checkForStatus) {
       for {
          set orcIndex=request.GetNextIndex("PIDgrpgrp(1).ORCgrp()",orcIndex,.tSCTrans)  Quit:orcIndex=""
          for{
             set obxIndex=request.GetNextIndex("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp()",obxIndex,.tSCTrans)  Quit:obxIndex=""
             set obx3=request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:3.1")
             set obx5=request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:5.1")
             if ((obx3="STATUS") && (obx5="ISSU")) {
                set obr25=request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBR:25")
                set obx11=request.GetValueAt("PIDgrpgrp(1).ORCgrp("_orcIndex_").OBXgrp("_obxIndex_").OBX:11")
                if ((obx11="P") && (obr25="P")) {
