<Method name="OnGetConnections">
<ClassMethod>1</ClassMethod>
<FormalSpec>*pArray:%String,item:Ens.Config.Item</FormalSpec>
<Implementation><![CDATA[
   #dim locArray As array Of %String;
   set tValue=""
   Set (tValue,tIndex)=""
   For {
      Set tIndex = item.Settings.Next(tIndex)
      Quit:tIndex=""
      Set tSetting = item.Settings.GetAt(tIndex)
      If (tSetting.Name["Order Events Target") || (tSetting.Name["Micro Result Events Target") 
         || (tSetting.Name["Standard Result Events Target") || (tSetting.Name["BloodBank Result Events Target")
      {    
         if (tValue '= "")
         {
            set tValue = tValue _ "," _ tSetting.Value
         } Else{
            Set tValue=tSetting.Value
         }
      }
   }
  
   For i=1:1:$L(tValue,",") {
     Set tOne=$P(tValue,",",i)
     Continue:""=tOne
     Set pArray(tOne)=""
   }
]]></Implementation>
</Method>

