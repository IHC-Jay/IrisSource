<code name='Prep GetRepFromNcid' xpos='200' ypos='950' >
<annotation><![CDATA[Prepare RepFromNcid values]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE(" Get Rep from Ncid Hdd lookup call")  	
 set context.hddRepRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateHddRepReqObject()
 $$$TRACE(" After creating Ncid Hdd lookup request object") 

 set context.facId = request.GetValueAt("MSH:SendingFacility.namespaceID")  	
 if (context.facId '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , context.facId, context.hddiCentraContext, "MSH4:Facility")  	  	
     $$$TRACE("Hdd Request MSH-4 Sending Facility is " _ context.facId )     		
 } else {
	 // Skip message if PV1-3.4 is empty
	 set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "MSH-4 Sending Facility is empty. Skipping the record.")	 
 }
 
 set pid8Sex = request.GetValueAt("PIDgrp.PID:Sex")  	
 if (pid8Sex '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, pid8Sex, context.hddContextInterface, "PID8:Sex")  	  	
     $$$TRACE("Hdd Request PID-8 Sex is " _ pid8Sex)     		
 }
 
 set patClass = request.GetValueAt("PIDgrp.PV1grp.PV1:PatientClass")  	
 if (patClass '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, patClass, context.hddContextInterface, "PV12:Class")  	  	
     $$$TRACE("Hdd Request PV1-2 Patient Class is " _ patClass)     		
 }
  
 set orc1OrderControl = request.GetValueAt("ORCgrp(1).ORC:OrderControl")  	
 if (orc1OrderControl '= "") {
     Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , orc1OrderControl, context.hddContextInterface, "ORC1:OrderControl")  	  	
     $$$TRACE("Hdd Request ORC1-1 OrderControl is " _ orc1OrderControl)     		
 }
 
  set k1="",tSC=1 
  For { 
     Set k1=request.GetNextIndex("ORCgrp(1).ODS()",k1,.tSCTrans)  Quit:k1=""          
     set ods31Ncid = request.GetValueAt("ORCgrp(1).ODS("_(k1)_"):3(1).1")
     $$$TRACE("ODS-3.1DietSPC ID Ncid: " _ods31Ncid )
     if (ods31Ncid '= "" && $ISVALIDNUM(ods31Ncid)= "1"){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , ods31Ncid,  context.hddComputritionContext, "ODS31:DSPC"_k1)  	  	$$$TRACE("Hdd Request ODS-3.1(DietSPC Ncid) is " _ ods31Ncid)		
     }  
     set ods32Ncid = request.GetValueAt("ORCgrp(1).ODS("_(k1)_"):3(1).2")
     $$$TRACE("ODS-3.2 DietSPC Text Ncid: " _ods32Ncid)
     if (ods32Ncid '= "" && $ISVALIDNUM(ods32Ncid )= "1"){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , ods32Ncid,  context.hddComputritionContext, "ODS32:DSPC"_k1)  	  	$$$TRACE("Hdd Request ODS-3.2(DietSPC Ncid) is " _ ods32Ncid)		
     }     
  }
  
  set k1="",tSC=1 
  For { 
     Set k1=request.GetNextIndex("PIDgrp.AL1grp()",k1,.tSCTrans)  Quit:k1=""          
     set al12aTypeNcid = request.GetValueAt("PIDgrp.AL1grp("_k1_").AL1:2")
     $$$TRACE("AL1-2 AllergyType: " _al12aTypeNcid )
     if (al12aTypeNcid '= "" && $ISVALIDNUM(al12aTypeNcid)= "1"){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, al12aTypeNcid,  context.hddComputritionContext, "AL12:AllergyType"_k1) 	$$$TRACE("Hdd Request AL1-2(Allergy Type Ncid) is " _ al12aTypeNcid)		
     }     
     set al131Ncid = request.GetValueAt("PIDgrp.AL1grp("_k1_").AL1:3.1")
     $$$TRACE("AL1-3.1 Ncid: " _al131Ncid )
     if (al131Ncid '= "" && $ISVALIDNUM(al131Ncid)= "1"){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , al131Ncid,  context.hddiCentraComputritionContext, "AL131:ACMD"_k1)  	  	$$$TRACE("Hdd Request AL1-3.1(ACMD Ncid) is " _ al131Ncid )		
     }     
     set al14Ncid = request.GetValueAt("PIDgrp.AL1grp("_k1_").AL1:4")
     $$$TRACE("AL1-4 Ncid: " _al14Ncid )
     if (al14Ncid '= "" && $ISVALIDNUM(al14Ncid)= "1"){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest, al14Ncid,context.hddHl7Context, "AL14:AllergySeverity"_k1)
	$$$TRACE("Hdd Request AL1-4(AllergySeverity Ncid) is " _ al14Ncid )		
     }     
     set zal6Ncid = request.GetValueAt("PIDgrp.AL1grp("_k1_").ZAL:ReactionStatus")
     $$$TRACE("AAL-6 Ncid: " _zal6Ncid )
     if (zal6Ncid '= "" && $ISVALIDNUM(zal6Ncid)= "1"){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddNcidToRepObject(context.hddRepRequest , zal6Ncid,  context.hddiCentraComputritionContext, "ZAL16:ReactionStat"_k1)
	$$$TRACE("Hdd Request ZAL-6(Reaction Status Ncid) is " _ zal6Ncid)		
     }     
  }
  
 ]]]]><![CDATA[>
