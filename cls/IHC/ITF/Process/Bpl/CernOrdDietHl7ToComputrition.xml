<code name='Process Hdd Filtering' xpos='470' ypos='1600' >
<![CDATA[ $$$TRACE("processing hdd filtering")
 set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.ComputritionHddFilterResp, "computritionHddFilter")
 $$$TRACE("After making hdd object")
 if (hddObj '= ""){
    $$$TRACE("After checking hdd object")
    if (hddObj.Rep '="") {
       $$$TRACE("After checking hdd object response")
       if (hddObj.Rep = "N") {
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Not a record wanted by Computrition , skipping record: " _request.RawContent)
       }else {
          //Wanted by computrition so keep processing.
       }
    }else {
        set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Hl7 hdd message filtering failed, Skipping the record. Hl7 Msg:" _ request.RawContent)
    }
 }else {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Hl7 hdd message filtering failed, Skipping the record. Hl7 Msg:" _ request.RawContent)
