<code name='Check for Valid Allergy Ncid' xpos='200' ypos='1050' >
<![CDATA[ // set context.skipAllergySeg = 0
   if ( context.AllergyNcidPresent = 1 )
 {
  set validNcid = 0
 
  for { 
       Set algIndex=context.input.GetNextIndex("PIDgrp.AL1grp().AL1()",algIndex,.tSCTrans)  Quit:algIndex=""          
       set allergyType =  context.input.GetValueAt("PIDgrp.AL1grp("_(algIndex)_").AL1:2") 
       $$$TRACE(" Allergy type : "_allergyType)
       set allergyCode = context.input.GetValueAt("PIDgrp.AL1grp("_(algIndex)_").AL1:3.1")
       $$$TRACE(" Allergy code : "_allergyCode)
       
        //- no need to check inclusion for Food Allergy types
       if (allergyType '= "1551" )     
      {  
       
       if ($ISVALIDNUM(allergyCode)="1")
       {// this is a NCID      
       
         set hddObj = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.hddMemResponse, "isCompAllergy"_algIndex)
         if (hddObj '= "")
         {
            set isCompAllergyMem = hddObj.Rep
            $$$TRACE("Value of 'is Computrition Allergy Member ' from Hdd lookup: " _ isCompAllergyMem)
            if ( isCompAllergyMem'= 1 )
            {
                 $$$TRACE(" This Allergy NCID is not a member of the computrition Allergy Domain")
                 do context.input.SetValueAt("NA","PIDgrp.AL1grp("_(algIndex)_").AL1:3.1") 
                 do context.input.SetValueAt("","PIDgrp.AL1grp("_(algIndex)_").AL1:3.2")
                  do context.input.SetValueAt("","PIDgrp.AL1grp("_(algIndex)_").AL1:3.3")
             }
             else
             {
                $$$TRACE(" This Allergy NCID is a valid member of the computrition Allergy Domain")
                set validNcid = 1
              }
          }
                   
         }
        }
        
      } 
      
 //    if ( (context.AllergyTextPresent '= 1) && (validNcid '= 1) )
