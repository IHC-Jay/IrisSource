<code name='Call allergy isMember HDD call' xpos='200' ypos='950' >
<![CDATA[ set context.hddMemRequest  = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).CreateIsMemberObject()
  set allergyCode = ""
  set context.AllergyNcidPresent = 0
  set algIndex="",tSC=1
    for { 
       Set algIndex=request.GetNextIndex("PIDgrp.AL1grp()",algIndex,.tSCTrans)  Quit:algIndex=""          
       set allergyCode = request.GetValueAt("PIDgrp.AL1grp("_(algIndex)_").AL1:3.1")
       $$$TRACE(" Allergy code : "_allergyCode)
       if ( allergyCode '= "" ){
       if ($ISVALIDNUM(allergyCode)'="1")
       {
          $$$TRACE("Allergy ID is NOT a number, Let the record pass through for further processing  ")
          set context.AllergyTextPresent = 1
       }
       else
       {	
       $$$TRACE("Allergy ID is a number, Check the NCID for presence in the Allergy domain")
       set context.AllergyNcidPresent = 1
       $$$TRACE("Prepare for IsMemberObject Ncid Hdd request lookup call")  	
       Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddIsMemberObject(context.hddMemRequest , context.compAllergyDomain,allergyCode , "isCompAllergy"_algIndex)
       }
      } 
    }
  if (context.AllergyNcidPresent=1 )
  {
  
     set tStatus=process.SendRequestSync(context.hddTargetConfigName,context.hddMemRequest,.hddMemResponse)
     if ('tStatus) {     
     set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure. "_$SYSTEM.Status.GetOneErrorText(tStatus))
     }
      else { 
         set context.hddMemResponse= hddMemResponse
          $$$TRACE("Hdd return count(isMemberObjectFromNcid): " _ context.hddMemResponse.listOfHDDobj.Count() )
    }
  }
 
 set filterNUnitFlag = 0
  $$$TRACE("filter NU flag ")
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"FilterNU",.filterNUnitFlag)   
 set context.filterNUFlag = filterNUnitFlag

  
]]]]><![CDATA[>
