  set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.CernOrdDietHl7ToComputrition.Lookup.allowedOrdTypes", orc1Ncid, .retVal )
  if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {       
       $$$TRACE("It's not a allowed order type:"_orc1Ncid_", skip message.")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "It's not a allowed order type:"_orc1Ncid_", skip message.")
  }
]]]]><![CDATA[>
