<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tmpStatus AS %Status=$$$OK
	
	set tRequest = ##class(Ens.StreamContainer).%New("")	 
	 set tStream = ##class(%Stream.GlobalCharacter).%New("")
	 set respStr = "<AppResponse><ReturnCode>"_retCode_"</ReturnCode><ReturnDesc>"_retDesc_"</ReturnDesc></AppResponse>"	 
	 do tStream.Write(respStr)	 
	 set tRequest.Stream = tStream	 
	 	  	 	  
	 set claimsOraXmlFileTargetConfigName=##class(Ens.Director).GetItemSettingValue(process1.%ConfigName,"Host","ClaimsOraXmlFileTargetConfigName",.pstatus)
	 set reqObj =##class(IHC.ITF.ITFCOMMON.Request.FileIO).%New(tRequest.Stream)
 	 set reqObj.DestinationFileName = scheduleId_".xml"
	 set reqObj.DestinationFilePath = destinationFilePath
	 try{
 	 	set tmpStatus = process1.SendRequestSync(claimsOraXmlFileTargetConfigName,reqObj)
 	 	if ($$$ISOK(tmpStatus)){
	 	 	$$$TRACE("Response file sent..."_reqObj.DestinationFileName )
 	 		//set tmpStatus = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process1.%ConfigName, retDesc)
