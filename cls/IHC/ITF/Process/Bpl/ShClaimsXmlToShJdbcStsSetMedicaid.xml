	 	set clmUpdateStatusReqObj.pJobStatus = isFileSent
  	 	$$$TRACE(" Before SHSP_MEDICAID_JOB_STS_UPD call...")
     	set tmpStatus=process1.SendRequestSync(claimsStatusUpdateTargetConfigName,clmUpdateStatusReqObj,.dbResponse)
  	 	$$$TRACE(" After SHSP_MEDICAID_JOB_STS_UPD call-status : "_tmpStatus)
	}catch(ex){
		$$$TRACE("$$$Inside update status catch....")	
		set errText = $System.Status.GetOneStatusText(ex)	
		set retDesc = "Error while calling the SP -- SHSP_MEDICAID_JOB_STS_UPD, Failed to update the claim status of 837I. BatchCount: ["_batchNum_"]"_errText	
		set status = ##class(IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcStsSetMedicaid).createAndSendResponse("8",retDesc,scheId, fileName,.process1)    	 	 			  
	}
  	 
	quit tmpStatus
]]></Implementation>
