<FormalSpec><![CDATA[isFileSent:%String,guid:%String,scheId:%String,batchNum:%String,fileName:%String,&process1:IHC.ITF.Process.Bpl.ShClaimsXmlToShJdbcStsSetMedicaid]]></FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	#dim tmpStatus AS %Status=$$$OK
	
	try{
		set claimsStatusUpdateTargetConfigName=##class(Ens.Director).GetItemSettingValue(process1.%ConfigName,"Host","ClaimsStatusUpdateTargetConfigName",.pstatus) 
		set clmUpdateStatusReqObj = ##class(IHC.ITF.Request.ShspMedicareJobStsUpdate).%New()
		set clmUpdateStatusReqObj.pFileGuid = guid
    	set clmUpdateStatusReqObj.pBatchNumber = batchNum
