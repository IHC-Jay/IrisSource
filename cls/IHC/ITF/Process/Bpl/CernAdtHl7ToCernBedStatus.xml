<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)
 
  set hddstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"HddTargetConfigName", .hddConfigValue)
 if ($$$ISOK(hddstatus)){
    set context.HddTargetConfigName = hddConfigValue
    $$$TRACE("HddTargetConfigName: " _ context.HddTargetConfigName)
    $$$TRACE("End of get HDD property")
 }else{
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Unable to get HDDTargetConfigName, shutting down.")
 }
 
 //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Missing TargetConfigNames Values. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages." )
 }else{
     $$$TRACE("TargetConfigNames: " _configValue )
     set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
     if ( ($$$ISERR(pstatus)) || (configValue = "") )
     {
	     Set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not build TargetList. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages." )
	 }else{
		 $$$TRACE("TargetConfigNames: " _context.targetList)
         $$$TRACE("Count: " _ context.targetList.Count())
	 }
     
 }
  
 $$$TRACE("Done gathering settings and properties...")

 ]]]]><![CDATA[>
