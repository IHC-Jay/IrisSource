		</parameters>
		</property>
		<property name='doPV1SixDtlWork' type='%Boolean' initialexpression='0' instantiate='0' >
		<annotation><![CDATA[0 equals don't do DTL mapping
1 equals do DTL PV1-6 work]]]]><![CDATA[></annotation>
</property>
<property name='doPV1ThreeDtlWork' type='%Boolean' initialexpression='0' instantiate='0' >
<annotation><![CDATA[0 equals don't do DTL mapping
		1 equals do DTL PV1-3 work]]]]><![CDATA[></annotation>
		</property>
<property name='doA20Work' type='%Boolean' initialexpression='0' instantiate='0' >
<annotation><![CDATA[0 equals don't do HL7 work
		1 equals do HL7 work]]]]><![CDATA[></annotation>
		</property>


		</context>
		<sequence xend='200' yend='1500' >
		<scope xpos='200' ypos='250' xend='200' yend='1400' >
		<trace name='BedStatusA20' value='"In BPL for A20 LoopBack to Cerner for BedStatus Updae in iCentra."' xpos='200' ypos='350' />
		<code name='Get Setting Properties' xpos='200' ypos='450' >
		<annotation><![CDATA[Get MaxError, TargetConfigNames and HDD Property.]]]]><![CDATA[></annotation>
		<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
		$$$TRACE("Max Errors: " _ maxErr)
		
		set hddstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"HddTargetConfigName", .hddConfigValue)
		if ($$$ISOK(hddstatus)){
			set context.HddTargetConfigName = hddConfigValue
			$$$TRACE("HddTargetConfigName: " _ context.HddTargetConfigName)
			$$$TRACE("End of get HDD property")
			
			//Now get PV1-6 Setting
			//Read TargetConfigNames and PV1-6 Event Types Settings
			set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
			if ( ($$$ISERR(pstatus)) || (context.targetList.Count() <1) ) {
				set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not build TargetList. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages." )
			} else {
				set context.TriggerEvent=request.GetValueAt("MSH:MessageType.triggerevent")
				$$$TRACE("Found message type: " _context.TriggerEvent)
				$$$TRACE("Now Get ADT PV1-6.1 Event Type List")
				set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"PV1SixEventTypes",.PV1SixEventTypes)
				$$$TRACE("Retrieved the following ADT PV1-6.1 Event Types: "_ PV1SixEventTypes)
				if ( ($$$ISERR(pstatus)) || (PV1SixEventTypes = "")) {
					set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to fetch data from ADT PV1-6.1 Event Types list: PV1SixEventTypes, this is unexpected and needs to be checked out, shutting down!") 
				} else {
					$$$TRACE("Checking for Event Types that use the PV1-6.1 for Bed Status Processing:"_PV1SixEventTypes)
					TRY {
						For iTarget=1:1:$L(PV1SixEventTypes,",") 
						{ 
							Set tOneTarget=$ZStrip($P(PV1SixEventTypes,",",iTarget),"<>W")  
                            Continue:""=tOneTarget
							if (context.TriggerEvent = tOneTarget){
								set context.doPV1SixDtlWork = 1
								QUIT
							}
							
							$$$TRACE("ADT Event Type from PV1-6 settings: [" _ tOneTarget _"] verifying against Trigger Event: [ " _ context.TriggerEvent_"]")
						}
						$$$TRACE("context.doPV1SixDtlWork is set to: [" _ context.doPV1SixDtlWork_"]")
						
					} Catch eException {
						Set exceptStatus = "Parsing STRING to LIST for context.PV1SixEvnTypes for ADT PV1-6.1 Event Types list: "_eException.AsStatus()
						set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not parse to build LIST for context.PV1SixEvnTypes. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages. Error caught: "_exceptStatus )
						
					}          
					
				}
				
				
			}

		}else{
			set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get HDDTargetConfigName, shutting down.")
		}

		
		$$$TRACE("Done gathering settings and properties...")

		]]]]><![CDATA[>
		</code>
		
		<code name='CheckTpnInterfaceFlag' xpos='470' ypos='1700' >
<![CDATA[ 
      set tpnInterfaceFlag = request.GetValueAt("ZXY:TPNInterfaceFlag")
      set msh4Facility=request.GetValueAt("MSH:SendingFacility.namespaceID")
      if (tpnInterfaceFlag = "Y"){
	      set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Facility id:"_msh4Facility_" is not valid. Skip message.")
	  }
 ]]]]><![CDATA[>
</code>

		<code name='FilterIn' xpos='200' ypos='550' >
		<![CDATA[ $$$TRACE("Verify the Event Trigger Type for inclusion")
		$$$TRACE("Now pulling MSH-9.2 setting values for: AllowedADTEventTypes")
		set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedADTEventTypes",.allowedEventTypeVal)
		$$$TRACE("Allowed Events found from process AllowedADTEventTypes setting: ["_ allowedEventTypeVal_"]")
		if ( ($$$ISERR(pstatus)) || (allowedEventTypeVal = "")) {
			set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to fetch allowed event typess list: AllowedADTEventTypes in the settings, this is unexpected, shutting down.")
		}else {
			$$$TRACE("***Checking AllowedADTEventTypes Against MSH-9 Trigger Event*** ")
			TRY {
				For iTarget=1:1:$L(allowedEventTypeVal,",") 
						{ 
							Set tOneTarget=$ZStrip($P(allowedEventTypeVal,",",iTarget),"<>W")  
                            Continue:""=tOneTarget
							if (context.TriggerEvent = tOneTarget){
								set context.doA20Work = 1
								QUIT
							}
							
							$$$TRACE("Allowed ADT Event Type from settings: [" _ tOneTarget _"] verifying against Trigger Event: [ " _ context.TriggerEvent_"]")
				}
			    $$$TRACE("Checking against allowed events")
			    if (context.doA20Work=0) {
				    $$$TRACE("Unable to find Trigger Event in the allowed list: TriggerEvent:[" _context.TriggerEvent_ "], is not an allowed event - skipping message.")
				    set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Record does not contain an allowed Trigger Event from the AllowedADTEventTypes settings, not an event type wanted on this pathway - Event Type found is : " _context.TriggerEvent_ ", Allowed event types are: -"_allowedEventTypeVal_"-, skipping message.")
			    }
			    else{
				     $$$TRACE("Have a workable Event Type. Next going to check HDD to see if facility unit is one Cerner wants worked.")
			    }
			} Catch eException {
				Set exceptStatus = "Parsing STRING to LIST for listAllowedEventTypes for ADT MSH9.2 Event Types list: "_eException.AsStatus()
				set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not parse context.AllowedADTEventTypes. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages. Error caught: "_exceptStatus )
				
			}   
			
		}

		]]]]><![CDATA[>
		</code>
		<code name='WorkHDDLookup' xpos='200' ypos='650' >
		<annotation><![CDATA[See if Unit NCID PV1-3.1 or PV1-6.1 is in the BedStatus Context]]]]><![CDATA[></annotation>
		<![CDATA[ $$$TRACE("Creating HDD Object to check the point of care unit NCID is one we want to work to send back to Cerner for a Bed Status A20 update....")
		$$$TRACE("Building IsMember Hdd Requests..")

		if (context.doPV1SixDtlWork = 1){
			set context.UnitNcid = request.GetValueAt("PV1:PriorPatientLocation.pointofcare")
			$$$TRACE("Unit Ncid in PV1-6.1 " _ context.UnitNcid)
			
		}else{
			set context.UnitNcid = request.GetValueAt("PV1:AssignedPatientLocation.pointofcare")
			$$$TRACE("Unit Ncid in PV1-3.1 " _ context.UnitNcid)
			set context.doPV1ThreeDtlWork = 1
		}
		
		if (context.UnitNcid '= "" && $ISVALIDNUM(context.UnitNcid)= "1"){
	Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddIsMemberObject(context.IsMemberRequest, context.hddNcidBedStatInPatUnitInclValSetIsMember, context.UnitNcid, "IsMemberPV1Unit")         
}

]]]]><![CDATA[>
</code>
<code name='CallHddIsMemberMethod' xpos='200' ypos='750' >
<![CDATA[ 
 $$$TRACE("Calling HDD Operation...")
	set tStatus=process.SendRequestSync(context.HddTargetConfigName, context.IsMemberRequest,.hddIsMemberResponse)
	if ('tStatus) {
			set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure during isMember Hdd call. "_$SYSTEM.Status.GetOneErrorText(tStatus))    
		}else { 
			set context.IsMemberResponse = hddIsMemberResponse 
		}
		]]]]><![CDATA[>
		</code>
		<code name='CheckIfFacilityIsMember' xpos='200' ypos='850' >
		<![CDATA[ 
		set context.isPocUnitMemberResp = ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).GetHddObject(context.IsMemberResponse, "IsMemberPV1Unit")
		
		$$$TRACE("isPocUnitMemberResp back from HDD is: ["_context.isPocUnitMemberResp.Rep_"]" )    
		if (context.isPocUnitMemberResp.Rep=1) {                      
			$$$TRACE("Unit NCID in PV1: ["_context.UnitNcid_"] is a member of Bed Status Inpatient Unit Inclusion Value Set Domain: ["_context.hddNcidBedStatInPatUnitInclValSetIsMember_"]") 
			$$$TRACE("Cerner requires a Bed Status back to iCentra for this Unit NCID. Processing Record.")
		}else{
			$$$TRACE("Unit NCID in PV1: ["_context.UnitNcid_"] is NOT a member of Bed Status Inpatient Unit Inclusion Value Set Domain: ["_context.hddNcidBedStatInPatUnitInclValSetIsMember_"]") 
			$$$TRACE("Message not needed to go back to Cerner. Skipping Record.")
			set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Record does not contain a Unit NCID that Cerner requires a Bed Status Update back to iCentra. Skipping message.")
			
		}
		]]]]><![CDATA[>
		</code>
		<transform name='A20DTL' class='IHC.ITF.Transform.Dtl.CernAdtHl7ToCernBedStatus' source='request' target='response' xpos='200' ypos='950' />
		<trace name='ReturnFromDTL' value='"Back from Transform"' xpos='200' ypos='1050' />
		<foreach name='Send To Targets' property='context.targetList' key='context.targetListIndex' xpos='200' ypos='1150' xend='200' yend='450' >
		<call name='SendToEachTarget' target='@context.targetList.GetAt(context.targetListIndex)' async='1' xpos='200' ypos='250' >
		<request type='Ens.Request' >
		<assign property="callrequest" value="response" action="set" />
		</request>
		</call>
		<trace name='TraceOutSendInfo' value='"TargetCountIndex: "_context.targetListIndex_", Message Sent to target: "_ context.targetList.GetAt(context.targetListIndex)' xpos='200' ypos='350' />
		</foreach>
		<faulthandlers>
		<catchall xpos='200' ypos='1250' xend='200' yend='350' >
		<code name='Call error handler method' xpos='200' ypos='250' >
		<![CDATA[  Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).ProcessError(..%Context.%LastError)]]]]><![CDATA[>
		</code>
		</catchall>
		</faulthandlers>
