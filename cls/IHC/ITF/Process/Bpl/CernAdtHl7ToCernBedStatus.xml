<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)
 
 set hddstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"HddTargetConfigName", .hddConfigValue)
 if ($$$ISOK(hddstatus)){
    set context.HddTargetConfigName = hddConfigValue
    $$$TRACE("HddTargetConfigName: " _ context.HddTargetConfigName)
    $$$TRACE("End of get HDD property")
 }else{
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to get HDDTargetConfigName, shutting down.")
 }
 
 //Read TargetConfigNames
 set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
 if ( ($$$ISERR(pstatus)) || (context.targetList.Count() <1) ) {
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not build TargetList. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages." )
 } else {
      TRY {
           $$$TRACE("No error while fetching TargetConfigNames. Parsing Target List into string...")
           if ($LISTVALID(context.targetList) =1){
	           set tListStr = $LISTTOSTRING(context.targetList,":")
               $$$TRACE("TargetConfigNamesList: [" _tListStr_"] ")
               set tListCount = context.targetList.Count()
               $$$TRACE("Count: [" _tListCount_"] ")
	       } else {
		       set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not validate a valid Ensemble LIST collection for: TargetList. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages." )
		   }
           
      } Catch eException {
         Set exceptStatus = "Parsing LIST to STRING for context.targetList for logging and debugging: "_eException.AsStatus()
	     $$$LOGSTATUS(exceptStatus)
	     set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not parse TargetList. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages. Error caught: "_exceptStatus )
            
      }
      
      $$$TRACE("Get ADT PV1-6.1 Event Type List")
      set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"PV1SixEventTypes",.PV1SixEventTypes)
      $$$TRACE("ADT PV1-6.1 Event Types: "_ PV1SixEventTypes)
      if ( ($$$ISERR(pstatus)) || (PV1SixEventTypes = "")) {
          set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to fetch data from ADT PV1-6.1 Event Types list: PV1SixEventTypes, this is unexpected and needs to be checked out, shutting down!") 
      } else {
          $$$TRACE("Here are the ADT Event Types that use the PV1-6.1 for Bed Status Processing:"_PV1SixEventTypes)
          TRY {
	          set PV1SixEventTypesNoSpaces = $ZSTRIP(PV1SixEventTypes,"<>W")
              set context.PV1SixEvnTypes = $LISTFROMSTRING(PV1SixEventTypesNoSpaces, ",")
              if ($LISTVALID(context.PV1SixEvnTypes)=1){
	              $$$TRACE("Successfully created PV1-6 Event Types List.")
	          }
          
	      } Catch eException {
		      Set exceptStatus = "Parsing STRING to LIST for context.PV1SixEvnTypes for ADT PV1-6.1 Event Types list: "_eException.AsStatus()
	          $$$LOGSTATUS(exceptStatus)
	          set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not parse context.PV1SixEvnTypes. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages. Error caught: "_exceptStatus )
          		      
		  }
          
          
          if ((context.PV1SixEvnTypes = "") || (context.PV1SixEvnTypes.Count()<1)) {
	          set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to process data from ADT PV1-6.1 Event Types list settings: PV1SixEventTypes, this is unexpected and needs to be checked out, shutting down!") 
	     
	      } else{
	          TRY {
	              $$$TRACE("context.PV1SixEvnTypes: ["_$LISTFROMSTRING(context.PV1SixEvnTypes,":")_"] ")
	    
	          } Catch eException {
                  Set exceptStatus = "Error performing List To String function for context.PV1SixEvnTypes. Error: "_eException.AsStatus()
	              $$$LOGSTATUS(exceptStatus)
	              set status=##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Could not parse context.PV1SixEvnTypes doing List To String function. Required to proces HL7 Messages back to iCentra ADT A20 BED STATUS Messages." )
            
              }
          }

      }
      
      
 }
     
     
 
 
 
  
 $$$TRACE("Done gathering settings and properties...")

 ]]]]><![CDATA[>
