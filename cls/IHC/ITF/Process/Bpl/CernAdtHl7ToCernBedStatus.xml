<code name='WorkHDDLookup' xpos='200' ypos='650' >
<annotation><![CDATA[See if Unit NCID PV1-3.1 is in the BedStatus Context]]]]><![CDATA[></annotation>
<![CDATA[ $$$TRACE("Creating HDD Object to check the point of care unit NCID is one we want to work to send back to Cerner for a Bed Status A20 update....")
 $$$TRACE(" IsMember Hdd Requests..")    
 set context.PointOfCareUnitNcid = request.GetValueAt("PV1:AssignedPatientLocation.pointofcare")
 $$$TRACE("POC Ncid in PV1-3.1 " _ context.PointOfCareUnitNcid) 
 if (context.PointOfCareUnitNcid '= "" && $ISVALIDNUM(context.PointOfCareUnitNcid)= "1"){
    Do ##class(IHC.ITF.ITFCOMMON.HDD.Interface.Utility).AddIsMemberObject(context.IsMemberRequest, context.hddNcidBedStatInPatUnitInclValSetIsMember, context.PointOfCareUnitNcid, "IsMemberPV1ThreeOne")         
 }

]]]]><![CDATA[>
</code>
