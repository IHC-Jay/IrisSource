<code name='FilterIn' xpos='200' ypos='550' >
<![CDATA[ $$$TRACE("Verify the Event Trigger Type and check nurse unit for inclusion")
  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"AllowedADTEventTypes",.allowedEventTypeVal)
  $$$TRACE("Allowed Events: "_ allowedEventTypeVal)
  if ( ($$$ISERR(pstatus)) || (allowedEventTypeVal = "")) {
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).DisableMsgError(process.%ConfigName, "Unable to find allowed event typess list: AllowedADTEventTypes in the settings, this is unexpected, shutting down.")
  }else {
    set context.TriggerEvent=request.GetValueAt("MSH:MessageType.triggerevent")
    $$$TRACE("Getting message type: " _context.TriggerEvent)
    set AllowedADTEventTypes = $LISTFROMSTRING(allowedEventTypeVal, ",")
    
    $$$TRACE("Checking against allowed events")
    if ($LISTFIND(AllowedADTEventTypes, context.TriggerEvent)=0) {
       $$$TRACE("Unable to find Trigger Event in the settings: " _context.TriggerEvent_ ", not an allowed event skipping message.")
       set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Record does not contain an allowed Trigger Event from the AllowedADTEventTypes settings, not an event type wanted on this pathway - Event Type found is : " _context.TriggerEvent_ ", Allowed event types are: -"_allowedEventTypeVal_"-, skipping message.")
    }
    else{
	    $$$TRACE("Have a workable Event Type. Next going to check HDD to see if facility unit is one Cerner wants worked.")
	}
  }

]]]]><![CDATA[>
