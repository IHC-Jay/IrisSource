		<parameter name='MAXLEN'  value='50' />
		</parameters>
		</property>
		<property name='IsMemberRequest' type='IHC.ITF.ITFCOMMON.HDD.Interface.IsMemberLookupRequest' instantiate='1' />
		<property name='IsMemberResponse' type='IHC.ITF.ITFCOMMON.HDD.Interface.LookupResponse' instantiate='1' />
		<property name='HddTargetConfigName' type='%String' instantiate='0' >
		<parameters>
