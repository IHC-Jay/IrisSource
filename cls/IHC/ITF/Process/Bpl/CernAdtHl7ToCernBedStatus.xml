<![CDATA[ 
 // Call HDD Operation     
    set tStatus=process.SendRequestSync(context.hddTargetConfigName, context.IsMemberRequest,.hddIsMemberResponse)
    if ('tStatus) {
       set status=##class(IHC.ITF.ITFCOMMON.Utility).ItfGeneralError(process.%ConfigName,"Unexpected HDD response returned or HDD call failure during isMember Hdd call. "_$SYSTEM.Status.GetOneErrorText(tStatus))    
    }else { 
       set context.IsMemberResponse = hddIsMemberResponse 
    }
    ]]]]><![CDATA[>
