<code name='ConvertXmlToJSONAndCallPatientServiceMerges' xpos='1010' ypos='3150' >
<![CDATA[  
    $$$TRACE("Converting XML to JSON Operation (Merges).. ")
    set xmlStr=response.OutputToString()  
    $$$TRACE("DTL Output: "_xmlStr)  
    set myList = $LISTBUILD("primaryIds","toRetireIds")
    set json = ##class(IHC.ITF.ITFCOMMON.Util.XmlToJson2).CreateJson(xmlStr,myList)
    $$$TRACE("JSON string: "_json)             
    set jsonProcessRequest=##class(Ens.StringContainer).%New()
    set jsonProcessRequest.StringValue= ##class(Ens.Util.FunctionSet).SubString(json, 28, $LENGTH(json)-1)
    $$$TRACE("JSON string-Removed root XML element: "_jsonProcessRequest.StringValue)   
    
    $$$TRACE("Calling Merge Patient service") 
    set operType = "MERGE"        
    set tarConfigName = context.mergeHiePatientServiceTargetConfigName
    $$$TRACE(" Target Operation: " _ tarConfigName) 
    set httpPingServiceRequestObj=##class(IHC.ITF.ITFCOMMON.Request.HiePatientService).%New() 
    set httpPingServiceRequestObj.accessToken = context.accessToken
    set httpPingServiceRequestObj.operationType = operType  
    set httpPingServiceRequestObj.identifier = context.tellicaKeepMrn 
    set httpPingServiceRequestObj.streamObject = jsonProcessRequest
    
    $$$TRACE(" Calling Patient Service "_operType_" - BEGIN ")
    set status = process.SendRequestSync(tarConfigName,httpPingServiceRequestObj,.patientServiceResponse)
    $$$TRACE(" Calling Patient Service "_operType_" - END ")
    set respdata =""
    if (status=$$$OK){
	    $$$TRACE("Call PatientService "_operType_" Operation OK status.")      
        set patServiceResponseData=patientServiceResponse.Stream  
        set statusCode = patientServiceResponse.Attributes.GetAt("StatusCode")       
        set stream =   patServiceResponseData
       	set respData = ""
       	While 'stream.AtEnd { 
       		set respData = respData _ stream.ReadLine(,.sc,.eol)       		
       	}
        $$$TRACE(" httpStatusCode: "_statusCode)    
        
        set respdata = respData _ " JSON Request: "_jsonProcessRequest.StringValue_$CHAR(10)
        
        if (statusCode'="200"){
	    	if (statusCode="401"){
		   		$$$TRACE("  CheckError... ")
		   		set status=##class(IHC.ITF.ITFCOMMON.Utility).RetryCheckError(process.%ConfigName,"Http Status code: ["_statusCode_"]. Invalid access token. Response: ["_respData_"]. Retrying...") 
		   	}elseif (statusCode="400"){
		    	$$$TRACE("  In Status Code 400... ")
		    	$$$TRACE(" respData "_respData)
		    	set tRequest = ##class(Ens.StreamContainer).%New("")	 
