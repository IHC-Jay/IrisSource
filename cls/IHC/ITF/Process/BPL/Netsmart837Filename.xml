<sequence xend='200' yend='1700' >
<scope xpos='200' ypos='250' xend='200' yend='1600' >
<trace name='Enter BPL' value='"Entering BPL..."' xpos='200' ypos='350' />
<assign name="getAndSetProcessName" property="context.configName" value="process.%ConfigName" action="set" xpos='200' ypos='450' >
<annotation><![CDATA[Process Configuration Name]]]]><![CDATA[></annotation>
</assign>
<code name='Check ReplyCodeActions' xpos='200' ypos='550' >
<annotation><![CDATA[From settings tab]]]]><![CDATA[></annotation>
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }]]]]><![CDATA[>
</code>
<code name='Trace MaxError and get Target Config Names' xpos='200' ypos='650' >
<annotation><![CDATA[Trace MaxError and get Target Config Names]]]]><![CDATA[></annotation>
<![CDATA[ //Read Max Errors
 set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)
 
 //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
   set status=##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, No TargetConfigNames found!")
 }else{
      $$$TRACE("TargetConfigNames: " _configValue )
 }
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
    $$$TRACE("TargetConfigNames: " _context.targetList)
    $$$TRACE("TargetConfigCount: " _ context.targetList.Count())
   ]]]]><![CDATA[>
</code>
<code name='Incoming Message' xpos='200' ypos='750' >
<![CDATA[  Do request.Stream.Rewind()
  Set context.claimData=""
  While (request.Stream.AtEnd = 0) {
    Set context.claimData=context.claimData_request.Stream.Read(1)  
  }
   $$$TRACE("Incoming Claim Data (first 100):"_$EXTRACT(context.claimData,1,100))
]]]]><![CDATA[>
</code>
<code name='Parse Incoming Message ' xpos='200' ypos='850' >
<annotation><![CDATA[Find the GS08 value]]]]><![CDATA[></annotation>
<![CDATA[ 
  Do request.Stream.Rewind()
  Set context.claimData=""
  While (request.Stream.AtEnd = 0) {
    Set context.claimData=context.claimData_request.Stream.Read(1)  
  }
  
  set ISAsegment = $EXTRACT(context.claimData,1,106)
  $$$TRACE("Incoming Claim Data (ISA Segment): "_ISAsegment)
  
  Set segmentDelimiter = $EXTRACT(ISAsegment,106)
  $$$TRACE("segmentDelimiter: "_segmentDelimiter)
   
  Set elementDelimiter = $EXTRACT(ISAsegment,104)
  $$$TRACE("elementDelimiter: "_elementDelimiter)

  Set GSSegment = $PIECE(context.claimData,segmentDelimiter,2)
  $$$TRACE("GS Segment: "_GSSegment)

  Set GS08 = $PIECE(GSSegment,elementDelimiter,9)
  $$$TRACE("GS08: "_GS08)]]]]><![CDATA[>
</code>
<code name='Derive Transaction Type' xpos='200' ypos='950' >
<![CDATA[ //We need to derive the transactionType
  //837p GS 08 has version number ending in 222 whereas 837i has 223
  
  set context.transactionType="PENDING"
  if ($EXTRACT(GS08,*-4,*-2)="222")
  {
     set context.transactionType="837P01D"
  }

  if ($EXTRACT(GS08,*-4,*-2)="223")
  {
     set context.transactionType="83701D"
  }

  if (context.transactionType="PENDING")
  {
     set context.transactionType="BAD_DATA"
     //set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "GS08 is not producing a correct transaction type!")
     // Skip the record.
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "GS08 is not producing a correct transaction type!")
  }
  
  
 $$$TRACE("context.transactionType: "_context.transactionType)

  
]]]]><![CDATA[>
</code>
<code name='Derive the outgoing filename' xpos='200' ypos='1050' >
<annotation><![CDATA[Derive the outgoing filename; the same filename needs to go to the R1 outbounds and to Edifecs for Transaction Management]]]]><![CDATA[></annotation>
<![CDATA[  //Get the incoming filename
  

  //Separate the filename from the path
  SET inputFilename=$PIECE(request.OriginalFilename,"/",*)
  
  $$$TRACE("inputFilename="_inputFilename)
  
  set uniqueID = $EXTRACT(inputFilename,4,*-4)
  $$$TRACE("uniqueID: "_uniqueID)

 set context.destinationFilepath = "/Homehealth/"_context.transactionType_"/"
 $$$TRACE("context.destinationFilepath="_context.destinationFilepath)

  set context.destinationFilename = $ZDATE($HOROLOG,8)_".A109."_context.transactionType_"."_uniqueID_".HORIZON.TXT"

   $$$TRACE("context.destinationFilename="_context.destinationFilename)

]]]]><![CDATA[>
</code>
<code name='Store the message' xpos='200' ypos='1150' >
<annotation><![CDATA[We need to copy the incoming data to the outgoing request object so we can send along the new filename.]]]]><![CDATA[></annotation>
<![CDATA[ //Create a global stream to persist file content
	set stream=##class(%Stream.GlobalCharacter).%New()

	Set status= stream.CopyFromAndSave(request.Stream)
	
	if $$$ISERR(status)
	{
	   $$$TRACE("Skip message, stream copy failed")
	   set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Skip the record.")
	   Quit
	}

	$$$TRACE(request.OriginalFilename_" (ID "_request.%Id()_") has been successfully saved to database. Stream OID is "_stream.%Oid()_"; Stream ID is "_stream.%Id()_".")
	set context.response=##class(IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath).%New(stream)
	
	 
	SET context.response.DestinationFilePath = context.destinationFilepath
	$$$TRACE("context.response.DestinationFilePath="_context.response.DestinationFilePath)
	SET context.response.DestinationFileName = context.destinationFilename
	$$$TRACE("context.response.DestinationFileName="_context.response.DestinationFileName)
	SET context.response.SourceFileName = $PIECE(request.OriginalFilename,"/",*)
	$$$TRACE("context.response.SourceFileName="_context.response.SourceFileName)
	]]]]><![CDATA[>
</code>
<foreach name='For Each Target' property='context.targetList' key='context.targetConfigIndex' xpos='200' ypos='1250' xend='200' yend='450' >
<trace value='"Sending to target..."' xpos='200' ypos='250' />
<call name='Send to TargetConfigNames' target='@context.targetList.GetAt(context.targetConfigIndex)' async='1' xpos='200' ypos='350' >
<request type='IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath' >
<assign property="callrequest" value="context.response" action="set" />
</request>
</call>
</foreach>
<code name='RESETERROR' xpos='200' ypos='1350' >
<![CDATA[  Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)]]]]><![CDATA[>
