<![CDATA[        Set tMessage = "837 X12 File '"_context.sourcefilename_"' was received from invalid source '"_tService_"'. Please verify and reprocess the file appropriately."
        Do ##class(%SYS.Log).Error(tMessage)
        $$$TRACE("Logged error: "_tMessage)]]]]><![CDATA[>
