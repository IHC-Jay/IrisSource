<if name='Is MedGroup ?' condition='$EXTRACT($PIECE($PIECE(request.streamContainer.OriginalFilename,"/",*),"_",1),1,5) = "MG837"' xpos='1010' ypos='900' xend='1010' yend='1250' >
<true>
<code name='Derive the outgoing filename' xpos='1010' ypos='1050' >
<![CDATA[  //Get the incoming filename
  /* Expected input filename from iCentraMG is of format " PROD_iCENTRA_<Date>_<Some #>_<Some other #>.837p " and Required output file name format is
		 " <Date>.<Dest Trans Type>.<Some #>_<Some other #> _<ServerId>.TXT "
		 Example:
		 input filename : MG837P_20210526_19344885.837p
		 Output filename : 20210526.A400.837P01D.19344885.837p.TXT
		 ----------------------------------------------------------------------------------------------------------------
			Proposed File Name:
				837p: inputfiledate + ".A400.837P01D." +  unique_ID + ".837p.TXT"
				837i: inputfiledate + ".A400.837P01D." +  unique_ID + ".837i.TXT"

			Test File Path
				837p: /Test/MedicalGroup/837P01D/
				837i: /Test/MedicalGroup/83701D/
		
			Prod File Path
				837p: /MedicalGroup/837P01D/
				837i: /MedicalGroup/83701D/
		 */
  //Separate the filename from the path
  SET inputfilename=$PIECE(request.streamContainer.OriginalFilename,"/",*)
  $$$TRACE("inputfilename="_inputfilename)
  
  if ($FIND(inputfilename,"_")>0) // If there are underscores in the input file name
  {
	 SET inputfiledate=$PIECE(inputfilename,"_",2)
     $$$TRACE("inputfiledate="_inputfiledate)
     
     SET uniqueId=$PIECE(inputfilename,"_",3)
     $$$TRACE("uniqueId(including extension)="_uniqueId)
	 
     SET transactiontype = $EXTRACT($PIECE(inputfilename,"_"),*-3,*) 
     IF (transactiontype="837P") ! (transactiontype="837p")
     {
       SET context.transactiontype="837P01D"
       $$$TRACE("context.transactiontype="_context.transactiontype)
     }
     ELSEIF (transactiontype="837I") ! (transactiontype="837i")
     {
        SET context.transactiontype="83701D"
        $$$TRACE("context.transactiontype="_context.transactiontype)
     }
	 
     SET context.destinationfilename=inputfiledate_".A400.837P01D."_uniqueId_".TXT"	 
     $$$TRACE("context.destinationfilename="_context.destinationfilename)	 
     
     SET context.destinationfilepath = "/MedicalGroup/"_context.transactiontype_"/"
     $$$TRACE("context.destinationfilepath="_context.destinationfilepath) 
   }
  //if the incoming filename does NOT contain an underscore
   ELSE
   {
      SET status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Input 837 X12 file received from iCentraMG does not contain underscores. Please verify and correct the input file name as per expected standards and reprocess the file.")
 }]]]]><![CDATA[>
</code>
