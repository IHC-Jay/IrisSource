<trace name='Sending to targets' value='"Sending to targets..."' xpos='200' ypos='1550' disabled="true"/>
<foreach name='For Each Target' property='context.targetList' key='context.targetConfigIndex' xpos='200' ypos='1650' xend='200' yend='350' >
<call name='Send to TargetConfigNames' target='@context.targetList.GetAt(context.targetConfigIndex)' async='1' xpos='200' ypos='250' >
<request type='IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath' >
