<code name='Store the message' xpos='1010' ypos='1350' >
<annotation><![CDATA[We need to copy the incoming data to the outgoing request object so we can send along the new filename.]]]]><![CDATA[></annotation>
<![CDATA[ //Create a global stream to persist file content
	set stream=##class(%Stream.GlobalCharacter).%New()

	Set status= stream.CopyFromAndSave(request.streamContainer.Stream)
	
	if $$$ISERR(status)
	{
	   $$$TRACE("Skip message, stream copy failed")
	   set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Skip the record.")
	   Quit
	}

	$$$TRACE(request.streamContainer.OriginalFilename_" (ID "_request.%Id()_") has been successfully saved to database. Stream OID is "_stream.%Oid()_"; Stream ID is "_stream.%Id()_".")
	set context.response=##class(IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath).%New(stream)
	
        SET context.response.SenderID = "INTERMOUNTAIN"
        $$$TRACE("context.response.SenderID="_context.response.SenderID)

        SET context.response.ReceiverID = "ICENTRA"
        $$$TRACE("context.response.ReceiverID="_context.response.ReceiverID)
        
        if ($EXTRACT($PIECE(request.streamContainer.OriginalFilename,"_",1),1,5)="MG837")
        {SET context.response.InputSource = "iCentraMG"}
  	else 
  	{SET context.response.InputSource = "iCentra"}
	$$$TRACE("context.response.InputSource="_context.response.InputSource)
		
	SET context.response.FacilityCode = context.facilitycode
	$$$TRACE("context.response.FacilityCode="_ context.response.FacilityCode)
	
	SET context.response.DestinationFilePath = context.destinationfilepath
	$$$TRACE("context.response.DestinationFilePath="_context.response.DestinationFilePath)
	
	SET context.response.DestinationFileName = context.destinationfilename
	$$$TRACE("context.response.DestinationFileName="_context.response.DestinationFileName)
	
	SET context.response.SourceFileName = request.streamContainer.OriginalFilename
	$$$TRACE("context.response.SourceFileName="_context.response.SourceFileName)

	]]]]><![CDATA[>
