<trace name='Message(s) forwarded.' value='"Message(s) forwarded."' xpos='200' ypos='1750' />
<code name='DB Destination Filename update' xpos='200' ypos='1850' >
<![CDATA[   	   set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"X12StoreTargetConfigName",.configValue)
           set context.TargetDest=configValue
 if ( ($$$ISOK(pstatus)) && (configValue '= ""))
 {         
           //Start - Set Destination Filename in the IRIS DB - IHC.X12.Data837
           $$$TRACE("Sending X12 to " _ configValue _" to update destination filename")
           SET inputfilename=$PIECE(request.streamContainer.OriginalFilename,"/",*)
   	   
	   Set context.storeX12 = ##class(IHC.ITF.ITFCOMMON.DStruc.StoreX12).%New()
           Set context.storeX12.streamContainer = ##class(Ens.StreamContainer).%New()
           Set context.storeX12.streamContainer.Stream = ##class(%Stream.GlobalCharacter).%New()
           Set tSC2 = context.storeX12.streamContainer.Stream.CopyFromAndSave(request.streamContainer.Stream)
           
           Set context.storeX12.fileName = inputfilename     
           Set context.storeX12.destinationFileName = context.destinationfilename
           $$$TRACE("context.storeX12.destinationFileName: " _ context.storeX12.destinationFileName )
           Set context.storeX12.status = "Processed"
           set context.storeX12.SessionID = process.%PrimaryRequestHeader.SessionId
           
           //Set tSC3=process.SendRequestAsync(configValue, storeX12)
           //$$$TRACE("Destination Filename update - Send Async Incoming Stream to Store in DB, status: " _ tSC3 )
           //End- Set Destination Filename in the IRIS DB
  
 } 
 else {
        $$$TRACE("X12 is not sent to the store process to Destination filename update")
 }
]]]]><![CDATA[>
</code>
<call name='Update DB with DestFN' target='@context.TargetDest' async='1' xpos='200' ypos='1950' >
<request type='IHC.ITF.ITFCOMMON.DStruc.StoreX12' >
<assign property="callrequest" value="context.storeX12" action="set" />
</request>
</call>
<code name='RESETERROR' xpos='200' ypos='2050' >
