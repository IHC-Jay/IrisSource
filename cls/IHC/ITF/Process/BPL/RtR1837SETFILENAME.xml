<![CDATA[  //Separate the filename from the path
  /* Expected input filename from CPR+ is of format " edi<Date><Time><Tomorrows Date>ARCH " and Required output file name format is
		 " <Date>.837P01D.<Time>_<ServerId>.TXT   "
		 Example:
		 input filename : edi2026011903482269.dat
		 Output filename : EDI20260119.A109.837P01D.03482269.CPRPLUS.TXT
		 
		 input filename : emc2026011444444342.dat
		 Output filename : EMC20260114.A109.837P01D.44444342.CPRPLUS.TXT
		 */
  SET inputFilename=$PIECE(request.streamContainer.OriginalFilename,"/",*)
  $$$TRACE("inputFilename="_inputFilename)
  
  //set filenamePrefix = $EXTRACT(inputFilename,1,3)
  set filenamePrefix = $ZCONVERT($EXTRACT(inputFilename,1,3),"U")
  $$$TRACE("filenamePrefix ="_filenamePrefix)
  
  set filenameDate = $EXTRACT(inputFilename,4,11)
  $$$TRACE("filenameDate ="_filenameDate)
    
  set uniqueID = $EXTRACT(inputFilename,12,*-4)
  $$$TRACE("uniqueID: "_uniqueID)
  
  set context.destinationfilename = filenamePrefix_filenameDate_".A109.837P01D."_uniqueID_".CPRPLUS.TXT"
  $$$TRACE("destinationfilename="_context.destinationfilename )
  
 //Assign the outgoing file path
 set context.destinationfilepath="/Homehealth/837P01D/"
  ]]]]><![CDATA[>
