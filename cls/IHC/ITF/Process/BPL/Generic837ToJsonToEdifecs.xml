<code name='Build JSON from Data and Filename' xpos='200' ypos='750' >
<![CDATA[  $$$TRACE("Converting Data and filename to JSON Operation.. ")
  
  //Check for incoming data
  if (context.ClaimData'="") {
     $$$TRACE("Incoming Data found and contains "_ $LENGTH(context.ClaimData) _" characters.") 
  }
  else {
     $$$TRACE("context.ClaimData is empty!")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "NO INPUT DATA RECIEVED!, Skipping the record.")
  }
  
  //Build a string that has the original input billing system...
  if (request.InputSource'="") {
     $$$TRACE("Input Source: "_request.InputSource)
  }
  else {
     $$$TRACE("request.InputSource is empty!")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "NO ORIGINAL INPUT SOURCE RECIEVED!, Skipping the record.")
  }
  
  //Build a string that has the Facility Code
  if (request.FacilityCode'="") {
     $$$TRACE("Facility Code: "_request.FacilityCode)
  }
  else {
     $$$TRACE("request.FacilityCode is empty!")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "NO FACILITY CODE RECIEVED!, Skipping the record.")
  }
  
  
  //Build a string that has the original filename...
  if (request.SourceFileName'="") {
     $$$TRACE("Source File Name: "_request.SourceFileName)
  }
  else {
     $$$TRACE("request.SourceFileName is empty!")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "NO ORIGINAL FILE NAME RECIEVED!, Skipping the record.")
  }
  
  
   //Build a string that has the filename...
  if (request.DestinationFileName'="") {
     $$$TRACE("Destination File Name: "_request.DestinationFileName)
  }
  else {
     $$$TRACE("request.DestinationFileName is empty!")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "NO INPUT FILE NAME RECIEVED!, Skipping the record.")
  }
  
  
  //Build a string that has the filepath...
  if (request.DestinationFilePath'="") {
     $$$TRACE("Destination File Path: "_request.DestinationFilePath)
  }
  else {
     $$$TRACE("request.DestinationFilePath is empty!")
     set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "NO INPUT FILE PATH RECIEVED!, Skipping the record.")
  }
  
  set claimForEdifecsTMRequestObj=##class(IHC.ITF.Request.ClaimJSONToEdifecs).%New()
  $$$TRACE("New IHC.ITF.Request.ClaimJSONToEdifecs created.")
  set claimForEdifecsTMRequestObj.FacilityCode= request.FacilityCode
  set claimForEdifecsTMRequestObj.ClaimData = context.ClaimData
  set claimForEdifecsTMRequestObj.InputSource= request.InputSource
  set claimForEdifecsTMRequestObj.SourceFileName= request.SourceFileName
  set claimForEdifecsTMRequestObj.DestinationFileName = request.DestinationFileName
  set claimForEdifecsTMRequestObj.DestinationFilePath = request.DestinationFilePath
  $$$TRACE("Blah")
  
  //$$$TRACE("IHC.ITF.Request.ClaimJSONToEdifecs populated: FacilityCode="_context.FacilityCode_" ClaimData="_context.ClaimData_" InputSource="_request.InputSource_" SourceFileName="_request.SourceFileName_" DestinationFileName="_request.DestinationFileName_" DestinationFilePath="_request.DestinationFilePath)
    
  set status = process.SendRequestSync("Out-Claims-Json-BRIDGE-Ens-TO-EdifecsRco-REST",claimForEdifecsTMRequestObj,"") //No response is necessary

  $$$TRACE("JSON REQUEST SENT.")
  ]]]]><![CDATA[>
