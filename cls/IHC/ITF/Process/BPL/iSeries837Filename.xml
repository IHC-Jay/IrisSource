BPL Definition</Description>
<XMLNamespace>http://www.intersystems.com/bpl</XMLNamespace>
<Data><![CDATA[
<process language='objectscript' request='Ens.Request' height='2000' width='2000' >
<context>
<property name='ClaimData' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='2500' />
</parameters>
</property>
<property name='configName' type='%String' initialexpression='"PENDING"' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='targetList' type='%String' collection='list' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='destinationFilename' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='2500' />
</parameters>
</property>
<property name='destinationFilepath' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='2500' />
</parameters>
</property>
<property name='targetConfigIndex' type='%Integer' instantiate='0' />
<property name='response' type='IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath' instantiate='0' />
<property name='facilitycode' type='%String' initialexpression='"PENDING"' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='10' />
</parameters>
</property>
</context>
<sequence xend='200' yend='1600' >
<scope xpos='200' ypos='250' xend='200' yend='1500' >
<trace name='Enter BPL' value='"Entering BPL..."' xpos='200' ypos='350' />
<assign name="getAndSetProcessName" property="context.configName" value="process.%ConfigName" action="set" xpos='200' ypos='450' >
<annotation><![CDATA[Process Configuration Name]]]]><![CDATA[></annotation>
</assign>
<code name='Check ReplyCodeActions' xpos='200' ypos='550' >
<annotation><![CDATA[From settings tab]]]]><![CDATA[></annotation>
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }]]]]><![CDATA[>
</code>
<code name='Trace MaxError and get Target Config Names' xpos='200' ypos='650' >
<annotation><![CDATA[Trace MaxError and get Target Config Names]]]]><![CDATA[></annotation>
<![CDATA[ //Read Max Errors
 set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 $$$TRACE("Max Errors: " _ maxErr)
 
 //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
   set status=##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, No TargetConfigNames found!")
 }else{
      $$$TRACE("TargetConfigNames: " _configValue )
 }
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
    $$$TRACE("TargetConfigNames: " _context.targetList)
    $$$TRACE("TargetConfigCount: " _ context.targetList.Count())
   ]]]]><![CDATA[>
</code>
<code name='Incoming Message (first 100)' xpos='200' ypos='750' >
<![CDATA[  Do request.Stream.Rewind()
  Set context.ClaimData=""
  While (request.Stream.AtEnd = 0) {
    Set context.ClaimData=context.ClaimData_request.Stream.Read(1)  
  }
   $$$TRACE("Incoming Claim Data (first 100):"_$EXTRACT(context.ClaimData,1,100))
]]]]><![CDATA[>
</code>
<code name='Outgoing filename and path' xpos='200' ypos='850' >
<annotation><![CDATA[Derive the outgoing filename; the same filename needs to go to the R1 outbounds and to Edifecs for Transaction Management]]]]><![CDATA[></annotation>
<![CDATA[  //Get the incoming filename
  
  //Separate the filename from the path
  SET inputfilename=$PIECE(request.OriginalFilename,"/",*)
  
  $$$TRACE("inputfilename="_inputfilename)
  
   if ($FIND(inputfilename,"_")>0) // If there are underscores in the input file name
  {
  
     SET facilitycode = $PIECE(inputfilename,"_")
     $$$TRACE("facilitycode ="_facilitycode)
  
     SET transactiontype = $PIECE(inputfilename,"_",2)
     SET transactiontype = $EXTRACT(transactiontype,3,*)
     
     IF transactiontype="837P"
      {
        SET transactiontype="837P01D"
      }
      ELSEIF transactiontype="837I"
      {
        SET transactiontype="83701D"
      }
     ELSE
      {
         SET status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Transaction Type could not be derived from incoming filename. Please verify and correct the input file name as per expected standards and reprocess the file.")
      }

     $$$TRACE("transactiontype="_transactiontype)
     
     //We want the year included in the outgoing file name, even though it is not included in the incoming file name
     SET currentyear=$EXTRACT($ZDATETIME($NOW(),8),0,4)
     $$$TRACE("currentyear="_currentyear)
     
     SET datefromfilename=$PIECE(inputfilename,"_",3)
     SET inputfiledate=currentyear_datefromfilename
     $$$TRACE("inputfiledate="_inputfiledate)
     
     SET uniqueID=$EXTRACT($PIECE(inputfilename,"_",4),1,5)
     $$$TRACE("uniqueID="_uniqueID)
     
     SET context.facilitycode=$PIECE(inputfilename,"_",1)
     $$$TRACE("context.facilitycode="_context.facilitycode)
     
     SET context.destinationFilename =  inputfiledate_".A"_facilitycode_"."_transactiontype_"."_uniqueID_".ISERIES.TXT"
     $$$TRACE("context.destinationFilename="_context.destinationFilename)

     SET context.destinationFilepath="A"_facilitycode_"/"_transactiontype_"/A"_facilitycode_"/"
     $$$TRACE("context.destinationFilepath="_context.destinationFilepath)
   
  }
  //if the incoming filename does NOT contain an underscore
  ELSE
  {
      SET status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Input 837 X12 file received from iSeries has invalid file name . Please verify and correct the input file name as per expected standards and reprocess the file.")
  }
]]]]><![CDATA[>
</code>
<code name='Store the message' xpos='200' ypos='950' >
<annotation><![CDATA[We need to copy the incoming data to the outgoing request object so we can send along the new filename.]]]]><![CDATA[></annotation>
<![CDATA[ //Create a global stream to persist file content
	set stream=##class(%Stream.GlobalCharacter).%New()

	Set status= stream.CopyFromAndSave(request.Stream)
	
	if $$$ISERR(status)
	{
	   $$$TRACE("Skip message, stream copy failed")
	   set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Skip the record.")
	   Quit
	}

	$$$TRACE(request.OriginalFilename_" (ID "_request.%Id()_") has been successfully saved to database. Stream OID is "_stream.%Oid()_"; Stream ID is "_stream.%Id()_".")
	
	set context.response=##class(IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath).%New(stream)
	
	SET context.response.InputSource = "iSeries"
	$$$TRACE("context.response.InputSource="_context.response.InputSource)
	SET context.response.SenderID = "INTERMOUNTAIN"
	$$$TRACE("context.response.SenderID="_context.response.SenderID)
	SET context.response.ReceiverID = "CIRIUS"
	$$$TRACE("context.response.ReceiverID="_context.response.ReceiverID)
	SET context.response.FacilityCode= context.facilitycode
	$$$TRACE("context.response.FacilityCode="_context.response.FacilityCode)
	SET context.response.DestinationFilePath = context.destinationFilepath
	$$$TRACE("context.response.DestinationFilePath="_context.response.DestinationFilePath)
	SET context.response.DestinationFileName = context.destinationFilename
	$$$TRACE("context.response.DestinationFileName="_context.response.DestinationFileName)
	SET context.response.SourceFileName = $PIECE(request.OriginalFilename,"/",*)
	$$$TRACE("context.response.SourceFileName="_context.response.SourceFileName)
	
	  
	]]]]><![CDATA[>
</code>
<trace name='Sending to targets' value='"Sending to targets..."' xpos='200' ypos='1050' />
<foreach name='Send to each target' property='context.targetList' key='context.targetConfigIndex' xpos='200' ypos='1150' xend='200' yend='350' >
<call name='Send to TargetConfigNames' target='@context.targetList.GetAt(context.targetConfigIndex)' async='1' xpos='200' ypos='250' >
<request type='IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath' >
<assign property="callrequest" value="context.response" action="set" />
</request>
</call>
</foreach>
<code name='RESETERROR' xpos='200' ypos='1250' >
<![CDATA[  Do ##class(IHC.ITF.ITFCOMMON.Utility).ResetError(process.%ConfigName)
]]]]><![CDATA[>
</code>
<faulthandlers>
<catchall name='CATCH ALL' xpos='200' ypos='1350' xend='200' yend='250' />
</faulthandlers>
</scope>
</sequence>
</process>
]]></Data>
</XData>
