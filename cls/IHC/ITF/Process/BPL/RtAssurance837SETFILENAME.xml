           Set context.storeX12.streamContainer.Stream = ##class(%Stream.GlobalCharacter).%New()
           Set tSC2 = context.storeX12.streamContainer.Stream.CopyFromAndSave(request.streamContainer.Stream)
           
           Set context.storeX12.fileName = inputfilename     
           Set context.storeX12.destinationFileName = context.destinationfilename
           $$$TRACE("context.storeX12.destinationFileName: " _ context.storeX12.destinationFileName )
           Set context.storeX12.status = "Processed"
