<code name='Derive the outgoing filename' xpos='1550' ypos='1200' >
<annotation><![CDATA[Derive the outgoing filename; the same filename needs to go to the R1 outbounds and to Edifecs for Transaction Management]]]]><![CDATA[></annotation>
<![CDATA[  //Get the incoming filename
  
  //Separate the filename from the path
  SET inputfilename=$PIECE(request.OriginalFilename,"/",*)
  
  $$$TRACE("inputfilename="_inputfilename)
  
  if ($FIND(inputfilename,"_")>0) // If there are underscores in the input file name
  {
     SET context.facilitycode = $PIECE(inputfilename,"_")
     SET context.facilitycode = $EXTRACT(context.facilitycode,1,*-4)
     $$$TRACE("context.facilitycode="_context.facilitycode)
  
     SET transactiontype = $EXTRACT($PIECE(inputfilename,"_"),*-3,*) 
     IF (transactiontype="837P") ! (transactiontype="837p")
     {
       SET context.transactiontype="837P01D"
       $$$TRACE("context.transactiontype="_context.transactiontype)
     }
     ELSEIF (transactiontype="837I") ! (transactiontype="837i")
     {
        SET context.transactiontype="83701D"
        $$$TRACE("context.transactiontype="_context.transactiontype)
     }
     ELSE
     {
       SET status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Transaction Type could not be derived from incoming filename. Please verify and correct the input file name as per expected standards and reprocess the file.")
     }
    
   SET inputfiledate=$PIECE(inputfilename,"_",2)
   $$$TRACE("inputfiledate="_inputfiledate)
     
   SET uniqueId=$PIECE(inputfilename,"_",3)
   $$$TRACE("uniqueId(including extension)="_uniqueId) 
   
   //Lookup Facility Code Rep from IHC.ITF.Process.Bpl.RtGeneric837SETFILENAME.Lookup.R1FacilityCodes for R1 Prescrubbed Claims     
   if context.facilitycode'= "PENDING"
   {
      
      $$$TRACE("Calling the Lookup tables to retrieve FacilityCode from R1FacilityCodes "_context.facilitycode_ "...")
      //set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.R1-837-Filename-X12PRESCRUB.Lookup.R1FacilityCodes", context.facilitycode, .retVal )
      set retStat= ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup("IHC.ITF.Process.Bpl.RtGeneric837SETFILENAME.Lookup.R1FacilityCodes", context.facilitycode, .retVal )

      $$$TRACE(" Returned FacilityCode Rep from Lookup table: " _ retVal)
      Set context.facilitycoderep = retVal
      if ($$$ISERR(retStat) || (retVal = "Unknown") || (retVal ="")) {       
          $$$TRACE("Unable to get Facility Code Rep value from the lookup table. Getting the default value.")
          set context.facilitycoderep = "A154"
      }    
      else {
          $$$TRACE("Value of Facility Code Rep from the lookup table :" _ context.facilitycoderep)
      }
   }
   
   $$$TRACE("context.facilitycoderep="_context.facilitycoderep)
   
   SET context.destinationfilename=inputfiledate_"."_context.facilitycoderep_"."_context.transactiontype_"."_uniqueId_".ICENTRA.TXT"


   $$$TRACE("context.destinationfilename="_context.destinationfilename)
   
   
   }
  //if the incoming filename does NOT contain an underscore
   ELSE
   {
      SET status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Input 837 X12 file received from iCentra does not contain underscores. Please verify and correct the input file name as per expected standards and reprocess the file.")
 }]]]]><![CDATA[>
</code>
