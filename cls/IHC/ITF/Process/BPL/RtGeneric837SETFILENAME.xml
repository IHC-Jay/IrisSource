<![CDATA[  Do request.Stream.Rewind()
  Set context.ClaimData=""
  While (request.Stream.AtEnd = 0) {
    Set context.ClaimData=context.ClaimData_request.Stream.Read(1)  
  }
  
  set ISAsegment = $EXTRACT(context.ClaimData,1,106)
  $$$TRACE("Incoming Claim Data (ISA Segment): "_ISAsegment)
  
  Set segmentDelimiter = $EXTRACT(ISAsegment,106)
  $$$TRACE("segmentDelimiter: "_segmentDelimiter)
   
  Set elementDelimiter = $EXTRACT(ISAsegment,104)
  $$$TRACE("elementDelimiter: "_elementDelimiter)

  Set GSSegment = $PIECE(context.ClaimData,segmentDelimiter,2)
  $$$TRACE("GS Segment: "_GSSegment)

  Set GS08 = $PIECE(GSSegment,elementDelimiter,9)
  $$$TRACE("GS08: "_GS08)]]]]><![CDATA[>
</code>
<code name='Derive Transaction Type' xpos='1010' ypos='1250' >
<![CDATA[ //We need to derive the transactionType
  //837p GS 08 has version number ending in 222 whereas 837i has 223
  
  set context.transactiontype="PENDING"
  if ($EXTRACT(GS08,*-4,*-2)="222")
  {
     set context.transactiontype="837P01D"
  }

  if ($EXTRACT(GS08,*-4,*-2)="223")
  {
     set context.transactiontype="83701D"
  }

  if (context.transactiontype="PENDING")
  {
     set context.transactiontype="BAD_DATA"
     //set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "GS08 is not producing a correct transaction type!")
     // Skip the record.
    set status = ##class(IHC.ITF.ITFCOMMON.Utility).CheckError(context.configName, "GS08 is not producing a correct transaction type!")
  }
  
  
 $$$TRACE("context.transactiontype: "_context.transactiontype)]]]]><![CDATA[>
