<code name='Route' xpos='200' ypos='850' >
<![CDATA[ set routeArr=##class(%ArrayOfDataTypes).%New()
 
 	 do routeArr.SetAt( "Telcor", "isTelcor835")
	 do routeArr.SetAt("Telcor", "isTelcorCLIN835")
	 do routeArr.SetAt("Telcor", "isTelcorGenomics835")
	 						 	 					 		 
	 do routeArr.SetAt("Cern", "ICENTRACPA") 
	 do routeArr.SetAt("Cern", "ICENTRACPM") 
	 do routeArr.SetAt("Cern", "isCerner835")
	 
	 do routeArr.SetAt( "NetSmart", "Homecare")					 		 
	 do routeArr.SetAt( "CprPlus", "isCprPlus835")
	 do routeArr.SetAt( "Myriad", "is835ForMyriad")
	 
 
	 
  	if (context.destArr.Count() = 0)
	 {
		 $$$TRACE( " ***** NO Route ***** " )
	 }
	 else
	 {
	 
	   set key="", rNum =1
	   for  {
		 set value=context.destArr.GetNext(.key)  quit:key="" 
		 set dest = routeArr.GetAt(value)
		 if (dest '= "")
		 {
		       set stream=##class(%Stream.GlobalCharacter).%New()
		       
		       if (request.%Extends("Ens.StreamContainer") )
		       {
		          Set status= stream.CopyFromAndSave(request.Stream)
		       }
		       else
		       {
		          Set tSC = request.OutputToLibraryStream(stream)
		       }
		       
                       set pResponse=##class(Ens.StreamContainer).%New(stream)
                       set pResponse.OriginalFilename = dest _"-File-FromCirius.x12"
                       
		       if (dest = "Myriad")
                       {
                        // Send to Myriad
                   
                          Set tSC1=process.SendRequestAsync("Myriad-File-ENCRYPT", pResponse)
                          $$$TRACE("Send Async Incoming Stream to Process: Myriad-File-ENCRYPT, status: " _ tSC1 )
 
                       }
                       else
                       {
                       
		              set comp = "Out-" _ dest _  "-835-Sftp-REMITRCO-X12"
		              Set tSC1=process.SendRequestAsync(comp, pResponse)		              
		       }
		       $$$TRACE( "Send to  Route # " _ rNum _ ", = " _ dest _", " _ tSC1 )
		 }
		 else
		 {
		    $$$TRACE("Component not found for " _ value _" from routeArr")
		 }
		 Do $INCREMENT(rNum)
	   }
	 }]]]]><![CDATA[>
</code>
