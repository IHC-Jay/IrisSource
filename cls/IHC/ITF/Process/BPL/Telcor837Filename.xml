<code name='Incoming Message (first 100)' xpos='200' ypos='450' >
<![CDATA[  Do request.Stream.Rewind()
  Set context.ClaimData=""
  While (request.Stream.AtEnd = 0) {
    Set context.ClaimData=context.ClaimData_request.Stream.Read(1)  
  }
   $$$TRACE("Incoming Claim Data (first 100):"_$EXTRACT(context.ClaimData,1,100))
]]]]><![CDATA[>
