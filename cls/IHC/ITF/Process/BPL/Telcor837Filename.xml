<code name='Check ReplyCodeActions' xpos='200' ypos='550' >
<annotation><![CDATA[From settings tab]]]]><![CDATA[></annotation>
<![CDATA[  set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }]]]]><![CDATA[>
</code>
<code name='Trace MaxError and get Target Config Names' xpos='200' ypos='650' >
<annotation><![CDATA[Trace MaxError and get Target Config Names]]]]><![CDATA[></annotation>
<![CDATA[ set maxErr = ##class(IHC.ITF.ITFCOMMON.Utility).GetMaxError(process.%ConfigName)
 
 
 $$$TRACE("Max Errors: " _ maxErr)
   //Read TargetConfigNames
 set configValue = "" 
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetConfigNames",.configValue)

 if ( ($$$ISERR(pstatus)) || (configValue = "") )
 {
   set status=##class(IHC.ITF.ITFCOMMON.Utility).InitializationError(process.%ConfigName, "Initialization error, No TargetConfigNames found!")
 }else{
      $$$TRACE("TargetConfigNames: " _configValue )
 }
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Process.ItfBusinessProcessBPL).GetTargetConfigNames(process.%ConfigName, context.targetList) 
    $$$TRACE("TargetConfigNames: " _context.targetList)
    $$$TRACE("Count: " _ context.targetList.Count())
   ]]]]><![CDATA[>
</code>
<code name='Derive the outgoing filename' xpos='200' ypos='750' >
<annotation><![CDATA[Derive the outgoing filename; the same filename needs to go to the R1 outbounds and to Edifecs for Transaction Management]]]]><![CDATA[></annotation>
<![CDATA[  //Get the incoming filename
  
  //Separate the filename from the path
  SET inputfilename=$PIECE(request.OriginalFilename,"/",*)
  
  $$$TRACE("inputfilename="_inputfilename)
  
  if ($FIND(inputfilename,"_")>0) // If there are underscores in the input file name
  {
     //Derive the file date from the incoming filename
     SET inputfiledate=$EXTRACT($PIECE(inputfilename,"_",4,99),1,8)
     $$$TRACE("inputfiledate="_inputfiledate)
     
     //Derive the uniqueID from the incoming filename
     SET uniqueID=$PIECE(inputfilename,"_",2)
     $$$TRACE("uniqueID="_uniqueID)
     

     SET context.destinationFilename = inputfiledate_".A153.837P01D."_uniqueID_".TXT"
     $$$TRACE("destinationFilename="_context.destinationFilename)
     
  }
  //if the incoming filename does NOT contain an underscore
  else
  {
     set status=##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName, "Input 837 X12 file received from Telcor has invalid file name . Please verify and correct the input file name as per expected standards and reprocess the file.")
  }
]]]]><![CDATA[>
</code>
<code name='Read the outgoing filepath' xpos='200' ypos='850' >
<![CDATA[ 
 set destinationFilepath = ##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","DestinationFilePath",.pstatus)
 if ($$$ISOK(pstatus)){
	 set context.destinationFilepath = destinationFilepath
 	$$$TRACE("context.destinationFilepath " _ context.destinationFilepath)
 }else{
    Set status = $$$ERROR("Initialization error, No DestinationFilePath found! Set the DestinationFilePath setting.")	 
 } ]]]]><![CDATA[>
</code>
<code name='Store the message' xpos='200' ypos='950' >
<annotation><![CDATA[We need to copy the incoming data to the outgoing request object so we can send along the new filename.]]]]><![CDATA[></annotation>
<![CDATA[ //Create a global stream to persist file content
	set stream=##class(%Stream.GlobalCharacter).%New()

	Set status= stream.CopyFromAndSave(request.Stream)
	
	if $$$ISERR(status)
	{
	   $$$TRACE("Skip message, stream copy failed")
	   set status = ##class(IHC.ITF.ITFCOMMON.Utility).SkipMsgError(process.%ConfigName, "Skip the record.")
	   Quit
	}

	$$$TRACE(request.OriginalFilename_" (ID "_request.%Id()_") has been successfully saved to database. Stream OID is "_stream.%Oid()_"; Stream ID is "_stream.%Id()_".")
	set context.response=##class(IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath).%New(stream)
	
	//set context.NewFilePath = $PIECE(request.OriginalFilename, "/",*-1)
	
	//set context.response.OriginalFilename = request.OriginalFilename
	//SET context.response.NewFilePath = context.destinationfilepath
	//SET context.response.NewFileName = context.destinationfilename
	
	SET context.response.DestinationFilePath = context.destinationFilepath
	$$$TRACE("context.response.DestinationFilePath="_context.response.DestinationFilePath)
	SET context.response.DestinationFileName = context.destinationFilename
	$$$TRACE("context.response.DestinationFileName="_context.response.DestinationFileName)
	SET context.response.SourceFileName = $PIECE(request.OriginalFilename,"/",*)
	$$$TRACE("context.response.SourceFileName="_context.response.SourceFileName)]]]]><![CDATA[>
