<call name='Send to TargetConfigNames' target='@context.targetList.GetAt(context.targetConfigIndex)' async='1' xpos='200' ypos='350' >
<request type='IHC.ITF.Provider.DStruc.Record.StreamContainerWithFilepath' >
<assign property="callrequest" value="context.response" action="set" />
</request>
