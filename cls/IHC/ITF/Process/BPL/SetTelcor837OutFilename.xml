<Data><![CDATA[
<process language='objectscript' request='Ens.Request' response='Ens.Response' height='2000' width='2000' >
<context>
<property name='Filename' type='%String' instantiate='0' >
<parameters>
<parameter name='MAXLEN'  value='250' />
</parameters>
</property>
<property name='newStreamContainer' type='Ens.StreamContainer' instantiate='0' />
</context>
<sequence xend='200' yend='1000' >
<scope xpos='200' ypos='250' xend='200' yend='900' >
<trace name='Enter BPL' value='"Entering BPL: " _ $CLASSNAME() _ ", Process: " _ process.%ConfigName' xpos='200' ypos='350' />
<code name='Check ReplyCodeActions' xpos='200' ypos='450' >
<![CDATA[ set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"ReplyCodeActions",.configValue)
 
 if ( ($$$ISERR(pstatus)) || (configValue = ""))
 {
 	Set status = $$$ERROR("Initialization error, No ReplyCodeActions found")
 }]]]]><![CDATA[>
</code>
<code name='Set new file name ' xpos='200' ypos='550' >
<![CDATA[
 set stream=##class(%Stream.GlobalCharacter).%New()
 do stream.Write(request.Message)
 
 set context.Filename = $REPLACE(request.Properties.GetAt("destination_filename"),"(N/A)","") 
 
 
 $$$TRACE("Filename : "_ context.Filename _ " Size : " _ stream.Size) 
 
 if (context.Filename '= "")
 {
    set context.newStreamContainer=##class(Ens.StreamContainer).%New(request.Message)
    set context.newStreamContainer.OriginalFilename = context.Filename
 }
 else
 {
   $$$TRACE("Missing Property destination_filename on input file")
   Set status =  ##class(IHC.ITF.ITFCOMMON.Utility).InputDataError(process.%ConfigName," Missing Property destination_filename on input file. Please verify Edifecs routes")	 
 } 
 	
  
                        
                          
  

                          

 
  


 
 
   

	

                          
 

 
]]]]><![CDATA[>
</code>
<call name='Send to destination' target='Out-Assurance-837-File-TOAGENT' async='1' xpos='200' ypos='650' >
<request type='Ens.Request' >
<assign property="callrequest" value="context.newStreamContainer" action="set" />
</request>
<response type='Ens.Response' />
</call>
<faulthandlers>
<catchall name='Catch All' xpos='200' ypos='750' xend='200' yend='250' />
</faulthandlers>
