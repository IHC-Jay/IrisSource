<code name='Send to target' xpos='200' ypos='750' >
<![CDATA[ if (context.targetConfigNames = "")
 {
    Set status = $$$ERROR("Initialization error, No TargetConfigNames found")
 }
   
    set stream=##class(%Stream.GlobalCharacter).%New()

    
    if (request.%ClassName() = "StreamContainer")
    {
        Set tSC = stream.CopyFrom(request.Stream)
    }
    elseif (request.%ClassName() = "EnsLib.EDI.X12.Document")
    {
       Set tSC =request.OutputToLibraryStream(stream)
    }
    else
    {
       set tSC = $$$ERROR("Invalid inbound message")
    }
    If $$$ISOK(tSC) {
    
      set newStreamContainer =##class(Ens.StreamContainer).%New(stream)
      set newStreamContainer.OriginalFilename = request.OriginalFilename
    
      For iTarget=1:1:$L(context.targetConfigNames, ",") 
      {
	 Set tOneTarget=$ZStrip($P(context.targetConfigNames,",",iTarget),"<>W")  Continue:""=tOneTarget
	 Set tSC1=process.SendRequestAsync(tOneTarget, newStreamContainer)
	 $$$TRACE("Send Async Incoming X12 message to Process: " _ tOneTarget _ " in targetConfigNames, status: " _ tSC1 )
			
      }
    }]]]]><![CDATA[>
