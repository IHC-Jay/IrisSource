  if (request.%ClassName() = "StoreX12")
  {
     $$$TRACE("Store: " _ request.streamContainer.OriginalFilename _ ", Stream of size: " _ request.streamContainer.Stream.Size _", status: " _ request.status)
     Do ##class(IHC.ITF.ITFCOMMON.X12.StoreEdiX12Data).ProcessStream(request.streamContainer.Stream, request.streamContainer.OriginalFilename, request.status, request.createDtTm)
  }
  elseif (request.%ClassName() = "StreamContainer")
  {
     $$$TRACE("Store StreamContainer: " _ request.OriginalFilename _ ", Stream of size: " _ request.Stream.Size)
     Do ##class(IHC.ITF.ITFCOMMON.X12.StoreEdiX12Data).ProcessStreamContainer(request)
  }
  elseif (request.%ClassName() [ "x12MessageReq") // CORERULES message
  {
     $$$TRACE("Store x12MessageReq  : " _ request.pTransactionFileName_ ", Inbound X12 size: " _ $L(request.Payload) )
     set inpId = ##class(IHC.ITF.ITFCOMMON.X12.StoreEdiX12Data).ProcessX12String(request.Payload, request.pTransactionFileName, "Processed", request.TimeStamp, "Inbound")
     set respId = ##class(IHC.ITF.ITFCOMMON.X12.StoreEdiX12Data).ProcessX12String(request.RespPayload, request.pTransactionFileName, "Processed", request.RespTimeStamp, "Outbound")
     $$$TRACE("X12 IDs: " _ inpId _", " _ respId)
  }
  else
  {
   $$$TRACE("Process X12 Stream: " _ ##class(%File).GetFilename(request.Source) _", " _ request.%ClassName())
   Do ##class(IHC.ITF.ITFCOMMON.X12.StoreEdiX12Data).ProcessX12Doc(request)
  }
 $$$TRACE("Processed X12Doc data")]]]]><![CDATA[>
