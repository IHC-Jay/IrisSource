 set context.ReconcilerFiling.MyProp.GetAt(8).Value = context.dtTm 
 set context.ReconcilerFiling.MyProp.GetAt(9).Value = context.dtTm
 set context.ReconcilerFiling.MyProp.GetAt(10).Value = context.dtTm
 
 // MessageContent - XML message
  $$$TRACE("Set MessageContent  to xmlContent")
  set context.ReconcilerFiling.MyProp.GetAt(11).Value = context.xmlContent 
