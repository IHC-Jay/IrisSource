 // MessageType
 
 set context.ReconcilerFiling.MyProp.GetAt(6).Value = "Allscripts.CIE.InterfaceError.InterfaceErrorReceivedEvent, Allscripts.CIE.InterfaceError, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
 
  
 $$$TRACE("Created structure: ReconcilerFiling for " _ context.ReconcilerFiling.ProcName)
 // MessageStatus
