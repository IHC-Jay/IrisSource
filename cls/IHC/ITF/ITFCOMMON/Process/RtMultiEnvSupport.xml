 set context.dfdTargetConfigName=##class(Ens.Director).GetItemSettingValue(process.%ConfigName,"Host","DFDTargetConfigName",.pstatus)
 if ($$$ISOK(pstatus) &&(context.dfdTargetConfigName '="")){
