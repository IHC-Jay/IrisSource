<code name='Check LastNamesMatch' xpos='200' ypos='1050' >
<annotation><![CDATA[Get LastNamesMatch from settings]]]]><![CDATA[></annotation>
<![CDATA[
 //LastNamesMatch validation
 set pid5LastName=request.GetValueAt(lastNameHl7Structure) 
 $$$TRACE("lastNameinPID5.1: " _ pid5LastName)  
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"LastNamesMatch",.LastNamesMatch) 
 set listLastNamesMatch = $LISTFROMSTRING(LastNamesMatch, ",")
 set lenListLastNamesMatch = $LISTLENGTH(listLastNamesMatch)  
 if ($$$ISOK(pstatus)&&(LastNamesMatch '="")){    	
    	$$$TRACE("LastNamesMatch: ["_LastNamesMatch_"]")
    	$$$TRACE("pid5LastName: ["_pid5LastName_"]")    
    	For i=1:1:lenListLastNamesMatch {
	    	Set piece = $List(listLastNamesMatch,i)
	    	if (pid5LastName [ piece) {	 
	    	  $$$TRACE(piece _" LastNamematch contains in the last name ["_pid5LastName_"]")       		 
	     	  set context.bridgeToDFD = "1"    	    		 
	    	}
    	}	    	
	    if (context.bridgeToDFD = "1") {	     	    		 
    		$$$TRACE("Contains  LastNamesMatch ["_LastNamesMatch_"]")       		 
	     	//set context.bridgeToDFD = "1"
        }else{
	        $$$TRACE("Does NOT Contain  LastNamesMatch ["_LastNamesMatch_"]")    
	        set qstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"LastNamesExtAddOrRemove",.lastNamesExtAddOrRemove) 
	        if ($$$ISOK(qstatus)&&(lastNamesExtAddOrRemove '="")){  
	           	$$$TRACE("LastNamesExtAddOrRemove: ["_lastNamesExtAddOrRemove_"]")
	        	set listLastNamesExtAddOrRemove = $LISTFROMSTRING(lastNamesExtAddOrRemove, ",")
 				set lenLastNamesExtAddOrRemove = $LISTLENGTH(listLastNamesExtAddOrRemove)
 			    set extToAddOrRemove = ""
 				For i=1:1:lenLastNamesExtAddOrRemove {
	    			Set piece = $List(listLastNamesExtAddOrRemove,i)
	    			if (pid5LastName [ piece) {	 
	    	  			$$$TRACE(piece _" LastNamesExtAddOrRemove contains in the last name ["_pid5LastName_"]")       		 
	     	  			set context.bridgeToDFD = "0"   
	     	  			set extToAddOrRemove = piece 	    		 
	    			}
    			}
	           if (context.bridgeToDFD ="0") {	
	               $$$TRACE("LastNamesExtAddOrRemove: ["_extToAddOrRemove_"] is in last name "_pid5LastName)	               
	        	   set lenLastName = $L(pid5LastName)
	        	   set lenExtToAddOrRemove = $L(extToAddOrRemove)	        	   
	               if (context.addExtFlag = 1){
			          set lastName = pid5LastName_extToAddOrRemove
			          $$$TRACE("Updated LastName["_lastName_"].")
		        	   set context.updatedPayload = request.%ConstructClone(1)
		    		   Do context.updatedPayload.SetValueAt(lastName, lastNameHl7Structure)  
		    		   $$$TRACE("context.updatedPayload --> "_context.updatedPayload.RawContent)  
			       }else{
				       $$$TRACE(" ExtractLastName: "_$E(pid5LastName,lenLastName-lenExtToAddOrRemove+1,lenLastName))
				       if ($E(pid5LastName,lenLastName-lenExtToAddOrRemove+1,lenLastName)=extToAddOrRemove){
		        		 set lastName = $E(pid5LastName,1,lenLastName-lenExtToAddOrRemove)
		        		 $$$TRACE("Updated LastName["_lastName_"].")
		        	     set context.updatedPayload = request.%ConstructClone(1)
		    		     Do context.updatedPayload.SetValueAt(lastName, lastNameHl7Structure)  
		    		      $$$TRACE("context.updatedPayload --> "_context.updatedPayload.RawContent)  		        	
				       }else{
			    	   		$$$TRACE(" No -D in the LastName: ["_pid5LastName_"]")
			    	   		set context.updatedPayload = request.%ConstructClone(1) 
			    	   		$$$TRACE("context.updatedPayload --> "_context.updatedPayload.RawContent)
			       		}		
			       }      		
	           }else{
		           $$$TRACE("LastNamesExtAddOrRemove: ["_lastNamesExtAddOrRemove_"] is NOT in last name "_pid5LastName)
		           $$$TRACE(" No -D in the LastName: ["_pid5LastName_"]")
			       set context.updatedPayload = request.%ConstructClone(1) 
			       $$$TRACE("context.updatedPayload --> "_context.updatedPayload.RawContent)
		       }  	
	        }	        
		}
 	 } 
 $$$TRACE("bridgeToDFD--> " _ context.bridgeToDFD) 
 ]]]]><![CDATA[>
