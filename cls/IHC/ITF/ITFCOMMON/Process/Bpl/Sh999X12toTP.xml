 $$$TRACE("Process FILE: " _ request.OutputFolder _", Inbound X12 Document length: " _ context.inXmlDoc.FullSize )
  

  
  //tp lookup for 999 
  
   set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"TargetAcksLookupTable",.configValue)
    $$$TRACE( " Routing TP:" _ configValue)
   
   
  if ( ($$$ISERR(pstatus)) || (configValue = "") || (configValue [ "None") || ($zconvert(configValue, "u") [ "BITBUCKET"))
 {
 	$$$LOGWARNING("TargetAcksLookup table is not found to send X12" )
 	
 }
 else
 {
    set context.TargetAcksLookupTable = configValue 
     
    try
    {
      set compList = ""
      
      set statlook = ##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.TargetAcksLookupTable, request.OutputFolder , .compList) 
      //$$$TRACE( "statlook :" _ statlook)
      //$$$TRACE( " Routing complist TP:" _ compList)
      
      //$$$TRACE("context.tpLinkObj.Routing:" _ context.tpLinkObj.Routing  - ": Flags from: " _ context.TargetAcksLookupTable)
       
      if (compList '= "") 
      {
        
         $$$TRACE("Entered Try-catch")  
        set x12StCon = ##class(Ens.StreamContainer).%New()
        set x12StCon.Stream = ##class(%Stream.GlobalCharacter).%New()
        Do request.Stream.Rewind()
        $$$TRACE("request.Stream OREF=" _ $IsObject(request.Stream))
        $$$TRACE("x12StCon.Stream OREF=" _ $IsObject(x12StCon.Stream))
        Set tSC = x12StCon.Stream.CopyFrom(request.Stream)
        $$$TRACE("AFx12StCon.Stream OREF=" _ $IsObject(x12StCon.Stream))
        $$$TRACE("AFx12StCon.Stream.Size=" _ x12StCon.Stream.Size)
        $$$TRACE("Content=" _ x12StCon.Stream.Read(200))
        
        set x12StCon.OriginalFilename = context.FileName
        //$$$TRACE("File contents:" _ x12StCon.streamContainer.Stream.Read())
        
		if ((compList '= "") && '($zconvert(compList, "u") [ "BITBUCKET"))  // NEEDS TO BE UPDATED
	     	{
			$$$TRACE("Entered Try-catch-IF")  
			//$$$TRACE( "  x12StCon: " _ x12StCon.Stream)
			//$$$TRACE( "  x12StCon-request: " _ request.Stream)
			Set tSC1=process.SendRequestSync(compList, x12StCon)
			//Set tSC1=process.SendRequestAsync(compList, x12StCon)
			$$$TRACE("Send Sync Outgoing message to: " _ compList_ ", status: " _ tSC1)
			$$$TRACE("Leaving Try-catch-IF")  
	     	}
		    

      }
      else
      {
         $$$LOGERROR("Value not found in Lookup table: " _ context.TargetAcksLookupTable _ " for value: " _ request.OutputFolder)
      }
