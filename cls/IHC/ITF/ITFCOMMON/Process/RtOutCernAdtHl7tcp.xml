<code name='Check LastNamesMatch' xpos='200' ypos='1450' >
<annotation><![CDATA[Get LastNamesMatch from settings]]]]><![CDATA[></annotation>
<![CDATA[
 //LastNamesMatch validation
 set pid5LastName=request.GetValueAt("PID:5(1).1.1") 
 $$$TRACE("lastNameinPID5.1: " _ pid5LastName)  
 set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).GetItemSettingValue(process.%ConfigName,"LastNamesMatch",.LastNamesMatch) 
 if ($$$ISOK(pstatus)&&(LastNamesMatch '="")){    	
    	$$$TRACE("LastNames that has ["_LastNamesMatch_"] will be sent to DFD in QA Ensemble environment.")
    	if ($LISTFROMSTRING(LastNamesMatch,",")[ pid5LastName) {	     
