<assign value='source.list.(1).TimeStamp' property='target.TimeStamp' action='set' />
<assign value='context.dtTm' property='target.InterfaceError.MessageSource.ErrorDateTime' action='set' />
<assign value='"Ensemble"' property='target.Originator' action='set' >
<annotation>&quot;Ensemble&quot; / &quot;CIE&quot;</annotation>
</assign>
<assign value='"Received"' property='target.Verb' action='set' />
<assign value='"InterfaceError"' property='target.Noun' action='set' />
<assign value='"AccountID"' property='target.KeyedValues.(1).Key' action='set' />
<assign value='"00000000000000000000"' property='target.KeyedValues.(1).Value' action='set' />
<assign value='"ProductID"' property='target.KeyedValues.(2).Key' action='set' />
<assign value='"EEHR"' property='target.KeyedValues.(2).Value' action='set' />
<assign value='"DestinationID"' property='target.KeyedValues.(3).Key' action='set' />
<assign value='"AllScripts"' property='target.KeyedValues.(3).Value' action='set' />
<assign value='$PIECE(source.list.(1).StoredProcParamsCollection.ProcName, ".", *)' property='target.InterfaceError.MessageSource.StoredProcedure' action='set' />
<trace value='target.InterfaceError.MessageSource.StoredProcedure' />
<assign value='context.InterfaceSource' property='target.InterfaceError.MessageSource.InterfaceSource' action='set' />
<assign value='source.list.(1).InterfaceName' property='target.InterfaceError.MessageSource.InterfaceSourceName' action='set' />
<assign value='"0.0.0.0:0000"' property='target.InterfaceError.MessageSource.SourceConnection' action='set' />
<assign value='"&lt;![CDATA[" _ source.list.(1).SourceMessage _ "]]&gt;" ' property='target.InterfaceError.MessageSource.SourceMessage' action='set' >
<annotation>source.SourceMessage</annotation>
</assign>
<trace value='"Set SourceMessage with CDATA tag"' />
<foreach property='source.list()' key='k1' >
<trace value='"Set TargetErrors " _ k1' />
<assign value='source.list.(k1).ErrorCode' property='target.InterfaceError.TargetErrors.(k1).ErrorDescription' action='set' />
<assign value='source.list.(k1).ErrorCode' property='target.InterfaceError.TargetErrors.(k1).ErrorCode' action='set' />
<assign value='"1"' property='target.InterfaceError.TargetErrors.(k1).ErrorId' action='set' />
</foreach>
<assign value='$L(source.list.(1).SourceMessage)' property='SourceMessageLen' action='set' />
<trace value='"Set Source message for length: " _ SourceMessageLen' />
<code>
<![CDATA[ set numErr = source.list.Count()
 $$$TRACE("List of errors: " _ numErr)
 set errorCodes = ""
 for errIndex = 1:1:numErr   
 {
	 $$$TRACE("ProcParamsCollection Count: " _ source.list.GetAt(errIndex).StoredProcParamsCollection.MyProp.Count())
	 set MAXValues = source.list.GetAt(errIndex).StoredProcParamsCollection.MyProp.Count()
	 // $$$TRACE("TE: " _ target.InterfaceError.TargetErrors)
	 // $$$TRACE("TE 1: " _ target.InterfaceError.TargetErrors.GetAt(1))
	 // $$$TRACE("PL: " _ target.InterfaceError.TargetErrors.GetAt(1).ParameterList)
	 $$$TRACE("context.lookupTable: " _ context.lookupTable)
	 if (errIndex = 1)
	 {
	     set errorCodes= source.list.GetAt(errIndex).ErrorCode
	 }
	 else
	 {
	     set errorCodes= errorCodes _ "," _ source.list.GetAt(errIndex).ErrorCode
	 }
	 
	 set storedProcStr =""
	 
	 for ind = 1:1:MAXValues   
	 {
	        
		set nm = source.list.GetAt(errIndex).StoredProcParamsCollection.MyProp.GetAt(ind).Name
		set val = $ZSTRIP(source.list.GetAt(errIndex).StoredProcParamsCollection.MyProp.GetAt(ind).Value, "<>W")
		set val = $ZSTRIP(val,"*C")
		
		
		set par = ##class(Reconciler.Parameter).%New()
		set par.Name =  nm 
		
		set typ = source.list.GetAt(errIndex).StoredProcParamsCollection.MyProp.GetAt(ind).Type
		set par.DataType = typ
		if (typ = "datetime") {
			if ($L(val) = 10)
				{
						set val = val _ " 00:00:00:000"
				}
			elseif ($L(val) = 16)
				{
						set val = val _ ":00:000"
				}
			elseif ($L(val) = 19)
				{
						set val = val _ ":000"
				}
			
		}
		$$$TRACE( ind _ ": DTL set InterfaceError " _ nm _" to >" _ val _"<")
		
		if (($L(val) >= 1) || (val '= " "))
		{   
			
			set par.Value = "'" _ val _ "'"
		}
		else
		{
				 set par.Value = "''"
		}
		// <TargetErrors><TargetError><Message>
		if (ind = MAXValues)
		{
		   set storedProcStr = storedProcStr _  par.Value 
		}
		else
		{
		   set storedProcStr = storedProcStr _ par.Value _ ","
		}
		
		set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.lookupTable,nm, .retVal) 
		
		if ((retVal '="") && (retVal'="Unknown")){
			
			$$$TRACE("Value from " _ context.lookupTable _ " for key: " _ nm _ " from Lookup table:"_retVal)
			set par.WellKnownName = retVal
		}
		
		Set target.InterfaceError.TargetErrors.GetAt(errIndex).Message = storedProcStr 
		Do target.InterfaceError.TargetErrors.GetAt(errIndex).ParameterList.Insert(par)
		
	 }
	 $$$TRACE(errIndex _ ". # of TargetErrors: " _ target.InterfaceError.TargetErrors.Count())
	 $$$TRACE(errIndex _ ". # of ParameterList: " _ target.InterfaceError.TargetErrors.GetAt(errIndex).ParameterList.Count())
 }
 ]]]]><![CDATA[></code>
<trace value='"ErrorCodes: " _ errorCodes' />
<assign value='errorCodes' property='target.InterfaceError.MessageSource.ErrorCodes' action='set' />
<trace value='"DTL complete"' />
</transform>
]]></Data>
