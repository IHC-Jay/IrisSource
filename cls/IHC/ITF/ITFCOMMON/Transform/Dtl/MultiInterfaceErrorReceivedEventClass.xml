<Data><![CDATA[
<transform sourceClass='IHC.ITF.ITFCOMMON.DataStructure.MultiInterfaceErrorEvents' targetClass='IHC.ITF.ITFCOMMON.DataStructure.InterfaceErrorReceivedEvent' create='new' language='objectscript' >
<trace value='"In DTL"' />
