<DependsOn>Ens.AlertRequest,EnsLib.HTTP.GenericMessage</DependsOn>

<XData name="DTL">
<XMLNamespace>http://www.intersystems.com/dtl</XMLNamespace>
<Data><![CDATA[
<transform sourceClass='Ens.AlertRequest' targetClass='EnsLib.HTTP.GenericMessage' create='new' language='objectscript' >
<trace value='"IN ALERT DTL"' />
<code>
<![CDATA[  // Create APE object
   set apeInfo =##class(IHC.ITF.ITFCOMMON.ApeInformation).%New()
   set apeInfo.hostname = $SYSTEM.INetInfo.LocalHostName()
   set apeInfo.groupname = $NAMESPACE]]]]><![CDATA[></code>
<code>
<![CDATA[  SET sqlStmt = "SELECT MessageBodyId, MessageBodyClassName FROM Ens.MessageHeader " _
                " where Type = ? and TargetConfigName = ? and sessionId = ? "
    
    
  SET tStatement = ##class(%SQL.Statement).%New()
  SET qStatus = tStatement.%Prepare(sqlStmt)
  IF qStatus'=1 { 
     $$$LOGERROR("Error in preparing SQL: " _ sqlStmt _", error: " _ qStatus) 
  }
  else
  {
    SET rset = tStatement.%Execute(1, source.SourceConfigName, source.SessionId)
 
 
    if (rset.%SQLCODE = 0)
    {
  	WHILE rset.%Next() {
  	$$$LOGINFO( "Data: " _ rset.MessageBodyId _ ", type: " _ rset.MessageBodyClassName)
     		if ( rset.MessageBodyClassName = "EnsLib.HL7.Message" )
     		{
     			set tmpObject = ##class(EnsLib.HL7.Message).%OpenId(rset.MessageBodyId)
 			set apeInfo.inputData  = $EXTRACT( tmpObject.OutputToString(), 1, 2000)
     		}
     		elseif( rset.MessageBodyClassName = "Ens.StreamContainer" )
     		{
     		       set streamObj = ##class(Ens.StreamContainer).%OpenId(rset.MessageBodyId)
     			set apeInfo.inputData  = "OriginalFilename: " _ streamObj.OriginalFilename
     		}
     		elseif ( rset.MessageBodyClassName = "Ens.StringRequest" )
     		{
     		        set strReq = ##class(Ens.StringRequest).%OpenId(rset.MessageBodyId)
     			set apeInfo.inputData  = $EXTRACT(strReq.StringValue, 1, 2000)
     		}
     		elseif( rset.MessageBodyClassName = "Ens.StringContainer" )
     		{
     		        set strConReq = ##class(Ens.StringContainer).%OpenId(rset.MessageBodyId)
     			set apeInfo.inputData  = $EXTRACT(strConReq.StringValue, 1, 2000)
     		}
     		else
     		{
     		   set apeInfo.inputData  = "MessageBodyClassName: " _ rset.MessageBodyClassName _ ", MessageBodyId: " _ rset.MessageBodyId
     		}
     	    $$$LOGINFO("Copied Input message: " _ apeInfo.inputData)
     	    quit
  	}
  	Do rset.%Close()
   }
   else
   {
     $$$LOGERROR("Error in Execute: " _ rset.%SQLCODE)
     set apeInfo.inputData  = "Could not get input record for session: " _ source.SessionId _ " for component: " _ source.SourceConfigName
   }
  }]]]]><![CDATA[></code>
<code>
<![CDATA[ // create data stream
  set stream=##class(%Stream.GlobalBinary).%New()
 
   set apeInfo.comment = source.AlertDestination
   set apeInfo.messagedata = source.AlertText

   set apeInfo.msgtimestamp = source.AlertTime
   //":"2014-04-25 16:17:46.774"
  set apeInfo.msgtimestampformat = "yyyy-mm-dd hh24:mi:ss.ms"
   
   set apeInfo.processname = source.SourceConfigName
   set apeInfo.sessionId = source.SessionId
  
   // find sub error id
   set itfErr = "ITFCOMMON:"
   set ind = $FIND(source.AlertText, itfErr)
   if ind > 0
   {
    set ind2 = $FIND(source.AlertText, ":", ind)
    set apeInfo.issuecode = $EXTRACT(source.AlertText, ind - $L(itfErr), ind2 -2 )
    set emailMsg = "SendEmailSuccess|SendEmailError"
    set ind = $LOCATE(source.AlertText, emailMsg)
    if ind > 0
    {
    $$$TRACE("Send email message")
    set emailSub = "emailSubject:"
    set emailBody = "emailBody:"
    set ind2 = $FIND(source.AlertText, emailSub )
    set ind3 = $FIND(source.AlertText, emailBody )
        if (ind3 > ind2)
        {
            set apeInfo.emailSubject = $EXTRACT(source.AlertText, ind2, ind3 - ($L(emailBody) +1) )
            set apeInfo.emailBody = $EXTRACT(source.AlertText, ind3, *) 
        }
        else
        {
        set apeInfo.emailSubject = $EXTRACT(source.AlertText, ind2, *)
        }
        if (ind2 > 1)
        {
         set apeInfo.messagedata = $EXTRACT(source.AlertText, 1, ind2 - ($L(emailSub) +1))
         }
    }

   }
   else
   {
     // Intersystem error
     set intSysErr = "ERROR #"
     set ind = $FIND(source.AlertText, intSysErr )
     if ind > 0
     {
      set ind2 = $FIND(source.AlertText, ":", ind)
      set apeInfo.issuecode = $EXTRACT(source.AlertText, ind - $L(intSysErr), ind2 -2 )
     }
     else
     {
     	set intSysErr = "ERROR"
	set ind = $FIND(source.AlertText, intSysErr )
     	if ind > 0
     	{
      	 set ind2 = $FIND(source.AlertText, ":")
      	 if ind2 > 0
     	 {
      	  set apeInfo.issuecode = $EXTRACT(source.AlertText, ind - $LENGTH(intSysErr), ind2 - 2 )
     	  set apeInfo.issuecode = $REPLACE(apeInfo.issuecode, $CHAR(92) _ "u003c", "<")
          set apeInfo.issuecode = $REPLACE(apeInfo.issuecode, $CHAR(92) _"u003e", ">")
     	 }
     	 else
     	 {
     	   set apeInfo.issuecode = "Unknown"
     	 }
     	}
     	else
     	{
     	  set apeInfo.issuecode = "Unknown"
     	}

     }

   }
  
    do ##class(%ZEN.Auxiliary.jsonProvider).%WriteJSONStreamFromObject(stream,apeInfo)
  
  do target.HTTPHeaders.SetAt("application/json", "content-type")
  
    do target.HTTPHeaders.SetAt(stream.Size, "content-length")]]]]><![CDATA[></code>
<code>
<![CDATA[ Set str = stream.Read(,.sc)
 $$$LOGINFO("STRING: " _ str)
 $$$LOGINFO("STAT: " _ sc)]]]]><![CDATA[></code>
<trace value='"ALERT DTL DONE"' />
<assign value='stream' property='target.Stream' action='set' />
</transform>
]]></Data>
