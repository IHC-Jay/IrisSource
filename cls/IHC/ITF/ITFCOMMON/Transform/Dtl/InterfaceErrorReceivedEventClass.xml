<![CDATA[ $$$TRACE(source.StoredProcParamsCollection.MyProp.Count())
 set MAXValues = source.StoredProcParamsCollection.MyProp.Count()
 $$$TRACE("TE: " _ target.InterfaceError.TargetErrors)
