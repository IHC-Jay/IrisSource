    set nm = source.StoredProcParamsCollection.MyProp.GetAt(ind).Name
	set val = $ZSTRIP(source.StoredProcParamsCollection.MyProp.GetAt(ind).Value, "<>W")
	// set val = $ZSTRIP(val,"*C")
	
	
	set par = ##class(Reconciler.Parameter).%New()
	set par.Name =  nm 
	
	set typ = source.StoredProcParamsCollection.MyProp.GetAt(ind).Type
	set par.DataType = typ
	if (typ = "datetime") {
		if ($L(val) = 10)
          	{
                    set val = val _ " 00:00:00:000"
	        }
		elseif ($L(val) = 16)
	        {
                    set val = val _ ":00:000"
	        }
		elseif ($L(val) = 19)
	        {
                    set val = val _ ":000"
	        }
	    
	}
	$$$TRACE( ind _ ": DTL set InterfaceError " _ nm _" to >" _ val _"<")
	
	if (($L(val) >= 1) || (val '= " "))
	{   
	    
		set par.Value = "'" _ val _ "'"
	}
	else
	{
	         set par.Value = "''"
	}
	// <TargetErrors><TargetError><Message>
	if (ind = MAXValues)
	{
  	   set storedProcStr = storedProcStr _  par.Value 
	}
	else
	{
	   set storedProcStr = storedProcStr _ par.Value _ ","
	}
	
	set pstatus=##class(IHC.ITF.ITFCOMMON.Utility).ItfLookup(context.lookupTable,nm, .retVal) 
 	
 	if ((retVal '="") && (retVal'="Unknown")){
    	
		$$$TRACE("Value from " _ context.lookupTable _ " for key: " _ nm _ " from Lookup table:"_retVal)
		set par.WellKnownName = retVal
    }
    Do target.InterfaceError.TargetErrors.GetAt(1).ParameterList.Insert(par)
 }
 $$$TRACE("# of TargetErrors: " _ target.InterfaceError.TargetErrors.Count())
 $$$TRACE("# of ParameterList: " _ target.InterfaceError.TargetErrors.GetAt(1).ParameterList.Count())
 
 




