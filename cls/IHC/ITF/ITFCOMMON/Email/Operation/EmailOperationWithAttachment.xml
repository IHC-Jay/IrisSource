<?xml version="1.0" encoding="UTF-8"?>
<Export generator="IRIS" version="26">
<Class name="IHC.ITF.ITFCOMMON.Email.Operation.EmailOperationWithAttachment">
<Super>Ens.BusinessOperation</Super>
<TimeCreated>66561,42507.472098</TimeCreated>

<Parameter name="ADAPTER">
<Default>EnsLib.EMail.OutboundAdapter</Default>
</Parameter>

<Property name="Adapter">
<Type>EnsLib.EMail.OutboundAdapter</Type>
</Property>

<Property name="Subject">
<Description>
Subject to be added</Description>
<Type>%String</Type>
<InitialExpression>"DefaultSubject"</InitialExpression>
<Parameter name="MAXLEN" value="200"/>
</Property>

<Property name="AttachmentName">
<Description>
Attachment name to be added</Description>
<Type>%String</Type>
<InitialExpression>"Default.txt"</InitialExpression>
<Parameter name="MAXLEN" value="200"/>
</Property>

<Property name="AttachmentUse">
<Description>
Use AttachmentName or OriginalFileName for attachment</Description>
<Type>%String</Type>
<InitialExpression>"OriginalFilename"</InitialExpression>
<Parameter name="MAXLEN" value="200"/>
</Property>

<Property name="Body">
<Description>
Body to be added in the message</Description>
<Type>%String</Type>
<InitialExpression>"Test Mail"</InitialExpression>
<Parameter name="MAXLEN" value="2000"/>
</Property>

<Parameter name="SETTINGS">
<Default>Subject:Additional,Body:Additional,AttachmentName:Additional,AttachmentUse:Additional</Default>
</Parameter>

<Method name="OnMessage">
<FormalSpec>pRequest:Ens.StreamContainer,*pResponse:%Persistent</FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	if (..AttachmentUse = "OriginalFilename") {
		set ..AttachmentName = pRequest.OriginalFilename
	}
	set tMailMessage = ##class(%Net.MailMessage).%New()
	set tMailMessage.Subject = ..Subject	
	set tMailMessage.TextData = ..Body
	set status = tMailMessage.AttachStream(pRequest.Stream,..AttachmentName,0,"iso-8859-1",1)
	set tsc = ..Adapter.SendMail(tMailMessage) 
	quit tsc
]]></Implementation>
</Method>

<XData name="MessageMap">
<Data><![CDATA[
<MapItems>
  <MapItem MessageType="Ens.StreamContainer">
    <Method>OnMessage</Method>
  </MapItem>
</MapItems>
]]></Data>
</XData>
</Class>
</Export>
