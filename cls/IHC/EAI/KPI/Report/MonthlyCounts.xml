<Method name="SendReport">
<Description>
Write ##class(IHC.EAI.KPI.Report.MonthlyCounts).SendReport()</Description>
<ClassMethod>1</ClassMethod>
<FormalSpec>pToList:%ListOfDataTypes,pCcList:%ListOfDataTypes,pBccList:%ListOfDataTypes</FormalSpec>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	Set tStatus = $$$OK
	Try {
		Set tReport = ..%New()
		Set tStatus = tReport.GenerateReportToStream(.tStream,1)
		$$$ThrowOnError(tStatus)
		
		Set tMailMessage = ##class(%Net.MailMessage).%New()
		For i=1:1:pToList.Count() {
			Set tAddress = pToList.GetAt(i)	
			Set tStatus = tMailMessage.To.Insert(tAddress)
			$$$ThrowOnError(tStatus)
		}
		For i=1:1:pCcList.Count() {
			Set tAddress = pCcList.GetAt(i)	
			Set tStatus = tMailMessage.Cc.Insert(tAddress)
			$$$ThrowOnError(tStatus)
		}
		For i=1:1:pBccList.Count() {
			Set tAddress = pBccList.GetAt(i)	
			Set tStatus = tMailMessage.Bcc.Insert(tAddress)
			$$$ThrowOnError(tStatus)
		}
		Set tMailMessage.Subject = "KPI Counts By Month"
		Set tMailMessage.From = "hsadmin"
		Set tMailMessage.Charset = "iso-8859-1"
		Set tMailMessage.IsHTML = 1
		Set tMailMessage.IsBinary = 0
		Set tMailMessage.ContentType = "text/html"
		Do tMailMessage.TextData.CopyFrom(tStream)
		
		Set tSMTP = ##class(%Net.SMTP).%New()
		Set tSMTP.smtpserver = "smtp.co.ihc.com"
		Set tSMTP.timezone = "MST"
		Set tAuthenticator = ##class(%Net.Authenticator).%New()
		Set tUsername = "", tPassword = ""
		Set tStatus = ##class(%SYS.Task.Config).EmailGet("AuthUser",.tUsername)
		$$$ThrowOnError(tStatus)
		Set tAuthenticator.UserName = tUsername
		Set tStatus = ##class(%SYS.Task.Config).EmailGet("AuthPassword",.tPassword)
		$$$ThrowOnError(tStatus)
		Set tAuthenticator.Password = tPassword
		Set tSMTP.authenticator = tAuthenticator
		
		// Send
		Set tStatus = tSMTP.Send(tMailMessage)
		If ($$$ISERR(tStatus)) {
			For i=1:1:tSMTP.FailedSend.Count() {
				$$$LOGERROR("KPI Report SMTP FailedSend: " _ tSMTP.FailedSend.GetAt(i))
			}
		}
		$$$ThrowOnError(tStatus)
		
	} Catch eException {
		Set tStatus = eException.AsStatus()
	}
	Quit tStatus
]]></Implementation>
</Method>

<Method name="%OnBeforeReport">
<Description>
This callback is invoked after this report is instantiated
and before it is run.</Description>
<ReturnType>%Status</ReturnType>
<Implementation><![CDATA[
	Set tStatus = $$$OK
	Try {
		Set ..LocalWebServer = $System.INetInfo.LocalHostName()
		Set ..LocalWebServerPort = ..GetWebServerPort()
	} Catch eException {
		Set tStatus = eExeption.AsStatus()
	}
	Quit tStatus
]]></Implementation>
</Method>

<Method name="GetWebServerPort">
<ReturnType>%String</ReturnType>
<Implementation><![CDATA[
	Set tPort = ""
	
	// Security is setup in %SYS namespace
	New $NAMESPACE
   	Set $NAMESPACE = "%SYS"
   	
   	Do ##class(Config.Startup).Get(.tProperties)
   	Set tPort = tProperties("WebServerPort")
   	
   	Quit tPort
]]></Implementation>
</Method>
