<Query name="MonthlyTransByApp">
<Type>%SQLQuery</Type>
<SqlName>Monthly_Transaction_By_Application</SqlName>
<SqlProc>1</SqlProc>
<SqlQuery>	SELECT 
		Application,
		YEAR(ValueDate),
		MONTH(ValueDate),
		SUM(Value) 
	FROM IHC_EAI_KPI_Schema.TransactionCount 
	WHERE 
		(Type = 'Out' OR Type IS NULL) 
	GROUP By 
		Application,
		YEAR(ValueDate),
		MONTH(ValueDate)</SqlQuery>
<Parameter name="CONTAINID" value="0"/>
<Parameter name="SELECTMODE" value="RUNTIME"/>
</Query>

