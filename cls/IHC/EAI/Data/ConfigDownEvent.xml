<Query name="CurrentMonthDowntimeTotal">
<Type>%SQLQuery</Type>
<SqlName>Current_Month_Downtime_Total</SqlName>
<SqlProc>1</SqlProc>
<SqlQuery><![CDATA[	SELECT 
		cc1.Application,
		YEAR(cc1.ValueDate),
		MONTH(cc1.ValueDate),
		SUM(cc1.Value)
	FROM IHC_EAI_KPI_Schema.ComponentCount cc1
	WHERE NOT EXISTS (SELECT 1
	    FROM IHC_EAI_KPI_Schema.ComponentCount cc2 WHERE cc2.ValueDate > cc1.ValueDate
	    AND MONTH(cc2.ValueDate) = MONTH(cc1.ValueDate)
	    AND YEAR(cc2.ValueDate) = YEAR(cc1.ValueDate)) AND
	    cc1.Type = 'Total'
	GROUP BY cc1.Application,cc1.ValueDate
	ORDER BY cc1.ValueDate]]></SqlQuery>
<Parameter name="CONTAINID" value="0"/>
<Parameter name="SELECTMODE" value="RUNTIME"/>
</Query>

