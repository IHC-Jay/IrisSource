<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
<Class name="ITFCOMMON.Production.SendAlertToApeDTL">
<Super>Ens.DataTransformDTL</Super>
<TimeCreated>63396,46869.784324</TimeCreated>
<DependsOn>Ens.AlertRequest,EnsLib.HTTP.GenericMessage</DependsOn>

<Parameter name="IGNOREMISSINGSOURCE">
<Default>1</Default>
</Parameter>

<Parameter name="REPORTERRORS">
<Default>1</Default>
</Parameter>

<XData name="DTL">
<XMLNamespace>http://www.intersystems.com/dtl</XMLNamespace>
<Data><![CDATA[
<transform sourceClass='Ens.AlertRequest' targetClass='EnsLib.HTTP.GenericMessage' create='new' language='objectscript' >
<trace value='"IN ALERT DTL"'  />
<code>
<![CDATA[  // create data stream
  set stream=##class(%Stream.GlobalBinary).%New()
  // Create APE object
   set apeInfo =##class(ITFCOMMON.ApeInformation).%New()
   set apeInfo.hostname = $SYSTEM.INetInfo.LocalHostName()
   set apeInfo.groupname = $NAMESPACE
   set apeInfo.Comment = source.AlertText
   set apeInfo.msgtimestamp = source.AlertTime
   //":"2014-04-25 16:17:46.774"
  set apeInfo.msgtimestampformat = "yyyy-mm-dd hh24:mi:ss.ms"
   
   set apeInfo.processname = source.SourceConfigName
   set apeInfo.SessionId = source.SessionId
  
   // find sub error id
   set itfErr = "<ITFCOMMON>"
   set ind = $FIND(source.AlertText, itfErr)
   if ind > 0
   {
    set ind2 = $FIND(source.AlertText, ":", ind)
    set apeInfo.issuecode = $EXTRACT(source.AlertText, ind - $L(itfErr), ind2 -2 )
   }
  
    do ##class(%ZEN.Auxiliary.jsonProvider).%WriteJSONStreamFromObject(stream,apeInfo)
  
  do target.HTTPHeaders.SetAt("application/json", "content-type")
  
    do target.HTTPHeaders.SetAt(stream.Size, "content-length")]]]]><![CDATA[></code>
<code>
<![CDATA[ Set str = stream.Read(,.sc)
 $$$LOGINFO("STRING: " _ str)
 $$$LOGINFO("STAT: " _ sc)]]]]><![CDATA[></code>
<trace value='"ALERT DTL DONE"'  />
<assign value='stream' property='target.Stream' action='set'  />
</transform>
]]></Data>
</XData>
