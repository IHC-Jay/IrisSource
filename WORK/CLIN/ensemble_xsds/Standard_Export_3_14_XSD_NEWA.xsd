  *******************************************************************************************************************-->
  <!--Visual CACTUS Logical Fields are formatted differently for Oracle vs. SQL/FoxPro-->
  <xs:simpleType name="BaseLogical">
    <!--Oracle
      <xs:restriction base="xs:boolean">
        <xs:pattern value="[0-1]" />
        End Oracle-->
    <!--SQL/FoxPro-->
      <xs:restriction base="xs:string">
        <xs:pattern value="\.[TF]\."/>
    <!--End SQL/FoxPro-->
    </xs:restriction>
  </xs:simpleType>
  <!--Providers.IndividualInstitutionFlag must be 1 or 2 only-->
  <xs:simpleType name="BaseProvInst">
    <xs:restriction base="xs:unsignedInt">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="2"/>
    </xs:restriction>
  </xs:simpleType>
  <!--EntityAssignments RecordType field must be 'A' or 'E' ONLY-->
  <xs:simpleType name="BaseEARecType">
    <xs:restriction base="xs:string">
      <xs:length value="1"/>
      <xs:enumeration value="E"/>
      <xs:enumeration value="A"/>
    </xs:restriction>
  </xs:simpleType>
  <!--Visual CACTUS Dates must be in MM/DD/YYYY format.  
      This type's RegEx validates without checking for Feb/year range.
      Allows VC-formatted date or empty string only-->
  <xs:simpleType name="BaseDate">
    <xs:restriction base="xs:token">
      <xs:pattern value="((0[1-9])|(1[0-2]))/((0[1-9])|([1-2][0-9])|(3[0-1]))/[0-9]{4}|"/>
    </xs:restriction>
  </xs:simpleType>
  <!--Visual CACTUS Time fields export as character strings, with 0 - 4 numbers-->
  <xs:simpleType name="BaseMTime">
    <xs:restriction base="xs:string">
      <xs:maxLength value="4"/>
    </xs:restriction>
  </xs:simpleType>
  <!--Visual CACTUS Primary Key fields must be 10 characters, preserving leading white spaces-->
  <xs:simpleType name="BasePKey">
    <xs:restriction base="xs:string">
      <xs:whiteSpace value="preserve"/>
      <xs:maxLength value="10"/>
    </xs:restriction>
  </xs:simpleType>
  <!--Addresses.Latitude and .Longitude are floats with 6-digit precision-->
  <xs:simpleType name="BaseZip">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="6"/>
    </xs:restriction>
  </xs:simpleType>
  <!--Provider Health records - Results radio options can have values 1,2,3 or 4 ONLY-->
  <xs:simpleType name="BaseHealthResults">
    <xs:restriction base="xs:int">
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
