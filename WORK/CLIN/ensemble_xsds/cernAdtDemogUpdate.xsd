<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="consumerProfile">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="consumerProfileType">
					<xs:sequence>
						<xs:element name="sn"/>
						<xs:element name="middleName" minOccurs="0"/>
						<xs:element name="givenName" maxOccurs="unbounded"/>
						<xs:element name="dateOfBirth" minOccurs="0"/>
						<xs:element name="race" minOccurs="0"/>
						<xs:element name="ethnicity" minOccurs="0"/>
						<xs:element name="sex" minOccurs="0"/>
						<xs:element name="SSNLastFour" minOccurs="0"/>
						<xs:element name="externalId" minOccurs="0"/>
						<xs:element name="mail" minOccurs="0"/>
						<xs:element name="phoneNumbers" type="phoneType" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="externalInfo" type="externalInfoType" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="addresses" type="addressType" minOccurs="0" maxOccurs="unbounded"/>
						<xs:element name="oldUnitNumber" minOccurs="0"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="consumerProfileType"/>
	<xs:complexType name="emailType"/>
	<xs:complexType name="phoneType">
		<xs:sequence>
			<xs:element name="type" type="xs:string" minOccurs="0"/>
			<xs:element name="primary" type="xs:boolean" minOccurs="0"/>
			<xs:element name="verified" type="xs:boolean" minOccurs="0"/>
			<xs:element name="value" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="externalInfoType">
		<xs:sequence>
			<xs:element name="type" type="xs:string" minOccurs="0"/>
			<xs:element name="value" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="addressType">
		<xs:sequence>
			<xs:element name="type" type="xs:string" minOccurs="0"/>
			<xs:element name="streetAddress" type="xs:string" minOccurs="0"/>
			<xs:element name="streetAddress2" type="xs:string" minOccurs="0"/>
			<xs:element name="postalCode" type="xs:string" minOccurs="0"/>
			<xs:element name="locality" type="xs:string" minOccurs="0"/>
			<xs:element name="region" type="xs:string" minOccurs="0"/>
			<xs:element name="country" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
