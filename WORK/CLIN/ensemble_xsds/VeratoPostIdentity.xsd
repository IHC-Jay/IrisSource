<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
<xs:element name="veratoPostIdentity">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="veratoPostIdentityType">
					<xs:sequence>
					    <xs:element name="trackingId" minOccurs="0"/>	
						<xs:element name="content" type="contentType" />							
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="contentType">
	   <xs:element name="responseIdentityFormatNames" minOccurs="0"/>			
	   <xs:element name="identity" type="identityType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="toSurviveSource" type="toSurviveSourceType" minOccurs="0" maxOccurs="unbounded"/>
		<xs:element name="toRetireSource" type="toRetireSourceType" minOccurs="0" maxOccurs="unbounded"/>	   
	</xs:complexType>
	<xs:complexType name="identityType">
	    <xs:element name="sources" type="sourcesType" minOccurs="0" maxOccurs="unbounded"/>
		<xs:element name="names" type="namesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="ssns" minOccurs="0"/>			
        <xs:element name="genders" minOccurs="0"/>	
        <xs:element name="datesOfBirth" minOccurs="0"/>		
        <xs:element name="addresses" type="addressesType" minOccurs="0" maxOccurs="unbounded"/>
		<xs:element name="emails" minOccurs="0"/>			
		<xs:element name="phoneNumbers" type="phoneNumbersType" minOccurs="0" maxOccurs="unbounded"/>
		<xs:element name="alternateIdentifiers" type="alternateIdentifierType" minOccurs="0" maxOccurs="unbounded"/>	
		<xs:element name="custom.patientname" type="namesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.maidenname" type="namesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.aliasname" type="namesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.preferredname" type="namesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.homephone" type="customPhonesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.cellphone" type="customPhonesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.officephone" type="customPhonesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.alternatephone" type="customPhonesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.emergencyphone" type="customPhonesType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="custom.dateofdeath" type="customDeathDateType" minOccurs="0" maxOccurs="unbounded"/>
	</xs:complexType>
	<xs:complexType name="customDeathDateType">
	  <xs:element name="dod" minOccurs="0" />
	</xs:complexType>
	<xs:complexType name="sourcesType">
	  <xs:element name="name" minOccurs="0"/>			
	  <xs:element name="id" minOccurs="0"/>			
	</xs:complexType>
	<xs:complexType name="namesType">
	  <xs:element name="first" minOccurs="0"/>			
	  <xs:element name="middle" minOccurs="0"/>			
	  <xs:element name="last" minOccurs="0"/>			
	  <xs:element name="suffix" minOccurs="0"/>			
	</xs:complexType>
	  <xs:complexType name="addressesType">
	  <xs:element name="line1" minOccurs="0"/>			
	  <xs:element name="line2" minOccurs="0"/>			
	  <xs:element name="city" minOccurs="0"/>			
	  <xs:element name="state" minOccurs="0"/>			
	  <xs:element name="postalCode" minOccurs="0"/>			
	</xs:complexType>		
	<xs:complexType name="phoneNumbersType">
	  <xs:element name="number" minOccurs="0"/>			
	  <xs:element name="areaCode" minOccurs="0"/>			
	  <xs:element name="extension" minOccurs="0"/>			
	  <xs:element name="countryCode" minOccurs="0"/>				  
	</xs:complexType>
	<xs:complexType name="customPhonesType">
	  <xs:element name="number" minOccurs="0"/>			
	  <xs:element name="areaCode" minOccurs="0"/>			
	 </xs:complexType>
	<xs:complexType name="alternateIdentifierType">
	  <xs:element name="type" minOccurs="0"/>			
	  <xs:element name="issuer" minOccurs="0"/>			
	  <xs:element name="value" minOccurs="0"/>	
	</xs:complexType>
	
	<xs:complexType name="toSurviveSourceType">
	  <xs:element name="name" minOccurs="0"/>			
	  <xs:element name="id" minOccurs="0"/>	
	</xs:complexType>
	
	<xs:complexType name="toRetireSourceType">
	  <xs:element name="name" minOccurs="0"/>			
	  <xs:element name="id" minOccurs="0"/>	
	</xs:complexType>
	
	
</xs:schema>