<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="initiatePatientService">
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="initiatePatientServiceType">
					<xs:sequence>
					    <xs:element name="application" minOccurs="0"/>			
						<xs:element name="transactionType" minOccurs="0"/>			
						<xs:element name="transactionFacility" minOccurs="0"/>			
						<xs:element name="transactionTime" minOccurs="0"/>	
						<xs:element name="patient" type="patientType" minOccurs="0"/>							
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="initiatePatientServiceType"/>
	<xs:complexType name="patientType">
		<xs:element name="addresses" type="addressType" minOccurs="0" maxOccurs="unbounded"/>
		<xs:element name="phones" type="phoneType" minOccurs="0" maxOccurs="unbounded"/>
		<xs:element name="names" type="nameType" minOccurs="0" maxOccurs="unbounded"/>						
		<xs:element name="emails" type="emailType" minOccurs="0" maxOccurs="unbounded"/>
		<xs:element name="mrn" minOccurs="0"/>						
		<xs:element name="sourceMrns" type="externalIdType" minOccurs="0" maxOccurs="unbounded"/>						
		<xs:element name="genderType" minOccurs="0"/>
		<xs:element name="dateOfBirth" minOccurs="0"/>
		<xs:element name="ssn" minOccurs="0"/>	 
	</xs:complexType>
	<xs:complexType name="emailType">
		<xs:sequence>
			<xs:element name="address" type="xs:string" minOccurs="0"/>
			<xs:element name="type" type="xs:string" minOccurs="0"/>			
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="phoneType">
		<xs:sequence>			
			<xs:element name="areaCode" type="xs:string" minOccurs="0"/>
			<xs:element name="phoneNumber" type="xs:string" minOccurs="0"/>			
			<xs:element name="phoneType" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="nameType">
		<xs:sequence>
			<xs:element name="givenName" type="xs:string" minOccurs="0"/>
			<xs:element name="familyName" type="xs:string" minOccurs="0"/>			
			<xs:element name="middleName" type="xs:string" minOccurs="0"/>
			<xs:element name="status" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="externalIdType">
		<xs:sequence>
			<xs:element name="assigningAuthority" type="xs:string" minOccurs="0"/>
			<xs:element name="mrn" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="addressType">
		<xs:sequence>			
			<xs:element name="line1" type="xs:string" minOccurs="0"/>
			<xs:element name="line2" type="xs:string" minOccurs="0"/>
			<xs:element name="county" type="xs:string" minOccurs="0"/>
			<xs:element name="city" type="xs:string" minOccurs="0"/>			
			<xs:element name="state" type="xs:string" minOccurs="0"/>
			<xs:element name="country" type="xs:string" minOccurs="0"/>	
            <xs:element name="zip" type="xs:string" minOccurs="0"/>			
			<xs:element name="type" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
